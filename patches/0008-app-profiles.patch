+      </div>
+    </form>
+  </dialog>
+
+  <script>
+    let editingId = null;
+    let profiles = [];
+    const field = (id) => document.getElementById(id);
+    const dialog = field('dialog');
+
+    function render() {
+      const content = field('content');
+      content.replaceChildren();
+      field('count').textContent = profiles.length ? '(' + profiles.length + ')' : '';
+
+      if (!profiles.length) {
+        const empty = document.createElement('div');
+        empty.className = 'empty';
+        empty.innerHTML = '<div class="glyph">&#128100;</div>' +
+            '<p>No profiles configured yet. A profile is its own isolated cookies, ' +
+            'local storage, and cache — handy for staying signed into the same site as two ' +
+            'different accounts.</p>';
+        const btn = document.createElement('button');
+        btn.className = 'btn-primary';
+        btn.type = 'button';
+        btn.textContent = '+ Add your first profile';
+        btn.addEventListener('click', openAddDialog);
+        empty.appendChild(btn);
+        content.appendChild(empty);
+        return;
+      }
+
+      const grid = document.createElement('div');
+      grid.className = 'grid';
+      for (const profile of profiles) {
+        grid.appendChild(buildCard(profile));
+      }
+      content.appendChild(grid);
+    }
+
+    function buildCard(profile) {
+      const card = document.createElement('div');
+      card.className = 'card';
+
+      const name = document.createElement('div');
+      name.className = 'profile-name';
+      const star = document.createElement('button');
+      star.type = 'button';
+      star.className = 'star-btn' + (profile.active ? ' active' : '');
+      star.title = profile.active ? 'Active profile' : 'Make active';
+      star.textContent = profile.active ? '★' : '☆';
+      star.addEventListener('click', () => chrome.send('activateProfile', [profile.id]));
+      const label = document.createElement('span');
+      label.textContent = profile.name;
+      name.appendChild(star);
+      name.appendChild(label);
+
+      const actions = document.createElement('div');
+      actions.className = 'card-actions';
+      const editBtn = document.createElement('button');
+      editBtn.className = 'icon-btn';
+      editBtn.type = 'button';
+      editBtn.textContent = 'Edit';
+      editBtn.addEventListener('click', () => openEditDialog(profile));
+      const rmBtn = document.createElement('button');
+      rmBtn.className = 'icon-btn danger';
+      rmBtn.type = 'button';
+      rmBtn.textContent = 'Remove';
+      rmBtn.addEventListener('click', () => {
+        if (confirm('Remove profile "' + profile.name + '"?')) {
+          chrome.send('removeProfile', [profile.id]);
+        }
+      });
+      actions.appendChild(editBtn);
+      actions.appendChild(rmBtn);
+
+      card.appendChild(name);
+      card.appendChild(actions);
+      return card;
+    }
+
+    function openAddDialog() {
+      editingId = null;
+      field('dialogTitle').textContent = 'Add profile';
+      field('save').textContent = 'Add profile';
+      field('name').value = '';
+      dialog.showModal();
+      field('name').focus();
+    }
+
+    function openEditDialog(profile) {
+      editingId = profile.id;
+      field('dialogTitle').textContent = 'Edit profile';
+      field('save').textContent = 'Save';
+      field('name').value = profile.name;
+      dialog.showModal();
+      field('name').focus();
+    }
+
+    field('openAdd').addEventListener('click', openAddDialog);
+    field('cancel').addEventListener('click', () => dialog.close());
+
+    field('form').addEventListener('submit', (event) => {
+      event.preventDefault();
+      const name = field('name').value.trim();
+      if (!name) return;
+      if (editingId) {
+        chrome.send('updateProfile', [editingId, name]);
+      } else {
+        chrome.send('addProfile', [name]);
+      }
+      dialog.close();
+    });
+
+    window.setData = (data) => {
+      profiles = data.profiles;
+      render();
+    };
+    chrome.send('getData');
+  </script>
+</body>
+</html>
+)html";
+
+class AppSwapProfilesHandler : public content::WebUIMessageHandler {
+ public:
+  void RegisterMessages() override {
+    web_ui()->RegisterMessageCallback(
+        "getData", base::BindRepeating(&AppSwapProfilesHandler::HandleGetData,
+                                       base::Unretained(this)));
+    web_ui()->RegisterMessageCallback(
+        "addProfile",
+        base::BindRepeating(&AppSwapProfilesHandler::HandleAddProfile,
+                            base::Unretained(this)));
+    web_ui()->RegisterMessageCallback(
+        "updateProfile",
+        base::BindRepeating(&AppSwapProfilesHandler::HandleUpdateProfile,
+                            base::Unretained(this)));
+    web_ui()->RegisterMessageCallback(
+        "removeProfile",
+        base::BindRepeating(&AppSwapProfilesHandler::HandleRemoveProfile,
+                            base::Unretained(this)));
+    web_ui()->RegisterMessageCallback(
+        "activateProfile",
+        base::BindRepeating(&AppSwapProfilesHandler::HandleActivateProfile,
+                            base::Unretained(this)));
+  }
+
+ private:
+  void SendData() {
+    AppSwapProfilesService::GetInstance()->GetProfiles(base::BindOnce(
+        &AppSwapProfilesHandler::OnProfilesLoaded, weak_factory_.GetWeakPtr()));
+  }
+
+  void OnProfilesLoaded(std::vector<AppSwapProfile> profiles) {
+    base::ListValue profiles_list;
+    for (const AppSwapProfile& profile : profiles) {
+      base::DictValue dict;
+      dict.Set("id", profile.id);
+      dict.Set("name", profile.name);
+      std::optional<std::string> active_id =
+          AppSwapProfilesService::GetInstance()->GetActiveProfileIdIfLoaded();
+      dict.Set("active", active_id.has_value() && *active_id == profile.id);
+      profiles_list.Append(std::move(dict));
+    }
+
+    base::DictValue data;
+    data.Set("profiles", std::move(profiles_list));
+    CallJavascriptFunction("setData", data);
+  }
+
+  void HandleGetData(const base::ListValue& args) {
+    AllowJavascript();
+    SendData();
+  }
+
+  void HandleAddProfile(const base::ListValue& args) {
+    AllowJavascript();
+    if (args.empty()) {
+      return;
+    }
+    const std::string* name = args[0].GetIfString();
+    if (!name) {
+      return;
+    }
+
+    AppSwapProfile profile;
+    profile.name = *name;
+    AppSwapProfilesService::GetInstance()->AddProfile(std::move(profile));
+    SendData();
+  }
+
+  void HandleUpdateProfile(const base::ListValue& args) {
+    AllowJavascript();
+    if (args.size() < 2) {
+      return;
+    }
+    const std::string* id = args[0].GetIfString();
+    const std::string* name = args[1].GetIfString();
+    if (!id || !name) {
+      return;
+    }
+
+    AppSwapProfile profile;
+    profile.id = *id;
+    profile.name = *name;
+    AppSwapProfilesService::GetInstance()->UpdateProfile(std::move(profile));
+    SendData();
+  }
+
+  void HandleRemoveProfile(const base::ListValue& args) {
+    AllowJavascript();
+    if (args.empty()) {
+      return;
+    }
+    const std::string* id = args[0].GetIfString();
+    if (!id) {
+      return;
+    }
+    // Move any tab currently running under this profile off it first, then
+    // wipe the partition's data, and only then forget the profile itself --
+    // in that order so nothing is left mid-navigation on a partition that's
+    // about to be cleared.
+    SwitchTabsOffAppSwapProfile(*id);
+    ClearAppSwapProfileData(*id, Profile::FromWebUI(web_ui()));
+    AppSwapProfilesService::GetInstance()->RemoveProfile(*id);
+    SendData();
+  }
+
+  void HandleActivateProfile(const base::ListValue& args) {
+    AllowJavascript();
+    if (args.empty()) {
+      return;
+    }
+    const std::string* id = args[0].GetIfString();
+    if (!id) {
+      return;
+    }
+    AppSwapProfilesService::GetInstance()->SetActiveProfile(*id);
+    SendData();
+  }
+
+  base::WeakPtrFactory<AppSwapProfilesHandler> weak_factory_{this};
+};
+
+}  // namespace
+
+AppSwapProfilesUI::AppSwapProfilesUI(content::WebUI* web_ui)
+    : content::WebUIController(web_ui) {
+  // Lets this page's renderer navigate directly to appswap:// links (e.g. the
+  // nav tabs), which ChildProcessSecurityPolicy would otherwise block as an
+  // unrequestable scheme even though it's just an alias rewritten to this
+  // same chrome:// page.
+  web_ui->AddRequestableScheme(content::kAppSwapUIScheme);
+  content::WebUIDataSource* source =
+      content::WebUIDataSource::CreateAndAdd(Profile::FromWebUI(web_ui),
+                                             "appswap-profiles");
+  // Allow the inline script in the page.
+  source->OverrideContentSecurityPolicy(
+      network::mojom::CSPDirectiveName::ScriptSrc,
+      "script-src chrome://resources 'self' 'unsafe-inline';");
+  source->AddResourcePath("favicon-16.png", IDR_PRODUCT_LOGO_16);
+  source->AddResourcePath("favicon-32.png", IDR_PRODUCT_LOGO_32);
+  // Serve the single HTML document for the root URL (both "" and "/" paths).
+  source->SetRequestFilter(
+      base::BindRepeating(
+          [](const std::string& path) { return path.empty() || path == "/"; }),
+      base::BindRepeating(
+          [](const std::string& path,
+             content::WebUIDataSource::GotDataCallback callback) {
+            std::move(callback).Run(
+                base::MakeRefCounted<base::RefCountedString>(
+                    std::string(kProfilesHtml)));
+          }));
+  web_ui->AddMessageHandler(std::make_unique<AppSwapProfilesHandler>());
+}
+
+AppSwapProfilesUI::~AppSwapProfilesUI() = default;
+
+AppSwapProfilesUIConfig::AppSwapProfilesUIConfig()
+    : content::DefaultWebUIConfig<AppSwapProfilesUI>(content::kChromeUIScheme,
+                                                      "appswap-profiles") {}
