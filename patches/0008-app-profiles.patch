index 0000000000..75c7717cbb
--- /dev/null
+++ b/chrome/browser/app_swap/app_swap_profiles_service.h
@@ -0,0 +1,102 @@
+// Copyright 2026 The AppSwap Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_APP_SWAP_APP_SWAP_PROFILES_SERVICE_H_
+#define CHROME_BROWSER_APP_SWAP_APP_SWAP_PROFILES_SERVICE_H_
+
+#include <optional>
+#include <string>
+#include <utility>
+#include <vector>
+
+#include "base/callback_list.h"
+#include "base/files/file_path.h"
+#include "base/functional/callback.h"
+#include "base/sequence_checker.h"
+
+// The content::StoragePartitionConfig partition_domain used for every
+// AppSwap Profile's storage partition; partition_name is the profile's id.
+// Shared between the partition-assignment code
+// (ChromeContentBrowserClient::GetStoragePartitionConfigForSite), the code
+// that switches a tab's partition (SwitchActiveAppSwapProfile), and the code
+// that reads a tab's *already-assigned* partition back to figure out which
+// Profile it belongs to (AppSwapProfileTabStripButton) -- all three must
+// agree on this exact string.
+inline constexpr char kAppSwapProfilePartitionDomain[] = "appswap-profile";
+
+// A configured profile: an isolated storage identity. Profiles are a global
+// browsing identity, not tied to any app -- at most one is "active" for the
+// whole browser at a time (see GetActiveProfileIdIfLoaded), and once active
+// it applies to every http/https navigation.
+struct AppSwapProfile {
+  std::string id;    // GUID, generated on creation.
+  std::string name;
+};
+
+// Owns the persistent profile configuration, stored as JSON in the user data
+// directory. The file is read/written on a background (MayBlock) task runner.
+class AppSwapProfilesService {
+ public:
+  AppSwapProfilesService();
+  ~AppSwapProfilesService();
+
+  AppSwapProfilesService(const AppSwapProfilesService&) = delete;
+  AppSwapProfilesService& operator=(const AppSwapProfilesService&) = delete;
+
+  static AppSwapProfilesService* GetInstance();
+
+  // Loads the config from disk (on first call) and invokes |callback| with
+  // the profiles on the UI thread.
+  void GetProfiles(base::OnceCallback<void(std::vector<AppSwapProfile>)> callback);
+
+  // Returns the loaded profiles synchronously, or an empty list if the config
+  // hasn't finished loading yet. Callers that must not wait on a callback
+  // (e.g. GetStoragePartitionConfigForSite, which runs synchronously on the
+  // UI thread) should call GetProfiles() once early to kick off the load,
+  // then use this for the actual per-request lookup.
+  const std::vector<AppSwapProfile>& GetProfilesIfLoaded() const;
+
+  // Mutations. Must only be called after the config has been loaded (i.e.
+  // after a GetProfiles callback has run). They update the in-memory state
+  // and schedule an asynchronous save.
+  void AddProfile(AppSwapProfile profile);
+  void UpdateProfile(AppSwapProfile profile);
+  void RemoveProfile(const std::string& id);
+
+  // Returns the id of the one globally active profile: the explicitly
+  // recorded one if it still exists, else nullopt (none ever set, or the
+  // recorded one was since removed). Deliberately does not fall back to
+  // "some other profile" -- with no single app to fall back within, the safe
+  // default is "no active profile", i.e. ordinary unpartitioned browsing.
+  std::optional<std::string> GetActiveProfileIdIfLoaded() const;
+
+  // Marks |profile_id| as the one global active profile. No-op if not found.
+  void SetActiveProfile(const std::string& profile_id);
+
+  // Registers `callback` to run whenever the profile list or the active
+  // profile changes (add/update/remove/switch, or the initial load
+  // completing) -- e.g. AppSwapProfileTabStripButton uses this to pick up a
+  // rename made elsewhere (appswap://profiles) without needing its own tab
+  // to change. Returns a subscription that unregisters on destruction.
+  base::CallbackListSubscription AddChangeCallback(
+      base::RepeatingClosure callback);
+
+ private:
+  void OnConfigLoaded(
+      std::pair<std::vector<AppSwapProfile>, std::optional<std::string>>
+          loaded);
+  void ScheduleSave();
+
+  base::FilePath ConfigPath();
+
+  std::vector<AppSwapProfile> profiles_;
+  std::optional<std::string> active_profile_id_;
+  bool loaded_ = false;
+  bool loading_ = false;
+  std::vector<base::OnceClosure> pending_load_;
+  base::RepeatingClosureList change_callbacks_;
+  SEQUENCE_CHECKER(sequence_checker_);
+};
+
+#endif  // CHROME_BROWSER_APP_SWAP_APP_SWAP_PROFILES_SERVICE_H_
