@@ -0,0 +1,239 @@
+// Copyright 2026 The AppSwap Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/app_swap/app_swap_profiles_service.h"
+
+#include <optional>
+#include <string>
+#include <utility>
+
+#include "base/files/file_util.h"
+#include "base/functional/bind.h"
+#include "base/json/json_reader.h"
+#include "base/json/json_writer.h"
+#include "base/no_destructor.h"
+#include "base/task/thread_pool.h"
+#include "base/uuid.h"
+#include "base/values.h"
+#include "content/public/browser/browser_context.h"
+
+namespace {
+
+base::DictValue ProfileToDict(const AppSwapProfile& profile) {
+  base::DictValue dict;
+  dict.Set("id", profile.id);
+  dict.Set("name", profile.name);
+  return dict;
+}
+
+std::optional<AppSwapProfile> ProfileFromDict(const base::DictValue& dict) {
+  const std::string* id = dict.FindString("id");
+  const std::string* name = dict.FindString("name");
+  if (!id || !name) {
+    return std::nullopt;
+  }
+  AppSwapProfile profile;
+  profile.id = *id;
+  profile.name = *name;
+  return profile;
+}
+
+// Reads and parses the config file. Runs on a MayBlock task runner.
+std::pair<std::vector<AppSwapProfile>, std::optional<std::string>>
+ReadConfigFile(const base::FilePath& path) {
+  std::vector<AppSwapProfile> profiles;
+  std::optional<std::string> active_profile_id;
+  std::string json;
+  if (!base::ReadFileToString(path, &json)) {
+    return {std::move(profiles), std::move(active_profile_id)};
+  }
+  std::optional<base::DictValue> parsed =
+      base::JSONReader::ReadDict(json, base::JSON_PARSE_CHROMIUM_EXTENSIONS);
+  if (!parsed) {
+    return {std::move(profiles), std::move(active_profile_id)};
+  }
+  if (const base::ListValue* profiles_list = parsed->FindList("profiles")) {
+    for (size_t i = 0; i < profiles_list->size(); ++i) {
+      const base::Value& value = (*profiles_list)[i];
+      if (!value.is_dict()) {
+        continue;
+      }
+      if (std::optional<AppSwapProfile> profile =
+              ProfileFromDict(value.GetDict())) {
+        profiles.push_back(std::move(*profile));
+      }
+    }
+  }
+  if (const std::string* active_id = parsed->FindString("active_profile_id")) {
+    active_profile_id = *active_id;
+  }
+  return {std::move(profiles), std::move(active_profile_id)};
+}
+
+}  // namespace
+
+AppSwapProfilesService::AppSwapProfilesService(
+    content::BrowserContext* browser_context)
+    : profile_path_(browser_context->GetPath()) {}
+AppSwapProfilesService::~AppSwapProfilesService() = default;
+
+base::FilePath AppSwapProfilesService::ConfigPath() const {
+  return profile_path_.Append(FILE_PATH_LITERAL("AppSwap"))
+      .Append(FILE_PATH_LITERAL("profiles.json"));
+}
+
+void AppSwapProfilesService::GetProfiles(
+    base::OnceCallback<void(std::vector<AppSwapProfile>)> callback) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+
+  if (loaded_) {
+    base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+        FROM_HERE, base::BindOnce(std::move(callback), profiles_));
+    return;
+  }
+
+  pending_load_.push_back(base::BindOnce(
+      [](AppSwapProfilesService* self,
+         base::OnceCallback<void(std::vector<AppSwapProfile>)> callback) {
+        self->GetProfiles(std::move(callback));
+      },
+      base::Unretained(this), std::move(callback)));
+
+  if (loading_) {
+    return;
+  }
+  loading_ = true;
+
+  base::ThreadPool::PostTaskAndReplyWithResult(
+      FROM_HERE, {base::MayBlock(), base::TaskPriority::USER_VISIBLE},
+      base::BindOnce(&ReadConfigFile, ConfigPath()),
+      base::BindOnce(&AppSwapProfilesService::OnConfigLoaded,
+                     base::Unretained(this)));
+}
+
+const std::vector<AppSwapProfile>& AppSwapProfilesService::GetProfilesIfLoaded()
+    const {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  static const base::NoDestructor<std::vector<AppSwapProfile>> kEmpty;
+  return loaded_ ? profiles_ : *kEmpty;
+}
+
+std::optional<std::string> AppSwapProfilesService::GetActiveProfileIdIfLoaded()
+    const {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  if (!loaded_ || !active_profile_id_) {
+    return std::nullopt;
+  }
+  for (const AppSwapProfile& profile : profiles_) {
+    if (profile.id == *active_profile_id_) {
+      return active_profile_id_;
+    }
+  }
+  return std::nullopt;  // The recorded active profile no longer exists.
+}
+
+void AppSwapProfilesService::SetActiveProfile(const std::string& profile_id) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  DCHECK(loaded_);
+  for (const AppSwapProfile& profile : profiles_) {
+    if (profile.id == profile_id) {
+      active_profile_id_ = profile_id;
+      ScheduleSave();
+      change_callbacks_.Notify();
+      return;
+    }
+  }
+}
+
+base::CallbackListSubscription AppSwapProfilesService::AddChangeCallback(
+    base::RepeatingClosure callback) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  return change_callbacks_.Add(std::move(callback));
+}
+
+void AppSwapProfilesService::OnConfigLoaded(
+    std::pair<std::vector<AppSwapProfile>, std::optional<std::string>>
+        loaded) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  profiles_ = std::move(loaded.first);
+  active_profile_id_ = std::move(loaded.second);
+  loaded_ = true;
+  loading_ = false;
+
+  std::vector<base::OnceClosure> pending = std::move(pending_load_);
+  pending_load_.clear();
+  for (base::OnceClosure& callback : pending) {
+    std::move(callback).Run();
+  }
+  change_callbacks_.Notify();
+}
+
+void AppSwapProfilesService::AddProfile(AppSwapProfile profile) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  DCHECK(loaded_);
+  if (profile.id.empty()) {
+    profile.id = base::Uuid::GenerateRandomV4().AsLowercaseString();
+  }
+  profiles_.push_back(std::move(profile));
+  ScheduleSave();
+  change_callbacks_.Notify();
+}
+
+void AppSwapProfilesService::UpdateProfile(AppSwapProfile profile) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  DCHECK(loaded_);
+  for (AppSwapProfile& existing : profiles_) {
+    if (existing.id == profile.id) {
+      existing = std::move(profile);
+      ScheduleSave();
+      change_callbacks_.Notify();
+      return;
+    }
+  }
+}
+
+void AppSwapProfilesService::RemoveProfile(const std::string& id) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  DCHECK(loaded_);
+  for (auto it = profiles_.begin(); it != profiles_.end(); ++it) {
+    if (it->id == id) {
+      profiles_.erase(it);
+      if (active_profile_id_ == id) {
+        active_profile_id_.reset();
+      }
+      ScheduleSave();
+      change_callbacks_.Notify();
+      return;
+    }
+  }
+}
+
+void AppSwapProfilesService::ScheduleSave() {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+
+  base::DictValue root;
+  base::ListValue profiles_list;
+  for (const AppSwapProfile& profile : profiles_) {
+    profiles_list.Append(ProfileToDict(profile));
+  }
+  root.Set("profiles", std::move(profiles_list));
+  if (active_profile_id_) {
+    root.Set("active_profile_id", *active_profile_id_);
+  }
+
+  std::string json;
+  if (!base::JSONWriter::Write(root, &json)) {
+    return;
+  }
+
+  const base::FilePath path = ConfigPath();
+  base::ThreadPool::PostTask(
+      FROM_HERE, {base::MayBlock(), base::TaskPriority::BEST_EFFORT},
+      base::BindOnce(
+          [](base::FilePath path, std::string json) {
+            base::CreateDirectory(path.DirName());
+            base::WriteFile(path, json);
+          },
+          std::move(path), std::move(json)));
+}
