index 0000000000000..d25468eb11310
--- /dev/null
+++ b/chrome/browser/app_swap/app_swap_profiles_service.cc
@@ -0,0 +1,184 @@
+// Copyright 2026 The AppSwap Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/app_swap/app_swap_profiles_service.h"
+
+#include <optional>
+#include <string>
+#include <utility>
+
+#include "base/functional/bind.h"
+#include "base/no_destructor.h"
+#include "base/uuid.h"
+#include "content/public/browser/browser_context.h"
+
+namespace {
+
+base::DictValue ProfileToDict(const AppSwapProfile& profile) {
+  base::DictValue dict;
+  dict.Set("id", profile.id);
+  dict.Set("name", profile.name);
+  return dict;
+}
+
+std::optional<AppSwapProfile> ProfileFromDict(const base::DictValue& dict) {
+  const std::string* id = dict.FindString("id");
+  const std::string* name = dict.FindString("name");
+  if (!id || !name) {
+    return std::nullopt;
+  }
+  AppSwapProfile profile;
+  profile.id = *id;
+  profile.name = *name;
+  return profile;
+}
+
+}  // namespace
+
+AppSwapProfilesService::AppSwapProfilesService(
+    content::BrowserContext* browser_context)
+    : AppSwapConfigStore(browser_context->GetPath(),
+                         FILE_PATH_LITERAL("profiles.json")) {}
+AppSwapProfilesService::~AppSwapProfilesService() = default;
+
+void AppSwapProfilesService::ParseConfig(const base::DictValue& dict) {
+  if (const base::ListValue* profiles_list = dict.FindList("profiles")) {
+    for (const base::Value& value : *profiles_list) {
+      if (!value.is_dict()) {
+        continue;
+      }
+      if (std::optional<AppSwapProfile> profile =
+              ProfileFromDict(value.GetDict())) {
+        profiles_.push_back(std::move(*profile));
+      }
+    }
+  }
+  if (const std::string* active_id = dict.FindString("active_profile_id")) {
+    active_profile_id_ = *active_id;
+  }
+}
+
+base::DictValue AppSwapProfilesService::SerializeConfig() const {
+  base::DictValue root;
+  base::ListValue profiles_list;
+  for (const AppSwapProfile& profile : profiles_) {
+    profiles_list.Append(ProfileToDict(profile));
+  }
+  root.Set("profiles", std::move(profiles_list));
+  if (active_profile_id_) {
+    root.Set("active_profile_id", *active_profile_id_);
+  }
+  return root;
+}
+
+void AppSwapProfilesService::OnConfigLoadFinished() {
+  change_callbacks_.Notify();
+}
+
+void AppSwapProfilesService::GetProfiles(
+    base::OnceCallback<void(std::vector<AppSwapProfile>)> callback) {
+  RunWhenLoaded(base::BindOnce(
+      [](AppSwapProfilesService* self,
+         base::OnceCallback<void(std::vector<AppSwapProfile>)> callback) {
+        std::move(callback).Run(self->profiles_);
+      },
+      base::Unretained(this), std::move(callback)));
+}
+
+const std::vector<AppSwapProfile>& AppSwapProfilesService::GetProfilesIfLoaded()
+    const {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  static const base::NoDestructor<std::vector<AppSwapProfile>> kEmpty;
+  return loaded() ? profiles_ : *kEmpty;
+}
+
+std::optional<std::string> AppSwapProfilesService::GetActiveProfileIdIfLoaded()
+    const {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  if (!loaded() || !active_profile_id_) {
+    return std::nullopt;
+  }
+  for (const AppSwapProfile& profile : profiles_) {
+    if (profile.id == *active_profile_id_) {
+      return active_profile_id_;
+    }
+  }
+  return std::nullopt;  // The recorded active profile no longer exists.
+}
+
+base::CallbackListSubscription AppSwapProfilesService::AddChangeCallback(
+    base::RepeatingClosure callback) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  return change_callbacks_.Add(std::move(callback));
+}
+
+void AppSwapProfilesService::SetActiveProfile(const std::string& profile_id) {
+  RunWhenLoaded(base::BindOnce(&AppSwapProfilesService::SetActiveProfileNow,
+                               base::Unretained(this), profile_id));
+}
+
+void AppSwapProfilesService::SetActiveProfileNow(
+    const std::string& profile_id) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  for (const AppSwapProfile& profile : profiles_) {
+    if (profile.id == profile_id) {
+      active_profile_id_ = profile_id;
+      Save();
+      change_callbacks_.Notify();
+      return;
+    }
+  }
+}
+
+void AppSwapProfilesService::AddProfile(AppSwapProfile profile) {
+  RunWhenLoaded(base::BindOnce(&AppSwapProfilesService::AddProfileNow,
+                               base::Unretained(this), std::move(profile)));
+}
+
+void AppSwapProfilesService::AddProfileNow(AppSwapProfile profile) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  if (profile.id.empty()) {
+    profile.id = base::Uuid::GenerateRandomV4().AsLowercaseString();
+  }
+  profiles_.push_back(std::move(profile));
+  Save();
+  change_callbacks_.Notify();
+}
+
+void AppSwapProfilesService::UpdateProfile(AppSwapProfile profile) {
+  RunWhenLoaded(base::BindOnce(&AppSwapProfilesService::UpdateProfileNow,
+                               base::Unretained(this), std::move(profile)));
+}
+
+void AppSwapProfilesService::UpdateProfileNow(AppSwapProfile profile) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  for (AppSwapProfile& existing : profiles_) {
+    if (existing.id == profile.id) {
+      existing = std::move(profile);
+      Save();
+      change_callbacks_.Notify();
+      return;
+    }
+  }
+}
+
+void AppSwapProfilesService::RemoveProfile(const std::string& id) {
+  RunWhenLoaded(base::BindOnce(&AppSwapProfilesService::RemoveProfileNow,
+                               base::Unretained(this), id));
+}
+
+void AppSwapProfilesService::RemoveProfileNow(const std::string& id) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  for (auto it = profiles_.begin(); it != profiles_.end(); ++it) {
+    if (it->id == id) {
+      profiles_.erase(it);
+      if (active_profile_id_ == id) {
+        active_profile_id_.reset();
+      }
+      Save();
+      change_callbacks_.Notify();
+      return;
+    }
+  }
+}
