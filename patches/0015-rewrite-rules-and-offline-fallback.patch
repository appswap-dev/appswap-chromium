+// Copyright 2026 The AppSwap Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/app_swap/app_swap_rewrite_rules_service.h"
+
+#include <optional>
+#include <string>
+#include <utility>
+
+#include "base/files/file_util.h"
+#include "base/functional/bind.h"
+#include "base/json/json_reader.h"
+#include "base/json/json_writer.h"
+#include "base/no_destructor.h"
+#include "base/path_service.h"
+#include "base/task/thread_pool.h"
+#include "base/uuid.h"
+#include "base/values.h"
+#include "chrome/common/chrome_paths.h"
+
+namespace {
+
+base::DictValue RuleToDict(const AppSwapRewriteRule& rule) {
+  base::DictValue dict;
+  dict.Set("id", rule.id);
+  dict.Set("name", rule.name);
+  dict.Set("url_pattern", rule.url_pattern);
+  dict.Set("target", rule.target);
+  return dict;
+}
+
+std::optional<AppSwapRewriteRule> RuleFromDict(const base::DictValue& dict) {
+  const std::string* id = dict.FindString("id");
+  const std::string* name = dict.FindString("name");
+  const std::string* url_pattern = dict.FindString("url_pattern");
+  const std::string* target = dict.FindString("target");
+  if (!id || !name || !url_pattern || !target) {
+    return std::nullopt;
+  }
+  AppSwapRewriteRule rule;
+  rule.id = *id;
+  rule.name = *name;
+  rule.url_pattern = *url_pattern;
+  rule.target = *target;
+  return rule;
+}
+
+// Reads and parses the config file. Runs on a MayBlock task runner.
+std::vector<AppSwapRewriteRule> ReadConfigFile(const base::FilePath& path) {
+  std::vector<AppSwapRewriteRule> rules;
+  std::string json;
+  if (!base::ReadFileToString(path, &json)) {
+    return rules;
+  }
+  std::optional<base::DictValue> parsed =
+      base::JSONReader::ReadDict(json, base::JSON_PARSE_CHROMIUM_EXTENSIONS);
+  if (!parsed) {
+    return rules;
+  }
+  const base::ListValue* rules_list = parsed->FindList("rules");
+  if (!rules_list) {
+    return rules;
+  }
+  for (size_t i = 0; i < rules_list->size(); ++i) {
+    const base::Value& value = (*rules_list)[i];
+    if (!value.is_dict()) {
+      continue;
+    }
+    if (std::optional<AppSwapRewriteRule> rule = RuleFromDict(value.GetDict())) {
+      rules.push_back(std::move(*rule));
+    }
+  }
+  return rules;
+}
+
+}  // namespace
+
+AppSwapRewriteRulesService::AppSwapRewriteRulesService() = default;
+AppSwapRewriteRulesService::~AppSwapRewriteRulesService() = default;
+
+// static
+AppSwapRewriteRulesService* AppSwapRewriteRulesService::GetInstance() {
+  static base::NoDestructor<AppSwapRewriteRulesService> instance;
+  return instance.get();
+}
+
+base::FilePath AppSwapRewriteRulesService::ConfigPath() {
+  base::FilePath dir;
+  if (!base::PathService::Get(chrome::DIR_USER_DATA, &dir)) {
+    base::GetTempDir(&dir);
+  }
+  return dir.Append(FILE_PATH_LITERAL("AppSwap"))
+      .Append(FILE_PATH_LITERAL("rewrite_rules.json"));
+}
+
+void AppSwapRewriteRulesService::GetRules(
+    base::OnceCallback<void(std::vector<AppSwapRewriteRule>)> callback) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+
+  if (loaded_) {
+    base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+        FROM_HERE, base::BindOnce(std::move(callback), rules_));
+    return;
+  }
+
+  pending_load_.push_back(base::BindOnce(
+      [](AppSwapRewriteRulesService* self,
+         base::OnceCallback<void(std::vector<AppSwapRewriteRule>)> callback) {
+        self->GetRules(std::move(callback));
+      },
+      base::Unretained(this), std::move(callback)));
+
+  if (loading_) {
+    return;
+  }
+  loading_ = true;
+
+  base::ThreadPool::PostTaskAndReplyWithResult(
+      FROM_HERE, {base::MayBlock(), base::TaskPriority::USER_VISIBLE},
+      base::BindOnce(&ReadConfigFile, ConfigPath()),
+      base::BindOnce(&AppSwapRewriteRulesService::OnConfigLoaded,
+                     base::Unretained(this)));
+}
+
+const std::vector<AppSwapRewriteRule>&
+AppSwapRewriteRulesService::GetRulesIfLoaded() const {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  static const base::NoDestructor<std::vector<AppSwapRewriteRule>> kEmpty;
+  return loaded_ ? rules_ : *kEmpty;
+}
+
+void AppSwapRewriteRulesService::OnConfigLoaded(
+    std::vector<AppSwapRewriteRule> rules) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  rules_ = std::move(rules);
+  loaded_ = true;
+  loading_ = false;
+
+  std::vector<base::OnceClosure> pending = std::move(pending_load_);
+  pending_load_.clear();
+  for (base::OnceClosure& callback : pending) {
+    std::move(callback).Run();
+  }
+}
+
+void AppSwapRewriteRulesService::AddRule(AppSwapRewriteRule rule) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  DCHECK(loaded_);
+  if (rule.id.empty()) {
+    rule.id = base::Uuid::GenerateRandomV4().AsLowercaseString();
+  }
+  rules_.push_back(std::move(rule));
+  ScheduleSave();
+}
+
+void AppSwapRewriteRulesService::UpdateRule(AppSwapRewriteRule rule) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  DCHECK(loaded_);
+  for (AppSwapRewriteRule& existing : rules_) {
+    if (existing.id == rule.id) {
+      existing = std::move(rule);
+      ScheduleSave();
+      return;
+    }
+  }
+}
+
+void AppSwapRewriteRulesService::RemoveRule(const std::string& id) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  DCHECK(loaded_);
+  for (auto it = rules_.begin(); it != rules_.end(); ++it) {
+    if (it->id == id) {
+      rules_.erase(it);
+      ScheduleSave();
+      return;
+    }
+  }
+}
+
+void AppSwapRewriteRulesService::ScheduleSave() {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+
+  base::DictValue root;
+  base::ListValue rules_list;
+  for (const AppSwapRewriteRule& rule : rules_) {
+    rules_list.Append(RuleToDict(rule));
+  }
+  root.Set("rules", std::move(rules_list));
+
+  std::string json;
+  if (!base::JSONWriter::Write(root, &json)) {
+    return;
+  }
+
+  const base::FilePath path = ConfigPath();
+  base::ThreadPool::PostTask(
+      FROM_HERE, {base::MayBlock(), base::TaskPriority::BEST_EFFORT},
+      base::BindOnce(
+          [](base::FilePath path, std::string json) {
+            base::CreateDirectory(path.DirName());
+            base::WriteFile(path, json);
+          },
+          std::move(path), std::move(json)));
+}
