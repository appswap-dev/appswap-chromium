+      const target = document.createElement('div');
+      target.className = 'rule-target';
+      target.textContent = rule.target;
+      target.title = rule.target;
+
+      const actions = document.createElement('div');
+      actions.className = 'card-actions';
+      const editBtn = document.createElement('button');
+      editBtn.className = 'icon-btn';
+      editBtn.type = 'button';
+      editBtn.textContent = 'Edit';
+      editBtn.addEventListener('click', () => openEditDialog(rule));
+      const rmBtn = document.createElement('button');
+      rmBtn.className = 'icon-btn danger';
+      rmBtn.type = 'button';
+      rmBtn.textContent = 'Remove';
+      rmBtn.addEventListener('click', () => {
+        if (confirm('Remove rewrite rule "' + rule.name + '"?')) {
+          chrome.send('removeRule', [rule.id]);
+        }
+      });
+      actions.appendChild(editBtn);
+      actions.appendChild(rmBtn);
+
+      card.appendChild(name);
+      card.appendChild(pattern);
+      card.appendChild(arrow);
+      card.appendChild(target);
+      card.appendChild(actions);
+      return card;
+    }
+
+    function openAddDialog() {
+      editingId = null;
+      field('dialogTitle').textContent = 'Add rewrite rule';
+      field('save').textContent = 'Add rule';
+      field('ruleName').value = '';
+      field('urlPattern').value = '';
+      field('target').value = '';
+      updatePreview();
+      dialog.showModal();
+      field('ruleName').focus();
+    }
+
+    function openEditDialog(rule) {
+      editingId = rule.id;
+      field('dialogTitle').textContent = 'Edit rewrite rule';
+      field('save').textContent = 'Save';
+      field('ruleName').value = rule.name;
+      field('urlPattern').value = rule.url_pattern;
+      field('target').value = rule.target;
+      updatePreview();
+      dialog.showModal();
+      field('ruleName').focus();
+    }
+
+    field('openAdd').addEventListener('click', openAddDialog);
+    field('cancel').addEventListener('click', () => dialog.close());
+    field('urlPattern').addEventListener('input', updatePreview);
+    field('target').addEventListener('input', updatePreview);
+
+    field('form').addEventListener('submit', (event) => {
+      event.preventDefault();
+      const name = field('ruleName').value.trim();
+      const urlPattern = field('urlPattern').value.trim();
+      const target = field('target').value.trim();
+      if (!name || !urlPattern || !target) return;
+      if (editingId) {
+        chrome.send('updateRule', [editingId, name, urlPattern, target]);
+      } else {
+        chrome.send('addRule', [name, urlPattern, target]);
+      }
+      dialog.close();
+    });
+
+    window.setData = (data) => {
+      rules = data.rules;
+      render();
+    };
+    chrome.send('getData');
+  </script>
+</body>
+</html>
+)html";
+
+class AppSwapRewriteRulesHandler : public content::WebUIMessageHandler {
+ public:
+  void RegisterMessages() override {
+    web_ui()->RegisterMessageCallback(
+        "getData", base::BindRepeating(&AppSwapRewriteRulesHandler::HandleGetData,
+                                       base::Unretained(this)));
+    web_ui()->RegisterMessageCallback(
+        "addRule", base::BindRepeating(&AppSwapRewriteRulesHandler::HandleAddRule,
+                                       base::Unretained(this)));
+    web_ui()->RegisterMessageCallback(
+        "updateRule",
+        base::BindRepeating(&AppSwapRewriteRulesHandler::HandleUpdateRule,
+                            base::Unretained(this)));
+    web_ui()->RegisterMessageCallback(
+        "removeRule",
+        base::BindRepeating(&AppSwapRewriteRulesHandler::HandleRemoveRule,
+                            base::Unretained(this)));
+  }
+
+ private:
+  void SendData() {
+    AppSwapRewriteRulesService::GetInstance()->GetRules(base::BindOnce(
+        &AppSwapRewriteRulesHandler::OnRulesLoaded, weak_factory_.GetWeakPtr()));
+  }
+
+  void OnRulesLoaded(std::vector<AppSwapRewriteRule> rules) {
+    base::ListValue rules_list;
+    for (const AppSwapRewriteRule& rule : rules) {
+      base::DictValue dict;
+      dict.Set("id", rule.id);
+      dict.Set("name", rule.name);
+      dict.Set("url_pattern", rule.url_pattern);
+      dict.Set("target", rule.target);
+      rules_list.Append(std::move(dict));
+    }
+
+    base::DictValue data;
+    data.Set("rules", std::move(rules_list));
+    CallJavascriptFunction("setData", data);
+  }
+
+  void HandleGetData(const base::ListValue& args) {
+    AllowJavascript();
+    SendData();
+  }
+
+  void HandleAddRule(const base::ListValue& args) {
+    AllowJavascript();
+    if (args.size() < 3) {
+      return;
+    }
+    const std::string* name = args[0].GetIfString();
+    const std::string* url_pattern = args[1].GetIfString();
+    const std::string* target = args[2].GetIfString();
+    if (!name || !url_pattern || !target) {
+      return;
+    }
+
+    AppSwapRewriteRule rule;
+    rule.name = *name;
+    rule.url_pattern = *url_pattern;
+    rule.target = *target;
+    AppSwapRewriteRulesService::GetInstance()->AddRule(std::move(rule));
+    SendData();
+  }
+
+  void HandleUpdateRule(const base::ListValue& args) {
+    AllowJavascript();
+    if (args.size() < 4) {
+      return;
+    }
+    const std::string* id = args[0].GetIfString();
+    const std::string* name = args[1].GetIfString();
+    const std::string* url_pattern = args[2].GetIfString();
+    const std::string* target = args[3].GetIfString();
+    if (!id || !name || !url_pattern || !target) {
+      return;
+    }
+
+    AppSwapRewriteRule rule;
+    rule.id = *id;
+    rule.name = *name;
+    rule.url_pattern = *url_pattern;
+    rule.target = *target;
+    AppSwapRewriteRulesService::GetInstance()->UpdateRule(std::move(rule));
+    SendData();
+  }
+
+  void HandleRemoveRule(const base::ListValue& args) {
+    AllowJavascript();
+    if (args.empty()) {
+      return;
+    }
+    const std::string* id = args[0].GetIfString();
+    if (!id) {
+      return;
+    }
+    AppSwapRewriteRulesService::GetInstance()->RemoveRule(*id);
+    SendData();
+  }
+
+  base::WeakPtrFactory<AppSwapRewriteRulesHandler> weak_factory_{this};
+};
+
+}  // namespace
+
+AppSwapRewriteRulesUI::AppSwapRewriteRulesUI(content::WebUI* web_ui)
+    : content::WebUIController(web_ui) {
+  // Lets this page's renderer navigate directly to appswap:// links (e.g. the
+  // nav tabs), which ChildProcessSecurityPolicy would otherwise block as an
+  // unrequestable scheme even though it's just an alias rewritten to this
+  // same chrome:// page.
+  web_ui->AddRequestableScheme(content::kAppSwapUIScheme);
+  content::WebUIDataSource* source =
+      content::WebUIDataSource::CreateAndAdd(Profile::FromWebUI(web_ui),
+                                             "appswap-rewrites");
+  // Allow the inline script in the page.
+  source->OverrideContentSecurityPolicy(
+      network::mojom::CSPDirectiveName::ScriptSrc,
+      "script-src chrome://resources 'self' 'unsafe-inline';");
+  source->AddResourcePath("favicon-16.png", IDR_PRODUCT_LOGO_16);
+  source->AddResourcePath("favicon-32.png", IDR_PRODUCT_LOGO_32);
+  // Serve the single HTML document for the root URL (both "" and "/" paths).
+  source->SetRequestFilter(
+      base::BindRepeating(
+          [](const std::string& path) { return path.empty() || path == "/"; }),
+      base::BindRepeating(
+          [](const std::string& path,
+             content::WebUIDataSource::GotDataCallback callback) {
+            std::move(callback).Run(
+                base::MakeRefCounted<base::RefCountedString>(
+                    std::string(kRewriteRulesHtml)));
+          }));
+  web_ui->AddMessageHandler(std::make_unique<AppSwapRewriteRulesHandler>());
+}
+
+AppSwapRewriteRulesUI::~AppSwapRewriteRulesUI() = default;
+
+AppSwapRewriteRulesUIConfig::AppSwapRewriteRulesUIConfig()
+    : content::DefaultWebUIConfig<AppSwapRewriteRulesUI>(
+          content::kChromeUIScheme,
+          "appswap-rewrites") {}
