@@ -0,0 +1,82 @@
+// Copyright 2026 The AppSwap Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_APP_SWAP_APP_SWAP_REWRITE_RULES_SERVICE_H_
+#define CHROME_BROWSER_APP_SWAP_APP_SWAP_REWRITE_RULES_SERVICE_H_
+
+#include <string>
+#include <vector>
+
+#include "base/files/file_path.h"
+#include "base/functional/callback.h"
+#include "base/sequence_checker.h"
+
+// A named, app-independent URL rewrite rule: requests whose URL matches
+// `url_pattern` (see AppSwapUrlMatchesPattern) are forwarded to the real
+// network with the URL rewritten -- the portion of the request path beyond
+// `url_pattern`'s own path is appended to `target`'s path unchanged, so
+// e.g. a pattern of "https://example.com/api" with a target of
+// "https://beta.example.com/api" turns a request for
+// "https://example.com/api/users?x=1" into
+// "https://beta.example.com/api/users?x=1" (see
+// ComputeAppSwapRewriteUrl()). Applies to every HTTP method, not just
+// GET/HEAD -- it's a URL-level proxy, not served file content.
+//
+// Unlike an AppSwapRoute (which always resolves to exactly one app), a
+// rewrite rule has no notion of "app" at all: `name` exists so the same
+// rule can be identified/reused independently of any one app's
+// configuration (e.g. a future "apply this named rule to the current tab"
+// feature).
+struct AppSwapRewriteRule {
+  std::string id;           // GUID, generated on creation.
+  std::string name;         // user-facing label, e.g. "API beta"
+  std::string url_pattern;  // e.g. "https://my-website.com/api"
+  std::string target;       // e.g. "https://beta.my-website.com/api"
+};
+
+// Owns the persistent rewrite-rule configuration, stored as JSON in the user
+// data directory. Mirrors AppSwapRoutesService: the file is read/written on
+// a background (MayBlock) task runner.
+class AppSwapRewriteRulesService {
+ public:
+  AppSwapRewriteRulesService();
+  ~AppSwapRewriteRulesService();
+
+  AppSwapRewriteRulesService(const AppSwapRewriteRulesService&) = delete;
+  AppSwapRewriteRulesService& operator=(const AppSwapRewriteRulesService&) =
+      delete;
+
+  static AppSwapRewriteRulesService* GetInstance();
+
+  // Loads the config from disk (on first call) and invokes |callback| with
+  // the rules on the UI thread.
+  void GetRules(
+      base::OnceCallback<void(std::vector<AppSwapRewriteRule>)> callback);
+
+  // Returns the loaded rules synchronously, or an empty list if the config
+  // hasn't finished loading yet. See AppSwapAppsService::GetAppsIfLoaded for
+  // why this exists alongside GetRules().
+  const std::vector<AppSwapRewriteRule>& GetRulesIfLoaded() const;
+
+  // Mutations. Must only be called after the config has been loaded (i.e.
+  // after a GetRules callback has run). They update the in-memory list and
+  // schedule an asynchronous save.
+  void AddRule(AppSwapRewriteRule rule);
+  void UpdateRule(AppSwapRewriteRule rule);
+  void RemoveRule(const std::string& id);
+
+ private:
+  void OnConfigLoaded(std::vector<AppSwapRewriteRule> rules);
+  void ScheduleSave();
+
+  base::FilePath ConfigPath();
+
+  std::vector<AppSwapRewriteRule> rules_;
+  bool loaded_ = false;
+  bool loading_ = false;
+  std::vector<base::OnceClosure> pending_load_;
+  SEQUENCE_CHECKER(sequence_checker_);
+};
+
+#endif  // CHROME_BROWSER_APP_SWAP_APP_SWAP_REWRITE_RULES_SERVICE_H_
