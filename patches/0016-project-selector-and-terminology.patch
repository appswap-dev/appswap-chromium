diff --git a/chrome/browser/ui/views/app_swap/app_swap_project_selector_button.cc b/chrome/browser/ui/views/app_swap/app_swap_project_selector_button.cc
new file mode 100644
index 0000000000000..27ae213bc058e
--- /dev/null
+++ b/chrome/browser/ui/views/app_swap/app_swap_project_selector_button.cc
@@ -0,0 +1,192 @@
+// Copyright 2026 The AppSwap Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/views/app_swap/app_swap_project_selector_button.h"
+
+#include <iterator>
+#include <string>
+#include <utility>
+
+#include "base/functional/bind.h"
+#include "base/hash/hash.h"
+#include "base/strings/utf_string_conversions.h"
+#include "chrome/browser/browser_process.h"
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/browser/profiles/profile_attributes_entry.h"
+#include "chrome/browser/profiles/profile_manager.h"
+#include "chrome/browser/profiles/profile_window.h"
+#include "chrome/browser/ui/browser_window/public/browser_window_interface.h"
+#include "chrome/browser/ui/profiles/profile_picker.h"
+#include "ui/base/metadata/metadata_impl_macros.h"
+#include "ui/base/mojom/menu_source_type.mojom.h"
+#include "ui/base/models/menu_separator_types.h"
+#include "ui/color/color_id.h"
+#include "ui/color/color_provider.h"
+#include "ui/gfx/color_utils.h"
+#include "ui/gfx/geometry/insets.h"
+#include "ui/views/background.h"
+#include "ui/views/border.h"
+#include "ui/views/controls/menu/menu_item_view.h"
+#include "ui/views/controls/menu/menu_model_adapter.h"
+#include "ui/views/controls/menu/menu_runner.h"
+
+namespace {
+
+// Command ids for the project-picker menu. Purely local to this menu's own
+// ExecuteCommand -- not part of chrome's global command-id space.
+constexpr int kNewProjectCommandId = 1;
+constexpr int kProjectCommandBase = 2;
+
+// Modest rounding for a "rounded rectangle" chip, not a full pill/stadium.
+constexpr float kBadgeCornerRadius = 6.0f;
+
+// Same curated palette as AppSwapProfileTabStripButton -- see its comment
+// for why these specific hues (avoids washed-out yellows, spans hues that
+// stay distinct under red-green color blindness).
+constexpr double kBadgeHues[] = {
+    210.0,  // blue
+    175.0,  // teal
+    150.0,  // blue-leaning green (not yellow-green)
+    265.0,  // purple
+    330.0,  // magenta / pink
+    25.0,   // orange
+    245.0,  // indigo
+    355.0,  // pink-leaning red
+};
+
+double HueForProjectName(const std::string& name) {
+  return kBadgeHues[base::PersistentHash(name) % std::size(kBadgeHues)];
+}
+
+SkColor ComputeBadgeBackgroundColor(const std::string& name, bool dark_theme) {
+  color_utils::HSL hsl;
+  hsl.h = HueForProjectName(name) / 360.0;
+  hsl.s = dark_theme ? 0.40 : 0.62;
+  hsl.l = dark_theme ? 0.28 : 0.80;
+  return color_utils::HSLToSkColor(hsl, SK_AlphaOPAQUE);
+}
+
+SkColor ComputeBadgeTextColor(SkColor background) {
+  return color_utils::BlendForMinContrast(SK_ColorBLACK, background).color;
+}
+
+}  // namespace
+
+AppSwapProjectSelectorButton::AppSwapProjectSelectorButton(
+    BrowserWindowInterface* browser)
+    : views::MenuButton(base::BindRepeating(
+          &AppSwapProjectSelectorButton::ButtonPressed,
+          base::Unretained(this))),
+      browser_(browser) {
+  profile_attributes_observation_.Observe(
+      &g_browser_process->profile_manager()->GetProfileAttributesStorage());
+  UpdateLabel();
+}
+
+AppSwapProjectSelectorButton::~AppSwapProjectSelectorButton() = default;
+
+void AppSwapProjectSelectorButton::OnProfileNameChanged(
+    const base::FilePath& profile_path,
+    const std::u16string& old_name) {
+  if (profile_path == browser_->GetProfile()->GetPath()) {
+    UpdateLabel();
+  }
+}
+
+void AppSwapProjectSelectorButton::UpdateLabel() {
+  ProfileAttributesEntry* entry =
+      g_browser_process->profile_manager()
+          ->GetProfileAttributesStorage()
+          .GetProfileAttributesWithPath(browser_->GetProfile()->GetPath());
+  const std::string name =
+      entry ? base::UTF16ToUTF8(entry->GetName()) : "Project";
+  SetText(base::UTF8ToUTF16(name));
+  ApplyBadgeStyle(name);
+}
+
+void AppSwapProjectSelectorButton::ApplyBadgeStyle(
+    const std::string& project_name) {
+  bool dark_theme = false;
+  if (const ui::ColorProvider* color_provider = GetColorProvider()) {
+    dark_theme =
+        color_utils::IsDark(color_provider->GetColor(ui::kColorWindowBackground));
+  }
+
+  const SkColor background_color =
+      ComputeBadgeBackgroundColor(project_name, dark_theme);
+  const SkColor text_color = ComputeBadgeTextColor(background_color);
+
+  SetBackground(
+      views::CreateRoundedRectBackground(background_color, kBadgeCornerRadius));
+  SetEnabledTextColors(text_color);
+  SetBorder(views::CreateEmptyBorder(gfx::Insets::VH(4, 10)));
+}
+
+void AppSwapProjectSelectorButton::OnThemeChanged() {
+  views::MenuButton::OnThemeChanged();
+  UpdateLabel();
+}
+
+void AppSwapProjectSelectorButton::ButtonPressed() {
+  // Tear down any previous menu before rebuilding -- see
+  // AppSwapProfileTabStripButton::ButtonPressed for why this ordering
+  // (menu_runner_ first) matters.
+  menu_runner_.reset();
+  menu_model_adapter_.reset();
+  menu_model_.reset();
+
+  const base::FilePath current_path = browser_->GetProfile()->GetPath();
+  const base::FilePath guest_path = ProfileManager::GetGuestProfilePath();
+  const base::FilePath system_path = ProfileManager::GetSystemProfilePath();
+
+  ProfileAttributesStorage& storage =
+      g_browser_process->profile_manager()->GetProfileAttributesStorage();
+
+  menu_model_ = std::make_unique<ui::SimpleMenuModel>(this);
+  menu_project_paths_.clear();
+  for (ProfileAttributesEntry* entry :
+       storage.GetAllProfilesAttributesSortedByNameWithCheck()) {
+    const base::FilePath path = entry->GetPath();
+    if (path == current_path || path == guest_path || path == system_path ||
+        entry->IsOmitted()) {
+      continue;
+    }
+    menu_project_paths_.push_back(path);
+    menu_model_->AddItem(
+        kProjectCommandBase + static_cast<int>(menu_project_paths_.size() - 1),
+        entry->GetName());
+  }
+  if (!menu_project_paths_.empty()) {
+    menu_model_->AddSeparator(ui::NORMAL_SEPARATOR);
+  }
+  menu_model_->AddItem(kNewProjectCommandId, u"New Project…");
+
+  menu_model_adapter_ = std::make_unique<views::MenuModelAdapter>(
+      menu_model_.get());
+  std::unique_ptr<views::MenuItemView> root = menu_model_adapter_->CreateMenu();
+  menu_runner_ = std::make_unique<views::MenuRunner>(
+      std::move(root), views::MenuRunner::HAS_MNEMONICS);
+  menu_runner_->RunMenuAt(GetWidget(), nullptr, GetAnchorBoundsInScreen(),
+                          views::MenuAnchorPosition::kTopLeft,
+                          ui::mojom::MenuSourceType::kNone);
+}
+
+void AppSwapProjectSelectorButton::ExecuteCommand(int command_id,
+                                                   int event_flags) {
+  if (command_id == kNewProjectCommandId) {
+    ProfilePicker::Show(ProfilePicker::Params::FromEntryPoint(
+        ProfilePicker::EntryPoint::kProfileMenuAddNewProfile));
+    return;
+  }
+
+  const size_t index = static_cast<size_t>(command_id - kProjectCommandBase);
+  if (index >= menu_project_paths_.size()) {
+    return;
+  }
+  profiles::SwitchToProfile(menu_project_paths_[index],
+                            /*always_create=*/false);
+}
+
+BEGIN_METADATA(AppSwapProjectSelectorButton)
+END_METADATA
