--- /dev/null
+++ b/chrome/browser/ui/views/app_swap/app_swap_project_selector_button.h
@@ -0,0 +1,82 @@
+// Copyright 2026 The AppSwap Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_VIEWS_APP_SWAP_APP_SWAP_PROJECT_SELECTOR_BUTTON_H_
+#define CHROME_BROWSER_UI_VIEWS_APP_SWAP_APP_SWAP_PROJECT_SELECTOR_BUTTON_H_
+
+#include <string>
+
+#include "base/memory/raw_ptr.h"
+#include "base/scoped_observation.h"
+#include "chrome/browser/profiles/profile_attributes_storage.h"
+#include "chrome/browser/profiles/profile_attributes_storage_observer.h"
+#include "ui/base/metadata/metadata_header_macros.h"
+#include "ui/views/controls/button/menu_button.h"
+
+class BrowserWindowInterface;
+
+// A leading tab-strip button (sits where the Tab Search button lives, before
+// the first tab) showing the Project (== Chromium Profile, see the
+// "Projects" plan) this window belongs to. This is a real per-window
+// identity -- always visible, unlike the location-bar AppSwap Profile/Route
+// Group chips, which only show up on relevant pages.
+//
+// Clicking it reuses Chromium's own native profile-switcher bubble
+// (BrowserWindowFeatures::profile_menu_coordinator()/ProfileMenuView)
+// instead of a custom dropdown: this button claims the
+// kToolbarAvatarButtonElementId element identifier that
+// ProfileMenuCoordinator anchors its bubble to. The real AvatarToolbarButton
+// is hidden in this build (see ToolbarView's constructor, which clears the
+// identifier off of it so there's no conflict) -- so
+// chrome::ShowAvatarMenu() shows the exact same bubble the stock avatar
+// button would, anchored to this button instead. That gets every feature of
+// that bubble (switch/create/delete project, guest mode, DICE sign-in) for
+// free, correctly retextured to "project" wording via the string changes in
+// profiles_strings.grdp/chromium_strings.grd/their .xtb translations, with
+// no custom menu code to maintain here.
+//
+// This is why this button's two files are compiled into the main
+// //chrome/browser/ui target (see chrome/browser/ui/BUILD.gn) rather than
+// the separate //chrome/browser/ui/views/app_swap target the other AppSwap
+// tab-strip/location-bar buttons live in: chrome::ShowAvatarMenu() and
+// ProfileMenuCoordinator are only reachable from within that target, which
+// depends on (not from) app_swap, so pulling this button in the other
+// direction would be circular.
+class AppSwapProjectSelectorButton : public views::MenuButton,
+                                     public ProfileAttributesStorageObserver {
+  METADATA_HEADER(AppSwapProjectSelectorButton, views::MenuButton)
+
+ public:
+  explicit AppSwapProjectSelectorButton(BrowserWindowInterface* browser);
+  AppSwapProjectSelectorButton(const AppSwapProjectSelectorButton&) = delete;
+  AppSwapProjectSelectorButton& operator=(
+      const AppSwapProjectSelectorButton&) = delete;
+  ~AppSwapProjectSelectorButton() override;
+
+  // ProfileAttributesStorageObserver:
+  void OnProfileNameChanged(const base::FilePath& profile_path,
+                            const std::u16string& old_name) override;
+
+  // views::View:
+  void OnThemeChanged() override;
+
+ private:
