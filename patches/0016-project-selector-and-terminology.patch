@@ -0,0 +1,94 @@
+// Copyright 2026 The AppSwap Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_VIEWS_APP_SWAP_APP_SWAP_PROJECT_SELECTOR_BUTTON_H_
+#define CHROME_BROWSER_UI_VIEWS_APP_SWAP_APP_SWAP_PROJECT_SELECTOR_BUTTON_H_
+
+#include <memory>
+#include <vector>
+
+#include "base/files/file_path.h"
+#include "base/memory/raw_ptr.h"
+#include "base/scoped_observation.h"
+#include "chrome/browser/profiles/profile_attributes_storage.h"
+#include "chrome/browser/profiles/profile_attributes_storage_observer.h"
+#include "ui/base/metadata/metadata_header_macros.h"
+#include "ui/menus/simple_menu_model.h"
+#include "ui/views/controls/button/menu_button.h"
+
+class BrowserWindowInterface;
+
+namespace views {
+class MenuModelAdapter;
+class MenuRunner;
+}  // namespace views
+
+// A leading tab-strip button (sits where the Tab Search button lives, before
+// the first tab) showing the Project (== Chromium Profile, see the
+// "Projects" plan) this window belongs to. This is a real per-window
+// identity -- always visible, unlike the location-bar AppSwap Profile/Route
+// Group chips, which only show up on relevant pages. Clicking it opens a
+// menu listing every *other* configured Project plus "New Project..."; the
+// current window's own project is on the button itself, not repeated in the
+// dropdown. Picking a project activates (or opens) that Profile's own window
+// via profiles::SwitchToProfile -- a Project switch is a real Profile
+// switch, not an in-page reload, unlike AppSwapRouteGroupTabStripButton's
+// per-tab pin.
+//
+// Deliberately a standalone views::MenuButton + ui::SimpleMenuModel, not a
+// WebUI bubble -- this avoids any dependency on TabSearchBubbleHost /
+// TabStripComboButton (chrome/browser/ui/views/tabs/shared/), which stay
+// completely untouched.
+class AppSwapProjectSelectorButton : public views::MenuButton,
+                                     public ProfileAttributesStorageObserver,
+                                     public ui::SimpleMenuModel::Delegate {
+  METADATA_HEADER(AppSwapProjectSelectorButton, views::MenuButton)
+
+ public:
+  explicit AppSwapProjectSelectorButton(BrowserWindowInterface* browser);
+  AppSwapProjectSelectorButton(const AppSwapProjectSelectorButton&) = delete;
+  AppSwapProjectSelectorButton& operator=(
+      const AppSwapProjectSelectorButton&) = delete;
+  ~AppSwapProjectSelectorButton() override;
+
+  // ProfileAttributesStorageObserver:
+  void OnProfileNameChanged(const base::FilePath& profile_path,
+                            const std::u16string& old_name) override;
+
+  // ui::SimpleMenuModel::Delegate:
+  void ExecuteCommand(int command_id, int event_flags) override;
+
+  // views::View:
+  void OnThemeChanged() override;
+
+ private:
+  // Recomputes the button's label/badge from the current window's own
+  // ProfileAttributesEntry.
+  void UpdateLabel();
+
+  // Same badge-coloring approach as AppSwapProfileTabStripButton::
+  // ApplyBadgeStyle -- see its comment.
+  void ApplyBadgeStyle(const std::string& project_name);
+
+  // Builds and runs the project-picker menu.
+  void ButtonPressed();
+
+  raw_ptr<BrowserWindowInterface> browser_;
+
+  // The *other* projects listed in the menu currently shown, in menu order --
+  // kept in sync with the menu so ExecuteCommand's command ids resolve
+  // against the same list the user picked from. Excludes this window's own
+  // project.
+  std::vector<base::FilePath> menu_project_paths_;
+
+  base::ScopedObservation<ProfileAttributesStorage,
+                          ProfileAttributesStorageObserver>
+      profile_attributes_observation_{this};
+
+  std::unique_ptr<ui::SimpleMenuModel> menu_model_;
+  std::unique_ptr<views::MenuModelAdapter> menu_model_adapter_;
+  std::unique_ptr<views::MenuRunner> menu_runner_;
+};
+
+#endif  // CHROME_BROWSER_UI_VIEWS_APP_SWAP_APP_SWAP_PROJECT_SELECTOR_BUTTON_H_
