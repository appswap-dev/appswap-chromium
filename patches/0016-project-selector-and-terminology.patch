+  // strip stays the size it was while the user is in the bubble. The two
+  // segments beside this one do the same for their own bubble and menu (see
+  // TabStripComboButton::OnBubbleInitializing); without it, every click in
+  // the collapsed strip played the expand animation.
+  std::unique_ptr<ExpandOnHoverLock> expand_on_hover_lock_;
+
+  base::ScopedObservation<ProfileAttributesStorage,
+                          ProfileAttributesStorageObserver>
+      profile_attributes_observation_{this};
