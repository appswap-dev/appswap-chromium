+void TabStripComboButton::ApplyLeadingButtonWidthMode() {
+  if (!leading_button_) {
+    return;
   }
+
+  // The leading segment carries a label, so it wants the width its text
+  // needs -- except in two cases, where it falls back to the same square its
+  // neighbours are and shows its icon alone.
+  //
+  // The first is a group stacked vertically, which is what the vertical tab
+  // strip does once collapsed: a strip that narrow has no room for a name.
+  bool labelled = orientation_ == views::LayoutOrientation::kHorizontal;
+
+  // The second is a group that would not fit across the room it has. Asked
+  // for more width than exists, the vertical strip's top container gives up
+  // on a row and stacks instead, which left the name ellipsized and its two
+  // neighbours squeezed to nothing. Measured rather than estimated, because
+  // the name is the user's own project name and can be any length.
+  if (labelled && available_width_.has_value()) {
+    leading_button_->SetSizeToContents(true);
+    labelled =
+        GetPreferredSizeForOrientation(views::LayoutOrientation::kHorizontal)
+            .width() <= available_width_.value();
+  }
+
+  leading_button_->SetSizeToContents(labelled);
 }
 
