+  // Claims kToolbarAvatarButtonElementId while this button is on screen and
+  // gives it up otherwise. Both tab strips are built for every window and
+  // only one of them is ever shown, so both hold one of these buttons -- and
+  // the profile bubble anchors to whichever view the identifier resolves to,
+  // which has to be the one the user can actually see.
+  void UpdateAnchorIdentifier();
+
+  void ButtonPressed();
