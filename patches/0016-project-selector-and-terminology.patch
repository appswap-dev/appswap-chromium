diff --git a/chrome/browser/ui/views/app_swap/app_swap_project_selector_button.cc b/chrome/browser/ui/views/app_swap/app_swap_project_selector_button.cc
new file mode 100644
index 0000000000000..a4511df119f54
--- /dev/null
+++ b/chrome/browser/ui/views/app_swap/app_swap_project_selector_button.cc
@@ -0,0 +1,169 @@
+// Copyright 2026 The AppSwap Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/views/app_swap/app_swap_project_selector_button.h"
+
+#include <string>
+
+#include "base/functional/bind.h"
+#include "chrome/browser/browser_process.h"
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/browser/profiles/profile_attributes_entry.h"
+#include "chrome/browser/profiles/profile_avatar_icon_util.h"
+#include "chrome/browser/profiles/profile_manager.h"
+#include "chrome/browser/ui/browser_commands.h"
+#include "chrome/browser/ui/browser_element_identifiers.h"
+#include "chrome/browser/ui/browser_window/public/browser_window_interface.h"
+#include "chrome/browser/ui/views/frame/browser_view.h"
+#include "chrome/browser/ui/views/frame/tab_strip_region_view.h"
+#include "chrome/browser/ui/layout_constants.h"
+#include "ui/base/metadata/metadata_impl_macros.h"
+#include "ui/base/models/image_model.h"
+#include "ui/gfx/image/image.h"
+#include "ui/views/accessibility/view_accessibility.h"
+#include "ui/views/view_class_properties.h"
+
+AppSwapProjectSelectorButton::AppSwapProjectSelectorButton(
+    BrowserWindowInterface* browser)
+    : browser_(browser) {
+  SetCallback(base::BindRepeating(&AppSwapProjectSelectorButton::ButtonPressed,
+                                  base::Unretained(this)));
+  // Unlike its two neighbours, which the vertical strip labels and the
+  // horizontal one does not, this segment names something and so carries its
+  // name in both. Whether there is room is a separate question, settled by
+  // SetSizeToContents(), which TabStripComboButton drives off its
+  // orientation.
+  SetShouldShowLabel(true);
+  // What TabStripComboButton::CreateFlatEdgeButtonFor() does for the two
+  // segments it builds itself. This one is built here instead, and without
+  // it the button keeps views::LabelButton's left-aligned default: the
+  // avatar then sat against the segment's leading edge rather than in the
+  // middle of it, everywhere the segment is wider than its icon.
+  SetHorizontalAlignment(gfx::HorizontalAlignment::ALIGN_CENTER);
+  profile_attributes_observation_.Observe(
+      &g_browser_process->profile_manager()->GetProfileAttributesStorage());
+  UpdateProject();
+}
+
+AppSwapProjectSelectorButton::~AppSwapProjectSelectorButton() = default;
+
+void AppSwapProjectSelectorButton::OnProfileNameChanged(
+    const base::FilePath& profile_path,
+    const std::u16string& old_name) {
+  if (profile_path == browser_->GetProfile()->GetPath()) {
+    UpdateProject();
+  }
+}
+
+void AppSwapProjectSelectorButton::OnProfileAvatarChanged(
+    const base::FilePath& profile_path) {
+  if (profile_path == browser_->GetProfile()->GetPath()) {
+    UpdateProject();
+  }
+}
+
+void AppSwapProjectSelectorButton::OnProfileThemeColorsChanged(
+    const base::FilePath& profile_path) {
+  // A placeholder avatar is drawn in the project's own theme colors, so it
+  // has to be re-fetched when those change even though the avatar itself did
+  // not.
+  if (profile_path == browser_->GetProfile()->GetPath()) {
+    UpdateProject();
+  }
+}
+
+void AppSwapProjectSelectorButton::UpdateProject() {
+  ProfileAttributesEntry* entry =
+      g_browser_process->profile_manager()
+          ->GetProfileAttributesStorage()
+          .GetProfileAttributesWithPath(browser_->GetProfile()->GetPath());
+  const std::u16string name = entry ? entry->GetName() : u"Project";
+  SetLabelText(name);
+  // Explicit, not inherited from the label: the label is dropped whenever
+  // this segment is icon-only, which is how the collapsed vertical strip
+  // draws it, and a focusable view painting with no accessible name fails
+  // views::RunAccessibilityPaintChecks() outright.
+  SetTooltipText(name);
+  GetViewAccessibility().SetName(name);
+
+  // The project's own avatar rather than a generic glyph. It is the only
+  // thing left when the vertical strip collapses to icons, and one shared
+  // glyph there would say nothing about which project this window is.
+  //
+  // Set through SetImageModel() rather than TabStripFlatEdgeButton::
+  // UpdateIcon(), which takes vector icons only: an avatar is a bitmap, and
+  // being a bitmap it also needs no recoloring when the theme changes.
+  if (entry) {
+    const int size = GetLayoutConstant(
+        LayoutConstant::kVerticalTabStripComboButtonIconSize);
+    // Resized explicitly. GetAvatarIcon()'s size argument applies only to the
+    // placeholder silhouette; a real avatar comes back at its own resolution,
+    // which is far larger than an icon slot and overflowed the segment as a
+    // pale square hanging out of its corner.
+    const ui::ImageModel avatar =
+        ui::ImageModel::FromImage(profiles::GetSizedAvatarIcon(
+            entry->GetAvatarIcon(size, /*use_high_res_file=*/true), size, size,
+            profiles::AvatarShape::SHAPE_CIRCLE));
+    SetImageModel(views::Button::STATE_NORMAL, avatar);
+    SetImageModel(views::Button::STATE_HOVERED, avatar);
+    SetImageModel(views::Button::STATE_PRESSED, avatar);
+    SetImageModel(views::Button::STATE_DISABLED, avatar);
+  }
+}
+
+void AppSwapProjectSelectorButton::AddedToWidget() {
+  TabStripFlatEdgeButton::AddedToWidget();
+  UpdateAnchorIdentifier();
+}
+
+void AppSwapProjectSelectorButton::VisibilityChanged(views::View* starting_from,
+                                                     bool is_visible) {
+  TabStripFlatEdgeButton::VisibilityChanged(starting_from, is_visible);
+  UpdateAnchorIdentifier();
+}
+
+void AppSwapProjectSelectorButton::UpdateAnchorIdentifier() {
+  // See the header. The real AvatarToolbarButton had this cleared off of it
+  // in ToolbarView's constructor, so the only competition is the button in
+  // the other tab strip, and exactly one of the two is drawn at a time.
+  if (IsDrawn()) {
+    SetProperty(views::kElementIdentifierKey, kToolbarAvatarButtonElementId);
+  } else {
+    ClearProperty(views::kElementIdentifierKey);
+  }
+}
+
+void AppSwapProjectSelectorButton::OnThemeChanged() {
+  TabStripFlatEdgeButton::OnThemeChanged();
+  UpdateProject();
+}
+
+void AppSwapProjectSelectorButton::OnViewPropertyChanged(
+    views::View* observed_view,
+    const void* key,
+    int64_t old_value) {
+  if (key != views::kAnchoredDialogKey) {
+    return;
+  }
+
+  // The profile bubble just anchored itself here, or just let go. Hold the
+  // strip at the size it was for as long as it is up -- see the header.
+  if (!GetProperty(views::kAnchoredDialogKey)) {
+    expand_on_hover_lock_.reset();
+    return;
+  }
+  BrowserView* browser_view = BrowserView::GetBrowserViewForBrowser(browser_);
+  if (browser_view && browser_view->tab_strip_view()) {
+    expand_on_hover_lock_ =
+        browser_view->tab_strip_view()->GetExpandOnHoverLock(
+            ExpandOnHoverLockType::kKeepCurrentState);
+  }
+}
+
+void AppSwapProjectSelectorButton::ButtonPressed() {
+  chrome::ShowAvatarMenu(browser_);
+}
+
+BEGIN_METADATA(AppSwapProjectSelectorButton)
+END_METADATA
