+void RenderWidgetHostImpl::RegisterPaintOpRecordingObserver(
+    mojo::PendingReceiver<app_swap::mojom::PaintOpRecordingObserverClient>
+        paint_op_recording_observer_client_receiver,
+    mojo::PendingRemote<app_swap::mojom::PaintOpRecordingObserver>
+        paint_op_recording_observer) {
+  paint_op_recording_client_receiver_.reset();
+  paint_op_recording_client_receiver_.Bind(
+      std::move(paint_op_recording_observer_client_receiver));
+  paint_op_recording_observer_remote_.reset();
+  paint_op_recording_observer_remote_.Bind(
+      std::move(paint_op_recording_observer));
+  // Re-apply whatever enabled state was already requested -- e.g. this is
+  // a fresh renderer (crash/reload) reconnecting mid-recording.
+  if (paint_op_recording_callback_) {
+    paint_op_recording_observer_remote_->SetEnabled(true);
+  }
+}
+
+void RenderWidgetHostImpl::SetPaintOpRecordingCallback(
+    PaintOpFrameCallback callback) {
+  paint_op_recording_callback_ = std::move(callback);
+  if (paint_op_recording_observer_remote_) {
+    paint_op_recording_observer_remote_->SetEnabled(
+        !!paint_op_recording_callback_);
+  }
+}
+
+void RenderWidgetHostImpl::OnPaintOpFrame(
+    uint32_t frame_index,
+    int32_t layer_id,
+    int32_t width,
+    int32_t height,
+    const gfx::Transform& transform,
+    const std::vector<uint8_t>& paintops,
+    const std::vector<uint8_t>& strikedata,
+    const std::vector<uint8_t>& imagedata) {
+  if (!paint_op_recording_callback_) {
+    // Recording was disabled after this frame was already in flight from
+    // the renderer -- drop it rather than reopening a just-closed
+    // session.
+    return;
+  }
+  cc::SerializedPaintOpBuffer serialized;
+  serialized.paintops = paintops;
+  serialized.strikedata = strikedata;
+  serialized.imagedata = imagedata;
+  paint_op_recording_callback_.Run(frame_index, layer_id,
+                                   gfx::Size(width, height), transform,
+                                   std::move(serialized));
+}
