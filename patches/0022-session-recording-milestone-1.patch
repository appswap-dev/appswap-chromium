+// Copyright 2026 The AppSwap Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/views/app_swap/app_swap_session_recording_button.h"
+
+#include "base/functional/bind.h"
+#include "chrome/browser/app_swap/app_swap_session_recording_tab_helper.h"
+#include "chrome/browser/ui/browser_window/public/browser_window_interface.h"
+#include "chrome/browser/ui/tabs/tab_strip_model.h"
+#include "components/vector_icons/vector_icons.h"
+#include "content/public/browser/web_contents.h"
+#include "ui/base/metadata/metadata_impl_macros.h"
+#include "ui/color/color_id.h"
+#include "ui/views/background.h"
+
+namespace {
+constexpr float kActiveBadgeCornerRadius = 4.0f;
+}  // namespace
+
+AppSwapSessionRecordingButton::AppSwapSessionRecordingButton(
+    BrowserWindowInterface* browser)
+    : ToolbarButton(base::BindRepeating(
+          &AppSwapSessionRecordingButton::ButtonPressed,
+          base::Unretained(this))),
+      browser_(browser) {
+  SetVectorIcon(vector_icons::kScreenRecordIcon);
+  SetTooltipText(u"Record AppSwap session");
+  SetAccessibleName(u"Record session");
+  SetVisible(false);
+  browser_->GetTabStripModel()->AddObserver(this);
+  UpdateForActiveTab();
+}
+
+AppSwapSessionRecordingButton::~AppSwapSessionRecordingButton() {
+  browser_->GetTabStripModel()->RemoveObserver(this);
+}
+
+void AppSwapSessionRecordingButton::OnTabStripModelChanged(
+    TabStripModel* tab_strip_model,
+    const TabStripModelChange& change,
+    const TabStripSelectionChange& selection) {
+  if (selection.active_tab_changed()) {
+    UpdateForActiveTab();
+  }
+}
+
+void AppSwapSessionRecordingButton::OnTabChangedAt(
+    tabs::TabInterface* tab,
+    TabChangeType change_type) {
+  UpdateForActiveTab();
+}
+
+void AppSwapSessionRecordingButton::ButtonPressed() {
+  content::WebContents* web_contents =
+      browser_->GetTabStripModel()->GetActiveWebContents();
+  if (!web_contents) {
+    return;
+  }
+  AppSwapSessionRecordingTabHelper* helper =
+      AppSwapSessionRecordingTabHelper::GetOrCreateForWebContents(
+          web_contents);
+  if (helper->recording()) {
+    helper->StopRecording();
+  } else {
+    helper->StartRecording();
+  }
+  SetActiveVisual(helper->recording());
+}
+
+void AppSwapSessionRecordingButton::UpdateForActiveTab() {
+  content::WebContents* web_contents =
+      browser_->GetTabStripModel()->GetActiveWebContents();
+  if (!web_contents) {
+    SetVisible(false);
+    return;
+  }
+
+  // Recording only makes sense on a real http(s) page, matching
+  // AppSwapResponsiveLabButton's own applicability check.
+  const bool applicable =
+      web_contents->GetLastCommittedURL().SchemeIsHTTPOrHTTPS();
+  SetVisible(applicable);
+
+  bool recording = false;
+  if (applicable) {
+    if (AppSwapSessionRecordingTabHelper* helper =
+            AppSwapSessionRecordingTabHelper::FromWebContents(web_contents)) {
+      recording = helper->recording();
+    }
+  }
+  SetActiveVisual(recording);
+}
+
+void AppSwapSessionRecordingButton::SetActiveVisual(bool active) {
+  if (active) {
+    SetBackground(views::CreateRoundedRectBackground(
+        ui::kColorSysNeutralContainer, kActiveBadgeCornerRadius));
+  } else {
+    SetBackground(nullptr);
+  }
+}
+
+BEGIN_METADATA(AppSwapSessionRecordingButton)
+END_METADATA
