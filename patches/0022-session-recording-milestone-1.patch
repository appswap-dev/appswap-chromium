+#define THIRD_PARTY_BLINK_RENDERER_PLATFORM_WIDGET_COMPOSITING_PAINT_OP_RECORDING_OBSERVER_IMPL_H_
+
+#include "mojo/public/cpp/bindings/pending_receiver.h"
