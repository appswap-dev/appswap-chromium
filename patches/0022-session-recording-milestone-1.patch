index 0000000000000..0e02123560be9
--- /dev/null
+++ b/third_party/blink/renderer/platform/widget/compositing/paint_op_recording_observer_impl.cc
@@ -0,0 +1,96 @@
+// Copyright 2026 The AppSwap Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "third_party/blink/renderer/platform/widget/compositing/paint_op_recording_observer_impl.h"
+
+#include <utility>
+
+#include "base/memory/scoped_refptr.h"
+#include "cc/layers/layer.h"
+#include "cc/paint/display_item_list.h"
+#include "cc/paint/paint_op_capture_serializer.h"
+#include "cc/trees/layer_tree_host.h"
+#include "cc/trees/property_tree.h"
+
+namespace blink {
+
+namespace {
+
+// mojom's `array<uint8>` maps to blink::Vector<uint8_t> in the -blink
+// generated bindings, not std::vector<uint8_t> --
+// cc::SerializePaintOpBufferForCapture() (a plain, non-Blink cc/paint
+// helper, shared with the debug capture path in content/renderer/
+// gpu_benchmarking_extension.cc) necessarily returns the latter, so this
+// copies once at the renderer/mojo boundary.
+Vector<uint8_t> ToBlinkVector(const std::vector<uint8_t>& data) {
+  Vector<uint8_t> result;
+  result.Append(data.data(), static_cast<wtf_size_t>(data.size()));
+  return result;
+}
+
+}  // namespace
+
+PaintOpRecordingObserverImpl::PaintOpRecordingObserverImpl() = default;
+PaintOpRecordingObserverImpl::~PaintOpRecordingObserverImpl() = default;
+
+void PaintOpRecordingObserverImpl::Bind(
+    mojo::PendingReceiver<app_swap::mojom::blink::PaintOpRecordingObserver>
+        receiver,
+    mojo::PendingRemote<app_swap::mojom::blink::PaintOpRecordingObserverClient>
+        client) {
+  receiver_.Bind(std::move(receiver));
+  client_.Bind(std::move(client));
+}
+
+void PaintOpRecordingObserverImpl::SetEnabled(bool enabled) {
+  enabled_ = enabled;
+}
+
+void PaintOpRecordingObserverImpl::OnCommit(const cc::Layer* root_layer) {
+  if (!enabled_ || !client_ || !root_layer) {
+    return;
+  }
+
+  const uint32_t frame_index = frame_index_++;
+
+  const cc::ScrollTree& scroll_tree =
+      root_layer->layer_tree_host()->property_trees()->scroll_tree();
+
+  int layer_id = 0;
+  for (auto* layer : *root_layer->layer_tree_host()) {
+    scoped_refptr<cc::DisplayItemList> display_list =
+        layer->CapturePaintOpDisplayListForTesting();
+    if (!display_list) {
+      continue;
+    }
+
+    // A real page can have scrollable subtrees (kDrawScrollingContents
+    // ops) whose offsets MUST be supplied at serialize time -- confirmed
+    // by an actual crash (cc/paint/paint_op_buffer_serializer.cc:287,
+    // hit by focusing a search box on a real page) when this was
+    // omitted. See SerializePaintOpBufferForCapture()'s own comment for
+    // why cc/paint can't build this map itself.
+    cc::ScrollOffsetMap raster_inducing_scroll_offsets;
+    for (auto& [element_id, unused] :
+        display_list->raster_inducing_scrolls()) {
+      raster_inducing_scroll_offsets[element_id] =
+          scroll_tree.current_scroll_offset(element_id);
+    }
+
+    std::optional<cc::SerializedPaintOpBuffer> serialized =
+        cc::SerializePaintOpBufferForCapture(display_list->paint_op_buffer(),
+                                             &raster_inducing_scroll_offsets);
+    if (serialized) {
+      client_->OnPaintOpFrame(frame_index, layer_id, layer->bounds().width(),
+                              layer->bounds().height(),
+                              layer->ScreenSpaceTransform(),
+                              ToBlinkVector(serialized->paintops),
+                              ToBlinkVector(serialized->strikedata),
+                              ToBlinkVector(serialized->imagedata));
+    }
+    ++layer_id;
+  }
+}
+
+}  // namespace blink
