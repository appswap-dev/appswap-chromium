@@ -0,0 +1,105 @@
+// Copyright 2026 The AppSwap Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_APP_SWAP_APP_SWAP_SESSION_RECORDING_TAB_HELPER_H_
+#define CHROME_BROWSER_APP_SWAP_APP_SWAP_SESSION_RECORDING_TAB_HELPER_H_
+
+#include <memory>
+
+#include "base/memory/weak_ptr.h"
+#include "cc/paint/paint_op_capture_serializer.h"
+#include "content/public/browser/web_contents_observer.h"
+#include "content/public/browser/web_contents_user_data.h"
+#include "ui/gfx/geometry/size.h"
+#include "ui/gfx/geometry/transform.h"
+
+class AppSwapSessionRecordingWriter;
+
+namespace content {
+class Page;
+class WebContents;
+}  // namespace content
+
+// Tracks, per tab, whether AppSwap session recording is toggled on, and
+// owns the AppSwapSessionRecordingWriter for the current session while
+// active. See the design notes this was built from (PaintOp-based session
+// recording, Milestone 1) for full context: this is the browser-side half
+// of a renderer -> browser paint-op capture pipeline built directly on
+// top of the SerializePaintOpBufferForCapture() sequence already proven
+// (and shared with) the debug chrome.gpuBenchmarking.dumpPaintOpBuffer()
+// path in content/renderer/gpu_benchmarking_extension.cc.
+//
+// STATUS: end-to-end wired. StartRecording() enables continuous capture on
+// the primary main frame's widget via content::RenderWidgetHost::
+// SetPaintOpRecordingCallback() (bound to OnFrameCaptured() below), which
+// rides the renderer<->browser app_swap.mojom.PaintOpRecordingObserver
+// [Client] pipe pair -- see third_party/blink/public/mojom/app_swap/
+// paint_op_recording.mojom for the full design note, and
+// blink::PaintOpRecordingObserverImpl (third_party/blink/renderer/
+// platform/widget/compositing/) for the renderer-side hook into
+// LayerTreeView::WillCommit(). This transport touches core content/blink
+// classes (RenderWidgetHostImpl, blink::WidgetBase, blink.mojom.WidgetHost)
+// that couldn't be verified by building (per this session's standing "I
+// don't build" rule) -- real build/runtime issues surfacing here would not
+// be a surprise, the way Phase 0's own real build fixes weren't.
+//
+// Milestone 1 scope: capture + disk storage only, manual on/off toggle.
+// No replay, no input/DOM/navigation capture, no WebUI session browser --
+// see the plan's own non-goals list.
+class AppSwapSessionRecordingTabHelper
+    : public content::WebContentsObserver,
+      public content::WebContentsUserData<AppSwapSessionRecordingTabHelper> {
+ public:
+  ~AppSwapSessionRecordingTabHelper() override;
+
+  AppSwapSessionRecordingTabHelper(const AppSwapSessionRecordingTabHelper&) =
+      delete;
+  AppSwapSessionRecordingTabHelper& operator=(
+      const AppSwapSessionRecordingTabHelper&) = delete;
+
+  bool recording() const { return writer_ != nullptr; }
+
+  // Starts a new recording session rooted at this tab's current
+  // last-committed URL. No-op if already recording.
+  void StartRecording();
+
+  // Ends the current recording session, if any. No-op if not recording.
+  void StopRecording();
+
+  // Called once per captured, changed layer per commit while recording is
+  // active -- the browser-side sink for the renderer -> browser recording
+  // Mojo interface (bound/dispatched elsewhere; this class only owns what
+  // happens to a frame once it arrives). No-op if not currently
+  // recording, so a frame that was in flight when StopRecording() was
+  // called is silently dropped rather than reopening a just-closed
+  // session.
+  void OnFrameCaptured(uint32_t frame_index,
+                       int layer_id,
+                       const gfx::Size& bounds,
+                       const gfx::Transform& transform,
+                       cc::SerializedPaintOpBuffer serialized);
+
+ private:
+  friend class content::WebContentsUserData<AppSwapSessionRecordingTabHelper>;
+  explicit AppSwapSessionRecordingTabHelper(content::WebContents* web_contents);
+
+  // content::WebContentsObserver:
+  void PrimaryPageChanged(content::Page& page) override;
+
+  // Looks up (via FindAppSwapAppForUrl() and, if that matches,
+  // AppSwapUpdateAvailableTabHelper::committed_version()) and logs the app
+  // package/version currently serving this tab's last-committed URL, if
+  // any -- called from both StartRecording() and PrimaryPageChanged() so
+  // the navigation log always starts with an entry for the URL a
+  // recording began on, not just subsequent navigations.
+  void LogCurrentNavigation();
+
+  std::unique_ptr<AppSwapSessionRecordingWriter> writer_;
+
+  base::WeakPtrFactory<AppSwapSessionRecordingTabHelper> weak_factory_{this};
+
+  WEB_CONTENTS_USER_DATA_KEY_DECL();
+};
+
+#endif  // CHROME_BROWSER_APP_SWAP_APP_SWAP_SESSION_RECORDING_TAB_HELPER_H_
