new file mode 100644
index 0000000000000..75c96a2d8ba05
--- /dev/null
+++ b/chrome/browser/app_swap/app_swap_session_recording_writer.h
@@ -0,0 +1,117 @@
+// Copyright 2026 The AppSwap Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_APP_SWAP_APP_SWAP_SESSION_RECORDING_WRITER_H_
+#define CHROME_BROWSER_APP_SWAP_APP_SWAP_SESSION_RECORDING_WRITER_H_
+
+#include <memory>
+#include <string>
+
+#include "base/files/file_path.h"
+#include "base/memory/scoped_refptr.h"
+#include "base/task/sequenced_task_runner.h"
+#include "base/time/time.h"
+#include "cc/paint/paint_op_capture_serializer.h"
+#include "ui/gfx/geometry/size.h"
+#include "ui/gfx/geometry/transform.h"
+#include "url/gurl.h"
+
+// Writes one recording session's captured paint-op frames to disk as they
+// arrive, under a new <profile_path>/AppSwap/Recordings/<session-id>/
+// directory, plus a small manifest describing the session.
+//
+// This is a NEW storage mechanism for this codebase's AppSwap additions --
+// unlike AppSwapConfigStore (whole-file JSON rewrite on every save, the
+// right fit for small settings blobs like apps.json/route_groups.json) a
+// session recording grows continuously and unboundedly while active, so
+// every frame is APPENDED to a segment file rather than re-serializing and
+// rewriting the whole recording on each capture. Segments roll over at
+// kMaxSegmentBytes so no single file grows unbounded and a partial/corrupt
+// tail segment can't invalidate everything captured before it. Segment
+// files are named sequentially (segment_0000.paintopseg,
+// segment_0001.paintopseg, ...) so they're discoverable and orderable by a
+// directory listing alone -- the manifest only records session-level
+// metadata, not the segment list.
+//
+// A segment record does NOT embed a layer's full paintops/strikedata/image
+// bytes inline -- confirmed by real usage (scrolling an image-heavy page
+// produced tens of MB in a few seconds, since the same still-visible
+// photos were being fully re-captured and re-stored on every commit) that
+// this needed real deduplication, not just a smaller format. Instead each
+// record stores content hashes, resolved against a single
+// content-addressed blob store for the whole session (blobs.dat, see
+// WriteBlobIfNew()): identical content -- the same photo redrawn commit
+// after commit, or a genuinely static layer's unchanged paintops -- is
+// gzip-compressed and stored exactly once, regardless of how many commits
+// reference it. This works without requiring any cross-commit stability
+// from the ids DrawImageOp already embeds in paintops (RealImageProvider,
+// cc/paint/paint_op_capture_serializer.cc, still assigns a fresh id every
+// single capture, unchanged) -- playback already rebuilds a fresh
+// per-commit transfer-cache mapping regardless, so all that's needed is
+// resolving *this* commit's own ids to the right bytes, which a
+// (id, content_hash) reference list plus the shared blob store already
+// gives for free, with instant lookup by hash regardless of which commit
+// first introduced that content.
+//
+// All disk I/O runs on a dedicated SequencedTaskRunner (mirroring
+// AppSwapConfigStore's own threading convention, see that class's own
+// comment) -- WriteFrame() posts to it and returns immediately.
+class AppSwapSessionRecordingWriter {
+ public:
+  // Maximum size a single segment file is allowed to reach before rolling
+  // over to a new one. Not a hard per-write cap -- one frame's bytes are
+  // never split across segments, so a single frame can still push a
+  // segment slightly past this.
+  static constexpr int64_t kMaxSegmentBytes = 16 * 1024 * 1024;
+
+  // `recordings_dir` is <profile_path>/AppSwap/Recordings -- this creates
+  // and owns a new subdirectory under it for this one session.
+  AppSwapSessionRecordingWriter(const base::FilePath& recordings_dir,
+                                const GURL& start_url);
+  ~AppSwapSessionRecordingWriter();
+
+  AppSwapSessionRecordingWriter(const AppSwapSessionRecordingWriter&) =
+      delete;
+  AppSwapSessionRecordingWriter& operator=(
+      const AppSwapSessionRecordingWriter&) = delete;
+
+  // Appends one captured layer's serialized paint ops as a new frame
+  // record in the current segment. Cheap to call frequently -- the actual
+  // file write happens on the background sequence. `frame_index` is
+  // shared by every layer captured in the same commit (see
+  // paint_op_recording.mojom's OnPaintOpFrame comment); `transform` is
+  // that layer's screen-space transform at capture time, needed to
+  // composite frames back together for playback.
+  void WriteFrame(uint32_t frame_index,
+                  int layer_id,
+                  base::Time capture_time,
+                  const gfx::Size& bounds,
+                  const gfx::Transform& transform,
+                  cc::SerializedPaintOpBuffer serialized);
+
+  // Appends one entry to this session's navigation log (navigations.jsonl)
+  // -- the URL a tab was on, and (if it's an AppSwap-routed npm app) the
+  // package/version serving it, at `time`. Cheap to call frequently; the
+  // actual file write happens on the background sequence. `package_name`
+  // and `version` are both empty for a plain, non-AppSwap-routed page.
+  void WriteNavigation(base::Time time,
+                       const GURL& url,
+                       const std::string& package_name,
+                       const std::string& version);
+
+  const base::FilePath& session_dir() const { return session_dir_; }
+
+ private:
+  class BackgroundWriter;
+
+  base::FilePath session_dir_;
+  scoped_refptr<base::SequencedTaskRunner> task_runner_;
+  // Owns all segment-file state; only ever touched on task_runner_. The
+  // custom deleter runs ~BackgroundWriter() (which flushes/closes the
+  // current segment) on that same sequence rather than wherever this
+  // writer itself is destroyed.
+  std::unique_ptr<BackgroundWriter, base::OnTaskRunnerDeleter> background_;
+};
+
+#endif  // CHROME_BROWSER_APP_SWAP_APP_SWAP_SESSION_RECORDING_WRITER_H_
