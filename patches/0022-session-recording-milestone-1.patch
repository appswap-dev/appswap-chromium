+
 void LayerTreeView::DidCommit(int source_frame_number,
                               base::TimeTicks commit_start_time,
                               base::TimeTicks commit_finish_time) {
+  // AppSwap session recording (Milestone 1): needs the real cc::Layer
+  // tree via layer_tree_host_->root_layer() -- confirmed by an actual
+  // crash (cc/trees/layer_tree_host.cc:530, "Check failed:
+  // !inside_will_commit_") that this is NOT safe to call from
+  // WillCommit() (root_layer()'s non-const overload calls
+  // thread_unsafe_commit_state(), which calls
+  // WaitForProtectedSequenceCompletion() -> WaitForCommitCompletion(),
+  // which CHECKs it isn't invoked while cc::LayerTreeHost::inside_will_commit_
+  // is true -- true for the *entire* duration of the client_->WillCommit()
+  // call, unconditionally, regardless of whether recording is even
+  // enabled). DidCommit() runs after that guard is released, so this is
+  // the correct hook instead. Placed after the staleness check below
+  // (not before) so a commit belonging to a previous, already-detached
+  // delegate doesn't get captured. See PaintOpRecordingObserverImpl's own
+  // class comment for why this isn't routed through a formal
+  // cc::RenderFrameMetadataObserver-style interface instead. Cheap no-op
+  // (a null check, then a disabled-check inside OnCommit itself) when
+  // recording isn't active for this widget.
   if (!delegate_ ||
       source_frame_number < first_source_frame_for_current_delegate_) {
     return;
   }
+  if (paint_op_recording_observer_) {
+    paint_op_recording_observer_->OnCommit(layer_tree_host_->root_layer());
+  }
   delegate_->DidCommitCompositorFrame(commit_start_time, commit_finish_time);
 }
 
