index 0000000000000..8a5075c416762
--- /dev/null
+++ b/chrome/browser/app_swap/app_swap_session_recording_writer.cc
@@ -0,0 +1,362 @@
+// Copyright 2026 The AppSwap Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/app_swap/app_swap_session_recording_writer.h"
+
+#include <array>
+#include <unordered_set>
+#include <utility>
+
+#include "base/containers/span.h"
+#include "base/files/file.h"
+#include "base/files/file_util.h"
+#include "base/files/important_file_writer.h"
+#include "base/functional/bind.h"
+#include "base/hash/hash.h"
+#include "base/json/json_writer.h"
+#include "base/logging.h"
+#include "base/task/thread_pool.h"
+#include "base/unguessable_token.h"
+#include "base/values.h"
+#include "chrome/browser/app_swap/app_swap_session_recording_paths.h"
+#include "third_party/zlib/google/compression_utils.h"
+
+namespace {
+
+constexpr base::FilePath::CharType kManifestFileName[] =
+    FILE_PATH_LITERAL("manifest.json");
+
+}  // namespace
+
+// All I/O happens on the writer's dedicated SequencedTaskRunner -- this
+// class has no thread-safety of its own and relies entirely on that.
+class AppSwapSessionRecordingWriter::BackgroundWriter {
+ public:
+  // Trivial and I/O-free on purpose -- this is constructed synchronously
+  // on whatever thread owns the AppSwapSessionRecordingWriter (typically
+  // the UI thread), so it must not touch disk. Initialize() does the
+  // actual directory/manifest setup, posted to run on the background
+  // sequence immediately after construction (see the .h file's threading
+  // comment) -- ordering versus any WriteFrame() call is guaranteed by
+  // both being posted to the same SequencedTaskRunner in that order.
+  explicit BackgroundWriter(const base::FilePath& session_dir)
+      : session_dir_(session_dir) {}
+
+  ~BackgroundWriter() {
+    current_segment_.Close();
+    blobs_file_.Close();
+  }
+
+  void Initialize(const GURL& start_url) {
+    if (!base::CreateDirectory(session_dir_)) {
+      LOG(ERROR) << "AppSwap: failed to create recording directory "
+                 << session_dir_;
+      failed_ = true;
+      return;
+    }
+    WriteManifest(start_url);
+  }
+
+  void WriteFrame(uint32_t frame_index,
+                  int layer_id,
+                  base::Time capture_time,
+                  const gfx::Size& bounds,
+                  const gfx::Transform& transform,
+                  cc::SerializedPaintOpBuffer serialized) {
+    if (failed_) {
+      return;
+    }
+
+    const uint64_t paintops_hash = WriteBlobIfNew(base::span(serialized.paintops));
+    const uint64_t strikedata_hash =
+        WriteBlobIfNew(base::span(serialized.strikedata));
+    if (failed_) {
+      return;
+    }
+
+    // Each image is deduplicated individually, not as part of one combined
+    // imagedata blob -- confirmed necessary because the SET of images
+    // visible in a commit drifts as new content scrolls into view, so a
+    // whole-blob hash would rarely match even when most of the individual
+    // photos are unchanged from an earlier commit.
+    std::vector<cc::ImageDataEntry> image_entries =
+        cc::ParseImageData(base::span(serialized.imagedata));
+    std::vector<std::pair<uint32_t, uint64_t>> image_refs;
+    image_refs.reserve(image_entries.size());
+    for (const cc::ImageDataEntry& entry : image_entries) {
+      image_refs.emplace_back(entry.id, WriteBlobIfNew(entry.bytes));
+      if (failed_) {
+        return;
+      }
+    }
+
+    // Record layout (all fields fixed-size and little-endian on every
+    // platform this fork ships on -- not attempting cross-endianness
+    // portability here, this format never leaves the machine that wrote
+    // it):
+    //   uint32 frame_index (shared by every layer of one commit)
+    //   uint32 layer_id
+    //   int64  capture_time (milliseconds since Unix epoch)
+    //   uint32 width
+    //   uint32 height
+    //   double transform[16] (column-major, gfx::Transform::GetColMajor())
+    //   uint64 paintops_hash    -- resolved against blobs.dat, see
+    //   uint64 strikedata_hash     WriteBlobIfNew()'s own comment
+    //   uint32 image_ref_count
+    //   [image_ref_count * (uint32 id, uint64 content_hash)]
+    // Prefixed by its own uint32 total-length so a reader can find record
+    // boundaries in the segment file without parsing each record's inner
+    // fields first.
+    const uint32_t frame_index_field = frame_index;
+    const uint32_t layer_id_u32 = static_cast<uint32_t>(layer_id);
+    const int64_t capture_time_ms =
+        capture_time.InMillisecondsSinceUnixEpoch();
+    const uint32_t width = static_cast<uint32_t>(bounds.width());
+    const uint32_t height = static_cast<uint32_t>(bounds.height());
+    std::array<double, 16> transform_col_major;
+    transform.GetColMajor(base::span(transform_col_major));
+    const uint32_t image_ref_count =
+        static_cast<uint32_t>(image_refs.size());
+
+    const uint32_t record_len = static_cast<uint32_t>(
+        sizeof(frame_index_field) + sizeof(layer_id_u32) +
+        sizeof(capture_time_ms) + sizeof(width) + sizeof(height) +
+        sizeof(transform_col_major) + sizeof(paintops_hash) +
+        sizeof(strikedata_hash) + sizeof(image_ref_count) +
+        image_refs.size() * (sizeof(uint32_t) + sizeof(uint64_t)));
+
+    if (!EnsureSegmentOpenForWrite(sizeof(record_len) + record_len)) {
+      return;
+    }
+
+    bool ok =
+        current_segment_.WriteAtCurrentPosAndCheck(
+            base::byte_span_from_ref(record_len)) &&
+        current_segment_.WriteAtCurrentPosAndCheck(
+            base::byte_span_from_ref(frame_index_field)) &&
+        current_segment_.WriteAtCurrentPosAndCheck(
+            base::byte_span_from_ref(layer_id_u32)) &&
+        current_segment_.WriteAtCurrentPosAndCheck(
+            base::byte_span_from_ref(capture_time_ms)) &&
+        current_segment_.WriteAtCurrentPosAndCheck(
+            base::byte_span_from_ref(width)) &&
+        current_segment_.WriteAtCurrentPosAndCheck(
+            base::byte_span_from_ref(height)) &&
+        current_segment_.WriteAtCurrentPosAndCheck(
+            base::as_byte_span(base::allow_nonunique_obj,
+                              transform_col_major)) &&
+        current_segment_.WriteAtCurrentPosAndCheck(
+            base::byte_span_from_ref(paintops_hash)) &&
+        current_segment_.WriteAtCurrentPosAndCheck(
+            base::byte_span_from_ref(strikedata_hash)) &&
+        current_segment_.WriteAtCurrentPosAndCheck(
+            base::byte_span_from_ref(image_ref_count));
+    for (const auto& [id, hash] : image_refs) {
+      ok = ok &&
+           current_segment_.WriteAtCurrentPosAndCheck(
+               base::byte_span_from_ref(id)) &&
+           current_segment_.WriteAtCurrentPosAndCheck(
+               base::byte_span_from_ref(hash));
+    }
+    if (!ok) {
+      LOG(ERROR) << "AppSwap: failed writing recording frame to "
+                 << current_segment_path_;
+      return;
+    }
+    current_segment_bytes_ += sizeof(record_len) + record_len;
+  }
+
+  void WriteNavigation(base::Time time,
+                       const GURL& url,
+                       const std::string& package_name,
+                       const std::string& version) {
+    if (failed_) {
+      return;
+    }
+    base::DictValue entry;
+    entry.Set("time_ms",
+              static_cast<double>(time.InMillisecondsSinceUnixEpoch()));
+    entry.Set("url", url.spec());
+    entry.Set("package_name", package_name);
+    entry.Set("version", version);
+    std::string json;
+    if (!base::JSONWriter::Write(entry, &json)) {
+      LOG(ERROR) << "AppSwap: failed to serialize navigation entry for "
+                 << session_dir_;
+      return;
+    }
+    json += "\n";
+    // NOT base::AppendToFile(): on Windows that opens with OPEN_EXISTING,
+    // which fails outright if navigations.jsonl doesn't exist yet -- true
+    // for the very first entry of every session, confirmed by actually
+    // hitting "failed to append navigation entry" on a real recording.
+    // FLAG_OPEN_ALWAYS creates it on that first call and just opens it on
+    // every one after.
+    base::File file(GetAppSwapRecordingNavigationsPath(session_dir_),
+                    base::File::FLAG_OPEN_ALWAYS | base::File::FLAG_APPEND);
+    if (!file.IsValid() ||
+        !file.WriteAtCurrentPosAndCheck(base::as_byte_span(json))) {
+      LOG(ERROR) << "AppSwap: failed to append navigation entry in "
+                 << session_dir_;
+    }
+  }
+
+ private:
+  // Opens the current segment file if needed, rolling over to a new one
+  // first if writing `additional_bytes` would push the current segment
+  // past kMaxSegmentBytes. A single frame is never split across segments,
+  // even if it alone exceeds kMaxSegmentBytes.
+  bool EnsureSegmentOpenForWrite(size_t additional_bytes) {
+    if (current_segment_.IsValid() &&
+        current_segment_bytes_ + additional_bytes >
+            static_cast<size_t>(
+                AppSwapSessionRecordingWriter::kMaxSegmentBytes)) {
+      current_segment_.Close();
+    }
+    if (current_segment_.IsValid()) {
+      return true;
+    }
+
+    current_segment_path_ =
+        GetAppSwapRecordingSegmentPath(session_dir_, next_segment_index_++);
+    current_segment_ = base::File(
+        current_segment_path_,
+        base::File::FLAG_CREATE_ALWAYS | base::File::FLAG_WRITE);
+    current_segment_bytes_ = 0;
+    if (!current_segment_.IsValid()) {
+      LOG(ERROR) << "AppSwap: failed to open recording segment "
+                 << current_segment_path_;
+      failed_ = true;
+      return false;
+    }
+    return true;
+  }
+
+  // Content-addressed dedup for paintops/strikedata/each image (see this
+  // class's own header comment): computes a 64-bit hash of `content`,
+  // checks it against every hash already written this session, and only
+  // gzip-compresses and appends it to blobs.dat on a miss -- either way,
+  // returns the hash the caller should store as this content's reference.
+  // blobs.dat format: [uint64 hash][uint32 compressed_len][compressed
+  // bytes], repeated, append-only, never rolled over (an acceptable first
+  // cut -- dedup + compression should already keep typical sessions well
+  // under what today's un-deduped segments hit). Collision risk at
+  // base::FastHash's 64 bits is negligible at one session's scale of
+  // thousands, not billions, of distinct blobs.
+  uint64_t WriteBlobIfNew(base::span<const uint8_t> content) {
+    const uint64_t hash = static_cast<uint64_t>(base::FastHash(content));
+    if (known_hashes_.contains(hash)) {
+      return hash;
+    }
+    known_hashes_.insert(hash);
+
+    std::string compressed;
+    if (!compression::GzipCompress(content, &compressed)) {
+      LOG(ERROR) << "AppSwap: failed to compress recording blob in "
+                 << session_dir_;
+      failed_ = true;
+      return hash;
+    }
+
+    if (!blobs_file_.IsValid()) {
+      blobs_file_ = base::File(
+          GetAppSwapRecordingBlobsPath(session_dir_),
+          base::File::FLAG_CREATE_ALWAYS | base::File::FLAG_WRITE);
+      if (!blobs_file_.IsValid()) {
+        LOG(ERROR) << "AppSwap: failed to open recording blob store in "
+                   << session_dir_;
+        failed_ = true;
+        return hash;
+      }
+    }
+
+    const uint32_t compressed_len = static_cast<uint32_t>(compressed.size());
+    if (!blobs_file_.WriteAtCurrentPosAndCheck(
+            base::byte_span_from_ref(hash)) ||
+        !blobs_file_.WriteAtCurrentPosAndCheck(
+            base::byte_span_from_ref(compressed_len)) ||
+        !blobs_file_.WriteAtCurrentPosAndCheck(
+            base::as_byte_span(compressed))) {
+      LOG(ERROR) << "AppSwap: failed writing recording blob in "
+                 << session_dir_;
+      failed_ = true;
+    }
+    return hash;
+  }
+
+  void WriteManifest(const GURL& start_url) {
+    base::DictValue manifest;
+    manifest.Set("start_time_ms",
+                 static_cast<double>(
+                     base::Time::Now().InMillisecondsSinceUnixEpoch()));
+    manifest.Set("start_url", start_url.spec());
+    std::string json;
+    if (!base::JSONWriter::Write(manifest, &json) ||
+        !base::ImportantFileWriter::WriteFileAtomically(
+            session_dir_.Append(kManifestFileName), json)) {
+      LOG(ERROR) << "AppSwap: failed to write recording manifest in "
+                 << session_dir_;
+    }
+  }
+
+  base::FilePath session_dir_;
+  base::File current_segment_;
+  base::FilePath current_segment_path_;
+  size_t current_segment_bytes_ = 0;
+  int next_segment_index_ = 0;
+  // blobs.dat -- lazily opened on the first WriteBlobIfNew() call that
+  // actually needs to write something (a session with nothing to record
+  // yet, e.g. immediately stopped, need not create it at all).
+  base::File blobs_file_;
+  // Every hash already written to blobs.dat this session -- checked by
+  // WriteBlobIfNew() before writing anything new. Reset only by
+  // destroying this BackgroundWriter (one instance is always one
+  // recording session).
+  std::unordered_set<uint64_t> known_hashes_;
+  bool failed_ = false;
+};
+
+AppSwapSessionRecordingWriter::AppSwapSessionRecordingWriter(
+    const base::FilePath& recordings_dir,
+    const GURL& start_url)
+    : session_dir_(recordings_dir.AppendASCII(
+          base::UnguessableToken::Create().ToString())),
+      task_runner_(base::ThreadPool::CreateSequencedTaskRunner(
+          {base::MayBlock(), base::TaskPriority::USER_VISIBLE,
+           base::TaskShutdownBehavior::BLOCK_SHUTDOWN})),
+      background_(new BackgroundWriter(session_dir_),
+                  base::OnTaskRunnerDeleter(task_runner_)) {
+  task_runner_->PostTask(
+      FROM_HERE, base::BindOnce(&BackgroundWriter::Initialize,
+                                base::Unretained(background_.get()),
+                                start_url));
+}
+
+AppSwapSessionRecordingWriter::~AppSwapSessionRecordingWriter() = default;
+
+void AppSwapSessionRecordingWriter::WriteFrame(
+    uint32_t frame_index,
+    int layer_id,
+    base::Time capture_time,
+    const gfx::Size& bounds,
+    const gfx::Transform& transform,
+    cc::SerializedPaintOpBuffer serialized) {
+  task_runner_->PostTask(
+      FROM_HERE,
+      base::BindOnce(&BackgroundWriter::WriteFrame,
+                     base::Unretained(background_.get()), frame_index,
+                     layer_id, capture_time, bounds, transform,
+                     std::move(serialized)));
+}
+
+void AppSwapSessionRecordingWriter::WriteNavigation(
+    base::Time time,
+    const GURL& url,
+    const std::string& package_name,
+    const std::string& version) {
+  task_runner_->PostTask(
+      FROM_HERE, base::BindOnce(&BackgroundWriter::WriteNavigation,
+                                base::Unretained(background_.get()), time,
+                                url, package_name, version));
+}
