+// Copyright 2026 The AppSwap Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+module app_swap.mojom;
+
+import "ui/gfx/mojom/transform.mojom";
+
+// AppSwap session recording (Milestone 1): a per-widget, toggleable,
+// best-effort channel for the renderer to push captured cc::PaintOpBuffer
+// content (see cc/paint/paint_op_capture_serializer.h -- the same
+// serialization sequence the debug chrome.gpuBenchmarking.
+// dumpPaintOpBuffer() path in content/renderer/gpu_benchmarking_extension.cc
+// already uses) to the browser process, which has the real file-system
+// access needed to persist it (see chrome/browser/app_swap/
+// app_swap_session_recording_writer.h -- renderer file I/O is normally
+// sandbox-blocked, so unlike the debug dump path this cannot write to disk
+// itself).
+//
+// Modeled structurally on cc.mojom.RenderFrameMetadataObserver /
+// RenderFrameMetadataObserverClient (cc/mojom/render_frame_metadata.mojom)
+// -- the closest existing precedent in this checkout for "toggleable,
+// high-frequency (up to once per compositor commit), best-effort,
+// renderer-pushes-to-browser" traffic. Like that pair, this is meant to be
+// bootstrapped over a DEDICATED, non-frame-associated mojo::Remote/
+// mojo::Receiver pipe -- handed over via a one-shot call on the existing
+// blink.mojom.WidgetHost/blink.mojom.Widget associated channel (see
+// RegisterRenderFrameMetadataObserver in
+// third_party/blink/public/mojom/widget/platform_widget.mojom, and its
+// real bootstrap call site, blink::WidgetBase::CreateRenderFrameObserver(),
+// third_party/blink/renderer/platform/widget/widget_base.cc) -- rather
+// than riding RenderFrameHostImpl::GetRemoteAssociatedInterfaces(), which
+// is meant for navigation/frame-ordered traffic and would couple this
+// channel's ordering to that.
+//
+// STATUS: fully wired end to end. RegisterPaintOpRecordingObserver() lives
+// on blink.mojom.WidgetHost (this module's own import target, added
+// alongside RegisterRenderFrameMetadataObserver just above it in that
+// file); content::RenderWidgetHostImpl implements it and the
+// PaintOpRecordingObserverClient methods
+// (content/browser/renderer_host/render_widget_host_impl.{h,cc}); the
+// renderer-side bootstrap is blink::WidgetBase::
+// CreatePaintOpRecordingObserver() (third_party/blink/renderer/platform/
+// widget/widget_base.{h,cc}), called once from InitializeCompositing()
+// right after a fresh LayerTreeView is initialized; the actual per-commit
+// hook is blink::PaintOpRecordingObserverImpl (third_party/blink/
+// renderer/platform/widget/compositing/), OWNED BY LayerTreeView itself
+// (not WidgetBase) specifically so it moves together with LayerTreeView
+// across a widget reattachment -- see LayerTreeView::
+// SetPaintOpRecordingObserver()'s own comment for why that ownership
+// choice matters. This touches core content/blink classes that couldn't
+// be verified by building (per this session's standing "I don't build"
+// rule) -- real build/runtime issues surfacing here would not be a
+// surprise, the way Phase 0's own real build fixes weren't.
+
+// Implemented by the renderer (a new PaintOpRecordingObserverImpl,
+// modeled on blink::RenderFrameMetadataObserverImpl, hooked into
+// blink::WidgetBase's existing LayerTreeViewDelegate overrides -- the
+// real, already-firing per-commit callback confirmed via direct source
+// reading, see WidgetBase : public LayerTreeViewDelegate).
+interface PaintOpRecordingObserver {
+  // Enables or disables capture. Disabled by default -- when disabled,
+  // the renderer-side hook does no work at all (no layer-tree walk, no
+  // serialization), so a tab with this feature off pays zero cost.
+  SetEnabled(bool enabled);
+};
+
+// Implemented by the browser (owned analogously to
+// content::RenderFrameMetadataProviderImpl, i.e. per-widget --
+// content::RenderWidgetHostImpl -- forwarding into whichever tab-level
+// sink is currently recording, e.g. AppSwapSessionRecordingTabHelper::
+// OnFrameCaptured).
+interface PaintOpRecordingObserverClient {
+  // Called once per changed PictureLayer per committed compositor frame,
+  // while enabled. `layer_id` is assigned by the renderer in per-commit
+  // layer-tree iteration order -- unique only within one captured commit,
+  // NOT a stable identifier for "the same layer" across multiple calls,
+  // so it must not be used to correlate frames beyond a single commit.
+  // `frame_index` IS stable across calls within one commit -- it's a
+  // simple counter incremented once per OnCommit(), shared by every layer
+  // emitted during that commit, and is how a later reader regroups
+  // per-layer records back into "everything that belongs to one frame"
+  // (needed for playback compositing). `transform` is that layer's
+  // cc::Layer::ScreenSpaceTransform() at capture time, needed to place it
+  // correctly when compositing a frame's layers back together during
+  // playback. `paintops`/`strikedata`/`imagedata` are exactly what
+  // cc::SerializePaintOpBufferForCapture() (cc/paint/
+  // paint_op_capture_serializer.h) produces -- see that function's own
+  // comment for the format.
+  OnPaintOpFrame(uint32 frame_index,
+                int32 layer_id,
+                int32 width,
+                int32 height,
+                gfx.mojom.Transform transform,
+                array<uint8> paintops,
+                array<uint8> strikedata,
+                array<uint8> imagedata);
+};
