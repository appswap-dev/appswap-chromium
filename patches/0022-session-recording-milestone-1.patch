@@ -0,0 +1,118 @@
+// Copyright 2026 The AppSwap Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/app_swap/app_swap_session_recording_tab_helper.h"
+
+#include <utility>
+
+#include "base/files/file_path.h"
+#include "base/functional/bind.h"
+#include "base/time/time.h"
+#include "chrome/browser/app_swap/app_swap_route_matcher.h"
+#include "chrome/browser/app_swap/app_swap_session_recording_paths.h"
+#include "chrome/browser/app_swap/app_swap_session_recording_writer.h"
+#include "chrome/browser/app_swap/app_swap_update_available_tab_helper.h"
+#include "chrome/browser/profiles/profile.h"
+#include "content/public/browser/page.h"
+#include "content/public/browser/render_frame_host.h"
+#include "content/public/browser/render_widget_host.h"
+#include "content/public/browser/web_contents.h"
+
+AppSwapSessionRecordingTabHelper::AppSwapSessionRecordingTabHelper(
+    content::WebContents* web_contents)
+    : content::WebContentsObserver(web_contents),
+      content::WebContentsUserData<AppSwapSessionRecordingTabHelper>(
+          *web_contents) {}
+
+AppSwapSessionRecordingTabHelper::~AppSwapSessionRecordingTabHelper() =
+    default;
+
+void AppSwapSessionRecordingTabHelper::StartRecording() {
+  if (writer_) {
+    return;
+  }
+  Profile* profile =
+      Profile::FromBrowserContext(GetWebContents().GetBrowserContext());
+  writer_ = std::make_unique<AppSwapSessionRecordingWriter>(
+      GetAppSwapRecordingsDir(profile), GetWebContents().GetLastCommittedURL());
+  // Log the URL/app this recording is starting on -- PrimaryPageChanged()
+  // only fires on a SUBSEQUENT navigation, so without this the navigation
+  // log would be missing an entry for wherever recording began.
+  LogCurrentNavigation();
+
+  // Enables continuous capture on the primary main frame's widget -- see
+  // content::RenderWidgetHost::SetPaintOpRecordingCallback() and the
+  // renderer<->browser transport it rides (third_party/blink/public/
+  // mojom/app_swap/paint_op_recording.mojom).
+  GetWebContents()
+      .GetPrimaryMainFrame()
+      ->GetRenderWidgetHost()
+      ->SetPaintOpRecordingCallback(base::BindRepeating(
+          &AppSwapSessionRecordingTabHelper::OnFrameCaptured,
+          weak_factory_.GetWeakPtr()));
+}
+
+void AppSwapSessionRecordingTabHelper::StopRecording() {
+  if (!writer_) {
+    return;
+  }
+  // A null callback disables capture -- see SetPaintOpRecordingCallback()'s
+  // own comment. Guarded on GetPrimaryMainFrame() being non-null: this can
+  // run during WebContents teardown, after the frame is already gone.
+  if (content::RenderFrameHost* main_frame =
+          GetWebContents().GetPrimaryMainFrame()) {
+    main_frame->GetRenderWidgetHost()->SetPaintOpRecordingCallback(
+        content::RenderWidgetHost::PaintOpFrameCallback());
+  }
+  writer_.reset();
+}
+
+void AppSwapSessionRecordingTabHelper::OnFrameCaptured(
+    uint32_t frame_index,
+    int layer_id,
+    const gfx::Size& bounds,
+    const gfx::Transform& transform,
+    cc::SerializedPaintOpBuffer serialized) {
+  if (!writer_) {
+    return;
+  }
+  writer_->WriteFrame(frame_index, layer_id, base::Time::Now(), bounds,
+                      transform, std::move(serialized));
+}
+
+void AppSwapSessionRecordingTabHelper::PrimaryPageChanged(
+    content::Page& page) {
+  if (recording()) {
+    LogCurrentNavigation();
+  }
+}
+
+void AppSwapSessionRecordingTabHelper::LogCurrentNavigation() {
+  Profile* profile =
+      Profile::FromBrowserContext(GetWebContents().GetBrowserContext());
+  const GURL& url = GetWebContents().GetLastCommittedURL();
+
+  std::string package_name;
+  std::string version;
+  if (std::optional<AppSwapApp> app = FindAppSwapAppForUrl(profile, url)) {
+    package_name = app->package_name;
+    // Prefer what was actually served for this navigation over the app's
+    // configured dist-tag -- see AppSwapUpdateAvailableTabHelper's own
+    // comment for why those can differ.
+    if (auto* update_helper =
+            AppSwapUpdateAvailableTabHelper::FromWebContents(
+                &GetWebContents())) {
+      if (update_helper->committed_version()) {
+        version = *update_helper->committed_version();
+      }
+    }
+    if (version.empty()) {
+      version = app->version;
+    }
+  }
+
+  writer_->WriteNavigation(base::Time::Now(), url, package_name, version);
+}
+
+WEB_CONTENTS_USER_DATA_KEY_IMPL(AppSwapSessionRecordingTabHelper);
