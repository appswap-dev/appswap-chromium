+
+  void SetActiveVisual(bool active);
+
+  raw_ptr<BrowserWindowInterface> browser_;
+};
+
+#endif  // CHROME_BROWSER_UI_VIEWS_APP_SWAP_APP_SWAP_SESSION_RECORDING_BUTTON_H_
