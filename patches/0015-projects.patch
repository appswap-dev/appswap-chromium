@@ -0,0 +1,94 @@
+// Copyright 2026 The AppSwap Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_VIEWS_APP_SWAP_APP_SWAP_ROUTE_GROUP_TAB_STRIP_BUTTON_H_
+#define CHROME_BROWSER_UI_VIEWS_APP_SWAP_APP_SWAP_ROUTE_GROUP_TAB_STRIP_BUTTON_H_
+
+#include <memory>
+#include <vector>
+
+#include "base/memory/raw_ptr.h"
+#include "chrome/browser/app_swap/app_swap_route_group_service.h"
+#include "chrome/browser/ui/tabs/tab_change_type.h"
+#include "chrome/browser/ui/tabs/tab_strip_model_observer.h"
+#include "ui/base/metadata/metadata_header_macros.h"
+#include "ui/menus/simple_menu_model.h"
+#include "ui/views/controls/button/menu_button.h"
+
+class BrowserWindowInterface;
+class TabStripModel;
+
+namespace tabs {
+class TabInterface;
+}  // namespace tabs
+
+namespace views {
+class MenuModelAdapter;
+class MenuRunner;
+}  // namespace views
+
+// A location-bar-trailing button showing the Route Group the *active tab* is
+// currently pinned to -- unlike AppSwapProfileTabStripButton (a single
+// browser-wide active identity), a Route Group pin is real per-tab state
+// (see AppSwapRouteGroupPinTabHelper), so this button re-reads the active
+// tab's own pin rather than a shared pointer. Shows the pinned group's name
+// once pinned; before that, shows a neutral "Routes" placeholder on any
+// ordinary web page so the switcher is discoverable even before any group
+// has been picked. Clicking it opens a menu listing every route group
+// configured for the current project (== Chromium Profile), plus a "Direct
+// (no rewriting)" entry to unpin, plus a link to manage groups; picking one
+// pins the active tab and reloads it -- no WebContents replacement needed
+// (unlike AppSwapProfileTabStripButton's profile switch), since a route
+// group pin doesn't change storage partition or SiteInstance.
+class AppSwapRouteGroupTabStripButton : public views::MenuButton,
+                                        public TabStripModelObserver,
+                                        public ui::SimpleMenuModel::Delegate {
+  METADATA_HEADER(AppSwapRouteGroupTabStripButton, views::MenuButton)
+
+ public:
+  explicit AppSwapRouteGroupTabStripButton(BrowserWindowInterface* browser);
+  AppSwapRouteGroupTabStripButton(const AppSwapRouteGroupTabStripButton&) =
+      delete;
+  AppSwapRouteGroupTabStripButton& operator=(
+      const AppSwapRouteGroupTabStripButton&) = delete;
+  ~AppSwapRouteGroupTabStripButton() override;
+
+  // TabStripModelObserver:
+  void OnTabStripModelChanged(
+      TabStripModel* tab_strip_model,
+      const TabStripModelChange& change,
+      const TabStripSelectionChange& selection) override;
+  void OnTabChangedAt(tabs::TabInterface* tab,
+                      TabChangeType change_type) override;
+
+  // ui::SimpleMenuModel::Delegate:
+  void ExecuteCommand(int command_id, int event_flags) override;
+
+  // views::View:
+  void OnThemeChanged() override;
+
+ private:
+  // Recomputes visibility and label text from the active tab's own pin.
+  void UpdateForActiveTab();
+
+  // Same badge-coloring approach as AppSwapProfileTabStripButton::
+  // ApplyBadgeStyle -- see its comment.
+  void ApplyBadgeStyle(const std::string& group_name);
+
+  // Builds and runs the route-group menu.
+  void ButtonPressed();
+
+  raw_ptr<BrowserWindowInterface> browser_;
+
+  // The groups menu currently shown -- kept in sync with the menu so
+  // ExecuteCommand's command ids resolve against the same list the user
+  // picked from.
+  std::vector<AppSwapRouteGroup> menu_groups_;
+
+  std::unique_ptr<ui::SimpleMenuModel> menu_model_;
+  std::unique_ptr<views::MenuModelAdapter> menu_model_adapter_;
+  std::unique_ptr<views::MenuRunner> menu_runner_;
+};
+
+#endif  // CHROME_BROWSER_UI_VIEWS_APP_SWAP_APP_SWAP_ROUTE_GROUP_TAB_STRIP_BUTTON_H_
