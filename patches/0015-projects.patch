+// Copyright 2026 The AppSwap Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/webui/app_swap_projects/app_swap_projects_page_handler.h"
+
+#include <utility>
+
+#include "base/functional/bind.h"
+#include "base/strings/utf_string_conversions.h"
+#include "chrome/browser/app_swap/app_swap_apps_service.h"
+#include "chrome/browser/app_swap/app_swap_apps_service_factory.h"
+#include "chrome/browser/app_swap/app_swap_profile_removal_util.h"
+#include "chrome/browser/app_swap/app_swap_profiles_service.h"
+#include "chrome/browser/app_swap/app_swap_profiles_service_factory.h"
+#include "chrome/browser/app_swap/app_swap_route_group_service.h"
+#include "chrome/browser/app_swap/app_swap_route_group_service_factory.h"
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/browser/profiles/profile_attributes_entry.h"
+#include "chrome/browser/profiles/profile_attributes_storage.h"
+#include "chrome/browser/profiles/profile_manager.h"
+#include "chrome/browser/browser_process.h"
+
+AppSwapProjectsPageHandler::AppSwapProjectsPageHandler(
+    mojo::PendingReceiver<app_swap_projects::mojom::PageHandler> handler,
+    Profile* profile)
+    : profile_(profile), receiver_(this, std::move(handler)) {}
+
+AppSwapProjectsPageHandler::~AppSwapProjectsPageHandler() = default;
+
+AppSwapAppsService* AppSwapProjectsPageHandler::apps_service() {
+  return AppSwapAppsServiceFactory::GetForProfile(profile_);
+}
+
+AppSwapRouteGroupService* AppSwapProjectsPageHandler::route_group_service() {
+  return AppSwapRouteGroupServiceFactory::GetForProfile(profile_);
+}
+
+AppSwapProfilesService* AppSwapProjectsPageHandler::profiles_service() {
+  return AppSwapProfilesServiceFactory::GetForProfile(profile_);
+}
+
+void AppSwapProjectsPageHandler::GetProjectName(
+    GetProjectNameCallback callback) {
+  ProfileAttributesEntry* entry =
+      g_browser_process->profile_manager()
+          ->GetProfileAttributesStorage()
+          .GetProfileAttributesWithPath(profile_->GetPath());
+  std::move(callback).Run(entry ? base::UTF16ToUTF8(entry->GetName())
+                                : std::string());
+}
+
+void AppSwapProjectsPageHandler::GetApps(GetAppsCallback callback) {
+  AppSwapAppsService* service = apps_service();
+  if (!service) {
+    std::move(callback).Run({});
+    return;
+  }
+  service->GetApps(base::BindOnce(
+      [](GetAppsCallback callback, std::vector<AppSwapApp> apps) {
+        std::vector<app_swap_projects::mojom::AppInfoPtr> result;
+        for (const AppSwapApp& app : apps) {
+          result.push_back(app_swap_projects::mojom::AppInfo::New(
+              app.id, app.title, app.package_name, app.version, app.registry,
+              app.token, app.hosts));
+        }
+        std::move(callback).Run(std::move(result));
+      },
+      std::move(callback)));
+}
+
+void AppSwapProjectsPageHandler::AddApp(
+    app_swap_projects::mojom::AppInfoPtr app,
+    AddAppCallback callback) {
+  AppSwapAppsService* service = apps_service();
+  if (!service) {
+    std::move(callback).Run();
+    return;
+  }
+  AppSwapApp new_app;
+  new_app.id = app->id;
+  new_app.title = app->title;
+  new_app.package_name = app->package_name;
+  new_app.version = app->version;
+  new_app.registry = app->registry;
+  new_app.token = app->token;
+  new_app.hosts = app->hosts;
+  service->AddApp(std::move(new_app));
+  std::move(callback).Run();
+}
+
+void AppSwapProjectsPageHandler::RemoveApp(const std::string& id,
+                                           RemoveAppCallback callback) {
+  if (AppSwapAppsService* service = apps_service()) {
+    service->RemoveApp(id);
+  }
+  std::move(callback).Run();
+}
+
+void AppSwapProjectsPageHandler::GetRouteGroups(
+    GetRouteGroupsCallback callback) {
+  AppSwapRouteGroupService* service = route_group_service();
+  if (!service) {
+    std::move(callback).Run({});
+    return;
+  }
+  service->GetRouteGroups(base::BindOnce(
+      [](GetRouteGroupsCallback callback,
+         std::vector<AppSwapRouteGroup> groups) {
+        std::vector<app_swap_projects::mojom::RouteGroupInfoPtr> result;
+        for (const AppSwapRouteGroup& group : groups) {
+          std::vector<app_swap_projects::mojom::RouteGroupRuleInfoPtr> rules;
+          for (const AppSwapRouteGroupRule& rule : group.rules) {
+            rules.push_back(app_swap_projects::mojom::RouteGroupRuleInfo::New(
+                rule.id, rule.url_pattern, rule.target));
+          }
+          result.push_back(app_swap_projects::mojom::RouteGroupInfo::New(
+              group.id, group.name, std::move(rules)));
+        }
+        std::move(callback).Run(std::move(result));
+      },
+      std::move(callback)));
+}
+
+void AppSwapProjectsPageHandler::AddRouteGroup(
+    const std::string& name,
+    AddRouteGroupCallback callback) {
+  AppSwapRouteGroupService* service = route_group_service();
+  if (!service) {
+    std::move(callback).Run();
+    return;
+  }
+  AppSwapRouteGroup group;
+  group.name = name;
+  service->AddRouteGroup(std::move(group));
+  std::move(callback).Run();
+}
+
+void AppSwapProjectsPageHandler::RemoveRouteGroup(
+    const std::string& id,
+    RemoveRouteGroupCallback callback) {
+  if (AppSwapRouteGroupService* service = route_group_service()) {
+    service->RemoveRouteGroup(id);
+  }
+  std::move(callback).Run();
+}
+
+void AppSwapProjectsPageHandler::AddRule(const std::string& group_id,
+                                         const std::string& url_pattern,
+                                         const std::string& target,
+                                         AddRuleCallback callback) {
+  if (AppSwapRouteGroupService* service = route_group_service()) {
+    AppSwapRouteGroupRule rule;
+    rule.url_pattern = url_pattern;
+    rule.target = target;
+    service->AddRule(group_id, std::move(rule));
+  }
+  std::move(callback).Run();
+}
+
+void AppSwapProjectsPageHandler::RemoveRule(const std::string& group_id,
+                                            const std::string& rule_id,
+                                            RemoveRuleCallback callback) {
+  if (AppSwapRouteGroupService* service = route_group_service()) {
+    service->RemoveRule(group_id, rule_id);
+  }
+  std::move(callback).Run();
+}
+
+void AppSwapProjectsPageHandler::GetAppSwapProfiles(
+    GetAppSwapProfilesCallback callback) {
+  AppSwapProfilesService* service = profiles_service();
+  if (!service) {
+    std::move(callback).Run({}, std::nullopt);
+    return;
+  }
+  service->GetProfiles(base::BindOnce(
+      [](AppSwapProfilesService* service, GetAppSwapProfilesCallback callback,
+         std::vector<AppSwapProfile> profiles) {
+        std::vector<app_swap_projects::mojom::AppSwapProfileInfoPtr> result;
+        for (const AppSwapProfile& profile_info : profiles) {
+          result.push_back(app_swap_projects::mojom::AppSwapProfileInfo::New(
+              profile_info.id, profile_info.name));
+        }
+        std::move(callback).Run(std::move(result),
+                                service->GetActiveProfileIdIfLoaded());
+      },
+      service, std::move(callback)));
+}
+
+void AppSwapProjectsPageHandler::AddAppSwapProfile(
+    const std::string& name,
+    AddAppSwapProfileCallback callback) {
+  AppSwapProfilesService* service = profiles_service();
+  if (!service) {
+    std::move(callback).Run();
+    return;
+  }
+  AppSwapProfile profile;
+  profile.name = name;
+  service->AddProfile(std::move(profile));
+  std::move(callback).Run();
+}
+
+void AppSwapProjectsPageHandler::RemoveAppSwapProfile(
+    const std::string& id,
+    RemoveAppSwapProfileCallback callback) {
+  if (AppSwapProfilesService* service = profiles_service()) {
+    // Reassign any tab currently running under this profile's partition back
+    // to the default partition before removing it, so nothing is left
+    // pointing at a partition that's about to be cleared out from under it --
+    // same ordering appswap://profiles used to follow.
+    SwitchTabsOffAppSwapProfile(id);
+    ClearAppSwapProfileData(id, profile_);
+    service->RemoveProfile(id);
+  }
+  std::move(callback).Run();
+}
+
+void AppSwapProjectsPageHandler::SetActiveAppSwapProfile(
+    const std::string& id,
+    SetActiveAppSwapProfileCallback callback) {
+  if (AppSwapProfilesService* service = profiles_service()) {
+    service->SetActiveProfile(id);
+  }
+  std::move(callback).Run();
+}
