@@ -0,0 +1,129 @@
+/* Copyright 2026 The AppSwap Authors
+ * Use of this source code is governed by a BSD-style license that can be
+ * found in the LICENSE file. */
+
+/* #css_wrapper_metadata_start
+ * #type=style-lit
+ * #scheme=relative
+ * #css_wrapper_metadata_end */
+
+:host {
+  background: var(--color-sys-surface, white);
+  box-sizing: border-box;
+  color: var(--color-sys-on-surface, black);
+  display: block;
+  font-family: inherit;
+  min-height: 100vh;
+  padding: 16px 24px;
+  width: 100%;
+}
+
+h1 {
+  font-size: 20px;
+  margin: 0 0 12px;
+}
+
+h2 {
+  font-size: 16px;
+  margin: 20px 0 8px;
+}
+
+h3 {
+  font-size: 13px;
+  margin: 12px 0 6px;
+}
+
+.hint {
+  color: var(--cr-secondary-text-color, #5f6368);
+  font-size: 0.9em;
+}
+
+section {
+  max-width: 640px;
+}
+
+.row {
+  align-items: center;
+  border-bottom: 1px solid var(--cr-separator-color, #e0e0e0);
+  display: flex;
+  gap: 12px;
+  justify-content: space-between;
+  padding: 8px 4px;
+}
+
+.row-main {
+  display: flex;
+  flex-direction: column;
+  min-width: 0;
+}
+
+.primary {
+  font-weight: 500;
+}
+
+.secondary {
+  color: var(--cr-secondary-text-color, #5f6368);
+  font-size: 0.85em;
+}
+
+.badge {
+  background: var(--color-sys-primary-container, rgba(66, 133, 244, 0.12));
+  border-radius: 4px;
+  font-size: 0.75em;
+  margin-inline-start: 8px;
+  padding: 2px 6px;
+}
+
+.group {
+  border: 1px solid var(--cr-separator-color, #e0e0e0);
+  border-radius: 8px;
+  margin: 8px 0;
+  padding: 8px 12px;
+}
+
+.group-header {
+  align-items: center;
+  display: flex;
+  justify-content: space-between;
+  padding-bottom: 4px;
+}
+
+.form {
+  display: flex;
+  flex-direction: column;
+  gap: 6px;
+  margin-top: 8px;
+  max-width: 360px;
+}
+
+.form input {
+  border: 1px solid var(--cr-separator-color, #c0c0c0);
+  border-radius: 4px;
+  font: inherit;
+  padding: 6px 8px;
+}
+
+button {
+  background: none;
+  border: 1px solid var(--cr-separator-color, #c0c0c0);
+  border-radius: 4px;
+  cursor: pointer;
+  font: inherit;
+  padding: 6px 10px;
+  white-space: nowrap;
+}
+
+button:hover {
+  background: var(--cr-hover-background-color, rgba(0, 0, 0, 0.06));
+}
+
+/* The one irreversible action on this page (deleting the project itself).
+   Everything else removes a single config entry that can be retyped. */
+button.danger {
+  border-color: var(--google-red-600, #d93025);
+  color: var(--google-red-600, #d93025);
+}
+
+button.danger:hover {
+  background: var(--google-red-50, rgba(217, 48, 37, 0.08));
+}
diff --git a/chrome/browser/resources/app_swap_projects/app.html.ts b/chrome/browser/resources/app_swap_projects/app.html.ts
