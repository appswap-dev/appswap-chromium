diff --git a/chrome/browser/app_swap/app_swap_route_matcher_unittest.cc b/chrome/browser/app_swap/app_swap_route_matcher_unittest.cc
new file mode 100644
index 0000000000000..7e48eef15c0da
--- /dev/null
+++ b/chrome/browser/app_swap/app_swap_route_matcher_unittest.cc
@@ -0,0 +1,140 @@
+// Copyright 2026 The AppSwap Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/app_swap/app_swap_route_matcher.h"
+
+#include <optional>
+#include <string>
+
+#include "chrome/browser/app_swap/app_swap_route_group_service.h"
+#include "testing/gtest/include/gtest/gtest.h"
+#include "url/gurl.h"
+
+namespace {
+
+// The two Profile-taking lookups (FindAppSwapAppForUrl,
+// FindAppSwapRouteGroupById) need a KeyedService and are covered by browser
+// tests instead; everything here is the pure matching/rewriting logic those
+// two funnel into, which is where the edge cases actually live.
+
+TEST(AppSwapRouteMatcherTest, MatchesWholeOriginForRootPattern) {
+  const std::string pattern = "https://my-app.dev";
+  EXPECT_TRUE(AppSwapUrlMatchesPattern(GURL("https://my-app.dev/"), pattern));
+  EXPECT_TRUE(
+      AppSwapUrlMatchesPattern(GURL("https://my-app.dev/a/b?c=1"), pattern));
+}
+
+TEST(AppSwapRouteMatcherTest, RequiresSameSchemeHostAndPort) {
+  const std::string pattern = "https://my-app.dev";
+  EXPECT_FALSE(AppSwapUrlMatchesPattern(GURL("http://my-app.dev/"), pattern));
+  EXPECT_FALSE(
+      AppSwapUrlMatchesPattern(GURL("https://other.dev/"), pattern));
+  EXPECT_FALSE(
+      AppSwapUrlMatchesPattern(GURL("https://my-app.dev:8443/"), pattern));
+  // A suffix match on the host would be a serious bug: this is a different
+  // site entirely.
+  EXPECT_FALSE(
+      AppSwapUrlMatchesPattern(GURL("https://my-app.dev.evil.com/"), pattern));
+}
+
+TEST(AppSwapRouteMatcherTest, TreatsDefaultPortAsExplicitPort) {
+  EXPECT_TRUE(AppSwapUrlMatchesPattern(GURL("https://my-app.dev:443/x"),
+                                       "https://my-app.dev"));
+  EXPECT_TRUE(AppSwapUrlMatchesPattern(GURL("https://my-app.dev/x"),
+                                       "https://my-app.dev:443"));
+}
+
+TEST(AppSwapRouteMatcherTest, MatchesOnPathSegmentBoundariesOnly) {
+  const std::string pattern = "https://my-app.dev/docs";
+  EXPECT_TRUE(AppSwapUrlMatchesPattern(GURL("https://my-app.dev/docs"),
+                                       pattern));
+  EXPECT_TRUE(AppSwapUrlMatchesPattern(GURL("https://my-app.dev/docs/intro"),
+                                       pattern));
+  // The case the boundary check exists for.
+  EXPECT_FALSE(AppSwapUrlMatchesPattern(GURL("https://my-app.dev/docs-legacy"),
+                                        pattern));
+  EXPECT_FALSE(AppSwapUrlMatchesPattern(GURL("https://my-app.dev/other"),
+                                        pattern));
+}
+
+TEST(AppSwapRouteMatcherTest, RejectsInvalidPattern) {
+  EXPECT_FALSE(AppSwapUrlMatchesPattern(GURL("https://my-app.dev/"), ""));
+  EXPECT_FALSE(
+      AppSwapUrlMatchesPattern(GURL("https://my-app.dev/"), "not a url"));
+}
+
+TEST(AppSwapRouteMatcherTest, RewriteAppendsSuffixBeyondPatternPath) {
+  EXPECT_EQ(GURL("https://beta.my-app.dev/api/users"),
+            ComputeAppSwapRewriteUrl(GURL("https://my-app.dev/api/users"),
+                                     "https://my-app.dev/api",
+                                     "https://beta.my-app.dev/api"));
+}
+
+TEST(AppSwapRouteMatcherTest, RewritePreservesQuery) {
+  EXPECT_EQ(GURL("https://beta.my-app.dev/api/users?x=1&y=2"),
+            ComputeAppSwapRewriteUrl(GURL("https://my-app.dev/api/users?x=1&y=2"),
+                                     "https://my-app.dev/api",
+                                     "https://beta.my-app.dev/api"));
+}
+
+TEST(AppSwapRouteMatcherTest, RewriteCarriesWholePathForRootPattern) {
+  EXPECT_EQ(GURL("http://localhost:5000/api/users"),
+            ComputeAppSwapRewriteUrl(GURL("https://my-app.dev/api/users"),
+                                     "https://my-app.dev",
+                                     "http://localhost:5000"));
+}
+
+TEST(AppSwapRouteMatcherTest, RewriteDoesNotDoubleSlashAtTheJoin) {
+  EXPECT_EQ(GURL("https://beta.my-app.dev/api/users"),
+            ComputeAppSwapRewriteUrl(GURL("https://my-app.dev/api/users"),
+                                     "https://my-app.dev/api",
+                                     "https://beta.my-app.dev/api/"));
+}
+
+TEST(AppSwapRouteMatcherTest, RewriteOfExactPatternPathHasNoSuffix) {
+  EXPECT_EQ(GURL("https://beta.my-app.dev/v2"),
+            ComputeAppSwapRewriteUrl(GURL("https://my-app.dev/api"),
+                                     "https://my-app.dev/api",
+                                     "https://beta.my-app.dev/v2"));
+}
+
+TEST(AppSwapRouteMatcherTest, NoGroupPinnedMeansNoRule) {
+  EXPECT_FALSE(FindAppSwapRouteGroupRuleForUrl(std::nullopt,
+                                               GURL("https://my-app.dev/api")));
+}
+
+TEST(AppSwapRouteMatcherTest, EmptyGroupMeansNoRule) {
+  // "Prod" is an ordinary group with zero rules, not a special case.
+  AppSwapRouteGroup group;
+  group.id = "g1";
+  group.name = "Prod";
+  EXPECT_FALSE(FindAppSwapRouteGroupRuleForUrl(std::make_optional(group),
+                                               GURL("https://my-app.dev/api")));
+}
+
+TEST(AppSwapRouteMatcherTest, ReturnsFirstMatchingRuleInOrder) {
+  AppSwapRouteGroup group;
+  group.id = "g1";
+  group.name = "Beta";
+  group.rules.push_back(
+      {"r1", "https://my-app.dev/api/v2", "https://beta.my-app.dev/api/v2"});
+  group.rules.push_back(
+      {"r2", "https://my-app.dev/api", "https://beta.my-app.dev/api"});
+
+  const std::optional<AppSwapRouteGroup> opt = group;
+  std::optional<AppSwapRouteGroupRule> rule = FindAppSwapRouteGroupRuleForUrl(
+      opt, GURL("https://my-app.dev/api/v2/users"));
+  ASSERT_TRUE(rule);
+  EXPECT_EQ("r1", rule->id);
+
+  rule = FindAppSwapRouteGroupRuleForUrl(
+      opt, GURL("https://my-app.dev/api/v1/users"));
+  ASSERT_TRUE(rule);
+  EXPECT_EQ("r2", rule->id);
+
+  EXPECT_FALSE(
+      FindAppSwapRouteGroupRuleForUrl(opt, GURL("https://elsewhere.dev/api")));
+}
+
+}  // namespace
diff --git a/chrome/browser/app_swap/app_swap_version_utils_unittest.cc b/chrome/browser/app_swap/app_swap_version_utils_unittest.cc
new file mode 100644
index 0000000000000..d4a8d26f7e8bd
--- /dev/null
+++ b/chrome/browser/app_swap/app_swap_version_utils_unittest.cc
@@ -0,0 +1,93 @@
+// Copyright 2026 The AppSwap Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/app_swap/app_swap_version_utils.h"
+
+#include "testing/gtest/include/gtest/gtest.h"
+
+namespace app_swap {
+namespace {
+
+TEST(AppSwapVersionUtilsTest, ComparesNumericallyNotLexically) {
+  // The whole reason this isn't a string compare: "10" sorts before "9".
+  EXPECT_TRUE(IsNewerVersion("1.2.10", "1.2.9"));
+  EXPECT_FALSE(IsNewerVersion("1.2.9", "1.2.10"));
+  EXPECT_TRUE(IsNewerVersion("2.0.0", "1.99.99"));
+  EXPECT_TRUE(IsNewerVersion("1.10.0", "1.9.0"));
+}
+
+TEST(AppSwapVersionUtilsTest, EqualVersionIsNotNewer) {
+  EXPECT_FALSE(IsNewerVersion("1.2.3", "1.2.3"));
+  EXPECT_FALSE(IsNewerVersion("next", "next"));
+}
+
+TEST(AppSwapVersionUtilsTest, MissingComponentsCountAsZero) {
+  EXPECT_TRUE(IsNewerVersion("1.2.1", "1.2"));
+  EXPECT_FALSE(IsNewerVersion("1.2", "1.2.1"));
+  EXPECT_FALSE(IsNewerVersion("1.2.0", "1.2"));
+}
+
+TEST(AppSwapVersionUtilsTest, ComparesNumericPartOfPrereleaseSuffixes) {
+  // Both parse to {1,2,10} and {1,2,9}; without the leading-digit-run
+  // parsing these would fall back to a string compare and get it backwards.
+  EXPECT_TRUE(IsNewerVersion("1.2.10-next", "1.2.9-next"));
+  EXPECT_FALSE(IsNewerVersion("1.2.9-next", "1.2.10-next"));
+}
+
+TEST(AppSwapVersionUtilsTest, UnparseableFallsBackToStringCompare) {
+  // Dist-tag names aren't versions; there's no meaningful ordering, but the
+  // comparison must stay total and not crash.
+  EXPECT_TRUE(IsNewerVersion("next", "latest"));
+  EXPECT_FALSE(IsNewerVersion("latest", "next"));
+}
+
+TEST(AppSwapVersionUtilsTest, AcceptsOrdinaryVersionsAsPaths) {
+  EXPECT_TRUE(IsValidVersionForPath("1.2.3"));
+  EXPECT_TRUE(IsValidVersionForPath("1.2.3-beta.1"));
+  EXPECT_TRUE(IsValidVersionForPath("1.2.3+build_7"));
+  EXPECT_TRUE(IsValidVersionForPath("latest"));
+  EXPECT_TRUE(IsValidVersionForPath("v2"));
+}
+
+TEST(AppSwapVersionUtilsTest, RejectsVersionsThatEscapeTheCacheDirectory) {
+  // The attack this predicate exists for: a page on a configured app host
+  // linking to ?appswap-use-version=<these> would otherwise repoint the
+  // serve root outside the artifact cache.
+  EXPECT_FALSE(IsValidVersionForPath("1/../../../.."));
+  EXPECT_FALSE(IsValidVersionForPath(".."));
+  EXPECT_FALSE(IsValidVersionForPath("../1.2.3"));
+  EXPECT_FALSE(IsValidVersionForPath("1.2.3/../../etc"));
+  EXPECT_FALSE(IsValidVersionForPath("..\\windows"));
+  EXPECT_FALSE(IsValidVersionForPath("C:\\Windows"));
+}
+
+TEST(AppSwapVersionUtilsTest, RejectsEmptyAndHiddenAndEncodedVersions) {
+  EXPECT_FALSE(IsValidVersionForPath(""));
+  EXPECT_FALSE(IsValidVersionForPath("."));
+  EXPECT_FALSE(IsValidVersionForPath(".hidden"));
+  EXPECT_FALSE(IsValidVersionForPath("1.2.3%2f.."));
+  EXPECT_FALSE(IsValidVersionForPath(std::string("1.2.3\0evil", 10)));
+}
+
+TEST(AppSwapVersionUtilsTest, AcceptsPlainAndScopedPackageNames) {
+  EXPECT_TRUE(IsValidPackageNameForPath("myapp"));
+  EXPECT_TRUE(IsValidPackageNameForPath("my-app.thing_2"));
+  EXPECT_TRUE(IsValidPackageNameForPath("@myorg/myapp"));
+}
+
+TEST(AppSwapVersionUtilsTest, RejectsPackageNamesThatEscapeOrMalform) {
+  EXPECT_FALSE(IsValidPackageNameForPath(""));
+  EXPECT_FALSE(IsValidPackageNameForPath(".."));
+  EXPECT_FALSE(IsValidPackageNameForPath("../../etc"));
+  // A "/" is only legal as the single scope separator, never elsewhere.
+  EXPECT_FALSE(IsValidPackageNameForPath("myorg/myapp"));
+  EXPECT_FALSE(IsValidPackageNameForPath("@myorg/my/app"));
+  EXPECT_FALSE(IsValidPackageNameForPath("@myorg"));
+  EXPECT_FALSE(IsValidPackageNameForPath("@/myapp"));
+  EXPECT_FALSE(IsValidPackageNameForPath("@myorg/"));
+  EXPECT_FALSE(IsValidPackageNameForPath("@../myapp"));
+}
+
+}  // namespace
+}  // namespace app_swap
