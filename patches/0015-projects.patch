+
+#include "chrome/browser/app_swap/app_swap_route_group_service_factory.h"
+
+#include <memory>
+
+#include "chrome/browser/app_swap/app_swap_route_group_service.h"
+#include "chrome/browser/profiles/profile.h"
+
+// static
+AppSwapRouteGroupService* AppSwapRouteGroupServiceFactory::GetForProfile(
+    Profile* profile) {
+  return static_cast<AppSwapRouteGroupService*>(
+      GetInstance()->GetServiceForBrowserContext(profile, true));
+}
+
+// static
+AppSwapRouteGroupServiceFactory*
+AppSwapRouteGroupServiceFactory::GetInstance() {
+  static base::NoDestructor<AppSwapRouteGroupServiceFactory> instance;
+  return instance.get();
+}
+
+AppSwapRouteGroupServiceFactory::AppSwapRouteGroupServiceFactory()
+    : ProfileKeyedServiceFactory("AppSwapRouteGroupService") {}
+
+AppSwapRouteGroupServiceFactory::~AppSwapRouteGroupServiceFactory() = default;
+
+std::unique_ptr<KeyedService>
+AppSwapRouteGroupServiceFactory::BuildServiceInstanceForBrowserContext(
+    content::BrowserContext* context) const {
+  return std::make_unique<AppSwapRouteGroupService>(context);
+}
