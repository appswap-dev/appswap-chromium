+// Copyright 2026 The AppSwap Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+module app_swap_projects.mojom;
+
+// Mirrors AppSwapApp (chrome/browser/app_swap/app_swap_apps_service.h).
+struct AppInfo {
+  string id;
+  string title;
+  string package_name;
+  string version;
+  string registry;
+  string token;
+  array<string> hosts;
+};
+
+// Mirrors AppSwapRouteGroupRule.
+struct RouteGroupRuleInfo {
+  string id;
+  string url_pattern;
+  string target;
+};
+
+// Mirrors AppSwapRouteGroup.
+struct RouteGroupInfo {
+  string id;
+  string name;
+  array<RouteGroupRuleInfo> rules;
+};
+
+// Mirrors AppSwapProfile (the storage-partition sub-identity, not this page
+// itself -- see the Profiles tab).
+struct AppSwapProfileInfo {
+  string id;
+  string name;
+};
+
+interface PageHandlerFactory {
+  CreatePageHandler(pending_receiver<PageHandler> handler);
+};
+
+// Every method resolves against the Profile (== Project) this page was
+// opened in -- there is no project id anywhere in this interface, see
+// AppSwapProjectsUI.
+interface PageHandler {
+  // General tab.
+  GetProjectName() => (string name);
+  // Renames the Chromium Profile backing this project, i.e. what the project
+  // is called everywhere in the UI. No-op for an empty name.
+  RenameProject(string name) => ();
+  // Deletes this project and everything in it -- config, bookmarks,
+  // history, cookies, open tabs. Closes its windows as a side effect, so
+  // nothing more can be expected of this page afterwards. The reply comes
+  // back before the deletion completes.
+  DeleteProject() => ();
+
+  // Apps tab. `app.id` selects which app UpdateApp() edits; every other
+  // field replaces what's stored.
+  GetApps() => (array<AppInfo> apps);
+  AddApp(AppInfo app) => ();
+  UpdateApp(AppInfo app) => ();
+  RemoveApp(string id) => ();
+
+  // Routes tab.
+  GetRouteGroups() => (array<RouteGroupInfo> groups);
+  AddRouteGroup(string name) => ();
+  // Renames a group; its rules are untouched (they have their own entry
+  // points below).
+  UpdateRouteGroup(string id, string name) => ();
+  RemoveRouteGroup(string id) => ();
+  AddRule(string group_id, string url_pattern, string target) => ();
+  UpdateRule(string group_id, string rule_id,
+             string url_pattern, string target) => ();
+  RemoveRule(string group_id, string rule_id) => ();
+
+  // Profiles tab (the storage-partition sub-identity).
+  GetAppSwapProfiles() => (array<AppSwapProfileInfo> profiles,
+                           string? active_profile_id);
+  AddAppSwapProfile(string name) => ();
+  UpdateAppSwapProfile(string id, string name) => ();
+  RemoveAppSwapProfile(string id) => ();
+  SetActiveAppSwapProfile(string id) => ();
+};
