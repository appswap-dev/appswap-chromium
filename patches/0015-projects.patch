diff --git a/chrome/browser/app_swap/app_swap_config_store.cc b/chrome/browser/app_swap/app_swap_config_store.cc
new file mode 100644
index 0000000000000..9d8a7f1a8f801
--- /dev/null
+++ b/chrome/browser/app_swap/app_swap_config_store.cc
@@ -0,0 +1,110 @@
+// Copyright 2026 The AppSwap Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/app_swap/app_swap_config_store.h"
+
+#include <optional>
+#include <string>
+#include <utility>
+
+#include "base/files/file_util.h"
+#include "base/files/important_file_writer.h"
+#include "base/functional/bind.h"
+#include "base/json/json_reader.h"
+#include "base/json/json_writer.h"
+#include "base/task/thread_pool.h"
+
+namespace {
+
+// Blocking; runs on the store's task runner.
+base::DictValue ReadConfigFile(const base::FilePath& path) {
+  std::string json;
+  if (!base::ReadFileToString(path, &json)) {
+    return base::DictValue();
+  }
+  std::optional<base::DictValue> parsed =
+      base::JSONReader::ReadDict(json, base::JSON_PARSE_CHROMIUM_EXTENSIONS);
+  return parsed ? std::move(*parsed) : base::DictValue();
+}
+
+// Blocking; runs on the store's task runner. Atomic: writes a sibling temp
+// file and renames it over `path`, so an interrupted write leaves the
+// previous config intact rather than a truncated file.
+void WriteConfigFile(const base::FilePath& path, std::string json) {
+  if (!base::CreateDirectory(path.DirName())) {
+    return;
+  }
+  base::ImportantFileWriter::WriteFileAtomically(path, json);
+}
+
+}  // namespace
+
+AppSwapConfigStore::AppSwapConfigStore(
+    const base::FilePath& profile_path,
+    base::FilePath::StringViewType file_name)
+    : config_path_(
+          profile_path.Append(FILE_PATH_LITERAL("AppSwap")).Append(file_name)),
+      task_runner_(base::ThreadPool::CreateSequencedTaskRunner(
+          {base::MayBlock(), base::TaskPriority::USER_VISIBLE,
+           base::TaskShutdownBehavior::BLOCK_SHUTDOWN})) {}
+
+AppSwapConfigStore::~AppSwapConfigStore() = default;
+
+bool AppSwapConfigStore::loaded() const {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  return loaded_;
+}
+
+void AppSwapConfigStore::RunWhenLoaded(base::OnceClosure closure) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+
+  if (loaded_) {
+    base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+        FROM_HERE, std::move(closure));
+    return;
+  }
+
+  pending_load_.push_back(std::move(closure));
+
+  if (loading_) {
+    return;
+  }
+  loading_ = true;
+
+  task_runner_->PostTaskAndReplyWithResult(
+      FROM_HERE, base::BindOnce(&ReadConfigFile, config_path_),
+      base::BindOnce(&AppSwapConfigStore::OnConfigLoaded,
+                     weak_factory_.GetWeakPtr()));
+}
+
+void AppSwapConfigStore::OnConfigLoaded(base::DictValue dict) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+
+  ParseConfig(dict);
+  loaded_ = true;
+  loading_ = false;
+  OnConfigLoadFinished();
+
+  // Swapped out before running anything: `loaded_` is already true above, so
+  // a queued closure that calls RunWhenLoaded() again posts a fresh task
+  // rather than appending here -- but taking the vector first keeps that
+  // true regardless of how this ordering is later changed.
+  std::vector<base::OnceClosure> pending = std::move(pending_load_);
+  pending_load_.clear();
+  for (base::OnceClosure& closure : pending) {
+    std::move(closure).Run();
+  }
+}
+
+void AppSwapConfigStore::Save() {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+
+  std::string json;
+  if (!base::JSONWriter::Write(SerializeConfig(), &json)) {
+    return;
+  }
+  task_runner_->PostTask(
+      FROM_HERE,
+      base::BindOnce(&WriteConfigFile, config_path_, std::move(json)));
+}
diff --git a/chrome/browser/app_swap/app_swap_config_store.h b/chrome/browser/app_swap/app_swap_config_store.h
new file mode 100644
index 0000000000000..105298b5a4ed4
--- /dev/null
+++ b/chrome/browser/app_swap/app_swap_config_store.h
@@ -0,0 +1,99 @@
+// Copyright 2026 The AppSwap Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_APP_SWAP_APP_SWAP_CONFIG_STORE_H_
+#define CHROME_BROWSER_APP_SWAP_APP_SWAP_CONFIG_STORE_H_
+
+#include <vector>
+
+#include "base/files/file_path.h"
+#include "base/functional/callback.h"
+#include "base/memory/weak_ptr.h"
+#include "base/sequence_checker.h"
+#include "base/task/sequenced_task_runner.h"
+#include "base/values.h"
+
+// Shared load/save machinery for the per-Project (== per-Chromium-Profile)
+// AppSwap JSON config files -- apps.json, route_groups.json, profiles.json.
+// Each of those services owns exactly one of these; the store handles the
+// file, the load state machine, and ordering, and the subclass supplies only
+// the parse/serialize step for its own entity.
+//
+// Two properties this exists to guarantee, both of which the three
+// hand-rolled copies it replaced got wrong:
+//
+//  * Writes are atomic and strictly ordered. Everything (the initial read
+//    included) runs on one SequencedTaskRunner and goes through
+//    base::ImportantFileWriter, so two saves in quick succession can't land
+//    out of order and persist the older snapshot, and a crash mid-write
+//    can't truncate the file.
+//
+//  * Nothing observes or mutates an unloaded config. Every public entry
+//    point on a subclass -- readers and mutators alike -- runs its work
+//    through RunWhenLoaded(), so a mutation racing the very first read
+//    can't append to an empty in-memory list and then persist *that* as the
+//    entire config, silently discarding the file's real contents.
+class AppSwapConfigStore {
+ public:
+  // `profile_path` is the Chromium Profile directory; the config lives at
+  // <profile_path>/AppSwap/<file_name>.
+  AppSwapConfigStore(const base::FilePath& profile_path,
+                     base::FilePath::StringViewType file_name);
+  virtual ~AppSwapConfigStore();
+
+  AppSwapConfigStore(const AppSwapConfigStore&) = delete;
+  AppSwapConfigStore& operator=(const AppSwapConfigStore&) = delete;
+
+  // Runs `closure` once the config is in memory, kicking off the read if it
+  // hasn't started. Always asynchronous, even when already loaded, so
+  // callers see one consistent ordering. Queued closures run in the order
+  // they were registered, which is what lets a caller sequence a reply
+  // behind a mutation it just requested (see the AddApp/RunWhenLoaded pair
+  // in AppSwapProjectsPageHandler).
+  void RunWhenLoaded(base::OnceClosure closure);
+
+  // Whether the config has finished loading. Callers that must answer
+  // synchronously (e.g. a URLLoaderFactory resolving a route per request,
+  // which can't wait on a callback) use this to decide whether their
+  // *IfLoaded() accessor has real data; everyone else should use
+  // RunWhenLoaded().
+  bool loaded() const;
+
+ protected:
+  // Populates in-memory state from `dict`, which is empty if the file was
+  // missing, unreadable, or unparseable. Called exactly once, on the owning
+  // sequence, before any closure queued with RunWhenLoaded() runs.
+  virtual void ParseConfig(const base::DictValue& dict) = 0;
+
+  // Returns the dict to persist. Called synchronously from Save().
+  virtual base::DictValue SerializeConfig() const = 0;
+
+  // Called once, after ParseConfig() and after loaded() has become true, but
+  // before any closure queued with RunWhenLoaded() runs. Override to notify
+  // observers that the state is now readable -- the ordering matters, since
+  // an observer woken here will immediately call an *IfLoaded() accessor.
+  virtual void OnConfigLoadFinished() {}
+
+  // Serializes the current state and writes it to disk. Cheap to call
+  // repeatedly; each call replaces the file atomically.
+  void Save();
+
+  SEQUENCE_CHECKER(sequence_checker_);
+
+ private:
+  void OnConfigLoaded(base::DictValue dict);
+
+  const base::FilePath config_path_;
+  // One sequence for this file: the initial read and every subsequent write
+  // run on it, in order.
+  const scoped_refptr<base::SequencedTaskRunner> task_runner_;
+
+  bool loaded_ = false;
+  bool loading_ = false;
+  std::vector<base::OnceClosure> pending_load_;
+
+  base::WeakPtrFactory<AppSwapConfigStore> weak_factory_{this};
+};
+
+#endif  // CHROME_BROWSER_APP_SWAP_APP_SWAP_CONFIG_STORE_H_
diff --git a/chrome/browser/app_swap/app_swap_config_store_unittest.cc b/chrome/browser/app_swap/app_swap_config_store_unittest.cc
new file mode 100644
index 0000000000000..28c4a03e1dc01
--- /dev/null
+++ b/chrome/browser/app_swap/app_swap_config_store_unittest.cc
@@ -0,0 +1,204 @@
+// Copyright 2026 The AppSwap Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/app_swap/app_swap_config_store.h"
+
+#include <string>
+#include <vector>
+
+#include "base/files/file_path.h"
+#include "base/files/file_util.h"
+#include "base/files/scoped_temp_dir.h"
+#include "base/functional/bind.h"
+#include "base/functional/callback_helpers.h"
+#include "base/strings/string_number_conversions.h"
+#include "base/test/task_environment.h"
+#include "base/values.h"
+#include "testing/gtest/include/gtest/gtest.h"
+
+namespace {
+
+// Minimal concrete store: one list of strings under "items". Stands in for
+// the three real services, which differ only in what they parse.
+class TestConfigStore : public AppSwapConfigStore {
+ public:
+  explicit TestConfigStore(const base::FilePath& profile_path)
+      : AppSwapConfigStore(profile_path, FILE_PATH_LITERAL("test.json")) {}
+
+  void AddItem(const std::string& item) {
+    RunWhenLoaded(base::BindOnce(&TestConfigStore::AddItemNow,
+                                 base::Unretained(this), item));
+  }
+
+  void GetItems(base::OnceCallback<void(std::vector<std::string>)> callback) {
+    RunWhenLoaded(base::BindOnce(
+        [](TestConfigStore* self,
+           base::OnceCallback<void(std::vector<std::string>)> callback) {
+          std::move(callback).Run(self->items_);
+        },
+        base::Unretained(this), std::move(callback)));
+  }
+
+  int parse_count() const { return parse_count_; }
+
+ protected:
+  void ParseConfig(const base::DictValue& dict) override {
+    ++parse_count_;
+    if (const base::ListValue* items = dict.FindList("items")) {
+      for (const base::Value& value : *items) {
+        if (const std::string* item = value.GetIfString()) {
+          items_.push_back(*item);
+        }
+      }
+    }
+  }
+
+  base::DictValue SerializeConfig() const override {
+    base::ListValue items;
+    for (const std::string& item : items_) {
+      items.Append(item);
+    }
+    base::DictValue root;
+    root.Set("items", std::move(items));
+    return root;
+  }
+
+ private:
+  void AddItemNow(const std::string& item) {
+    items_.push_back(item);
+    Save();
+  }
+
+  std::vector<std::string> items_;
+  int parse_count_ = 0;
+};
+
+class AppSwapConfigStoreTest : public testing::Test {
+ protected:
+  void SetUp() override { ASSERT_TRUE(temp_dir_.CreateUniqueTempDir()); }
+
+  base::FilePath profile_path() const { return temp_dir_.GetPath(); }
+
+  base::FilePath ConfigPath() const {
+    return profile_path()
+        .Append(FILE_PATH_LITERAL("AppSwap"))
+        .Append(FILE_PATH_LITERAL("test.json"));
+  }
+
+  void WriteConfig(const std::string& json) {
+    ASSERT_TRUE(base::CreateDirectory(ConfigPath().DirName()));
+    ASSERT_TRUE(base::WriteFile(ConfigPath(), json));
+  }
+
+  std::string ReadConfig() {
+    std::string json;
+    base::ReadFileToString(ConfigPath(), &json);
+    return json;
+  }
+
+  std::vector<std::string> GetItemsAndWait(TestConfigStore& store) {
+    std::vector<std::string> result;
+    store.GetItems(base::BindOnce(
+        [](std::vector<std::string>* out, std::vector<std::string> items) {
+          *out = std::move(items);
+        },
+        &result));
+    task_environment_.RunUntilIdle();
+    return result;
+  }
+
+  base::test::TaskEnvironment task_environment_;
+  base::ScopedTempDir temp_dir_;
+};
+
+TEST_F(AppSwapConfigStoreTest, ReadsExistingConfig) {
+  WriteConfig(R"({"items":["a","b"]})");
+  TestConfigStore store(profile_path());
+  EXPECT_EQ(std::vector<std::string>({"a", "b"}), GetItemsAndWait(store));
+}
+
+TEST_F(AppSwapConfigStoreTest, MissingFileLoadsEmpty) {
+  TestConfigStore store(profile_path());
+  EXPECT_TRUE(GetItemsAndWait(store).empty());
+}
+
+TEST_F(AppSwapConfigStoreTest, MalformedFileLoadsEmptyRatherThanFailing) {
+  WriteConfig("this is not json");
+  TestConfigStore store(profile_path());
+  EXPECT_TRUE(GetItemsAndWait(store).empty());
+}
+
+TEST_F(AppSwapConfigStoreTest, ReadsOnlyOnceForConcurrentCallers) {
+  WriteConfig(R"({"items":["a"]})");
+  TestConfigStore store(profile_path());
+  // Three requests before the first read can finish must share one load, not
+  // race three of them.
+  store.GetItems(base::DoNothing());
+  store.GetItems(base::DoNothing());
+  store.GetItems(base::DoNothing());
+  task_environment_.RunUntilIdle();
+  EXPECT_EQ(1, store.parse_count());
+}
+
+TEST_F(AppSwapConfigStoreTest, MutationBeforeLoadDoesNotDiscardExistingConfig) {
+  // The regression this exists for: a mutation issued before the initial
+  // read finished used to append to an empty in-memory list and then persist
+  // *that* as the whole config, silently dropping everything already in the
+  // file.
+  WriteConfig(R"({"items":["a","b"]})");
+  TestConfigStore store(profile_path());
+  store.AddItem("c");  // Deliberately not waiting for the load first.
+  task_environment_.RunUntilIdle();
+
+  EXPECT_EQ(std::vector<std::string>({"a", "b", "c"}), GetItemsAndWait(store));
+  EXPECT_EQ(R"({"items":["a","b","c"]})", ReadConfig());
+}
+
+TEST_F(AppSwapConfigStoreTest, QueuedWorkRunsInTheOrderItWasRequested) {
+  TestConfigStore store(profile_path());
+  store.AddItem("a");
+  store.AddItem("b");
+  store.AddItem("c");
+  task_environment_.RunUntilIdle();
+  EXPECT_EQ(std::vector<std::string>({"a", "b", "c"}), GetItemsAndWait(store));
+}
+
+TEST_F(AppSwapConfigStoreTest, RapidSavesLeaveTheNewestSnapshotOnDisk) {
+  // Every write goes through one sequenced runner, so the last mutation is
+  // the one that ends up on disk -- with unordered posting, an earlier
+  // snapshot could land last and win.
+  TestConfigStore store(profile_path());
+  for (int i = 0; i < 20; ++i) {
+    store.AddItem(base::NumberToString(i));
+  }
+  task_environment_.RunUntilIdle();
+
+  const std::vector<std::string> items = GetItemsAndWait(store);
+  ASSERT_EQ(20u, items.size());
+  EXPECT_EQ("19", items.back());
+
+  // And a fresh store reading the same file sees exactly that.
+  TestConfigStore reloaded(profile_path());
+  EXPECT_EQ(items, GetItemsAndWait(reloaded));
+}
+
+TEST_F(AppSwapConfigStoreTest, SaveCreatesTheConfigDirectory) {
+  ASSERT_FALSE(base::PathExists(ConfigPath().DirName()));
+  TestConfigStore store(profile_path());
+  store.AddItem("a");
+  task_environment_.RunUntilIdle();
+  EXPECT_TRUE(base::PathExists(ConfigPath()));
+}
+
+TEST_F(AppSwapConfigStoreTest, LoadedIsFalseUntilTheReadCompletes) {
+  WriteConfig(R"({"items":["a"]})");
+  TestConfigStore store(profile_path());
+  EXPECT_FALSE(store.loaded());
+  store.GetItems(base::DoNothing());
+  EXPECT_FALSE(store.loaded());
+  task_environment_.RunUntilIdle();
+  EXPECT_TRUE(store.loaded());
+}
+
+}  // namespace
