+
+#ifndef CHROME_BROWSER_UI_WEBUI_APP_SWAP_PROJECTS_APP_SWAP_PROJECTS_UI_H_
+#define CHROME_BROWSER_UI_WEBUI_APP_SWAP_PROJECTS_APP_SWAP_PROJECTS_UI_H_
+
+#include <memory>
+
+#include "chrome/browser/ui/webui/app_swap_projects/app_swap_projects.mojom.h"
+#include "content/public/browser/web_ui_controller.h"
+#include "content/public/browser/webui_config.h"
