+// Copyright 2026 The AppSwap Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+import {CrLitElement} from 'chrome://resources/lit/v3_0/lit.rollup.js';
+import 'chrome://resources/cr_elements/cr_tabs/cr_tabs.js';
+
+import {getCss} from './app.css.js';
+import {getHtml} from './app.html.js';
+import type {BrowserProxy} from './browser_proxy.js';
+import {BrowserProxyImpl} from './browser_proxy.js';
+import type {AppInfo, AppSwapProfileInfo, RouteGroupInfo} from './app_swap_projects.mojom-webui.js';
+
+export class AppSwapProjectsAppElement extends CrLitElement {
+  static get is() {
+    return 'app-swap-projects-app';
+  }
+
+  static override get styles() {
+    return getCss();
+  }
+
+  override render() {
+    return getHtml.bind(this)();
+  }
+
+  static override get properties() {
+    return {
+      selectedTab_: {type: Number},
+      tabNames_: {type: Array},
+      projectName_: {type: String},
+      apps_: {type: Array},
+      routeGroups_: {type: Array},
+      profiles_: {type: Array},
+      activeProfileId_: {type: String},
+      newAppTitle_: {type: String},
+      newAppPackage_: {type: String},
+      newAppVersion_: {type: String},
+      newAppRegistry_: {type: String},
+      newAppToken_: {type: String},
+      newAppHosts_: {type: String},
+      newGroupName_: {type: String},
+      pendingRules_: {type: Object},
+      newProfileName_: {type: String},
+    };
+  }
+
+  private apiProxy_: BrowserProxy = BrowserProxyImpl.getInstance();
+
+  protected accessor selectedTab_: number = 0;
+  protected accessor tabNames_: string[] = ['General', 'Apps', 'Routes', 'Profiles'];
+  protected accessor projectName_: string = '';
+  protected accessor apps_: AppInfo[] = [];
+  protected accessor routeGroups_: RouteGroupInfo[] = [];
+  protected accessor profiles_: AppSwapProfileInfo[] = [];
+  protected accessor activeProfileId_: string|null = null;
+
+  protected accessor newAppTitle_: string = '';
+  protected accessor newAppPackage_: string = '';
+  protected accessor newAppVersion_: string = '';
+  protected accessor newAppRegistry_: string = '';
+  protected accessor newAppToken_: string = '';
+  protected accessor newAppHosts_: string = '';
+
+  protected accessor newGroupName_: string = '';
+  // Keyed by group id -- each route group renders its own "add rule" mini
+  // form, and they must not share pending state (a single pair of
+  // newRulePattern_/newRuleTarget_ properties made every group's form mirror
+  // whatever was typed into any one of them).
+  protected accessor pendingRules_: Record<string, {pattern: string, target: string}> = {};
+
+  protected accessor newProfileName_: string = '';
+
+  override connectedCallback() {
+    super.connectedCallback();
+    this.refreshAll_();
+  }
+
+  private async refreshAll_() {
+    const {name} = await this.apiProxy_.handler.getProjectName();
+    this.projectName_ = name;
+    await Promise.all([
+      this.refreshApps_(),
+      this.refreshRouteGroups_(),
+      this.refreshProfiles_(),
+    ]);
+  }
+
+  private async refreshApps_() {
+    const {apps} = await this.apiProxy_.handler.getApps();
+    this.apps_ = apps;
+  }
+
+  private async refreshRouteGroups_() {
+    const {groups} = await this.apiProxy_.handler.getRouteGroups();
+    this.routeGroups_ = groups;
+  }
+
+  private async refreshProfiles_() {
+    const {profiles, activeProfileId} =
+        await this.apiProxy_.handler.getAppSwapProfiles();
+    this.profiles_ = profiles;
+    this.activeProfileId_ = activeProfileId ?? null;
+  }
+
+  protected onTabsSelectedChanged_(e: CustomEvent<{value: number}>) {
+    this.selectedTab_ = e.detail.value;
+  }
+
+  // Generic text-field binding: every plain <input> in this page carries
+  // data-field="<propertyName>" and routes through here rather than a
+  // separate handler per field -- there are ten near-identical fields across
+  // the four tabs' forms, and a dedicated handler per field would just be
+  // that same three-line body copy-pasted ten times.
+  protected onFieldInput_(e: Event) {
+    const input = e.target as HTMLInputElement;
+    const field = input.dataset['field']!;
+    (this as unknown as Record<string, string>)[field] = input.value;
+  }
+
+  protected async onAddAppClick_() {
+    const hosts = this.newAppHosts_.split(',')
+                      .map(h => h.trim())
+                      .filter(h => h.length > 0);
+    await this.apiProxy_.handler.addApp({
+      id: '',
+      title: this.newAppTitle_,
+      packageName: this.newAppPackage_,
+      version: this.newAppVersion_,
+      registry: this.newAppRegistry_,
+      token: this.newAppToken_,
+      hosts,
+    });
+    this.newAppTitle_ = '';
+    this.newAppPackage_ = '';
+    this.newAppVersion_ = '';
+    this.newAppRegistry_ = '';
+    this.newAppToken_ = '';
+    this.newAppHosts_ = '';
+    await this.refreshApps_();
+  }
+
+  protected async onRemoveAppClick_(e: Event) {
+    const id = (e.currentTarget as HTMLElement).dataset['id']!;
+    await this.apiProxy_.handler.removeApp(id);
+    await this.refreshApps_();
+  }
+
+  protected async onAddRouteGroupClick_() {
+    if (!this.newGroupName_.trim()) {
+      return;
+    }
+    await this.apiProxy_.handler.addRouteGroup(this.newGroupName_);
+    this.newGroupName_ = '';
+    await this.refreshRouteGroups_();
+  }
+
+  protected async onRemoveRouteGroupClick_(e: Event) {
+    const id = (e.currentTarget as HTMLElement).dataset['id']!;
+    await this.apiProxy_.handler.removeRouteGroup(id);
+    await this.refreshRouteGroups_();
+  }
+
+  // Returns the in-progress "add rule" field values for `groupId`'s own
+  // form, never another group's -- see pendingRules_.
+  protected getPendingRule_(groupId: string): {pattern: string, target: string} {
+    return this.pendingRules_[groupId] || {pattern: '', target: ''};
+  }
+
+  protected onRuleFieldInput_(e: Event) {
+    const input = e.target as HTMLInputElement;
+    const groupId = input.dataset['groupId']!;
+    const field = input.dataset['ruleField'] as 'pattern' | 'target';
+    const current = this.getPendingRule_(groupId);
+    this.pendingRules_ = {
+      ...this.pendingRules_,
+      [groupId]: {...current, [field]: input.value},
+    };
+  }
+
+  protected async onAddRuleClick_(e: Event) {
+    const groupId = (e.currentTarget as HTMLElement).dataset['groupId']!;
+    const pending = this.getPendingRule_(groupId);
+    if (!pending.pattern.trim() || !pending.target.trim()) {
+      return;
+    }
+    await this.apiProxy_.handler.addRule(groupId, pending.pattern, pending.target);
+    const rest = {...this.pendingRules_};
+    delete rest[groupId];
+    this.pendingRules_ = rest;
+    await this.refreshRouteGroups_();
+  }
+
+  protected async onRemoveRuleClick_(e: Event) {
+    const target = e.currentTarget as HTMLElement;
+    const groupId = target.dataset['groupId']!;
+    const ruleId = target.dataset['ruleId']!;
+    await this.apiProxy_.handler.removeRule(groupId, ruleId);
+    await this.refreshRouteGroups_();
+  }
+
+  protected async onAddProfileClick_() {
+    if (!this.newProfileName_.trim()) {
+      return;
+    }
+    await this.apiProxy_.handler.addAppSwapProfile(this.newProfileName_);
+    this.newProfileName_ = '';
+    await this.refreshProfiles_();
+  }
+
+  protected async onRemoveProfileClick_(e: Event) {
+    const id = (e.currentTarget as HTMLElement).dataset['id']!;
+    await this.apiProxy_.handler.removeAppSwapProfile(id);
+    await this.refreshProfiles_();
+  }
+
+  protected async onSetActiveProfileClick_(e: Event) {
+    const id = (e.currentTarget as HTMLElement).dataset['id']!;
+    await this.apiProxy_.handler.setActiveAppSwapProfile(id);
+    await this.refreshProfiles_();
+  }
+}
+
+declare global {
+  interface HTMLElementTagNameMap {
+    'app-swap-projects-app': AppSwapProjectsAppElement;
+  }
+}
+
+customElements.define(
+    AppSwapProjectsAppElement.is, AppSwapProjectsAppElement);
