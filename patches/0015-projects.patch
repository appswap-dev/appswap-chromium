diff --git a/chrome/browser/ui/webui/app_swap_projects/app_swap_projects.mojom b/chrome/browser/ui/webui/app_swap_projects/app_swap_projects.mojom
new file mode 100644
index 0000000000000..66c1244b19f48
--- /dev/null
