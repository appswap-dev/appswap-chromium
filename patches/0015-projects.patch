+// Copyright 2026 The AppSwap Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/app_swap/app_swap_route_group_pin_tab_helper.h"
+
+#include <utility>
+
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/browser/sessions/session_service.h"
+#include "chrome/browser/sessions/session_service_factory.h"
+#include "components/sessions/content/session_tab_helper.h"
+#include "content/public/browser/render_frame_host.h"
+#include "content/public/browser/web_contents.h"
+
+namespace {
+
+constexpr char kAppSwapRouteGroupPinExtraDataKey[] = "appswap.route_group_pin";
+
+}  // namespace
+
+AppSwapRouteGroupPinTabHelper::AppSwapRouteGroupPinTabHelper(
+    content::WebContents* web_contents)
+    : content::WebContentsObserver(web_contents),
+      content::WebContentsUserData<AppSwapRouteGroupPinTabHelper>(
+          *web_contents) {
+  // New tabs opened from an existing tab (link click, Ctrl+click, "open in
+  // new tab", window.open()) inherit the opener's pinned route group -- e.g.
+  // opening an API link from a tab pinned to "Beta" should keep testing
+  // "Beta" in the new tab, not silently fall back to unpinned/direct. This
+  // has no equivalent in AppSwapVersionPinTabHelper (which starts every new
+  // tab unpinned) or in AppSwapProfilesService (whose "inheritance" is
+  // actually a side effect of a single global active-profile pointer, not
+  // real per-tab copying) -- see GetStoragePartitionConfigForSite.
+  if (content::RenderFrameHost* opener = web_contents->GetOpener()) {
+    if (content::WebContents* opener_contents =
+            content::WebContents::FromRenderFrameHost(opener)) {
+      if (AppSwapRouteGroupPinTabHelper* opener_helper =
+              AppSwapRouteGroupPinTabHelper::FromWebContents(
+                  opener_contents)) {
+        pinned_group_id_ = opener_helper->pinned_group_id_;
+      }
+    }
+  }
+}
+
+AppSwapRouteGroupPinTabHelper::~AppSwapRouteGroupPinTabHelper() = default;
+
+void AppSwapRouteGroupPinTabHelper::SetPinnedGroup(
+    const std::string& group_id) {
+  if (group_id.empty()) {
+    pinned_group_id_.reset();
+  } else {
+    pinned_group_id_ = group_id;
+  }
+  Persist();
+}
+
+std::optional<std::string> AppSwapRouteGroupPinTabHelper::GetPinnedGroup()
+    const {
+  return pinned_group_id_;
+}
+
+void AppSwapRouteGroupPinTabHelper::PrimaryPageChanged(content::Page& page) {
+  // Re-persist on every commit, mirroring
+  // AppSwapVersionPinTabHelper::PrimaryPageChanged -- see its comment for
+  // why (a tab whose pin was populated via RestoreFromExtraData or opener
+  // inheritance, rather than a direct SetPinnedGroup() call, still needs to
+  // land in *this* session's own SessionService log).
+  Persist();
+}
+
+// static
+void AppSwapRouteGroupPinTabHelper::RestoreFromExtraData(
+    content::WebContents* web_contents,
+    const std::map<std::string, std::string>& extra_data) {
+  auto it = extra_data.find(kAppSwapRouteGroupPinExtraDataKey);
+  if (it == extra_data.end() || it->second.empty()) {
+    return;
+  }
+  AppSwapRouteGroupPinTabHelper* helper =
+      GetOrCreateForWebContents(web_contents);
+  helper->pinned_group_id_ = it->second;
+}
+
+void AppSwapRouteGroupPinTabHelper::Persist() {
+  content::WebContents* contents = web_contents();
+  Profile* profile = Profile::FromBrowserContext(contents->GetBrowserContext());
+  SessionService* session_service = SessionServiceFactory::GetForProfile(profile);
+  if (!session_service) {
+    return;
+  }
+  SessionID window_id =
+      sessions::SessionTabHelper::IdForWindowContainingTab(contents);
+  SessionID tab_id = sessions::SessionTabHelper::IdForTab(contents);
+  if (!window_id.is_valid() || !tab_id.is_valid()) {
+    return;
+  }
+  session_service->AddTabExtraData(window_id, tab_id,
+                                   kAppSwapRouteGroupPinExtraDataKey,
+                                   pinned_group_id_.value_or(std::string()));
+}
+
+WEB_CONTENTS_USER_DATA_KEY_IMPL(AppSwapRouteGroupPinTabHelper);
