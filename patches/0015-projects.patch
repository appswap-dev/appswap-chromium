+}
+
+h2 {
+  font-size: 16px;
+  margin: 20px 0 8px;
+}
+
+h3 {
+  font-size: 13px;
+  margin: 12px 0 6px;
+}
+
+.hint {
+  color: var(--cr-secondary-text-color, #5f6368);
+  font-size: 0.9em;
+}
+
+section {
+  max-width: 640px;
+}
+
+.row {
+  align-items: center;
+  border-bottom: 1px solid var(--cr-separator-color, #e0e0e0);
+  display: flex;
+  gap: 12px;
+  justify-content: space-between;
