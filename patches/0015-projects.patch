+
+namespace content {
+class RenderFrameHost;
+}  // namespace content
+
+class AppSwapProjectsUIConfig
+    : public content::DefaultWebUIConfig<AppSwapProjectsUI> {
+ public:
+  AppSwapProjectsUIConfig();
+};
+
+// appswap://projects (chrome://appswap-projects under the hood): the single
+// admin page for a Project -- General/Apps/Routes/Profiles tabs. Always
+// scoped to whichever Profile's window it's opened in (Project == Chromium
+// Profile, see the "Projects" plan) -- no project id ever crosses Mojo, the
+// PageHandler just resolves Profile::FromWebUI(web_ui()).
+class AppSwapProjectsUI : public content::WebUIController,
+                          public app_swap_projects::mojom::PageHandlerFactory {
+ public:
+  explicit AppSwapProjectsUI(content::WebUI* web_ui);
+  AppSwapProjectsUI(const AppSwapProjectsUI&) = delete;
+  AppSwapProjectsUI& operator=(const AppSwapProjectsUI&) = delete;
+  ~AppSwapProjectsUI() override;
+
+  void BindInterface(
+      mojo::PendingReceiver<app_swap_projects::mojom::PageHandlerFactory>
+          receiver);
+
+ private:
+  // content::WebUIController:
+  void WebUIRenderFrameCreated(content::RenderFrameHost* rfh) override;
+
+  // app_swap_projects::mojom::PageHandlerFactory:
+  void CreatePageHandler(
+      mojo::PendingReceiver<app_swap_projects::mojom::PageHandler> handler)
+      override;
+
+  std::unique_ptr<AppSwapProjectsPageHandler> page_handler_;
+  mojo::Receiver<app_swap_projects::mojom::PageHandlerFactory>
+      page_factory_receiver_{this};
+
+  WEB_UI_CONTROLLER_TYPE_DECL();
+};
+
+#endif  // CHROME_BROWSER_UI_WEBUI_APP_SWAP_PROJECTS_APP_SWAP_PROJECTS_UI_H_
