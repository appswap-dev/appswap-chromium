+// Copyright 2026 The AppSwap Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+import {PageHandlerFactory, PageHandlerRemote} from './app_swap_projects.mojom-webui.js';
+
+export interface BrowserProxy {
+  handler: PageHandlerRemote;
+}
+
+export class BrowserProxyImpl implements BrowserProxy {
+  handler: PageHandlerRemote = new PageHandlerRemote();
+
+  constructor() {
+    const factory = PageHandlerFactory.getRemote();
+    factory.createPageHandler(this.handler.$.bindNewPipeAndPassReceiver());
+  }
+
+  static getInstance(): BrowserProxy {
+    return instance || (instance = new BrowserProxyImpl());
+  }
+
+  static setInstance(obj: BrowserProxy) {
+    instance = obj;
+  }
+}
+
+let instance: BrowserProxy|null = null;
diff --git a/chrome/browser/ui/views/app_swap/app_swap_route_group_tab_strip_button.cc b/chrome/browser/ui/views/app_swap/app_swap_route_group_tab_strip_button.cc
new file mode 100644
index 0000000000000..00a2887001110
--- /dev/null
+++ b/chrome/browser/ui/views/app_swap/app_swap_route_group_tab_strip_button.cc
@@ -0,0 +1,252 @@
+// Copyright 2026 The AppSwap Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/views/app_swap/app_swap_route_group_tab_strip_button.h"
+
+#include <iterator>
+#include <optional>
+#include <string>
+#include <utility>
+
+#include "base/functional/bind.h"
+#include "base/hash/hash.h"
+#include "base/strings/utf_string_conversions.h"
+#include "chrome/browser/app_swap/app_swap_route_group_pin_tab_helper.h"
+#include "chrome/browser/app_swap/app_swap_route_group_service_factory.h"
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/browser/ui/browser_window/public/browser_window_interface.h"
+#include "chrome/browser/ui/tabs/tab_strip_model.h"
+#include "content/public/browser/navigation_controller.h"
+#include "content/public/browser/web_contents.h"
+#include "ui/base/metadata/metadata_impl_macros.h"
+#include "ui/base/mojom/menu_source_type.mojom.h"
+#include "ui/base/models/menu_separator_types.h"
+#include "ui/base/window_open_disposition.h"
+#include "ui/color/color_id.h"
+#include "ui/color/color_provider.h"
+#include "ui/gfx/color_utils.h"
+#include "ui/gfx/geometry/insets.h"
+#include "ui/views/background.h"
+#include "ui/views/border.h"
+#include "ui/views/controls/menu/menu_item_view.h"
+#include "ui/views/controls/menu/menu_model_adapter.h"
+#include "ui/views/controls/menu/menu_runner.h"
+#include "url/gurl.h"
+
+namespace {
+
+// Command ids for the route-group menu. Purely local to this menu's own
+// ExecuteCommand -- not part of chrome's global command-id space.
+constexpr int kDirectCommandId = 1;
+constexpr int kManageCommandId = 2;
+constexpr int kGroupCommandBase = 3;
+
+constexpr float kBadgeCornerRadius = 6.0f;
+
+// Same curated palette as AppSwapProfileTabStripButton -- see its comment
+// for why these specific hues (avoids washed-out yellows, spans hues that
+// stay distinct under red-green color blindness).
+constexpr double kBadgeHues[] = {
+    210.0,  // blue
+    175.0,  // teal
+    150.0,  // blue-leaning green (not yellow-green)
+    265.0,  // purple
+    330.0,  // magenta / pink
+    25.0,   // orange
+    245.0,  // indigo
+    355.0,  // pink-leaning red
+};
+
+double HueForGroupName(const std::string& name) {
+  return kBadgeHues[base::PersistentHash(name) % std::size(kBadgeHues)];
+}
+
+SkColor ComputeBadgeBackgroundColor(const std::string& name, bool dark_theme) {
+  color_utils::HSL hsl;
+  hsl.h = HueForGroupName(name) / 360.0;
+  hsl.s = dark_theme ? 0.40 : 0.62;
+  hsl.l = dark_theme ? 0.28 : 0.80;
+  return color_utils::HSLToSkColor(hsl, SK_AlphaOPAQUE);
+}
+
+SkColor ComputeBadgeTextColor(SkColor background) {
+  return color_utils::BlendForMinContrast(SK_ColorBLACK, background).color;
+}
+
+}  // namespace
+
+AppSwapRouteGroupTabStripButton::AppSwapRouteGroupTabStripButton(
+    BrowserWindowInterface* browser)
+    : views::MenuButton(base::BindRepeating(
+          &AppSwapRouteGroupTabStripButton::ButtonPressed,
+          base::Unretained(this))),
+      browser_(browser) {
+  SetVisible(false);
+  browser_->GetTabStripModel()->AddObserver(this);
+  UpdateForActiveTab();
+}
+
+AppSwapRouteGroupTabStripButton::~AppSwapRouteGroupTabStripButton() {
+  browser_->GetTabStripModel()->RemoveObserver(this);
+}
+
+void AppSwapRouteGroupTabStripButton::OnTabStripModelChanged(
+    TabStripModel* tab_strip_model,
+    const TabStripModelChange& change,
+    const TabStripSelectionChange& selection) {
+  if (selection.active_tab_changed()) {
+    UpdateForActiveTab();
+  }
+}
+
+void AppSwapRouteGroupTabStripButton::OnTabChangedAt(
+    tabs::TabInterface* tab,
+    TabChangeType change_type) {
+  UpdateForActiveTab();
+}
+
+void AppSwapRouteGroupTabStripButton::UpdateForActiveTab() {
+  // Route Groups don't apply to Incognito/Guest/System windows --
+  // AppSwapRouteGroupServiceFactory only builds an instance for regular
+  // profiles (ProfileKeyedServiceFactory's default ProfileSelections), so
+  // this button just stays permanently hidden there instead of crashing
+  // (see the matching guard in ButtonPressed(), and
+  // AppSwapProfileTabStripButton's constructor for how this was actually
+  // discovered -- a real crash dump from opening an Incognito window).
+  AppSwapRouteGroupService* service =
+      AppSwapRouteGroupServiceFactory::GetForProfile(browser_->GetProfile());
+  if (!service) {
+    SetVisible(false);
+    return;
+  }
+
+  content::WebContents* web_contents =
+      browser_->GetTabStripModel()->GetActiveWebContents();
+
+  if (!web_contents ||
+      !web_contents->GetLastCommittedURL().SchemeIsHTTPOrHTTPS()) {
+    SetVisible(false);
+    return;
+  }
+
+  if (AppSwapRouteGroupPinTabHelper* pin_helper =
+          AppSwapRouteGroupPinTabHelper::FromWebContents(web_contents)) {
+    if (std::optional<std::string> group_id = pin_helper->GetPinnedGroup()) {
+      for (const AppSwapRouteGroup& group : service->GetRouteGroupsIfLoaded()) {
+        if (group.id == *group_id) {
+          SetText(base::UTF8ToUTF16(group.name));
+          ApplyBadgeStyle(group.name);
+          SetVisible(true);
+          return;
+        }
+      }
+      // The pinned group has since been removed -- fall through to the
+      // "unpinned" placeholder below.
+    }
+  }
+
+  SetText(u"Routes");
+  ApplyBadgeStyle("Routes");
+  SetVisible(true);
+}
+
+void AppSwapRouteGroupTabStripButton::ApplyBadgeStyle(
+    const std::string& group_name) {
+  bool dark_theme = false;
+  if (const ui::ColorProvider* color_provider = GetColorProvider()) {
+    dark_theme =
+        color_utils::IsDark(color_provider->GetColor(ui::kColorWindowBackground));
+  }
+
+  const SkColor background_color =
+      ComputeBadgeBackgroundColor(group_name, dark_theme);
+  const SkColor text_color = ComputeBadgeTextColor(background_color);
+
+  SetBackground(
+      views::CreateRoundedRectBackground(background_color, kBadgeCornerRadius));
+  SetEnabledTextColors(text_color);
+  SetBorder(views::CreateEmptyBorder(gfx::Insets::VH(4, 10)));
+}
+
+void AppSwapRouteGroupTabStripButton::OnThemeChanged() {
+  views::MenuButton::OnThemeChanged();
+  UpdateForActiveTab();
+}
+
+void AppSwapRouteGroupTabStripButton::ButtonPressed() {
+  AppSwapRouteGroupService* service =
+      AppSwapRouteGroupServiceFactory::GetForProfile(browser_->GetProfile());
+  if (!service) {
+    return;
+  }
+
+  // Tear down any previous menu before rebuilding -- see
+  // AppSwapProfileTabStripButton::ButtonPressed for why this ordering
+  // (menu_runner_ first) matters.
+  menu_runner_.reset();
+  menu_model_adapter_.reset();
+  menu_model_.reset();
+
+  menu_groups_ = service->GetRouteGroupsIfLoaded();
+
+  menu_model_ = std::make_unique<ui::SimpleMenuModel>(this);
+  menu_model_->AddItem(kDirectCommandId, u"Direct (no rewriting)");
+  if (!menu_groups_.empty()) {
+    menu_model_->AddSeparator(ui::NORMAL_SEPARATOR);
+    for (size_t i = 0; i < menu_groups_.size(); ++i) {
+      const AppSwapRouteGroup& group = menu_groups_[i];
+      menu_model_->AddItem(kGroupCommandBase + static_cast<int>(i),
+                           base::UTF8ToUTF16(group.name));
+    }
+  }
+  menu_model_->AddSeparator(ui::NORMAL_SEPARATOR);
+  menu_model_->AddItem(kManageCommandId, u"Manage route groups");
+
+  menu_model_adapter_ = std::make_unique<views::MenuModelAdapter>(
+      menu_model_.get());
+  std::unique_ptr<views::MenuItemView> root = menu_model_adapter_->CreateMenu();
+  menu_runner_ = std::make_unique<views::MenuRunner>(
+      std::move(root), views::MenuRunner::HAS_MNEMONICS);
+  menu_runner_->RunMenuAt(GetWidget(), nullptr, GetAnchorBoundsInScreen(),
+                          views::MenuAnchorPosition::kTopLeft,
+                          ui::mojom::MenuSourceType::kNone);
+}
+
+void AppSwapRouteGroupTabStripButton::ExecuteCommand(int command_id,
+                                                      int event_flags) {
+  content::WebContents* web_contents =
+      browser_->GetTabStripModel()->GetActiveWebContents();
+  if (!web_contents) {
+    return;
+  }
+
+  if (command_id == kManageCommandId) {
+    browser_->OpenGURL(GURL("appswap://projects"),
+                       WindowOpenDisposition::NEW_FOREGROUND_TAB);
+    return;
+  }
+
+  std::string group_id;  // Empty means "unpin".
+  if (command_id != kDirectCommandId) {
+    const size_t index =
+        static_cast<size_t>(command_id - kGroupCommandBase);
+    if (index >= menu_groups_.size()) {
+      return;
+    }
+    group_id = menu_groups_[index].id;
+  }
+
+  AppSwapRouteGroupPinTabHelper::GetOrCreateForWebContents(web_contents)
+      ->SetPinnedGroup(group_id);
+  // Unlike a Profile switch (which needs a whole new WebContents pinned to a
+  // different SiteInstance/storage partition), a route group pin doesn't
+  // change storage identity -- a plain reload is enough for the new pin to
+  // take effect on the next request this tab makes.
+  web_contents->GetController().Reload(content::ReloadType::NORMAL,
+                                       /*check_for_repost=*/false);
+  UpdateForActiveTab();
+}
+
+BEGIN_METADATA(AppSwapRouteGroupTabStripButton)
+END_METADATA
