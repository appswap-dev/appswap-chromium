@@ -0,0 +1,208 @@
+// Copyright 2026 The AppSwap Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+import {html} from 'chrome://resources/lit/v3_0/lit.rollup.js';
+
+import type {AppSwapProjectsAppElement} from './app.js';
+
+export function getHtml(this: AppSwapProjectsAppElement) {
+  // clang-format off
+  return html`
+    <h1>${this.projectName_ || 'Project settings'}</h1>
+    <cr-tabs .tabNames="${this.tabNames_}" .selected="${this.selectedTab_}"
+        @selected-changed="${this.onTabsSelectedChanged_}">
+    </cr-tabs>
+
+    ${this.selectedTab_ === 0 ? html`
+      <section>
+        <h2>General</h2>
+        <div class="form">
+          <h3>Project name</h3>
+          <input placeholder="Project name" data-field="projectNameDraft_"
+              .value="${this.projectNameDraft_}" @input="${this.onFieldInput_}">
+          <button @click="${this.onRenameProjectClick_}">Rename</button>
+        </div>
+        <div class="form">
+          <h3>Delete project</h3>
+          <p class="hint">A Project is a Chromium Profile: deleting it also
+            deletes its bookmarks, history, cookies and open tabs, and closes
+            its windows. This can't be undone.</p>
+          ${this.confirmingDelete_ ? html`
+            <p class="hint">Permanently delete
+              <strong>${this.projectName_}</strong> and everything in it?</p>
+            <button class="danger" @click="${this.onConfirmDeleteProjectClick_}">
+              Delete permanently
+            </button>
+            <button @click="${this.onCancelDeleteProjectClick_}">Cancel</button>
+          ` : html`
+            <button class="danger" @click="${this.onDeleteProjectClick_}">
+              Delete this project
+            </button>
+          `}
+        </div>
+      </section>
+    ` : ''}
+
+    ${this.selectedTab_ === 1 ? html`
+      <section>
+        <h2>Apps</h2>
+        ${this.apps_.length === 0 ? html`<p class="hint">No apps yet.</p>` : ''}
+        ${this.apps_.map(app => this.editingAppId_ === app.id ? html`
+          <div class="form">
+            <h3>Edit app</h3>
+            <input placeholder="Title" data-field="editAppTitle_"
+                .value="${this.editAppTitle_}" @input="${this.onFieldInput_}">
+            <input placeholder="Package name (e.g. @org/app)"
+                data-field="editAppPackage_" .value="${this.editAppPackage_}"
+                @input="${this.onFieldInput_}">
+            <input placeholder="Version (exact or dist-tag)"
+                data-field="editAppVersion_" .value="${this.editAppVersion_}"
+                @input="${this.onFieldInput_}">
+            <input placeholder="Registry (e.g. https://registry.npmjs.org)"
+                data-field="editAppRegistry_" .value="${this.editAppRegistry_}"
+                @input="${this.onFieldInput_}">
+            <input placeholder="Token (optional)" data-field="editAppToken_"
+                .value="${this.editAppToken_}" @input="${this.onFieldInput_}">
+            <input placeholder="Hosts, comma-separated (e.g. https://my-app.dev)"
+                data-field="editAppHosts_" .value="${this.editAppHosts_}"
+                @input="${this.onFieldInput_}">
+            <button @click="${this.onSaveAppClick_}">Save</button>
+            <button @click="${this.onCancelEditAppClick_}">Cancel</button>
+          </div>
+        ` : html`
+          <div class="row">
+            <div class="row-main">
+              <div class="primary">${app.title}</div>
+              <div class="secondary">${app.packageName}@${app.version}
+                &middot; ${app.registry}</div>
+              <div class="secondary">Hosts: ${app.hosts.join(', ') || '(none)'}</div>
+            </div>
+            <button data-id="${app.id}" @click="${this.onEditAppClick_}">Edit</button>
+            <button data-id="${app.id}" @click="${this.onRemoveAppClick_}">Remove</button>
+          </div>
+        `)}
+        <div class="form">
+          <h3>Add app</h3>
+          <input placeholder="Title" data-field="newAppTitle_"
+              .value="${this.newAppTitle_}" @input="${this.onFieldInput_}">
+          <input placeholder="Package name (e.g. @org/app)" data-field="newAppPackage_"
+              .value="${this.newAppPackage_}" @input="${this.onFieldInput_}">
+          <input placeholder="Version (exact or dist-tag)" data-field="newAppVersion_"
+              .value="${this.newAppVersion_}" @input="${this.onFieldInput_}">
+          <input placeholder="Registry (e.g. https://registry.npmjs.org)"
+              data-field="newAppRegistry_" .value="${this.newAppRegistry_}"
+              @input="${this.onFieldInput_}">
+          <input placeholder="Token (optional)" data-field="newAppToken_"
+              .value="${this.newAppToken_}" @input="${this.onFieldInput_}">
+          <input placeholder="Hosts, comma-separated (e.g. https://my-app.dev)"
+              data-field="newAppHosts_" .value="${this.newAppHosts_}"
+              @input="${this.onFieldInput_}">
+          <button @click="${this.onAddAppClick_}">Add app</button>
+        </div>
+      </section>
+    ` : ''}
+
+    ${this.selectedTab_ === 2 ? html`
+      <section>
+        <h2>Routes</h2>
+        ${this.routeGroups_.length === 0 ? html`<p class="hint">No route groups yet.</p>` : ''}
+        ${this.routeGroups_.map(group => html`
+          <div class="group">
+            ${this.editingGroupId_ === group.id ? html`
+              <div class="form">
+                <input placeholder="Name (e.g. Beta, Prod)"
+                    data-field="editGroupName_" .value="${this.editGroupName_}"
+                    @input="${this.onFieldInput_}">
+                <button @click="${this.onSaveRouteGroupClick_}">Save</button>
+                <button @click="${this.onCancelEditRouteGroupClick_}">Cancel</button>
+              </div>
+            ` : html`
+              <div class="group-header">
+                <strong>${group.name}</strong>
+                <button data-id="${group.id}" @click="${this.onEditRouteGroupClick_}">Rename</button>
+                <button data-id="${group.id}" @click="${this.onRemoveRouteGroupClick_}">Remove group</button>
+              </div>
+            `}
+            ${group.rules.length === 0 ? html`<p class="hint">No rules -- direct calls.</p>` : ''}
+            ${group.rules.map(rule => this.editingRuleId_ === rule.id ? html`
+              <div class="form">
+                <input placeholder="URL pattern (e.g. https://api.my-app.dev)"
+                    data-field="editRulePattern_" .value="${this.editRulePattern_}"
+                    @input="${this.onFieldInput_}">
+                <input placeholder="Rewrite target (e.g. https://api.beta.my-app.dev)"
+                    data-field="editRuleTarget_" .value="${this.editRuleTarget_}"
+                    @input="${this.onFieldInput_}">
+                <button @click="${this.onSaveRuleClick_}">Save</button>
+                <button @click="${this.onCancelEditRuleClick_}">Cancel</button>
+              </div>
+            ` : html`
+              <div class="row">
+                <div class="row-main">
+                  <span class="primary">${rule.urlPattern}</span>
+                  <span class="secondary">&rarr; ${rule.target}</span>
+                </div>
+                <button data-group-id="${group.id}" data-rule-id="${rule.id}"
+                    @click="${this.onEditRuleClick_}">Edit</button>
+                <button data-group-id="${group.id}" data-rule-id="${rule.id}"
+                    @click="${this.onRemoveRuleClick_}">Remove</button>
+              </div>
+            `)}
+            <div class="form">
+              <input placeholder="URL pattern (e.g. https://api.my-app.dev)"
+                  data-group-id="${group.id}" data-rule-field="pattern"
+                  .value="${this.getPendingRule_(group.id).pattern}"
+                  @input="${this.onRuleFieldInput_}">
+              <input placeholder="Rewrite target (e.g. https://api.beta.my-app.dev)"
+                  data-group-id="${group.id}" data-rule-field="target"
+                  .value="${this.getPendingRule_(group.id).target}"
+                  @input="${this.onRuleFieldInput_}">
+              <button data-group-id="${group.id}" @click="${this.onAddRuleClick_}">Add rule</button>
+            </div>
+          </div>
+        `)}
+        <div class="form">
+          <h3>Add route group</h3>
+          <input placeholder="Name (e.g. Beta, Prod)" data-field="newGroupName_"
+              .value="${this.newGroupName_}" @input="${this.onFieldInput_}">
+          <button @click="${this.onAddRouteGroupClick_}">Add group</button>
+        </div>
+      </section>
+    ` : ''}
+
+    ${this.selectedTab_ === 3 ? html`
+      <section>
+        <h2>Profiles</h2>
+        <p class="hint">A separate storage identity within this project --
+          e.g. testing two logged-in accounts against the same app.</p>
+        ${this.profiles_.length === 0 ? html`<p class="hint">No profiles yet.</p>` : ''}
+        ${this.profiles_.map(profile => this.editingProfileId_ === profile.id ? html`
+          <div class="form">
+            <input placeholder="Name" data-field="editProfileName_"
+                .value="${this.editProfileName_}" @input="${this.onFieldInput_}">
+            <button @click="${this.onSaveProfileClick_}">Save</button>
+            <button @click="${this.onCancelEditProfileClick_}">Cancel</button>
+          </div>
+        ` : html`
+          <div class="row">
+            <div class="row-main">
+              <span class="primary">${profile.name}</span>
+              ${profile.id === this.activeProfileId_ ? html`<span class="badge">Active</span>` : ''}
+            </div>
+            ${profile.id !== this.activeProfileId_ ? html`
+              <button data-id="${profile.id}" @click="${this.onSetActiveProfileClick_}">Set active</button>
+            ` : ''}
+            <button data-id="${profile.id}" @click="${this.onEditProfileClick_}">Rename</button>
+            <button data-id="${profile.id}" @click="${this.onRemoveProfileClick_}">Remove</button>
+          </div>
+        `)}
+        <div class="form">
+          <h3>Add profile</h3>
+          <input placeholder="Name" data-field="newProfileName_"
+              .value="${this.newProfileName_}" @input="${this.onFieldInput_}">
+          <button @click="${this.onAddProfileClick_}">Add profile</button>
+        </div>
+      </section>
+    ` : ''}`;
+  // clang-format on
+}
diff --git a/chrome/browser/resources/app_swap_projects/app.ts b/chrome/browser/resources/app_swap_projects/app.ts
new file mode 100644
index 0000000000000..0fa827e04f565
--- /dev/null
+++ b/chrome/browser/resources/app_swap_projects/app.ts
@@ -0,0 +1,423 @@
+// Copyright 2026 The AppSwap Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+import {CrLitElement} from 'chrome://resources/lit/v3_0/lit.rollup.js';
+import 'chrome://resources/cr_elements/cr_tabs/cr_tabs.js';
+
+import {getCss} from './app.css.js';
+import {getHtml} from './app.html.js';
+import type {BrowserProxy} from './browser_proxy.js';
+import {BrowserProxyImpl} from './browser_proxy.js';
+import type {AppInfo, AppSwapProfileInfo, RouteGroupInfo} from './app_swap_projects.mojom-webui.js';
+
+export class AppSwapProjectsAppElement extends CrLitElement {
+  static get is() {
+    return 'app-swap-projects-app';
+  }
+
+  static override get styles() {
+    return getCss();
+  }
+
+  override render() {
+    return getHtml.bind(this)();
+  }
+
+  static override get properties() {
+    return {
+      selectedTab_: {type: Number},
+      tabNames_: {type: Array},
+      projectName_: {type: String},
+      apps_: {type: Array},
+      routeGroups_: {type: Array},
+      profiles_: {type: Array},
+      activeProfileId_: {type: String},
+      newAppTitle_: {type: String},
+      newAppPackage_: {type: String},
+      newAppVersion_: {type: String},
+      newAppRegistry_: {type: String},
+      newAppToken_: {type: String},
+      newAppHosts_: {type: String},
+      newGroupName_: {type: String},
+      pendingRules_: {type: Object},
+      newProfileName_: {type: String},
+      projectNameDraft_: {type: String},
+      confirmingDelete_: {type: Boolean},
+      editingAppId_: {type: String},
+      editAppTitle_: {type: String},
+      editAppPackage_: {type: String},
+      editAppVersion_: {type: String},
+      editAppRegistry_: {type: String},
+      editAppToken_: {type: String},
+      editAppHosts_: {type: String},
+      editingGroupId_: {type: String},
+      editGroupName_: {type: String},
+      editingRuleGroupId_: {type: String},
+      editingRuleId_: {type: String},
+      editRulePattern_: {type: String},
+      editRuleTarget_: {type: String},
+      editingProfileId_: {type: String},
+      editProfileName_: {type: String},
+    };
+  }
+
+  private apiProxy_: BrowserProxy = BrowserProxyImpl.getInstance();
+
+  protected accessor selectedTab_: number = 0;
+  protected accessor tabNames_: string[] = ['General', 'Apps', 'Routes', 'Profiles'];
+  protected accessor projectName_: string = '';
+  protected accessor apps_: AppInfo[] = [];
+  protected accessor routeGroups_: RouteGroupInfo[] = [];
+  protected accessor profiles_: AppSwapProfileInfo[] = [];
+  protected accessor activeProfileId_: string|null = null;
+
+  protected accessor newAppTitle_: string = '';
+  protected accessor newAppPackage_: string = '';
+  protected accessor newAppVersion_: string = '';
+  protected accessor newAppRegistry_: string = '';
+  protected accessor newAppToken_: string = '';
+  protected accessor newAppHosts_: string = '';
+
+  protected accessor newGroupName_: string = '';
+  // Keyed by group id -- each route group renders its own "add rule" mini
+  // form, and they must not share pending state (a single pair of
+  // newRulePattern_/newRuleTarget_ properties made every group's form mirror
+  // whatever was typed into any one of them).
+  protected accessor pendingRules_: Record<string, {pattern: string, target: string}> = {};
+
+  protected accessor newProfileName_: string = '';
+
+  // Edit state. Only one row anywhere on the page is editable at a time --
+  // the editing*Id_ properties below say which, and the flat draft fields
+  // beside each hold that one row's in-progress values. Opening a second
+  // editor closes the first (see startEditing*_), which is what keeps a
+  // single set of draft fields sufficient.
+  protected accessor projectNameDraft_: string = '';
+  protected accessor confirmingDelete_: boolean = false;
+  protected accessor editingAppId_: string|null = null;
+  protected accessor editAppTitle_: string = '';
+  protected accessor editAppPackage_: string = '';
+  protected accessor editAppVersion_: string = '';
+  protected accessor editAppRegistry_: string = '';
+  protected accessor editAppToken_: string = '';
+  protected accessor editAppHosts_: string = '';
+  protected accessor editingGroupId_: string|null = null;
+  protected accessor editGroupName_: string = '';
+  protected accessor editingRuleGroupId_: string|null = null;
+  protected accessor editingRuleId_: string|null = null;
+  protected accessor editRulePattern_: string = '';
+  protected accessor editRuleTarget_: string = '';
+  protected accessor editingProfileId_: string|null = null;
+  protected accessor editProfileName_: string = '';
+
+  override connectedCallback() {
+    super.connectedCallback();
+    this.refreshAll_();
+  }
+
+  private async refreshAll_() {
+    const {name} = await this.apiProxy_.handler.getProjectName();
+    this.projectName_ = name;
+    this.projectNameDraft_ = name;
+    await Promise.all([
+      this.refreshApps_(),
+      this.refreshRouteGroups_(),
+      this.refreshProfiles_(),
+    ]);
+  }
+
+  private async refreshApps_() {
+    const {apps} = await this.apiProxy_.handler.getApps();
+    this.apps_ = apps;
+  }
+
+  private async refreshRouteGroups_() {
+    const {groups} = await this.apiProxy_.handler.getRouteGroups();
+    this.routeGroups_ = groups;
+  }
+
+  private async refreshProfiles_() {
+    const {profiles, activeProfileId} =
+        await this.apiProxy_.handler.getAppSwapProfiles();
+    this.profiles_ = profiles;
+    this.activeProfileId_ = activeProfileId ?? null;
+  }
+
+  protected onTabsSelectedChanged_(e: CustomEvent<{value: number}>) {
+    this.selectedTab_ = e.detail.value;
+  }
+
+  // Generic text-field binding: every plain <input> in this page carries
+  // data-field="<propertyName>" and routes through here rather than a
+  // separate handler per field -- there are ten near-identical fields across
+  // the four tabs' forms, and a dedicated handler per field would just be
+  // that same three-line body copy-pasted ten times.
+  protected onFieldInput_(e: Event) {
+    const input = e.target as HTMLInputElement;
+    const field = input.dataset['field']!;
+    (this as unknown as Record<string, string>)[field] = input.value;
+  }
+
+  protected async onAddAppClick_() {
+    const hosts = this.newAppHosts_.split(',')
+                      .map(h => h.trim())
+                      .filter(h => h.length > 0);
+    await this.apiProxy_.handler.addApp({
+      id: '',
+      title: this.newAppTitle_,
+      packageName: this.newAppPackage_,
+      version: this.newAppVersion_,
+      registry: this.newAppRegistry_,
+      token: this.newAppToken_,
+      hosts,
+    });
+    this.newAppTitle_ = '';
+    this.newAppPackage_ = '';
+    this.newAppVersion_ = '';
+    this.newAppRegistry_ = '';
+    this.newAppToken_ = '';
+    this.newAppHosts_ = '';
+    await this.refreshApps_();
+  }
+
+  protected async onRemoveAppClick_(e: Event) {
+    const id = (e.currentTarget as HTMLElement).dataset['id']!;
+    await this.apiProxy_.handler.removeApp(id);
+    await this.refreshApps_();
+  }
+
+  protected onEditAppClick_(e: Event) {
+    const id = (e.currentTarget as HTMLElement).dataset['id']!;
+    const app = this.apps_.find(a => a.id === id);
+    if (!app) {
+      return;
+    }
+    this.editingAppId_ = id;
+    this.editAppTitle_ = app.title;
+    this.editAppPackage_ = app.packageName;
+    this.editAppVersion_ = app.version;
+    this.editAppRegistry_ = app.registry;
+    this.editAppToken_ = app.token;
+    this.editAppHosts_ = app.hosts.join(', ');
+  }
+
+  protected onCancelEditAppClick_() {
+    this.editingAppId_ = null;
+  }
+
+  protected async onSaveAppClick_() {
+    const id = this.editingAppId_;
+    if (!id) {
+      return;
+    }
+    const hosts = this.editAppHosts_.split(',')
+                      .map(h => h.trim())
+                      .filter(h => h.length > 0);
+    await this.apiProxy_.handler.updateApp({
+      id,
+      title: this.editAppTitle_,
+      packageName: this.editAppPackage_,
+      version: this.editAppVersion_,
+      registry: this.editAppRegistry_,
+      token: this.editAppToken_,
+      hosts,
+    });
+    this.editingAppId_ = null;
+    await this.refreshApps_();
+  }
+
+  protected async onRenameProjectClick_() {
+    const name = this.projectNameDraft_.trim();
+    if (!name || name === this.projectName_) {
+      return;
+    }
+    await this.apiProxy_.handler.renameProject(name);
+    const {name: updated} = await this.apiProxy_.handler.getProjectName();
+    this.projectName_ = updated;
+    this.projectNameDraft_ = updated;
+  }
+
+  // Deleting a project takes its bookmarks, history, cookies and open tabs
+  // with it and can't be undone, so it takes two clicks -- every other
+  // destructive action on this page removes one small config entry that can
+  // be retyped. Deliberately an in-page step rather than window.confirm(),
+  // which chrome:// pages can't rely on being shown.
+  protected onDeleteProjectClick_() {
+    this.confirmingDelete_ = true;
+  }
+
+  protected onCancelDeleteProjectClick_() {
+    this.confirmingDelete_ = false;
+  }
+
+  protected async onConfirmDeleteProjectClick_() {
+    await this.apiProxy_.handler.deleteProject();
+  }
+
+  protected async onAddRouteGroupClick_() {
+    if (!this.newGroupName_.trim()) {
+      return;
+    }
+    await this.apiProxy_.handler.addRouteGroup(this.newGroupName_);
+    this.newGroupName_ = '';
+    await this.refreshRouteGroups_();
+  }
+
+  protected async onRemoveRouteGroupClick_(e: Event) {
+    const id = (e.currentTarget as HTMLElement).dataset['id']!;
+    await this.apiProxy_.handler.removeRouteGroup(id);
+    await this.refreshRouteGroups_();
+  }
+
+  protected onEditRouteGroupClick_(e: Event) {
+    const id = (e.currentTarget as HTMLElement).dataset['id']!;
+    const group = this.routeGroups_.find(g => g.id === id);
+    if (!group) {
+      return;
+    }
+    this.editingGroupId_ = id;
+    this.editGroupName_ = group.name;
+  }
+
+  protected onCancelEditRouteGroupClick_() {
+    this.editingGroupId_ = null;
+  }
+
+  protected async onSaveRouteGroupClick_() {
+    const id = this.editingGroupId_;
+    if (!id || !this.editGroupName_.trim()) {
+      return;
+    }
+    await this.apiProxy_.handler.updateRouteGroup(id, this.editGroupName_);
+    this.editingGroupId_ = null;
+    await this.refreshRouteGroups_();
+  }
+
+  protected onEditRuleClick_(e: Event) {
+    const target = e.currentTarget as HTMLElement;
+    const groupId = target.dataset['groupId']!;
+    const ruleId = target.dataset['ruleId']!;
+    const rule = this.routeGroups_.find(g => g.id === groupId)
+                     ?.rules.find(r => r.id === ruleId);
+    if (!rule) {
+      return;
+    }
+    // Deliberately not editingGroupId_: that one drives the group-rename
+    // form, and reusing it here would pop that form open too whenever a rule
+    // inside the group is edited.
+    this.editingRuleGroupId_ = groupId;
+    this.editingRuleId_ = ruleId;
+    this.editRulePattern_ = rule.urlPattern;
+    this.editRuleTarget_ = rule.target;
+  }
+
+  protected onCancelEditRuleClick_() {
+    this.editingRuleId_ = null;
+  }
+
+  protected async onSaveRuleClick_() {
+    const groupId = this.editingRuleGroupId_;
+    const ruleId = this.editingRuleId_;
+    if (!groupId || !ruleId || !this.editRulePattern_.trim() ||
+        !this.editRuleTarget_.trim()) {
+      return;
+    }
+    await this.apiProxy_.handler.updateRule(
+        groupId, ruleId, this.editRulePattern_, this.editRuleTarget_);
+    this.editingRuleId_ = null;
+    await this.refreshRouteGroups_();
+  }
+
+  // Returns the in-progress "add rule" field values for `groupId`'s own
+  // form, never another group's -- see pendingRules_.
+  protected getPendingRule_(groupId: string): {pattern: string, target: string} {
+    return this.pendingRules_[groupId] || {pattern: '', target: ''};
+  }
+
+  protected onRuleFieldInput_(e: Event) {
+    const input = e.target as HTMLInputElement;
+    const groupId = input.dataset['groupId']!;
+    const field = input.dataset['ruleField'] as 'pattern' | 'target';
+    const current = this.getPendingRule_(groupId);
+    this.pendingRules_ = {
+      ...this.pendingRules_,
+      [groupId]: {...current, [field]: input.value},
+    };
+  }
+
+  protected async onAddRuleClick_(e: Event) {
+    const groupId = (e.currentTarget as HTMLElement).dataset['groupId']!;
+    const pending = this.getPendingRule_(groupId);
+    if (!pending.pattern.trim() || !pending.target.trim()) {
+      return;
+    }
+    await this.apiProxy_.handler.addRule(groupId, pending.pattern, pending.target);
+    const rest = {...this.pendingRules_};
+    delete rest[groupId];
+    this.pendingRules_ = rest;
+    await this.refreshRouteGroups_();
+  }
+
+  protected async onRemoveRuleClick_(e: Event) {
+    const target = e.currentTarget as HTMLElement;
+    const groupId = target.dataset['groupId']!;
+    const ruleId = target.dataset['ruleId']!;
+    await this.apiProxy_.handler.removeRule(groupId, ruleId);
+    await this.refreshRouteGroups_();
+  }
+
+  protected async onAddProfileClick_() {
+    if (!this.newProfileName_.trim()) {
+      return;
+    }
+    await this.apiProxy_.handler.addAppSwapProfile(this.newProfileName_);
+    this.newProfileName_ = '';
+    await this.refreshProfiles_();
+  }
+
+  protected async onRemoveProfileClick_(e: Event) {
+    const id = (e.currentTarget as HTMLElement).dataset['id']!;
+    await this.apiProxy_.handler.removeAppSwapProfile(id);
+    await this.refreshProfiles_();
+  }
+
+  protected onEditProfileClick_(e: Event) {
+    const id = (e.currentTarget as HTMLElement).dataset['id']!;
+    const profile = this.profiles_.find(p => p.id === id);
+    if (!profile) {
+      return;
+    }
+    this.editingProfileId_ = id;
+    this.editProfileName_ = profile.name;
+  }
+
+  protected onCancelEditProfileClick_() {
+    this.editingProfileId_ = null;
+  }
+
+  protected async onSaveProfileClick_() {
+    const id = this.editingProfileId_;
+    if (!id || !this.editProfileName_.trim()) {
+      return;
+    }
+    await this.apiProxy_.handler.updateAppSwapProfile(id, this.editProfileName_);
+    this.editingProfileId_ = null;
+    await this.refreshProfiles_();
+  }
+
+  protected async onSetActiveProfileClick_(e: Event) {
+    const id = (e.currentTarget as HTMLElement).dataset['id']!;
+    await this.apiProxy_.handler.setActiveAppSwapProfile(id);
+    await this.refreshProfiles_();
+  }
+}
+
+declare global {
+  interface HTMLElementTagNameMap {
+    'app-swap-projects-app': AppSwapProjectsAppElement;
+  }
+}
+
+customElements.define(
+    AppSwapProjectsAppElement.is, AppSwapProjectsAppElement);
