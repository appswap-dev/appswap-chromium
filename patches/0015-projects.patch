@@ -0,0 +1,75 @@
+// Copyright 2026 The AppSwap Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_APP_SWAP_APP_SWAP_ROUTE_GROUP_PIN_TAB_HELPER_H_
+#define CHROME_BROWSER_APP_SWAP_APP_SWAP_ROUTE_GROUP_PIN_TAB_HELPER_H_
+
+#include <map>
+#include <optional>
+#include <string>
+
+#include "content/public/browser/web_contents_observer.h"
+#include "content/public/browser/web_contents_user_data.h"
+
+namespace content {
+class Page;
+class WebContents;
+}  // namespace content
+
+// Lets a single tab pin a specific AppSwap Route Group (a named set of URL
+// rewrite rules -- see AppSwapRouteGroup), so different tabs on the same
+// project can test different environments (e.g. one tab pinned to "Beta",
+// another to "Prod") at once. No group pinned means no rewriting applies at
+// all, functionally identical to an explicit empty group -- there's no
+// separate "default" concept.
+//
+// New tabs opened from an existing tab inherit that tab's pin (see the
+// constructor) -- unlike AppSwapVersionPinTabHelper, which starts every new
+// tab with an empty pin, and unlike AppSwapProfilesService's active-profile
+// pointer, which is a single global switch rather than real per-tab state.
+//
+// Persisted per-tab via SessionService::AddTabExtraData so a pin survives a
+// session restore -- see RestoreFromExtraData(). Re-persisted on every
+// navigation commit (PrimaryPageChanged), not just when SetPinnedGroup() is
+// called directly, mirroring AppSwapVersionPinTabHelper.
+class AppSwapRouteGroupPinTabHelper
+    : public content::WebContentsObserver,
+      public content::WebContentsUserData<AppSwapRouteGroupPinTabHelper> {
+ public:
+  ~AppSwapRouteGroupPinTabHelper() override;
+
+  AppSwapRouteGroupPinTabHelper(const AppSwapRouteGroupPinTabHelper&) =
+      delete;
+  AppSwapRouteGroupPinTabHelper& operator=(
+      const AppSwapRouteGroupPinTabHelper&) = delete;
+
+  // Pins this tab to `group_id`. An empty id clears the pin (no rewriting
+  // applies).
+  void SetPinnedGroup(const std::string& group_id);
+
+  // Returns the route group id pinned for this tab, or nullopt if unpinned.
+  std::optional<std::string> GetPinnedGroup() const;
+
+  // Rebuilds this tab's pin from persisted session-restore extra data. Call
+  // before the tab's first navigation request, mirroring
+  // AppSwapVersionPinTabHelper::RestoreFromExtraData().
+  static void RestoreFromExtraData(
+      content::WebContents* web_contents,
+      const std::map<std::string, std::string>& extra_data);
+
+ private:
+  friend class content::WebContentsUserData<AppSwapRouteGroupPinTabHelper>;
+  explicit AppSwapRouteGroupPinTabHelper(content::WebContents* web_contents);
+
+  // content::WebContentsObserver:
+  void PrimaryPageChanged(content::Page& page) override;
+
+  void Persist();
+
+  std::optional<std::string> pinned_group_id_;
+
+  WEB_CONTENTS_USER_DATA_KEY_DECL();
+};
+
+#endif  // CHROME_BROWSER_APP_SWAP_APP_SWAP_ROUTE_GROUP_PIN_TAB_HELPER_H_
diff --git a/chrome/browser/app_swap/app_swap_route_group_service.cc b/chrome/browser/app_swap/app_swap_route_group_service.cc
new file mode 100644
index 0000000000000..7768c8f617afc
--- /dev/null
+++ b/chrome/browser/app_swap/app_swap_route_group_service.cc
@@ -0,0 +1,245 @@
+// Copyright 2026 The AppSwap Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/app_swap/app_swap_route_group_service.h"
+
+#include <optional>
+#include <string>
+#include <utility>
+
+#include "base/functional/bind.h"
+#include "base/no_destructor.h"
+#include "base/uuid.h"
+#include "content/public/browser/browser_context.h"
+
+namespace {
+
+base::DictValue RuleToDict(const AppSwapRouteGroupRule& rule) {
+  base::DictValue dict;
+  dict.Set("id", rule.id);
+  dict.Set("url_pattern", rule.url_pattern);
+  dict.Set("target", rule.target);
+  return dict;
+}
+
+std::optional<AppSwapRouteGroupRule> RuleFromDict(const base::DictValue& dict) {
+  const std::string* id = dict.FindString("id");
+  const std::string* url_pattern = dict.FindString("url_pattern");
+  const std::string* target = dict.FindString("target");
+  if (!id || !url_pattern || !target) {
+    return std::nullopt;
+  }
+  AppSwapRouteGroupRule rule;
+  rule.id = *id;
+  rule.url_pattern = *url_pattern;
+  rule.target = *target;
+  return rule;
+}
+
+base::DictValue GroupToDict(const AppSwapRouteGroup& group) {
+  base::DictValue dict;
+  dict.Set("id", group.id);
+  dict.Set("name", group.name);
+  base::ListValue rules_list;
+  for (const AppSwapRouteGroupRule& rule : group.rules) {
+    rules_list.Append(RuleToDict(rule));
+  }
+  dict.Set("rules", std::move(rules_list));
+  return dict;
+}
+
+std::optional<AppSwapRouteGroup> GroupFromDict(const base::DictValue& dict) {
+  const std::string* id = dict.FindString("id");
+  const std::string* name = dict.FindString("name");
+  if (!id || !name) {
+    return std::nullopt;
+  }
+  AppSwapRouteGroup group;
+  group.id = *id;
+  group.name = *name;
+  if (const base::ListValue* rules_list = dict.FindList("rules")) {
+    for (const base::Value& value : *rules_list) {
+      if (!value.is_dict()) {
+        continue;
+      }
+      if (std::optional<AppSwapRouteGroupRule> rule =
+              RuleFromDict(value.GetDict())) {
+        group.rules.push_back(std::move(*rule));
+      }
+    }
+  }
+  return group;
+}
+
+}  // namespace
+
+AppSwapRouteGroupService::AppSwapRouteGroupService(
+    content::BrowserContext* browser_context)
+    : AppSwapConfigStore(browser_context->GetPath(),
+                         FILE_PATH_LITERAL("route_groups.json")) {}
+AppSwapRouteGroupService::~AppSwapRouteGroupService() = default;
+
+void AppSwapRouteGroupService::ParseConfig(const base::DictValue& dict) {
+  const base::ListValue* groups_list = dict.FindList("route_groups");
+  if (!groups_list) {
+    return;
+  }
+  for (const base::Value& value : *groups_list) {
+    if (!value.is_dict()) {
+      continue;
+    }
+    if (std::optional<AppSwapRouteGroup> group =
+            GroupFromDict(value.GetDict())) {
+      groups_.push_back(std::move(*group));
+    }
+  }
+}
+
+base::DictValue AppSwapRouteGroupService::SerializeConfig() const {
+  base::DictValue root;
+  base::ListValue groups_list;
+  for (const AppSwapRouteGroup& group : groups_) {
+    groups_list.Append(GroupToDict(group));
+  }
+  root.Set("route_groups", std::move(groups_list));
+  return root;
+}
+
+void AppSwapRouteGroupService::GetRouteGroups(
+    base::OnceCallback<void(std::vector<AppSwapRouteGroup>)> callback) {
+  RunWhenLoaded(base::BindOnce(
+      [](AppSwapRouteGroupService* self,
+         base::OnceCallback<void(std::vector<AppSwapRouteGroup>)> callback) {
+        std::move(callback).Run(self->groups_);
+      },
+      base::Unretained(this), std::move(callback)));
+}
+
+const std::vector<AppSwapRouteGroup>&
+AppSwapRouteGroupService::GetRouteGroupsIfLoaded() const {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  static const base::NoDestructor<std::vector<AppSwapRouteGroup>> kEmpty;
+  return loaded() ? groups_ : *kEmpty;
+}
+
+void AppSwapRouteGroupService::AddRouteGroup(AppSwapRouteGroup group) {
+  RunWhenLoaded(base::BindOnce(&AppSwapRouteGroupService::AddRouteGroupNow,
+                               base::Unretained(this), std::move(group)));
+}
+
+void AppSwapRouteGroupService::AddRouteGroupNow(AppSwapRouteGroup group) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  if (group.id.empty()) {
+    group.id = base::Uuid::GenerateRandomV4().AsLowercaseString();
+  }
+  groups_.push_back(std::move(group));
+  Save();
+}
+
+void AppSwapRouteGroupService::UpdateRouteGroup(AppSwapRouteGroup group) {
+  RunWhenLoaded(base::BindOnce(&AppSwapRouteGroupService::UpdateRouteGroupNow,
+                               base::Unretained(this), std::move(group)));
+}
+
+void AppSwapRouteGroupService::UpdateRouteGroupNow(AppSwapRouteGroup group) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  for (AppSwapRouteGroup& existing : groups_) {
+    if (existing.id == group.id) {
+      // Rules aren't part of what the caller edits here (they have their own
+      // Add/Update/RemoveRule entry points), so keep whatever's loaded
+      // rather than letting a group edit silently drop them.
+      group.rules = std::move(existing.rules);
+      existing = std::move(group);
+      Save();
+      return;
+    }
+  }
+}
+
+void AppSwapRouteGroupService::RemoveRouteGroup(const std::string& id) {
+  RunWhenLoaded(base::BindOnce(&AppSwapRouteGroupService::RemoveRouteGroupNow,
+                               base::Unretained(this), id));
+}
+
+void AppSwapRouteGroupService::RemoveRouteGroupNow(const std::string& id) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  for (auto it = groups_.begin(); it != groups_.end(); ++it) {
+    if (it->id == id) {
+      groups_.erase(it);
+      Save();
+      return;
+    }
+  }
+}
+
+void AppSwapRouteGroupService::AddRule(const std::string& group_id,
+                                       AppSwapRouteGroupRule rule) {
+  RunWhenLoaded(base::BindOnce(&AppSwapRouteGroupService::AddRuleNow,
+                               base::Unretained(this), group_id,
+                               std::move(rule)));
+}
+
+void AppSwapRouteGroupService::AddRuleNow(const std::string& group_id,
+                                          AppSwapRouteGroupRule rule) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  for (AppSwapRouteGroup& group : groups_) {
+    if (group.id == group_id) {
+      if (rule.id.empty()) {
+        rule.id = base::Uuid::GenerateRandomV4().AsLowercaseString();
+      }
+      group.rules.push_back(std::move(rule));
+      Save();
+      return;
+    }
+  }
+}
+
+void AppSwapRouteGroupService::UpdateRule(const std::string& group_id,
+                                          AppSwapRouteGroupRule rule) {
+  RunWhenLoaded(base::BindOnce(&AppSwapRouteGroupService::UpdateRuleNow,
+                               base::Unretained(this), group_id,
+                               std::move(rule)));
+}
+
+void AppSwapRouteGroupService::UpdateRuleNow(const std::string& group_id,
+                                             AppSwapRouteGroupRule rule) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  for (AppSwapRouteGroup& group : groups_) {
+    if (group.id != group_id) {
+      continue;
+    }
+    for (AppSwapRouteGroupRule& existing : group.rules) {
+      if (existing.id == rule.id) {
+        existing = std::move(rule);
+        Save();
+        return;
+      }
+    }
+    return;
+  }
+}
+
+void AppSwapRouteGroupService::RemoveRule(const std::string& group_id,
+                                          const std::string& rule_id) {
+  RunWhenLoaded(base::BindOnce(&AppSwapRouteGroupService::RemoveRuleNow,
+                               base::Unretained(this), group_id, rule_id));
+}
+
+void AppSwapRouteGroupService::RemoveRuleNow(const std::string& group_id,
+                                             const std::string& rule_id) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  for (AppSwapRouteGroup& group : groups_) {
+    if (group.id != group_id) {
+      continue;
+    }
+    for (auto it = group.rules.begin(); it != group.rules.end(); ++it) {
+      if (it->id == rule_id) {
+        group.rules.erase(it);
+        Save();
+        return;
+      }
+    }
+    return;
+  }
+}
diff --git a/chrome/browser/app_swap/app_swap_route_group_service.h b/chrome/browser/app_swap/app_swap_route_group_service.h
new file mode 100644
index 0000000000000..d1c3e6c8ff58a
--- /dev/null
+++ b/chrome/browser/app_swap/app_swap_route_group_service.h
@@ -0,0 +1,104 @@
+// Copyright 2026 The AppSwap Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_APP_SWAP_APP_SWAP_ROUTE_GROUP_SERVICE_H_
+#define CHROME_BROWSER_APP_SWAP_APP_SWAP_ROUTE_GROUP_SERVICE_H_
+
+#include <string>
+#include <vector>
+
+#include "base/functional/callback.h"
+#include "base/values.h"
+#include "chrome/browser/app_swap/app_swap_config_store.h"
+#include "components/keyed_service/core/keyed_service.h"
+
+namespace content {
+class BrowserContext;
+}  // namespace content
+
+// A single URL rewrite entry within an AppSwapRouteGroup: requests whose URL
+// matches `url_pattern` (see AppSwapUrlMatchesPattern) are forwarded to the
+// real network with the URL rewritten -- the portion of the request path
+// beyond `url_pattern`'s own path is appended to `target`'s path unchanged,
+// so e.g. a pattern of "https://example.com/api" with a target of
+// "https://beta.example.com/api" turns a request for
+// "https://example.com/api/users?x=1" into
+// "https://beta.example.com/api/users?x=1" (see
+// ComputeAppSwapRewriteUrl()). Applies to every HTTP method, not just
+// GET/HEAD -- it's a URL-level proxy, not served file content.
+struct AppSwapRouteGroupRule {
+  std::string id;           // GUID, generated on creation.
+  std::string url_pattern;  // e.g. "https://my-website.com/api"
+  std::string target;       // e.g. "https://beta.my-website.com/api"
+};
+
+// A named, app-independent set of rewrite rules a tab can be pinned to (see
+// AppSwapRouteGroupPinTabHelper) -- e.g. "Beta" rewrites a project's api/cdn
+// hosts to their beta counterparts, "Prod" has zero rules (a normal, real,
+// selectable group; not a special case). A rule has no notion of "app" at
+// all: rules apply purely by URL pattern, independent of any one app's own
+// hosts.
+struct AppSwapRouteGroup {
+  std::string id;    // GUID, generated on creation.
+  std::string name;   // e.g. "Beta", "Prod"
+  std::vector<AppSwapRouteGroupRule> rules;
+};
+
+// Owns the persistent route-group configuration for one Project (== Chromium
+// Profile), stored as JSON under that profile's own directory. See
+// AppSwapConfigStore for the load/save mechanics, and
+// AppSwapRouteGroupServiceFactory for how to reach the instance for a given
+// Profile.
+class AppSwapRouteGroupService : public KeyedService,
+                                 public AppSwapConfigStore {
+ public:
+  explicit AppSwapRouteGroupService(content::BrowserContext* browser_context);
+  ~AppSwapRouteGroupService() override;
+
+  AppSwapRouteGroupService(const AppSwapRouteGroupService&) = delete;
+  AppSwapRouteGroupService& operator=(const AppSwapRouteGroupService&) =
+      delete;
+
+  // Loads the config from disk (on first call) and invokes |callback| with
+  // the groups on the UI thread.
+  void GetRouteGroups(
+      base::OnceCallback<void(std::vector<AppSwapRouteGroup>)> callback);
+
+  // Returns the loaded groups synchronously, or an empty list if the config
+  // hasn't finished loading yet. See AppSwapAppsService::GetAppsIfLoaded for
+  // why this exists alongside GetRouteGroups().
+  const std::vector<AppSwapRouteGroup>& GetRouteGroupsIfLoaded() const;
+
+  // Group mutations. Safe to call at any time: each one is queued behind the
+  // config load (see AppSwapConfigStore::RunWhenLoaded), applies to the
+  // in-memory list, and writes the file. `id` is generated for
+  // AddRouteGroup() if empty; Update/Remove are no-ops if no group has that
+  // id.
+  void AddRouteGroup(AppSwapRouteGroup group);
+  void UpdateRouteGroup(AppSwapRouteGroup group);
+  void RemoveRouteGroup(const std::string& id);
+
+  // Rule mutations, nested within the group identified by `group_id`. No-op
+  // if `group_id` doesn't match any loaded group.
+  void AddRule(const std::string& group_id, AppSwapRouteGroupRule rule);
+  void UpdateRule(const std::string& group_id, AppSwapRouteGroupRule rule);
+  void RemoveRule(const std::string& group_id, const std::string& rule_id);
+
+ protected:
+  // AppSwapConfigStore:
+  void ParseConfig(const base::DictValue& dict) override;
+  base::DictValue SerializeConfig() const override;
+
+ private:
+  void AddRouteGroupNow(AppSwapRouteGroup group);
+  void UpdateRouteGroupNow(AppSwapRouteGroup group);
+  void RemoveRouteGroupNow(const std::string& id);
+  void AddRuleNow(const std::string& group_id, AppSwapRouteGroupRule rule);
+  void UpdateRuleNow(const std::string& group_id, AppSwapRouteGroupRule rule);
+  void RemoveRuleNow(const std::string& group_id, const std::string& rule_id);
+
+  std::vector<AppSwapRouteGroup> groups_;
+};
+
+#endif  // CHROME_BROWSER_APP_SWAP_APP_SWAP_ROUTE_GROUP_SERVICE_H_
