+#include "ui/webui/webui_util.h"
+
+AppSwapProjectsUIConfig::AppSwapProjectsUIConfig()
+    : DefaultWebUIConfig(content::kChromeUIScheme, "appswap-projects") {}
+
+AppSwapProjectsUI::AppSwapProjectsUI(content::WebUI* web_ui)
+    : content::WebUIController(web_ui) {
+  Profile* profile = Profile::FromWebUI(web_ui);
+  content::WebUIDataSource* source =
+      content::WebUIDataSource::CreateAndAdd(profile, "appswap-projects");
+  webui::SetupWebUIDataSource(source, kAppSwapProjectsResources,
+                              IDR_APP_SWAP_PROJECTS_APP_SWAP_PROJECTS_HTML);
+}
+
+AppSwapProjectsUI::~AppSwapProjectsUI() = default;
+
+WEB_UI_CONTROLLER_TYPE_IMPL(AppSwapProjectsUI)
+
+void AppSwapProjectsUI::WebUIRenderFrameCreated(
+    content::RenderFrameHost* rfh) {
+  rfh->EnableMojoJsBindings(nullptr);
+}
+
+void AppSwapProjectsUI::BindInterface(
+    mojo::PendingReceiver<app_swap_projects::mojom::PageHandlerFactory>
+        receiver) {
+  page_factory_receiver_.reset();
+  page_factory_receiver_.Bind(std::move(receiver));
+}
+
+void AppSwapProjectsUI::CreatePageHandler(
+    mojo::PendingReceiver<app_swap_projects::mojom::PageHandler> handler) {
+  page_handler_ = std::make_unique<AppSwapProjectsPageHandler>(
+      std::move(handler), Profile::FromWebUI(web_ui()));
+}
