+
+#ifndef CHROME_BROWSER_UI_WEBUI_APP_SWAP_PROJECTS_APP_SWAP_PROJECTS_PAGE_HANDLER_H_
+#define CHROME_BROWSER_UI_WEBUI_APP_SWAP_PROJECTS_APP_SWAP_PROJECTS_PAGE_HANDLER_H_
+
+#include "base/memory/raw_ptr.h"
+#include "chrome/browser/ui/webui/app_swap_projects/app_swap_projects.mojom.h"
+#include "mojo/public/cpp/bindings/pending_receiver.h"
+#include "mojo/public/cpp/bindings/receiver.h"
+
+class AppSwapAppsService;
+class AppSwapProfilesService;
+class AppSwapRouteGroupService;
+class Profile;
+
+// Implements the Projects page's PageHandler. Every method resolves the
+// Apps/Route Groups/AppSwap-Profiles services for `profile_` -- the Profile
+// (== Project) this page was opened in, fixed for the handler's lifetime.
+// None of those factories build an instance for a non-regular profile
+// (Incognito/Guest/System) -- appswap://projects can still be navigated to
+// in one, so every method goes through the apps_service()/route_group_
+// service()/profiles_service() accessors below and no-ops (rather than
+// crashing) when the relevant one is null.
+class AppSwapProjectsPageHandler : public app_swap_projects::mojom::PageHandler {
+ public:
+  AppSwapProjectsPageHandler(
+      mojo::PendingReceiver<app_swap_projects::mojom::PageHandler> handler,
+      Profile* profile);
+  AppSwapProjectsPageHandler(const AppSwapProjectsPageHandler&) = delete;
+  AppSwapProjectsPageHandler& operator=(const AppSwapProjectsPageHandler&) =
+      delete;
+  ~AppSwapProjectsPageHandler() override;
+
+  // app_swap_projects::mojom::PageHandler:
+  void GetProjectName(GetProjectNameCallback callback) override;
+  void GetApps(GetAppsCallback callback) override;
+  void AddApp(app_swap_projects::mojom::AppInfoPtr app,
+             AddAppCallback callback) override;
+  void RemoveApp(const std::string& id, RemoveAppCallback callback) override;
+  void GetRouteGroups(GetRouteGroupsCallback callback) override;
+  void AddRouteGroup(const std::string& name,
+                     AddRouteGroupCallback callback) override;
+  void RemoveRouteGroup(const std::string& id,
+                        RemoveRouteGroupCallback callback) override;
+  void AddRule(const std::string& group_id,
+              const std::string& url_pattern,
+              const std::string& target,
+              AddRuleCallback callback) override;
+  void RemoveRule(const std::string& group_id,
+                  const std::string& rule_id,
+                  RemoveRuleCallback callback) override;
+  void GetAppSwapProfiles(GetAppSwapProfilesCallback callback) override;
+  void AddAppSwapProfile(const std::string& name,
+                         AddAppSwapProfileCallback callback) override;
+  void RemoveAppSwapProfile(const std::string& id,
+                            RemoveAppSwapProfileCallback callback) override;
+  void SetActiveAppSwapProfile(
+      const std::string& id,
+      SetActiveAppSwapProfileCallback callback) override;
+
+ private:
+  AppSwapAppsService* apps_service();
+  AppSwapRouteGroupService* route_group_service();
+  AppSwapProfilesService* profiles_service();
+
+  const raw_ptr<Profile> profile_;
+  mojo::Receiver<app_swap_projects::mojom::PageHandler> receiver_;
+};
+
+#endif  // CHROME_BROWSER_UI_WEBUI_APP_SWAP_PROJECTS_APP_SWAP_PROJECTS_PAGE_HANDLER_H_
