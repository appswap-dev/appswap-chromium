+// Copyright 2026 The AppSwap Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_VIEWS_APP_SWAP_APP_SWAP_VERSION_PICKER_DIALOG_H_
+#define CHROME_BROWSER_UI_VIEWS_APP_SWAP_APP_SWAP_VERSION_PICKER_DIALOG_H_
+
+#include <memory>
+
+#include "base/memory/weak_ptr.h"
+#include "chrome/browser/app_swap/app_swap_apps_service.h"
+
+namespace content {
+class WebContents;
+}  // namespace content
+
+namespace views {
+class View;
+}  // namespace views
+
+class PageInfoNavigationHandler;
+
+// Builds the "Switch version" content shown as a Page Info sub-page (see
+// PageInfoNavigationHandler::OpenVersionPickerPage) -- a small WebUI page
+// (chrome://appswap-version-picker, see
+// chrome/browser/ui/webui/app_swap_version_picker/) embedded directly via
+// views::WebView, letting the user switch `app` to a different dist-tag or
+// exact version for `web_contents`'s tab. The page fetches the full list of
+// published dist-tags/versions itself; picking one pins the tab
+// (AppSwapVersionPinTabHelper), closes `navigation_handler`'s Page Info
+// bubble, and reloads the tab.
+std::unique_ptr<views::View> CreateAppSwapVersionPickerSubpageView(
+    content::WebContents* web_contents,
+    const AppSwapApp& app,
+    base::WeakPtr<PageInfoNavigationHandler> navigation_handler);
+
+#endif  // CHROME_BROWSER_UI_VIEWS_APP_SWAP_APP_SWAP_VERSION_PICKER_DIALOG_H_
diff --git a/chrome/browser/ui/views/controls/rich_hover_button.cc b/chrome/browser/ui/views/controls/rich_hover_button.cc
index aa91770c8b..bb04fb0715 100644
--- a/chrome/browser/ui/views/controls/rich_hover_button.cc
+++ b/chrome/browser/ui/views/controls/rich_hover_button.cc
@@ -170,6 +170,14 @@ void RichHoverButton::SetSubtitleText(std::u16string_view subtitle_text) {
       subtitle_->SetMultiLine(subtitle_multiline_);
       subtitle_->SetHorizontalAlignment(gfx::ALIGN_LEFT);
       subtitle_->SetAutoColorReadabilityEnabled(false);
+      // The subtitle row can end up painted underneath an ink-drop layer
+      // (e.g. the leading/action icon views created by CreateIconView() set
+      // SetFillsBoundsOpaquely(false) on themselves), which trips
+      // Label::PaintText()'s subpixel-rendering-on-opaque-background DCHECK.
+      // Every prior caller of SetSubtitleText() avoided this by only ever
+      // passing an empty or single-space placeholder string; skip the check
+      // outright so real subtitle text doesn't crash DCHECK-enabled builds.
+      subtitle_->SetSkipSubpixelRenderingOpacityCheck(true);
       base::Extend(subtitle_row_views_, AddFillerViews(children().size()));
     }
     subtitle_->SetText(subtitle_text);
