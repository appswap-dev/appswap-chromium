index 0000000000000..8ba246424dc25
--- /dev/null
+++ b/chrome/browser/app_swap/app_swap_version_utils.h
@@ -0,0 +1,43 @@
+// Copyright 2026 The AppSwap Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_APP_SWAP_APP_SWAP_VERSION_UTILS_H_
+#define CHROME_BROWSER_APP_SWAP_APP_SWAP_VERSION_UTILS_H_
+
+#include <string>
+
+namespace app_swap {
+
+// Not a full semver comparison (no pre-release/build-metadata handling) --
+// just enough to compare the plain "X.Y.Z"-style versions actually served by
+// this codebase's npm registry integration. Falls back to a string compare
+// if either version doesn't parse as dot-separated integers.
+bool IsNewerVersion(const std::string& candidate, const std::string& current);
+
+// Whether `version` is safe to use as a single directory name in the on-disk
+// artifact cache (see AppSwapArtifactProvider's TargetDir()). Requires a
+// non-empty string of npm-legal version characters only -- alphanumerics and
+// ".-+_~" -- and rejects anything with a path separator, a leading dot, or a
+// ".." component.
+//
+// This is a security boundary, not a nicety: a version string reaches the
+// cache path straight from the `appswap-use-version` query parameter (see
+// AppSwapProxyingURLLoaderFactory::CreateLoaderAndStart), so any page served
+// on a configured app host could otherwise point the serve root at an
+// arbitrary directory -- "1/../../../.." resolves out of the cache entirely,
+// and every file under wherever it lands would then be readable over http.
+bool IsValidVersionForPath(const std::string& version);
+
+// Whether `package_name` is safe to use as a path under the artifact cache.
+// Accepts the two shapes npm allows -- "name" and "@scope/name" -- with the
+// same character restrictions as IsValidVersionForPath() per segment, so the
+// one legal "/" can't be joined by traversal components. Package names come
+// from the project's own config rather than a URL, so this is a guard
+// against a typo corrupting an unrelated directory rather than against a
+// remote attacker.
+bool IsValidPackageNameForPath(const std::string& package_name);
+
+}  // namespace app_swap
+
+#endif  // CHROME_BROWSER_APP_SWAP_APP_SWAP_VERSION_UTILS_H_
diff --git a/chrome/browser/ui/views/app_swap/app_swap_version_picker_dialog.cc b/chrome/browser/ui/views/app_swap/app_swap_version_picker_dialog.cc
