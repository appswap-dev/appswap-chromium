+++ b/chrome/browser/ui/views/app_swap/app_swap_version_picker_dialog.cc
@@ -0,0 +1,115 @@
+// Copyright 2026 The AppSwap Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/views/app_swap/app_swap_version_picker_dialog.h"
+
+#include <string>
+#include <utility>
+
+#include "base/functional/bind.h"
+#include "base/location.h"
+#include "base/scoped_observation.h"
+#include "base/task/single_thread_task_runner.h"
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/browser/ui/views/page_info/page_info_navigation_handler.h"
+#include "chrome/browser/ui/webui/app_swap_version_picker/app_swap_version_picker_context.h"
+#include "content/public/browser/web_contents.h"
+#include "ui/gfx/geometry/size.h"
+#include "ui/views/controls/webview/webview.h"
+#include "ui/views/view_observer.h"
+#include "url/gurl.h"
+
+namespace {
+
+// Every other Page Info subpage's content is a plain views::View tree: a
+// size change happens synchronously inside a Layout() pass and reaches the
+// bubble through the normal ChildPreferredSizeChanged() -> SizeToContents()
+// chain (see PageInfoBubbleView::ChildPreferredSizeChanged, itself already a
+// workaround for crbug.com/343325197). This subpage's content is a WebView
+// instead: its preferred size changes arrive later, as a renderer-process
+// auto-resize IPC landing on a call stack that never goes through a normal
+// Views layout pass. Forwarding to NotifyContentSizeChanged() synchronously
+// from that same notification recomputes against identical state and
+// changes nothing (View::PreferredSizeChanged() fires the
+// ChildPreferredSizeChanged() chain and this observer's own notification
+// from the same call, so by the time this fires SizeToContents() has
+// already run once against the same state) -- deferring to the next task is
+// the part that matters, since it's what actually steps outside whatever
+// unusual call stack the WebView's resize IPC arrived on. Self-owned: holds
+// no state anything else needs to reach, and outlives nothing it shouldn't
+// by dying with the WebView it observes.
+class AppSwapVersionPickerAutoResizeNotifier : public views::ViewObserver {
+ public:
+  AppSwapVersionPickerAutoResizeNotifier(
+      views::View* web_view,
+      base::WeakPtr<PageInfoNavigationHandler> navigation_handler)
+      : navigation_handler_(std::move(navigation_handler)) {
+    observation_.Observe(web_view);
+  }
+  AppSwapVersionPickerAutoResizeNotifier(
+      const AppSwapVersionPickerAutoResizeNotifier&) = delete;
+  AppSwapVersionPickerAutoResizeNotifier& operator=(
+      const AppSwapVersionPickerAutoResizeNotifier&) = delete;
+
+  // views::ViewObserver:
+  void OnViewPreferredSizeChanged(views::View* observed_view) override {
+    base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(
+        FROM_HERE,
+        base::BindOnce(&PageInfoNavigationHandler::NotifyContentSizeChanged,
+                       navigation_handler_));
+  }
+  void OnViewIsDeleting(views::View* observed_view) override { delete this; }
+
+ private:
+  ~AppSwapVersionPickerAutoResizeNotifier() override = default;
+
+  base::WeakPtr<PageInfoNavigationHandler> navigation_handler_;
+  base::ScopedObservation<views::View, views::ViewObserver> observation_{
+      this};
+};
+
+// Matches the width Page Info's own sub-pages settle on. The height is a
+// range rather than a single value: the page reports its own content height
+// back through auto-resize (see EnableSizingFromWebContents below), so a
+// package with one tag and one version gets a short panel instead of a fixed
+// tall one padded out with empty space. Past the maximum the page scrolls.
+constexpr int kSubpageWidth = 320;
+constexpr int kSubpageMinHeight = 100;
+constexpr int kSubpageMaxHeight = 400;
+
+}  // namespace
+
+std::unique_ptr<views::View> CreateAppSwapVersionPickerSubpageView(
+    content::WebContents* web_contents,
+    const AppSwapApp& app,
+    base::WeakPtr<PageInfoNavigationHandler> navigation_handler) {
+  AppSwapVersionPickerContext::Entry entry;
+  entry.web_contents_handle =
+      WebContentsWeakHandle::GetOrCreateForWebContents(web_contents)
+          ->GetWeakPtr();
+  entry.app = app;
+  entry.close_page_info = base::BindRepeating(
+      &PageInfoNavigationHandler::CloseBubble, navigation_handler);
+  std::string token =
+      AppSwapVersionPickerContext::GetInstance()->Stash(std::move(entry));
+
+  auto web_view = std::make_unique<views::WebView>(
+      Profile::FromBrowserContext(web_contents->GetBrowserContext()));
+  // Width is pinned at both ends of the range so only the height tracks the
+  // content -- a panel that changed width as rows are filtered would make
+  // the whole Page Info bubble jump around while typing.
+  web_view->EnableSizingFromWebContents(
+      gfx::Size(kSubpageWidth, kSubpageMinHeight),
+      gfx::Size(kSubpageWidth, kSubpageMaxHeight));
+  // Something to lay out with until the renderer reports its first real
+  // content height, which arrives a frame or two after the page loads.
+  web_view->SetPreferredSize(gfx::Size(kSubpageWidth, kSubpageMinHeight));
+  // Self-owned; see the class comment for why this subpage needs it and the
+  // other Page Info subpages don't.
+  new AppSwapVersionPickerAutoResizeNotifier(web_view.get(),
+                                             std::move(navigation_handler));
+  web_view->LoadInitialURL(
+      GURL("chrome://appswap-version-picker/?token=" + token));
+  return web_view;
+}
diff --git a/chrome/browser/ui/views/app_swap/app_swap_version_picker_dialog.h b/chrome/browser/ui/views/app_swap/app_swap_version_picker_dialog.h
