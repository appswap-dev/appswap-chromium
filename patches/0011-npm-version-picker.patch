@@ -0,0 +1,118 @@
+// Copyright 2026 The AppSwap Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/app_swap/app_swap_version_utils.h"
+
+#include <algorithm>
+#include <string_view>
+#include <vector>
+
+#include "base/strings/string_number_conversions.h"
+
+namespace app_swap {
+
+namespace {
+
+// Splits a version string like "1.2.3" into {1, 2, 3}. Each component is
+// parsed by its leading run of digits, so a pre-release/build suffix like
+// "1.2.3-next" or "1.2.3-beta.1" still parses its numeric part ({1, 2, 3})
+// instead of failing the whole version -- without this, two suffixed
+// versions differing only in a double-digit segment (e.g. "1.2.10-next" vs
+// "1.2.9-next") would fall back to string comparison and compare backwards.
+// Returns an empty vector if any component has no leading digits at all
+// (this isn't a version number, e.g. a dist-tag name like "next").
+std::vector<int> SplitVersion(const std::string& version) {
+  std::vector<int> parts;
+  size_t start = 0;
+  while (start <= version.size()) {
+    const size_t dot = version.find('.', start);
+    const std::string part = version.substr(
+        start, dot == std::string::npos ? std::string::npos : dot - start);
+    size_t digit_end = 0;
+    while (digit_end < part.size() && part[digit_end] >= '0' &&
+          part[digit_end] <= '9') {
+      ++digit_end;
+    }
+    int n = 0;
+    if (digit_end == 0 || !base::StringToInt(part.substr(0, digit_end), &n)) {
+      return {};
+    }
+    parts.push_back(n);
+    if (dot == std::string::npos) {
+      break;
+    }
+    start = dot + 1;
+  }
+  return parts;
+}
+
+// One path segment's worth of validation, shared by the two public
+// predicates below. Deliberately an allowlist: anything not explicitly
+// permitted (separators, "%", control characters, non-ASCII) is rejected,
+// so no encoding or platform-specific separator handling can slip past.
+bool IsSafePathSegment(std::string_view segment) {
+  if (segment.empty() || segment == "." || segment == "..") {
+    return false;
+  }
+  // A leading dot would make the directory hidden and, more importantly,
+  // keeps ".."-adjacent shapes out of the cache entirely.
+  if (segment.front() == '.') {
+    return false;
+  }
+  for (const char c : segment) {
+    const bool allowed = (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') ||
+                         (c >= '0' && c <= '9') || c == '.' || c == '-' ||
+                         c == '+' || c == '_' || c == '~';
+    if (!allowed) {
+      return false;
+    }
+  }
+  return true;
+}
+
+}  // namespace
+
+bool IsValidVersionForPath(const std::string& version) {
+  return IsSafePathSegment(version);
+}
+
+bool IsValidPackageNameForPath(const std::string& package_name) {
+  if (package_name.empty()) {
+    return false;
+  }
+  if (package_name.front() != '@') {
+    return IsSafePathSegment(package_name);
+  }
+  // Scoped package: "@scope/name", exactly one separator, both halves
+  // validated as ordinary segments.
+  const std::string_view rest = std::string_view(package_name).substr(1);
+  const size_t slash = rest.find('/');
+  if (slash == std::string_view::npos) {
+    return false;
+  }
+  const std::string_view scope = rest.substr(0, slash);
+  const std::string_view name = rest.substr(slash + 1);
+  return IsSafePathSegment(scope) && IsSafePathSegment(name);
+}
+
+bool IsNewerVersion(const std::string& candidate, const std::string& current) {
+  if (candidate == current) {
+    return false;
+  }
+  const std::vector<int> a = SplitVersion(candidate);
+  const std::vector<int> b = SplitVersion(current);
+  if (a.empty() || b.empty()) {
+    return candidate > current;
+  }
+  for (size_t i = 0; i < std::max(a.size(), b.size()); ++i) {
+    const int av = i < a.size() ? a[i] : 0;
+    const int bv = i < b.size() ? b[i] : 0;
+    if (av != bv) {
+      return av > bv;
+    }
+  }
+  return false;
+}
+
+}  // namespace app_swap
diff --git a/chrome/browser/app_swap/app_swap_version_utils.h b/chrome/browser/app_swap/app_swap_version_utils.h
