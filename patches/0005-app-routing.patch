@@ -0,0 +1,365 @@
+// Copyright 2026 The AppSwap Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/app_swap/app_swap_artifact_provider.h"
+
+#include <memory>
+#include <optional>
+#include <string>
+#include <utility>
+
+#include "base/compiler_specific.h"
+#include "base/files/file_path.h"
+#include "base/files/file_util.h"
+#include "base/functional/bind.h"
+#include "base/json/json_reader.h"
+#include "base/no_destructor.h"
+#include "base/path_service.h"
+#include "base/strings/string_util.h"
+#include "base/task/thread_pool.h"
+#include "base/values.h"
+#include "chrome/browser/net/system_network_context_manager.h"
+#include "chrome/common/chrome_paths.h"
+#include "net/base/net_errors.h"
+#include "net/http/http_request_headers.h"
+#include "net/traffic_annotation/network_traffic_annotation.h"
+#include "services/network/public/cpp/resource_request.h"
+#include "services/network/public/cpp/shared_url_loader_factory.h"
+#include "services/network/public/cpp/simple_url_loader.h"
+#include "services/network/public/mojom/url_response_head.mojom.h"
+#include "third_party/zlib/google/compression_utils.h"
+#include "url/gurl.h"
+
+namespace {
+
+constexpr net::NetworkTrafficAnnotationTag kArtifactTrafficAnnotation =
+    net::DefineNetworkTrafficAnnotation("appswap_artifact", R"(
+        semantics {
+          sender: "AppSwap Artifact Provider"
+          description:
+            "Downloads the SPA application artifact (npm tarball) that AppSwap "
+            "serves for a configured route."
+          trigger: "A user navigates to an app configured with an npm source."
+          data: "None beyond the request URL and optional registry credentials."
+          destination: OTHER
+        }
+        policy {
+          cookies_allowed: NO
+          setting: "This is an AppSwap feature with no separate setting."
+        })");
+
+std::string Key(const AppSwapSource& source) {
+  return source.package_name + "@" + source.version;
+}
+
+bool IsExactVersion(const std::string& version) {
+  size_t i = 0;
+  if (!version.empty() && (version[0] == 'v' || version[0] == 'V')) {
+    i = 1;
+  }
+  return i < version.size() && version[i] >= '0' && version[i] <= '9';
+}
+
+std::string TarballUrl(const AppSwapSource& source, const std::string& version) {
+  std::string basename = source.package_name;
+  const size_t slash = basename.find_last_of('/');
+  if (slash != std::string::npos) {
+    basename = basename.substr(slash + 1);
+  }
+  return base::StrCat({source.registry, "/", source.package_name, "/-/",
+                       basename, "-", version, ".tgz"});
+}
+
+std::string MetadataUrl(const AppSwapSource& source) {
+  std::string encoded;
+  for (const char c : source.package_name) {
+    if (c == '/') {
+      encoded += "%2F";
+    } else {
+      encoded += c;
+    }
+  }
+  return base::StrCat({source.registry, "/", encoded});
+}
+
+// Extracts a ustar-format tar archive into `dest_dir`. Returns false on error
+// (including any entry that would escape `dest_dir`).
+UNSAFE_BUFFERS(bool ExtractTar(const std::string& tar,
+                               const base::FilePath& dest_dir) {
+  constexpr size_t kBlockSize = 512;
+  size_t offset = 0;
+  while (offset + kBlockSize <= tar.size()) {
+    const char* header = tar.data() + offset;
+
+    // A zeroed header marks the end of the archive.
+    if (header[0] == '\0') {
+      return true;
+    }
+
+    std::string name(header, 100);
+    name = name.substr(0, name.find('\0'));
+    std::string prefix(header + 345, 155);
+    prefix = prefix.substr(0, prefix.find('\0'));
+    if (!prefix.empty()) {
+      name = prefix + "/" + name;
+    }
+    // npm tarballs store everything under a top-level "package/" directory.
+    const size_t first_slash = name.find('/');
+    if (first_slash != std::string::npos) {
+      name = name.substr(first_slash + 1);
+    }
+
+    std::string size_str(header + 124, 12);
+    size_str = size_str.substr(0, size_str.find_first_of(" \0"));
+    uint64_t size = 0;
+    if (!size_str.empty()) {
+      size = strtoull(size_str.c_str(), nullptr, 8);
+    }
+
+    const char typeflag = header[156];
+    offset += kBlockSize;
+
+    const uint64_t padded_size = (size + kBlockSize - 1) / kBlockSize * kBlockSize;
+    if (offset + padded_size > tar.size()) {
+      return false;
+    }
+
+    // Security: reject any entry that could escape the destination.
+    if (name.find("..") != std::string::npos) {
+      return false;
+    }
+
+    // The top-level directory entry itself carries no content to write.
+    if (name.empty()) {
+      offset += padded_size;
+      continue;
+    }
+
+    base::FilePath path = dest_dir.Append(base::FilePath::FromUTF8Unsafe(name));
+
+    if (typeflag == '5') {
+      // Directory.
+      if (!base::CreateDirectory(path)) {
+        return false;
+      }
+    } else if (typeflag == '0' || typeflag == '\0') {
+      // Regular file.
+      if (!base::CreateDirectory(path.DirName()) ||
+          !base::WriteFile(path, tar.substr(offset, size))) {
+        return false;
+      }
+    }
+    // Other types (symlink, hardlink, device) are skipped.
+
+    offset += padded_size;
+  }
+  return false;  // Truncated archive (no end marker).
+})
+
+}  // namespace
+
+AppSwapArtifactProvider::AppSwapArtifactProvider() = default;
+AppSwapArtifactProvider::~AppSwapArtifactProvider() = default;
+
+// static
+AppSwapArtifactProvider* AppSwapArtifactProvider::GetInstance() {
+  static base::NoDestructor<AppSwapArtifactProvider> instance;
+  return instance.get();
+}
+
+void AppSwapArtifactProvider::GetOrDownload(
+    const AppSwapSource& source,
+    base::OnceCallback<void(base::FilePath)> callback) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  if (source.type != AppSwapSourceType::kNpm) {
+    std::move(callback).Run(base::FilePath());
+    return;
+  }
+
+  const std::string key = Key(source);
+
+  auto cache_it = cache_.find(key);
+  if (cache_it != cache_.end()) {
+    base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+        FROM_HERE, base::BindOnce(std::move(callback), cache_it->second));
+    return;
+  }
+
+  auto& pending = pending_[key];
+  pending.push_back(std::move(callback));
+  if (pending.size() > 1) {
+    return;  // Already resolving/downloading this source.
+  }
+
+  if (IsExactVersion(source.version)) {
+    DownloadTarball(source, source.version, TarballUrl(source, source.version),
+                    base::BindOnce(&AppSwapArtifactProvider::Finish,
+                                   base::Unretained(this), source));
+  } else {
+    FetchMetadata(
+        source,
+        base::BindOnce(
+            [](AppSwapArtifactProvider* self, const AppSwapSource& source,
+               std::string version, std::string error) {
+              self->loaders_.erase(Key(source));
+              if (!error.empty()) {
+                self->Finish(source, base::FilePath());
+                return;
+              }
+              self->DownloadTarball(
+                  source, version, TarballUrl(source, version),
+                  base::BindOnce(&AppSwapArtifactProvider::Finish,
+                                 base::Unretained(self), source));
+            },
+            base::Unretained(this), source));
+  }
+}
+
+void AppSwapArtifactProvider::FetchMetadata(
+    const AppSwapSource& source,
+    base::OnceCallback<void(std::string /*version*/, std::string /*error*/)>
+        callback) {
+  auto resource_request = std::make_unique<network::ResourceRequest>();
+  resource_request->url = GURL(MetadataUrl(source));
+  resource_request->method = net::HttpRequestHeaders::kGetMethod;
+  resource_request->headers.SetHeader(net::HttpRequestHeaders::kAccept,
+                                      "application/json");
+  if (!source.token.empty()) {
+    resource_request->headers.SetHeader(net::HttpRequestHeaders::kAuthorization,
+                                        base::StrCat({"Bearer ", source.token}));
+  }
+
+  scoped_refptr<network::SharedURLLoaderFactory> factory =
+      SystemNetworkContextManager::GetInstance()->GetSharedURLLoaderFactory();
+
+  auto loader =
+      network::SimpleURLLoader::Create(std::move(resource_request),
+                                       kArtifactTrafficAnnotation);
+  network::SimpleURLLoader* raw_loader = loader.get();
+  loaders_[Key(source)] = std::move(loader);
+
+  raw_loader->DownloadToStringOfUnboundedSizeUntilCrashAndDie(
+      factory.get(),
+      base::BindOnce(
+          [](AppSwapArtifactProvider* self, const AppSwapSource& source,
+             base::OnceCallback<void(std::string, std::string)> callback,
+             std::optional<std::string> body) {
+            self->loaders_.erase(Key(source));
+            if (!body) {
+              std::move(callback).Run(std::string(), "metadata download failed");
+              return;
+            }
+            std::optional<base::Value> parsed =
+                base::JSONReader::Read(*body, base::JSON_PARSE_CHROMIUM_EXTENSIONS);
+            if (!parsed || !parsed->is_dict()) {
+              std::move(callback).Run(std::string(), "invalid metadata JSON");
+              return;
+            }
+            const base::DictValue& root = parsed->GetDict();
+            const base::DictValue* dist_tags = root.FindDict("dist-tags");
+            const std::string* version =
+                dist_tags ? dist_tags->FindString(source.version) : nullptr;
+            if (!version) {
+              std::move(callback).Run(std::string(),
+                                      "dist-tag not found: " + source.version);
+              return;
+            }
+            std::move(callback).Run(*version, std::string());
+          },
+          base::Unretained(this), source, std::move(callback)));
+}
+
+void AppSwapArtifactProvider::DownloadTarball(
+    const AppSwapSource& source,
+    const std::string& version,
+    const std::string& tarball_url,
+    base::OnceCallback<void(base::FilePath)> callback) {
+  // Resolve the cache directory for this exact version.
+  base::FilePath apps_dir;
+  if (!base::PathService::Get(chrome::DIR_USER_DATA, &apps_dir)) {
+    base::GetTempDir(&apps_dir);
+  }
+  const base::FilePath target_dir =
+      apps_dir.AppendASCII("AppSwapApps")
+          .Append(base::FilePath::FromUTF8Unsafe(source.package_name))
+          .Append(base::FilePath::FromUTF8Unsafe(version));
+
+  auto resource_request = std::make_unique<network::ResourceRequest>();
+  resource_request->url = GURL(tarball_url);
+  resource_request->method = net::HttpRequestHeaders::kGetMethod;
+  if (!source.token.empty()) {
+    resource_request->headers.SetHeader(net::HttpRequestHeaders::kAuthorization,
+                                        base::StrCat({"Bearer ", source.token}));
+  }
+
+  scoped_refptr<network::SharedURLLoaderFactory> factory =
+      SystemNetworkContextManager::GetInstance()->GetSharedURLLoaderFactory();
+
+  auto loader =
+      network::SimpleURLLoader::Create(std::move(resource_request),
+                                       kArtifactTrafficAnnotation);
+  network::SimpleURLLoader* raw_loader = loader.get();
+  loaders_[Key(source)] = std::move(loader);
+
+  raw_loader->DownloadToStringOfUnboundedSizeUntilCrashAndDie(
+      factory.get(),
+      base::BindOnce(&AppSwapArtifactProvider::OnTarball, base::Unretained(this),
+                     source, version, target_dir, std::move(callback)));
+}
+
+void AppSwapArtifactProvider::OnTarball(
+    const AppSwapSource& source,
+    const std::string& version,
+    base::FilePath target_dir,
+    base::OnceCallback<void(base::FilePath)> callback,
+    std::optional<std::string> body) {
+  loaders_.erase(Key(source));
+  if (!body) {
+    std::move(callback).Run(base::FilePath());
+    return;
+  }
+
+  // Extract (gunzip + untar) on a MayBlock task runner.
+  base::ThreadPool::PostTaskAndReplyWithResult(
+      FROM_HERE, {base::MayBlock(), base::TaskPriority::USER_VISIBLE},
+      base::BindOnce(
+          [](std::string tgz, base::FilePath dir) {
+            if (base::PathExists(dir)) {
+              return true;  // Already extracted.
+            }
+            std::string tar;
+            if (!compression::GzipUncompress(tgz, &tar) ||
+                !base::CreateDirectory(dir) || !ExtractTar(tar, dir)) {
+              return false;
+            }
+            return true;
+          },
+          std::move(*body), target_dir),
+      base::BindOnce(
+          [](base::OnceCallback<void(base::FilePath)> callback,
+             base::FilePath target_dir, bool success) {
+            std::move(callback).Run(success ? target_dir : base::FilePath());
+          },
+          std::move(callback), target_dir));
+}
+
+void AppSwapArtifactProvider::Finish(const AppSwapSource& source,
+                                     base::FilePath dir) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  const std::string key = Key(source);
+
+  if (!dir.empty()) {
+    cache_[key] = dir;
+  }
+
+  auto it = pending_.find(key);
+  if (it != pending_.end()) {
+    std::vector<base::OnceCallback<void(base::FilePath)>> callbacks =
+        std::move(it->second);
+    pending_.erase(it);
+    for (auto& callback : callbacks) {
+      std::move(callback).Run(dir);
+    }
+  }
+}
