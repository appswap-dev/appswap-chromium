+)html";
+
+class AppSwapRoutesHandler : public content::WebUIMessageHandler {
+ public:
+  void RegisterMessages() override {
+    web_ui()->RegisterMessageCallback(
+        "getData", base::BindRepeating(&AppSwapRoutesHandler::HandleGetData,
+                                       base::Unretained(this)));
+    web_ui()->RegisterMessageCallback(
+        "addRoute", base::BindRepeating(&AppSwapRoutesHandler::HandleAddRoute,
+                                        base::Unretained(this)));
+    web_ui()->RegisterMessageCallback(
+        "updateRoute",
+        base::BindRepeating(&AppSwapRoutesHandler::HandleUpdateRoute,
+                            base::Unretained(this)));
+    web_ui()->RegisterMessageCallback(
+        "removeRoute",
+        base::BindRepeating(&AppSwapRoutesHandler::HandleRemoveRoute,
+                            base::Unretained(this)));
+  }
+
+ private:
+  void SendData() {
+    AppSwapAppsService::GetInstance()->GetApps(base::BindOnce(
+        &AppSwapRoutesHandler::OnAppsLoaded, weak_factory_.GetWeakPtr()));
+  }
+
+  void OnAppsLoaded(std::vector<AppSwapApp> apps) {
+    AppSwapRoutesService::GetInstance()->GetRoutes(
+        base::BindOnce(&AppSwapRoutesHandler::OnRoutesLoaded,
+                       weak_factory_.GetWeakPtr(), std::move(apps)));
+  }
+
+  void OnRoutesLoaded(std::vector<AppSwapApp> apps,
+                      std::vector<AppSwapRoute> routes) {
+    base::ListValue apps_list;
+    for (const AppSwapApp& app : apps) {
+      base::DictValue dict;
+      dict.Set("id", app.id);
+      dict.Set("title", app.title);
+      dict.Set("package", app.package_name);
+      dict.Set("version", app.version);
+      dict.Set("registry", app.registry);
+      apps_list.Append(std::move(dict));
+    }
+
+    base::ListValue routes_list;
+    for (const AppSwapRoute& route : routes) {
+      base::DictValue dict;
+      dict.Set("id", route.id);
+      dict.Set("url_pattern", route.url_pattern);
+      dict.Set("app_id", route.app_id);
+      routes_list.Append(std::move(dict));
+    }
+
+    base::DictValue data;
+    data.Set("apps", std::move(apps_list));
+    data.Set("routes", std::move(routes_list));
+    CallJavascriptFunction("setData", data);
+  }
+
+  void HandleGetData(const base::ListValue& args) {
+    AllowJavascript();
+    SendData();
+  }
+
+  void HandleAddRoute(const base::ListValue& args) {
+    AllowJavascript();
+    if (args.size() < 2) {
+      return;
+    }
+    const std::string* url_pattern = args[0].GetIfString();
+    const std::string* app_id = args[1].GetIfString();
+    if (!url_pattern || !app_id) {
+      return;
+    }
+
+    AppSwapRoute route;
+    route.url_pattern = *url_pattern;
+    route.app_id = *app_id;
+    AppSwapRoutesService::GetInstance()->AddRoute(std::move(route));
+    SendData();
+  }
+
+  void HandleUpdateRoute(const base::ListValue& args) {
+    AllowJavascript();
+    if (args.size() < 3) {
+      return;
+    }
+    const std::string* id = args[0].GetIfString();
+    const std::string* url_pattern = args[1].GetIfString();
+    const std::string* app_id = args[2].GetIfString();
+    if (!id || !url_pattern || !app_id) {
+      return;
+    }
+
+    AppSwapRoute route;
+    route.id = *id;
+    route.url_pattern = *url_pattern;
+    route.app_id = *app_id;
+    AppSwapRoutesService::GetInstance()->UpdateRoute(std::move(route));
+    SendData();
+  }
+
+  void HandleRemoveRoute(const base::ListValue& args) {
+    AllowJavascript();
+    if (args.empty()) {
+      return;
+    }
+    const std::string* id = args[0].GetIfString();
+    if (!id) {
+      return;
+    }
+    AppSwapRoutesService::GetInstance()->RemoveRoute(*id);
+    SendData();
+  }
+
+  base::WeakPtrFactory<AppSwapRoutesHandler> weak_factory_{this};
+};
+
+}  // namespace
