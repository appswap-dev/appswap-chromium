new file mode 100644
index 0000000000000..732081c51250c
--- /dev/null
+++ b/chrome/browser/app_swap/app_swap_apps_service.h
@@ -0,0 +1,87 @@
+// Copyright 2026 The AppSwap Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_APP_SWAP_APP_SWAP_APPS_SERVICE_H_
+#define CHROME_BROWSER_APP_SWAP_APP_SWAP_APPS_SERVICE_H_
+
+#include <string>
+#include <vector>
+
+#include "base/functional/callback.h"
+#include "base/values.h"
+#include "chrome/browser/app_swap/app_swap_config_store.h"
+#include "chrome/browser/app_swap/app_swap_source.h"
+#include "components/keyed_service/core/keyed_service.h"
+
+namespace content {
+class BrowserContext;
+}  // namespace content
+
+// A configured app: an npm package identified by a GUID, with a display title
+// and a version (exact version or dist-tag such as "latest"), plus the
+// origin(s) it's served at directly. `hosts` replaces what used to be a
+// separate AppSwapRoute entity (origin -> app_id) -- an app without any
+// serving origin isn't useful on its own, so hosting is just a property of
+// the app itself now.
+struct AppSwapApp {
+  std::string id;             // GUID, generated on creation.
+  std::string title;
+  std::string package_name;   // e.g. "@myorg/myapp"
+  std::string version;        // exact version ("1.2.3") or dist-tag ("latest")
+  std::string registry;       // e.g. "https://registry.npmjs.org"
+  std::string token;          // optional bearer token for private registries
+  std::vector<std::string> hosts;  // e.g. "https://my-website.com" or
+                                    // "https://my-website.com/docs"
+
+  AppSwapSource ToSource() const {
+    return AppSwapSource{package_name, version, registry, token};
+  }
+};
+
+// Owns the persistent app configuration for one Project (== Chromium
+// Profile), stored as JSON under that profile's own directory. See
+// AppSwapConfigStore for the load/save mechanics, and
+// AppSwapAppsServiceFactory for how to reach the instance for a given
+// Profile.
+class AppSwapAppsService : public KeyedService, public AppSwapConfigStore {
+ public:
+  explicit AppSwapAppsService(content::BrowserContext* browser_context);
+  ~AppSwapAppsService() override;
+
+  AppSwapAppsService(const AppSwapAppsService&) = delete;
+  AppSwapAppsService& operator=(const AppSwapAppsService&) = delete;
+
+  // Loads the config from disk (on first call) and invokes |callback| with
+  // the apps on the UI thread.
+  void GetApps(base::OnceCallback<void(std::vector<AppSwapApp>)> callback);
+
+  // Returns the loaded apps synchronously, or an empty list if the config
+  // hasn't finished loading yet. Callers that must not wait on a callback
+  // (e.g. the URLLoaderFactory interceptor, which resolves a route on every
+  // request) should call GetApps() once early to kick off the load, then use
+  // this for the actual per-request lookup.
+  const std::vector<AppSwapApp>& GetAppsIfLoaded() const;
+
+  // Mutations. Safe to call at any time: each one is queued behind the
+  // config load (see AppSwapConfigStore::RunWhenLoaded), applies to the
+  // in-memory list, and writes the file. `id` is generated for AddApp() if
+  // empty; Update/Remove are no-ops if no app has that id.
+  void AddApp(AppSwapApp app);
+  void UpdateApp(AppSwapApp app);
+  void RemoveApp(const std::string& id);
+
+ protected:
+  // AppSwapConfigStore:
+  void ParseConfig(const base::DictValue& dict) override;
+  base::DictValue SerializeConfig() const override;
+
+ private:
+  void AddAppNow(AppSwapApp app);
+  void UpdateAppNow(AppSwapApp app);
+  void RemoveAppNow(const std::string& id);
+
+  std::vector<AppSwapApp> apps_;
+};
+
+#endif  // CHROME_BROWSER_APP_SWAP_APP_SWAP_APPS_SERVICE_H_
