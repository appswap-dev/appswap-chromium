--- /dev/null
+++ b/chrome/browser/app_swap/app_swap_artifact_provider.cc
@@ -0,0 +1,651 @@
+// Copyright 2026 The AppSwap Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/app_swap/app_swap_artifact_provider.h"
+
+#include <algorithm>
+#include <memory>
+#include <optional>
+#include <string>
+#include <utility>
+#include <vector>
+
+#include "base/compiler_specific.h"
+#include "base/files/file_enumerator.h"
+#include "base/files/file_path.h"
+#include "base/files/file_util.h"
+#include "base/functional/bind.h"
+#include "base/json/json_reader.h"
+#include "base/no_destructor.h"
+#include "base/path_service.h"
+#include "base/strings/string_util.h"
+#include "base/task/thread_pool.h"
+#include "base/time/time.h"
+#include "base/values.h"
+#include "chrome/browser/app_swap/app_swap_version_utils.h"
+#include "chrome/browser/net/system_network_context_manager.h"
+#include "chrome/common/chrome_paths.h"
+#include "net/base/net_errors.h"
+#include "net/http/http_request_headers.h"
+#include "net/traffic_annotation/network_traffic_annotation.h"
+#include "services/network/public/cpp/resource_request.h"
+#include "services/network/public/cpp/shared_url_loader_factory.h"
+#include "services/network/public/cpp/simple_url_loader.h"
+#include "services/network/public/mojom/url_response_head.mojom.h"
+#include "third_party/zlib/google/compression_utils.h"
+#include "url/gurl.h"
+
+namespace {
+
+constexpr net::NetworkTrafficAnnotationTag kArtifactTrafficAnnotation =
+    net::DefineNetworkTrafficAnnotation("appswap_artifact", R"(
+        semantics {
+          sender: "AppSwap Artifact Provider"
+          description:
+            "Downloads the SPA application artifact (npm tarball) that AppSwap "
+            "serves for a configured route."
+          trigger: "A user navigates to an app configured with an npm source."
+          data: "None beyond the request URL and optional registry credentials."
+          destination: OTHER
+        }
+        policy {
+          cookies_allowed: NO
+          setting: "This is an AppSwap feature with no separate setting."
+        })");
+
+std::string Key(const AppSwapSource& source) {
+  return source.package_name + "@" + source.version;
+}
+
+std::string TarballUrl(const AppSwapSource& source, const std::string& version) {
+  std::string basename = source.package_name;
+  const size_t slash = basename.find_last_of('/');
+  if (slash != std::string::npos) {
+    basename = basename.substr(slash + 1);
+  }
+  return base::StrCat({source.registry, "/", source.package_name, "/-/",
+                       basename, "-", version, ".tgz"});
+}
+
+std::string MetadataUrl(const AppSwapSource& source) {
+  std::string encoded;
+  for (const char c : source.package_name) {
+    if (c == '/') {
+      encoded += "%2F";
+    } else {
+      encoded += c;
+    }
+  }
+  return base::StrCat({source.registry, "/", encoded});
+}
+
+// Both of these return an empty path for input that isn't safe to put in a
+// filesystem path -- see app_swap::IsValidPackageNameForPath /
+// IsValidVersionForPath, and the callers, which treat an empty path as "this
+// artifact cannot be resolved" rather than falling back to something.
+base::FilePath PackageDir(const AppSwapSource& source) {
+  if (!app_swap::IsValidPackageNameForPath(source.package_name)) {
+    return base::FilePath();
+  }
+  base::FilePath apps_dir;
+  if (!base::PathService::Get(chrome::DIR_USER_DATA, &apps_dir)) {
+    base::GetTempDir(&apps_dir);
+  }
+  return apps_dir.AppendASCII("AppSwapApps")
+      .Append(base::FilePath::FromUTF8Unsafe(source.package_name));
+}
+
+base::FilePath TargetDir(const AppSwapSource& source,
+                         const std::string& version) {
+  if (!app_swap::IsValidVersionForPath(version)) {
+    return base::FilePath();
+  }
+  const base::FilePath package_dir = PackageDir(source);
+  if (package_dir.empty()) {
+    return base::FilePath();
+  }
+  return package_dir.Append(base::FilePath::FromUTF8Unsafe(version));
+}
+
+// How many extracted versions of one package to keep on disk. Old versions
+// are worth keeping around -- they're what makes the offline fallback and
+// the "registry unreachable" recovery page work -- but without a cap the
+// cache grows for the life of the install, one full copy of the app per
+// release ever navigated to.
+constexpr size_t kMaxCachedVersionsPerPackage = 10;
+
+// Blocking; must run off the UI thread. Deletes all but the
+// `kMaxCachedVersionsPerPackage` most recently modified version directories
+// under `package_dir`, skipping anything in `keep` (versions currently
+// resolved for a live tab, which must not be pulled out from under it).
+void PruneCachedVersionsBlocking(base::FilePath package_dir,
+                                 std::vector<base::FilePath> keep) {
+  std::vector<std::pair<base::Time, base::FilePath>> entries;
+  base::FileEnumerator enumerator(package_dir, /*recursive=*/false,
+                                  base::FileEnumerator::DIRECTORIES);
+  for (base::FilePath name = enumerator.Next(); !name.empty();
+       name = enumerator.Next()) {
+    entries.emplace_back(enumerator.GetInfo().GetLastModifiedTime(), name);
+  }
+  if (entries.size() <= kMaxCachedVersionsPerPackage) {
+    return;
+  }
+  // Newest first, so everything past the cap is the oldest by last use.
+  std::sort(entries.begin(), entries.end(),
+            [](const auto& a, const auto& b) { return a.first > b.first; });
+  for (size_t i = kMaxCachedVersionsPerPackage; i < entries.size(); ++i) {
+    const base::FilePath& dir = entries[i].second;
+    if (std::ranges::contains(keep, dir)) {
+      continue;
+    }
+    base::DeletePathRecursively(dir);
+  }
+}
+
+// Blocking; must run off the UI thread. Each subdirectory of a package's
+// cache directory is an extracted version (see TargetDir()).
+std::vector<std::string> ListCachedVersionsBlocking(base::FilePath package_dir) {
+  std::vector<std::string> versions;
+  base::FileEnumerator enumerator(package_dir, /*recursive=*/false,
+                                  base::FileEnumerator::DIRECTORIES);
+  for (base::FilePath name = enumerator.Next(); !name.empty();
+       name = enumerator.Next()) {
+    versions.push_back(name.BaseName().AsUTF8Unsafe());
+  }
+  std::sort(versions.begin(), versions.end(), &app_swap::IsNewerVersion);
+  return versions;
+}
+
+// Extracts a ustar-format tar archive into `dest_dir`. Returns false on error
+// (including any entry that would escape `dest_dir`).
+UNSAFE_BUFFERS(bool ExtractTar(const std::string& tar,
+                               const base::FilePath& dest_dir) {
+  constexpr size_t kBlockSize = 512;
+  size_t offset = 0;
+  while (offset + kBlockSize <= tar.size()) {
+    const char* header = tar.data() + offset;
+
+    // A zeroed header marks the end of the archive.
+    if (header[0] == '\0') {
+      return true;
+    }
+
+    std::string name(header, 100);
+    name = name.substr(0, name.find('\0'));
+    std::string prefix(header + 345, 155);
+    prefix = prefix.substr(0, prefix.find('\0'));
+    if (!prefix.empty()) {
+      name = prefix + "/" + name;
+    }
+    // npm tarballs store everything under a top-level "package/" directory.
+    const size_t first_slash = name.find('/');
+    if (first_slash != std::string::npos) {
+      name = name.substr(first_slash + 1);
+    }
+
+    std::string size_str(header + 124, 12);
+    size_str = size_str.substr(0, size_str.find_first_of(" \0"));
+    uint64_t size = 0;
+    if (!size_str.empty()) {
+      size = strtoull(size_str.c_str(), nullptr, 8);
+    }
+
+    const char typeflag = header[156];
+    offset += kBlockSize;
+
+    const uint64_t padded_size = (size + kBlockSize - 1) / kBlockSize * kBlockSize;
+    if (offset + padded_size > tar.size()) {
+      return false;
+    }
+
+    // Security: reject any entry that could escape the destination.
+    if (name.find("..") != std::string::npos) {
+      return false;
+    }
+
+    // The top-level directory entry itself carries no content to write.
+    if (name.empty()) {
+      offset += padded_size;
+      continue;
+    }
+
+    base::FilePath path = dest_dir.Append(base::FilePath::FromUTF8Unsafe(name));
+
+    if (typeflag == '5') {
+      // Directory.
+      if (!base::CreateDirectory(path)) {
+        return false;
+      }
+    } else if (typeflag == '0' || typeflag == '\0') {
+      // Regular file.
+      if (!base::CreateDirectory(path.DirName()) ||
+          !base::WriteFile(path, tar.substr(offset, size))) {
+        return false;
+      }
+    }
+    // Other types (symlink, hardlink, device) are skipped.
+
+    offset += padded_size;
+  }
+  return false;  // Truncated archive (no end marker).
+})
+
+}  // namespace
+
+AppSwapArtifactProvider::AppSwapArtifactProvider() = default;
+AppSwapArtifactProvider::~AppSwapArtifactProvider() = default;
+
+// static
+AppSwapArtifactProvider* AppSwapArtifactProvider::GetInstance() {
+  static base::NoDestructor<AppSwapArtifactProvider> instance;
+  return instance.get();
+}
+
+// static
+bool AppSwapArtifactProvider::IsExactVersion(const std::string& version) {
+  size_t i = 0;
+  if (!version.empty() && (version[0] == 'v' || version[0] == 'V')) {
+    i = 1;
+  }
+  return i < version.size() && version[i] >= '0' && version[i] <= '9';
+}
+
+std::optional<std::string> AppSwapArtifactProvider::GetResolvedVersionIfCached(
+    const AppSwapSource& source) const {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  auto it = cache_.find(Key(source));
+  if (it == cache_.end()) {
+    return std::nullopt;
+  }
+  return it->second.BaseName().AsUTF8Unsafe();
+}
+
+void AppSwapArtifactProvider::CheckForNewerVersion(
+    const AppSwapSource& source,
+    base::OnceCallback<void(std::optional<std::string>)> callback) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  FetchMetadata(
+      source, &loaders_for_checks_,
+      base::BindOnce(
+          [](base::OnceCallback<void(std::optional<std::string>)> callback,
+             std::string version, std::string error) {
+            std::move(callback).Run(
+                error.empty() ? std::optional<std::string>(std::move(version))
+                             : std::nullopt);
+          },
+          std::move(callback)));
+}
+
+void AppSwapArtifactProvider::InvalidateCache(const AppSwapSource& source) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  cache_.erase(Key(source));
+}
+
+void AppSwapArtifactProvider::GetOrDownload(
+    const AppSwapSource& source,
+    base::OnceCallback<void(base::FilePath)> callback) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  const std::string key = Key(source);
+
+  auto cache_it = cache_.find(key);
+  if (cache_it != cache_.end()) {
+    base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+        FROM_HERE, base::BindOnce(std::move(callback), cache_it->second));
+    return;
+  }
+
+  auto& pending = pending_[key];
+  pending.push_back(std::move(callback));
+  if (pending.size() > 1) {
+    return;  // Already resolving/downloading this source.
+  }
+
+  // A package name or exact version that can't be a cache path is not
+  // resolvable, and must not reach the network either -- see
+  // app_swap::IsValidVersionForPath for why a version in particular is
+  // attacker-influenced. A dist-tag isn't checked here; it's resolved to a
+  // real version by the registry first, and *that* gets validated when the
+  // resolved version is turned into a path.
+  if (PackageDir(source).empty() ||
+      (IsExactVersion(source.version) &&
+       !app_swap::IsValidVersionForPath(source.version))) {
+    base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+        FROM_HERE, base::BindOnce(&AppSwapArtifactProvider::Finish,
+                                  base::Unretained(this), source,
+                                  base::FilePath()));
+    return;
+  }
+
+  if (IsExactVersion(source.version)) {
+    // Check disk before the network: an exact version that's already been
+    // extracted (from an earlier session, or resolved under a since-moved
+    // dist-tag) doesn't need re-downloading, and -- more importantly --
+    // this is what lets a currently-displayed tab keep working (via the
+    // fallback in AppSwapProxyingURLLoaderFactory's ServeAfterResolve) when
+    // the registry is unreachable.
+    const base::FilePath target_dir = TargetDir(source, source.version);
+    base::ThreadPool::PostTaskAndReplyWithResult(
+        FROM_HERE, {base::MayBlock(), base::TaskPriority::USER_VISIBLE},
+        base::BindOnce(&base::PathExists, target_dir),
+        base::BindOnce(
+            [](AppSwapArtifactProvider* self, AppSwapSource source,
+               base::FilePath target_dir, bool exists) {
+              if (exists) {
+                self->Finish(source, target_dir);
+                return;
+              }
+              self->DownloadTarball(
+                  source, source.version,
+                  TarballUrl(source, source.version),
+                  base::BindOnce(&AppSwapArtifactProvider::Finish,
+                                 base::Unretained(self), source));
+            },
+            base::Unretained(this), source, target_dir));
+  } else {
+    FetchMetadata(
+        source, &loaders_,
+        base::BindOnce(
+            [](AppSwapArtifactProvider* self, const AppSwapSource& source,
+               std::string version, std::string error) {
+              if (!error.empty()) {
+                self->Finish(source, base::FilePath());
+                return;
+              }
+              self->DownloadTarball(
+                  source, version, TarballUrl(source, version),
+                  base::BindOnce(&AppSwapArtifactProvider::Finish,
+                                 base::Unretained(self), source));
+            },
+            base::Unretained(this), source));
+  }
+}
+
+void AppSwapArtifactProvider::EnsureFreshThenGetOrDownload(
+    const AppSwapSource& source,
+    base::OnceCallback<void(base::FilePath)> callback) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  if (IsExactVersion(source.version)) {
+    GetOrDownload(source, std::move(callback));
+    return;
+  }
+  CheckForNewerVersion(
+      source, base::BindOnce(
+                  [](AppSwapArtifactProvider* self, AppSwapSource source,
+                     base::OnceCallback<void(base::FilePath)> callback,
+                     std::optional<std::string> registry_version) {
+                    if (registry_version) {
+                      std::optional<std::string> cached =
+                          self->GetResolvedVersionIfCached(source);
+                      if (!cached || *cached != *registry_version) {
+                        self->InvalidateCache(source);
+                      }
+                    }
+                    self->GetOrDownload(source, std::move(callback));
+                  },
+                  base::Unretained(this), source, std::move(callback)));
+}
+
+AppSwapPackageMetadata::AppSwapPackageMetadata() = default;
+AppSwapPackageMetadata::AppSwapPackageMetadata(
+    const AppSwapPackageMetadata&) = default;
+AppSwapPackageMetadata& AppSwapPackageMetadata::operator=(
+    const AppSwapPackageMetadata&) = default;
+AppSwapPackageMetadata::~AppSwapPackageMetadata() = default;
+
+void AppSwapArtifactProvider::FetchPackageMetadata(
+    const AppSwapSource& source,
+    base::OnceCallback<void(std::optional<AppSwapPackageMetadata>)>
+        callback) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+
+  auto resource_request = std::make_unique<network::ResourceRequest>();
+  resource_request->url = GURL(MetadataUrl(source));
+  resource_request->method = net::HttpRequestHeaders::kGetMethod;
+  resource_request->headers.SetHeader(net::HttpRequestHeaders::kAccept,
+                                      "application/json");
+  if (!source.token.empty()) {
+    resource_request->headers.SetHeader(net::HttpRequestHeaders::kAuthorization,
+                                        base::StrCat({"Bearer ", source.token}));
+  }
+
+  scoped_refptr<network::SharedURLLoaderFactory> factory =
+      SystemNetworkContextManager::GetInstance()->GetSharedURLLoaderFactory();
+
+  auto loader =
+      network::SimpleURLLoader::Create(std::move(resource_request),
+                                       kArtifactTrafficAnnotation);
+  network::SimpleURLLoader* raw_loader = loader.get();
+  const std::string key = Key(source);
+  metadata_query_loaders_[key] = std::move(loader);
+
+  raw_loader->DownloadToStringOfUnboundedSizeUntilCrashAndDie(
+      factory.get(),
+      base::BindOnce(
+          [](AppSwapArtifactProvider* self, std::string key,
+             base::OnceCallback<void(std::optional<AppSwapPackageMetadata>)>
+                 callback,
+             std::optional<std::string> body) {
+            self->metadata_query_loaders_.erase(key);
+            if (!body) {
+              std::move(callback).Run(std::nullopt);
+              return;
+            }
+            std::optional<base::Value> parsed = base::JSONReader::Read(
+                *body, base::JSON_PARSE_CHROMIUM_EXTENSIONS);
+            if (!parsed || !parsed->is_dict()) {
+              std::move(callback).Run(std::nullopt);
+              return;
+            }
+            const base::DictValue& root = parsed->GetDict();
+            AppSwapPackageMetadata metadata;
+            if (const base::DictValue* dist_tags = root.FindDict("dist-tags")) {
+              for (const auto [tag, version] : *dist_tags) {
+                if (version.is_string()) {
+                  metadata.dist_tags[tag] = version.GetString();
+                }
+              }
+            }
+            if (const base::DictValue* versions = root.FindDict("versions")) {
+              for (const auto [version, unused] : *versions) {
+                metadata.versions.push_back(version);
+              }
+            }
+            if (metadata.versions.empty() && metadata.dist_tags.empty()) {
+              std::move(callback).Run(std::nullopt);
+              return;
+            }
+            std::move(callback).Run(std::move(metadata));
+          },
+          base::Unretained(this), key, std::move(callback)));
+}
+
+void AppSwapArtifactProvider::GetCachedVersions(
+    const AppSwapSource& source,
+    base::OnceCallback<void(std::vector<std::string>)> callback) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  const base::FilePath package_dir = PackageDir(source);
+  if (package_dir.empty()) {
+    base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+        FROM_HERE,
+        base::BindOnce(std::move(callback), std::vector<std::string>()));
+    return;
+  }
+  base::ThreadPool::PostTaskAndReplyWithResult(
+      FROM_HERE, {base::MayBlock(), base::TaskPriority::USER_VISIBLE},
+      base::BindOnce(&ListCachedVersionsBlocking, package_dir),
+      std::move(callback));
+}
+
+void AppSwapArtifactProvider::FetchMetadata(
+    const AppSwapSource& source,
+    std::map<std::string, std::unique_ptr<network::SimpleURLLoader>>*
+        loader_map,
+    base::OnceCallback<void(std::string /*version*/, std::string /*error*/)>
+        callback) {
+  auto resource_request = std::make_unique<network::ResourceRequest>();
+  resource_request->url = GURL(MetadataUrl(source));
+  resource_request->method = net::HttpRequestHeaders::kGetMethod;
+  resource_request->headers.SetHeader(net::HttpRequestHeaders::kAccept,
+                                      "application/json");
+  if (!source.token.empty()) {
+    resource_request->headers.SetHeader(net::HttpRequestHeaders::kAuthorization,
+                                        base::StrCat({"Bearer ", source.token}));
+  }
+
+  scoped_refptr<network::SharedURLLoaderFactory> factory =
+      SystemNetworkContextManager::GetInstance()->GetSharedURLLoaderFactory();
+
+  auto loader =
+      network::SimpleURLLoader::Create(std::move(resource_request),
+                                       kArtifactTrafficAnnotation);
+  network::SimpleURLLoader* raw_loader = loader.get();
+  (*loader_map)[Key(source)] = std::move(loader);
+
+  raw_loader->DownloadToStringOfUnboundedSizeUntilCrashAndDie(
+      factory.get(),
+      base::BindOnce(
+          [](std::map<std::string, std::unique_ptr<network::SimpleURLLoader>>*
+                 loader_map,
+             const AppSwapSource& source,
+             base::OnceCallback<void(std::string, std::string)> callback,
+             std::optional<std::string> body) {
+            loader_map->erase(Key(source));
+            if (!body) {
+              std::move(callback).Run(std::string(), "metadata download failed");
+              return;
+            }
+            std::optional<base::Value> parsed =
+                base::JSONReader::Read(*body, base::JSON_PARSE_CHROMIUM_EXTENSIONS);
+            if (!parsed || !parsed->is_dict()) {
+              std::move(callback).Run(std::string(), "invalid metadata JSON");
+              return;
+            }
+            const base::DictValue& root = parsed->GetDict();
+            const base::DictValue* dist_tags = root.FindDict("dist-tags");
+            const std::string* version =
+                dist_tags ? dist_tags->FindString(source.version) : nullptr;
+            if (!version) {
+              std::move(callback).Run(std::string(),
+                                      "dist-tag not found: " + source.version);
+              return;
+            }
+            std::move(callback).Run(*version, std::string());
+          },
+          loader_map, source, std::move(callback)));
+}
+
+void AppSwapArtifactProvider::DownloadTarball(
+    const AppSwapSource& source,
+    const std::string& version,
+    const std::string& tarball_url,
+    base::OnceCallback<void(base::FilePath)> callback) {
+  const base::FilePath target_dir = TargetDir(source, version);
+  // Empty for a version the registry resolved a dist-tag to that isn't safe
+  // as a directory name -- nothing to download it into, so don't ask.
+  if (target_dir.empty()) {
+    std::move(callback).Run(base::FilePath());
+    return;
+  }
+
+  auto resource_request = std::make_unique<network::ResourceRequest>();
+  resource_request->url = GURL(tarball_url);
+  resource_request->method = net::HttpRequestHeaders::kGetMethod;
+  if (!source.token.empty()) {
+    resource_request->headers.SetHeader(net::HttpRequestHeaders::kAuthorization,
+                                        base::StrCat({"Bearer ", source.token}));
+  }
+
+  scoped_refptr<network::SharedURLLoaderFactory> factory =
+      SystemNetworkContextManager::GetInstance()->GetSharedURLLoaderFactory();
+
+  auto loader =
+      network::SimpleURLLoader::Create(std::move(resource_request),
+                                       kArtifactTrafficAnnotation);
+  network::SimpleURLLoader* raw_loader = loader.get();
+  loaders_[Key(source)] = std::move(loader);
+
+  raw_loader->DownloadToStringOfUnboundedSizeUntilCrashAndDie(
+      factory.get(),
+      base::BindOnce(&AppSwapArtifactProvider::OnTarball, base::Unretained(this),
+                     source, version, target_dir, std::move(callback)));
+}
+
+void AppSwapArtifactProvider::OnTarball(
+    const AppSwapSource& source,
+    const std::string& version,
+    base::FilePath target_dir,
+    base::OnceCallback<void(base::FilePath)> callback,
+    std::optional<std::string> body) {
+  loaders_.erase(Key(source));
+  if (!body) {
+    std::move(callback).Run(base::FilePath());
+    return;
+  }
+
+  // Extract (gunzip + untar) on a MayBlock task runner.
+  base::ThreadPool::PostTaskAndReplyWithResult(
+      FROM_HERE, {base::MayBlock(), base::TaskPriority::USER_VISIBLE},
+      base::BindOnce(
+          [](std::string tgz, base::FilePath dir) {
+            if (base::PathExists(dir)) {
+              return true;  // Already extracted.
+            }
+            std::string tar;
+            if (!compression::GzipUncompress(tgz, &tar) ||
+                !base::CreateDirectory(dir) || !ExtractTar(tar, dir)) {
+              return false;
+            }
+            return true;
+          },
+          std::move(*body), target_dir),
+      base::BindOnce(
+          [](base::OnceCallback<void(base::FilePath)> callback,
+             base::FilePath target_dir, bool success) {
+            std::move(callback).Run(success ? target_dir : base::FilePath());
+          },
+          std::move(callback), target_dir));
+}
+
+void AppSwapArtifactProvider::Finish(const AppSwapSource& source,
+                                     base::FilePath dir) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  const std::string key = Key(source);
+
+  if (!dir.empty()) {
+    cache_[key] = dir;
+    PruneCachedVersions(source);
+  }
+
+  auto it = pending_.find(key);
+  if (it != pending_.end()) {
+    std::vector<base::OnceCallback<void(base::FilePath)>> callbacks =
+        std::move(it->second);
+    pending_.erase(it);
+    for (auto& callback : callbacks) {
+      std::move(callback).Run(dir);
+    }
+  }
+}
+
+void AppSwapArtifactProvider::PruneCachedVersions(
+    const AppSwapSource& source) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  const base::FilePath package_dir = PackageDir(source);
+  if (package_dir.empty()) {
+    return;
+  }
+  // Everything currently resolved, for any package -- a tab pinned to an
+  // older version (or still showing one after the dist-tag moved on) holds
+  // its directory through `cache_`, and deleting it out from under that tab
+  // would break its next subresource fetch.
+  std::vector<base::FilePath> keep;
+  keep.reserve(cache_.size());
+  for (const auto& [key, dir] : cache_) {
+    keep.push_back(dir);
+  }
+  base::ThreadPool::PostTask(
+      FROM_HERE, {base::MayBlock(), base::TaskPriority::BEST_EFFORT},
+      base::BindOnce(&PruneCachedVersionsBlocking, package_dir,
+                     std::move(keep)));
+}
