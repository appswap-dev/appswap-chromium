+#ifndef CHROME_BROWSER_APP_SWAP_APP_SWAP_SOURCE_H_
+#define CHROME_BROWSER_APP_SWAP_APP_SWAP_SOURCE_H_
+
+#include <string>
+
+// Where the files for an AppSwap route come from: an npm package tarball.
+struct AppSwapSource {
+  std::string package_name;  // e.g. "@myorg/myapp"
+  std::string version;       // exact version ("1.2.3") or dist-tag ("latest")
+  std::string registry;      // e.g. "https://registry.npmjs.org" (no trailing '/')
+  std::string token;         // optional bearer token for private registries
+};
+
+#endif  // CHROME_BROWSER_APP_SWAP_APP_SWAP_SOURCE_H_
