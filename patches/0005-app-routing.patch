--- /dev/null
+++ b/chrome/browser/app_swap/app_swap_artifact_provider.h
@@ -0,0 +1,174 @@
+// Copyright 2026 The AppSwap Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_APP_SWAP_APP_SWAP_ARTIFACT_PROVIDER_H_
+#define CHROME_BROWSER_APP_SWAP_APP_SWAP_ARTIFACT_PROVIDER_H_
+
+#include <map>
+#include <memory>
+#include <optional>
+#include <string>
+#include <vector>
+
+#include "base/files/file_path.h"
+#include "base/functional/callback.h"
+#include "base/sequence_checker.h"
+#include "chrome/browser/app_swap/app_swap_source.h"
+
+namespace network {
+class SimpleURLLoader;
+}  // namespace network
+
+// The full set of published dist-tags and versions for a package, used by the
+// version-picker UI to let the user choose among ALL available tags/versions
+// rather than just what a single AppSwapSource currently resolves to.
+struct AppSwapPackageMetadata {
+  AppSwapPackageMetadata();
+  AppSwapPackageMetadata(const AppSwapPackageMetadata&);
+  AppSwapPackageMetadata& operator=(const AppSwapPackageMetadata&);
+  ~AppSwapPackageMetadata();
+
+  std::vector<std::string> versions;              // All published versions.
+  std::map<std::string, std::string> dist_tags;   // tag -> version.
+};
+
+// Resolves npm app sources to a directory on disk, downloading and unpacking
+// the tarball on first use and caching the result.
+class AppSwapArtifactProvider {
+ public:
+  AppSwapArtifactProvider();
+  ~AppSwapArtifactProvider();
+
+  AppSwapArtifactProvider(const AppSwapArtifactProvider&) = delete;
+  AppSwapArtifactProvider& operator=(const AppSwapArtifactProvider&) = delete;
+
+  static AppSwapArtifactProvider* GetInstance();
+
+  // Asynchronously ensures the artifact for `source` is present and calls
+  // `callback` with its directory (empty on failure). Must be called on the UI
+  // thread; `callback` runs on the UI thread.
+  //
+  // For a dist-tag `source`, this trusts whatever is already cached under
+  // that tag -- it does not re-consult the registry once a tag has resolved
+  // once. Use EnsureFreshThenGetOrDownload() at points where staleness would
+  // actually be visible to the user (a navigation), not for every
+  // subresource of an already-loading page.
+  void GetOrDownload(const AppSwapSource& source,
+                     base::OnceCallback<void(base::FilePath)> callback);
+
+  // Same contract as GetOrDownload(), except for a dist-tag `source` it first
+  // asks the registry what the tag currently resolves to and, if that
+  // differs from what's cached, invalidates the cache so the download that
+  // follows fetches the current version instead of serving a stale one.
+  // Falls back to plain GetOrDownload() behavior (serve whatever's cached,
+  // or resolve for the first time) if the registry query itself fails, so a
+  // transient network hiccup degrades to the old behavior rather than
+  // failing the navigation. Intended for navigation-type requests (a new tab
+  // or a refresh) -- an exact-version `source` skips the registry query
+  // entirely, since there's no tag to have drifted.
+  void EnsureFreshThenGetOrDownload(
+      const AppSwapSource& source,
+      base::OnceCallback<void(base::FilePath)> callback);
+
+  // Returns the concrete version `source` resolved to (e.g. "1.1.0" for a
+  // `source.version` of "latest"), if its artifact has already been
+  // downloaded via GetOrDownload; nullopt otherwise.
+  std::optional<std::string> GetResolvedVersionIfCached(
+      const AppSwapSource& source) const;
+
+  // Asks the registry what `source.version` (a dist-tag) currently resolves
+  // to, without touching GetOrDownload's cache or download state -- a pure
+  // "what does the registry say right now" query, used to detect a newer
+  // version under a moving tag. Calls `callback` with nullopt on any
+  // network/parse error. Must be called on the UI thread.
+  void CheckForNewerVersion(
+      const AppSwapSource& source,
+      base::OnceCallback<void(std::optional<std::string> /*version*/)>
+          callback);
+
+  // Forgets the cached resolved directory for `source`, so a subsequent
+  // GetOrDownload() re-resolves and re-downloads instead of returning the
+  // stale directory. Call only when actually about to serve a newer version
+  // (e.g. after the user confirms an update reload) -- never speculatively.
+  void InvalidateCache(const AppSwapSource& source);
+
+  // Returns whether `version` looks like an exact version ("1.2.3",
+  // optionally "v"-prefixed) rather than a dist-tag ("latest", "beta", ...).
+  static bool IsExactVersion(const std::string& version);
+
+  // Fetches the full list of published dist-tags and versions for `source`'s
+  // package, ignoring `source.version` entirely -- used by the version-picker
+  // UI. Calls `callback` with nullopt on any network/parse error.
+  void FetchPackageMetadata(
+      const AppSwapSource& source,
+      base::OnceCallback<void(std::optional<AppSwapPackageMetadata>)>
+          callback);
+
+  // Lists the exact versions of `source.package_name` already extracted on
+  // disk, newest first, regardless of dist-tag or in-memory cache state.
+  // Used to offer a fallback when the registry is unreachable and a
+  // navigation has no other version to fall back to. `callback` gets an
+  // empty list if none are cached (including if the package has never been
+  // downloaded at all). Must be called on the UI thread; `callback` runs on
+  // the UI thread.
+  void GetCachedVersions(
+      const AppSwapSource& source,
+      base::OnceCallback<void(std::vector<std::string>)> callback);
+
+ private:
+  // `loader_map` is the map to keep the in-flight SimpleURLLoader alive in
+  // (and erase it from on completion) -- callers pick which one so an
+  // update-availability check can never cancel, or be cancelled by, a real
+  // GetOrDownload() resolution for the same "package@version" key sharing
+  // one map would.
+  void FetchMetadata(
+      const AppSwapSource& source,
+      std::map<std::string, std::unique_ptr<network::SimpleURLLoader>>*
+          loader_map,
+      base::OnceCallback<void(std::string /*version*/,
+                              std::string /*error*/)> callback);
+  void DownloadTarball(const AppSwapSource& source,
+                       const std::string& version,
+                       const std::string& tarball_url,
+                       base::OnceCallback<void(base::FilePath)> callback);
+  void OnTarball(const AppSwapSource& source,
+                 const std::string& version,
+                 base::FilePath target_dir,
+                 base::OnceCallback<void(base::FilePath)> callback,
+                 std::optional<std::string> body);
+  void Finish(const AppSwapSource& source, base::FilePath dir);
+
+  // Caps how many extracted versions of `source`'s package stay on disk,
+  // preserving every version any live tab has currently resolved. Posted to
+  // a blocking sequence; the result is never waited on.
+  void PruneCachedVersions(const AppSwapSource& source);
+
+  base::FilePath apps_dir_;
+
+  // Dedup: pending callbacks keyed by "package@version".
+  std::map<std::string, std::vector<base::OnceCallback<void(base::FilePath)>>>
+      pending_;
+
+  // Active downloads keyed by "package@version", to keep the loader alive.
+  std::map<std::string, std::unique_ptr<network::SimpleURLLoader>> loaders_;
+
+  // Active CheckForNewerVersion() requests, kept separate from `loaders_`
+  // for the same reason `metadata_query_loaders_` is kept separate below.
+  std::map<std::string, std::unique_ptr<network::SimpleURLLoader>>
+      loaders_for_checks_;
+
+  // Active FetchPackageMetadata() requests, kept separate from `loaders_` --
+  // sharing one map would let an unrelated in-flight request silently
+  // cancel (or be cancelled by) a real GetOrDownload() for the same
+  // "package@version" key.
+  std::map<std::string, std::unique_ptr<network::SimpleURLLoader>>
+      metadata_query_loaders_;
+
+  // In-memory cache of resolved directories keyed by "package@version".
+  std::map<std::string, base::FilePath> cache_;
+
+  SEQUENCE_CHECKER(sequence_checker_);
+};
+
+#endif  // CHROME_BROWSER_APP_SWAP_APP_SWAP_ARTIFACT_PROVIDER_H_
