+AppSwapRoutesUI::AppSwapRoutesUI(content::WebUI* web_ui)
+    : content::WebUIController(web_ui) {
+  // Lets this page's renderer navigate directly to appswap:// links (e.g. the
+  // nav tabs), which ChildProcessSecurityPolicy would otherwise block as an
+  // unrequestable scheme even though it's just an alias rewritten to this
+  // same chrome:// page.
+  web_ui->AddRequestableScheme(content::kAppSwapUIScheme);
+  content::WebUIDataSource* source =
+      content::WebUIDataSource::CreateAndAdd(Profile::FromWebUI(web_ui),
+                                             "appswap-routes");
+  // Allow the inline script in the page.
+  source->OverrideContentSecurityPolicy(
+      network::mojom::CSPDirectiveName::ScriptSrc,
+      "script-src chrome://resources 'self' 'unsafe-inline';");
+  source->AddResourcePath("favicon-16.png", IDR_PRODUCT_LOGO_16);
+  source->AddResourcePath("favicon-32.png", IDR_PRODUCT_LOGO_32);
+  // Serve the single HTML document for the root URL (both "" and "/" paths).
+  source->SetRequestFilter(
+      base::BindRepeating(
+          [](const std::string& path) { return path.empty() || path == "/"; }),
+      base::BindRepeating(
+          [](const std::string& path,
+             content::WebUIDataSource::GotDataCallback callback) {
+            std::move(callback).Run(
+                base::MakeRefCounted<base::RefCountedString>(
+                    std::string(kRoutesHtml)));
+          }));
+  web_ui->AddMessageHandler(std::make_unique<AppSwapRoutesHandler>());
+}
+
+AppSwapRoutesUI::~AppSwapRoutesUI() = default;
+
+AppSwapRoutesUIConfig::AppSwapRoutesUIConfig()
+    : content::DefaultWebUIConfig<AppSwapRoutesUI>(content::kChromeUIScheme,
+                                                   "appswap-routes") {}
