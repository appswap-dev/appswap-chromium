+// Copyright 2026 The AppSwap Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_APP_SWAP_APP_SWAP_APPS_SERVICE_H_
+#define CHROME_BROWSER_APP_SWAP_APP_SWAP_APPS_SERVICE_H_
+
+#include <string>
+#include <vector>
+
+#include "base/files/file_path.h"
+#include "base/functional/callback.h"
+#include "base/sequence_checker.h"
+#include "chrome/browser/app_swap/app_swap_source.h"
+
+// A configured app: an npm package identified by a GUID, with a display title
+// and a version (exact version or dist-tag such as "latest").
+struct AppSwapApp {
+  std::string id;           // GUID, generated on creation.
+  std::string title;
+  std::string package_name;  // e.g. "@myorg/myapp"
+  std::string version;       // exact version ("1.2.3") or dist-tag ("latest")
+  std::string registry;      // e.g. "https://registry.npmjs.org"
+  std::string token;         // optional bearer token for private registries
+
+  AppSwapSource ToSource() const {
+    return AppSwapSource{package_name, version, registry, token};
+  }
+};
+
+// Owns the persistent app configuration, stored as JSON in the user data
+// directory. The file is read/written on a background (MayBlock) task runner.
+class AppSwapAppsService {
+ public:
+  AppSwapAppsService();
+  ~AppSwapAppsService();
+
+  AppSwapAppsService(const AppSwapAppsService&) = delete;
+  AppSwapAppsService& operator=(const AppSwapAppsService&) = delete;
+
+  static AppSwapAppsService* GetInstance();
+
+  // Loads the config from disk (on first call) and invokes |callback| with the
+  // apps on the UI thread.
+  void GetApps(base::OnceCallback<void(std::vector<AppSwapApp>)> callback);
+
+  // Returns the loaded apps synchronously, or an empty list if the config
+  // hasn't finished loading yet. Callers that must not wait on a callback
+  // (e.g. the URLLoaderFactory interceptor, which resolves a route on every
+  // request) should call GetApps() once early to kick off the load, then use
+  // this for the actual per-request lookup.
+  const std::vector<AppSwapApp>& GetAppsIfLoaded() const;
+
+  // Mutations. Must only be called after the config has been loaded (i.e.
+  // after a GetApps callback has run). They update the in-memory list and
+  // schedule an asynchronous save.
+  void AddApp(AppSwapApp app);
+  void UpdateApp(AppSwapApp app);
+  void RemoveApp(const std::string& id);
+
+ private:
+  void OnConfigLoaded(std::vector<AppSwapApp> apps);
+  void ScheduleSave();
+
+  base::FilePath ConfigPath();
+
+  std::vector<AppSwapApp> apps_;
+  bool loaded_ = false;
+  bool loading_ = false;
+  std::vector<base::OnceClosure> pending_load_;
+  SEQUENCE_CHECKER(sequence_checker_);
+};
+
+#endif  // CHROME_BROWSER_APP_SWAP_APP_SWAP_APPS_SERVICE_H_
