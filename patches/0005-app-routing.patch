@@ -0,0 +1,134 @@
+// Copyright 2026 The AppSwap Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/app_swap/app_swap_route_matcher.h"
+
+#include <optional>
+#include <string>
+#include <string_view>
+
+#include "base/strings/strcat.h"
+#include "base/strings/string_util.h"
+#include "chrome/browser/app_swap/app_swap_apps_service_factory.h"
+#include "chrome/browser/app_swap/app_swap_route_group_service_factory.h"
+#include "url/gurl.h"
+
+bool AppSwapUrlMatchesPattern(const GURL& url, const std::string& url_pattern) {
+  const GURL pattern_url(url_pattern);
+  if (!pattern_url.is_valid() || url.scheme() != pattern_url.scheme() ||
+      url.host() != pattern_url.host() ||
+      url.EffectiveIntPort() != pattern_url.EffectiveIntPort()) {
+    return false;
+  }
+
+  const std::string_view pattern_path = pattern_url.path();
+  if (pattern_path.empty() || pattern_path == "/") {
+    return true;
+  }
+  const std::string_view url_path = url.path();
+  if (!base::StartsWith(url_path, pattern_path)) {
+    return false;
+  }
+  // Require a path-segment boundary so "/docs" doesn't match "/docs-legacy".
+  return url_path.size() == pattern_path.size() || pattern_path.back() == '/' ||
+         url_path[pattern_path.size()] == '/';
+}
+
+GURL ComputeAppSwapRewriteUrl(const GURL& url,
+                              const std::string& url_pattern,
+                              const std::string& target) {
+  const GURL pattern_url(url_pattern);
+  const GURL target_url(target);
+
+  const std::string_view pattern_path = pattern_url.path();
+  const std::string_view url_path = url.path();
+  // Mirrors AppSwapUrlMatchesPattern()'s treatment of an empty/root pattern
+  // path as matching (and thus contributing) the whole request path.
+  std::string_view suffix;
+  if (pattern_path.empty() || pattern_path == "/") {
+    suffix = url_path;
+  } else if (url_path.size() > pattern_path.size()) {
+    suffix = url_path.substr(pattern_path.size());
+  }
+
+  std::string_view target_path = target_url.path();
+  std::string new_path;
+  if (!target_path.empty() && !suffix.empty() && target_path.back() == '/' &&
+      suffix.front() == '/') {
+    // Avoid a doubled slash where the target path and the suffix both
+    // supply one at the join point (e.g. target "/api/" + suffix "/users").
+    new_path = base::StrCat({target_path, suffix.substr(1)});
+  } else {
+    new_path = base::StrCat({target_path, suffix});
+  }
+
+  const std::string query(url.query());
+  GURL::Replacements replacements;
+  replacements.SetPathStr(new_path);
+  if (url.has_query()) {
+    replacements.SetQueryStr(query);
+  } else {
+    replacements.ClearQuery();
+  }
+  return target_url.ReplaceComponents(replacements);
+}
+
+std::optional<AppSwapRouteGroupRule> FindAppSwapRouteGroupRuleForUrl(
+    const std::optional<AppSwapRouteGroup>& group,
+    const GURL& url) {
+  if (!group) {
+    return std::nullopt;
+  }
+  for (const AppSwapRouteGroupRule& rule : group->rules) {
+    if (AppSwapUrlMatchesPattern(url, rule.url_pattern)) {
+      return rule;
+    }
+  }
+  return std::nullopt;
+}
+
+std::optional<AppSwapRouteGroup> FindAppSwapRouteGroupById(
+    Profile* profile,
+    const std::string& group_id) {
+  // AppSwapRouteGroupServiceFactory only builds an instance for regular
+  // profiles (ProfileKeyedServiceFactory's default ProfileSelections
+  // excludes Incognito/Guest/System) -- guarded here, at the shared root
+  // both of this file's public functions fan out from, rather than at each
+  // caller, since new callers (there are several already: the URL loader
+  // factory, the location bar's security-chip logic, Page Info) would
+  // otherwise each need to remember to do it themselves. Confirmed via a
+  // real crash dump: an Incognito window's location bar used to null-deref
+  // through here.
+  AppSwapRouteGroupService* service =
+      AppSwapRouteGroupServiceFactory::GetForProfile(profile);
+  if (!service) {
+    return std::nullopt;
+  }
+  for (const AppSwapRouteGroup& group : service->GetRouteGroupsIfLoaded()) {
+    if (group.id == group_id) {
+      return group;
+    }
+  }
+  return std::nullopt;
+}
+
+std::optional<AppSwapApp> FindAppSwapAppForUrl(Profile* profile,
+                                               const GURL& url) {
+  AppSwapAppsService* service = AppSwapAppsServiceFactory::GetForProfile(profile);
+  if (!service) {
+    return std::nullopt;
+  }
+  for (const AppSwapApp& app : service->GetAppsIfLoaded()) {
+    for (const std::string& host : app.hosts) {
+      if (AppSwapUrlMatchesPattern(url, host)) {
+        return app;
+      }
+    }
+  }
+  return std::nullopt;
+}
+
+bool IsAppSwapRoutedPage(Profile* profile, const GURL& url) {
+  return FindAppSwapAppForUrl(profile, url).has_value();
+}
