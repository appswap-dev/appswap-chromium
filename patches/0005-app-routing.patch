+// Copyright 2026 The AppSwap Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_APP_SWAP_APP_SWAP_URL_LOADER_FACTORY_H_
+#define CHROME_BROWSER_APP_SWAP_APP_SWAP_URL_LOADER_FACTORY_H_
+
+#include "base/memory/weak_ptr.h"
+#include "base/task/sequenced_task_runner.h"
+#include "mojo/public/cpp/bindings/pending_receiver.h"
+#include "mojo/public/cpp/bindings/pending_remote.h"
+#include "mojo/public/cpp/bindings/remote.h"
+#include "services/network/public/cpp/self_deleting_url_loader_factory.h"
+#include "services/network/public/cpp/url_loader_factory_builder.h"
+
+namespace content {
+class RenderFrameHost;
+class WebContents;
+}  // namespace content
+
+// A URLLoaderFactory interceptor that serves AppSwap-routed requests from disk
+// and forwards everything else to the wrapped network factory.
+class AppSwapProxyingURLLoaderFactory
+    : public network::SelfDeletingURLLoaderFactory {
+ public:
+  static void MaybeProxyRequest(content::RenderFrameHost* frame,
+                                network::URLLoaderFactoryBuilder& builder);
+
+  AppSwapProxyingURLLoaderFactory(
+      mojo::PendingReceiver<network::mojom::URLLoaderFactory> receiver,
+      mojo::PendingRemote<network::mojom::URLLoaderFactory> target_factory,
+      base::WeakPtr<content::WebContents> web_contents,
+      base::SelfDeletingPassKey pass_key);
+  AppSwapProxyingURLLoaderFactory(const AppSwapProxyingURLLoaderFactory&) =
+      delete;
+  AppSwapProxyingURLLoaderFactory& operator=(
+      const AppSwapProxyingURLLoaderFactory&) = delete;
+
+  // network::mojom::URLLoaderFactory:
+  void CreateLoaderAndStart(
+      mojo::PendingReceiver<network::mojom::URLLoader> loader,
+      int32_t request_id,
+      uint32_t options,
+      const network::ResourceRequest& request,
+      mojo::PendingRemote<network::mojom::URLLoaderClient> client,
+      const net::MutableNetworkTrafficAnnotationTag& traffic_annotation)
+      override;
+
+ private:
+  ~AppSwapProxyingURLLoaderFactory() override;
+
+  void OnTargetFactoryError();
+
+  mojo::Remote<network::mojom::URLLoaderFactory> target_factory_;
+  base::WeakPtr<content::WebContents> web_contents_;
+  scoped_refptr<base::SequencedTaskRunner> task_runner_;
+};
+
+#endif  // CHROME_BROWSER_APP_SWAP_APP_SWAP_URL_LOADER_FACTORY_H_
