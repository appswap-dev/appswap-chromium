+// Copyright 2026 The AppSwap Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_APP_SWAP_APP_SWAP_ROUTE_MATCHER_H_
+#define CHROME_BROWSER_APP_SWAP_APP_SWAP_ROUTE_MATCHER_H_
+
+#include <optional>
+#include <string>
+
+#include "chrome/browser/app_swap/app_swap_apps_service.h"
+#include "chrome/browser/app_swap/app_swap_route_group_service.h"
+
+class GURL;
+class Profile;
+
+// Returns whether `url` falls under `url_pattern`: same scheme/host/port, and
+// `url`'s path is equal to or nested under the pattern's path (so
+// "https://my-website.com" matches every path on that origin, while
+// "https://my-website.com/docs" matches "/docs" and "/docs/x" but not
+// "/docs-legacy"). Does not match across origins, e.g. a pattern of
+// "https://my-website.com" never matches "https://my-website.com.evil.com".
+bool AppSwapUrlMatchesPattern(const GURL& url, const std::string& url_pattern);
+
+// Finds the first app configured in `profile` whose `hosts` matches `url`, or
+// nullopt. Only consults already-loaded apps; see
+// AppSwapAppsService::GetAppsIfLoaded.
+//
+// Returns a copy rather than a pointer into the service's own vector on
+// purpose: that vector is reallocated by any Add/Update/Remove, so a
+// borrowed pointer is only valid until the next config mutation -- a trap
+// for any caller that holds the result across a task boundary.
+std::optional<AppSwapApp> FindAppSwapAppForUrl(Profile* profile,
+                                               const GURL& url);
+
+// For a `url_pattern` that AppSwapUrlMatchesPattern() has already matched
+// against `url` (see AppSwapRouteGroupRule), returns the URL to actually
+// request: `target` with the portion of `url`'s path beyond `url_pattern`'s
+// own path appended, plus `url`'s original query string. Behavior is
+// unspecified if `url_pattern` didn't actually match `url`.
+GURL ComputeAppSwapRewriteUrl(const GURL& url,
+                              const std::string& url_pattern,
+                              const std::string& target);
+
+// Finds the first rule in `group` whose pattern matches `url`, or nullopt.
+// `group` may be nullopt (e.g. no route group pinned for the requesting
+// tab), in which case this always returns nullopt -- no group pinned means
+// no rewriting, same as an explicit empty group.
+std::optional<AppSwapRouteGroupRule> FindAppSwapRouteGroupRuleForUrl(
+    const std::optional<AppSwapRouteGroup>& group,
+    const GURL& url);
+
+// Finds the route group with the given id configured in `profile`, or
+// nullopt. Only consults already-loaded groups; see
+// AppSwapRouteGroupService::GetRouteGroupsIfLoaded. Returns a copy, for the
+// same reason FindAppSwapAppForUrl() does.
+std::optional<AppSwapRouteGroup> FindAppSwapRouteGroupById(
+    Profile* profile,
+    const std::string& group_id);
+
+// Whether `url` is currently served by a configured AppSwap app (an npm
+// package swapped in for some other origin) in `profile`, regardless of
+// `url`'s own scheme.
+bool IsAppSwapRoutedPage(Profile* profile, const GURL& url);
+
+#endif  // CHROME_BROWSER_APP_SWAP_APP_SWAP_ROUTE_MATCHER_H_
