diff --git a/chrome/browser/app_swap/app_swap_apps_service.cc b/chrome/browser/app_swap/app_swap_apps_service.cc
new file mode 100644
index 0000000000000..99e49927a52f7
--- /dev/null
+++ b/chrome/browser/app_swap/app_swap_apps_service.cc
@@ -0,0 +1,213 @@
+// Copyright 2026 The AppSwap Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/app_swap/app_swap_apps_service.h"
+
+#include <optional>
+#include <string>
+#include <utility>
+
+#include "base/files/file_util.h"
+#include "base/functional/bind.h"
+#include "base/json/json_reader.h"
+#include "base/json/json_writer.h"
+#include "base/no_destructor.h"
+#include "base/path_service.h"
+#include "base/task/thread_pool.h"
+#include "base/uuid.h"
+#include "base/values.h"
+#include "chrome/common/chrome_paths.h"
+
+namespace {
+
+base::DictValue AppToDict(const AppSwapApp& app) {
+  base::DictValue dict;
+  dict.Set("id", app.id);
+  dict.Set("title", app.title);
+  dict.Set("package", app.package_name);
+  dict.Set("version", app.version);
+  dict.Set("registry", app.registry);
+  if (!app.token.empty()) {
+    dict.Set("token", app.token);
+  }
+  return dict;
+}
+
+std::optional<AppSwapApp> AppFromDict(const base::DictValue& dict) {
+  const std::string* id = dict.FindString("id");
+  const std::string* title = dict.FindString("title");
+  const std::string* package = dict.FindString("package");
+  const std::string* version = dict.FindString("version");
+  if (!id || !title || !package || !version) {
+    return std::nullopt;
+  }
+  AppSwapApp app;
+  app.id = *id;
+  app.title = *title;
+  app.package_name = *package;
+  app.version = *version;
+  if (const std::string* registry = dict.FindString("registry")) {
+    app.registry = *registry;
+  }
+  if (const std::string* token = dict.FindString("token")) {
+    app.token = *token;
+  }
+  return app;
+}
+
+// Reads and parses the config file. Runs on a MayBlock task runner.
+std::vector<AppSwapApp> ReadConfigFile(const base::FilePath& path) {
+  std::vector<AppSwapApp> apps;
+  std::string json;
+  if (!base::ReadFileToString(path, &json)) {
+    return apps;
+  }
+  std::optional<base::DictValue> parsed =
+      base::JSONReader::ReadDict(json, base::JSON_PARSE_CHROMIUM_EXTENSIONS);
+  if (!parsed) {
+    return apps;
+  }
+  const base::ListValue* apps_list = parsed->FindList("apps");
+  if (!apps_list) {
+    return apps;
+  }
+  for (size_t i = 0; i < apps_list->size(); ++i) {
+    const base::Value& value = (*apps_list)[i];
+    if (!value.is_dict()) {
+      continue;
+    }
+    if (std::optional<AppSwapApp> app = AppFromDict(value.GetDict())) {
+      apps.push_back(std::move(*app));
+    }
+  }
+  return apps;
+}
+
+}  // namespace
+
+AppSwapAppsService::AppSwapAppsService() = default;
+AppSwapAppsService::~AppSwapAppsService() = default;
+
+// static
+AppSwapAppsService* AppSwapAppsService::GetInstance() {
+  static base::NoDestructor<AppSwapAppsService> instance;
+  return instance.get();
+}
+
+base::FilePath AppSwapAppsService::ConfigPath() {
+  base::FilePath dir;
+  if (!base::PathService::Get(chrome::DIR_USER_DATA, &dir)) {
+    base::GetTempDir(&dir);
+  }
+  return dir.Append(FILE_PATH_LITERAL("AppSwap"))
+      .Append(FILE_PATH_LITERAL("apps.json"));
+}
+
+void AppSwapAppsService::GetApps(
+    base::OnceCallback<void(std::vector<AppSwapApp>)> callback) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+
+  if (loaded_) {
+    base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+        FROM_HERE, base::BindOnce(std::move(callback), apps_));
+    return;
+  }
+
+  pending_load_.push_back(base::BindOnce(
+      [](AppSwapAppsService* self,
+         base::OnceCallback<void(std::vector<AppSwapApp>)> callback) {
+        self->GetApps(std::move(callback));
+      },
+      base::Unretained(this), std::move(callback)));
+
+  if (loading_) {
+    return;
+  }
+  loading_ = true;
+
+  base::ThreadPool::PostTaskAndReplyWithResult(
+      FROM_HERE, {base::MayBlock(), base::TaskPriority::USER_VISIBLE},
+      base::BindOnce(&ReadConfigFile, ConfigPath()),
+      base::BindOnce(&AppSwapAppsService::OnConfigLoaded,
+                     base::Unretained(this)));
+}
+
+const std::vector<AppSwapApp>& AppSwapAppsService::GetAppsIfLoaded() const {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  static const base::NoDestructor<std::vector<AppSwapApp>> kEmpty;
+  return loaded_ ? apps_ : *kEmpty;
+}
+
+void AppSwapAppsService::OnConfigLoaded(std::vector<AppSwapApp> apps) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  apps_ = std::move(apps);
+  loaded_ = true;
+  loading_ = false;
+
+  std::vector<base::OnceClosure> pending = std::move(pending_load_);
+  pending_load_.clear();
+  for (base::OnceClosure& callback : pending) {
+    std::move(callback).Run();
+  }
+}
+
+void AppSwapAppsService::AddApp(AppSwapApp app) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  DCHECK(loaded_);
+  if (app.id.empty()) {
+    app.id = base::Uuid::GenerateRandomV4().AsLowercaseString();
+  }
+  apps_.push_back(std::move(app));
+  ScheduleSave();
+}
+
+void AppSwapAppsService::UpdateApp(AppSwapApp app) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  DCHECK(loaded_);
+  for (AppSwapApp& existing : apps_) {
+    if (existing.id == app.id) {
+      existing = std::move(app);
+      ScheduleSave();
+      return;
+    }
+  }
+}
+
+void AppSwapAppsService::RemoveApp(const std::string& id) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  DCHECK(loaded_);
+  for (auto it = apps_.begin(); it != apps_.end(); ++it) {
+    if (it->id == id) {
+      apps_.erase(it);
+      ScheduleSave();
+      return;
+    }
+  }
+}
+
+void AppSwapAppsService::ScheduleSave() {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+
+  base::DictValue root;
+  base::ListValue apps_list;
+  for (const AppSwapApp& app : apps_) {
+    apps_list.Append(AppToDict(app));
+  }
+  root.Set("apps", std::move(apps_list));
+
+  std::string json;
+  if (!base::JSONWriter::Write(root, &json)) {
+    return;
+  }
+
+  const base::FilePath path = ConfigPath();
+  base::ThreadPool::PostTask(
+      FROM_HERE, {base::MayBlock(), base::TaskPriority::BEST_EFFORT},
+      base::BindOnce(
+          [](base::FilePath path, std::string json) {
+            base::CreateDirectory(path.DirName());
+            base::WriteFile(path, json);
+          },
+          std::move(path), std::move(json)));
+}
