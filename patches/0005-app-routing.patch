+// Copyright 2026 The AppSwap Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/app_swap/app_swap_apps_ui.h"
+
+#include <memory>
+#include <string>
+
+#include "base/functional/bind.h"
+#include "base/memory/ref_counted_memory.h"
+#include "base/values.h"
+#include "chrome/browser/app_swap/app_swap_tab_state.h"
+#include "chrome/browser/profiles/profile.h"
+#include "content/public/browser/navigation_controller.h"
+#include "content/public/browser/web_contents.h"
+#include "content/public/browser/web_ui.h"
+#include "content/public/browser/web_ui_data_source.h"
+#include "content/public/browser/web_ui_message_handler.h"
+#include "content/public/common/url_constants.h"
+#include "services/network/public/mojom/content_security_policy.mojom.h"
+#include "url/gurl.h"
+
+namespace {
+
+constexpr char kAppsHtml[] = R"html(<!doctype html>
+<html>
+<head>
+<title>AppSwap Apps</title>
+<meta charset="utf-8">
+<style>
+  body { font-family: system-ui, sans-serif; margin: 2rem; }
+  h1 { font-size: 1.25rem; }
+  ul { list-style: none; padding: 0; }
+  li { margin: 0.5rem 0; }
+  a { color: #1a73e8; text-decoration: none; font-size: 1.1rem; }
+  .empty { color: #777; }
+</style>
+</head>
+<body>
+  <h1>Apps</h1>
+  <ul id="apps"></ul>
+  <script>
+    window.setApps = function(apps) {
+      const ul = document.getElementById('apps');
+      ul.replaceChildren();
+      if (!apps.length) {
+        const li = document.createElement('li');
+        li.className = 'empty';
+        li.textContent = 'No apps configured.';
+        ul.appendChild(li);
+        return;
+      }
+      for (const app of apps) {
+        const li = document.createElement('li');
+        const a = document.createElement('a');
+        a.href = app.url;
+        a.textContent = app.title || app.url;
+        a.addEventListener('click', (e) => {
+          e.preventDefault();
+          chrome.send('openApp', [app.url]);
+        });
+        li.appendChild(a);
+        ul.appendChild(li);
+      }
+    };
+    chrome.send('getApps');
+  </script>
+</body>
+</html>
+)html";
+
+class AppSwapAppsHandler : public content::WebUIMessageHandler {
+ public:
+  void RegisterMessages() override {
+    web_ui()->RegisterMessageCallback(
+        "getApps", base::BindRepeating(&AppSwapAppsHandler::HandleGetApps,
+                                       base::Unretained(this)));
+    web_ui()->RegisterMessageCallback(
+        "openApp", base::BindRepeating(&AppSwapAppsHandler::HandleOpenApp,
+                                       base::Unretained(this)));
+  }
+
+ private:
+  void HandleGetApps(const base::ListValue& args) {
+    AllowJavascript();
+
+    base::ListValue apps;
+    for (const AppSwapRoute& route : AppSwapTabState::GetGlobalRoutes()) {
+      base::DictValue app;
+      app.Set("url", route.url_prefix);
+      app.Set("title", GURL(route.url_prefix).host());
+      apps.Append(std::move(app));
+    }
+    CallJavascriptFunction("setApps", apps);
+  }
+
+  void HandleOpenApp(const base::ListValue& args) {
+    if (args.empty()) {
+      return;
+    }
+    const std::string* url = args[0].GetIfString();
+    if (!url || url->empty()) {
+      return;
+    }
+
+    content::WebContents* web_contents = web_ui()->GetWebContents();
+    if (!web_contents) {
+      return;
+    }
+
+    // Navigate this tab to the app; its URL is served by the AppSwap routes.
+    content::NavigationController::LoadURLParams load_params{GURL(*url)};
+    load_params.transition_type = ui::PAGE_TRANSITION_AUTO_TOPLEVEL;
+    web_contents->GetController().LoadURLWithParams(load_params);
+  }
+};
+
+}  // namespace
+
+AppSwapAppsUI::AppSwapAppsUI(content::WebUI* web_ui)
+    : content::WebUIController(web_ui) {
+  content::WebUIDataSource* source =
+      content::WebUIDataSource::CreateAndAdd(Profile::FromWebUI(web_ui),
+                                             "appswap-apps");
+  // Allow the inline script in the page.
+  source->OverrideContentSecurityPolicy(
+      network::mojom::CSPDirectiveName::ScriptSrc,
+      "script-src chrome://resources 'self' 'unsafe-inline';");
+  // Serve the single HTML document for the root URL (both "" and "/" paths).
+  source->SetRequestFilter(
+      base::BindRepeating(
+          [](const std::string& path) { return path.empty() || path == "/"; }),
+      base::BindRepeating(
+          [](const std::string& path,
+             content::WebUIDataSource::GotDataCallback callback) {
+            std::move(callback).Run(
+                base::MakeRefCounted<base::RefCountedString>(
+                    std::string(kAppsHtml)));
+          }));
+  web_ui->AddMessageHandler(std::make_unique<AppSwapAppsHandler>());
+}
+
+AppSwapAppsUI::~AppSwapAppsUI() = default;
+
+AppSwapAppsUIConfig::AppSwapAppsUIConfig()
+    : content::DefaultWebUIConfig<AppSwapAppsUI>(content::kChromeUIScheme,
+                                                 "appswap-apps") {}
