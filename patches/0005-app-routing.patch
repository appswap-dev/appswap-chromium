new file mode 100644
index 0000000000000..07ae514bd8dc1
--- /dev/null
+++ b/chrome/browser/app_swap/app_swap_routes_service.cc
@@ -0,0 +1,201 @@
+// Copyright 2026 The AppSwap Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/app_swap/app_swap_routes_service.h"
+
+#include <optional>
+#include <string>
+#include <utility>
+
+#include "base/files/file_util.h"
+#include "base/functional/bind.h"
+#include "base/json/json_reader.h"
+#include "base/json/json_writer.h"
+#include "base/no_destructor.h"
+#include "base/path_service.h"
+#include "base/task/thread_pool.h"
+#include "base/uuid.h"
+#include "base/values.h"
+#include "chrome/common/chrome_paths.h"
+
+namespace {
+
+base::DictValue RouteToDict(const AppSwapRoute& route) {
+  base::DictValue dict;
+  dict.Set("id", route.id);
+  dict.Set("url_pattern", route.url_pattern);
+  dict.Set("app_id", route.app_id);
+  return dict;
+}
+
+std::optional<AppSwapRoute> RouteFromDict(const base::DictValue& dict) {
+  const std::string* id = dict.FindString("id");
+  const std::string* url_pattern = dict.FindString("url_pattern");
+  const std::string* app_id = dict.FindString("app_id");
+  if (!id || !url_pattern || !app_id) {
+    return std::nullopt;
+  }
+  AppSwapRoute route;
+  route.id = *id;
+  route.url_pattern = *url_pattern;
+  route.app_id = *app_id;
+  return route;
+}
+
+// Reads and parses the config file. Runs on a MayBlock task runner.
+std::vector<AppSwapRoute> ReadConfigFile(const base::FilePath& path) {
+  std::vector<AppSwapRoute> routes;
+  std::string json;
+  if (!base::ReadFileToString(path, &json)) {
+    return routes;
+  }
+  std::optional<base::DictValue> parsed =
+      base::JSONReader::ReadDict(json, base::JSON_PARSE_CHROMIUM_EXTENSIONS);
+  if (!parsed) {
+    return routes;
+  }
+  const base::ListValue* routes_list = parsed->FindList("routes");
+  if (!routes_list) {
+    return routes;
+  }
+  for (size_t i = 0; i < routes_list->size(); ++i) {
+    const base::Value& value = (*routes_list)[i];
+    if (!value.is_dict()) {
+      continue;
+    }
+    if (std::optional<AppSwapRoute> route = RouteFromDict(value.GetDict())) {
+      routes.push_back(std::move(*route));
+    }
+  }
+  return routes;
+}
+
+}  // namespace
+
+AppSwapRoutesService::AppSwapRoutesService() = default;
+AppSwapRoutesService::~AppSwapRoutesService() = default;
+
+// static
+AppSwapRoutesService* AppSwapRoutesService::GetInstance() {
+  static base::NoDestructor<AppSwapRoutesService> instance;
+  return instance.get();
+}
+
+base::FilePath AppSwapRoutesService::ConfigPath() {
+  base::FilePath dir;
+  if (!base::PathService::Get(chrome::DIR_USER_DATA, &dir)) {
+    base::GetTempDir(&dir);
+  }
+  return dir.Append(FILE_PATH_LITERAL("AppSwap"))
+      .Append(FILE_PATH_LITERAL("routes.json"));
+}
+
+void AppSwapRoutesService::GetRoutes(
+    base::OnceCallback<void(std::vector<AppSwapRoute>)> callback) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+
+  if (loaded_) {
+    base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+        FROM_HERE, base::BindOnce(std::move(callback), routes_));
+    return;
+  }
+
+  pending_load_.push_back(base::BindOnce(
+      [](AppSwapRoutesService* self,
+         base::OnceCallback<void(std::vector<AppSwapRoute>)> callback) {
+        self->GetRoutes(std::move(callback));
+      },
+      base::Unretained(this), std::move(callback)));
+
+  if (loading_) {
+    return;
+  }
+  loading_ = true;
+
+  base::ThreadPool::PostTaskAndReplyWithResult(
+      FROM_HERE, {base::MayBlock(), base::TaskPriority::USER_VISIBLE},
+      base::BindOnce(&ReadConfigFile, ConfigPath()),
+      base::BindOnce(&AppSwapRoutesService::OnConfigLoaded,
+                     base::Unretained(this)));
+}
+
+const std::vector<AppSwapRoute>& AppSwapRoutesService::GetRoutesIfLoaded()
+    const {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  static const base::NoDestructor<std::vector<AppSwapRoute>> kEmpty;
+  return loaded_ ? routes_ : *kEmpty;
+}
+
+void AppSwapRoutesService::OnConfigLoaded(std::vector<AppSwapRoute> routes) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  routes_ = std::move(routes);
+  loaded_ = true;
+  loading_ = false;
+
+  std::vector<base::OnceClosure> pending = std::move(pending_load_);
+  pending_load_.clear();
+  for (base::OnceClosure& callback : pending) {
+    std::move(callback).Run();
+  }
+}
+
+void AppSwapRoutesService::AddRoute(AppSwapRoute route) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  DCHECK(loaded_);
+  if (route.id.empty()) {
+    route.id = base::Uuid::GenerateRandomV4().AsLowercaseString();
+  }
+  routes_.push_back(std::move(route));
+  ScheduleSave();
+}
+
+void AppSwapRoutesService::UpdateRoute(AppSwapRoute route) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  DCHECK(loaded_);
+  for (AppSwapRoute& existing : routes_) {
+    if (existing.id == route.id) {
+      existing = std::move(route);
+      ScheduleSave();
+      return;
+    }
+  }
+}
+
+void AppSwapRoutesService::RemoveRoute(const std::string& id) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  DCHECK(loaded_);
+  for (auto it = routes_.begin(); it != routes_.end(); ++it) {
+    if (it->id == id) {
+      routes_.erase(it);
+      ScheduleSave();
+      return;
+    }
+  }
+}
+
+void AppSwapRoutesService::ScheduleSave() {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+
+  base::DictValue root;
+  base::ListValue routes_list;
+  for (const AppSwapRoute& route : routes_) {
+    routes_list.Append(RouteToDict(route));
+  }
+  root.Set("routes", std::move(routes_list));
+
+  std::string json;
+  if (!base::JSONWriter::Write(root, &json)) {
+    return;
+  }
+
+  const base::FilePath path = ConfigPath();
+  base::ThreadPool::PostTask(
+      FROM_HERE, {base::MayBlock(), base::TaskPriority::BEST_EFFORT},
+      base::BindOnce(
+          [](base::FilePath path, std::string json) {
+            base::CreateDirectory(path.DirName());
+            base::WriteFile(path, json);
+          },
+          std::move(path), std::move(json)));
+}
