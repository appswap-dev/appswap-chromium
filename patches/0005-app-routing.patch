+AppSwapArtifactProvider::AppSwapArtifactProvider() = default;
+AppSwapArtifactProvider::~AppSwapArtifactProvider() = default;
+
+// static
+AppSwapArtifactProvider* AppSwapArtifactProvider::GetInstance() {
+  static base::NoDestructor<AppSwapArtifactProvider> instance;
+  return instance.get();
+}
+
+// static
+bool AppSwapArtifactProvider::IsExactVersion(const std::string& version) {
+  size_t i = 0;
+  if (!version.empty() && (version[0] == 'v' || version[0] == 'V')) {
+    i = 1;
+  }
+  return i < version.size() && version[i] >= '0' && version[i] <= '9';
+}
+
+std::optional<std::string> AppSwapArtifactProvider::GetResolvedVersionIfCached(
+    const AppSwapSource& source) const {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  auto it = cache_.find(Key(source));
+  if (it == cache_.end()) {
+    return std::nullopt;
+  }
+  return it->second.BaseName().AsUTF8Unsafe();
+}
+
+void AppSwapArtifactProvider::CheckForNewerVersion(
+    const AppSwapSource& source,
+    base::OnceCallback<void(std::optional<std::string>)> callback) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  FetchMetadata(
+      source, &loaders_for_checks_,
+      base::BindOnce(
+          [](base::OnceCallback<void(std::optional<std::string>)> callback,
+             std::string version, std::string error) {
+            std::move(callback).Run(
+                error.empty() ? std::optional<std::string>(std::move(version))
+                             : std::nullopt);
+          },
+          std::move(callback)));
+}
+
+void AppSwapArtifactProvider::InvalidateCache(const AppSwapSource& source) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  cache_.erase(Key(source));
+}
+
+void AppSwapArtifactProvider::GetOrDownload(
+    const AppSwapSource& source,
+    base::OnceCallback<void(base::FilePath)> callback) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  const std::string key = Key(source);
+
+  auto cache_it = cache_.find(key);
+  if (cache_it != cache_.end()) {
+    base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+        FROM_HERE, base::BindOnce(std::move(callback), cache_it->second));
+    return;
+  }
+
+  auto& pending = pending_[key];
+  pending.push_back(std::move(callback));
+  if (pending.size() > 1) {
+    return;  // Already resolving/downloading this source.
+  }
+
+  if (IsExactVersion(source.version)) {
+    DownloadTarball(source, source.version, TarballUrl(source, source.version),
+                    base::BindOnce(&AppSwapArtifactProvider::Finish,
+                                   base::Unretained(this), source));
+  } else {
+    FetchMetadata(
+        source, &loaders_,
+        base::BindOnce(
+            [](AppSwapArtifactProvider* self, const AppSwapSource& source,
+               std::string version, std::string error) {
+              if (!error.empty()) {
+                self->Finish(source, base::FilePath());
+                return;
+              }
+              self->DownloadTarball(
+                  source, version, TarballUrl(source, version),
+                  base::BindOnce(&AppSwapArtifactProvider::Finish,
+                                 base::Unretained(self), source));
+            },
+            base::Unretained(this), source));
+  }
+}
+
+void AppSwapArtifactProvider::EnsureFreshThenGetOrDownload(
+    const AppSwapSource& source,
+    base::OnceCallback<void(base::FilePath)> callback) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  if (IsExactVersion(source.version)) {
+    GetOrDownload(source, std::move(callback));
+    return;
+  }
+  CheckForNewerVersion(
+      source, base::BindOnce(
+                  [](AppSwapArtifactProvider* self, AppSwapSource source,
+                     base::OnceCallback<void(base::FilePath)> callback,
+                     std::optional<std::string> registry_version) {
+                    if (registry_version) {
+                      std::optional<std::string> cached =
+                          self->GetResolvedVersionIfCached(source);
+                      if (!cached || *cached != *registry_version) {
+                        self->InvalidateCache(source);
+                      }
+                    }
+                    self->GetOrDownload(source, std::move(callback));
+                  },
+                  base::Unretained(this), source, std::move(callback)));
+}
+
+AppSwapPackageMetadata::AppSwapPackageMetadata() = default;
+AppSwapPackageMetadata::AppSwapPackageMetadata(
+    const AppSwapPackageMetadata&) = default;
+AppSwapPackageMetadata& AppSwapPackageMetadata::operator=(
+    const AppSwapPackageMetadata&) = default;
+AppSwapPackageMetadata::~AppSwapPackageMetadata() = default;
+
+void AppSwapArtifactProvider::FetchPackageMetadata(
+    const AppSwapSource& source,
+    base::OnceCallback<void(std::optional<AppSwapPackageMetadata>)>
+        callback) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+
+  auto resource_request = std::make_unique<network::ResourceRequest>();
+  resource_request->url = GURL(MetadataUrl(source));
+  resource_request->method = net::HttpRequestHeaders::kGetMethod;
+  resource_request->headers.SetHeader(net::HttpRequestHeaders::kAccept,
+                                      "application/json");
+  if (!source.token.empty()) {
+    resource_request->headers.SetHeader(net::HttpRequestHeaders::kAuthorization,
+                                        base::StrCat({"Bearer ", source.token}));
+  }
+
+  scoped_refptr<network::SharedURLLoaderFactory> factory =
+      SystemNetworkContextManager::GetInstance()->GetSharedURLLoaderFactory();
+
+  auto loader =
+      network::SimpleURLLoader::Create(std::move(resource_request),
+                                       kArtifactTrafficAnnotation);
+  network::SimpleURLLoader* raw_loader = loader.get();
+  const std::string key = Key(source);
+  metadata_query_loaders_[key] = std::move(loader);
+
+  raw_loader->DownloadToStringOfUnboundedSizeUntilCrashAndDie(
+      factory.get(),
+      base::BindOnce(
+          [](AppSwapArtifactProvider* self, std::string key,
+             base::OnceCallback<void(std::optional<AppSwapPackageMetadata>)>
+                 callback,
+             std::optional<std::string> body) {
+            self->metadata_query_loaders_.erase(key);
+            if (!body) {
+              std::move(callback).Run(std::nullopt);
+              return;
+            }
+            std::optional<base::Value> parsed = base::JSONReader::Read(
+                *body, base::JSON_PARSE_CHROMIUM_EXTENSIONS);
+            if (!parsed || !parsed->is_dict()) {
+              std::move(callback).Run(std::nullopt);
+              return;
+            }
+            const base::DictValue& root = parsed->GetDict();
+            AppSwapPackageMetadata metadata;
+            if (const base::DictValue* dist_tags = root.FindDict("dist-tags")) {
+              for (const auto [tag, version] : *dist_tags) {
+                if (version.is_string()) {
+                  metadata.dist_tags[tag] = version.GetString();
+                }
+              }
+            }
+            if (const base::DictValue* versions = root.FindDict("versions")) {
+              for (const auto [version, unused] : *versions) {
+                metadata.versions.push_back(version);
+              }
+            }
+            if (metadata.versions.empty() && metadata.dist_tags.empty()) {
+              std::move(callback).Run(std::nullopt);
+              return;
+            }
+            std::move(callback).Run(std::move(metadata));
+          },
+          base::Unretained(this), key, std::move(callback)));
+}
+
+void AppSwapArtifactProvider::FetchMetadata(
+    const AppSwapSource& source,
+    std::map<std::string, std::unique_ptr<network::SimpleURLLoader>>*
+        loader_map,
+    base::OnceCallback<void(std::string /*version*/, std::string /*error*/)>
+        callback) {
+  auto resource_request = std::make_unique<network::ResourceRequest>();
+  resource_request->url = GURL(MetadataUrl(source));
+  resource_request->method = net::HttpRequestHeaders::kGetMethod;
+  resource_request->headers.SetHeader(net::HttpRequestHeaders::kAccept,
+                                      "application/json");
+  if (!source.token.empty()) {
+    resource_request->headers.SetHeader(net::HttpRequestHeaders::kAuthorization,
+                                        base::StrCat({"Bearer ", source.token}));
+  }
+
+  scoped_refptr<network::SharedURLLoaderFactory> factory =
+      SystemNetworkContextManager::GetInstance()->GetSharedURLLoaderFactory();
+
+  auto loader =
+      network::SimpleURLLoader::Create(std::move(resource_request),
+                                       kArtifactTrafficAnnotation);
+  network::SimpleURLLoader* raw_loader = loader.get();
+  (*loader_map)[Key(source)] = std::move(loader);
+
+  raw_loader->DownloadToStringOfUnboundedSizeUntilCrashAndDie(
+      factory.get(),
+      base::BindOnce(
+          [](std::map<std::string, std::unique_ptr<network::SimpleURLLoader>>*
+                 loader_map,
+             const AppSwapSource& source,
+             base::OnceCallback<void(std::string, std::string)> callback,
+             std::optional<std::string> body) {
+            loader_map->erase(Key(source));
+            if (!body) {
+              std::move(callback).Run(std::string(), "metadata download failed");
+              return;
+            }
+            std::optional<base::Value> parsed =
+                base::JSONReader::Read(*body, base::JSON_PARSE_CHROMIUM_EXTENSIONS);
+            if (!parsed || !parsed->is_dict()) {
+              std::move(callback).Run(std::string(), "invalid metadata JSON");
+              return;
+            }
+            const base::DictValue& root = parsed->GetDict();
+            const base::DictValue* dist_tags = root.FindDict("dist-tags");
+            const std::string* version =
+                dist_tags ? dist_tags->FindString(source.version) : nullptr;
+            if (!version) {
+              std::move(callback).Run(std::string(),
+                                      "dist-tag not found: " + source.version);
+              return;
+            }
+            std::move(callback).Run(*version, std::string());
+          },
+          loader_map, source, std::move(callback)));
+}
+
+void AppSwapArtifactProvider::DownloadTarball(
+    const AppSwapSource& source,
+    const std::string& version,
+    const std::string& tarball_url,
+    base::OnceCallback<void(base::FilePath)> callback) {
+  // Resolve the cache directory for this exact version.
+  base::FilePath apps_dir;
+  if (!base::PathService::Get(chrome::DIR_USER_DATA, &apps_dir)) {
+    base::GetTempDir(&apps_dir);
+  }
+  const base::FilePath target_dir =
+      apps_dir.AppendASCII("AppSwapApps")
+          .Append(base::FilePath::FromUTF8Unsafe(source.package_name))
+          .Append(base::FilePath::FromUTF8Unsafe(version));
+
+  auto resource_request = std::make_unique<network::ResourceRequest>();
+  resource_request->url = GURL(tarball_url);
+  resource_request->method = net::HttpRequestHeaders::kGetMethod;
+  if (!source.token.empty()) {
+    resource_request->headers.SetHeader(net::HttpRequestHeaders::kAuthorization,
+                                        base::StrCat({"Bearer ", source.token}));
+  }
+
+  scoped_refptr<network::SharedURLLoaderFactory> factory =
+      SystemNetworkContextManager::GetInstance()->GetSharedURLLoaderFactory();
+
+  auto loader =
+      network::SimpleURLLoader::Create(std::move(resource_request),
+                                       kArtifactTrafficAnnotation);
+  network::SimpleURLLoader* raw_loader = loader.get();
+  loaders_[Key(source)] = std::move(loader);
+
+  raw_loader->DownloadToStringOfUnboundedSizeUntilCrashAndDie(
+      factory.get(),
+      base::BindOnce(&AppSwapArtifactProvider::OnTarball, base::Unretained(this),
+                     source, version, target_dir, std::move(callback)));
+}
+
+void AppSwapArtifactProvider::OnTarball(
+    const AppSwapSource& source,
+    const std::string& version,
+    base::FilePath target_dir,
+    base::OnceCallback<void(base::FilePath)> callback,
+    std::optional<std::string> body) {
+  loaders_.erase(Key(source));
+  if (!body) {
+    std::move(callback).Run(base::FilePath());
+    return;
+  }
+
+  // Extract (gunzip + untar) on a MayBlock task runner.
+  base::ThreadPool::PostTaskAndReplyWithResult(
+      FROM_HERE, {base::MayBlock(), base::TaskPriority::USER_VISIBLE},
+      base::BindOnce(
+          [](std::string tgz, base::FilePath dir) {
+            if (base::PathExists(dir)) {
+              return true;  // Already extracted.
+            }
+            std::string tar;
+            if (!compression::GzipUncompress(tgz, &tar) ||
+                !base::CreateDirectory(dir) || !ExtractTar(tar, dir)) {
+              return false;
+            }
+            return true;
+          },
+          std::move(*body), target_dir),
+      base::BindOnce(
+          [](base::OnceCallback<void(base::FilePath)> callback,
+             base::FilePath target_dir, bool success) {
+            std::move(callback).Run(success ? target_dir : base::FilePath());
+          },
+          std::move(callback), target_dir));
+}
+
+void AppSwapArtifactProvider::Finish(const AppSwapSource& source,
+                                     base::FilePath dir) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  const std::string key = Key(source);
+
+  if (!dir.empty()) {
+    cache_[key] = dir;
+  }
+
+  auto it = pending_.find(key);
+  if (it != pending_.end()) {
+    std::vector<base::OnceCallback<void(base::FilePath)>> callbacks =
+        std::move(it->second);
+    pending_.erase(it);
+    for (auto& callback : callbacks) {
+      std::move(callback).Run(dir);
+    }
+  }
+}
diff --git a/chrome/browser/app_swap/app_swap_artifact_provider.h b/chrome/browser/app_swap/app_swap_artifact_provider.h
new file mode 100644
index 0000000000000..d1614cfc56443
--- /dev/null
+++ b/chrome/browser/app_swap/app_swap_artifact_provider.h
@@ -0,0 +1,158 @@
+// Copyright 2026 The AppSwap Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_APP_SWAP_APP_SWAP_ARTIFACT_PROVIDER_H_
+#define CHROME_BROWSER_APP_SWAP_APP_SWAP_ARTIFACT_PROVIDER_H_
+
+#include <map>
+#include <memory>
+#include <optional>
+#include <string>
+#include <vector>
+
+#include "base/files/file_path.h"
+#include "base/functional/callback.h"
+#include "base/sequence_checker.h"
+#include "chrome/browser/app_swap/app_swap_source.h"
+
+namespace network {
+class SimpleURLLoader;
+}  // namespace network
+
+// The full set of published dist-tags and versions for a package, used by the
+// version-picker UI to let the user choose among ALL available tags/versions
+// rather than just what a single AppSwapSource currently resolves to.
+struct AppSwapPackageMetadata {
+  AppSwapPackageMetadata();
+  AppSwapPackageMetadata(const AppSwapPackageMetadata&);
+  AppSwapPackageMetadata& operator=(const AppSwapPackageMetadata&);
+  ~AppSwapPackageMetadata();
+
+  std::vector<std::string> versions;              // All published versions.
+  std::map<std::string, std::string> dist_tags;   // tag -> version.
+};
+
+// Resolves npm app sources to a directory on disk, downloading and unpacking
+// the tarball on first use and caching the result.
+class AppSwapArtifactProvider {
+ public:
+  AppSwapArtifactProvider();
+  ~AppSwapArtifactProvider();
+
+  AppSwapArtifactProvider(const AppSwapArtifactProvider&) = delete;
+  AppSwapArtifactProvider& operator=(const AppSwapArtifactProvider&) = delete;
+
+  static AppSwapArtifactProvider* GetInstance();
+
+  // Asynchronously ensures the artifact for `source` is present and calls
+  // `callback` with its directory (empty on failure). Must be called on the UI
+  // thread; `callback` runs on the UI thread.
+  //
+  // For a dist-tag `source`, this trusts whatever is already cached under
+  // that tag -- it does not re-consult the registry once a tag has resolved
+  // once. Use EnsureFreshThenGetOrDownload() at points where staleness would
+  // actually be visible to the user (a navigation), not for every
+  // subresource of an already-loading page.
+  void GetOrDownload(const AppSwapSource& source,
+                     base::OnceCallback<void(base::FilePath)> callback);
+
+  // Same contract as GetOrDownload(), except for a dist-tag `source` it first
+  // asks the registry what the tag currently resolves to and, if that
+  // differs from what's cached, invalidates the cache so the download that
+  // follows fetches the current version instead of serving a stale one.
+  // Falls back to plain GetOrDownload() behavior (serve whatever's cached,
+  // or resolve for the first time) if the registry query itself fails, so a
+  // transient network hiccup degrades to the old behavior rather than
+  // failing the navigation. Intended for navigation-type requests (a new tab
+  // or a refresh) -- an exact-version `source` skips the registry query
+  // entirely, since there's no tag to have drifted.
+  void EnsureFreshThenGetOrDownload(
+      const AppSwapSource& source,
+      base::OnceCallback<void(base::FilePath)> callback);
+
+  // Returns the concrete version `source` resolved to (e.g. "1.1.0" for a
+  // `source.version` of "latest"), if its artifact has already been
+  // downloaded via GetOrDownload; nullopt otherwise.
+  std::optional<std::string> GetResolvedVersionIfCached(
+      const AppSwapSource& source) const;
+
+  // Asks the registry what `source.version` (a dist-tag) currently resolves
+  // to, without touching GetOrDownload's cache or download state -- a pure
+  // "what does the registry say right now" query, used to detect a newer
+  // version under a moving tag. Calls `callback` with nullopt on any
+  // network/parse error. Must be called on the UI thread.
+  void CheckForNewerVersion(
+      const AppSwapSource& source,
+      base::OnceCallback<void(std::optional<std::string> /*version*/)>
+          callback);
+
+  // Forgets the cached resolved directory for `source`, so a subsequent
+  // GetOrDownload() re-resolves and re-downloads instead of returning the
+  // stale directory. Call only when actually about to serve a newer version
+  // (e.g. after the user confirms an update reload) -- never speculatively.
+  void InvalidateCache(const AppSwapSource& source);
+
+  // Returns whether `version` looks like an exact version ("1.2.3",
+  // optionally "v"-prefixed) rather than a dist-tag ("latest", "beta", ...).
+  static bool IsExactVersion(const std::string& version);
+
+  // Fetches the full list of published dist-tags and versions for `source`'s
+  // package, ignoring `source.version` entirely -- used by the version-picker
+  // UI. Calls `callback` with nullopt on any network/parse error.
+  void FetchPackageMetadata(
+      const AppSwapSource& source,
+      base::OnceCallback<void(std::optional<AppSwapPackageMetadata>)>
+          callback);
+
+ private:
+  // `loader_map` is the map to keep the in-flight SimpleURLLoader alive in
+  // (and erase it from on completion) -- callers pick which one so an
+  // update-availability check can never cancel, or be cancelled by, a real
+  // GetOrDownload() resolution for the same "package@version" key sharing
+  // one map would.
+  void FetchMetadata(
+      const AppSwapSource& source,
+      std::map<std::string, std::unique_ptr<network::SimpleURLLoader>>*
+          loader_map,
+      base::OnceCallback<void(std::string /*version*/,
+                              std::string /*error*/)> callback);
+  void DownloadTarball(const AppSwapSource& source,
+                       const std::string& version,
+                       const std::string& tarball_url,
+                       base::OnceCallback<void(base::FilePath)> callback);
+  void OnTarball(const AppSwapSource& source,
+                 const std::string& version,
+                 base::FilePath target_dir,
+                 base::OnceCallback<void(base::FilePath)> callback,
+                 std::optional<std::string> body);
+  void Finish(const AppSwapSource& source, base::FilePath dir);
+
+  base::FilePath apps_dir_;
+
+  // Dedup: pending callbacks keyed by "package@version".
+  std::map<std::string, std::vector<base::OnceCallback<void(base::FilePath)>>>
+      pending_;
+
+  // Active downloads keyed by "package@version", to keep the loader alive.
+  std::map<std::string, std::unique_ptr<network::SimpleURLLoader>> loaders_;
+
+  // Active CheckForNewerVersion() requests, kept separate from `loaders_`
+  // for the same reason `metadata_query_loaders_` is kept separate below.
+  std::map<std::string, std::unique_ptr<network::SimpleURLLoader>>
+      loaders_for_checks_;
+
+  // Active FetchPackageMetadata() requests, kept separate from `loaders_` --
+  // sharing one map would let an unrelated in-flight request silently
+  // cancel (or be cancelled by) a real GetOrDownload() for the same
+  // "package@version" key.
+  std::map<std::string, std::unique_ptr<network::SimpleURLLoader>>
+      metadata_query_loaders_;
+
+  // In-memory cache of resolved directories keyed by "package@version".
+  std::map<std::string, base::FilePath> cache_;
+
+  SEQUENCE_CHECKER(sequence_checker_);
+};
+
+#endif  // CHROME_BROWSER_APP_SWAP_APP_SWAP_ARTIFACT_PROVIDER_H_
diff --git a/chrome/browser/app_swap/app_swap_route_matcher.cc b/chrome/browser/app_swap/app_swap_route_matcher.cc
