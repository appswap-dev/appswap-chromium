+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_APP_SWAP_APP_SWAP_ROUTES_SERVICE_H_
+#define CHROME_BROWSER_APP_SWAP_APP_SWAP_ROUTES_SERVICE_H_
+
+#include <string>
+#include <vector>
+
+#include "base/files/file_path.h"
+#include "base/functional/callback.h"
+#include "base/sequence_checker.h"
+
+// A configured route: requests whose URL matches `url_pattern` (an origin,
+// optionally with a path prefix) are served from the app identified by
+// `app_id` instead of the network.
+struct AppSwapRoute {
+  std::string id;           // GUID, generated on creation.
+  std::string url_pattern;  // e.g. "https://my-website.com" or
+                             // "https://my-website.com/docs"
+  std::string app_id;       // -> AppSwapApp.id
+};
+
+// Owns the persistent route configuration, stored as JSON in the user data
+// directory. Mirrors AppSwapAppsService: the file is read/written on a
+// background (MayBlock) task runner.
+class AppSwapRoutesService {
+ public:
+  AppSwapRoutesService();
+  ~AppSwapRoutesService();
+
+  AppSwapRoutesService(const AppSwapRoutesService&) = delete;
+  AppSwapRoutesService& operator=(const AppSwapRoutesService&) = delete;
+
+  static AppSwapRoutesService* GetInstance();
+
+  // Loads the config from disk (on first call) and invokes |callback| with
+  // the routes on the UI thread.
+  void GetRoutes(base::OnceCallback<void(std::vector<AppSwapRoute>)> callback);
+
+  // Returns the loaded routes synchronously, or an empty list if the config
+  // hasn't finished loading yet. See AppSwapAppsService::GetAppsIfLoaded for
+  // why this exists alongside GetRoutes().
+  const std::vector<AppSwapRoute>& GetRoutesIfLoaded() const;
+
+  // Mutations. Must only be called after the config has been loaded (i.e.
+  // after a GetRoutes callback has run). They update the in-memory list and
+  // schedule an asynchronous save.
+  void AddRoute(AppSwapRoute route);
+  void UpdateRoute(AppSwapRoute route);
+  void RemoveRoute(const std::string& id);
+
+ private:
+  void OnConfigLoaded(std::vector<AppSwapRoute> routes);
+  void ScheduleSave();
+
+  base::FilePath ConfigPath();
+
+  std::vector<AppSwapRoute> routes_;
+  bool loaded_ = false;
+  bool loading_ = false;
+  std::vector<base::OnceClosure> pending_load_;
+  SEQUENCE_CHECKER(sequence_checker_);
+};
+
+#endif  // CHROME_BROWSER_APP_SWAP_APP_SWAP_ROUTES_SERVICE_H_
