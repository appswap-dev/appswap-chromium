+}  // namespace
+
+// static
+void AppSwapProxyingURLLoaderFactory::MaybeProxyRequest(
+    content::BrowserContext* browser_context,
+    content::RenderFrameHost* frame,
+    network::URLLoaderFactoryBuilder& builder) {
+  // `frame` is null for factories not tied to a single frame -- notably
+  // service worker script fetches (URLLoaderFactoryType::kServiceWorkerScript,
+  // see ServiceWorkerContextWrapper::GetLoaderFactoryForUpdateCheck), which
+  // still need to go through rewrite-rule matching. The resulting
+  // GlobalRenderFrameHostId is simply invalid, and every frame_id_ use below
+  // already null-checks RenderFrameHost::FromID() (the same as a tab closing
+  // mid-request), so app-route serving degrades gracefully instead of
+  // matching. `browser_context` is passed separately (rather than derived
+  // from `frame`) because it's what's actually available at every call site,
+  // frame or not -- see ServiceWorkerContextWrapper's own call, which passes
+  // its own browser_context with a null frame.
+  content::GlobalRenderFrameHostId frame_id =
+      frame ? frame->GetGlobalId() : content::GlobalRenderFrameHostId();
+
+  // Kick off (or continue) loading the app/route-group configuration as
+  // early as possible, so it's likely ready by the time a request needs to
+  // be matched. Actual matching uses the synchronous *IfLoaded() accessors
+  // below rather than waiting on these callbacks, since a URLLoaderFactory
+  // can't block request dispatch on a file read; a request that races the
+  // very first load on a cold start simply falls through to the network,
+  // same as an unconfigured route.
+  Profile* profile = Profile::FromBrowserContext(browser_context);
+  AppSwapAppsService* apps_service =
+      AppSwapAppsServiceFactory::GetForProfile(profile);
+  AppSwapRouteGroupService* route_group_service =
+      AppSwapRouteGroupServiceFactory::GetForProfile(profile);
+  // Both factories only build an instance for regular profiles
+  // (ProfileKeyedServiceFactory's default ProfileSelections excludes
+  // System/Guest) -- e.g. the System Profile that ProfilePicker::Show()
+  // navigates internally hits this for its own WebUI resource fetches.
+  // AppSwap simply doesn't apply there: skip installing the proxying factory
+  // entirely rather than threading a null check through every downstream
+  // lookup (FindAppSwapAppForUrl/FindAppSwapRouteGroupById in
+  // CreateLoaderAndStart below both assume a valid service).
+  if (!apps_service || !route_group_service) {
+    return;
+  }
+  apps_service->GetApps(base::DoNothing());
+  route_group_service->GetRouteGroups(base::DoNothing());
+  AppSwapUpdateChecker::GetInstance()->EnsureStarted();
+
+  auto [receiver, remote] = builder.Append();
+  base::MakeSelfDeleting<AppSwapProxyingURLLoaderFactory>(
+      std::move(receiver), std::move(remote), browser_context, frame_id);
+}
+
+AppSwapProxyingURLLoaderFactory::AppSwapProxyingURLLoaderFactory(
+    mojo::PendingReceiver<network::mojom::URLLoaderFactory> receiver,
+    mojo::PendingRemote<network::mojom::URLLoaderFactory> target_factory,
+    content::BrowserContext* browser_context,
+    content::GlobalRenderFrameHostId frame_id,
+    base::SelfDeletingPassKey pass_key)
+    : network::SelfDeletingURLLoaderFactory(std::move(receiver), pass_key),
+      browser_context_(browser_context->GetWeakPtr()),
+      frame_id_(frame_id) {
+  target_factory_.Bind(std::move(target_factory));
+  target_factory_.set_disconnect_handler(base::BindOnce(
+      &AppSwapProxyingURLLoaderFactory::OnTargetFactoryError,
+      base::Unretained(this)));
+}
+
+AppSwapProxyingURLLoaderFactory::~AppSwapProxyingURLLoaderFactory() = default;
+
+void AppSwapProxyingURLLoaderFactory::OnTargetFactoryError() {
+  DisconnectReceiversAndDestroy();
+}
+
+void AppSwapProxyingURLLoaderFactory::CreateLoaderAndStart(
+    mojo::PendingReceiver<network::mojom::URLLoader> loader,
+    int32_t request_id,
+    uint32_t options,
+    const network::ResourceRequest& request,
+    mojo::PendingRemote<network::mojom::URLLoaderClient> client,
+    const net::MutableNetworkTrafficAnnotationTag& traffic_annotation) {
+  content::BrowserContext* browser_context = browser_context_.get();
+  if (!browser_context) {
+    // The Profile this factory belongs to has already been destroyed (its
+    // mojo disconnect is processed asynchronously, so this can outlive the
+    // Profile itself -- see the comment on browser_context_). Nothing left
+    // to resolve Apps/Route Groups against; just pass the request through.
+    target_factory_->CreateLoaderAndStart(std::move(loader), request_id,
+                                          options, request, std::move(client),
+                                          traffic_annotation);
+    return;
+  }
+  Profile* profile = Profile::FromBrowserContext(browser_context);
+
+  // Route Group rules are checked independently of, and before, apps -- they
+  // have no notion of "app" at all (see AppSwapRouteGroupRule), and apply to
+  // every HTTP method, not just GET/HEAD, since this is a URL-level proxy
+  // (e.g. an API prefix), not served file content. Which group applies (if
+  // any) is per-tab, not project-wide -- see AppSwapRouteGroupPinTabHelper.
+  content::RenderFrameHost* frame =
+      content::RenderFrameHost::FromID(frame_id_);
+  std::optional<AppSwapRouteGroup> pinned_group;
+  if (frame) {
+    if (content::WebContents* web_contents =
+            content::WebContents::FromRenderFrameHost(frame)) {
+      if (AppSwapRouteGroupPinTabHelper* pin_helper =
+              AppSwapRouteGroupPinTabHelper::FromWebContents(web_contents)) {
+        if (std::optional<std::string> group_id =
+                pin_helper->GetPinnedGroup()) {
+          pinned_group = FindAppSwapRouteGroupById(profile, *group_id);
+        }
+      }
+    }
+  }
+  if (std::optional<AppSwapRouteGroupRule> rule =
+          FindAppSwapRouteGroupRuleForUrl(pinned_group, request.url)) {
+    network::ResourceRequest rewritten_request = request;
+    rewritten_request.url = ComputeAppSwapRewriteUrl(
+        request.url, rule->url_pattern, rule->target);
+    // The site/isolation info on `request` describes the original URL (e.g.
+    // for a main-frame navigation, site_for_cookies is scoped to it). Since
+    // the actual bytes are now being fetched from a different origin, that
+    // info must be updated to match -- the network service DCHECKs that a
+    // main-frame navigation's site_for_cookies is same-site with the URL
+    // actually being fetched. This mirrors what happens on a real redirect.
+    url::Origin rewritten_origin = url::Origin::Create(rewritten_request.url);
+    rewritten_request.site_for_cookies =
+        net::SiteForCookies::FromUrl(rewritten_request.url);
+    if (rewritten_request.trusted_params) {
+      rewritten_request.trusted_params->isolation_info =
+          rewritten_request.trusted_params->isolation_info.CreateForRedirect(
+              rewritten_origin);
+    }
+    // Subresource requests (e.g. a font fetched in CORS mode) carry the
+    // page's own origin as `request_initiator`. Left pointing at the
+    // original origin, the network service sees a genuine cross-origin
+    // fetch to the rewritten URL and requires an Access-Control-Allow-Origin
+    // header the target server has no reason to send. Rewriting it to match
+    // the fetched origin makes the fetch same-origin from CORS's point of
+    // view, matching the site_for_cookies/isolation_info treatment above.
+    if (rewritten_request.request_initiator) {
+      rewritten_request.request_initiator = rewritten_origin;
+    }
+    // The renderer already computed `referrer` against the *original* URL
+    // (e.g. "https://my-shop.dev/") under the page's referrer policy. If the
+    // rewritten target has different security properties -- most commonly
+    // dropping from https to plain http, as a "localhost:5000" dev backend
+    // target typically does -- that already-computed referrer now violates
+    // the request's own policy for its *actual* destination (an https->http
+    // downgrade must omit the referrer entirely), and net::URLRequest
+    // cancels the request outright with ERR_BLOCKED_BY_CLIENT rather than
+    // send it (confirmed by testing). Clearing it is always policy-compliant
+    // regardless of policy, matching what a real cross-origin downgrade
+    // would send.
+    rewritten_request.referrer = GURL();
+    // The tab's own StoragePartition, not necessarily the profile's default
+    // one -- a tab pinned to an AppSwap Profile browses in a named
+    // partition, and its rewritten requests have to carry that partition's
+    // cookies rather than the default's, or switching AppSwap Profile would
+    // silently stop applying to anything a route group rewrites.
+    content::StoragePartition* partition =
+        frame ? frame->GetProcess()->GetStoragePartition()
+              : browser_context->GetDefaultStoragePartition();
+    mojo::MakeSelfOwnedReceiver(
+        std::make_unique<AppSwapRewriteProxyLoader>(
+            partition->GetURLLoaderFactoryForBrowserProcess(), request_id,
+            options, std::move(rewritten_request), std::move(client),
+            traffic_annotation),
+        std::move(loader));
+    return;
+  }
+
+  if (std::optional<AppSwapApp> app = FindAppSwapAppForUrl(profile, request.url)) {
+    // Only static GET/HEAD requests are served from disk; everything else
+    // falls through to the real network below.
+    if (request.method == net::HttpRequestHeaders::kGetMethod ||
+        request.method == net::HttpRequestHeaders::kHeadMethod) {
+      bool accepts_html = false;
+      if (const std::optional<std::string> accept =
+              request.headers.GetHeader(net::HttpRequestHeaders::kAccept);
+          accept && accept->find("text/html") != std::string::npos) {
+        accepts_html = true;
+      }
+
+      AppSwapSource source = app->ToSource();
+      if (frame) {
+        if (content::WebContents* web_contents =
+                content::WebContents::FromRenderFrameHost(frame)) {
+          // A click on the "registry unreachable" recovery page's list of
+          // cached versions (see BuildRegistryUnreachableHtml()) carries
+          // this query param -- pin the tab to it now, before the pin
+          // lookup right below, so it takes effect immediately for this
+          // very navigation rather than only on the next one. The address
+          // bar still briefly shows the full URL with this parameter while
+          // the navigation is in flight; overriding the pending entry's
+          // virtual URL here makes it settle on the clean version once the
+          // navigation commits, same trick chrome://newtab-style pages use
+          // to display a URL other than the one actually requested.
+          //
+          // This is the one place a *page-controlled* string reaches the
+          // artifact cache path, so it's validated here rather than only
+          // deeper down: any page served on a configured app host can link
+          // to this parameter, and an unchecked value like "1/../../.."
+          // would repoint the serve root outside the cache entirely. An
+          // invalid value is ignored (no pin, no virtual-URL rewrite), so
+          // the navigation just resolves normally.
+          if (std::string use_version;
+              net::GetValueForKeyInQuery(request.url, kAppSwapUseVersionQueryKey,
+                                         &use_version) &&
+              app_swap::IsValidVersionForPath(use_version)) {
+            AppSwapVersionPinTabHelper::GetOrCreateForWebContents(web_contents)
+                ->SetPinnedVersion(app->id, use_version);
+            if (content::NavigationEntry* entry =
+                    web_contents->GetController().GetPendingEntry()) {
+              entry->SetVirtualURL(net::AppendOrReplaceQueryParameter(
+                  request.url, kAppSwapUseVersionQueryKey, std::nullopt));
+            }
+          }
+          if (AppSwapVersionPinTabHelper* pin_helper =
+                  AppSwapVersionPinTabHelper::FromWebContents(web_contents)) {
+            if (std::optional<std::string> pinned_version =
+                    pin_helper->GetPinnedVersion(app->id)) {
+              source.version = *pinned_version;
+            }
+          }
+        }
+      }
+
+      // Only a navigation (not each subresource of an already-loading page)
+      // pays for a live "is this dist-tag still what I have cached" check --
+      // otherwise a single page load would fire one registry query per
+      // script/style/image it references. This is also what makes the
+      // Reload button's "Update" click just a plain reload: any refresh is a
+      // navigation, so it already re-resolves the tag here.
+      auto resolve_callback = base::BindOnce(
+          &ServeAfterResolve, source, request.url, accepts_html, frame_id_,
+          std::move(loader), std::move(client));
+      if (accepts_html) {
+        AppSwapArtifactProvider::GetInstance()->EnsureFreshThenGetOrDownload(
+            source, std::move(resolve_callback));
+      } else {
+        AppSwapArtifactProvider::GetInstance()->GetOrDownload(
+            source, std::move(resolve_callback));
+      }
+      return;
+    }
+  }
+
+  // Not handled; forward to the wrapped network factory.
+  target_factory_->CreateLoaderAndStart(std::move(loader), request_id, options,
+                                        request, std::move(client),
+                                        traffic_annotation);
+}
diff --git a/chrome/browser/app_swap/app_swap_url_loader_factory.h b/chrome/browser/app_swap/app_swap_url_loader_factory.h
new file mode 100644
index 0000000000000..fe601f5a4a79b
--- /dev/null
+++ b/chrome/browser/app_swap/app_swap_url_loader_factory.h
@@ -0,0 +1,85 @@
+// Copyright 2026 The AppSwap Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_APP_SWAP_APP_SWAP_URL_LOADER_FACTORY_H_
+#define CHROME_BROWSER_APP_SWAP_APP_SWAP_URL_LOADER_FACTORY_H_
+
+#include "base/memory/weak_ptr.h"
+#include "content/public/browser/global_routing_id.h"
+#include "mojo/public/cpp/bindings/pending_receiver.h"
+#include "mojo/public/cpp/bindings/pending_remote.h"
+#include "mojo/public/cpp/bindings/remote.h"
+#include "services/network/public/cpp/self_deleting_url_loader_factory.h"
+#include "services/network/public/cpp/url_loader_factory_builder.h"
+
+namespace content {
+class BrowserContext;
+class RenderFrameHost;
+}  // namespace content
+
+// A request for an AppSwap-routed URL carrying this query parameter pins
+// the tab to the given exact version and serves it directly (no registry
+// round-trip, since it must already be on disk to be named this way) --
+// used both by the "registry unreachable" recovery page's list of cached
+// versions and by the "Copy link to this version" action in Page Info, so
+// the resulting link is bookmarkable/shareable and reproduces the exact
+// version when opened later.
+inline constexpr char kAppSwapUseVersionQueryKey[] = "__appswap_use_version";
+
+// A URLLoaderFactory interceptor that serves AppSwap-routed requests from disk
+// and forwards everything else to the wrapped network factory.
+class AppSwapProxyingURLLoaderFactory
+    : public network::SelfDeletingURLLoaderFactory {
+ public:
+  static void MaybeProxyRequest(content::BrowserContext* browser_context,
+                                content::RenderFrameHost* frame,
+                                network::URLLoaderFactoryBuilder& builder);
+
+  AppSwapProxyingURLLoaderFactory(
+      mojo::PendingReceiver<network::mojom::URLLoaderFactory> receiver,
+      mojo::PendingRemote<network::mojom::URLLoaderFactory> target_factory,
+      content::BrowserContext* browser_context,
+      content::GlobalRenderFrameHostId frame_id,
+      base::SelfDeletingPassKey pass_key);
+  AppSwapProxyingURLLoaderFactory(const AppSwapProxyingURLLoaderFactory&) =
+      delete;
+  AppSwapProxyingURLLoaderFactory& operator=(
+      const AppSwapProxyingURLLoaderFactory&) = delete;
+
+  // network::mojom::URLLoaderFactory:
+  void CreateLoaderAndStart(
+      mojo::PendingReceiver<network::mojom::URLLoader> loader,
+      int32_t request_id,
+      uint32_t options,
+      const network::ResourceRequest& request,
+      mojo::PendingRemote<network::mojom::URLLoaderClient> client,
+      const net::MutableNetworkTrafficAnnotationTag& traffic_annotation)
+      override;
+
+ private:
+  ~AppSwapProxyingURLLoaderFactory() override;
+
+  void OnTargetFactoryError();
+
+  mojo::Remote<network::mojom::URLLoaderFactory> target_factory_;
+
+  // The Profile (== Project) this factory resolves Apps/Route Groups
+  // against. Held as a WeakPtr, not a raw pointer: this factory is
+  // self-deleting and only torn down when its mojo pipe disconnects, which
+  // is NOT guaranteed to happen before the owning Profile is destroyed --
+  // confirmed by a real crash (BackupRefPtr's dangling-pointer detector
+  // firing in this class's destructor) when closing the last window of one
+  // Profile while another Profile's window was still open. A raw_ptr member
+  // dangling across that reordering trips the safety check even if never
+  // dereferenced afterwards; a WeakPtr degrades safely to null instead.
+  const base::WeakPtr<content::BrowserContext> browser_context_;
+
+  // The frame this factory serves requests for. Looked up fresh (rather than
+  // held as a raw content::RenderFrameHost*) since a RenderFrameHost can
+  // outlive or be swapped independently of this factory's lifetime; an ID
+  // that no longer resolves just means "no per-tab override applies".
+  const content::GlobalRenderFrameHostId frame_id_;
+};
+
+#endif  // CHROME_BROWSER_APP_SWAP_APP_SWAP_URL_LOADER_FACTORY_H_
