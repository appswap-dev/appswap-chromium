diff --git a/chrome/browser/app_swap/app_swap_apps_service.cc b/chrome/browser/app_swap/app_swap_apps_service.cc
new file mode 100644
index 0000000000000..cee410ddf458c
--- /dev/null
+++ b/chrome/browser/app_swap/app_swap_apps_service.cc
@@ -0,0 +1,157 @@
+// Copyright 2026 The AppSwap Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/app_swap/app_swap_apps_service.h"
+
+#include <optional>
+#include <string>
+#include <utility>
+
+#include "base/functional/bind.h"
+#include "base/no_destructor.h"
+#include "base/uuid.h"
+#include "content/public/browser/browser_context.h"
+
+namespace {
+
+base::DictValue AppToDict(const AppSwapApp& app) {
+  base::DictValue dict;
+  dict.Set("id", app.id);
+  dict.Set("title", app.title);
+  dict.Set("package", app.package_name);
+  dict.Set("version", app.version);
+  dict.Set("registry", app.registry);
+  if (!app.token.empty()) {
+    dict.Set("token", app.token);
+  }
+  base::ListValue hosts_list;
+  for (const std::string& host : app.hosts) {
+    hosts_list.Append(host);
+  }
+  dict.Set("hosts", std::move(hosts_list));
+  return dict;
+}
+
+std::optional<AppSwapApp> AppFromDict(const base::DictValue& dict) {
+  const std::string* id = dict.FindString("id");
+  const std::string* title = dict.FindString("title");
+  const std::string* package = dict.FindString("package");
+  const std::string* version = dict.FindString("version");
+  if (!id || !title || !package || !version) {
+    return std::nullopt;
+  }
+  AppSwapApp app;
+  app.id = *id;
+  app.title = *title;
+  app.package_name = *package;
+  app.version = *version;
+  if (const std::string* registry = dict.FindString("registry")) {
+    app.registry = *registry;
+  }
+  if (const std::string* token = dict.FindString("token")) {
+    app.token = *token;
+  }
+  if (const base::ListValue* hosts_list = dict.FindList("hosts")) {
+    for (const base::Value& host : *hosts_list) {
+      if (const std::string* host_str = host.GetIfString()) {
+        app.hosts.push_back(*host_str);
+      }
+    }
+  }
+  return app;
+}
+
+}  // namespace
+
+AppSwapAppsService::AppSwapAppsService(content::BrowserContext* browser_context)
+    : AppSwapConfigStore(browser_context->GetPath(),
+                         FILE_PATH_LITERAL("apps.json")) {}
+AppSwapAppsService::~AppSwapAppsService() = default;
+
+void AppSwapAppsService::ParseConfig(const base::DictValue& dict) {
+  const base::ListValue* apps_list = dict.FindList("apps");
+  if (!apps_list) {
+    return;
+  }
+  for (const base::Value& value : *apps_list) {
+    if (!value.is_dict()) {
+      continue;
+    }
+    if (std::optional<AppSwapApp> app = AppFromDict(value.GetDict())) {
+      apps_.push_back(std::move(*app));
+    }
+  }
+}
+
+base::DictValue AppSwapAppsService::SerializeConfig() const {
+  base::DictValue root;
+  base::ListValue apps_list;
+  for (const AppSwapApp& app : apps_) {
+    apps_list.Append(AppToDict(app));
+  }
+  root.Set("apps", std::move(apps_list));
+  return root;
+}
+
+void AppSwapAppsService::GetApps(
+    base::OnceCallback<void(std::vector<AppSwapApp>)> callback) {
+  RunWhenLoaded(base::BindOnce(
+      [](AppSwapAppsService* self,
+         base::OnceCallback<void(std::vector<AppSwapApp>)> callback) {
+        std::move(callback).Run(self->apps_);
+      },
+      base::Unretained(this), std::move(callback)));
+}
+
+const std::vector<AppSwapApp>& AppSwapAppsService::GetAppsIfLoaded() const {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  static const base::NoDestructor<std::vector<AppSwapApp>> kEmpty;
+  return loaded() ? apps_ : *kEmpty;
+}
+
+void AppSwapAppsService::AddApp(AppSwapApp app) {
+  RunWhenLoaded(base::BindOnce(&AppSwapAppsService::AddAppNow,
+                               base::Unretained(this), std::move(app)));
+}
+
+void AppSwapAppsService::AddAppNow(AppSwapApp app) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  if (app.id.empty()) {
+    app.id = base::Uuid::GenerateRandomV4().AsLowercaseString();
+  }
+  apps_.push_back(std::move(app));
+  Save();
+}
+
+void AppSwapAppsService::UpdateApp(AppSwapApp app) {
+  RunWhenLoaded(base::BindOnce(&AppSwapAppsService::UpdateAppNow,
+                               base::Unretained(this), std::move(app)));
+}
+
+void AppSwapAppsService::UpdateAppNow(AppSwapApp app) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  for (AppSwapApp& existing : apps_) {
+    if (existing.id == app.id) {
+      existing = std::move(app);
+      Save();
+      return;
+    }
+  }
+}
+
+void AppSwapAppsService::RemoveApp(const std::string& id) {
+  RunWhenLoaded(base::BindOnce(&AppSwapAppsService::RemoveAppNow,
+                               base::Unretained(this), id));
+}
+
+void AppSwapAppsService::RemoveAppNow(const std::string& id) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  for (auto it = apps_.begin(); it != apps_.end(); ++it) {
+    if (it->id == id) {
+      apps_.erase(it);
+      Save();
+      return;
+    }
+  }
+}
