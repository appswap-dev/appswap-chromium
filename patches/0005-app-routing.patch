--- /dev/null
+++ b/chrome/browser/app_swap/app_swap_route_matcher.cc
@@ -0,0 +1,56 @@
+// Copyright 2026 The AppSwap Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/app_swap/app_swap_route_matcher.h"
+
+#include <string_view>
+
+#include "base/strings/string_util.h"
+#include "url/gurl.h"
+
+bool AppSwapUrlMatchesPattern(const GURL& url, const std::string& url_pattern) {
+  const GURL pattern_url(url_pattern);
+  if (!pattern_url.is_valid() || url.scheme() != pattern_url.scheme() ||
+      url.host() != pattern_url.host() ||
+      url.EffectiveIntPort() != pattern_url.EffectiveIntPort()) {
+    return false;
+  }
+
+  const std::string_view pattern_path = pattern_url.path();
+  if (pattern_path.empty() || pattern_path == "/") {
+    return true;
+  }
+  const std::string_view url_path = url.path();
+  if (!base::StartsWith(url_path, pattern_path)) {
+    return false;
+  }
+  // Require a path-segment boundary so "/docs" doesn't match "/docs-legacy".
+  return url_path.size() == pattern_path.size() || pattern_path.back() == '/' ||
+         url_path[pattern_path.size()] == '/';
+}
+
+const AppSwapRoute* FindAppSwapRouteForUrl(const GURL& url) {
+  for (const AppSwapRoute& route :
+       AppSwapRoutesService::GetInstance()->GetRoutesIfLoaded()) {
+    if (AppSwapUrlMatchesPattern(url, route.url_pattern)) {
+      return &route;
+    }
+  }
+  return nullptr;
+}
+
+const AppSwapApp* FindAppSwapAppById(const std::string& app_id) {
+  for (const AppSwapApp& app :
+       AppSwapAppsService::GetInstance()->GetAppsIfLoaded()) {
+    if (app.id == app_id) {
+      return &app;
+    }
+  }
+  return nullptr;
+}
+
+bool IsAppSwapRoutedPage(const GURL& url) {
+  const AppSwapRoute* route = FindAppSwapRouteForUrl(url);
+  return route && FindAppSwapAppById(route->app_id);
+}
