+constexpr net::NetworkTrafficAnnotationTag kArtifactTrafficAnnotation =
+    net::DefineNetworkTrafficAnnotation("appswap_artifact", R"(
+        semantics {
+          sender: "AppSwap Artifact Provider"
+          description:
+            "Downloads the SPA application artifact (npm tarball) that AppSwap "
+            "serves for a configured route."
+          trigger: "A user navigates to an app configured with an npm source."
+          data: "None beyond the request URL and optional registry credentials."
+          destination: OTHER
+        }
+        policy {
+          cookies_allowed: NO
+          setting: "This is an AppSwap feature with no separate setting."
+        })");
+
+std::string Key(const AppSwapSource& source) {
+  return source.package_name + "@" + source.version;
+}
+
+std::string TarballUrl(const AppSwapSource& source, const std::string& version) {
+  std::string basename = source.package_name;
+  const size_t slash = basename.find_last_of('/');
+  if (slash != std::string::npos) {
+    basename = basename.substr(slash + 1);
+  }
+  return base::StrCat({source.registry, "/", source.package_name, "/-/",
+                       basename, "-", version, ".tgz"});
+}
+
+std::string MetadataUrl(const AppSwapSource& source) {
+  std::string encoded;
+  for (const char c : source.package_name) {
+    if (c == '/') {
+      encoded += "%2F";
+    } else {
+      encoded += c;
+    }
+  }
+  return base::StrCat({source.registry, "/", encoded});
+}
+
+// Extracts a ustar-format tar archive into `dest_dir`. Returns false on error
+// (including any entry that would escape `dest_dir`).
+UNSAFE_BUFFERS(bool ExtractTar(const std::string& tar,
+                               const base::FilePath& dest_dir) {
+  constexpr size_t kBlockSize = 512;
+  size_t offset = 0;
+  while (offset + kBlockSize <= tar.size()) {
+    const char* header = tar.data() + offset;
+
+    // A zeroed header marks the end of the archive.
+    if (header[0] == '\0') {
+      return true;
+    }
+
+    std::string name(header, 100);
+    name = name.substr(0, name.find('\0'));
+    std::string prefix(header + 345, 155);
+    prefix = prefix.substr(0, prefix.find('\0'));
+    if (!prefix.empty()) {
+      name = prefix + "/" + name;
+    }
+    // npm tarballs store everything under a top-level "package/" directory.
+    const size_t first_slash = name.find('/');
+    if (first_slash != std::string::npos) {
+      name = name.substr(first_slash + 1);
+    }
+
+    std::string size_str(header + 124, 12);
+    size_str = size_str.substr(0, size_str.find_first_of(" \0"));
+    uint64_t size = 0;
+    if (!size_str.empty()) {
+      size = strtoull(size_str.c_str(), nullptr, 8);
+    }
+
+    const char typeflag = header[156];
+    offset += kBlockSize;
+
+    const uint64_t padded_size = (size + kBlockSize - 1) / kBlockSize * kBlockSize;
+    if (offset + padded_size > tar.size()) {
+      return false;
+    }
+
+    // Security: reject any entry that could escape the destination.
+    if (name.find("..") != std::string::npos) {
+      return false;
+    }
+
+    // The top-level directory entry itself carries no content to write.
+    if (name.empty()) {
+      offset += padded_size;
+      continue;
+    }
+
+    base::FilePath path = dest_dir.Append(base::FilePath::FromUTF8Unsafe(name));
+
+    if (typeflag == '5') {
+      // Directory.
+      if (!base::CreateDirectory(path)) {
+        return false;
+      }
+    } else if (typeflag == '0' || typeflag == '\0') {
+      // Regular file.
+      if (!base::CreateDirectory(path.DirName()) ||
+          !base::WriteFile(path, tar.substr(offset, size))) {
+        return false;
+      }
+    }
+    // Other types (symlink, hardlink, device) are skipped.
+
+    offset += padded_size;
+  }
+  return false;  // Truncated archive (no end marker).
+})
