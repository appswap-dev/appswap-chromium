+
+namespace {
+
+// The task runner file serving runs on (file I/O is blocking).
+scoped_refptr<base::SequencedTaskRunner> GetServeTaskRunner() {
+  static base::NoDestructor<scoped_refptr<base::SequencedTaskRunner>> runner(
+      base::ThreadPool::CreateSequencedTaskRunner(
+          {base::MayBlock(), base::TaskPriority::USER_VISIBLE,
+           base::TaskShutdownBehavior::SKIP_ON_SHUTDOWN}));
+  return *runner;
+}
+
+// Resolves a request URL path to a file on disk under `serve_dir`, applying
+// SPA fallback for navigations. Returns an empty path when nothing matches.
+base::FilePath ResolveFilePath(const base::FilePath& serve_dir,
+                               const std::string& path,
+                               bool accepts_html) {
+  std::string_view path_view(path);
+  if (path_view.empty() || path_view == "/") {
+    path_view = "index.html";
+  }
+
+  // Strip leading separators to make the path relative to serve_dir.
+  const size_t start = path_view.find_first_not_of('/');
+  const std::string_view relative_str =
+      (start == std::string_view::npos) ? std::string_view()
+                                        : path_view.substr(start);
+
+  // A URL path is percent-encoded; the filenames on disk are not. Without
+  // decoding, any asset whose name contains a space or a non-ASCII character
+  // (both perfectly ordinary in an npm package's build output) is requested
+  // as "my%20file.js" and never found. The "Safe" variant refuses input with
+  // an *encoded* path separator or control character, so no decoding step
+  // can manufacture a separator that the traversal check below then never
+  // sees; real separators arrive unencoded and are left to it.
+  std::string relative;
+  if (!base::UnescapeBinaryURLComponentSafe(
+          relative_str, /*fail_on_path_separators=*/true, &relative)) {
+    return base::FilePath();
+  }
+
+  // Reject any path that could escape the serve directory.
+  if (relative.find("..") != std::string::npos) {
+    return base::FilePath();
+  }
+
+  base::FilePath full =
+      serve_dir.Append(base::FilePath::FromUTF8Unsafe(relative))
+          .NormalizePathSeparators();
+
+  if (base::PathExists(full) && !base::DirectoryExists(full)) {
+    return full;
+  }
+
+  // SPA fallback: only for navigations (requests that accept HTML), never for
+  // missing asset subresources.
+  if (accepts_html) {
+    base::FilePath index = serve_dir.Append(FILE_PATH_LITERAL("index.html"));
+    if (base::PathExists(index)) {
+      return index;
+    }
+  }
+  return base::FilePath();
+}
+
+// Self-owned URLLoader that streams a single file from disk as the response.
+// Runs on a MayBlock task runner (file I/O is blocking).
+class AppSwapFileLoader : public network::mojom::URLLoader {
+ public:
+  static void CreateAndStart(
+      const base::FilePath& serve_dir,
+      GURL url,
+      bool accepts_html,
+      mojo::PendingReceiver<network::mojom::URLLoader> loader,
+      mojo::PendingRemote<network::mojom::URLLoaderClient> client) {
+    // Owns itself; deleted once both bindings are closed.
+    auto* file_loader = new AppSwapFileLoader();
+    file_loader->Start(serve_dir, std::move(url), accepts_html,
+                       std::move(loader), std::move(client));
+  }
+
+  AppSwapFileLoader(const AppSwapFileLoader&) = delete;
+  AppSwapFileLoader& operator=(const AppSwapFileLoader&) = delete;
+
+  // network::mojom::URLLoader:
+  void FollowRedirect(
+      network::HttpRequestHeadersUpdateParams /*headers_update_params*/,
+      const std::optional<GURL>& /*new_url*/) override {}
+  void SetPriority(net::RequestPriority /*priority*/,
+                   int32_t /*intra_priority_value*/) override {}
+
+ private:
+  AppSwapFileLoader() = default;
+  ~AppSwapFileLoader() override = default;
+
+  void Start(const base::FilePath& serve_dir,
+             GURL url,
+             bool accepts_html,
+             mojo::PendingReceiver<network::mojom::URLLoader> loader,
+             mojo::PendingRemote<network::mojom::URLLoaderClient> client) {
+    receiver_.Bind(std::move(loader));
+    receiver_.set_disconnect_handler(base::BindOnce(
+        &AppSwapFileLoader::OnMojoDisconnect, base::Unretained(this)));
+    client_.Bind(std::move(client));
+
+    base::FilePath file_path =
+        ResolveFilePath(serve_dir, std::string(url.path()), accepts_html);
+    if (file_path.empty()) {
+      OnClientComplete(net::ERR_FILE_NOT_FOUND);
+      return;
+    }
+
+    base::File::Info info;
+    if (!base::GetFileInfo(file_path, &info) || info.is_directory) {
+      OnClientComplete(net::ERR_FILE_NOT_FOUND);
+      return;
+    }
+
+    base::File file(file_path, base::File::FLAG_OPEN | base::File::FLAG_READ);
+    if (!file.IsValid()) {
+      OnClientComplete(net::ERR_FILE_NOT_FOUND);
+      return;
+    }
+
+    auto head = network::mojom::URLResponseHead::New();
+    head->response_type = network::mojom::FetchResponseType::kBasic;
+    head->headers =
+        base::MakeRefCounted<net::HttpResponseHeaders>("HTTP/1.1 200 OK");
+    std::string mime_type;
+    if (!net::GetMimeTypeFromFile(file_path, &mime_type)) {
+      mime_type = "application/octet-stream";
+    }
+    head->mime_type = mime_type;
+    head->headers->AddHeader(net::HttpRequestHeaders::kContentType, mime_type);
+    head->headers->AddHeader(net::HttpRequestHeaders::kContentLength,
+                             base::NumberToString(info.size));
+    // Without this, a URL's response can be reused from Blink's in-memory
+    // resource cache (shared by same-process, same-origin tabs -- e.g. two
+    // tabs on the same route that aren't isolated by an AppSwap Profile
+    // partition) even after a different app version is pinned/resolved for
+    // this request, silently serving the wrong version's bytes.
+    head->headers->AddHeader(net::HttpRequestHeaders::kCacheControl,
+                             "no-store");
+    head->content_length = info.size;
+    content_length_ = info.size;
+    // Headers are trusted (fetched by us and/or read from local disk), so
+    // parsing can happen from the browser process. Timing fields mirror what
+    // WebUIURLLoaderFactory sets for the same kind of fabricated response;
+    // without them, navigations served this way render fine but never signal
+    // the tab as finished loading.
+    head->parsed_headers =
+        network::PopulateParsedHeaders(head->headers.get(), url);
+    const base::TimeTicks now_ticks = base::TimeTicks::Now();
+    const base::Time now_time = base::Time::Now();
+    head->request_time = now_time;
+    head->request_start = now_ticks;
+    head->response_time = now_time;
+    head->response_start = now_ticks;
+    head->load_timing.request_start_time = now_time;
+    head->load_timing.request_start = now_ticks;
+    head->load_timing.receive_headers_start = now_ticks;
+    head->load_timing.receive_headers_end = now_ticks;
+
+    mojo::ScopedDataPipeProducerHandle producer_handle;
+    mojo::ScopedDataPipeConsumerHandle consumer_handle;
+    if (mojo::CreateDataPipe(/*options=*/nullptr, producer_handle,
+                             consumer_handle) != MOJO_RESULT_OK) {
+      OnClientComplete(net::ERR_FAILED);
+      return;
+    }
+
+    client_->OnReceiveResponse(std::move(head), std::move(consumer_handle),
+                               std::nullopt);
+
+    if (info.size == 0) {
+      OnClientComplete(net::OK);
+      return;
+    }
+
+    data_producer_ = std::make_unique<mojo::DataPipeProducer>(
+        std::move(producer_handle));
+    data_producer_->Write(
+        std::make_unique<mojo::FileDataSource>(std::move(file)),
+        base::BindOnce(&AppSwapFileLoader::OnFileWritten,
+                       base::Unretained(this)));
+  }
+
+  void OnFileWritten(MojoResult result) {
+    // mojo::DataPipeProducer keeps the producer handle open (in case more
+    // data is written later) rather than closing it when a write finishes.
+    // The peer only sees EOF on the pipe once the handle actually closes, so
+    // without this reset the renderer has all the bytes and renders
+    // correctly, but never considers the resource load finished.
+    data_producer_.reset();
+    OnClientComplete(result == MOJO_RESULT_OK ? net::OK : net::ERR_FAILED);
+  }
+
+  void OnClientComplete(net::Error error) {
+    network::URLLoaderCompletionStatus status(error);
+    if (error == net::OK) {
+      // Without these, the renderer streams and renders the body correctly
+      // but some completion-dependent bookkeeping (e.g. resource timing)
+      // never sees a matching byte count, matching what
+      // content::webui::SendData populates for the same kind of fabricated
+      // response.
+      const auto size = static_cast<uint64_t>(content_length_);
+      status.encoded_data_length = base::ByteSize(size);
+      status.encoded_body_length = base::ByteSize(size);
+      status.decoded_body_length = base::ByteSize(size);
+    }
+    client_->OnComplete(status);
+    client_.reset();
+    MaybeDeleteSelf();
+  }
+
+  void OnMojoDisconnect() {
+    data_producer_.reset();
+    receiver_.reset();
+    client_.reset();
+    MaybeDeleteSelf();
+  }
+
+  void MaybeDeleteSelf() {
+    if (!receiver_.is_bound() && !client_.is_bound()) {
+      delete this;
+    }
+  }
+
+  mojo::Receiver<network::mojom::URLLoader> receiver_{this};
+  mojo::Remote<network::mojom::URLLoaderClient> client_;
+  std::unique_ptr<mojo::DataPipeProducer> data_producer_;
+  int64_t content_length_ = 0;
+};
+
+// Posts a file-serving request for `dir` to the serve task runner.
+void ServeFromDir(const base::FilePath& dir,
+                  GURL url,
+                  bool accepts_html,
+                  mojo::PendingReceiver<network::mojom::URLLoader> loader,
+                  mojo::PendingRemote<network::mojom::URLLoaderClient> client) {
+  GetServeTaskRunner()->PostTask(
+      FROM_HERE,
+      base::BindOnce(&AppSwapFileLoader::CreateAndStart, dir, std::move(url),
+                     accepts_html, std::move(loader), std::move(client)));
+}
+
+// A URLLoader+URLLoaderClient pair for a matched AppSwapRewriteRule: fetches
+// `request_` (the rewritten URL) via a cloned real network factory and
+// relays the response back to the original client verbatim -- a proper
+// reverse proxy at the network level, so the renderer/DevTools only ever
+// see ONE request/response, for the *original* URL, never the rewritten
+// one. (An earlier attempt issued a real HTTP redirect to the rewritten URL
+// instead -- necessary to avoid a site-isolation cross-origin rejection
+// when just swapping network::ResourceRequest::url and forwarding directly,
+// since a navigation's renderer process/SiteInstance is already selected
+// based on the *original* URL before this factory ever runs -- but a
+// redirect inherently surfaces the rewritten URL as a second, visible
+// request, which isn't what a reverse proxy is supposed to look like. This
+// class avoids that: it makes its own outbound request from the browser
+// process, using a trusted browser-process factory rather than a clone of
+// the frame's own scoped `target_factory_` -- so there's neither a
+// renderer-visible cross-origin hop for site isolation to react to, nor any
+// dependency on whatever trust boundaries (NetworkIsolationKey, CORS
+// assumptions, etc.) that per-frame factory carries for the *original*
+// URL's origin, which have no reason to permit fetching a completely
+// different origin (confirmed by testing: cloning and using
+// `target_factory_` for the rewritten URL fails outright).
+//
+// `factory` is the *tab's own StoragePartition's* browser-process factory,
+// so the rewritten request carries the profile's cookies for the target
+// origin. It deliberately isn't SystemNetworkContextManager's factory (what
+// AppSwapArtifactProvider's registry fetches use, and what this class used
+// to use): that network context has no cookie jar at all, which silently
+// turned every rewritten request to an authenticated dev backend into an
+// anonymous one -- exactly the case route groups exist to serve.
+class AppSwapRewriteProxyLoader : public network::mojom::URLLoader,
+                                  public network::mojom::URLLoaderClient {
+ public:
+  AppSwapRewriteProxyLoader(
+      scoped_refptr<network::SharedURLLoaderFactory> factory,
+      int32_t request_id,
+      uint32_t options,
+      network::ResourceRequest rewritten_request,
+      mojo::PendingRemote<network::mojom::URLLoaderClient> client,
+      const net::MutableNetworkTrafficAnnotationTag& traffic_annotation)
+      : client_(std::move(client)),
+        request_id_(request_id),
+        // kURLLoadOptionBlockLocalRequest is a safety net the renderer sets
+        // on ordinary cross-origin fetches to stop a public-looking page
+        // from reaching a local/private address (Local Network Access). It
+        // must not carry over here: after the rewrite, this fetch's actual
+        // target is often a local address on purpose (e.g. a route group
+        // pointing at localhost for a dev backend), issued by this trusted
+        // browser-process proxy rather than the renderer directly -- kept
+        // set, every such rewrite would fail with ERR_BLOCKED_BY_CLIENT
+        // (confirmed by testing).
+        options_(options & ~network::mojom::kURLLoadOptionBlockLocalRequest),
+        request_(std::move(rewritten_request)),
+        traffic_annotation_(traffic_annotation) {
+    mojo::PendingRemote<network::mojom::URLLoaderClient> client_remote;
+    client_receiver_.Bind(client_remote.InitWithNewPipeAndPassReceiver());
+    factory->CreateLoaderAndStart(
+        target_loader_.BindNewPipeAndPassReceiver(), request_id_, options_,
+        request_, std::move(client_remote), traffic_annotation_);
+  }
+
+  AppSwapRewriteProxyLoader(const AppSwapRewriteProxyLoader&) = delete;
+  AppSwapRewriteProxyLoader& operator=(const AppSwapRewriteProxyLoader&) =
+      delete;
+
+  ~AppSwapRewriteProxyLoader() override = default;
+
+  // network::mojom::URLLoader (downstream: what the original caller, e.g.
+  // the navigation loader, controls):
+  void FollowRedirect(
+      network::HttpRequestHeadersUpdateParams headers_update_params,
+      const std::optional<GURL>& new_url) override {
+    if (target_loader_) {
+      target_loader_->FollowRedirect(std::move(headers_update_params), new_url);
+    }
+  }
+  void SetPriority(net::RequestPriority priority,
+                   int32_t intra_priority_value) override {
+    if (target_loader_) {
+      target_loader_->SetPriority(priority, intra_priority_value);
+    }
+  }
+
+  // network::mojom::URLLoaderClient (upstream: what the cloned real
+  // factory's loader for the rewritten URL calls back into):
+  void OnReceiveEarlyHints(network::mojom::EarlyHintsPtr early_hints) override {
+    client_->OnReceiveEarlyHints(std::move(early_hints));
+  }
+  void OnReceiveResponse(
+      network::mojom::URLResponseHeadPtr head,
+      mojo::ScopedDataPipeConsumerHandle body,
+      std::optional<mojo_base::BigBuffer> cached_metadata) override {
+    client_->OnReceiveResponse(std::move(head), std::move(body),
+                               std::move(cached_metadata));
+  }
+  void OnReceiveRedirect(const net::RedirectInfo& redirect_info,
+                         network::mojom::URLResponseHeadPtr head) override {
+    // The rewritten target itself redirected somewhere; relay it as-is
+    // rather than trying to keep it hidden behind the original URL -- doing
+    // that properly would mean rewriting the Location header's origin too,
+    // which needs its own AppSwapRewriteRule match against the redirect
+    // target to be correct, not a blind rewrite of whatever it points to.
+    client_->OnReceiveRedirect(redirect_info, std::move(head));
+  }
+  void OnUploadProgress(int64_t current_position,
+                        int64_t total_size,
+                        base::OnceCallback<void()> callback) override {
+    client_->OnUploadProgress(current_position, total_size,
+                              std::move(callback));
+  }
+  void OnTransferSizeUpdated(int32_t transfer_size_diff) override {
+    client_->OnTransferSizeUpdated(transfer_size_diff);
+  }
+  void OnComplete(const network::URLLoaderCompletionStatus& status) override {
+    client_->OnComplete(status);
+  }
+
+ private:
+  mojo::Remote<network::mojom::URLLoaderClient> client_;
+  int32_t request_id_;
+  uint32_t options_;
+  network::ResourceRequest request_;
+  net::MutableNetworkTrafficAnnotationTag traffic_annotation_;
+
+  mojo::Receiver<network::mojom::URLLoaderClient> client_receiver_{this};
+  mojo::Remote<network::mojom::URLLoader> target_loader_;
+};
+
+// Self-owned URLLoader that streams an in-memory string as the response --
+// used only for the small generated "registry unreachable" recovery page,
+// never for real app content (which always comes from disk via
+// AppSwapFileLoader above). Unlike that class, this doesn't need the serve
+// task runner: there's no blocking file I/O involved.
+class AppSwapStringLoader : public network::mojom::URLLoader {
+ public:
+  static void CreateAndStart(
+      std::string body,
+      GURL url,
+      mojo::PendingReceiver<network::mojom::URLLoader> loader,
+      mojo::PendingRemote<network::mojom::URLLoaderClient> client) {
+    // Owns itself; deleted once both bindings are closed.
+    auto* string_loader = new AppSwapStringLoader();
+    string_loader->Start(std::move(body), std::move(url), std::move(loader),
+                         std::move(client));
+  }
+
+  AppSwapStringLoader(const AppSwapStringLoader&) = delete;
+  AppSwapStringLoader& operator=(const AppSwapStringLoader&) = delete;
+
+  // network::mojom::URLLoader:
+  void FollowRedirect(
+      network::HttpRequestHeadersUpdateParams /*headers_update_params*/,
+      const std::optional<GURL>& /*new_url*/) override {}
+  void SetPriority(net::RequestPriority /*priority*/,
+                   int32_t /*intra_priority_value*/) override {}
+
+ private:
+  AppSwapStringLoader() = default;
+  ~AppSwapStringLoader() override = default;
+
+  void Start(std::string body,
+             GURL url,
+             mojo::PendingReceiver<network::mojom::URLLoader> loader,
+             mojo::PendingRemote<network::mojom::URLLoaderClient> client) {
+    receiver_.Bind(std::move(loader));
+    receiver_.set_disconnect_handler(base::BindOnce(
+        &AppSwapStringLoader::OnMojoDisconnect, base::Unretained(this)));
+    client_.Bind(std::move(client));
+
+    auto head = network::mojom::URLResponseHead::New();
+    head->response_type = network::mojom::FetchResponseType::kBasic;
+    head->headers =
+        base::MakeRefCounted<net::HttpResponseHeaders>("HTTP/1.1 200 OK");
+    head->mime_type = "text/html";
+    head->headers->AddHeader(net::HttpRequestHeaders::kContentType,
+                             "text/html; charset=utf-8");
+    head->headers->AddHeader(net::HttpRequestHeaders::kContentLength,
+                             base::NumberToString(body.size()));
+    head->headers->AddHeader(net::HttpRequestHeaders::kCacheControl,
+                             "no-store");
+    head->content_length = body.size();
+    content_length_ = static_cast<int64_t>(body.size());
+    head->parsed_headers =
+        network::PopulateParsedHeaders(head->headers.get(), url);
+    const base::TimeTicks now_ticks = base::TimeTicks::Now();
+    const base::Time now_time = base::Time::Now();
+    head->request_time = now_time;
+    head->request_start = now_ticks;
+    head->response_time = now_time;
+    head->response_start = now_ticks;
+    head->load_timing.request_start_time = now_time;
+    head->load_timing.request_start = now_ticks;
+    head->load_timing.receive_headers_start = now_ticks;
+    head->load_timing.receive_headers_end = now_ticks;
+
+    mojo::ScopedDataPipeProducerHandle producer_handle;
+    mojo::ScopedDataPipeConsumerHandle consumer_handle;
+    if (mojo::CreateDataPipe(/*options=*/nullptr, producer_handle,
+                             consumer_handle) != MOJO_RESULT_OK) {
+      OnClientComplete(net::ERR_FAILED);
+      return;
+    }
+
+    client_->OnReceiveResponse(std::move(head), std::move(consumer_handle),
+                               std::nullopt);
+
+    if (body.empty()) {
+      OnClientComplete(net::OK);
+      return;
+    }
+
+    data_producer_ = std::make_unique<mojo::DataPipeProducer>(
+        std::move(producer_handle));
+    data_producer_->Write(
+        std::make_unique<mojo::StringDataSource>(
+            base::span(body),
+            mojo::StringDataSource::AsyncWritingMode::
+                STRING_MAY_BE_INVALIDATED_BEFORE_COMPLETION),
+        base::BindOnce(&AppSwapStringLoader::OnWritten,
+                       base::Unretained(this)));
+  }
+
+  void OnWritten(MojoResult result) {
+    data_producer_.reset();
+    OnClientComplete(result == MOJO_RESULT_OK ? net::OK : net::ERR_FAILED);
+  }
+
+  void OnClientComplete(net::Error error) {
+    network::URLLoaderCompletionStatus status(error);
+    if (error == net::OK) {
+      const auto size = static_cast<uint64_t>(content_length_);
+      status.encoded_data_length = base::ByteSize(size);
+      status.encoded_body_length = base::ByteSize(size);
+      status.decoded_body_length = base::ByteSize(size);
+    }
+    client_->OnComplete(status);
+    client_.reset();
+    MaybeDeleteSelf();
+  }
+
+  void OnMojoDisconnect() {
+    data_producer_.reset();
+    receiver_.reset();
+    client_.reset();
+    MaybeDeleteSelf();
+  }
+
+  void MaybeDeleteSelf() {
+    if (!receiver_.is_bound() && !client_.is_bound()) {
+      delete this;
+    }
+  }
+
+  mojo::Receiver<network::mojom::URLLoader> receiver_{this};
+  mojo::Remote<network::mojom::URLLoaderClient> client_;
+  std::unique_ptr<mojo::DataPipeProducer> data_producer_;
+  int64_t content_length_ = 0;
+};
+
+// Builds the body of the recovery page shown in place of a navigation that
+// failed to resolve because the registry is unreachable and this tab has no
+// version of its own to fall back to (e.g. a brand-new tab). Offers
+// whatever versions of this package are already on disk from other tabs or
+// past sessions, if any -- `cached_versions` is never empty when this is
+// called (see the call site).
+std::string BuildRegistryUnreachableHtml(
+    const GURL& app_url,
+    const std::vector<std::string>& cached_versions) {
+  std::string rows;
+  for (const std::string& version : cached_versions) {
+    GURL link = net::AppendOrReplaceQueryParameter(app_url, kAppSwapUseVersionQueryKey,
+                                                    version);
+    base::StrAppend(
+        &rows, {"<li><a href=\"", base::EscapeForHTML(link.spec()), "\">",
+                base::EscapeForHTML(version), "</a></li>"});
+  }
+  return base::StrCat(
+      {"<!doctype html><meta charset=utf-8>"
+       "<title>Can't reach the registry</title>"
+       "<style>body{font:14px/1.5 system-ui,sans-serif;max-width:420px;"
+       "margin:15vh auto 0;padding:0 20px;color:#3c4043}"
+       "h1{font-size:17px}ul{padding-left:20px}"
+       "a{color:#1a73e8;text-decoration:none}a:hover{text-decoration:"
+       "underline}</style>"
+       "<h1>Can&rsquo;t reach the package registry</h1>"
+       "<p>AppSwap couldn&rsquo;t resolve this app&rsquo;s latest version. "
+       "You can load a version that&rsquo;s already downloaded instead:</p>"
+       "<ul>",
+       rows, "</ul>"});
+}
+
+// Posts a request to serve `body` as the response, for the recovery page
+// above -- no serve-task-runner hop needed, unlike ServeFromDir(), since
+// there's no file I/O.
+void ServeHtml(std::string body,
+               GURL url,
+               mojo::PendingReceiver<network::mojom::URLLoader> loader,
+               mojo::PendingRemote<network::mojom::URLLoaderClient> client) {
+  AppSwapStringLoader::CreateAndStart(std::move(body), std::move(url),
+                                      std::move(loader), std::move(client));
+}
+
+// Records the exact version a navigation actually resolved to, so the
+// chip/Page Info/checker for *this* tab reflect it rather than whatever
+// AppSwapArtifactProvider's shared per-tag cache happens to hold right now
+// (which another tab's own navigation could have moved on since), then
+// serves it. Only ever called for a navigation, not a subresource -- a
+// page's own scripts/styles/images resolve the same source and would just
+// overwrite this with the same value repeatedly.
+void SetCommittedVersionAndServe(
+    GURL url,
+    content::GlobalRenderFrameHostId frame_id,
+    mojo::PendingReceiver<network::mojom::URLLoader> loader,
+    mojo::PendingRemote<network::mojom::URLLoaderClient> client,
+    base::FilePath dir) {
+  if (content::RenderFrameHost* frame =
+          content::RenderFrameHost::FromID(frame_id)) {
+    if (content::WebContents* web_contents =
+            content::WebContents::FromRenderFrameHost(frame)) {
+      if (AppSwapUpdateAvailableTabHelper* helper =
+              AppSwapUpdateAvailableTabHelper::FromWebContents(
+                  web_contents)) {
+        helper->SetCommittedVersion(dir.BaseName().AsUTF8Unsafe());
+      }
+    }
+  }
+  ServeFromDir(dir, std::move(url), /*accepts_html=*/true, std::move(loader),
+               std::move(client));
+}
+
+// Terminal continuation for the committed-version fallback below -- doesn't
+// retry again on failure, just serves or fails.
+void ServeAfterFallbackResolve(
+    GURL url,
+    content::GlobalRenderFrameHostId frame_id,
+    mojo::PendingReceiver<network::mojom::URLLoader> loader,
+    mojo::PendingRemote<network::mojom::URLLoaderClient> client,
+    base::FilePath dir) {
+  if (dir.empty()) {
+    mojo::Remote<network::mojom::URLLoaderClient>(std::move(client))
+        ->OnComplete(network::URLLoaderCompletionStatus(net::ERR_FAILED));
+    return;
+  }
+  SetCommittedVersionAndServe(std::move(url), frame_id, std::move(loader),
+                              std::move(client), std::move(dir));
+}
+
+// Terminal continuation for a tab with no committed version of its own
+// (e.g. a brand-new tab) whose navigation failed to resolve -- offers
+// whatever's cached on disk, if anything, instead of failing outright.
+void ServeCachedVersionsOrFail(
+    GURL url,
+    mojo::PendingReceiver<network::mojom::URLLoader> loader,
+    mojo::PendingRemote<network::mojom::URLLoaderClient> client,
+    std::vector<std::string> cached_versions) {
+  if (cached_versions.empty()) {
+    mojo::Remote<network::mojom::URLLoaderClient>(std::move(client))
+        ->OnComplete(network::URLLoaderCompletionStatus(net::ERR_FAILED));
+    return;
+  }
+  std::string html = BuildRegistryUnreachableHtml(url, cached_versions);
+  ServeHtml(std::move(html), std::move(url), std::move(loader),
+           std::move(client));
+}
+
+// Continuation after an npm artifact is resolved (downloaded + extracted).
+void ServeAfterResolve(
+    AppSwapSource source,
+    GURL url,
+    bool accepts_html,
+    content::GlobalRenderFrameHostId frame_id,
+    mojo::PendingReceiver<network::mojom::URLLoader> loader,
+    mojo::PendingRemote<network::mojom::URLLoaderClient> client,
+    base::FilePath dir) {
+  if (dir.empty()) {
+    // For a navigation, fall back rather than failing outright -- most
+    // commonly hit when the registry is unreachable and a dist-tag can't
+    // be re-resolved. Subresources of an already-loading page don't get
+    // this treatment; a failure there is real (e.g. a genuinely missing
+    // file), not a registry hiccup worth working around.
+    if (accepts_html) {
+      if (content::RenderFrameHost* frame =
+              content::RenderFrameHost::FromID(frame_id)) {
+        if (content::WebContents* web_contents =
+                content::WebContents::FromRenderFrameHost(frame)) {
+          if (AppSwapUpdateAvailableTabHelper* helper =
+                  AppSwapUpdateAvailableTabHelper::FromWebContents(
+                      web_contents)) {
+            // First choice: whatever exact version this tab is already
+            // showing, presumably still on disk from when it was first
+            // loaded. AppSwapArtifactProvider::GetOrDownload() checks disk
+            // before the network for an exact version, so this succeeds
+            // without needing connectivity.
+            if (std::optional<std::string> committed =
+                    helper->committed_version()) {
+              source.version = *committed;
+              AppSwapArtifactProvider::GetInstance()->GetOrDownload(
+                  source, base::BindOnce(&ServeAfterFallbackResolve,
+                                         std::move(url), frame_id,
+                                         std::move(loader), std::move(client)));
+              return;
+            }
+          }
+          // No committed version for this tab -- e.g. a brand-new tab that
+          // has never loaded this app before. Offer whatever's cached on
+          // disk from any tab or past session instead of failing outright.
+          AppSwapArtifactProvider::GetInstance()->GetCachedVersions(
+              source, base::BindOnce(&ServeCachedVersionsOrFail, url,
+                                     std::move(loader), std::move(client)));
+          return;
+        }
+      }
+    }
+    mojo::Remote<network::mojom::URLLoaderClient>(std::move(client))
+        ->OnComplete(network::URLLoaderCompletionStatus(net::ERR_FAILED));
+    return;
+  }
+  if (accepts_html) {
+    SetCommittedVersionAndServe(std::move(url), frame_id, std::move(loader),
+                                std::move(client), std::move(dir));
+    return;
+  }
+  ServeFromDir(dir, std::move(url), accepts_html, std::move(loader),
+               std::move(client));
+}
