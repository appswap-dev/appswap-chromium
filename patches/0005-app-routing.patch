+      if (apps.length) field('appId').value = apps[0].id;
+      updatePreview();
+      dialog.showModal();
+      field('urlPattern').focus();
+    }
+
+    function openEditDialog(route) {
+      editingId = route.id;
+      field('dialogTitle').textContent = 'Edit route';
+      field('save').textContent = 'Save';
+      field('urlPattern').value = route.url_pattern;
+      renderAppOptions();
+      field('appId').value = route.app_id;
+      updatePreview();
+      dialog.showModal();
+      field('urlPattern').focus();
+    }
+
+    field('openAdd').addEventListener('click', openAddDialog);
+    field('cancel').addEventListener('click', () => dialog.close());
+    field('appId').addEventListener('change', updatePreview);
+
+    field('form').addEventListener('submit', (event) => {
+      event.preventDefault();
+      const urlPattern = field('urlPattern').value.trim();
+      const appId = field('appId').value;
+      if (!urlPattern || !appId) return;
+      if (editingId) {
+        chrome.send('updateRoute', [editingId, urlPattern, appId]);
+      } else {
+        chrome.send('addRoute', [urlPattern, appId]);
+      }
+      dialog.close();
+    });
+
+    window.setData = (data) => {
+      apps = data.apps;
+      routes = data.routes;
+      render();
