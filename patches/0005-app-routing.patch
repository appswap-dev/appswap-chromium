+#include "url/gurl.h"
+
+// A single AppSwap route: requests whose URL starts with `url_prefix` are
+// served from `source` instead of the network.
+struct AppSwapRoute {
+  std::string url_prefix;
+  AppSwapSource source;
+
+  // Returns the first route whose prefix matches `url`, or nullopt.
+  static std::optional<AppSwapRoute> FindForUrl(
+      const std::vector<AppSwapRoute>& routes,
+      const GURL& url);
+};
+
+// Per-tab AppSwap route configuration, stored on the WebContents.
+class AppSwapTabState : public content::WebContentsUserData<AppSwapTabState> {
+ public:
+  ~AppSwapTabState() override;
+
+  void SetRoutes(std::vector<AppSwapRoute> routes);
+  const std::vector<AppSwapRoute>& routes() const { return routes_; }
+
+  // Global routes that apply to every tab. Currently populated from the
+  // `--appswap-route` command-line switch (a stopgap until routes are loaded
+  // from configuration).
+  static const std::vector<AppSwapRoute>& GetGlobalRoutes();
+
+ private:
+  explicit AppSwapTabState(content::WebContents* contents);
+
+  friend WebContentsUserData;
+  WEB_CONTENTS_USER_DATA_KEY_DECL();
+
+  std::vector<AppSwapRoute> routes_;
+};
+
+#endif  // CHROME_BROWSER_APP_SWAP_APP_SWAP_TAB_STATE_H_
