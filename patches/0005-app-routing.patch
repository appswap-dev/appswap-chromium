+    <div class="titlebar">
+      <h1>Apps <span class="count" id="count"></span></h1>
+      <nav class="tabs">
+        <a href="appswap://apps" class="active">Apps</a>
+        <a href="appswap://routes">Routes</a>
+        <a href="appswap://profiles">Profiles</a>
+      </nav>
+    </div>
+    <button class="btn-primary" id="openAdd" type="button">+ Add app</button>
+  </header>
+  <div id="content"></div>
+
+  <dialog id="dialog">
+    <form class="dialog-body" id="form" method="dialog">
+      <h2 id="dialogTitle">Add app</h2>
+      <div class="field">
+        <label for="title">Title</label>
+        <input id="title" placeholder="My App" required>
+      </div>
+      <div class="field">
+        <label for="package">Package</label>
+        <input id="package" placeholder="@myorg/myapp" required>
+      </div>
+      <div class="field">
+        <label for="version">Version or dist-tag</label>
+        <input id="version" placeholder="latest" required>
+      </div>
+      <div class="field">
+        <label for="registry">Registry</label>
+        <input id="registry" placeholder="https://registry.npmjs.org" value="https://registry.npmjs.org">
+      </div>
+      <div class="dialog-actions">
+        <button class="btn-secondary" id="cancel" type="button">Cancel</button>
+        <button class="btn-primary" id="save" type="submit">Add app</button>
+      </div>
+    </form>
+  </dialog>
+
+  <script>
+    let editingId = null;
+    const field = (id) => document.getElementById(id);
+    const dialog = field('dialog');
+
+    const PALETTE = ['#6366f1', '#0ea5e9', '#10b981', '#f59e0b', '#ef4444',
+                      '#8b5cf6', '#ec4899', '#14b8a6'];
+    function colorFor(text) {
+      let hash = 0;
+      for (let i = 0; i < text.length; i++) {
+        hash = (hash * 31 + text.charCodeAt(i)) >>> 0;
+      }
+      return PALETTE[hash % PALETTE.length];
+    }
+    function hostnameOf(url) {
+      try {
+        return new URL(url).hostname;
+      } catch (e) {
+        return url;
+      }
+    }
+    function initialOf(title) {
+      return (title.trim()[0] || '?').toUpperCase();
+    }
+
+    function render(apps) {
+      const content = field('content');
+      content.replaceChildren();
+      field('count').textContent = apps.length ? '(' + apps.length + ')' : '';
+
+      if (!apps.length) {
+        const empty = document.createElement('div');
+        empty.className = 'empty';
+        empty.innerHTML = '<div class="glyph">&#128230;</div>' +
+            '<p>No apps configured yet.</p>';
+        const btn = document.createElement('button');
+        btn.className = 'btn-primary';
+        btn.type = 'button';
+        btn.textContent = '+ Add your first app';
+        btn.addEventListener('click', openAddDialog);
+        empty.appendChild(btn);
+        content.appendChild(empty);
+        return;
+      }
+
+      const grid = document.createElement('div');
+      grid.className = 'grid';
+      for (const app of apps) {
+        grid.appendChild(buildCard(app));
+      }
+      content.appendChild(grid);
+    }
+
+    function buildCard(app) {
+      const card = document.createElement('div');
+      card.className = 'card';
+
+      const top = document.createElement('div');
+      top.className = 'card-top';
+
+      const icon = document.createElement('div');
+      icon.className = 'icon';
+      icon.style.background = colorFor(app.package || app.title);
+      icon.textContent = initialOf(app.title);
+
+      const heading = document.createElement('div');
+      heading.className = 'card-heading';
+      const title = document.createElement('div');
+      title.className = 'card-title';
+      title.textContent = app.title;
+      title.title = app.title;
+      const pkg = document.createElement('div');
+      pkg.className = 'card-package';
+      pkg.textContent = app.package;
+      pkg.title = app.package;
+      heading.appendChild(title);
+      heading.appendChild(pkg);
+
+      top.appendChild(icon);
+      top.appendChild(heading);
+
+      const meta = document.createElement('div');
+      meta.className = 'meta';
+      const versionBadge = document.createElement('span');
+      versionBadge.className = 'badge';
+      versionBadge.textContent = app.version;
+      const registryBadge = document.createElement('span');
+      registryBadge.className = 'badge';
+      registryBadge.textContent = hostnameOf(app.registry);
+      registryBadge.title = app.registry;
+      meta.appendChild(versionBadge);
+      meta.appendChild(registryBadge);
+
+      const actions = document.createElement('div');
+      actions.className = 'card-actions';
+      const editBtn = document.createElement('button');
+      editBtn.className = 'icon-btn';
+      editBtn.type = 'button';
+      editBtn.textContent = 'Edit';
+      editBtn.addEventListener('click', () => openEditDialog(app));
+      const rmBtn = document.createElement('button');
+      rmBtn.className = 'icon-btn danger';
+      rmBtn.type = 'button';
+      rmBtn.textContent = 'Remove';
+      rmBtn.addEventListener('click', () => {
+        if (confirm('Remove "' + app.title + '"?')) {
+          chrome.send('removeApp', [app.id]);
+        }
+      });
+      actions.appendChild(editBtn);
+      actions.appendChild(rmBtn);
+
+      card.appendChild(top);
+      card.appendChild(meta);
+      card.appendChild(actions);
+      return card;
+    }
+
+    function openAddDialog() {
+      editingId = null;
+      field('dialogTitle').textContent = 'Add app';
+      field('save').textContent = 'Add app';
+      field('title').value = '';
+      field('package').value = '';
+      field('version').value = '';
+      field('registry').value = 'https://registry.npmjs.org';
+      dialog.showModal();
+      field('title').focus();
+    }
+
+    function openEditDialog(app) {
+      editingId = app.id;
+      field('dialogTitle').textContent = 'Edit app';
+      field('save').textContent = 'Save';
+      field('title').value = app.title;
+      field('package').value = app.package;
+      field('version').value = app.version;
+      field('registry').value = app.registry || 'https://registry.npmjs.org';
+      dialog.showModal();
+      field('title').focus();
+    }
+
+    field('openAdd').addEventListener('click', openAddDialog);
+    field('cancel').addEventListener('click', () => dialog.close());
+
+    field('form').addEventListener('submit', (event) => {
+      event.preventDefault();
+      const title = field('title').value.trim();
+      const pkg = field('package').value.trim();
+      const version = field('version').value.trim();
+      const registry = field('registry').value.trim() || 'https://registry.npmjs.org';
+      if (!title || !pkg || !version) return;
+      if (editingId) {
+        chrome.send('updateApp', [editingId, title, pkg, version, registry]);
+      } else {
+        chrome.send('addApp', [title, pkg, version, registry]);
+      }
+      dialog.close();
+    });
+
+    window.setApps = render;
+    chrome.send('getApps');
+  </script>
+</body>
+</html>
+)html";
+
+class AppSwapAppsHandler : public content::WebUIMessageHandler {
+ public:
+  void RegisterMessages() override {
+    web_ui()->RegisterMessageCallback(
+        "getApps", base::BindRepeating(&AppSwapAppsHandler::HandleGetApps,
+                                       base::Unretained(this)));
+    web_ui()->RegisterMessageCallback(
+        "addApp", base::BindRepeating(&AppSwapAppsHandler::HandleAddApp,
+                                      base::Unretained(this)));
+    web_ui()->RegisterMessageCallback(
+        "updateApp", base::BindRepeating(&AppSwapAppsHandler::HandleUpdateApp,
+                                         base::Unretained(this)));
+    web_ui()->RegisterMessageCallback(
+        "removeApp", base::BindRepeating(&AppSwapAppsHandler::HandleRemoveApp,
+                                         base::Unretained(this)));
+  }
+
+ private:
+  void SendApps() {
+    AppSwapAppsService::GetInstance()->GetApps(base::BindOnce(
+        &AppSwapAppsHandler::OnAppsLoaded, weak_factory_.GetWeakPtr()));
+  }
+
+  void OnAppsLoaded(std::vector<AppSwapApp> apps) {
+    base::ListValue list;
+    for (const AppSwapApp& app : apps) {
+      base::DictValue dict;
+      dict.Set("id", app.id);
+      dict.Set("title", app.title);
+      dict.Set("package", app.package_name);
+      dict.Set("version", app.version);
+      dict.Set("registry", app.registry);
+      list.Append(std::move(dict));
+    }
+    CallJavascriptFunction("setApps", list);
+  }
+
+  void HandleGetApps(const base::ListValue& args) {
+    AllowJavascript();
+    SendApps();
+  }
+
+  void HandleAddApp(const base::ListValue& args) {
+    AllowJavascript();
+    if (args.size() < 4) {
+      return;
+    }
+    const std::string* title = args[0].GetIfString();
+    const std::string* package = args[1].GetIfString();
+    const std::string* version = args[2].GetIfString();
+    const std::string* registry = args[3].GetIfString();
+    if (!title || !package || !version) {
+      return;
+    }
+
+    AppSwapApp app;
+    app.title = *title;
+    app.package_name = *package;
+    app.version = *version;
+    app.registry = registry && !registry->empty() ? *registry : kDefaultRegistry;
+    AppSwapAppsService::GetInstance()->AddApp(std::move(app));
+    SendApps();
+  }
+
+  void HandleUpdateApp(const base::ListValue& args) {
+    AllowJavascript();
+    if (args.size() < 5) {
+      return;
+    }
+    const std::string* id = args[0].GetIfString();
+    const std::string* title = args[1].GetIfString();
+    const std::string* package = args[2].GetIfString();
+    const std::string* version = args[3].GetIfString();
+    const std::string* registry = args[4].GetIfString();
+    if (!id || !title || !package || !version) {
+      return;
+    }
+
+    AppSwapApp app;
+    app.id = *id;
+    app.title = *title;
+    app.package_name = *package;
+    app.version = *version;
+    app.registry = registry && !registry->empty() ? *registry : kDefaultRegistry;
+    AppSwapAppsService::GetInstance()->UpdateApp(std::move(app));
+    SendApps();
+  }
+
+  void HandleRemoveApp(const base::ListValue& args) {
+    AllowJavascript();
+    if (args.empty()) {
+      return;
+    }
+    const std::string* id = args[0].GetIfString();
+    if (!id) {
+      return;
+    }
+    AppSwapAppsService::GetInstance()->RemoveApp(*id);
+    SendApps();
+  }
+
+  base::WeakPtrFactory<AppSwapAppsHandler> weak_factory_{this};
+};
+
