+
+namespace network {
+class SimpleURLLoader;
+}  // namespace network
+
+// Resolves npm app sources to a directory on disk, downloading and unpacking
+// the tarball on first use and caching the result.
+class AppSwapArtifactProvider {
+ public:
+  AppSwapArtifactProvider();
+  ~AppSwapArtifactProvider();
+
+  AppSwapArtifactProvider(const AppSwapArtifactProvider&) = delete;
+  AppSwapArtifactProvider& operator=(const AppSwapArtifactProvider&) = delete;
+
+  static AppSwapArtifactProvider* GetInstance();
+
+  // Asynchronously ensures the artifact for `source` is present and calls
+  // `callback` with its directory (empty on failure). Must be called on the UI
+  // thread; `callback` runs on the UI thread.
+  void GetOrDownload(const AppSwapSource& source,
+                     base::OnceCallback<void(base::FilePath)> callback);
+
+ private:
+  void FetchMetadata(const AppSwapSource& source,
+                     base::OnceCallback<void(std::string /*version*/,
+                                             std::string /*error*/)> callback);
+  void DownloadTarball(const AppSwapSource& source,
+                       const std::string& version,
+                       const std::string& tarball_url,
+                       base::OnceCallback<void(base::FilePath)> callback);
+  void OnTarball(const AppSwapSource& source,
+                 const std::string& version,
+                 base::FilePath target_dir,
+                 base::OnceCallback<void(base::FilePath)> callback,
+                 std::optional<std::string> body);
+  void Finish(const AppSwapSource& source, base::FilePath dir);
+
+  base::FilePath apps_dir_;
+
+  // Dedup: pending callbacks keyed by "package@version".
+  std::map<std::string, std::vector<base::OnceCallback<void(base::FilePath)>>>
+      pending_;
+
+  // Active downloads keyed by "package@version", to keep the loader alive.
+  std::map<std::string, std::unique_ptr<network::SimpleURLLoader>> loaders_;
+
+  // In-memory cache of resolved directories keyed by "package@version".
+  std::map<std::string, base::FilePath> cache_;
+
+  SEQUENCE_CHECKER(sequence_checker_);
+};
+
+#endif  // CHROME_BROWSER_APP_SWAP_APP_SWAP_ARTIFACT_PROVIDER_H_
