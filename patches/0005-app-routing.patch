@@ -0,0 +1,100 @@
+// Copyright 2026 The AppSwap Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/app_swap/app_swap_tab_state.h"
+
+#include <optional>
+#include <string>
+#include <utility>
+#include <vector>
+
+#include "base/command_line.h"
+#include "base/no_destructor.h"
+#include "base/strings/string_split.h"
+#include "base/strings/string_util.h"
+
+AppSwapTabState::AppSwapTabState(content::WebContents* contents)
+    : content::WebContentsUserData<AppSwapTabState>(*contents) {}
+
+AppSwapTabState::~AppSwapTabState() = default;
+
+void AppSwapTabState::SetRoutes(std::vector<AppSwapRoute> routes) {
+  routes_ = std::move(routes);
+}
+
+// static
+std::optional<AppSwapRoute> AppSwapRoute::FindForUrl(
+    const std::vector<AppSwapRoute>& routes,
+    const GURL& url) {
+  const std::string spec = url.spec();
+  for (const AppSwapRoute& route : routes) {
+    if (base::StartsWith(spec, route.url_prefix)) {
+      return route;
+    }
+  }
+  return std::nullopt;
+}
+
+namespace {
+
+// Parses "--appswap-route=<url_prefix>|<dir>" into a directory route.
+std::optional<AppSwapRoute> ParseDirectoryRoute(const std::string& value) {
+  const size_t separator = value.find('|');
+  if (separator == std::string::npos || separator == 0) {
+    return std::nullopt;
+  }
+  AppSwapRoute route;
+  route.url_prefix = value.substr(0, separator);
+  route.source.type = AppSwapSourceType::kDirectory;
+  route.source.dir = base::FilePath::FromUTF8Unsafe(value.substr(separator + 1));
+  return route;
+}
+
+// Parses "--appswap-npm-route=<url_prefix>|<package>@<version>|<registry>"
+// into an npm route.
+std::optional<AppSwapRoute> ParseNpmRoute(const std::string& value) {
+  const std::vector<std::string> parts =
+      base::SplitString(value, "|", base::TRIM_WHITESPACE, base::SPLIT_WANT_ALL);
+  if (parts.size() != 3) {
+    return std::nullopt;
+  }
+
+  const size_t at = parts[1].find_last_of('@');
+  if (at == std::string::npos || at == 0) {
+    return std::nullopt;
+  }
+
+  AppSwapRoute route;
+  route.url_prefix = parts[0];
+  route.source.type = AppSwapSourceType::kNpm;
+  route.source.package_name = parts[1].substr(0, at);
+  route.source.version = parts[1].substr(at + 1);
+  route.source.registry = parts[2];
+  return route;
+}
+
+std::vector<AppSwapRoute> ParseGlobalRoutes() {
+  std::vector<AppSwapRoute> routes;
+  const base::CommandLine* command_line = base::CommandLine::ForCurrentProcess();
+  if (std::optional<AppSwapRoute> route = ParseDirectoryRoute(
+          command_line->GetSwitchValueASCII("appswap-route"))) {
+    routes.push_back(std::move(*route));
+  }
+  if (std::optional<AppSwapRoute> route = ParseNpmRoute(
+          command_line->GetSwitchValueASCII("appswap-npm-route"))) {
+    routes.push_back(std::move(*route));
+  }
+  return routes;
+}
+
+}  // namespace
+
+// static
+const std::vector<AppSwapRoute>& AppSwapTabState::GetGlobalRoutes() {
+  static const base::NoDestructor<std::vector<AppSwapRoute>> routes(
+      ParseGlobalRoutes());
+  return *routes;
+}
+
+WEB_CONTENTS_USER_DATA_KEY_IMPL(AppSwapTabState);
