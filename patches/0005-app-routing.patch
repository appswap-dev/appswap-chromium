+
+// A URLLoaderFactory interceptor that serves AppSwap-routed requests from disk
+// and forwards everything else to the wrapped network factory.
+class AppSwapProxyingURLLoaderFactory
+    : public network::SelfDeletingURLLoaderFactory {
+ public:
+  static void MaybeProxyRequest(content::RenderFrameHost* frame,
+                                network::URLLoaderFactoryBuilder& builder);
+
