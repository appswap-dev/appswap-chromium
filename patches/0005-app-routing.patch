index 0000000000..e2f32a293d
--- /dev/null
+++ b/chrome/browser/app_swap/app_swap_url_loader_factory.cc
@@ -0,0 +1,285 @@
+// Copyright 2026 The AppSwap Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/app_swap/app_swap_url_loader_factory.h"
+
+#include <memory>
+#include <optional>
+#include <string>
+#include <string_view>
+#include <utility>
+
+#include "base/files/file.h"
+#include "base/files/file_path.h"
+#include "base/files/file_util.h"
+#include "base/functional/bind.h"
+#include "base/memory/self_deleting.h"
+#include "base/task/thread_pool.h"
+#include "chrome/browser/app_swap/app_swap_tab_state.h"
+#include "content/public/browser/render_frame_host.h"
+#include "content/public/browser/web_contents.h"
+#include "mojo/public/cpp/system/data_pipe.h"
+#include "mojo/public/cpp/system/data_pipe_producer.h"
+#include "mojo/public/cpp/system/file_data_source.h"
+#include "net/base/mime_util.h"
+#include "net/base/net_errors.h"
+#include "net/http/http_request_headers.h"
+#include "net/http/http_response_headers.h"
+#include "services/network/public/cpp/resource_request.h"
+#include "services/network/public/mojom/url_loader.mojom.h"
+#include "services/network/public/mojom/url_response_head.mojom.h"
+#include "url/gurl.h"
+
+namespace {
+
+// Resolves a request URL path to a file on disk under `route.serve_dir`,
+// applying SPA fallback for navigations. Returns an empty path when nothing
+// matches. Runs on a MayBlock task runner (it stats the filesystem).
+base::FilePath ResolveFilePath(const AppSwapRoute& route,
+                               const std::string& path,
+                               bool accepts_html) {
+  std::string_view path_view(path);
+  if (path_view.empty() || path_view == "/") {
+    path_view = "index.html";
+  }
+
+  // Strip leading separators to make the path relative to serve_dir.
+  const size_t start = path_view.find_first_not_of('/');
+  const std::string_view relative_str =
+      (start == std::string_view::npos) ? std::string_view()
+                                        : path_view.substr(start);
+
+  // Reject any path that could escape the serve directory.
+  if (relative_str.find("..") != std::string_view::npos) {
+    return base::FilePath();
+  }
+
+  base::FilePath full =
+      route.serve_dir.Append(base::FilePath::FromUTF8Unsafe(relative_str))
+          .NormalizePathSeparators();
+
+  if (base::PathExists(full) && !base::DirectoryExists(full)) {
+    return full;
+  }
+
+  // SPA fallback: only for navigations (requests that accept HTML), never for
+  // missing asset subresources.
+  if (accepts_html) {
+    base::FilePath index =
+        route.serve_dir.Append(FILE_PATH_LITERAL("index.html"));
+    if (base::PathExists(index)) {
+      return index;
+    }
+  }
+  return base::FilePath();
+}
+
+// Self-owned URLLoader that streams a single file from disk as the response.
+// Runs on a MayBlock task runner (file I/O is blocking).
+class AppSwapFileLoader : public network::mojom::URLLoader {
+ public:
+  static void CreateAndStart(
+      const AppSwapRoute& route,
+      std::string path,
+      bool accepts_html,
+      mojo::PendingReceiver<network::mojom::URLLoader> loader,
+      mojo::PendingRemote<network::mojom::URLLoaderClient> client) {
+    // Owns itself; deleted once both bindings are closed.
+    auto* file_loader = new AppSwapFileLoader();
+    file_loader->Start(route, std::move(path), accepts_html, std::move(loader),
+                       std::move(client));
+  }
+
+  AppSwapFileLoader(const AppSwapFileLoader&) = delete;
+  AppSwapFileLoader& operator=(const AppSwapFileLoader&) = delete;
+
+  // network::mojom::URLLoader:
+  void FollowRedirect(
+      network::HttpRequestHeadersUpdateParams /*headers_update_params*/,
+      const std::optional<GURL>& /*new_url*/) override {}
+  void SetPriority(net::RequestPriority /*priority*/,
+                   int32_t /*intra_priority_value*/) override {}
+
+ private:
+  AppSwapFileLoader() = default;
+  ~AppSwapFileLoader() override = default;
+
+  void Start(const AppSwapRoute& route,
+             std::string path,
+             bool accepts_html,
+             mojo::PendingReceiver<network::mojom::URLLoader> loader,
+             mojo::PendingRemote<network::mojom::URLLoaderClient> client) {
+    receiver_.Bind(std::move(loader));
+    receiver_.set_disconnect_handler(base::BindOnce(
+        &AppSwapFileLoader::OnMojoDisconnect, base::Unretained(this)));
+    client_.Bind(std::move(client));
+
+    base::FilePath file_path = ResolveFilePath(route, path, accepts_html);
+    if (file_path.empty()) {
+      OnClientComplete(net::ERR_FILE_NOT_FOUND);
+      return;
+    }
+
+    base::File::Info info;
+    if (!base::GetFileInfo(file_path, &info) || info.is_directory) {
+      OnClientComplete(net::ERR_FILE_NOT_FOUND);
+      return;
+    }
+
+    base::File file(file_path, base::File::FLAG_OPEN | base::File::FLAG_READ);
+    if (!file.IsValid()) {
+      OnClientComplete(net::ERR_FILE_NOT_FOUND);
+      return;
+    }
+
+    auto head = network::mojom::URLResponseHead::New();
+    head->response_type = network::mojom::FetchResponseType::kBasic;
+    head->headers =
+        base::MakeRefCounted<net::HttpResponseHeaders>("HTTP/1.1 200 OK");
+    std::string mime_type;
+    if (!net::GetMimeTypeFromFile(file_path, &mime_type)) {
+      mime_type = "application/octet-stream";
+    }
+    head->mime_type = mime_type;
+    head->headers->AddHeader(net::HttpRequestHeaders::kContentType, mime_type);
+    head->content_length = info.size;
+
+    mojo::ScopedDataPipeProducerHandle producer_handle;
+    mojo::ScopedDataPipeConsumerHandle consumer_handle;
+    if (mojo::CreateDataPipe(/*options=*/nullptr, producer_handle,
+                             consumer_handle) != MOJO_RESULT_OK) {
+      OnClientComplete(net::ERR_FAILED);
+      return;
+    }
+
+    client_->OnReceiveResponse(std::move(head), std::move(consumer_handle),
+                               std::nullopt);
+
+    if (info.size == 0) {
+      OnClientComplete(net::OK);
+      return;
+    }
+
+    data_producer_ = std::make_unique<mojo::DataPipeProducer>(
+        std::move(producer_handle));
+    data_producer_->Write(
+        std::make_unique<mojo::FileDataSource>(std::move(file)),
+        base::BindOnce(&AppSwapFileLoader::OnFileWritten,
+                       base::Unretained(this)));
+  }
+
+  void OnFileWritten(MojoResult result) {
+    OnClientComplete(result == MOJO_RESULT_OK ? net::OK : net::ERR_FAILED);
+  }
+
+  void OnClientComplete(net::Error error) {
+    client_->OnComplete(network::URLLoaderCompletionStatus(error));
+    client_.reset();
+    MaybeDeleteSelf();
+  }
+
+  void OnMojoDisconnect() {
+    data_producer_.reset();
+    receiver_.reset();
+    client_.reset();
+    MaybeDeleteSelf();
+  }
+
+  void MaybeDeleteSelf() {
+    if (!receiver_.is_bound() && !client_.is_bound()) {
+      delete this;
+    }
+  }
+
+  mojo::Receiver<network::mojom::URLLoader> receiver_{this};
+  mojo::Remote<network::mojom::URLLoaderClient> client_;
+  std::unique_ptr<mojo::DataPipeProducer> data_producer_;
+};
+
+}  // namespace
+
+// static
+void AppSwapProxyingURLLoaderFactory::MaybeProxyRequest(
+    content::RenderFrameHost* frame,
+    network::URLLoaderFactoryBuilder& builder) {
+  if (!frame) {
+    return;
+  }
+  content::WebContents* web_contents =
+      content::WebContents::FromRenderFrameHost(frame);
+  if (!web_contents) {
+    return;
+  }
+
+  auto [receiver, remote] = builder.Append();
+  base::MakeSelfDeleting<AppSwapProxyingURLLoaderFactory>(
+      std::move(receiver), std::move(remote), web_contents->GetWeakPtr());
+}
+
+AppSwapProxyingURLLoaderFactory::AppSwapProxyingURLLoaderFactory(
+    mojo::PendingReceiver<network::mojom::URLLoaderFactory> receiver,
+    mojo::PendingRemote<network::mojom::URLLoaderFactory> target_factory,
+    base::WeakPtr<content::WebContents> web_contents,
+    base::SelfDeletingPassKey pass_key)
+    : network::SelfDeletingURLLoaderFactory(std::move(receiver), pass_key),
+      web_contents_(std::move(web_contents)),
+      task_runner_(base::ThreadPool::CreateSequencedTaskRunner(
+          {base::MayBlock(), base::TaskPriority::USER_VISIBLE,
+           base::TaskShutdownBehavior::SKIP_ON_SHUTDOWN})) {
+  target_factory_.Bind(std::move(target_factory));
+  target_factory_.set_disconnect_handler(base::BindOnce(
+      &AppSwapProxyingURLLoaderFactory::OnTargetFactoryError,
+      base::Unretained(this)));
+}
+
+AppSwapProxyingURLLoaderFactory::~AppSwapProxyingURLLoaderFactory() = default;
+
+void AppSwapProxyingURLLoaderFactory::OnTargetFactoryError() {
+  DisconnectReceiversAndDestroy();
+}
+
+void AppSwapProxyingURLLoaderFactory::CreateLoaderAndStart(
+    mojo::PendingReceiver<network::mojom::URLLoader> loader,
+    int32_t request_id,
+    uint32_t options,
+    const network::ResourceRequest& request,
+    mojo::PendingRemote<network::mojom::URLLoaderClient> client,
+    const net::MutableNetworkTrafficAnnotationTag& traffic_annotation) {
+  // Only static GET/HEAD requests are served from disk; everything else is
+  // forwarded to the network.
+  if (request.method == net::HttpRequestHeaders::kGetMethod ||
+      request.method == net::HttpRequestHeaders::kHeadMethod) {
+    std::optional<AppSwapRoute> route;
+    if (web_contents_) {
+      if (auto* state = AppSwapTabState::FromWebContents(web_contents_.get())) {
+        route = AppSwapRoute::FindForUrl(state->routes(), request.url);
+      }
+    }
+    if (!route) {
+      route = AppSwapRoute::FindForUrl(AppSwapTabState::GetGlobalRoutes(),
+                                       request.url);
+    }
+
+    if (route) {
+      std::string path(request.url.path());
+      bool accepts_html = false;
+      if (const std::optional<std::string> accept =
+              request.headers.GetHeader(net::HttpRequestHeaders::kAccept);
+          accept && accept->find("text/html") != std::string::npos) {
+        accepts_html = true;
+      }
+      task_runner_->PostTask(
+          FROM_HERE,
+          base::BindOnce(&AppSwapFileLoader::CreateAndStart, *route,
+                         std::move(path), accepts_html, std::move(loader),
+                         std::move(client)));
+      return;
+    }
+  }
+
+  // Not handled; forward to the wrapped network factory.
+  target_factory_->CreateLoaderAndStart(std::move(loader), request_id, options,
+                                        request, std::move(client),
+                                        traffic_annotation);
+}
