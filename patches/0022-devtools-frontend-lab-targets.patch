+/**
+ * AppSwap: keeps this frontend attached to every Responsive Lab cell, and
+ * scoped to whichever cell the user last focused.
+ *
+ * Retargeting is TargetManager's own scope mechanism, reached through the
+ * `SDK.Target.Target` UI context flavor that MainImpl listens for: setting the
+ * flavor calls setScopeTarget(), which replays targetRemoved/targetAdded
+ * across every scoped observer so the panels rebuild against the new cell.
+ * Panels need no changes; they already handle targets coming and going.
+ *
+ * Attaching is Target.autoAttachRelated on the browser target, once per cell.
+ * It accumulates (TargetHandler keeps a map of related auto-attachers), so
+ * repeating it for a cell that is already attached is harmless -- which is
+ * what lets this re-send the whole list rather than track a delta.
+ */
+class AppSwapLabTargetSwitcher implements SDK.TargetManager.Observer {
+  readonly #attachRequested = new Set<string>();
+  #pendingFocusId: string|null = null;
+
+  constructor() {
+    const host = Host.InspectorFrontendHost.InspectorFrontendHostInstance;
+    host.events.addEventListener(
+        Host.InspectorFrontendHostAPI.Events.AppSwapLabTargetsChanged, ({data}) => this.#attachAll(data));
+    host.events.addEventListener(
+        Host.InspectorFrontendHostAPI.Events.AppSwapLabFocusedTargetChanged, ({data}) => this.#focus(data));
+    SDK.TargetManager.TargetManager.instance().observeTargets(this);
+
+    // Whatever the browser pushed before this existed. It pushes as soon as
+    // the frontend document loads, which is several async hops before an
+    // early-initialization runnable gets to run, so without this the first
+    // window would attach nothing and scope to nothing.
+    const state = host.appSwapLabState();
+    this.#attachAll(state.targetIds);
+    if (state.focusedTargetId) {
+      this.#focus(state.focusedTargetId);
+    }
+  }
+
+  targetAdded(_target: SDK.Target.Target): void {
+    // A focus push can name a cell that has not finished attaching yet:
+    // autoAttachRelated round-trips through the renderer, so the browser
+    // knows the target id well before the frontend has the target. Re-apply
+    // the pending focus until it lands.
+    if (this.#pendingFocusId) {
+      this.#focus(this.#pendingFocusId);
