+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_SERVICES_APP_SWAP_PLAYBACK_APP_SWAP_PLAYBACK_SERVICE_H_
+#define CHROME_SERVICES_APP_SWAP_PLAYBACK_APP_SWAP_PLAYBACK_SERVICE_H_
+
+#include <vector>
+
+#include "base/memory/scoped_refptr.h"
+#include "chrome/services/app_swap_playback/public/mojom/app_swap_playback.mojom.h"
+#include "mojo/public/cpp/bindings/pending_receiver.h"
+#include "mojo/public/cpp/bindings/receiver.h"
+#include "third_party/skia/include/core/SkRefCnt.h"
+#include "third_party/skia/include/gpu/ganesh/GrDirectContext.h"
+#include "ui/gfx/geometry/size.h"
+
+namespace gl {
+class GLContext;
+class GLSurface;
+}  // namespace gl
+
+// AppSwap session recording playback (see app_swap_playback.mojom's own
+// design note for the full "why a separate process" reasoning). Lives in
+// its own child process, launched fresh on demand -- so
+// gl::init::InitializeGLOneOff()'s one-shot-per-process constraint is
+// satisfied naturally, and EnsureGaneshInitialized() only ever runs it
+// once per instance of this class (once per launch).
+class AppSwapPlaybackService : public app_swap_playback::mojom::PlaybackRenderer {
+ public:
+  explicit AppSwapPlaybackService(
+      mojo::PendingReceiver<app_swap_playback::mojom::PlaybackRenderer>
+          receiver);
+
+  AppSwapPlaybackService(const AppSwapPlaybackService&) = delete;
+  AppSwapPlaybackService& operator=(const AppSwapPlaybackService&) = delete;
+
+  ~AppSwapPlaybackService() override;
+
+ private:
+  // app_swap_playback::mojom::PlaybackRenderer:
+  void RenderFrame(std::vector<app_swap_playback::mojom::LayerFramePtr> layers,
+                   const gfx::Size& viewport_size,
+                   RenderFrameCallback callback) override;
+
+  // Stands up a GL/Ganesh context the first time it's called; a cheap
+  // no-op (returns the cached result) on every call after the first. See
+  // cc/paint/paintop_disk_roundtrip_tool.cc's RenderBitmapWithGanesh() --
+  // this mirrors that sequence, minus the per-call offscreen surface
+  // (this keeps one GrDirectContext alive across many RenderFrame() calls
+  // instead of tearing GL down and back up every time; the actual render
+  // target is a fresh SkSurface sized to each frame's own viewport,
+  // created per call in RenderFrame() itself since viewport size can
+  // change between calls -- e.g. the recorded window was resized).
+  bool EnsureGaneshInitialized();
+
+  scoped_refptr<gl::GLSurface> gl_surface_;
+  scoped_refptr<gl::GLContext> gl_context_;
+  sk_sp<GrDirectContext> gr_context_;
+  bool ganesh_init_failed_ = false;
+
+  mojo::Receiver<app_swap_playback::mojom::PlaybackRenderer> receiver_;
+};
+
+#endif  // CHROME_SERVICES_APP_SWAP_PLAYBACK_APP_SWAP_PLAYBACK_SERVICE_H_
diff --git a/chrome/services/app_swap_playback/public/mojom/BUILD.gn b/chrome/services/app_swap_playback/public/mojom/BUILD.gn
