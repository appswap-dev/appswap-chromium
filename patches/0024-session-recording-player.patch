@@ -0,0 +1,135 @@
+// Copyright 2026 The AppSwap Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_APP_SWAP_APP_SWAP_SESSION_RECORDING_READER_H_
+#define CHROME_BROWSER_APP_SWAP_APP_SWAP_SESSION_RECORDING_READER_H_
+
+#include <cstdint>
+#include <memory>
+#include <string>
+#include <vector>
+
+#include "base/files/file_path.h"
+#include "base/functional/callback.h"
+#include "base/memory/raw_ptr.h"
+#include "base/memory/scoped_refptr.h"
+#include "base/memory/weak_ptr.h"
+#include "base/task/sequenced_task_runner.h"
+#include "chrome/services/app_swap_playback/public/mojom/app_swap_playback.mojom.h"
+#include "ui/gfx/geometry/size.h"
+
+// Reads back one session recording written by AppSwapSessionRecordingWriter
+// for playback: builds a lightweight index of where each captured commit's
+// layer records live on disk (Index()), then re-reads and renders one
+// commit at a time on demand (RenderFrame()) -- so scrubbing through a long
+// recording never requires decoding every frame before the one actually
+// being displayed.
+//
+// All disk I/O runs on a dedicated SequencedTaskRunner (mirroring
+// AppSwapSessionRecordingWriter's own threading convention). `this` must
+// outlive every in-flight callback; both Index() and RenderFrame() are
+// safe to call only while a previous call of the same method isn't still
+// pending (the intended caller, AppSwapRecordingsPageHandler, only ever
+// has one recording open and one frame request in flight at a time).
+class AppSwapSessionRecordingReader {
+ public:
+  // One entry from navigations.jsonl (see AppSwapSessionRecordingWriter::
+  // WriteNavigation()) -- `package_name`/`version` are both empty for a
+  // plain, non-AppSwap-routed page.
+  struct NavigationEvent {
+    int64_t time_ms = 0;
+    std::string url;
+    std::string package_name;
+    std::string version;
+  };
+
+  // `playback_service` must outlive this reader (and every callback it's
+  // given) -- owned by whoever constructs this reader, typically
+  // AppSwapRecordingsPageHandler's lazily-launched
+  // mojo::Remote<PlaybackRenderer>.
+  AppSwapSessionRecordingReader(
+      const base::FilePath& session_dir,
+      app_swap_playback::mojom::PlaybackRenderer* playback_service);
+  ~AppSwapSessionRecordingReader();
+
+  AppSwapSessionRecordingReader(const AppSwapSessionRecordingReader&) =
+      delete;
+  AppSwapSessionRecordingReader& operator=(
+      const AppSwapSessionRecordingReader&) = delete;
+
+  // Scans every segment file once and builds the in-memory frame index.
+  // `success` is false if the session directory couldn't be read at all;
+  // an otherwise-empty recording (e.g. stopped immediately) is still a
+  // successful, zero-frame Index().
+  using IndexCallback =
+      base::OnceCallback<void(bool success,
+                              std::vector<int64_t> frame_timestamps_ms,
+                              std::vector<NavigationEvent> navigations)>;
+  void Index(IndexCallback callback);
+
+  // Renders the frame at `frame_ordinal` (an index into the
+  // frame_timestamps_ms Index() returned) and returns the composited
+  // bitmap, or null on any failure (out-of-range ordinal, a disk read
+  // error, or the playback service itself failing to render). Must be
+  // called only after Index() has completed successfully.
+  using RenderFrameCallback =
+      base::OnceCallback<void(app_swap_playback::mojom::FrameBitmapPtr)>;
+  void RenderFrame(uint32_t frame_ordinal, RenderFrameCallback callback);
+
+ private:
+  // Where one layer's full record lives in one segment file -- enough to
+  // re-read and fully parse it later without re-scanning from the start.
+  struct LayerRecordLocation {
+    int segment_index = 0;
+    int64_t record_offset = 0;  // offset of the record's own length prefix
+  };
+
+  struct IndexedFrame {
+    int64_t capture_time_ms = 0;
+    std::vector<LayerRecordLocation> layers;  // already in draw order
+  };
+
+  struct IndexResult {
+    IndexResult();
+    IndexResult(IndexResult&&);
+    IndexResult& operator=(IndexResult&&);
+    ~IndexResult();
+
+    bool success = false;
+    std::vector<IndexedFrame> frames;  // sorted by frame_index
+    std::vector<NavigationEvent> navigations;
+  };
+
+  // Runs on task_runner_.
+  static IndexResult BuildIndex(const base::FilePath& session_dir);
+  void OnIndexed(IndexCallback callback, IndexResult result);
+
+  // Runs on task_runner_. Reads and fully parses every layer record for
+  // one frame, computing that frame's composite viewport size (the union
+  // bounding box of each layer's transformed bounds) along the way.
+  struct ReadFrameResult {
+    ReadFrameResult();
+    ReadFrameResult(ReadFrameResult&&);
+    ReadFrameResult& operator=(ReadFrameResult&&);
+    ~ReadFrameResult();
+
+    std::vector<app_swap_playback::mojom::LayerFramePtr> layers;
+    gfx::Size viewport_size;
+  };
+  static ReadFrameResult ReadFrameLayers(const base::FilePath& session_dir,
+                                        IndexedFrame frame);
+  void OnFrameLayersRead(RenderFrameCallback callback,
+                        ReadFrameResult result);
+
+  base::FilePath session_dir_;
+  raw_ptr<app_swap_playback::mojom::PlaybackRenderer> playback_service_;
+  scoped_refptr<base::SequencedTaskRunner> task_runner_;
+
+  // Populated once Index() completes; empty (and unused) before that.
+  std::vector<IndexedFrame> frames_;
+
+  base::WeakPtrFactory<AppSwapSessionRecordingReader> weak_factory_{this};
+};
+
+#endif  // CHROME_BROWSER_APP_SWAP_APP_SWAP_SESSION_RECORDING_READER_H_
