+// Copyright 2026 The AppSwap Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/services/app_swap_playback/app_swap_playback_service.h"
+
+#include <utility>
+
+#include <map>
+#include <memory>
+
+#include "base/compiler_specific.h"
+#include "base/containers/span.h"
+#include "cc/paint/image_transfer_cache_entry.h"
+#include "cc/paint/paint_op_buffer.h"
+#include "cc/paint/paint_op_capture_serializer.h"
+#include "cc/paint/transfer_cache_deserialize_helper.h"
+#include "cc/paint/transfer_cache_entry.h"
+#include "chrome/services/app_swap_playback/public/mojom/app_swap_playback_bitmap.mojom.h"
+#include "mojo/public/cpp/base/big_buffer.h"
+#include "third_party/skia/include/core/SkBitmap.h"
+#include "third_party/skia/include/core/SkCanvas.h"
+#include "third_party/skia/include/core/SkImageInfo.h"
+#include "third_party/skia/include/core/SkSurface.h"
+#include "third_party/skia/include/gpu/GpuTypes.h"
+#include "third_party/skia/include/gpu/ganesh/SkSurfaceGanesh.h"
+#include "third_party/skia/include/gpu/ganesh/gl/GrGLDirectContext.h"
+#include "third_party/skia/include/gpu/ganesh/gl/GrGLInterface.h"
+#include "ui/gfx/geometry/skia_conversions.h"
+#include "ui/gl/gl_context.h"
+#include "ui/gl/gl_surface.h"
+#include "ui/gl/gl_version_info.h"
+#include "ui/gl/gpu_preference.h"
+#include "ui/gl/init/create_gr_gl_interface.h"
+#include "ui/gl/init/gl_factory.h"
+
+namespace {
+
+// Parses one layer's `imagedata` blob (see cc/paint/
+// paint_op_capture_serializer.h's SerializedPaintOpBuffer comment for the
+// [count][id,len,bytes]* format RealImageProvider produces at capture
+// time) and serves the resulting cc::ServiceImageTransferCacheEntry
+// instances back out through the TransferCacheDeserializeHelper interface
+// PaintOpReader expects. Constructed fresh per layer, matching this whole
+// pipeline's "one buffer, one deserialize pass, nothing persisted across
+// calls" convention (same as NullTransferCacheDeserializeHelper in
+// cc/paint/paint_op_capture_serializer.cc, which this replaces here).
+// Deserialize() needs a live GrDirectContext -- this service is the only
+// point downstream of capture that has one.
+class PlaybackTransferCacheDeserializeHelper
+    : public cc::TransferCacheDeserializeHelper {
+ public:
+  PlaybackTransferCacheDeserializeHelper(base::span<const uint8_t> imagedata,
+                                         GrDirectContext* gr_context) {
+    size_t pos = 0;
+    if (imagedata.size() < sizeof(uint32_t)) {
+      return;
+    }
+    uint32_t count;
+    base::byte_span_from_ref(count).copy_from(
+        imagedata.subspan(pos, sizeof(count)));
+    pos += sizeof(count);
+
+    for (uint32_t i = 0; i < count; ++i) {
+      if (imagedata.size() - pos < 2 * sizeof(uint32_t)) {
+        break;
+      }
+      uint32_t id;
+      base::byte_span_from_ref(id).copy_from(
+          imagedata.subspan(pos, sizeof(id)));
+      pos += sizeof(id);
+      uint32_t len;
+      base::byte_span_from_ref(len).copy_from(
+          imagedata.subspan(pos, sizeof(len)));
+      pos += sizeof(len);
+      if (imagedata.size() - pos < len) {
+        break;
+      }
+      base::span<const uint8_t> entry_bytes = imagedata.subspan(pos, len);
+      pos += len;
+
+      auto entry = std::make_unique<cc::ServiceImageTransferCacheEntry>();
+      if (entry->Deserialize(gr_context, /*graphite_recorder=*/nullptr,
+                             entry_bytes)) {
+        entries_[id] = std::move(entry);
+      }
+    }
+  }
+
+  // cc::TransferCacheDeserializeHelper:
+  void CreateLocalEntry(
+      uint32_t id,
+      std::unique_ptr<cc::ServiceTransferCacheEntry> entry) override {
+    entries_[id] = std::move(entry);
+  }
+
+ private:
+  cc::ServiceTransferCacheEntry* GetEntryInternal(
+      cc::TransferCacheEntryType type,
+      uint32_t id) override {
+    auto it = entries_.find(id);
+    if (it == entries_.end() || it->second->Type() != type) {
+      return nullptr;
+    }
+    return it->second.get();
+  }
+
+  std::map<uint32_t, std::unique_ptr<cc::ServiceTransferCacheEntry>>
+      entries_;
+};
+
+}  // namespace
+
+AppSwapPlaybackService::AppSwapPlaybackService(
+    mojo::PendingReceiver<app_swap_playback::mojom::PlaybackRenderer>
+        receiver)
+    : receiver_(this, std::move(receiver)) {}
+
+AppSwapPlaybackService::~AppSwapPlaybackService() = default;
+
+bool AppSwapPlaybackService::EnsureGaneshInitialized() {
+  if (gr_context_) {
+    return true;
+  }
+  if (ganesh_init_failed_) {
+    return false;
+  }
+
+  // Mirrors cc/paint/paintop_disk_roundtrip_tool.cc's
+  // RenderBitmapWithGanesh() -- see this class's header comment for why
+  // this is safe here (a fresh, dedicated process per launch) even though
+  // InitializeGLOneOff() is a one-shot-per-process operation elsewhere.
+  // The offscreen surface here is a fixed 1x1 dummy just to satisfy
+  // context creation -- actual rendering always happens on a separate,
+  // per-RenderFrame() SkSurface sized to that frame's own viewport.
+  gl::GLDisplay* display =
+      gl::init::InitializeGLOneOff(gl::GpuPreference::kDefault);
+  if (!display) {
+    ganesh_init_failed_ = true;
+    return false;
+  }
+
+  gl_surface_ = gl::init::CreateOffscreenGLSurface(display, gfx::Size(1, 1));
+  if (!gl_surface_) {
+    ganesh_init_failed_ = true;
+    return false;
+  }
+
+  gl_context_ = gl::init::CreateGLContext(
+      /*share_group=*/nullptr, gl_surface_.get(), gl::GLContextAttribs());
+  if (!gl_context_ || !gl_context_->MakeCurrent(gl_surface_.get())) {
+    ganesh_init_failed_ = true;
+    return false;
+  }
+
+  const gl::GLVersionInfo* version_info = gl_context_->GetVersionInfo();
+  if (!version_info) {
+    ganesh_init_failed_ = true;
+    return false;
+  }
+  sk_sp<GrGLInterface> gl_interface =
+      gl::init::CreateGrGLInterface(*version_info);
+  if (!gl_interface) {
+    ganesh_init_failed_ = true;
+    return false;
+  }
+
+  gr_context_ = GrDirectContexts::MakeGL(std::move(gl_interface));
+  if (!gr_context_) {
+    ganesh_init_failed_ = true;
+    return false;
+  }
+  return true;
+}
+
+void AppSwapPlaybackService::RenderFrame(
+    std::vector<app_swap_playback::mojom::LayerFramePtr> layers,
+    const gfx::Size& viewport_size,
+    RenderFrameCallback callback) {
+  if (viewport_size.IsEmpty() || !EnsureGaneshInitialized()) {
+    std::move(callback).Run(nullptr);
+    return;
+  }
+
+  sk_sp<SkSurface> surface = SkSurfaces::RenderTarget(
+      gr_context_.get(), skgpu::Budgeted::kNo,
+      SkImageInfo::MakeN32Premul(viewport_size.width(),
+                                 viewport_size.height()));
+  if (!surface) {
+    std::move(callback).Run(nullptr);
+    return;
+  }
+
+  // Flat painter's-algorithm composite: each layer is already in draw
+  // order (see paint_op_recording.mojom's OnPaintOpFrame comment), so
+  // simply playing them back in array order, each positioned by its own
+  // transform, reproduces correct position and stacking -- see
+  // app_swap_playback.mojom's own comment for the known limitation this
+  // doesn't handle (no per-layer clip against siblings, no effect-tree
+  // opacity/blend modes).
+  SkCanvas* canvas = surface->getCanvas();
+  canvas->clear(SK_ColorWHITE);
+  for (const auto& layer : layers) {
+    PlaybackTransferCacheDeserializeHelper transfer_cache_helper(
+        base::span(layer->imagedata), gr_context_.get());
+    sk_sp<cc::PaintOpBuffer> buffer = cc::DeserializePaintOpBufferForPlayback(
+        base::span(layer->paintops), base::span(layer->strikedata),
+        &transfer_cache_helper);
+    if (!buffer) {
+      continue;
+    }
+    canvas->save();
+    canvas->concat(gfx::TransformToSkM44(layer->transform));
+    buffer->Playback(canvas);
+    canvas->restore();
+  }
+
+  // Read back directly as RGBA8/unpremultiplied -- Skia converts during
+  // readPixels() -- so the bytes land in exactly the layout the web
+  // platform's ImageData constructor expects, with no manual
+  // channel-swizzling step on the WebUI side.
+  SkBitmap bitmap;
+  bitmap.allocPixels(SkImageInfo::Make(
+      viewport_size.width(), viewport_size.height(), kRGBA_8888_SkColorType,
+      kUnpremul_SkAlphaType));
+  if (!surface->readPixels(bitmap, 0, 0)) {
+    std::move(callback).Run(nullptr);
+    return;
+  }
+
+  auto result = app_swap_playback::mojom::FrameBitmap::New();
+  result->rgba_pixels = mojo_base::BigBuffer(
+      // SAFETY: `bitmap` was just allocated above with
+      // allocPixels(SkImageInfo::Make(viewport_size...)) and readPixels()
+      // into it succeeded, so getPixels() is a valid pointer to at least
+      // computeByteSize() bytes.
+      UNSAFE_BUFFERS(base::span(static_cast<const uint8_t*>(bitmap.getPixels()),
+                                bitmap.computeByteSize())));
+  result->size = viewport_size;
+  std::move(callback).Run(std::move(result));
+}
