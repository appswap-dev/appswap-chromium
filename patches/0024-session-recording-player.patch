+# Copyright 2026 The AppSwap Authors
+# Use of this source code is governed by a BSD-style license that can be
+# found in the LICENSE file.
+
+import("//mojo/public/tools/bindings/mojom.gni")
+
+# Native-only (browser <-> the playback service child process): the
+# PlaybackRenderer interface and LayerFrame, which uses gfx.mojom.Transform.
+# Deliberately NOT webui_module_path -- that type has no WebUI/TS bindings
+# configured, and the WebUI side never touches LayerFrame/PlaybackRenderer
+# directly anyway (only FrameBitmap, in the separate :bitmap_mojom target
+# below). See app_swap_playback_bitmap.mojom's own comment for the full
+# reasoning -- confirmed by actually hitting the TS generator's
+# "No WebUI bindings found for dependency ... transform.mojom" failure when
+# this was all one target.
+mojom("mojom") {
+  sources = [ "app_swap_playback.mojom" ]
+
+  # This interface only ever crosses between two native processes (the
+  # browser's page handler/reader and the playback service) -- nothing here
+  # is consumed from JS/TS (only :bitmap_mojom's FrameBitmap is). Without
+  # this, mojom.gni's auto-generated legacy-JS group for this target tries
+  # to depend on ":bitmap_mojom_js", which doesn't exist because
+  # :bitmap_mojom's webui_module_path skips legacy JS generation entirely --
+  # confirmed by hitting exactly that "Unresolved dependencies" error.
+  cpp_only = true
+
+  public_deps = [
+    ":bitmap_mojom",
+    "//sandbox/policy/mojom",
+    "//ui/gfx/geometry/mojom",
+    "//ui/gfx/mojom",
+  ]
+}
+
+# WebUI-facing: just FrameBitmap, imported by
+# chrome/browser/ui/webui/app_swap_recordings/app_swap_recordings.mojom.
+mojom("bitmap_mojom") {
+  sources = [ "app_swap_playback_bitmap.mojom" ]
+
+  webui_module_path = "/"
+
+  public_deps = [
+    "//mojo/public/mojom/base",
+    "//ui/gfx/geometry/mojom",
+  ]
+}
diff --git a/chrome/services/app_swap_playback/public/mojom/app_swap_playback.mojom b/chrome/services/app_swap_playback/public/mojom/app_swap_playback.mojom
new file mode 100644
index 0000000000000..5c844c3239229
--- /dev/null
+++ b/chrome/services/app_swap_playback/public/mojom/app_swap_playback.mojom
@@ -0,0 +1,56 @@
+// Copyright 2026 The AppSwap Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+module app_swap_playback.mojom;
+
+import "chrome/services/app_swap_playback/public/mojom/app_swap_playback_bitmap.mojom";
+import "sandbox/policy/mojom/sandbox.mojom";
+import "ui/gfx/geometry/mojom/geometry.mojom";
+import "ui/gfx/mojom/transform.mojom";
+
+// One layer's captured content for a single commit -- see
+// cc/paint/paint_op_capture_serializer.h for what `paintops`/`strikedata`/
+// `imagedata` contain (the output of SerializePaintOpBufferForCapture()).
+// Native-only (browser <-> this service) -- see
+// app_swap_playback_bitmap.mojom's own comment for why FrameBitmap had to
+// move out to a separate file/target.
+struct LayerFrame {
+  array<uint8> paintops;
+  array<uint8> strikedata;
+  array<uint8> imagedata;
+  uint32 width;
+  uint32 height;
+  gfx.mojom.Transform transform;
+};
+
+// AppSwap session recording playback: renders one captured commit's worth
+// of layers back into a single composited bitmap. Runs in its own,
+// separate child process (launched on demand via
+// content::ServiceProcessHost::Launch<PlaybackRenderer>()) rather than the
+// browser or the real GPU process, because rendering needs a real Ganesh
+// (GPU) canvas -- captured text round-trips as DrawSlugOp, which only
+// Ganesh/Graphite SkDevices implement -- and standing up a Ganesh context
+// via gl::init::InitializeGLOneOff() is a one-shot-per-process operation
+// that can't be repeated inside a process that's already initialized GL
+// for some other purpose. See cc/paint/paintop_disk_roundtrip_tool.cc's
+// RenderBitmapWithGanesh(), which already proves this exact technique in a
+// standalone tool; this service reuses that sequence almost verbatim,
+// satisfying its one-shot constraint naturally since this is always a
+// fresh process per launch.
+//
+// [ServiceSandbox=kNoSandbox] is a disclosed first-pass simplification --
+// full browser-equivalent rights, not a dedicated GPU-equivalent sandbox
+// (see e.g. sandbox.mojom.Sandbox.kOnDeviceModelExecution /
+// kWebNNModelCompilation for what that would look like). Defining a new
+// sandbox type means touching per-platform policy files, real hardening
+// follow-up work that isn't needed to get a working player.
+[ServiceSandbox=sandbox.mojom.Sandbox.kNoSandbox]
+interface PlaybackRenderer {
+  // Composites `layers` (already in draw order) onto one
+  // `viewport_size`-sized canvas, each positioned by its own `transform`,
+  // and returns the result. Returns a null `bitmap` if rendering fails
+  // (e.g. no usable GPU on this machine, or a malformed layer).
+  RenderFrame(array<LayerFrame> layers, gfx.mojom.Size viewport_size)
+      => (FrameBitmap? bitmap);
+};
diff --git a/chrome/services/app_swap_playback/public/mojom/app_swap_playback_bitmap.mojom b/chrome/services/app_swap_playback/public/mojom/app_swap_playback_bitmap.mojom
new file mode 100644
index 0000000000000..15aec75e41f17
--- /dev/null
+++ b/chrome/services/app_swap_playback/public/mojom/app_swap_playback_bitmap.mojom
@@ -0,0 +1,34 @@
+// Copyright 2026 The AppSwap Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+module app_swap_playback.mojom;
+
+import "mojo/public/mojom/base/big_buffer.mojom";
+import "ui/gfx/geometry/mojom/geometry.mojom";
+
+// Deliberately its own mojom file/target (see app_swap_playback.mojom for
+// the interface this feeds into) so it alone can have `webui_module_path`
+// set: appswap://recordings' own mojom (app_swap_recordings.mojom) needs
+// TS bindings for this struct, but NOT for app_swap_playback.mojom's
+// LayerFrame/PlaybackRenderer, which are purely native-C++-to-C++ (the
+// browser's page handler and reader talking to the playback service child
+// process) and use gfx.mojom.Transform -- a type with no WebUI/TS bindings
+// configured. Putting FrameBitmap in the same webui_module_path target as
+// LayerFrame fails the TS generator outright ("No WebUI bindings found for
+// dependency ... ui/gfx/mojom/transform.mojom"), confirmed by hitting it.
+//
+// A composited frame, ready to display. Raw pixels rather than an encoded
+// image on purpose: both ends of this trip are process-local (WebUI
+// renderer <-> browser <-> the playback service, all on the same
+// machine), so there's no network to economize bytes for, and lossless
+// compression would be real CPU cost paid twice (encode in the service,
+// decode in the WebUI) for no benefit -- exactly the cost that would cap
+// how smooth continuous autoplay can feel.
+struct FrameBitmap {
+  // Tightly packed, RGBA8, unpremultiplied -- exactly the byte layout the
+  // web platform's ImageData constructor expects, so the WebUI side can
+  // hand this straight to `new ImageData(...)` with no conversion step.
+  mojo_base.mojom.BigBuffer rgba_pixels;
+  gfx.mojom.Size size;
+};
