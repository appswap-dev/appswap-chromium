--- /dev/null
+++ b/chrome/browser/app_swap/app_swap_session_recording_reader.cc
@@ -0,0 +1,368 @@
+// Copyright 2026 The AppSwap Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/app_swap/app_swap_session_recording_reader.h"
+
+#include <array>
+#include <map>
+#include <optional>
+#include <string_view>
+#include <utility>
+
+#include "base/files/file.h"
+#include "base/files/file_util.h"
+#include "base/functional/bind.h"
+#include "base/json/json_reader.h"
+#include "base/strings/string_split.h"
+#include "base/task/task_traits.h"
+#include "base/task/thread_pool.h"
+#include "base/values.h"
+#include "chrome/browser/app_swap/app_swap_session_recording_paths.h"
+// FrameBitmap lives in a separate mojom file/target from PlaybackRenderer
+// (see app_swap_playback_bitmap.mojom's own comment for why) -- the header
+// this file includes only forward-declares it, but OnFrameLayersRead()
+// below constructs a real FrameBitmapPtr value (Run(nullptr)), which needs
+// the complete type.
+#include "chrome/services/app_swap_playback/public/mojom/app_swap_playback_bitmap.mojom.h"
+#include "mojo/public/cpp/bindings/callback_helpers.h"
+#include "ui/gfx/geometry/rect_f.h"
+#include "ui/gfx/geometry/size_conversions.h"
+#include "ui/gfx/geometry/transform.h"
+
+namespace {
+
+// One layer record, fully parsed -- the read-side mirror of
+// AppSwapSessionRecordingWriter::BackgroundWriter::WriteFrame()'s record
+// layout (see that function's own comment for the field-by-field format).
+struct ParsedRecord {
+  uint32_t frame_index = 0;
+  int32_t layer_id = 0;
+  int64_t capture_time_ms = 0;
+  uint32_t width = 0;
+  uint32_t height = 0;
+  gfx::Transform transform;
+  std::vector<uint8_t> paintops;
+  std::vector<uint8_t> strikedata;
+  std::vector<uint8_t> imagedata;
+};
+
+std::optional<ParsedRecord> ParseRecordAt(base::File& file, int64_t offset) {
+  uint32_t record_len;
+  if (!file.ReadAndCheck(offset, base::byte_span_from_ref(record_len))) {
+    return std::nullopt;
+  }
+  int64_t pos = offset + sizeof(record_len);
+
+  ParsedRecord result;
+  uint32_t layer_id_u32;
+  std::array<double, 16> transform_col_major;
+  uint32_t paintops_len;
+  uint32_t strikedata_len;
+
+  if (!file.ReadAndCheck(pos, base::byte_span_from_ref(result.frame_index))) {
+    return std::nullopt;
+  }
+  pos += sizeof(result.frame_index);
+
+  if (!file.ReadAndCheck(pos, base::byte_span_from_ref(layer_id_u32))) {
+    return std::nullopt;
+  }
+  pos += sizeof(layer_id_u32);
+  result.layer_id = static_cast<int32_t>(layer_id_u32);
+
+  if (!file.ReadAndCheck(pos,
+                        base::byte_span_from_ref(result.capture_time_ms))) {
+    return std::nullopt;
+  }
+  pos += sizeof(result.capture_time_ms);
+
+  if (!file.ReadAndCheck(pos, base::byte_span_from_ref(result.width))) {
+    return std::nullopt;
+  }
+  pos += sizeof(result.width);
+
+  if (!file.ReadAndCheck(pos, base::byte_span_from_ref(result.height))) {
+    return std::nullopt;
+  }
+  pos += sizeof(result.height);
+
+  if (!file.ReadAndCheck(
+          pos, base::as_writable_byte_span(base::allow_nonunique_obj,
+                                          transform_col_major))) {
+    return std::nullopt;
+  }
+  pos += sizeof(transform_col_major);
+  result.transform = gfx::Transform::ColMajor(base::span(transform_col_major));
+
+  if (!file.ReadAndCheck(pos, base::byte_span_from_ref(paintops_len))) {
+    return std::nullopt;
+  }
+  pos += sizeof(paintops_len);
+  result.paintops.resize(paintops_len);
+  if (!file.ReadAndCheck(pos, base::span(result.paintops))) {
+    return std::nullopt;
+  }
+  pos += paintops_len;
+
+  if (!file.ReadAndCheck(pos, base::byte_span_from_ref(strikedata_len))) {
+    return std::nullopt;
+  }
+  pos += sizeof(strikedata_len);
+  result.strikedata.resize(strikedata_len);
+  if (!file.ReadAndCheck(pos, base::span(result.strikedata))) {
+    return std::nullopt;
+  }
+  pos += strikedata_len;
+
+  uint32_t imagedata_len;
+  if (!file.ReadAndCheck(pos, base::byte_span_from_ref(imagedata_len))) {
+    return std::nullopt;
+  }
+  pos += sizeof(imagedata_len);
+  result.imagedata.resize(imagedata_len);
+  if (!file.ReadAndCheck(pos, base::span(result.imagedata))) {
+    return std::nullopt;
+  }
+
+  return result;
+}
+
+std::vector<AppSwapSessionRecordingReader::NavigationEvent>
+ParseNavigationsFile(const base::FilePath& path) {
+  std::vector<AppSwapSessionRecordingReader::NavigationEvent> result;
+  std::string contents;
+  if (!base::ReadFileToString(path, &contents)) {
+    return result;
+  }
+  for (std::string_view line : base::SplitStringPiece(
+           contents, "\n", base::TRIM_WHITESPACE, base::SPLIT_WANT_NONEMPTY)) {
+    std::optional<base::DictValue> entry = base::JSONReader::ReadDict(
+        line, base::JSON_PARSE_CHROMIUM_EXTENSIONS);
+    if (!entry) {
+      continue;
+    }
+    AppSwapSessionRecordingReader::NavigationEvent event;
+    if (std::optional<double> time_ms = entry->FindDouble("time_ms")) {
+      event.time_ms = static_cast<int64_t>(*time_ms);
+    }
+    if (const std::string* url = entry->FindString("url")) {
+      event.url = *url;
+    }
+    if (const std::string* package_name = entry->FindString("package_name")) {
+      event.package_name = *package_name;
+    }
+    if (const std::string* version = entry->FindString("version")) {
+      event.version = *version;
+    }
+    result.push_back(std::move(event));
+  }
+  return result;
+}
+
+}  // namespace
+
+AppSwapSessionRecordingReader::IndexResult::IndexResult() = default;
+AppSwapSessionRecordingReader::IndexResult::IndexResult(IndexResult&&) =
+    default;
+AppSwapSessionRecordingReader::IndexResult&
+AppSwapSessionRecordingReader::IndexResult::operator=(IndexResult&&) =
+    default;
+AppSwapSessionRecordingReader::IndexResult::~IndexResult() = default;
+
+AppSwapSessionRecordingReader::ReadFrameResult::ReadFrameResult() = default;
+AppSwapSessionRecordingReader::ReadFrameResult::ReadFrameResult(
+    ReadFrameResult&&) = default;
+AppSwapSessionRecordingReader::ReadFrameResult&
+AppSwapSessionRecordingReader::ReadFrameResult::operator=(ReadFrameResult&&) =
+    default;
+AppSwapSessionRecordingReader::ReadFrameResult::~ReadFrameResult() = default;
+
+AppSwapSessionRecordingReader::AppSwapSessionRecordingReader(
+    const base::FilePath& session_dir,
+    app_swap_playback::mojom::PlaybackRenderer* playback_service)
+    : session_dir_(session_dir),
+      playback_service_(playback_service),
+      task_runner_(base::ThreadPool::CreateSequencedTaskRunner(
+          {base::MayBlock(), base::TaskPriority::USER_VISIBLE})) {}
+
+AppSwapSessionRecordingReader::~AppSwapSessionRecordingReader() = default;
+
+// static
+AppSwapSessionRecordingReader::IndexResult
+AppSwapSessionRecordingReader::BuildIndex(const base::FilePath& session_dir) {
+  IndexResult result;
+  if (!base::DirectoryExists(session_dir)) {
+    result.success = false;
+    return result;
+  }
+
+  // Ordered by frame_index -- see paint_op_recording.mojom's OnPaintOpFrame
+  // comment: it's a simple counter incremented once per commit, shared by
+  // every layer of that commit, never reset for the lifetime of one
+  // recording (so it's unique and monotonic within this one session even
+  // though it may not start at 0).
+  std::map<uint32_t, IndexedFrame> frames_by_index;
+
+  for (int segment_index = 0;; ++segment_index) {
+    base::FilePath segment_path =
+        GetAppSwapRecordingSegmentPath(session_dir, segment_index);
+    if (!base::PathExists(segment_path)) {
+      break;
+    }
+    base::File file(segment_path,
+                    base::File::FLAG_OPEN | base::File::FLAG_READ);
+    if (!file.IsValid()) {
+      break;
+    }
+
+    int64_t file_length = file.GetLength();
+    int64_t offset = 0;
+    while (offset < file_length) {
+      // Indexing only ever reads this fixed 16-byte header -- frame_index
+      // and capture_time_ms -- never the paintops/strikedata payload, so
+      // Index() stays cheap (offsets, not payloads) even for a long
+      // recording. record_len is what lets this skip straight to the next
+      // record without decoding anything in between.
+      uint32_t record_len;
+      if (!file.ReadAndCheck(offset, base::byte_span_from_ref(record_len))) {
+        break;
+      }
+      int64_t header_offset = offset + sizeof(record_len);
+      uint32_t frame_index;
+      uint32_t layer_id_unused;
+      int64_t capture_time_ms;
+      if (!file.ReadAndCheck(header_offset,
+                            base::byte_span_from_ref(frame_index)) ||
+          !file.ReadAndCheck(header_offset + sizeof(frame_index),
+                            base::byte_span_from_ref(layer_id_unused)) ||
+          !file.ReadAndCheck(
+              header_offset + sizeof(frame_index) + sizeof(layer_id_unused),
+              base::byte_span_from_ref(capture_time_ms))) {
+        break;
+      }
+
+      IndexedFrame& frame = frames_by_index[frame_index];
+      if (frame.layers.empty()) {
+        frame.capture_time_ms = capture_time_ms;
+      }
+      frame.layers.push_back({segment_index, offset});
+
+      offset += static_cast<int64_t>(sizeof(record_len)) + record_len;
+    }
+  }
+
+  result.frames.reserve(frames_by_index.size());
+  for (auto& entry : frames_by_index) {
+    result.frames.push_back(std::move(entry.second));
+  }
+  result.navigations =
+      ParseNavigationsFile(GetAppSwapRecordingNavigationsPath(session_dir));
+  result.success = true;
+  return result;
+}
+
+void AppSwapSessionRecordingReader::Index(IndexCallback callback) {
+  task_runner_->PostTaskAndReplyWithResult(
+      FROM_HERE, base::BindOnce(&BuildIndex, session_dir_),
+      base::BindOnce(&AppSwapSessionRecordingReader::OnIndexed,
+                     weak_factory_.GetWeakPtr(), std::move(callback)));
+}
+
+void AppSwapSessionRecordingReader::OnIndexed(IndexCallback callback,
+                                              IndexResult result) {
+  bool success = result.success;
+  std::vector<NavigationEvent> navigations = std::move(result.navigations);
+  frames_ = std::move(result.frames);
+
+  std::vector<int64_t> frame_timestamps_ms;
+  frame_timestamps_ms.reserve(frames_.size());
+  for (const IndexedFrame& frame : frames_) {
+    frame_timestamps_ms.push_back(frame.capture_time_ms);
+  }
+  std::move(callback).Run(success, std::move(frame_timestamps_ms),
+                          std::move(navigations));
+}
+
+// static
+AppSwapSessionRecordingReader::ReadFrameResult
+AppSwapSessionRecordingReader::ReadFrameLayers(
+    const base::FilePath& session_dir,
+    IndexedFrame frame) {
+  ReadFrameResult result;
+  gfx::RectF bounds;
+
+  int cached_segment_index = -1;
+  base::File cached_file;
+
+  for (const LayerRecordLocation& location : frame.layers) {
+    if (location.segment_index != cached_segment_index) {
+      cached_file = base::File(
+          GetAppSwapRecordingSegmentPath(session_dir, location.segment_index),
+          base::File::FLAG_OPEN | base::File::FLAG_READ);
+      cached_segment_index = location.segment_index;
+    }
+    if (!cached_file.IsValid()) {
+      continue;
+    }
+
+    std::optional<ParsedRecord> parsed =
+        ParseRecordAt(cached_file, location.record_offset);
+    if (!parsed) {
+      continue;
+    }
+
+    bounds.Union(parsed->transform.MapRect(
+        gfx::RectF(0, 0, parsed->width, parsed->height)));
+
+    auto layer_frame = app_swap_playback::mojom::LayerFrame::New();
+    layer_frame->paintops = std::move(parsed->paintops);
+    layer_frame->strikedata = std::move(parsed->strikedata);
+    layer_frame->imagedata = std::move(parsed->imagedata);
+    layer_frame->width = parsed->width;
+    layer_frame->height = parsed->height;
+    layer_frame->transform = parsed->transform;
+    result.layers.push_back(std::move(layer_frame));
+  }
+
+  // Ignores a non-zero bounds origin (a disclosed simplification -- see
+  // this reader's own header comment and the player plan's "Disclosed
+  // simplifications" section): real captured pages start their root layer
+  // at the origin, so this only matters for exotic content.
+  result.viewport_size = gfx::ToCeiledSize(bounds.size());
+  return result;
+}
+
+void AppSwapSessionRecordingReader::RenderFrame(uint32_t frame_ordinal,
+                                                RenderFrameCallback callback) {
+  if (frame_ordinal >= frames_.size()) {
+    std::move(callback).Run(nullptr);
+    return;
+  }
+  task_runner_->PostTaskAndReplyWithResult(
+      FROM_HERE,
+      base::BindOnce(&ReadFrameLayers, session_dir_, frames_[frame_ordinal]),
+      base::BindOnce(&AppSwapSessionRecordingReader::OnFrameLayersRead,
+                     weak_factory_.GetWeakPtr(), std::move(callback)));
+}
+
+void AppSwapSessionRecordingReader::OnFrameLayersRead(
+    RenderFrameCallback callback,
+    ReadFrameResult result) {
+  if (result.layers.empty()) {
+    std::move(callback).Run(nullptr);
+    return;
+  }
+  // The playback service is a separate child process and can die mid-
+  // request (e.g. running out of memory rendering a frame with many large
+  // images) -- when its end of the pipe drops, mojo destroys this pending
+  // response callback without running it, which is a DCHECK/fatal
+  // ("response callback was destroyed without first either being run or
+  // its corresponding binding being closed"), confirmed by actually
+  // hitting it. Wrapping ensures a dying service fails this one frame
+  // (null bitmap) instead of crashing the browser process.
+  playback_service_->RenderFrame(
+      std::move(result.layers), result.viewport_size,
+      mojo::WrapCallbackWithDefaultInvokeIfNotRun(std::move(callback),
+                                                  nullptr));
+}
