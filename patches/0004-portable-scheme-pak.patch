+bool HandleAppSwapURLRewrite(GURL* url,
+                             content::BrowserContext* browser_context) {
+  // Only handle appswap: URLs; rewrite them to their chrome: equivalent so
+  // the rest of the WebUI machinery is unchanged.
+  if (!url->SchemeIs(content::kAppSwapUIScheme)) {
+    return false;
+  }
+
+  GURL::Replacements replacements;
+  replacements.SetSchemeStr(content::kChromeUIScheme);
+  // The apps catalog and route configuration each have their own WebUI;
+  // route them there instead of the stock chrome://apps page.
+  if (url->host() == "apps") {
+    replacements.SetHostStr("appswap-apps");
+  } else if (url->host() == "routes") {
+    replacements.SetHostStr("appswap-routes");
+  } else if (url->host() == "profiles") {
+    replacements.SetHostStr("appswap-profiles");
+  }
+  *url = url->ReplaceComponents(replacements);
+  return true;
+}
