diff --git a/chrome/tools/build/win/create_portable_archive.py b/chrome/tools/build/win/create_portable_archive.py
new file mode 100644
index 0000000000000..9809f86348038
--- /dev/null
+++ b/chrome/tools/build/win/create_portable_archive.py
@@ -0,0 +1,217 @@
+#!/usr/bin/env python3
+# Copyright 2026 The AppSwap Authors
+# Use of this source code is governed by a BSD-style license that can be
+# found in the LICENSE file.
+"""Create a portable (flat, run-from-anywhere) AppSwap distribution.
+
+This script stages a Chromium build into a single directory that can be copied
+and run from anywhere, using chrome.release -- Chromium's own curated list of
+runtime files -- as the source of truth rather than hard-coding a file list.
+
+The versioned install layout described by chrome.release (Application/<version>/
+etc.) is flattened into the same directory layout Chromium uses for developer
+builds, which the browser already knows how to load from.
+"""
+
+import configparser
+import fnmatch
+import optparse
+import os
+import shutil
+import subprocess
+import sys
+import zipfile
+
+
+def _grant_app_container_access(out_dir):
+    """Grant the AppContainer sandbox read/execute access to the portable tree.
+
+    Chromium's AppContainer sandbox spawns child processes under app-container
+    (S-1-15-2) SIDs, which must be able to read the executable and DLLs. The
+    build output directory carries the required ACE, but a plain copy into a
+    fresh directory does not, so grant it explicitly. On non-Windows hosts
+    this is a no-op.
+    """
+    if sys.platform != 'win32':
+        return
+    for sid in ('S-1-15-2-1', 'S-1-15-2-2'):
+        subprocess.run(
+            [
+                'icacls',
+                out_dir,
+                '/grant',
+                '*{}:(OI)(CI)(RX)'.format(sid),
+                '/T',
+                '/C',
+                '/Q',
+            ],
+            check=False,
+        )
+
+
+_LAUNCHER_NAME = 'Launch AppSwap.cmd'
+_LAUNCHER_CONTENT = (
+    '@echo off\r\n'
+    'rem AppSwap portable launcher. Grants the AppContainer sandbox access\r\n'
+    'rem (zip archives do not preserve ACLs) and starts the browser.\r\n'
+    'cd /d "%~dp0"\r\n'
+    'icacls "%cd%" /grant "*S-1-15-2-1:(OI)(CI)(RX)" /T /C /Q >nul 2>&1\r\n'
+    'icacls "%cd%" /grant "*S-1-15-2-2:(OI)(CI)(RX)" /T /C /Q >nul 2>&1\r\n'
+    'start "" "%~dp0appswap.exe"\r\n'
+)
+
+
+def _write_launcher(out_dir):
+    """Write a launcher that fixes the AppContainer ACL and launches AppSwap.
+
+    Needed because a zip distribution drops the ACL that the AppContainer
+    sandbox requires; the launcher re-grants it on first run.
+    """
+    with open(os.path.join(out_dir, _LAUNCHER_NAME), 'w', newline='') as f:
+        f.write(_LAUNCHER_CONTENT)
+
+
+def _insensiglob(pattern):
+    """Case-insensitive glob over a directory tree.
+
+    configparser lowercases option keys (e.g. 'libEGL.dll' -> 'libegl.dll'),
+    so matches must be case-insensitive. Plain glob.glob already is on Windows,
+    but not on a case-sensitive filesystem, so walk the parent directory and
+    match basenames case-insensitively.
+    """
+    parent = os.path.dirname(pattern)
+    basename = os.path.basename(pattern)
+    if not os.path.isdir(parent):
+        return []
+    matches = []
+    for entry in os.listdir(parent):
+        if fnmatch.fnmatch(entry.lower(), basename.lower()):
+            matches.append(os.path.join(parent, entry))
+    return matches
+
+
+def _portable_subdir(dest):
+    """Turn a chrome.release destination into a flat portable subdirectory.
+
+    The config interpolates %(ChromeDir)s and %(VersionDir)s to empty strings,
+    so values look like '\\', '\\Locales', '\\Extensions\\', etc. We strip the
+    separators and normalize 'Locales' to the lowercase directory the browser
+    actually loads at runtime.
+    """
+    dest = dest.replace('\\', '/').strip('/')
+    if dest.lower() == 'locales':
+        dest = 'locales'
+    return dest
+
+
+def _copy_section(config, section, build_dir, out_dir, verbose):
+    if not config.has_section(section):
+        return 0
+    copied = 0
+    for source in config.options(section):
+        if source.endswith('dir'):
+            continue
+        subdir = _portable_subdir(config.get(section, source))
+        dst_dir = os.path.join(out_dir, subdir) if subdir else out_dir
+        src_pattern = os.path.join(build_dir, source.replace('\\', os.sep))
+        src_paths = _insensiglob(src_pattern)
+        if not src_paths:
+            if verbose:
+                print('  (no matches) {}'.format(source))
+            continue
+        if not os.path.isdir(dst_dir):
+            os.makedirs(dst_dir)
+        for src_path in src_paths:
+            dst_path = os.path.join(dst_dir, os.path.basename(src_path))
+            if not os.path.exists(dst_path):
+                shutil.copy2(src_path, dst_path)
+                copied += 1
+    return copied
+
+
+def main():
+    parser = optparse.OptionParser(usage='create_portable_archive.py [options]')
+    parser.add_option('--build_dir', help='Build output dir (e.g. out/Release)')
+    parser.add_option('--output_dir', help='Where to write the portable tree')
+    parser.add_option('--chrome_release', help='Path to chrome.release')
+    parser.add_option(
+        '--enable_hidpi',
+        default='1',
+        help='Whether to include the HiDPI resource pack.',
+    )
+    parser.add_option(
+        '--include_snapshotblob',
+        default='0',
+        help='Whether to include the V8 snapshot blob.',
+    )
+    parser.add_option(
+        '--include_dxc', default='0', help='Whether to include DXC dlls.'
+    )
+    parser.add_option(
+        '--zip',
+        action='store_true',
+        default=False,
+        help='Zip the portable tree after staging it.',
+    )
+    parser.add_option('-v', '--verbose', action='store_true', default=False)
+
+    (options, _) = parser.parse_args()
+    if not options.build_dir or not options.output_dir or not options.chrome_release:
+        parser.error('--build_dir, --output_dir and --chrome_release are required.')
+
+    options.build_dir = os.path.abspath(options.build_dir)
+    options.output_dir = os.path.abspath(options.output_dir)
+    options.chrome_release = os.path.abspath(options.chrome_release)
+
+    # Interpolate %(ChromeDir)s / %(VersionDir)s to empty so the destination
+    # strings collapse to flat relative paths.
+    config = configparser.ConfigParser(
+        defaults={'ChromeDir': '', 'VersionDir': ''}
+    )
+    config.read(options.chrome_release)
+
+    if os.path.isdir(options.output_dir):
+        shutil.rmtree(options.output_dir)
+    os.makedirs(options.output_dir)
+
+    _grant_app_container_access(options.output_dir)
+
+    total = 0
+    sections = ['GENERAL']
+    if options.enable_hidpi == '1':
+        sections.append('HIDPI')
+    if options.include_snapshotblob == '1':
+        sections.append('SNAPSHOTBLOB')
+    if options.include_dxc == '1':
+        sections.append('DXC')
+    # FFMPEG and GOOGLE_CHROME sections are omitted: FFMPEG only applies to
+    # component ffmpeg builds and GOOGLE_CHROME only to Google-branded builds.
+
+    for section in sections:
+        if options.verbose:
+            print('[{}]'.format(section))
+        total += _copy_section(
+            config, section, options.build_dir, options.output_dir, options.verbose
+        )
+
+    _write_launcher(options.output_dir)
+
+    print('Staged {} files -> {}'.format(total, options.output_dir))
+
+    if options.zip:
+        zip_path = options.output_dir + '.zip'
+        if os.path.exists(zip_path):
+            os.remove(zip_path)
+        with zipfile.ZipFile(
+            zip_path, 'w', compression=zipfile.ZIP_DEFLATED, compresslevel=9
+        ) as zf:
+            for root, _, files in os.walk(options.output_dir):
+                for name in files:
+                    full = os.path.join(root, name)
+                    rel = os.path.relpath(full, options.output_dir)
+                    zf.write(full, rel)
+        print('Wrote {}'.format(zip_path))
+
+
+if __name__ == '__main__':
+    sys.exit(main())
