new file mode 100644
index 0000000000000..40b64ec6f2f32
--- /dev/null
+++ b/chrome/browser/app_swap/app_swap_update_checker.h
@@ -0,0 +1,68 @@
+// Copyright 2026 The AppSwap Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_APP_SWAP_APP_SWAP_UPDATE_CHECKER_H_
+#define CHROME_BROWSER_APP_SWAP_APP_SWAP_UPDATE_CHECKER_H_
+
+#include <optional>
+#include <string>
+#include <vector>
+
+#include "base/memory/weak_ptr.h"
+#include "base/no_destructor.h"
+#include "base/timer/timer.h"
+#include "chrome/browser/app_swap/app_swap_source.h"
+#include "components/prefs/pref_change_registrar.h"
+
+class AppSwapUpdateAvailableTabHelper;
+
+// Periodically re-checks every open tab on a dist-tag-pinned AppSwap app
+// against the registry, and flags (via AppSwapUpdateAvailableTabHelper) any
+// tab whose tag now resolves to a version different from what it's
+// currently running -- not necessarily "newer": a dist-tag can be
+// repointed anywhere, including back to an older version (e.g. rolling
+// back a bad release), and that's just as worth surfacing. Interval is
+// controlled by app_swap::prefs::kUpdateCheckIntervalMinutes.
+//
+// This only drives the UI signal (the Reload button's "Update" pill); it
+// does not itself keep AppSwapArtifactProvider's cache fresh for tabs that
+// never get looked at -- that happens per-navigation instead, see
+// AppSwapArtifactProvider::EnsureFreshThenGetOrDownload.
+class AppSwapUpdateChecker {
+ public:
+  static AppSwapUpdateChecker* GetInstance();
+
+  AppSwapUpdateChecker(const AppSwapUpdateChecker&) = delete;
+  AppSwapUpdateChecker& operator=(const AppSwapUpdateChecker&) = delete;
+
+  // Starts the periodic timer if it isn't already running. Idempotent --
+  // safe to call from any AppSwap-routed-request path, since there's no
+  // single "browser has finished starting up" hook this feature otherwise
+  // needs to be wired into.
+  void EnsureStarted();
+
+  // Runs one check pass immediately, without waiting for (or resetting) the
+  // periodic timer. Safe to call before EnsureStarted() (e.g. from a UI
+  // surface that wants an on-demand refresh, like the version-picker dialog
+  // opening) -- the periodic timer and this are independent triggers of the
+  // same underlying pass.
+  void CheckNow();
+
+ private:
+  friend class base::NoDestructor<AppSwapUpdateChecker>;
+  AppSwapUpdateChecker();
+  ~AppSwapUpdateChecker();
+
+  void RestartTimer();
+  void OnCheckResult(
+      AppSwapSource source,
+      std::vector<base::WeakPtr<AppSwapUpdateAvailableTabHelper>> helpers,
+      std::optional<std::string> registry_version);
+
+  base::RepeatingTimer timer_;
+  PrefChangeRegistrar pref_change_registrar_;
+  bool started_ = false;
+};
+
+#endif  // CHROME_BROWSER_APP_SWAP_APP_SWAP_UPDATE_CHECKER_H_
