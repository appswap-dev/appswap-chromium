+
+class BrowserWindowInterface;
+class TabStripModel;
+
+namespace tabs {
+class TabInterface;
+}  // namespace tabs
+
+// Watches the active tab for an AppSwap "update available" state, so the
+// toolbar Reload button can double as the update affordance instead of a
+// separate icon elsewhere in the UI. Deliberately has no reference to
+// ReloadButton (or any views:: type) -- it lives in
+// chrome/browser/ui/views/app_swap, and ReloadButton (chrome/browser/ui/
+// views/toolbar) is the one that depends on this target, not the other way
+// around, so a ReloadButton pointer here would create a circular target
+// dependency. ReloadButton instead owns one of these, subscribes to
+// AddChangeCallback(), and reacts to changes itself (SetHighlight(),
+// UpdateCachedTooltipText()); ButtonPressed() consults HasPendingUpdate()/
+// PerformUpdate() before falling back to its normal reload/stop handling.
+class AppSwapReloadButtonController : public TabStripModelObserver {
+ public:
+  explicit AppSwapReloadButtonController(BrowserWindowInterface* browser);
+  ~AppSwapReloadButtonController() override;
+
+  AppSwapReloadButtonController(const AppSwapReloadButtonController&) = delete;
+  AppSwapReloadButtonController& operator=(
+      const AppSwapReloadButtonController&) = delete;
+
+  // Whether the active tab currently has an AppSwap update pending.
+  bool HasPendingUpdate() const;
+
+  // The tooltip to show while HasPendingUpdate() is true.
+  std::u16string GetPendingUpdateTooltip() const;
+
+  // Reloads the active tab. A plain reload already re-resolves a dist-tag
+  // source against the registry before serving it (see
+  // AppSwapArtifactProvider::EnsureFreshThenGetOrDownload), so this is
+  // deliberately just a reload -- no update-specific logic needed here.
+  void PerformUpdate();
+
+  // Registers `callback` to run whenever HasPendingUpdate()'s answer (or
+  // its details, e.g. which version) might have changed -- callers should
+  // re-read state and update their own display. Returns a subscription
+  // that unregisters on destruction.
+  base::CallbackListSubscription AddChangeCallback(
+      base::RepeatingClosure callback);
+
+  // TabStripModelObserver:
+  void OnTabStripModelChanged(
+      TabStripModel* tab_strip_model,
+      const TabStripModelChange& change,
+      const TabStripSelectionChange& selection) override;
+  void OnTabChangedAt(tabs::TabInterface* tab,
+                      TabChangeType change_type) override;
+
+ private:
+  // Re-subscribes to the active tab's AppSwapUpdateAvailableTabHelper and
+  // refreshes state from it. Only ever called for an actual tab switch --
+  // never from within the subscription's own callback, since replacing the
+  // subscription from inside a callback currently being invoked by that
+  // same subscription's Notify() would modify the callback list while it's
+  // iterating itself.
+  void SubscribeToActiveTabAndRefresh();
+
+  // Refreshes state from the currently-subscribed tab's helper, without
+  // touching the subscription itself, then notifies our own
+  // change_callbacks_. This is what the subscription's callback is bound
+  // to.
+  void RefreshState();
+
+  raw_ptr<BrowserWindowInterface> browser_;
+
+  // What's currently offered, while pending.
+  std::string app_id_;
+  std::string available_version_;
+
+  base::CallbackListSubscription tab_update_subscription_;
+  base::RepeatingClosureList change_callbacks_;
+};
+
+#endif  // CHROME_BROWSER_UI_VIEWS_APP_SWAP_APP_SWAP_RELOAD_BUTTON_CONTROLLER_H_
