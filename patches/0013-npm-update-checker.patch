+void ReloadButton::OnAppSwapUpdateStateChanged() {
+  if (!appswap_reload_controller_->HasPendingUpdate()) {
+    SetHighlight(std::u16string(), std::nullopt);
+  } else {
+    SetHighlight(u"Update", GetAppSwapUpdateHighlightColor());
+  }
+  UpdateCachedTooltipText();
+  // SetHighlight() alone doesn't touch the icon -- ToolbarButton's icon
+  // color is baked in by UpdateIcon() at the time it's called, not
+  // recomputed per-paint, so it has to be explicitly refreshed here to pick
+  // up GetForegroundColor()'s new answer either way (both showing the
+  // highlight and clearing it change what that answer is). Forgetting this
+  // in the clear branch left the icon showing the *previous* tab's
+  // highlight color until some unrelated state change (e.g. hovering)
+  // forced a repaint.
+  UpdateIcon();
+}
+
+std::optional<SkColor> ReloadButton::GetAppSwapUpdateHighlightColor() const {
+  const ui::ColorProvider* color_provider = GetColorProvider();
+  if (!color_provider) {
+    return std::nullopt;
+  }
+  return color_provider->GetColor(ui::kColorAccent);
+}
+
+std::optional<SkColor> ReloadButton::GetHighlightTextColor() const {
+  if (!appswap_reload_controller_ ||
+      !appswap_reload_controller_->HasPendingUpdate()) {
+    return ToolbarButton::GetHighlightTextColor();
+  }
+  std::optional<SkColor> highlight_color = GetAppSwapUpdateHighlightColor();
+  if (!highlight_color) {
+    return ToolbarButton::GetHighlightTextColor();
+  }
+  // The default HighlightColorAnimation text color is the highlight color
+  // itself (see ToolbarButton::HighlightColorAnimation::GetTextColor()),
+  // which would paint "Update" in the same green as its own pill background.
+  // Use the higher-contrast of black/white against that background instead.
+  return color_utils::GetColorWithMaxContrast(*highlight_color);
+}
+
+SkColor ReloadButton::GetForegroundColor(ButtonState state) const {
+  if (appswap_reload_controller_ &&
+      appswap_reload_controller_->HasPendingUpdate()) {
+    if (std::optional<SkColor> highlight_color =
+            GetAppSwapUpdateHighlightColor()) {
+      return color_utils::GetColorWithMaxContrast(*highlight_color);
+    }
+  }
+  return ToolbarButton::GetForegroundColor(state);
+}
