+// Copyright 2026 The AppSwap Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_APP_SWAP_APP_SWAP_PREFS_H_
+#define CHROME_BROWSER_APP_SWAP_APP_SWAP_PREFS_H_
+
+class PrefRegistrySimple;
+
+namespace app_swap::prefs {
+
+// How often (in minutes) AppSwapUpdateChecker re-checks open tabs' dist-tags
+// against the registry for a newer version. Browser-wide, not per-profile --
+// matches components/performance_manager/user_tuning/prefs.cc's
+// kMemorySaverModeTimeBeforeDiscardInMinutes precedent for a similar
+// local-only interval setting.
+inline constexpr char kUpdateCheckIntervalMinutes[] =
+    "app_swap.update_check_interval_minutes";
+inline constexpr int kDefaultUpdateCheckIntervalMinutes = 10;
+
+void RegisterLocalStatePrefs(PrefRegistrySimple* registry);
+
+}  // namespace app_swap::prefs
+
+#endif  // CHROME_BROWSER_APP_SWAP_APP_SWAP_PREFS_H_
diff --git a/chrome/browser/app_swap/app_swap_update_available_tab_helper.cc b/chrome/browser/app_swap/app_swap_update_available_tab_helper.cc
new file mode 100644
index 0000000000000..85ca0702ccfaf
--- /dev/null
+++ b/chrome/browser/app_swap/app_swap_update_available_tab_helper.cc
@@ -0,0 +1,75 @@
+// Copyright 2026 The AppSwap Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/app_swap/app_swap_update_available_tab_helper.h"
+
+#include "chrome/browser/app_swap/app_swap_route_matcher.h"
+#include "chrome/browser/profiles/profile.h"
+#include "content/public/browser/web_contents.h"
+
+AppSwapUpdateAvailableTabHelper::AppSwapUpdateAvailableTabHelper(
+    content::WebContents* web_contents)
+    : content::WebContentsObserver(web_contents),
+      content::WebContentsUserData<AppSwapUpdateAvailableTabHelper>(
+          *web_contents) {}
+
+AppSwapUpdateAvailableTabHelper::~AppSwapUpdateAvailableTabHelper() = default;
+
+void AppSwapUpdateAvailableTabHelper::SetCommittedVersion(
+    const std::string& version) {
+  committed_version_ = version;
+  change_callbacks_.Notify();
+}
+
+void AppSwapUpdateAvailableTabHelper::SetAvailableVersion(
+    const std::string& version) {
+  available_version_ = version;
+  change_callbacks_.Notify();
+}
+
+void AppSwapUpdateAvailableTabHelper::ClearAvailableVersion() {
+  if (!available_version_) {
+    return;
+  }
+  available_version_.reset();
+  change_callbacks_.Notify();
+}
+
+base::CallbackListSubscription
+AppSwapUpdateAvailableTabHelper::AddChangeCallback(
+    base::RepeatingClosure callback) {
+  return change_callbacks_.Add(std::move(callback));
+}
+
+base::WeakPtr<AppSwapUpdateAvailableTabHelper>
+AppSwapUpdateAvailableTabHelper::GetWeakPtr() {
+  return weak_factory_.GetWeakPtr();
+}
+
+void AppSwapUpdateAvailableTabHelper::PrimaryPageChanged(content::Page& page) {
+  // A new page: any previously-known update no longer applies (it was for
+  // the page we just navigated away from), and no check has run for the new
+  // one yet. AppSwapUpdateChecker will populate it again on its own
+  // schedule if this new page also turns out to be update-checkable.
+  available_version_.reset();
+
+  if (const AppSwapApp* app = FindAppSwapAppForUrl(
+          Profile::FromBrowserContext(web_contents()->GetBrowserContext()),
+          web_contents()->GetLastCommittedURL())) {
+    app_id_ = app->id;
+    // committed_version_ is deliberately left alone here: for an
+    // AppSwap-routed page, the URL loader factory already set it to the
+    // version it actually resolved and served for *this* navigation, and
+    // that happens before this commit callback ever runs (the response has
+    // to be resolved before it can be committed). Resetting it here would
+    // just throw away the value this method exists to preserve.
+  } else {
+    app_id_.reset();
+    committed_version_.reset();
+  }
+
+  change_callbacks_.Notify();
+}
+
+WEB_CONTENTS_USER_DATA_KEY_IMPL(AppSwapUpdateAvailableTabHelper);
diff --git a/chrome/browser/app_swap/app_swap_update_available_tab_helper.h b/chrome/browser/app_swap/app_swap_update_available_tab_helper.h
new file mode 100644
index 0000000000000..9ec98b53f9cf5
--- /dev/null
+++ b/chrome/browser/app_swap/app_swap_update_available_tab_helper.h
@@ -0,0 +1,106 @@
+// Copyright 2026 The AppSwap Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_APP_SWAP_APP_SWAP_UPDATE_AVAILABLE_TAB_HELPER_H_
+#define CHROME_BROWSER_APP_SWAP_APP_SWAP_UPDATE_AVAILABLE_TAB_HELPER_H_
+
+#include <optional>
+#include <string>
+
+#include "base/callback_list.h"
+#include "base/memory/weak_ptr.h"
+#include "content/public/browser/web_contents_observer.h"
+#include "content/public/browser/web_contents_user_data.h"
+
+namespace content {
+class Page;
+}  // namespace content
+
+// Tracks, for a single tab: (1) the exact version its current page actually
+// loaded content from, and (2) whether the dist-tag its AppSwap app is on
+// now resolves to a different version than that (not necessarily newer --
+// see AppSwapUpdateChecker). (1) is set by the URL loader factory as it
+// serves a navigation; deliberately NOT read from
+// AppSwapArtifactProvider::GetResolvedVersionIfCached(), which reflects
+// whatever the tag most recently resolved to *globally* -- another tab
+// refreshing onto a newer version would otherwise make this tab's own chip
+// and Page Info claim a version it never actually loaded. (2) is populated
+// by AppSwapUpdateChecker; read by the toolbar Reload button's "Update"
+// highlight (AppSwapReloadButtonController). Neither is persisted -- purely
+// a live-session signal, re-derived on each navigation/check rather than
+// something that needs to survive a restart.
+class AppSwapUpdateAvailableTabHelper
+    : public content::WebContentsObserver,
+      public content::WebContentsUserData<AppSwapUpdateAvailableTabHelper> {
+ public:
+  ~AppSwapUpdateAvailableTabHelper() override;
+
+  AppSwapUpdateAvailableTabHelper(const AppSwapUpdateAvailableTabHelper&) =
+      delete;
+  AppSwapUpdateAvailableTabHelper& operator=(
+      const AppSwapUpdateAvailableTabHelper&) = delete;
+
+  // The AppSwap app id this tab is currently on, or nullopt if it isn't on
+  // an AppSwap-routed page at all.
+  const std::optional<std::string>& app_id() const { return app_id_; }
+
+  // The exact version this tab's current page actually loaded content
+  // from, or nullopt if that isn't known yet (e.g. the navigation's
+  // artifact resolution hasn't completed). This is what the chip/Page Info
+  // should display and what AppSwapUpdateChecker should diff the registry
+  // against for *this* tab -- not the app's/tag's globally-cached
+  // resolution, which can move out from under this tab via a different
+  // tab's own navigation.
+  const std::optional<std::string>& committed_version() const {
+    return committed_version_;
+  }
+
+  // Called by the URL loader factory once it resolves the artifact actually
+  // being served for this tab's current navigation.
+  void SetCommittedVersion(const std::string& version);
+
+  // The version the tag currently resolves to, if different from what's
+  // running, or nullopt if none is known right now (either they match, or
+  // no check has completed yet).
+  const std::optional<std::string>& available_version() const {
+    return available_version_;
+  }
+
+  // Called by AppSwapUpdateChecker once it confirms the tag now resolves
+  // somewhere different. Runs the change-callback list.
+  void SetAvailableVersion(const std::string& version);
+
+  // Called after a confirmed reload onto that version. Runs the
+  // change-callback list.
+  void ClearAvailableVersion();
+
+  // Registers `callback` to run whenever available_version() changes (set
+  // or cleared). Returns a subscription that unregisters on destruction --
+  // callers (the badge) should hold it only while displaying this tab.
+  base::CallbackListSubscription AddChangeCallback(
+      base::RepeatingClosure callback);
+
+  // Safe to hold across an async gap (e.g. AppSwapUpdateChecker's
+  // in-flight registry query) -- becomes null exactly when this tab (and so
+  // this helper) is destroyed, unlike a raw WebContents pointer.
+  base::WeakPtr<AppSwapUpdateAvailableTabHelper> GetWeakPtr();
+
+ private:
+  friend class content::WebContentsUserData<AppSwapUpdateAvailableTabHelper>;
+  explicit AppSwapUpdateAvailableTabHelper(content::WebContents* web_contents);
+
+  // content::WebContentsObserver:
+  void PrimaryPageChanged(content::Page& page) override;
+
+  std::optional<std::string> app_id_;
+  std::optional<std::string> committed_version_;
+  std::optional<std::string> available_version_;
+  base::RepeatingClosureList change_callbacks_;
+
+  WEB_CONTENTS_USER_DATA_KEY_DECL();
+
+  base::WeakPtrFactory<AppSwapUpdateAvailableTabHelper> weak_factory_{this};
+};
+
+#endif  // CHROME_BROWSER_APP_SWAP_APP_SWAP_UPDATE_AVAILABLE_TAB_HELPER_H_
diff --git a/chrome/browser/app_swap/app_swap_update_checker.cc b/chrome/browser/app_swap/app_swap_update_checker.cc
new file mode 100644
index 0000000000000..4cf2953e84b02
--- /dev/null
+++ b/chrome/browser/app_swap/app_swap_update_checker.cc
@@ -0,0 +1,146 @@
+// Copyright 2026 The AppSwap Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/app_swap/app_swap_update_checker.h"
+
+#include <map>
+#include <utility>
+
+#include "base/functional/bind.h"
+#include "base/no_destructor.h"
+#include "chrome/browser/app_swap/app_swap_artifact_provider.h"
+#include "chrome/browser/app_swap/app_swap_prefs.h"
+#include "chrome/browser/app_swap/app_swap_route_matcher.h"
+#include "chrome/browser/app_swap/app_swap_update_available_tab_helper.h"
+#include "chrome/browser/app_swap/app_swap_version_pin_tab_helper.h"
+#include "chrome/browser/browser_process.h"
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/browser/ui/browser_window/public/browser_window_interface.h"
+#include "chrome/browser/ui/browser_window/public/global_browser_collection.h"
+#include "chrome/browser/ui/tabs/tab_strip_model.h"
+#include "components/prefs/pref_service.h"
+#include "content/public/browser/web_contents.h"
+
+namespace {
+
+// One dist-tag app resolved from one or more open tabs, checked once per
+// tick regardless of how many tabs are on it.
+struct PendingCheck {
+  AppSwapSource source;
+  std::vector<base::WeakPtr<AppSwapUpdateAvailableTabHelper>> helpers;
+};
+
+std::string PendingCheckKey(const AppSwapSource& source) {
+  return source.package_name + "@" + source.version + "@" + source.registry;
+}
+
+}  // namespace
+
+// static
+AppSwapUpdateChecker* AppSwapUpdateChecker::GetInstance() {
+  static base::NoDestructor<AppSwapUpdateChecker> instance;
+  return instance.get();
+}
+
+AppSwapUpdateChecker::AppSwapUpdateChecker() = default;
+AppSwapUpdateChecker::~AppSwapUpdateChecker() = default;
+
+void AppSwapUpdateChecker::EnsureStarted() {
+  if (started_) {
+    return;
+  }
+  started_ = true;
+
+  pref_change_registrar_.Init(g_browser_process->local_state());
+  pref_change_registrar_.Add(
+      app_swap::prefs::kUpdateCheckIntervalMinutes,
+      base::BindRepeating(&AppSwapUpdateChecker::RestartTimer,
+                          base::Unretained(this)));
+  RestartTimer();
+}
+
+void AppSwapUpdateChecker::RestartTimer() {
+  int minutes = g_browser_process->local_state()->GetInteger(
+      app_swap::prefs::kUpdateCheckIntervalMinutes);
+  if (minutes <= 0) {
+    minutes = app_swap::prefs::kDefaultUpdateCheckIntervalMinutes;
+  }
+  timer_.Start(FROM_HERE, base::Minutes(minutes),
+              base::BindRepeating(&AppSwapUpdateChecker::CheckNow,
+                                  base::Unretained(this)));
+}
+
+void AppSwapUpdateChecker::CheckNow() {
+  std::map<std::string, PendingCheck> pending;
+
+  GlobalBrowserCollection::GetInstance()->ForEach(
+      [&](BrowserWindowInterface* browser) {
+        TabStripModel* tab_strip_model = browser->GetTabStripModel();
+        for (int i = 0; i < tab_strip_model->count(); ++i) {
+          content::WebContents* web_contents =
+              tab_strip_model->GetWebContentsAt(i);
+
+          const AppSwapApp* app = FindAppSwapAppForUrl(
+              Profile::FromBrowserContext(web_contents->GetBrowserContext()),
+              web_contents->GetLastCommittedURL());
+          if (!app) {
+            continue;
+          }
+
+          AppSwapSource source = app->ToSource();
+          source.version = GetEffectiveAppSwapVersion(*app, web_contents);
+          // Only a dist-tag can have drifted to a different version under
+          // the same tag; an exact-pinned version is intentionally fixed.
+          if (AppSwapArtifactProvider::IsExactVersion(source.version)) {
+            continue;
+          }
+
+          AppSwapUpdateAvailableTabHelper* helper =
+              AppSwapUpdateAvailableTabHelper::FromWebContents(web_contents);
+          // Nothing meaningful to compare the registry's answer against yet
+          // -- this tab's own navigation hasn't actually resolved an
+          // artifact (shouldn't normally happen for a page that's already
+          // loaded, but skip rather than guess).
+          if (!helper->committed_version()) {
+            continue;
+          }
+
+          PendingCheck& entry = pending[PendingCheckKey(source)];
+          entry.source = source;
+          entry.helpers.push_back(helper->GetWeakPtr());
+        }
+        return true;
+      });
+
+  for (auto& [key, entry] : pending) {
+    AppSwapArtifactProvider::GetInstance()->CheckForNewerVersion(
+        entry.source,
+        base::BindOnce(&AppSwapUpdateChecker::OnCheckResult,
+                       base::Unretained(this), entry.source,
+                       std::move(entry.helpers)));
+  }
+}
+
+void AppSwapUpdateChecker::OnCheckResult(
+    AppSwapSource source,
+    std::vector<base::WeakPtr<AppSwapUpdateAvailableTabHelper>> helpers,
+    std::optional<std::string> registry_version) {
+  if (!registry_version) {
+    return;
+  }
+  // Compared per-tab against that tab's own committed_version(), not one
+  // shared "current resolved" value -- tabs on the same tag can each be
+  // showing a different version (one may have already refreshed onto the
+  // registry's current answer while another hasn't), so whether *this*
+  // helper's tab still needs the pill is a per-tab question. Not
+  // specifically "newer" -- a dist-tag can be repointed anywhere, including
+  // back to an older version (e.g. rolling back a bad release), and that's
+  // just as worth flagging.
+  for (base::WeakPtr<AppSwapUpdateAvailableTabHelper>& helper : helpers) {
+    if (helper && helper->committed_version() &&
+        *helper->committed_version() != *registry_version) {
+      helper->SetAvailableVersion(*registry_version);
+    }
+  }
+}
