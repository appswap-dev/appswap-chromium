diff --git a/chrome/browser/ui/views/app_swap/app_swap_reload_button_controller.cc b/chrome/browser/ui/views/app_swap/app_swap_reload_button_controller.cc
new file mode 100644
index 0000000000000..33702a5c3f987
--- /dev/null
+++ b/chrome/browser/ui/views/app_swap/app_swap_reload_button_controller.cc
@@ -0,0 +1,109 @@
+// Copyright 2026 The AppSwap Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/views/app_swap/app_swap_reload_button_controller.h"
+
+#include "base/functional/bind.h"
+#include "base/strings/utf_string_conversions.h"
+#include "chrome/browser/app_swap/app_swap_update_available_tab_helper.h"
+#include "chrome/browser/ui/browser_window/public/browser_window_interface.h"
+#include "chrome/browser/ui/tabs/tab_strip_model.h"
+#include "content/public/browser/navigation_controller.h"
+#include "content/public/browser/web_contents.h"
+
+AppSwapReloadButtonController::AppSwapReloadButtonController(
+    BrowserWindowInterface* browser)
+    : browser_(browser) {
+  browser_->GetTabStripModel()->AddObserver(this);
+  SubscribeToActiveTabAndRefresh();
+}
+
+AppSwapReloadButtonController::~AppSwapReloadButtonController() {
+  browser_->GetTabStripModel()->RemoveObserver(this);
+}
+
+bool AppSwapReloadButtonController::HasPendingUpdate() const {
+  return !available_version_.empty();
+}
+
+std::u16string AppSwapReloadButtonController::GetPendingUpdateTooltip() const {
+  return u"Update to v" + base::UTF8ToUTF16(available_version_);
+}
+
+void AppSwapReloadButtonController::PerformUpdate() {
+  // Any navigation -- including a plain reload -- re-resolves a dist-tag
+  // source against the registry before serving it (see
+  // AppSwapArtifactProvider::EnsureFreshThenGetOrDownload, called from the
+  // URL loader factory for navigation-type requests), so there's nothing
+  // update-specific left to do here beyond reloading.
+  content::WebContents* web_contents =
+      browser_->GetTabStripModel()->GetActiveWebContents();
+  if (!web_contents) {
+    return;
+  }
+  web_contents->GetController().Reload(content::ReloadType::NORMAL,
+                                       /*check_for_repost=*/false);
+}
+
+base::CallbackListSubscription
+AppSwapReloadButtonController::AddChangeCallback(
+    base::RepeatingClosure callback) {
+  return change_callbacks_.Add(std::move(callback));
+}
+
+void AppSwapReloadButtonController::OnTabStripModelChanged(
+    TabStripModel* tab_strip_model,
+    const TabStripModelChange& change,
+    const TabStripSelectionChange& selection) {
+  if (selection.active_tab_changed()) {
+    SubscribeToActiveTabAndRefresh();
+  }
+}
+
+void AppSwapReloadButtonController::OnTabChangedAt(
+    tabs::TabInterface* tab,
+    TabChangeType change_type) {
+  // The active tab's own content/URL may have changed (e.g. navigated to a
+  // different AppSwap app) without a tab-strip selection change, so its
+  // helper's state may now be stale relative to what we subscribed to --
+  // re-subscribing here (rather than just refreshing) is what actually
+  // re-reads the current values, even though it's the same
+  // WebContents/helper as before.
+  SubscribeToActiveTabAndRefresh();
+}
+
+void AppSwapReloadButtonController::SubscribeToActiveTabAndRefresh() {
+  content::WebContents* web_contents =
+      browser_->GetTabStripModel()->GetActiveWebContents();
+  AppSwapUpdateAvailableTabHelper* helper =
+      web_contents
+          ? AppSwapUpdateAvailableTabHelper::FromWebContents(web_contents)
+          : nullptr;
+  if (!helper) {
+    tab_update_subscription_ = base::CallbackListSubscription();
+    RefreshState();
+    return;
+  }
+
+  tab_update_subscription_ = helper->AddChangeCallback(base::BindRepeating(
+      &AppSwapReloadButtonController::RefreshState, base::Unretained(this)));
+  RefreshState();
+}
+
+void AppSwapReloadButtonController::RefreshState() {
+  content::WebContents* web_contents =
+      browser_->GetTabStripModel()->GetActiveWebContents();
+  AppSwapUpdateAvailableTabHelper* helper =
+      web_contents
+          ? AppSwapUpdateAvailableTabHelper::FromWebContents(web_contents)
+          : nullptr;
+  if (!helper || !helper->app_id() || !helper->available_version()) {
+    app_id_.clear();
+    available_version_.clear();
+  } else {
+    app_id_ = *helper->app_id();
+    available_version_ = *helper->available_version();
+  }
+  change_callbacks_.Notify();
+}
