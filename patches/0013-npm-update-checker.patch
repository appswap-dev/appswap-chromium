+// A small location-bar decoration, positioned right after the version chip
+// (LocationIconView) for an AppSwap-routed page. Hidden entirely unless the
+// active tab's AppSwapUpdateAvailableTabHelper reports a newer version is
+// available under the dist-tag that tab is following. Clicking it opens a
+// small confirm popup offering to reload onto that version.
+class AppSwapUpdateBadgeView : public views::ImageButton,
+                               public TabStripModelObserver {
+  METADATA_HEADER(AppSwapUpdateBadgeView, views::ImageButton)
+
+ public:
+  explicit AppSwapUpdateBadgeView(BrowserWindowInterface* browser);
+  AppSwapUpdateBadgeView(const AppSwapUpdateBadgeView&) = delete;
+  AppSwapUpdateBadgeView& operator=(const AppSwapUpdateBadgeView&) = delete;
+  ~AppSwapUpdateBadgeView() override;
+
+  // TabStripModelObserver:
+  void OnTabStripModelChanged(
+      TabStripModel* tab_strip_model,
+      const TabStripModelChange& change,
+      const TabStripSelectionChange& selection) override;
+  void OnTabChangedAt(tabs::TabInterface* tab,
+                      TabChangeType change_type) override;
+
+  // views::View:
+  void OnThemeChanged() override;
+
+ private:
+  // Re-subscribes to the active tab's AppSwapUpdateAvailableTabHelper (if
+  // any) and recomputes visibility/tooltip from its current state.
+  void UpdateForActiveTab();
+
+  void ButtonPressed();
+
+  // Confirm-popup accept: re-resolves the app's currently-followed dist-tag
+  // fresh and reloads the active tab onto whatever that resolves to now.
+  void AcceptUpdate();
+
+  raw_ptr<BrowserWindowInterface> browser_;
+
+  // What the badge is currently offering, while visible.
+  std::string app_id_;
+  std::string available_version_;
+
+  // Subscribed to only the currently-active tab's helper; replaced (which
+  // unregisters the previous one) on every tab switch by
+  // UpdateForActiveTab().
+  base::CallbackListSubscription tab_update_subscription_;
+};
