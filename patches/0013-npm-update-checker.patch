diff --git a/chrome/browser/ui/views/app_swap/app_swap_update_badge_view.cc b/chrome/browser/ui/views/app_swap/app_swap_update_badge_view.cc
new file mode 100644
index 0000000000000..7385c1fcc7438
--- /dev/null
+++ b/chrome/browser/ui/views/app_swap/app_swap_update_badge_view.cc
@@ -0,0 +1,168 @@
+// Copyright 2026 The AppSwap Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/views/app_swap/app_swap_update_badge_view.h"
+
+#include <memory>
+#include <utility>
+
+#include "base/functional/bind.h"
+#include "base/strings/utf_string_conversions.h"
+#include "chrome/browser/app_swap/app_swap_apps_service.h"
+#include "chrome/browser/app_swap/app_swap_artifact_provider.h"
+#include "chrome/browser/app_swap/app_swap_route_matcher.h"
+#include "chrome/browser/app_swap/app_swap_update_available_tab_helper.h"
+#include "chrome/browser/app_swap/app_swap_version_pin_tab_helper.h"
+#include "chrome/browser/ui/browser_window/public/browser_window_interface.h"
+#include "chrome/browser/ui/tabs/tab_strip_model.h"
+#include "components/vector_icons/vector_icons.h"
+#include "content/public/browser/navigation_controller.h"
+#include "content/public/browser/web_contents.h"
+#include "ui/base/l10n/l10n_util.h"
+#include "ui/base/metadata/metadata_impl_macros.h"
+#include "ui/base/models/dialog_model.h"
+#include "ui/base/models/image_model.h"
+#include "ui/color/color_id.h"
+#include "ui/views/bubble/bubble_dialog_model_host.h"
+#include "ui/views/widget/widget.h"
+
+namespace {
+constexpr int kBadgeIconSize = 16;
+}  // namespace
+
+AppSwapUpdateBadgeView::AppSwapUpdateBadgeView(BrowserWindowInterface* browser)
+    : views::ImageButton(base::BindRepeating(
+          &AppSwapUpdateBadgeView::ButtonPressed, base::Unretained(this))),
+      browser_(browser) {
+  SetVisible(false);
+  SetTooltipText(u"Update available");
+  browser_->GetTabStripModel()->AddObserver(this);
+  UpdateForActiveTab();
+}
+
+AppSwapUpdateBadgeView::~AppSwapUpdateBadgeView() {
+  browser_->GetTabStripModel()->RemoveObserver(this);
+}
+
+void AppSwapUpdateBadgeView::OnTabStripModelChanged(
+    TabStripModel* tab_strip_model,
+    const TabStripModelChange& change,
+    const TabStripSelectionChange& selection) {
+  if (selection.active_tab_changed()) {
+    UpdateForActiveTab();
+  }
+}
+
+void AppSwapUpdateBadgeView::OnTabChangedAt(tabs::TabInterface* tab,
+                                            TabChangeType change_type) {
+  UpdateForActiveTab();
+}
+
+void AppSwapUpdateBadgeView::UpdateForActiveTab() {
+  content::WebContents* web_contents =
+      browser_->GetTabStripModel()->GetActiveWebContents();
+  AppSwapUpdateAvailableTabHelper* helper =
+      web_contents
+          ? AppSwapUpdateAvailableTabHelper::FromWebContents(web_contents)
+          : nullptr;
+  if (!helper) {
+    tab_update_subscription_ = base::CallbackListSubscription();
+    SetVisible(false);
+    return;
+  }
+
+  tab_update_subscription_ = helper->AddChangeCallback(base::BindRepeating(
+      &AppSwapUpdateBadgeView::UpdateForActiveTab, base::Unretained(this)));
+
+  if (!helper->app_id() || !helper->available_version()) {
+    SetVisible(false);
+    return;
+  }
+
+  app_id_ = *helper->app_id();
+  available_version_ = *helper->available_version();
+  SetTooltipText(u"Update available: v" +
+                base::UTF8ToUTF16(available_version_));
+  SetVisible(true);
+}
+
+void AppSwapUpdateBadgeView::OnThemeChanged() {
+  views::ImageButton::OnThemeChanged();
+  SetImageModel(
+      views::Button::STATE_NORMAL,
+      ui::ImageModel::FromVectorIcon(vector_icons::kDownloadIcon,
+                                     ui::kColorAccent, kBadgeIconSize));
+}
+
+void AppSwapUpdateBadgeView::ButtonPressed() {
+  const AppSwapApp* app = FindAppSwapAppById(app_id_);
+  content::WebContents* web_contents =
+      browser_->GetTabStripModel()->GetActiveWebContents();
+  if (!app || !web_contents) {
+    return;
+  }
+
+  AppSwapSource current_source = app->ToSource();
+  current_source.version = GetEffectiveAppSwapVersion(*app, web_contents);
+  std::string current_version =
+      AppSwapArtifactProvider::GetInstance()
+          ->GetResolvedVersionIfCached(current_source)
+          .value_or(current_source.version);
+
+  ui::DialogModel::Builder dialog_builder;
+  dialog_builder.SetTitle(u"Update available")
+      .AddParagraph(ui::DialogModelLabel(base::UTF8ToUTF16(
+          app->package_name + ": v" + available_version_ +
+          " is available (currently running v" + current_version + ")")))
+      .AddOkButton(base::BindOnce(&AppSwapUpdateBadgeView::AcceptUpdate,
+                                  base::Unretained(this)),
+                  ui::DialogModel::Button::Params().SetLabel(u"Reload"))
+      .AddCancelButton(base::DoNothing());
+
+  auto bubble = std::make_unique<views::BubbleDialogModelHost>(
+      dialog_builder.Build(), this, views::BubbleBorder::TOP_RIGHT);
+  views::Widget* widget = views::BubbleDialogDelegate::CreateBubbleDeprecated(
+      std::move(bubble), views::Widget::InitParams::NATIVE_WIDGET_OWNS_WIDGET);
+  widget->Show();
+}
+
+void AppSwapUpdateBadgeView::AcceptUpdate() {
+  content::WebContents* web_contents =
+      browser_->GetTabStripModel()->GetActiveWebContents();
+  AppSwapUpdateAvailableTabHelper* helper =
+      web_contents
+          ? AppSwapUpdateAvailableTabHelper::FromWebContents(web_contents)
+          : nullptr;
+  const AppSwapApp* app = FindAppSwapAppById(app_id_);
+  if (!helper || !app) {
+    return;
+  }
+
+  AppSwapSource source = app->ToSource();
+  // Re-resolve the dist-tag this tab is *currently* following (not the
+  // concrete version this badge already knows about) -- consistent with the
+  // feature's whole point: this tab tracks a moving tag, so a reload should
+  // pick up whatever that tag resolves to right now, not freeze the tab
+  // onto one specific version.
+  source.version = GetEffectiveAppSwapVersion(*app, web_contents);
+
+  AppSwapArtifactProvider* provider = AppSwapArtifactProvider::GetInstance();
+  provider->InvalidateCache(source);
+  provider->GetOrDownload(
+      source,
+      base::BindOnce(
+          [](base::WeakPtr<AppSwapUpdateAvailableTabHelper> helper,
+             base::FilePath dir) {
+            if (dir.empty() || !helper) {
+              return;
+            }
+            helper->web_contents()->GetController().Reload(
+                content::ReloadType::NORMAL, /*check_for_repost=*/false);
+            helper->ClearAvailableVersion();
+          },
+          helper->GetWeakPtr()));
+}
+
+BEGIN_METADATA(AppSwapUpdateBadgeView)
+END_METADATA
