+class Widget;
+}  // namespace views
+
+namespace tabs {
+class TabInterface;
+}  // namespace tabs
+
+// The toolbar entry point for moving the active tab's clock. Opens
+// AppSwapTimeTravelBubbleView, and carries a highlight for as long as that
+// tab is being shown a clock other than the machine's own -- the page gives
+// no other sign, and a tab quietly running an hour ahead is exactly the
+// kind of thing to forget about and then debug for twenty minutes.
+//
+// Sits next to the Responsive Lab button and follows the same rule for when
+// it is useful: only an http(s) page has a clock worth overriding.
+class AppSwapTimeTravelButton : public ToolbarButton,
+                                public TabStripModelObserver,
+                                public AppSwapTimeTravelSession::Observer {
+  METADATA_HEADER(AppSwapTimeTravelButton, ToolbarButton)
+
+ public:
+  explicit AppSwapTimeTravelButton(BrowserWindowInterface* browser);
+  AppSwapTimeTravelButton(const AppSwapTimeTravelButton&) = delete;
+  AppSwapTimeTravelButton& operator=(const AppSwapTimeTravelButton&) = delete;
+  ~AppSwapTimeTravelButton() override;
+
+  // TabStripModelObserver:
+  void OnTabStripModelChanged(
+      TabStripModel* tab_strip_model,
+      const TabStripModelChange& change,
+      const TabStripSelectionChange& selection) override;
+  void OnTabChangedAt(tabs::TabInterface* tab,
+                      TabChangeType change_type) override;
+
+  // AppSwapTimeTravelSession::Observer:
+  void OnTimeTravelChanged() override;
+
+  // ToolbarButton:
+  // Overridden because the default highlight text color is the highlight
+  // color itself, which would paint the multiplier in the same color as the
+  // pill behind it.
+  std::optional<SkColor> GetHighlightTextColor() const override;
+
+  // ToolbarButton:
+  // Overridden so the stopwatch is painted in the same color as the
+  // multiplier beside it. Left alone it keeps the ordinary toolbar icon
+  // color, which all but disappears against the pill.
+  SkColor GetForegroundColor(ButtonState state) const override;
+
+ private:
+  // Re-points this button at the active tab's session and refreshes how it
+  // looks. The session is created on demand by the bubble, so this may find
+  // none, which reads the same as an untouched clock.
+  void UpdateForActiveTab();
+
+  // Puts the tab's clock state on the button: a pill whenever anything is
+  // overridden, carrying the multiplier when the clock is not running at
+  // normal speed. Speed is the part that keeps changing while you watch a
+  // page, and the only part a glance at the toolbar can report.
+  void ApplyHighlight(const AppSwapTimeTravelSession* session);
+
+  // The pill's own color, or nullopt before this button has a color
+  // provider.
+  std::optional<SkColor> HighlightColor() const;
+
+  void ButtonPressed();
+
+  // views::BubbleDialogDelegate::CreateBubble() hands back a widget the
+  // caller owns, and the delegate has to outlive it, so this button holds
+  // both and lets go of them together once the bubble closes.
+  void OnBubbleClosed(views::Widget::ClosedReason reason);
+
+  raw_ptr<BrowserWindowInterface> browser_;
+
+  // Whether the pill is currently drawn, which is what decides the icon's
+  // color. Kept rather than re-derived, because GetForegroundColor() is
+  // called during painting and has no session to hand.
+  bool pill_showing_ = false;
+
+  std::unique_ptr<AppSwapTimeTravelBubble> bubble_;
+  std::unique_ptr<views::Widget> bubble_widget_;
+
+  base::ScopedObservation<AppSwapTimeTravelSession,
+                          AppSwapTimeTravelSession::Observer>
+      session_observation_{this};
+
+  base::WeakPtrFactory<AppSwapTimeTravelButton> weak_factory_{this};
+};
