--- /dev/null
+++ b/chrome/browser/ui/views/app_swap/app_swap_time_travel_button.cc
@@ -0,0 +1,184 @@
+// Copyright 2026 The AppSwap Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/views/app_swap/app_swap_time_travel_button.h"
+
+#include "base/functional/bind.h"
+#include "base/strings/stringprintf.h"
+#include "base/strings/utf_string_conversions.h"
+#include "chrome/app/vector_icons/vector_icons.h"
+#include "chrome/browser/ui/browser_window/public/browser_window_interface.h"
+#include "chrome/browser/ui/tabs/tab_strip_model.h"
+#include "chrome/browser/ui/views/app_swap/app_swap_time_travel_bubble.h"
+#include "content/public/browser/web_contents.h"
+#include "ui/base/metadata/metadata_impl_macros.h"
+#include "base/task/single_thread_task_runner.h"
+#include "ui/color/color_id.h"
+#include "ui/color/color_provider.h"
+#include "ui/views/bubble/bubble_dialog_delegate_view.h"
+
+namespace {
+
+// "x60", "x0.1". %g rather than a fixed precision because the dial offers
+// both whole and fractional steps and "x1.500000" reads badly.
+std::u16string RateLabel(double rate) {
+  return u"x" + base::UTF8ToUTF16(base::StringPrintf("%g", rate));
+}
+
+}  // namespace
+
+AppSwapTimeTravelButton::AppSwapTimeTravelButton(
+    BrowserWindowInterface* browser)
+    : ToolbarButton(base::BindRepeating(
+          &AppSwapTimeTravelButton::ButtonPressed,
+          base::Unretained(this))),
+      browser_(browser) {
+  SetVectorIcon(kTimerIcon);
+  SetTooltipText(u"Change this tab's clock");
+  SetAccessibleName(u"Time travel");
+  SetVisible(false);
+  browser_->GetTabStripModel()->AddObserver(this);
+  UpdateForActiveTab();
+}
+
+AppSwapTimeTravelButton::~AppSwapTimeTravelButton() {
+  browser_->GetTabStripModel()->RemoveObserver(this);
+}
+
+void AppSwapTimeTravelButton::OnTabStripModelChanged(
+    TabStripModel* tab_strip_model,
+    const TabStripModelChange& change,
+    const TabStripSelectionChange& selection) {
+  if (selection.active_tab_changed()) {
+    UpdateForActiveTab();
+  }
+}
+
+void AppSwapTimeTravelButton::OnTabChangedAt(tabs::TabInterface* tab,
+                                             TabChangeType change_type) {
+  UpdateForActiveTab();
+}
+
+void AppSwapTimeTravelButton::OnTimeTravelChanged() {
+  UpdateForActiveTab();
+}
+
+void AppSwapTimeTravelButton::UpdateForActiveTab() {
+  content::WebContents* web_contents =
+      browser_->GetTabStripModel()->GetActiveWebContents();
+  if (!web_contents) {
+    session_observation_.Reset();
+    SetVisible(false);
+    return;
+  }
+
+  SetVisible(web_contents->GetLastCommittedURL().SchemeIsHTTPOrHTTPS());
+
+  // Created here rather than waited for. The bubble used to be what brought
+  // a session into existence, which left this button observing nothing until
+  // the user had already opened it once -- so the first speed they picked
+  // never reached the toolbar. A session nobody has touched holds an
+  // identity override, attaches no protocol client and does nothing.
+  AppSwapTimeTravelSession::CreateForWebContents(web_contents);
+  AppSwapTimeTravelSession* session =
+      AppSwapTimeTravelSession::FromWebContents(web_contents);
+  // Only re-subscribed when the session actually changed. This method runs
+  // as the session's own observer callback, so unconditionally dropping and
+  // re-adding the subscription mutated the observer list mid-notification
+  // and called straight back into here -- the browser hung and then died the
+  // first time a multiplier was picked.
+  if (!session_observation_.IsObservingSource(session)) {
+    session_observation_.Reset();
+    if (session) {
+      session_observation_.Observe(session);
+    }
+  }
+  ApplyHighlight(session);
+}
+
+std::optional<SkColor> AppSwapTimeTravelButton::HighlightColor() const {
+  const ui::ColorProvider* colors = GetColorProvider();
+  if (!colors) {
+    return std::nullopt;
+  }
+  return colors->GetColor(ui::kColorSysPrimary);
+}
+
+std::optional<SkColor> AppSwapTimeTravelButton::GetHighlightTextColor() const {
+  const ui::ColorProvider* colors = GetColorProvider();
+  if (!colors) {
+    return ToolbarButton::GetHighlightTextColor();
+  }
+  return colors->GetColor(ui::kColorSysOnPrimary);
+}
+
+SkColor AppSwapTimeTravelButton::GetForegroundColor(ButtonState state) const {
+  if (pill_showing_) {
+    if (const ui::ColorProvider* colors = GetColorProvider()) {
+      return colors->GetColor(ui::kColorSysOnPrimary);
+    }
+  }
+  return ToolbarButton::GetForegroundColor(state);
+}
+
+void AppSwapTimeTravelButton::ApplyHighlight(
+    const AppSwapTimeTravelSession* session) {
+  if (!session || session->current().IsIdentity()) {
+    pill_showing_ = false;
+    SetHighlight(std::u16string(), std::nullopt);
+    // SetHighlight() does not touch the icon: ToolbarButton bakes the icon
+    // color in at UpdateIcon() time rather than recomputing it per paint, so
+    // it has to be asked again whenever GetForegroundColor()'s answer
+    // changes -- in both directions.
+    UpdateIcon();
+    return;
+  }
+  // No color of its own: the default highlight is the neutral toolbar pill,
+  // which says "this tab is not on the real clock" without competing with
+  // the reload button's own pill for attention.
+  // A color, not nullopt: the default highlight leaves the pill invisible
+  // here, and passing one is also what makes the label paint. Empty text
+  // still gets the pill, which is the signal for a date or time override
+  // with the clock running at normal speed.
+  const double rate = session->current().rate;
+  pill_showing_ = true;
+  SetHighlight(rate == 1.0 ? std::u16string() : RateLabel(rate),
+               HighlightColor());
+  UpdateIcon();
+}
+
+void AppSwapTimeTravelButton::ButtonPressed() {
+  if (bubble_widget_ && !bubble_widget_->IsClosed()) {
+    bubble_widget_->CloseWithReason(views::Widget::ClosedReason::kUnspecified);
+    return;
+  }
+  content::WebContents* web_contents =
+      browser_->GetTabStripModel()->GetActiveWebContents();
+  if (!web_contents) {
+    return;
+  }
+  bubble_ = std::make_unique<AppSwapTimeTravelBubble>(this, web_contents);
+  bubble_widget_ = views::BubbleDialogDelegate::CreateBubble(
+      bubble_.get(),
+      base::BindOnce(&AppSwapTimeTravelButton::OnBubbleClosed,
+                     weak_factory_.GetWeakPtr()));
+  bubble_widget_->Show();
+}
+
+void AppSwapTimeTravelButton::OnBubbleClosed(
+    views::Widget::ClosedReason reason) {
+  // Deleted next turn rather than here: this runs from inside the widget's
+  // own close, and the delegate has to outlive it.
+  if (bubble_widget_) {
+    base::SingleThreadTaskRunner::GetCurrentDefault()->DeleteSoon(
+        FROM_HERE, std::move(bubble_widget_));
+  }
+  if (bubble_) {
+    base::SingleThreadTaskRunner::GetCurrentDefault()->DeleteSoon(
+        FROM_HERE, std::move(bubble_));
+  }
+}
+
+BEGIN_METADATA(AppSwapTimeTravelButton)
+END_METADATA
