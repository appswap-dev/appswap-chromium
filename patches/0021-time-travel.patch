index 0000000000000..a9d424ec6b900
--- /dev/null
+++ b/chrome/browser/app_swap/app_swap_devtools_client.cc
@@ -0,0 +1,125 @@
+// Copyright 2026 The AppSwap Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/app_swap/app_swap_devtools_client.h"
+
+#include <string_view>
+#include <utility>
+
+#include "base/containers/span.h"
+#include "base/json/json_reader.h"
+#include "base/json/json_writer.h"
+#include "base/strings/string_view_util.h"
+#include "content/public/browser/web_contents.h"
+
+AppSwapDevToolsClient::AppSwapDevToolsClient(
+    content::WebContents* web_contents) {
+  scoped_refptr<content::DevToolsAgentHost> agent_host =
+      content::DevToolsAgentHost::GetOrCreateFor(web_contents);
+  if (agent_host && agent_host->AttachClient(this)) {
+    agent_host_ = std::move(agent_host);
+  }
+  // Otherwise agent_host_ stays null and this client is inert -- attaching
+  // can legitimately be refused (see DevToolsAgentHost::AttachClient), and
+  // the features built on this are all optional extras, so this is not
+  // treated as an error.
+}
+
+AppSwapDevToolsClient::~AppSwapDevToolsClient() {
+  Detach();
+}
+
+void AppSwapDevToolsClient::SendCommand(const std::string& method,
+                                        base::DictValue params,
+                                        CommandCallback callback) {
+  if (!agent_host_) {
+    if (callback) {
+      std::move(callback).Run(std::nullopt);
+    }
+    return;
+  }
+
+  const int command_id = ++last_command_id_;
+  base::DictValue command;
+  command.Set("id", command_id);
+  command.Set("method", method);
+  command.Set("params", std::move(params));
+
+  if (callback) {
+    pending_commands_[command_id] = std::move(callback);
+  }
+
+  const std::string json = base::WriteJson(command).value_or("");
+  agent_host_->DispatchProtocolMessage(this, base::as_byte_span(json));
+}
+
+void AppSwapDevToolsClient::DispatchProtocolMessage(
+    content::DevToolsAgentHost* agent_host,
+    base::span<const uint8_t> message) {
+  std::optional<base::Value> parsed =
+      base::JSONReader::Read(base::as_string_view(message),
+                             base::JSON_REPLACE_INVALID_CHARACTERS);
+  if (!parsed || !parsed->is_dict()) {
+    return;
+  }
+  base::DictValue& dict = parsed->GetDict();
+
+  // A message carrying an id is a reply to one of our own commands;
+  // anything else with a method is an unsolicited event.
+  const std::optional<int> id = dict.FindInt("id");
+  if (!id.has_value()) {
+    const std::string* method = dict.FindString("method");
+    if (method && event_callback_) {
+      // DictValue is move-only, so a ternary over "the params we have" and
+      // "an empty one" can't share a type -- hence the empty local.
+      const base::DictValue empty_params;
+      const base::DictValue* params = dict.FindDict("params");
+      event_callback_.Run(*method, params ? *params : empty_params);
+    }
+    return;
+  }
+
+  auto it = pending_commands_.find(*id);
+  if (it == pending_commands_.end()) {
+    return;
+  }
+  CommandCallback callback = std::move(it->second);
+  pending_commands_.erase(it);
+
+  if (dict.FindDict("error")) {
+    std::move(callback).Run(std::nullopt);
+    return;
+  }
+  base::DictValue* result = dict.FindDict("result");
+  std::move(callback).Run(result ? std::make_optional(result->Clone())
+                                 : std::make_optional(base::DictValue()));
+}
+
+void AppSwapDevToolsClient::AgentHostClosed(
+    content::DevToolsAgentHost* agent_host) {
+  // The host is already gone, so DetachClient() would be both unnecessary
+  // and wrong -- drop it first, then let Detach() fail the pending
+  // commands that will now never be answered.
+  agent_host_ = nullptr;
+  Detach();
+}
+
+std::string AppSwapDevToolsClient::GetTypeForMetrics() {
+  return "Other";
+}
+
+void AppSwapDevToolsClient::Detach() {
+  if (agent_host_) {
+    agent_host_->DetachClient(this);
+    agent_host_ = nullptr;
+  }
+
+  // Moved out first: a callback is free to destroy this object, and
+  // iterating the member map across that would be a use-after-free.
+  std::map<int, CommandCallback> pending = std::move(pending_commands_);
+  pending_commands_.clear();
+  for (auto& [id, callback] : pending) {
+    std::move(callback).Run(std::nullopt);
+  }
+}
