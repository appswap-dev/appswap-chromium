--- /dev/null
+++ b/chrome/browser/ui/views/app_swap/app_swap_time_travel_bubble.cc
@@ -0,0 +1,304 @@
+// Copyright 2026 The AppSwap Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/views/app_swap/app_swap_time_travel_bubble.h"
+
+#include <array>
+#include <memory>
+#include <optional>
+#include <string>
+#include <utility>
+#include <vector>
+
+#include "base/containers/span.h"
+#include "base/functional/bind.h"
+#include "base/strings/string_number_conversions.h"
+#include "base/strings/string_split.h"
+#include "base/strings/stringprintf.h"
+#include "base/strings/utf_string_conversions.h"
+#include "content/public/browser/web_contents.h"
+#include "ui/base/models/simple_combobox_model.h"
+#include "ui/base/mojom/dialog_button.mojom.h"
+#include "ui/views/accessibility/view_accessibility.h"
+#include "ui/views/controls/button/md_text_button.h"
+#include "ui/views/controls/combobox/combobox.h"
+#include "ui/views/controls/label.h"
+#include "ui/views/controls/textfield/textfield.h"
+#include "ui/views/layout/box_layout.h"
+#include "ui/views/layout/layout_provider.h"
+#include "ui/views/view.h"
+
+namespace {
+
+// What the speed control offers. Matches the steps a video player would
+// show, which is the closest thing most people have used to this control.
+constexpr auto kSpeeds = std::to_array<double>(
+    {0.1, 0.25, 0.5, 0.75, 1.0, 1.25, 1.5, 2.0, 3.0, 5.0, 10.0, 60.0});
+
+// Indexed through a span so the reads below are bounds-checked, which
+// -Wunsafe-buffer-usage requires of anything that is not.
+constexpr base::span<const double> Speeds() {
+  return base::span<const double>(kSpeeds);
+}
+
+constexpr int kFieldWidthChars = 12;
+
+std::u16string SpeedLabel(double speed) {
+  if (speed == 1.0) {
+    return u"Normal";
+  }
+  // Trailing zeros read badly on a speed dial: "x1.5", not "x1.500000".
+  return u"x" + base::UTF8ToUTF16(base::StringPrintf("%g", speed));
+}
+
+// "YYYY-MM-DD", the one date format that is unambiguous everywhere.
+std::optional<base::Time> ParseDate(const std::u16string& text) {
+  const std::vector<std::string> parts =
+      base::SplitString(base::UTF16ToUTF8(text), "-", base::TRIM_WHITESPACE,
+                        base::SPLIT_WANT_ALL);
+  if (parts.size() != 3) {
+    return std::nullopt;
+  }
+  base::Time::Exploded exploded = {};
+  if (!base::StringToInt(parts[0], &exploded.year) ||
+      !base::StringToInt(parts[1], &exploded.month) ||
+      !base::StringToInt(parts[2], &exploded.day_of_month)) {
+    return std::nullopt;
+  }
+  // Noon, not midnight: only the date part is ever read back out, and noon
+  // is the hour that survives every daylight-saving transition.
+  exploded.hour = 12;
+  base::Time parsed;
+  if (!base::Time::FromLocalExploded(exploded, &parsed)) {
+    return std::nullopt;
+  }
+  return parsed;
+}
+
+std::u16string FormatDate(base::Time time) {
+  base::Time::Exploded exploded;
+  time.LocalExplode(&exploded);
+  return base::UTF8ToUTF16(base::StringPrintf(
+      "%04d-%02d-%02d", exploded.year, exploded.month, exploded.day_of_month));
+}
+
+// "HH:MM" or "HH:MM:SS", as a duration since midnight.
+std::optional<base::TimeDelta> ParseTimeOfDay(const std::u16string& text) {
+  const std::vector<std::string> parts =
+      base::SplitString(base::UTF16ToUTF8(text), ":", base::TRIM_WHITESPACE,
+                        base::SPLIT_WANT_ALL);
+  if (parts.size() != 2 && parts.size() != 3) {
+    return std::nullopt;
+  }
+  int hours = 0;
+  int minutes = 0;
+  int seconds = 0;
+  if (!base::StringToInt(parts[0], &hours) ||
+      !base::StringToInt(parts[1], &minutes) ||
+      (parts.size() == 3 && !base::StringToInt(parts[2], &seconds))) {
+    return std::nullopt;
+  }
+  if (hours < 0 || hours > 23 || minutes < 0 || minutes > 59 || seconds < 0 ||
+      seconds > 59) {
+    return std::nullopt;
+  }
+  return base::Hours(hours) + base::Minutes(minutes) + base::Seconds(seconds);
+}
+
+std::u16string FormatTimeOfDay(base::TimeDelta time_of_day) {
+  const int total = static_cast<int>(time_of_day.InSeconds());
+  return base::UTF8ToUTF16(base::StringPrintf(
+      "%02d:%02d:%02d", total / 3600, (total / 60) % 60, total % 60));
+}
+
+}  // namespace
+
+AppSwapTimeTravelBubble::AppSwapTimeTravelBubble(
+    views::View* anchor,
+    content::WebContents* web_contents)
+    : views::BubbleDialogDelegate(anchor, views::BubbleBorder::TOP_RIGHT) {
+  SetTitle(u"Time travel");
+  SetButtons(static_cast<int>(ui::mojom::DialogButton::kNone));
+
+  AppSwapTimeTravelSession::CreateForWebContents(web_contents);
+  session_ =
+      AppSwapTimeTravelSession::FromWebContents(web_contents)->GetWeakPtr();
+
+  const views::LayoutProvider* provider = views::LayoutProvider::Get();
+  auto contents = std::make_unique<views::View>();
+  contents->SetLayoutManager(std::make_unique<views::BoxLayout>(
+      views::BoxLayout::Orientation::kVertical, gfx::Insets(),
+      provider->GetDistanceMetric(views::DISTANCE_RELATED_CONTROL_VERTICAL)));
+
+  const int row_spacing =
+      provider->GetDistanceMetric(views::DISTANCE_RELATED_CONTROL_HORIZONTAL);
+
+  // Each row is a label, a control, and where it can be switched off, the
+  // control that switches it off.
+  auto add_row = [&](const std::u16string& label) {
+    views::View* row = contents->AddChildView(std::make_unique<views::View>());
+    row->SetLayoutManager(std::make_unique<views::BoxLayout>(
+        views::BoxLayout::Orientation::kHorizontal, gfx::Insets(),
+        row_spacing));
+    row->AddChildView(std::make_unique<views::Label>(label));
+    return row;
+  };
+
+  views::View* date_row = add_row(u"Date");
+  date_field_ = date_row->AddChildView(std::make_unique<views::Textfield>());
+  date_field_->SetDefaultWidthInChars(kFieldWidthChars);
+  date_field_->SetPlaceholderText(u"YYYY-MM-DD");
+  date_field_->set_controller(this);
+  date_field_->GetViewAccessibility().SetName(u"Date shown to the page");
+  date_row->AddChildView(std::make_unique<views::MdTextButton>(
+      base::BindRepeating(&AppSwapTimeTravelBubble::OnClearDatePressed,
+                          base::Unretained(this)),
+      u"Clear"));
+
+  views::View* time_row = add_row(u"Time");
+  time_field_ = time_row->AddChildView(std::make_unique<views::Textfield>());
+  time_field_->SetDefaultWidthInChars(kFieldWidthChars);
+  time_field_->SetPlaceholderText(u"HH:MM");
+  time_field_->set_controller(this);
+  time_field_->GetViewAccessibility().SetName(
+      u"Time of day shown to the page");
+  time_row->AddChildView(std::make_unique<views::MdTextButton>(
+      base::BindRepeating(&AppSwapTimeTravelBubble::OnClearTimePressed,
+                          base::Unretained(this)),
+      u"Clear"));
+
+  views::View* speed_row = add_row(u"Speed");
+  std::vector<ui::SimpleComboboxModel::Item> items;
+  for (double speed : kSpeeds) {
+    items.emplace_back(SpeedLabel(speed));
+  }
+  speed_ = speed_row->AddChildView(std::make_unique<views::Combobox>(
+      std::make_unique<ui::SimpleComboboxModel>(std::move(items))));
+  speed_->SetCallback(base::BindRepeating(
+      &AppSwapTimeTravelBubble::OnSpeedChanged, base::Unretained(this)));
+  speed_->GetViewAccessibility().SetName(u"How fast the page's clock runs");
+
+  summary_ = contents->AddChildView(std::make_unique<views::Label>());
+  summary_->SetHorizontalAlignment(gfx::ALIGN_LEFT);
+  summary_->SetMultiLine(true);
+
+  contents->AddChildView(std::make_unique<views::MdTextButton>(
+      base::BindRepeating(&AppSwapTimeTravelBubble::OnResetPressed,
+                          base::Unretained(this)),
+      u"Back to the real clock"));
+
+  SetContentsView(std::move(contents));
+  SyncFromSession();
+}
+
+AppSwapTimeTravelBubble::~AppSwapTimeTravelBubble() = default;
+
+void AppSwapTimeTravelBubble::WindowClosing() {
+  date_field_ = nullptr;
+  time_field_ = nullptr;
+  speed_ = nullptr;
+  summary_ = nullptr;
+}
+
+void AppSwapTimeTravelBubble::ContentsChanged(
+    views::Textfield* sender,
+    const std::u16string& new_contents) {
+  Commit();
+}
+
+void AppSwapTimeTravelBubble::OnSpeedChanged() {
+  Commit();
+}
+
+void AppSwapTimeTravelBubble::OnClearDatePressed() {
+  date_field_->SetText(std::u16string());
+  Commit();
+}
+
+void AppSwapTimeTravelBubble::OnClearTimePressed() {
+  time_field_->SetText(std::u16string());
+  Commit();
+}
+
+void AppSwapTimeTravelBubble::OnResetPressed() {
+  if (session_) {
+    session_->Reset();
+  }
+  updating_ = true;
+  date_field_->SetText(std::u16string());
+  time_field_->SetText(std::u16string());
+  updating_ = false;
+  SyncFromSession();
+}
+
+void AppSwapTimeTravelBubble::Commit() {
+  if (updating_ || !session_ || !date_field_) {
+    return;
+  }
+
+  AppSwapTimeTravelSession::Override next;
+  // An empty field means "leave this alone". A field mid-edit that does not
+  // parse yet keeps whatever it had, rather than snapping the page back to
+  // real time on the way to a valid value.
+  const std::u16string date_text(date_field_->GetText());
+  next.date = date_text.empty() ? std::nullopt : ParseDate(date_text);
+  if (!date_text.empty() && !next.date.has_value()) {
+    next.date = session_->current().date;
+  }
+
+  const std::u16string time_text(time_field_->GetText());
+  next.time_of_day =
+      time_text.empty() ? std::nullopt : ParseTimeOfDay(time_text);
+  if (!time_text.empty() && !next.time_of_day.has_value()) {
+    next.time_of_day = session_->current().time_of_day;
+  }
+
+  const std::optional<size_t> index = speed_->GetSelectedIndex();
+  next.rate = index.has_value() ? Speeds()[*index] : 1.0;
+
+  session_->SetOverride(next);
+  SyncFromSession();
+}
+
+void AppSwapTimeTravelBubble::SyncFromSession() {
+  if (!session_ || !date_field_) {
+    return;
+  }
+  const AppSwapTimeTravelSession::Override& current = session_->current();
+
+  updating_ = true;
+  size_t selected = 0;
+  for (size_t i = 0; i < Speeds().size(); ++i) {
+    if (Speeds()[i] == current.rate) {
+      selected = i;
+      break;
+    }
+  }
+  speed_->SetSelectedIndex(selected);
+  // The text fields are only filled in when they are empty. Rewriting them
+  // otherwise would fight the caret while the user is still typing.
+  if (date_field_->GetText().empty() && current.date.has_value()) {
+    date_field_->SetText(FormatDate(*current.date));
+  }
+  if (time_field_->GetText().empty() && current.time_of_day.has_value()) {
+    time_field_->SetText(FormatTimeOfDay(*current.time_of_day));
+  }
+  updating_ = false;
+
+  if (current.IsIdentity()) {
+    summary_->SetText(u"This tab is on the real clock.");
+    return;
+  }
+  std::u16string summary = u"This tab sees ";
+  summary += current.date.has_value() ? FormatDate(*current.date) : u"today";
+  summary += u" at ";
+  summary += current.time_of_day.has_value()
+                 ? FormatTimeOfDay(*current.time_of_day)
+                 : u"the real time";
+  if (current.rate != 1.0) {
+    summary += u", running " + SpeedLabel(current.rate);
+  }
+  summary += u".";
+  summary_->SetText(summary);
+}
