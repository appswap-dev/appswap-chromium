+// Copyright 2026 The AppSwap Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_VIEWS_APP_SWAP_APP_SWAP_TIME_TRAVEL_BUBBLE_H_
+#define CHROME_BROWSER_UI_VIEWS_APP_SWAP_APP_SWAP_TIME_TRAVEL_BUBBLE_H_
+
+#include "base/memory/raw_ptr.h"
+#include "base/memory/weak_ptr.h"
+#include "chrome/browser/app_swap/app_swap_time_travel_session.h"
+#include "ui/views/bubble/bubble_dialog_delegate_view.h"
+#include "ui/views/controls/textfield/textfield_controller.h"
+
+namespace content {
+class WebContents;
+}  // namespace content
+
+namespace views {
+class Combobox;
+class Label;
+class Textfield;
+}  // namespace views
+
+// The controls behind the toolbar's time travel button: a date, a time of
+// day, and how fast the page's clock runs.
+//
+// Each field is independent and each may be left alone. Setting only the
+// date keeps the real time of day and vice versa, which is what makes "the
+// same afternoon, but on the first of the month" expressible without also
+// having to decide what o'clock it is.
+//
+// Edits apply as they are typed, once what is typed parses. There is no OK
+// button on purpose: the whole point is to watch the page react, and a
+// dialog that only commits on close hides exactly that.
+//
+// A BubbleDialogDelegate holding its controls rather than a
+// BubbleDialogDelegateView, which is deprecated and whose friend list is
+// closed to new callers. Whoever creates one owns it and the widget it
+// makes -- see AppSwapTimeTravelButton, which does both.
+class AppSwapTimeTravelBubble : public views::BubbleDialogDelegate,
+                                public views::TextfieldController {
+ public:
+  AppSwapTimeTravelBubble(views::View* anchor,
+                          content::WebContents* web_contents);
+  AppSwapTimeTravelBubble(const AppSwapTimeTravelBubble&) = delete;
+  AppSwapTimeTravelBubble& operator=(const AppSwapTimeTravelBubble&) = delete;
+  ~AppSwapTimeTravelBubble() override;
+
+  // views::WidgetDelegate:
+  //
+  // The widget owns the controls below, and this delegate outlives it by a
+  // turn (see AppSwapTimeTravelButton::OnBubbleClosed). Letting the raw_ptrs
+  // survive the views they point at is a dangling pointer, and the checker
+  // says so; this is the hook that runs while they are still valid.
+  void WindowClosing() override;
+
+  // views::TextfieldController:
+  void ContentsChanged(views::Textfield* sender,
+                       const std::u16string& new_contents) override;
+
+ private:
+  // Reads every control and hands the result to the session.
+  void Commit();
+
+  // Writes the session's current override back into the controls, for when
+  // something other than typing changed it.
+  void SyncFromSession();
+
+  void OnSpeedChanged();
+  void OnClearDatePressed();
+  void OnClearTimePressed();
+  void OnResetPressed();
+
+  base::WeakPtr<AppSwapTimeTravelSession> session_;
+
+  raw_ptr<views::Textfield> date_field_ = nullptr;
+  raw_ptr<views::Textfield> time_field_ = nullptr;
+  raw_ptr<views::Combobox> speed_ = nullptr;
+  raw_ptr<views::Label> summary_ = nullptr;
+
+  // Set while SyncFromSession() is writing the controls, so the changes it
+  // makes are not read straight back out as if the user had typed them.
+  bool updating_ = false;
+};
+
+#endif  // CHROME_BROWSER_UI_VIEWS_APP_SWAP_APP_SWAP_TIME_TRAVEL_BUBBLE_H_
