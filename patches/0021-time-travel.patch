+++ b/chrome/browser/app_swap/app_swap_devtools_client.h
@@ -0,0 +1,85 @@
+// Copyright 2026 The AppSwap Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_APP_SWAP_APP_SWAP_DEVTOOLS_CLIENT_H_
+#define CHROME_BROWSER_APP_SWAP_APP_SWAP_DEVTOOLS_CLIENT_H_
+
+#include <map>
+#include <optional>
+#include <string>
+
+#include "base/functional/callback.h"
+#include "base/memory/scoped_refptr.h"
+#include "base/values.h"
+#include "content/public/browser/devtools_agent_host.h"
+#include "content/public/browser/devtools_agent_host_client.h"
+
+namespace content {
+class WebContents;
+}  // namespace content
+
+// Talks the Chrome DevTools Protocol to one WebContents from the browser
+// process, with no DevTools frontend involved. Send commands, receive
+// replies, subscribe to events; what to say is left to whoever owns one.
+//
+// AppSwap uses the protocol as a general lever on a page from the browser
+// side -- device emulation for Responsive Lab's cells, a clock override for
+// time travel -- so this holds the plumbing every such feature needs and
+// nothing about any of them. Modelled on
+// ExtensionDevToolsClientHost::SendMessageToBackend, which is the same job
+// for the debugger extension API.
+//
+// Attaching costs the user nothing and coexists with them opening real
+// DevTools on the same page: a DevToolsAgentHost supports several attached
+// clients at once.
+class AppSwapDevToolsClient : public content::DevToolsAgentHostClient {
+ public:
+  // A command's reply, or nullopt if it failed, the protocol reported an
+  // error, or the agent host went away before it arrived.
+  using CommandCallback =
+      base::OnceCallback<void(std::optional<base::DictValue> result)>;
+
+  // Every protocol event this client receives, by method name. Repeating,
+  // and may fire at any time while attached.
+  using EventCallback =
+      base::RepeatingCallback<void(const std::string& method,
+                                   const base::DictValue& params)>;
+
+  // Attaches to `web_contents`'s agent host immediately. attached() is
+  // false if that failed (e.g. an embedder policy refused it), in which
+  // case every method below is a safe no-op.
+  explicit AppSwapDevToolsClient(content::WebContents* web_contents);
+  AppSwapDevToolsClient(const AppSwapDevToolsClient&) = delete;
+  AppSwapDevToolsClient& operator=(const AppSwapDevToolsClient&) = delete;
+  ~AppSwapDevToolsClient() override;
+
+  bool attached() const { return agent_host_ != nullptr; }
+
+  void set_event_callback(EventCallback callback) {
+    event_callback_ = std::move(callback);
+  }
+
+  // Sends one protocol command. `callback` may be null for fire-and-forget.
+  void SendCommand(const std::string& method,
+                   base::DictValue params,
+                   CommandCallback callback);
+
+  // content::DevToolsAgentHostClient:
+  void DispatchProtocolMessage(content::DevToolsAgentHost* agent_host,
+                               base::span<const uint8_t> message) override;
+  void AgentHostClosed(content::DevToolsAgentHost* agent_host) override;
+  std::string GetTypeForMetrics() override;
+
+ private:
+  // Detaches from agent_host_ (if attached) and fails every still-pending
+  // command, so no caller is left waiting on a reply that can't arrive.
+  void Detach();
+
+  scoped_refptr<content::DevToolsAgentHost> agent_host_;
+  int last_command_id_ = 0;
+  std::map<int, CommandCallback> pending_commands_;
+  EventCallback event_callback_;
+};
+
+#endif  // CHROME_BROWSER_APP_SWAP_APP_SWAP_DEVTOOLS_CLIENT_H_
diff --git a/chrome/browser/app_swap/app_swap_time_travel_session.cc b/chrome/browser/app_swap/app_swap_time_travel_session.cc
new file mode 100644
index 0000000000000..899827a9e8f1a
--- /dev/null
+++ b/chrome/browser/app_swap/app_swap_time_travel_session.cc
@@ -0,0 +1,351 @@
+// Copyright 2026 The AppSwap Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/app_swap/app_swap_time_travel_session.h"
+
+#include <string>
+#include <utility>
+
+#include "base/json/json_writer.h"
+#include "base/strings/strcat.h"
+#include "chrome/browser/app_swap/app_swap_devtools_client.h"
+#include "content/public/browser/web_contents.h"
+
+namespace {
+
+// The clock patch, injected into every document of the tab before its own
+// scripts run.
+//
+// Installed once per document and then reconfigured in place: the tail of
+// the injected source is a configure() call carrying the current override,
+// so re-injecting with new numbers costs nothing and the captured originals
+// are never captured twice.
+//
+// What it does not do is worth stating. A timer already scheduled keeps the
+// delay it was given, so a rate change only reaches timers created after
+// it. And the whole patch is ordinary JavaScript in the page's own world:
+// a page that squirrels away Date before this runs, or reads the clock from
+// its own server, is not fooled. Both are inherent to patching from inside
+// the page, and the reason the alternative is overriding the renderer's own
+// clock.
+constexpr char kClockScript[] = R"JS(
+(function() {
+  'use strict';
+  if (globalThis.__appSwapClock) { return; }
+
+  const OriginalDate = Date;
+  const originalNow = Date.now.bind(Date);
+  const originalSetTimeout = globalThis.setTimeout.bind(globalThis);
+  const originalSetInterval = globalThis.setInterval.bind(globalThis);
+  const originalPerfNow = performance.now.bind(performance);
+  const originalRaf = globalThis.requestAnimationFrame
+      ? globalThis.requestAnimationFrame.bind(globalThis) : null;
+  const originalCancelRaf = globalThis.cancelAnimationFrame
+      ? globalThis.cancelAnimationFrame.bind(globalThis) : null;
+
+  // config.date is epoch milliseconds whose date part is shown; config.time
+  // is milliseconds since midnight; config.rate scales elapsed time.
+  let config = { date: null, time: null, rate: 1 };
+  let configured = false;
+
+  // Wall clock. anchorFake is what the page should have believed at the
+  // instant anchorReal was taken, so elapsed time is simply scaled from
+  // there and a rate change never makes the clock jump.
+  let anchorReal = originalNow();
+  let anchorFake = anchorReal;
+
+  // Monotonic clock, same shape. Seeded from the real one so installing the
+  // patch does not send performance.now() backwards.
+  let perfAnchorReal = originalPerfNow();
+  let perfAnchorFake = perfAnchorReal;
+
+  // Where the page's clock should read at real time `real`, before any
+  // elapsed time is added. The two overrides compose: with both set you get
+  // that date at that time of day.
+  function baseAt(real) {
+    if (config.date === null && config.time === null) { return real; }
+    const now = new OriginalDate(real);
+    const day = config.date === null ? now : new OriginalDate(config.date);
+    let h = now.getHours(), m = now.getMinutes();
+    let s = now.getSeconds(), ms = now.getMilliseconds();
+    if (config.time !== null) {
+      let rest = config.time;
+      h = Math.floor(rest / 3600000); rest -= h * 3600000;
+      m = Math.floor(rest / 60000); rest -= m * 60000;
+      s = Math.floor(rest / 1000); ms = rest - s * 1000;
+    }
+    return new OriginalDate(day.getFullYear(), day.getMonth(), day.getDate(),
+                            h, m, s, ms).getTime();
+  }
+
+  function fakeNow() {
+    return anchorFake + (originalNow() - anchorReal) * config.rate;
+  }
+
+  function fakePerfNow() {
+    return perfAnchorFake + (originalPerfNow() - perfAnchorReal) * config.rate;
+  }
+
+  const FakeDate = new Proxy(OriginalDate, {
+    construct(target, args, newTarget) {
+      if (args.length === 0) {
+        return Reflect.construct(target, [fakeNow()], newTarget);
+      }
+      return Reflect.construct(target, args, newTarget);
+    },
+    apply(target, thisArg, args) {
+      if (args.length === 0) { return new OriginalDate(fakeNow()).toString(); }
+      return Reflect.apply(target, thisArg, args);
+    },
+    get(target, prop, receiver) {
+      if (prop === 'now') { return () => fakeNow(); }
+      return Reflect.get(target, prop, receiver);
+    },
+  });
+  globalThis.Date = FakeDate;
+
+  globalThis.setTimeout = function(handler, delay, ...args) {
+    const scaled = typeof delay === 'number' ? delay / config.rate : delay;
+    return originalSetTimeout(handler, scaled, ...args);
+  };
+  globalThis.setInterval = function(handler, delay, ...args) {
+    const scaled = typeof delay === 'number' ? delay / config.rate : delay;
+    return originalSetInterval(handler, scaled, ...args);
+  };
+
+  performance.now = function() { return fakePerfNow(); };
+
+  if (originalRaf) {
+    // Real frames, faked timestamps: the callback runs when the compositor
+    // says so, and only the number it is handed is on the page's clock.
+    const pending = new Map();
+    let nextId = 0;
+    globalThis.requestAnimationFrame = function(callback) {
+      const id = ++nextId;
+      const realId = originalRaf(() => {
+        pending.delete(id);
+        callback(fakePerfNow());
+      });
+      pending.set(id, realId);
+      return id;
+    };
+    globalThis.cancelAnimationFrame = function(id) {
+      const realId = pending.get(id);
+      if (realId !== undefined) { originalCancelRaf(realId); pending.delete(id); }
+    };
+  }
+
+  if (globalThis.document && document.timeline) {
+    Object.defineProperty(document.timeline, 'currentTime', {
+      get: () => fakePerfNow(),
+      configurable: true,
+    });
+  }
+
+  Object.defineProperty(performance, 'timeOrigin', {
+    get: () => fakeNow() - fakePerfNow(),
+    configurable: true,
+  });
+
+  const timeStamp = Object.getOwnPropertyDescriptor(Event.prototype, 'timeStamp');
+  if (timeStamp && timeStamp.get) {
+    Object.defineProperty(Event.prototype, 'timeStamp', {
+      get: function() {
+        // Scaled onto the same monotonic clock performance.now() reports,
+        // so the two agree. An event stamped before the patch was installed
+        // lands before the anchor and simply reads earlier, which is true.
+        const real = timeStamp.get.call(this);
+        return perfAnchorFake + (real - perfAnchorReal) * config.rate;
+      },
+      configurable: true,
+    });
+  }
+
+  globalThis.__appSwapClock = {
+    configure(next) {
+      // Re-anchor both clocks on the values the page can currently see, so
+      // whatever changes here takes effect from now on rather than being
+      // applied retroactively to time already elapsed.
+      const fakeWall = fakeNow();
+      const fakePerf = fakePerfNow();
+
+      // Only a new date or time of day moves the clock. A rate change must
+      // leave it reading exactly what it reads now and simply run on at the
+      // new speed -- otherwise setting the date, letting an hour of page
+      // time pass and then slowing down would throw that hour away and snap
+      // back to the moment the override was set.
+      const jump = !configured || next.date !== config.date ||
+                   next.time !== config.time;
+
+      anchorReal = originalNow();
+      perfAnchorReal = originalPerfNow();
+      perfAnchorFake = fakePerf;
+      config = next;
+      anchorFake = jump ? baseAt(anchorReal) : fakeWall;
+      configured = true;
+    },
+  };
+})();
+)JS";
+
+}  // namespace
+
+bool AppSwapTimeTravelSession::Override::IsIdentity() const {
+  return !date.has_value() && !time_of_day.has_value() && rate == 1.0;
+}
+
+AppSwapTimeTravelSession::AppSwapTimeTravelSession(
+    content::WebContents* web_contents)
+    : content::WebContentsUserData<AppSwapTimeTravelSession>(*web_contents),
+      content::WebContentsObserver(web_contents) {}
+
+AppSwapTimeTravelSession::~AppSwapTimeTravelSession() = default;
+
+void AppSwapTimeTravelSession::AddObserver(Observer* observer) {
+  observers_.AddObserver(observer);
+}
+
+void AppSwapTimeTravelSession::RemoveObserver(Observer* observer) {
+  observers_.RemoveObserver(observer);
+}
+
+void AppSwapTimeTravelSession::SetOverride(const Override& next) {
+  if (override_ == next) {
+    return;
+  }
+  override_ = next;
+  Apply();
+  for (Observer& observer : observers_) {
+    observer.OnTimeTravelChanged();
+  }
+}
+
+void AppSwapTimeTravelSession::Reset() {
+  SetOverride(Override());
+}
+
+base::WeakPtr<AppSwapTimeTravelSession>
+AppSwapTimeTravelSession::GetWeakPtr() {
+  return weak_factory_.GetWeakPtr();
+}
+
+void AppSwapTimeTravelSession::PrimaryPageChanged(content::Page& page) {
+  // The injected script re-runs on its own for each new document, but the
+  // animation playback rate is per-page state the new page does not
+  // inherit, so it has to be re-sent.
+  if (client_ && !override_.IsIdentity()) {
+    Apply();
+  }
+}
+
+std::string AppSwapTimeTravelSession::BuildClockScript() const {
+  base::DictValue config;
+  if (override_.date.has_value()) {
+    config.Set("date", override_.date->InMillisecondsFSinceUnixEpoch());
+  } else {
+    config.Set("date", base::Value());
+  }
+  if (override_.time_of_day.has_value()) {
+    config.Set("time", override_.time_of_day->InMillisecondsF());
+  } else {
+    config.Set("time", base::Value());
+  }
+  config.Set("rate", override_.rate);
+
+  return base::StrCat({kClockScript, "\n__appSwapClock.configure(",
+                       base::WriteJson(config).value_or("{}"), ");\n"});
+}
+
+void AppSwapTimeTravelSession::UpdateInjectedScript() {
+  if (registering_) {
+    // The reply carrying the identifier of the add already in flight will
+    // come back and start another round with whatever the override is then.
+    registration_stale_ = true;
+    return;
+  }
+
+  // Replace rather than add: without removing the previous registration the
+  // next document would install the patch several times over, and an older
+  // one could be the copy that configures it last.
+  if (injected_script_id_.has_value()) {
+    client_->SendCommand(
+        "Page.removeScriptToEvaluateOnNewDocument",
+        base::DictValue().Set("identifier", *injected_script_id_),
+        AppSwapDevToolsClient::CommandCallback());
+    injected_script_id_.reset();
+  }
+
+  registering_ = true;
+  client_->SendCommand(
+      "Page.addScriptToEvaluateOnNewDocument",
+      base::DictValue().Set("source", BuildClockScript()),
+      base::BindOnce(
+          [](base::WeakPtr<AppSwapTimeTravelSession> session,
+             std::optional<base::DictValue> result) {
+            if (!session) {
+              return;
+            }
+            session->registering_ = false;
+            if (result) {
+              if (const std::string* id = result->FindString("identifier")) {
+                session->injected_script_id_ = *id;
+              }
+            }
+            if (std::exchange(session->registration_stale_, false) &&
+                session->client_) {
+              session->UpdateInjectedScript();
+            }
+          },
+          GetWeakPtr()));
+}
+
+void AppSwapTimeTravelSession::Apply() {
+  if (override_.IsIdentity()) {
+    // Nothing to say any more. Dropping the client detaches it, which is
+    // also what clears the animation playback rate and stops the script
+    // being injected into the next document; the current document keeps its
+    // patch until it navigates, so the page is told to stand still first.
+    if (client_) {
+      client_->SendCommand(
+          "Runtime.evaluate",
+          base::DictValue().Set(
+              "expression",
+              "globalThis.__appSwapClock && "
+              "__appSwapClock.configure({date:null,time:null,rate:1})"),
+          AppSwapDevToolsClient::CommandCallback());
+      client_->SendCommand("Animation.setPlaybackRate",
+                           base::DictValue().Set("playbackRate", 1.0),
+                           AppSwapDevToolsClient::CommandCallback());
+      client_.reset();
+      injected_script_id_.reset();
+      registering_ = false;
+      registration_stale_ = false;
+    }
+    return;
+  }
+
+  if (!client_) {
+    client_ = std::make_unique<AppSwapDevToolsClient>(web_contents());
+    client_->SendCommand("Page.enable", base::DictValue(),
+                         AppSwapDevToolsClient::CommandCallback());
+    client_->SendCommand("Animation.enable", base::DictValue(),
+                         AppSwapDevToolsClient::CommandCallback());
+  }
+
+  UpdateInjectedScript();
+
+  // The document already on screen never sees the registration above, so it
+  // is told separately. The script is written to be safe to run twice.
+  client_->SendCommand("Runtime.evaluate",
+                       base::DictValue().Set("expression", BuildClockScript()),
+                       AppSwapDevToolsClient::CommandCallback());
+
+  // Animations are driven by the animation timeline rather than by anything
+  // the script above patches, so the rate has to be set on that too.
+  client_->SendCommand("Animation.setPlaybackRate",
+                       base::DictValue().Set("playbackRate", override_.rate),
+                       AppSwapDevToolsClient::CommandCallback());
+}
+
+WEB_CONTENTS_USER_DATA_KEY_IMPL(AppSwapTimeTravelSession);
diff --git a/chrome/browser/app_swap/app_swap_time_travel_session.h b/chrome/browser/app_swap/app_swap_time_travel_session.h
new file mode 100644
index 0000000000000..4b010765667a3
--- /dev/null
+++ b/chrome/browser/app_swap/app_swap_time_travel_session.h
@@ -0,0 +1,135 @@
+// Copyright 2026 The AppSwap Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_APP_SWAP_APP_SWAP_TIME_TRAVEL_SESSION_H_
+#define CHROME_BROWSER_APP_SWAP_APP_SWAP_TIME_TRAVEL_SESSION_H_
+
+#include <memory>
+#include <optional>
+
+#include "base/memory/weak_ptr.h"
+#include "base/observer_list.h"
+#include "base/observer_list_types.h"
+#include "base/time/time.h"
+#include "content/public/browser/web_contents_observer.h"
+#include "content/public/browser/web_contents_user_data.h"
+
+class AppSwapDevToolsClient;
+
+namespace content {
+class WebContents;
+}  // namespace content
+
+// What clock one tab's page is being shown, and the machinery that makes it
+// believe it.
+//
+// An app under development often behaves differently on a particular date
+// or at a particular hour, and waiting for either is not a debugging
+// strategy. This lets the user move the page's clock and run it faster or
+// slower, per tab, without touching the machine's real clock.
+//
+// The override is applied by patching the page's own clock APIs from the
+// browser process, over the DevTools protocol -- see
+// AppSwapTimeTravelSession::Apply(). That is a deliberate limit: only what
+// JavaScript can see moves. Anything the browser times in C++ (cookie and
+// cache expiry, response dates, storage and worker lifetimes) keeps running
+// on the real clock, so a page that reads its clock from a server, or from
+// a header, will disagree with one that reads Date.now(). Moving those too
+// means overriding the renderer's own clock, which is process-wide and a
+// much larger change.
+class AppSwapTimeTravelSession
+    : public content::WebContentsUserData<AppSwapTimeTravelSession>,
+      public content::WebContentsObserver {
+ public:
+  // The three independent knobs, matching what the page is told.
+  struct Override {
+    friend bool operator==(const Override&, const Override&) = default;
+
+    bool IsIdentity() const;
+
+    // The date to show, keeping the real time of day. Null for "today".
+    std::optional<base::Time> date;
+
+    // The time of day to show, as a duration since midnight, keeping the
+    // real date. Null for "now".
+    std::optional<base::TimeDelta> time_of_day;
+
+    // How fast the page's clock runs relative to the real one. 1.0 is
+    // normal; the UI offers a fixed set of steps either side of it.
+    double rate = 1.0;
+  };
+
+  ~AppSwapTimeTravelSession() override;
+
+  AppSwapTimeTravelSession(const AppSwapTimeTravelSession&) = delete;
+  AppSwapTimeTravelSession& operator=(const AppSwapTimeTravelSession&) =
+      delete;
+
+  class Observer : public base::CheckedObserver {
+   public:
+    // The override changed. Observers re-read current() -- it is three
+    // fields, and everything that watches it rebuilds wholesale anyway.
+    virtual void OnTimeTravelChanged() {}
+  };
+
+  void AddObserver(Observer* observer);
+  void RemoveObserver(Observer* observer);
+
+  const Override& current() const { return override_; }
+
+  // Applies `next` to the page and remembers it. Cheap to call with an
+  // unchanged value; that is a no-op.
+  void SetOverride(const Override& next);
+
+  // Back to the machine's own clock at normal speed.
+  void Reset();
+
+  base::WeakPtr<AppSwapTimeTravelSession> GetWeakPtr();
+
+  // content::WebContentsObserver:
+  void PrimaryPageChanged(content::Page& page) override;
+
+ private:
+  friend class content::WebContentsUserData<AppSwapTimeTravelSession>;
+  explicit AppSwapTimeTravelSession(content::WebContents* web_contents);
+
+  // Pushes override_ to the page: the clock patch for what JavaScript
+  // reads, and the animation playback rate for what the compositor drives.
+  // Attaches the protocol client on first use and drops it once the
+  // override is back to the identity, so a tab nobody has time-shifted
+  // carries no protocol client at all.
+  void Apply();
+
+  // The clock patch, as the script source injected into every document.
+  std::string BuildClockScript() const;
+
+  // Re-registers the injected script so the next document gets the current
+  // override. Serialized against itself: the identifier needed to remove the
+  // previous registration only arrives in a reply, so overlapping calls --
+  // which typing a date produces one per keystroke -- would leave several
+  // registrations alive and let an older one win on the next load.
+  void UpdateInjectedScript();
+
+  Override override_;
+
+  // Null until something is actually overridden. See Apply().
+  std::unique_ptr<AppSwapDevToolsClient> client_;
+
+  // What Page.addScriptToEvaluateOnNewDocument handed back, so the previous
+  // patch can be removed before a new one is added. Without this every
+  // change would stack another copy onto the next navigation.
+  std::optional<std::string> injected_script_id_;
+
+  // Whether an add is waiting for its identifier, and whether the override
+  // changed again while it was.
+  bool registering_ = false;
+  bool registration_stale_ = false;
+
+  base::ObserverList<Observer> observers_;
+  base::WeakPtrFactory<AppSwapTimeTravelSession> weak_factory_{this};
+
+  WEB_CONTENTS_USER_DATA_KEY_DECL();
+};
+
+#endif  // CHROME_BROWSER_APP_SWAP_APP_SWAP_TIME_TRAVEL_SESSION_H_
