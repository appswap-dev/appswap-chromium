+            }
+            GURL link = net::AppendOrReplaceQueryParameter(
+                web_contents->GetLastCommittedURL(),
+                kAppSwapUseVersionQueryKey, *helper->committed_version());
+            ui::ScopedClipboardWriter writer(ui::ClipboardBuffer::kCopyPaste);
+            writer.WriteText(base::UTF8ToUTF16(link.spec()));
+          },
+          base::Unretained(web_contents)),
+      PageInfoViewFactory::GetImageModel(vector_icons::kContentCopyIcon),
+      u"Copy link to this version", std::u16string());
+}
