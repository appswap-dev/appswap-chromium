+// Builds the "Copy link" row: copies a URL that reproduces this tab's exact
+// current version when opened later (bookmarked, shared, etc.), via
+// kAppSwapUseVersionQueryKey (see its comment in
+// app_swap_url_loader_factory.h) -- a no-op if the tab hasn't finished
+// resolving a version yet.
+std::unique_ptr<views::View> CreateAppSwapCopyLinkView(
+    content::WebContents* web_contents) {
+  return std::make_unique<RichHoverButton>(
+      base::BindRepeating(
+          [](content::WebContents* web_contents) {
+            AppSwapUpdateAvailableTabHelper* helper =
+                AppSwapUpdateAvailableTabHelper::FromWebContents(web_contents);
+            if (!helper || !helper->committed_version()) {
