+// Builds a small info section for pages served via a configured AppSwap
+// route, showing the npm package name and its version -- the configured
+// dist-tag alongside the concrete version it resolved to, if `app.version`
+// isn't already an exact version. Clicking it opens a modal letting the user
+// switch to a different dist-tag or exact version
+// (ShowAppSwapVersionPickerDialog).
+std::unique_ptr<views::View> CreateAppSwapPackageInfoView(
+    AppSwapApp app,
+    content::WebContents* web_contents) {
+  // Reflect this tab's own pinned version (if any), not the app-wide
+  // default -- a pinned tab may be showing a different version than what
+  // any other tab on the same app currently resolves to.
+  app.version = GetEffectiveAppSwapVersion(app, web_contents);
+
+  std::u16string version_text = base::UTF8ToUTF16(app.version);
+  if (!AppSwapArtifactProvider::IsExactVersion(app.version)) {
+    if (std::optional<std::string> resolved =
+            AppSwapArtifactProvider::GetInstance()->GetResolvedVersionIfCached(
+                app.ToSource())) {
+      version_text = base::UTF8ToUTF16(*resolved + " (" + app.version + ")");
+    }
+  }
+
+  return std::make_unique<RichHoverButton>(
+      base::BindRepeating(&ShowAppSwapVersionPickerDialog,
+                          base::Unretained(web_contents), app),
+      PageInfoViewFactory::GetImageModel(vector_icons::kExtensionFilledIcon),
+      u"Package: " + base::UTF8ToUTF16(app.package_name),
+      u"Version: " + version_text, PageInfoViewFactory::GetOpenSubpageIcon());
+}
+
 }  // namespace
 
