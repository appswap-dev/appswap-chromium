+// Returns the version text to show in the chip for an AppSwap-routed page:
+// this tab's own pinned version if it has one, resolved to a concrete
+// version if it's a dist-tag that's already been fetched -- otherwise the
+// app's own configured version, similarly resolved. Falls back to the
+// product name if the route/app can't be resolved (shouldn't normally
+// happen for a page IsAppSwapRoutedPage() already confirmed is routed).
+std::u16string GetAppSwapRoutedPageChipText(const GURL& url,
+                                            content::WebContents* web_contents) {
+  const AppSwapRoute* route = FindAppSwapRouteForUrl(url);
+  const AppSwapApp* app = route ? FindAppSwapAppById(route->app_id) : nullptr;
+  if (!app) {
+    return l10n_util::GetStringUTF16(IDS_SHORT_PRODUCT_NAME);
+  }
+
+  std::string version = GetEffectiveAppSwapVersion(*app, web_contents);
+  if (!AppSwapArtifactProvider::IsExactVersion(version)) {
+    AppSwapApp effective = *app;
+    effective.version = version;
+    if (std::optional<std::string> resolved =
+            AppSwapArtifactProvider::GetInstance()->GetResolvedVersionIfCached(
+                effective.ToSource())) {
+      version = *resolved;
+    }
+  }
+  return base::UTF8ToUTF16(version);
+}
+
