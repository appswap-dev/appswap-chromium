@@ -0,0 +1,37 @@
+// Copyright 2026 The AppSwap Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+import {html} from 'chrome://resources/lit/v3_0/lit.rollup.js';
+
+import type {AppSwapRecordingsPlayerElement} from './player.js';
+
+export function getHtml(this: AppSwapRecordingsPlayerElement) {
+  return html`
+    <div class="header">
+      <button @click="${this.onBackClick_}">&larr; Back</button>
+      <div class="nav-info">
+        ${this.currentUrl_ ? html`
+          <span class="url">${this.currentUrl_}</span>
+          ${this.currentPackage_ ? html`
+            <span class="package">${this.currentPackage_}</span>
+          ` : ''}
+        ` : ''}
+      </div>
+    </div>
+    <div class="canvas-wrap">
+      <canvas></canvas>
+    </div>
+    <div class="controls">
+      <button @click="${this.onPlayPauseClick_}"
+          ?disabled="${this.frameCount_ === 0}">
+        ${this.playing_ ? 'Pause' : 'Play'}
+      </button>
+      <input type="range" min="0"
+          max="${Math.max(0, this.frameCount_ - 1)}"
+          .value="${String(this.frameOrdinal_)}"
+          @input="${this.onScrubInput_}">
+      <span class="timestamp">${this.formatTimestamp_()}</span>
+    </div>
+  `;
+}
diff --git a/chrome/browser/resources/app_swap_recordings/player.ts b/chrome/browser/resources/app_swap_recordings/player.ts
new file mode 100644
index 0000000000000..95a6a8ab22361
--- /dev/null
+++ b/chrome/browser/resources/app_swap_recordings/player.ts
@@ -0,0 +1,204 @@
+// Copyright 2026 The AppSwap Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+import {assert} from 'chrome://resources/js/assert.js';
+import {CrLitElement} from 'chrome://resources/lit/v3_0/lit.rollup.js';
+
+import {getCss} from './player.css.js';
+import {getHtml} from './player.html.js';
+import type {BrowserProxy} from './browser_proxy.js';
+import {BrowserProxyImpl} from './browser_proxy.js';
+import type {NavigationEvent} from './app_swap_recordings.mojom-webui.js';
+
+// Continuous playback of one recording, with a scrub bar. Frames are
+// composited server-side (AppSwapPlaybackService, a separate child
+// process -- see app_swap_playback.mojom's own design note) and shipped
+// here as raw RGBA pixels rather than an encoded image: everything here is
+// process-local, so there's no network to economize bytes for, and
+// skipping a codec round trip matters for how smooth autoplay can feel.
+// Painted via ImageBitmapRenderingContext.transferFromImageBitmap() -- the
+// web platform's fast path for streaming raw bitmap frames into a canvas,
+// avoiding both an <img> decode pipeline and a full CPU-side
+// putImageData() redraw on every tick.
+export class AppSwapRecordingsPlayerElement extends CrLitElement {
+  static get is() {
+    return 'app-swap-recordings-player';
+  }
+
+  static override get styles() {
+    return getCss();
+  }
+
+  override render() {
+    return getHtml.bind(this)();
+  }
+
+  static override get properties() {
+    return {
+      sessionId: {type: String},
+      frameCount_: {type: Number},
+      frameOrdinal_: {type: Number},
+      playing_: {type: Boolean},
+      currentUrl_: {type: String},
+      currentPackage_: {type: String},
+    };
+  }
+
+  accessor sessionId: string = '';
+
+  protected accessor frameCount_: number = 0;
+  protected accessor frameOrdinal_: number = 0;
+  protected accessor playing_: boolean = false;
+  protected accessor currentUrl_: string = '';
+  protected accessor currentPackage_: string = '';
+
+  private apiProxy_: BrowserProxy = BrowserProxyImpl.getInstance();
+  private frameTimestampsMs_: number[] = [];
+  private navigations_: NavigationEvent[] = [];
+  // Bumped on every disconnect/pause so a stale autoplay loop started
+  // before that point notices and stops instead of racing a newer one.
+  private playToken_: number = 0;
+  private lastCanvasSize_: {width: number, height: number}|null = null;
+
+  override async connectedCallback() {
+    super.connectedCallback();
+    const {success, frameCount, frameTimestampsMs, navigations} =
+        await this.apiProxy_.handler.openRecording(this.sessionId);
+    if (!success || frameCount === 0) {
+      return;
+    }
+    this.frameCount_ = frameCount;
+    this.frameTimestampsMs_ = frameTimestampsMs;
+    this.navigations_ = navigations;
+    await this.showFrame_(0);
+  }
+
+  override disconnectedCallback() {
+    super.disconnectedCallback();
+    this.playing_ = false;
+    this.playToken_++;
+    this.apiProxy_.handler.closeRecording();
+  }
+
+  private updateCurrentNavigation_() {
+    const t = this.frameTimestampsMs_[this.frameOrdinal_] ?? 0;
+    let match: NavigationEvent|null = null;
+    for (const navigation of this.navigations_) {
+      if (navigation.timeMs <= t) {
+        match = navigation;
+      } else {
+        break;
+      }
+    }
+    this.currentUrl_ = match ? match.url : '';
+    this.currentPackage_ = (match && match.packageName) ?
+        `${match.packageName}@${match.version}` :
+        '';
+  }
+
+  private async showFrame_(ordinal: number) {
+    this.frameOrdinal_ = ordinal;
+    this.updateCurrentNavigation_();
+
+    const {bitmap} = await this.apiProxy_.handler.getFrame(ordinal);
+    if (!bitmap) {
+      return;
+    }
+
+    const canvas = this.shadowRoot.querySelector('canvas')!;
+    const size = bitmap.size;
+    if (!this.lastCanvasSize_ || this.lastCanvasSize_.width !== size.width ||
+        this.lastCanvasSize_.height !== size.height) {
+      canvas.width = size.width;
+      canvas.height = size.height;
+      this.lastCanvasSize_ = {width: size.width, height: size.height};
+    }
+
+    // BigBuffer is a tagged union on the TS side (bytes | sharedMemory |
+    // invalidBuffer), not a plain struct with a `.bytes` array -- a large
+    // payload (a full frame easily is) gets sent via shared memory instead
+    // of inlined, confirmed by hitting "Failed to construct 'ImageData':
+    // The input data has zero elements" when this only handled `.bytes`.
+    // Mirrors chrome/browser/resources/lens/overlay/
+    // screenshot_bitmap_browser_proxy.ts's own handling of an incoming
+    // BigBuffer, the only other place in this codebase that receives one.
+    const rgbaPixels = bitmap.rgbaPixels;
+    let bytes: Uint8Array;
+    if (Array.isArray(rgbaPixels.bytes)) {
+      bytes = new Uint8Array(rgbaPixels.bytes);
+    } else {
+      assert(rgbaPixels.sharedMemory);
+      const {buffer, result} = rgbaPixels.sharedMemory.bufferHandle.mapBuffer(
+          0, rgbaPixels.sharedMemory.size);
+      assert(result === Mojo.RESULT_OK);
+      bytes = new Uint8Array(buffer);
+    }
+    const imageData =
+        new ImageData(new Uint8ClampedArray(bytes), size.width, size.height);
+    const frameBitmap = await createImageBitmap(imageData);
+    canvas.getContext('bitmaprenderer')!.transferFromImageBitmap(frameBitmap);
+  }
+
+  protected onScrubInput_(e: Event) {
+    this.playing_ = false;
+    this.playToken_++;
+    const ordinal = Number((e.target as HTMLInputElement).value);
+    this.showFrame_(ordinal);
+  }
+
+  protected async onPlayPauseClick_() {
+    if (this.playing_) {
+      this.playing_ = false;
+      this.playToken_++;
+      return;
+    }
+
+    this.playing_ = true;
+    const token = ++this.playToken_;
+    while (this.playToken_ === token &&
+           this.frameOrdinal_ < this.frameCount_ - 1) {
+      const next = this.frameOrdinal_ + 1;
+      // Paces itself off the REAL recorded gaps between frames rather than
+      // a fixed frame rate, so playback speed tracks how the page actually
+      // behaved. Clamped to a small minimum so near-duplicate timestamps
+      // (two layers captured in the same commit) can't spin the loop.
+      const delay = Math.max(
+          16,
+          this.frameTimestampsMs_[next]! -
+              this.frameTimestampsMs_[this.frameOrdinal_]!);
+      await new Promise(resolve => setTimeout(resolve, delay));
+      if (this.playToken_ !== token) {
+        return;
+      }
+      await this.showFrame_(next);
+    }
+    if (this.playToken_ === token) {
+      this.playing_ = false;
+    }
+  }
+
+  protected onBackClick_() {
+    this.fire('back');
+  }
+
+  protected formatTimestamp_(): string {
+    const start = this.frameTimestampsMs_[0] ?? 0;
+    const elapsed = (this.frameTimestampsMs_[this.frameOrdinal_] ?? 0) - start;
+    const totalSeconds = Math.floor(elapsed / 1000);
+    const minutes = Math.floor(totalSeconds / 60);
+    const seconds = totalSeconds % 60;
+    const millis = Math.floor(elapsed % 1000);
+    return `${minutes}:${String(seconds).padStart(2, '0')}.${
+        String(millis).padStart(3, '0')}`;
+  }
+}
+
+declare global {
+  interface HTMLElementTagNameMap {
+    'app-swap-recordings-player': AppSwapRecordingsPlayerElement;
+  }
+}
+
+customElements.define(
+    AppSwapRecordingsPlayerElement.is, AppSwapRecordingsPlayerElement);
