+#include "content/public/common/url_constants.h"
+#include "ui/webui/webui_util.h"
+
+AppSwapRecordingsUIConfig::AppSwapRecordingsUIConfig()
+    : DefaultWebUIConfig(content::kChromeUIScheme, "appswap-recordings") {}
+
+AppSwapRecordingsUI::AppSwapRecordingsUI(content::WebUI* web_ui)
+    : content::WebUIController(web_ui) {
+  Profile* profile = Profile::FromWebUI(web_ui);
+  content::WebUIDataSource* source =
+      content::WebUIDataSource::CreateAndAdd(profile, "appswap-recordings");
+  webui::SetupWebUIDataSource(
+      source, kAppSwapRecordingsResources,
+      IDR_APP_SWAP_RECORDINGS_APP_SWAP_RECORDINGS_HTML);
+}
+
+AppSwapRecordingsUI::~AppSwapRecordingsUI() = default;
+
+WEB_UI_CONTROLLER_TYPE_IMPL(AppSwapRecordingsUI)
+
+void AppSwapRecordingsUI::WebUIRenderFrameCreated(
+    content::RenderFrameHost* rfh) {
+  rfh->EnableMojoJsBindings(nullptr);
+}
+
+void AppSwapRecordingsUI::BindInterface(
+    mojo::PendingReceiver<app_swap_recordings::mojom::PageHandlerFactory>
+        receiver) {
+  page_factory_receiver_.reset();
+  page_factory_receiver_.Bind(std::move(receiver));
+}
+
+void AppSwapRecordingsUI::CreatePageHandler(
+    mojo::PendingReceiver<app_swap_recordings::mojom::PageHandler> handler) {
+  page_handler_ = std::make_unique<AppSwapRecordingsPageHandler>(
+      std::move(handler), Profile::FromWebUI(web_ui()));
+}
