diff --git a/chrome/browser/ui/webui/app_swap_recordings/app_swap_recordings.mojom b/chrome/browser/ui/webui/app_swap_recordings/app_swap_recordings.mojom
new file mode 100644
index 0000000000000..f26555996fca3
--- /dev/null
+++ b/chrome/browser/ui/webui/app_swap_recordings/app_swap_recordings.mojom
@@ -0,0 +1,67 @@
+// Copyright 2026 The AppSwap Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+module app_swap_recordings.mojom;
+
+import "chrome/services/app_swap_playback/public/mojom/app_swap_playback_bitmap.mojom";
+
+// Mirrors AppSwapRecordingsScanner::RecordingInfo
+// (chrome/browser/app_swap/app_swap_recordings_scanner.h).
+struct RecordingInfo {
+  string session_id;
+  string start_url;
+  double start_time_ms;
+  uint32 segment_count;
+  uint64 total_bytes;
+};
+
+// Mirrors AppSwapSessionRecordingReader::NavigationEvent
+// (chrome/browser/app_swap/app_swap_session_recording_reader.h) -- one
+// entry from a recording's navigations.jsonl. `package_name`/`version` are
+// both empty for a plain, non-AppSwap-routed page.
+struct NavigationEvent {
+  double time_ms;
+  string url;
+  string package_name;
+  string version;
+};
+
+interface PageHandlerFactory {
+  CreatePageHandler(pending_receiver<PageHandler> handler);
+};
+
+// Every method resolves against the Profile this page was opened in --
+// AppSwapRecordingsPageHandler scopes everything to that profile's own
+// <profile_path>/AppSwap/Recordings directory.
+interface PageHandler {
+  GetRecordings() => (array<RecordingInfo> recordings);
+  // Returns false if `session_id` doesn't identify a real, currently
+  // existing recording -- see AppSwapRecordingsScanner::Delete()'s own
+  // comment for why this is validated rather than trusted.
+  DeleteRecording(string session_id) => (bool success);
+  // Reveals the recording's directory in the OS file manager. No-op if
+  // `session_id` doesn't identify a real recording.
+  OpenRecordingFolder(string session_id);
+
+  // Opens `session_id` for playback: indexes its captured frames (see
+  // AppSwapSessionRecordingReader::Index()) and launches the playback
+  // renderer service used by subsequent GetFrame() calls. `success` is
+  // false if `session_id` doesn't identify a real recording. Replaces any
+  // previously-open recording -- only one is open at a time.
+  OpenRecording(string session_id) => (
+      bool success,
+      uint32 frame_count,
+      array<double> frame_timestamps_ms,
+      array<NavigationEvent> navigations);
+  // Renders and returns the frame at `frame_ordinal` (an index into the
+  // frame_timestamps_ms OpenRecording() returned) for the currently-open
+  // recording. Null `bitmap` on any failure (out of range, no recording
+  // open, or the render itself failing).
+  GetFrame(uint32 frame_ordinal) =>
+      (app_swap_playback.mojom.FrameBitmap? bitmap);
+  // Releases the currently-open recording's reader and playback service,
+  // if any -- lets the playback service's child process exit instead of
+  // lingering. Safe to call even if nothing is open.
+  CloseRecording();
+};
diff --git a/chrome/browser/ui/webui/app_swap_recordings/app_swap_recordings_page_handler.cc b/chrome/browser/ui/webui/app_swap_recordings/app_swap_recordings_page_handler.cc
new file mode 100644
index 0000000000000..60f58a4d2a705
--- /dev/null
+++ b/chrome/browser/ui/webui/app_swap_recordings/app_swap_recordings_page_handler.cc
@@ -0,0 +1,157 @@
+// Copyright 2026 The AppSwap Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/webui/app_swap_recordings/app_swap_recordings_page_handler.h"
+
+#include <utility>
+
+#include "base/files/file_path.h"
+#include "base/functional/bind.h"
+#include "chrome/browser/app_swap/app_swap_session_recording_paths.h"
+#include "chrome/browser/platform_util.h"
+#include "chrome/browser/profiles/profile.h"
+// FrameBitmap lives in a separate mojom file/target from PlaybackRenderer
+// (see app_swap_playback_bitmap.mojom's own comment for why) -- the header
+// this file includes only forward-declares it, but GetFrame() below
+// constructs a real FrameBitmapPtr value (Run(nullptr)), which needs the
+// complete type.
+#include "chrome/services/app_swap_playback/public/mojom/app_swap_playback_bitmap.mojom.h"
+#include "content/public/browser/service_process_host.h"
+
+AppSwapRecordingsPageHandler::AppSwapRecordingsPageHandler(
+    mojo::PendingReceiver<app_swap_recordings::mojom::PageHandler> handler,
+    Profile* profile)
+    : profile_(profile),
+      scanner_(GetAppSwapRecordingsDir(profile)),
+      receiver_(this, std::move(handler)) {}
+
+AppSwapRecordingsPageHandler::~AppSwapRecordingsPageHandler() = default;
+
+void AppSwapRecordingsPageHandler::GetRecordings(
+    GetRecordingsCallback callback) {
+  scanner_.Scan(base::BindOnce(&AppSwapRecordingsPageHandler::OnScanned,
+                               weak_factory_.GetWeakPtr(),
+                               std::move(callback)));
+}
+
+void AppSwapRecordingsPageHandler::DeleteRecording(
+    const std::string& session_id,
+    DeleteRecordingCallback callback) {
+  scanner_.Delete(session_id, std::move(callback));
+}
+
+void AppSwapRecordingsPageHandler::OpenRecordingFolder(
+    const std::string& session_id) {
+  base::FilePath session_dir = scanner_.ResolveSessionDir(session_id);
+  if (session_dir.empty()) {
+    return;
+  }
+  platform_util::ShowItemInFolder(profile_, session_dir);
+}
+
+void AppSwapRecordingsPageHandler::OnScanned(
+    GetRecordingsCallback callback,
+    std::vector<AppSwapRecordingsScanner::RecordingInfo> infos) {
+  std::vector<app_swap_recordings::mojom::RecordingInfoPtr> result;
+  result.reserve(infos.size());
+  for (const auto& info : infos) {
+    auto mojo_info = app_swap_recordings::mojom::RecordingInfo::New();
+    mojo_info->session_id = info.session_id;
+    mojo_info->start_url = info.start_url;
+    mojo_info->start_time_ms = info.start_time_ms;
+    mojo_info->segment_count = static_cast<uint32_t>(info.segment_count);
+    mojo_info->total_bytes = static_cast<uint64_t>(info.total_bytes);
+    result.push_back(std::move(mojo_info));
+  }
+  std::move(callback).Run(std::move(result));
+}
+
+app_swap_playback::mojom::PlaybackRenderer&
+AppSwapRecordingsPageHandler::GetPlaybackService() {
+  if (!playback_service_) {
+    content::ServiceProcessHost::Launch<
+        app_swap_playback::mojom::PlaybackRenderer>(
+        playback_service_.BindNewPipeAndPassReceiver(),
+        content::ServiceProcessHost::Options()
+            .WithDisplayName("AppSwap Playback Renderer")
+            .Pass());
+    // NOT reset_on_disconnect(): that alone would leave active_reader_
+    // holding a dangling pointer into the just-reset Remote (see its own
+    // comment). set_disconnect_handler() lets OnPlaybackServiceDisconnected
+    // reset both together.
+    playback_service_.set_disconnect_handler(
+        base::BindOnce(&AppSwapRecordingsPageHandler::OnPlaybackServiceDisconnected,
+                       weak_factory_.GetWeakPtr()));
+  }
+  return *playback_service_.get();
+}
+
+void AppSwapRecordingsPageHandler::OnPlaybackServiceDisconnected() {
+  active_reader_.reset();
+  playback_service_.reset();
+}
+
+void AppSwapRecordingsPageHandler::OpenRecording(
+    const std::string& session_id,
+    OpenRecordingCallback callback) {
+  // ResolveSessionDir() is pure path computation (no I/O -- see its own
+  // comment), safe to call directly on the UI thread. Whether the
+  // directory actually exists is checked by AppSwapSessionRecordingReader::
+  // BuildIndex() on its own background sequence instead of here: this
+  // method runs on the UI thread (dispatched from the mojo receiver), and
+  // base::DirectoryExists() is a blocking filesystem call -- calling it
+  // here directly used to crash with "DCHECK failed:
+  // !tls_blocking_disallowed", confirmed by actually hitting it.
+  base::FilePath session_dir = scanner_.ResolveSessionDir(session_id);
+  if (session_dir.empty()) {
+    std::move(callback).Run(false, 0, {}, {});
+    return;
+  }
+  active_reader_ = std::make_unique<AppSwapSessionRecordingReader>(
+      session_dir, &GetPlaybackService());
+  active_reader_->Index(base::BindOnce(
+      &AppSwapRecordingsPageHandler::OnIndexed, weak_factory_.GetWeakPtr(),
+      std::move(callback)));
+}
+
+void AppSwapRecordingsPageHandler::OnIndexed(
+    OpenRecordingCallback callback,
+    bool success,
+    std::vector<int64_t> frame_timestamps_ms,
+    std::vector<AppSwapSessionRecordingReader::NavigationEvent>
+        navigations) {
+  std::vector<double> timestamps_ms(frame_timestamps_ms.begin(),
+                                    frame_timestamps_ms.end());
+
+  std::vector<app_swap_recordings::mojom::NavigationEventPtr>
+      mojo_navigations;
+  mojo_navigations.reserve(navigations.size());
+  for (const auto& navigation : navigations) {
+    auto entry = app_swap_recordings::mojom::NavigationEvent::New();
+    entry->time_ms = static_cast<double>(navigation.time_ms);
+    entry->url = navigation.url;
+    entry->package_name = navigation.package_name;
+    entry->version = navigation.version;
+    mojo_navigations.push_back(std::move(entry));
+  }
+
+  std::move(callback).Run(success,
+                          static_cast<uint32_t>(timestamps_ms.size()),
+                          std::move(timestamps_ms),
+                          std::move(mojo_navigations));
+}
+
+void AppSwapRecordingsPageHandler::GetFrame(uint32_t frame_ordinal,
+                                            GetFrameCallback callback) {
+  if (!active_reader_) {
+    std::move(callback).Run(nullptr);
+    return;
+  }
+  active_reader_->RenderFrame(frame_ordinal, std::move(callback));
+}
+
+void AppSwapRecordingsPageHandler::CloseRecording() {
+  active_reader_.reset();
+  playback_service_.reset();
+}
