+// Copyright 2026 The AppSwap Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+import {CrLitElement} from 'chrome://resources/lit/v3_0/lit.rollup.js';
+
+import {getCss} from './app.css.js';
+import {getHtml} from './app.html.js';
+import type {BrowserProxy} from './browser_proxy.js';
+import {BrowserProxyImpl} from './browser_proxy.js';
+import type {RecordingInfo} from './app_swap_recordings.mojom-webui.js';
+// Side-effect import: defines <app-swap-recordings-player>, used by
+// app.html.ts below.
+import './player.js';
+
+export class AppSwapRecordingsAppElement extends CrLitElement {
+  static get is() {
+    return 'app-swap-recordings-app';
+  }
+
+  static override get styles() {
+    return getCss();
+  }
+
+  override render() {
+    return getHtml.bind(this)();
+  }
+
+  static override get properties() {
+    return {
+      recordings_: {type: Array},
+      playingSessionId_: {type: String},
+    };
+  }
+
+  protected accessor recordings_: RecordingInfo[] = [];
+  protected accessor playingSessionId_: string|null = null;
+
+  private apiProxy_: BrowserProxy = BrowserProxyImpl.getInstance();
+
+  override connectedCallback() {
+    super.connectedCallback();
+    this.refresh_();
+  }
+
+  private async refresh_() {
+    const {recordings} = await this.apiProxy_.handler.getRecordings();
+    // Newest first.
+    this.recordings_ =
+        recordings.slice().sort((a, b) => b.startTimeMs - a.startTimeMs);
+  }
+
+  protected formatTime_(startTimeMs: number): string {
+    return new Date(startTimeMs).toLocaleString();
+  }
+
+  protected formatSize_(totalBytes: bigint): string {
+    const mb = Number(totalBytes) / (1024 * 1024);
+    return mb >= 0.1 ? `${mb.toFixed(1)} MB` :
+                       `${Math.ceil(Number(totalBytes) / 1024)} KB`;
+  }
+
+  protected onOpenFolderClick_(e: Event) {
+    const id = (e.currentTarget as HTMLElement).dataset['id']!;
+    this.apiProxy_.handler.openRecordingFolder(id);
+  }
+
+  protected onPlayClick_(e: Event) {
+    this.playingSessionId_ = (e.currentTarget as HTMLElement).dataset['id']!;
+  }
+
+  protected onPlayerBack_() {
+    this.playingSessionId_ = null;
+  }
+
+  protected async onDeleteClick_(e: Event) {
+    const id = (e.currentTarget as HTMLElement).dataset['id']!;
+    await this.apiProxy_.handler.deleteRecording(id);
+    await this.refresh_();
+  }
+}
+
+declare global {
+  interface HTMLElementTagNameMap {
+    'app-swap-recordings-app': AppSwapRecordingsAppElement;
+  }
+}
+
+customElements.define(
+    AppSwapRecordingsAppElement.is, AppSwapRecordingsAppElement);
