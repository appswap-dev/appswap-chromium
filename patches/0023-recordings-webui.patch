+++ b/chrome/browser/app_swap/app_swap_session_recording_paths.cc
@@ -0,0 +1,36 @@
+// Copyright 2026 The AppSwap Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/app_swap/app_swap_session_recording_paths.h"
+
+#include "base/strings/stringprintf.h"
+#include "chrome/browser/profiles/profile.h"
+
+namespace {
+constexpr base::FilePath::CharType kRecordingsDirName[] =
+    FILE_PATH_LITERAL("AppSwap/Recordings");
+constexpr base::FilePath::CharType kNavigationsFileName[] =
+    FILE_PATH_LITERAL("navigations.jsonl");
+constexpr base::FilePath::CharType kBlobsFileName[] =
+    FILE_PATH_LITERAL("blobs.dat");
+}  // namespace
+
+base::FilePath GetAppSwapRecordingsDir(Profile* profile) {
+  return profile->GetPath().Append(kRecordingsDirName);
+}
+
+base::FilePath GetAppSwapRecordingSegmentPath(const base::FilePath& session_dir,
+                                              int segment_index) {
+  return session_dir.AppendASCII(
+      base::StringPrintf("segment_%04d.paintopseg", segment_index));
+}
+
+base::FilePath GetAppSwapRecordingNavigationsPath(
+    const base::FilePath& session_dir) {
+  return session_dir.Append(kNavigationsFileName);
+}
+
+base::FilePath GetAppSwapRecordingBlobsPath(const base::FilePath& session_dir) {
+  return session_dir.Append(kBlobsFileName);
+}
diff --git a/chrome/browser/app_swap/app_swap_session_recording_paths.h b/chrome/browser/app_swap/app_swap_session_recording_paths.h
new file mode 100644
index 0000000000000..d61d3a85b000c
--- /dev/null
+++ b/chrome/browser/app_swap/app_swap_session_recording_paths.h
@@ -0,0 +1,37 @@
+// Copyright 2026 The AppSwap Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_APP_SWAP_APP_SWAP_SESSION_RECORDING_PATHS_H_
+#define CHROME_BROWSER_APP_SWAP_APP_SWAP_SESSION_RECORDING_PATHS_H_
+
+#include "base/files/file_path.h"
+
+class Profile;
+
+// The single source of truth for where AppSwap session recordings live on
+// disk -- <profile_path>/AppSwap/Recordings. Shared by
+// AppSwapSessionRecordingWriter (which writes here) and
+// AppSwapRecordingsScanner (which lists this directory for
+// appswap://recordings) so the two can't drift apart on the path.
+base::FilePath GetAppSwapRecordingsDir(Profile* profile);
+
+// One session's segment file naming convention (segment_0000.paintopseg,
+// segment_0001.paintopseg, ...) -- shared by AppSwapSessionRecordingWriter
+// (which creates them) and AppSwapSessionRecordingReader (which reads them
+// back for playback) so the two can't drift apart on the naming either.
+base::FilePath GetAppSwapRecordingSegmentPath(const base::FilePath& session_dir,
+                                              int segment_index);
+
+// One session's navigation-log file (navigations.jsonl) -- see
+// AppSwapSessionRecordingWriter::WriteNavigation() for the format.
+base::FilePath GetAppSwapRecordingNavigationsPath(
+    const base::FilePath& session_dir);
+
+// One session's content-addressed blob store (blobs.dat) -- see
+// AppSwapSessionRecordingWriter::WriteBlobIfNew() for the format. Holds
+// the actual paintops/strikedata/image bytes segment records now only
+// reference by hash, deduplicated across the whole session.
+base::FilePath GetAppSwapRecordingBlobsPath(const base::FilePath& session_dir);
+
+#endif  // CHROME_BROWSER_APP_SWAP_APP_SWAP_SESSION_RECORDING_PATHS_H_
