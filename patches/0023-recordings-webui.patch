+#ifndef CHROME_BROWSER_UI_WEBUI_APP_SWAP_RECORDINGS_APP_SWAP_RECORDINGS_PAGE_HANDLER_H_
+#define CHROME_BROWSER_UI_WEBUI_APP_SWAP_RECORDINGS_APP_SWAP_RECORDINGS_PAGE_HANDLER_H_
+
+#include <memory>
+#include <string>
+#include <vector>
+
+#include "base/memory/raw_ptr.h"
+#include "base/memory/weak_ptr.h"
+#include "chrome/browser/app_swap/app_swap_recordings_scanner.h"
+#include "chrome/browser/app_swap/app_swap_session_recording_reader.h"
+#include "chrome/browser/ui/webui/app_swap_recordings/app_swap_recordings.mojom.h"
+#include "chrome/services/app_swap_playback/public/mojom/app_swap_playback.mojom.h"
+#include "mojo/public/cpp/bindings/pending_receiver.h"
+#include "mojo/public/cpp/bindings/receiver.h"
+#include "mojo/public/cpp/bindings/remote.h"
+
+class Profile;
+
+// Implements the appswap://recordings page's PageHandler. `scanner_` is
+// scoped to `profile`'s own recordings directory (GetAppSwapRecordingsDir)
+// for the handler's lifetime.
+class AppSwapRecordingsPageHandler
+    : public app_swap_recordings::mojom::PageHandler {
+ public:
+  AppSwapRecordingsPageHandler(
+      mojo::PendingReceiver<app_swap_recordings::mojom::PageHandler> handler,
+      Profile* profile);
+  AppSwapRecordingsPageHandler(const AppSwapRecordingsPageHandler&) = delete;
+  AppSwapRecordingsPageHandler& operator=(
+      const AppSwapRecordingsPageHandler&) = delete;
+  ~AppSwapRecordingsPageHandler() override;
+
+  // app_swap_recordings::mojom::PageHandler:
+  void GetRecordings(GetRecordingsCallback callback) override;
+  void DeleteRecording(const std::string& session_id,
+                       DeleteRecordingCallback callback) override;
+  void OpenRecordingFolder(const std::string& session_id) override;
+  void OpenRecording(const std::string& session_id,
+                     OpenRecordingCallback callback) override;
+  void GetFrame(uint32_t frame_ordinal, GetFrameCallback callback) override;
+  void CloseRecording() override;
+
+ private:
+  void OnScanned(GetRecordingsCallback callback,
+                std::vector<AppSwapRecordingsScanner::RecordingInfo> infos);
+  void OnIndexed(OpenRecordingCallback callback,
+                bool success,
+                std::vector<int64_t> frame_timestamps_ms,
+                std::vector<AppSwapSessionRecordingReader::NavigationEvent>
+                    navigations);
+
+  // Lazily launches the playback renderer service (a separate child
+  // process -- see app_swap_playback.mojom's own design note for why) the
+  // first time a recording is opened; reused for every GetFrame() call
+  // until CloseRecording() tears it down. Mirrors PageHandler::GetService()
+  // in chrome/browser/ui/webui/on_device_internals/
+  // on_device_internals_page_handler.cc, the closest existing precedent
+  // for launching a ServiceProcessHost service lazily from a WebUI page
+  // handler.
+  app_swap_playback::mojom::PlaybackRenderer& GetPlaybackService();
+
+  // The playback service can die mid-session (e.g. running out of memory
+  // rendering a frame with many large images -- confirmed by actually
+  // hitting this on an image-heavy page). Tears down active_reader_ too:
+  // it holds a raw pointer to *playback_service_'s underlying interface
+  // (see GetPlaybackService()), which becomes dangling once
+  // playback_service_ resets itself, so it must not outlive it. The next
+  // GetFrame() call on a now-null active_reader_ just fails cleanly
+  // instead of calling through a dangling pointer; the WebUI has to
+  // OpenRecording() again to resume (which relaunches the service).
+  void OnPlaybackServiceDisconnected();
+
+  const raw_ptr<Profile> profile_;
+  AppSwapRecordingsScanner scanner_;
+  mojo::Receiver<app_swap_recordings::mojom::PageHandler> receiver_;
+
+  // Declared before active_reader_ so it's destroyed AFTER it (member
+  // destruction runs in reverse declaration order) -- active_reader_ holds
+  // a raw pointer to *playback_service_'s underlying interface (see
+  // GetPlaybackService()) and must never outlive it. CloseRecording()
+  // resets the two in the same relative order explicitly, for the same
+  // reason.
+  mojo::Remote<app_swap_playback::mojom::PlaybackRenderer> playback_service_;
+  // Only one recording is ever open at a time -- OpenRecording() replaces
+  // whatever was open before.
+  std::unique_ptr<AppSwapSessionRecordingReader> active_reader_;
+
+  base::WeakPtrFactory<AppSwapRecordingsPageHandler> weak_factory_{this};
+};
+
+#endif  // CHROME_BROWSER_UI_WEBUI_APP_SWAP_RECORDINGS_APP_SWAP_RECORDINGS_PAGE_HANDLER_H_
