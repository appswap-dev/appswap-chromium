diff --git a/chrome/browser/app_swap/app_swap_recordings_scanner.cc b/chrome/browser/app_swap/app_swap_recordings_scanner.cc
new file mode 100644
index 0000000000000..846527521dc96
--- /dev/null
+++ b/chrome/browser/app_swap/app_swap_recordings_scanner.cc
@@ -0,0 +1,142 @@
+// Copyright 2026 The AppSwap Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/app_swap/app_swap_recordings_scanner.h"
+
+#include <utility>
+
+#include "base/files/file_enumerator.h"
+#include "base/files/file_util.h"
+#include "base/json/json_reader.h"
+#include "base/task/task_traits.h"
+#include "base/task/thread_pool.h"
+#include "base/unguessable_token.h"
+#include "base/values.h"
+#include "chrome/browser/app_swap/app_swap_session_recording_paths.h"
+
+namespace {
+
+constexpr base::FilePath::CharType kManifestFileName[] =
+    FILE_PATH_LITERAL("manifest.json");
+constexpr base::FilePath::CharType kSegmentPattern[] =
+    FILE_PATH_LITERAL("segment_*.paintopseg");
+
+// Runs on the scanner's background sequence.
+std::vector<AppSwapRecordingsScanner::RecordingInfo> ScanBlocking(
+    base::FilePath recordings_dir) {
+  std::vector<AppSwapRecordingsScanner::RecordingInfo> results;
+
+  base::FileEnumerator session_dirs(recordings_dir, /*recursive=*/false,
+                                    base::FileEnumerator::DIRECTORIES);
+  for (base::FilePath session_dir = session_dirs.Next(); !session_dir.empty();
+       session_dir = session_dirs.Next()) {
+    AppSwapRecordingsScanner::RecordingInfo info;
+    info.session_id = session_dir.BaseName().MaybeAsASCII();
+    if (info.session_id.empty()) {
+      continue;  // Not one of ours -- a real session id is always ASCII.
+    }
+
+    std::string manifest_json;
+    if (base::ReadFileToString(session_dir.Append(kManifestFileName),
+                               &manifest_json)) {
+      std::optional<base::DictValue> manifest = base::JSONReader::ReadDict(
+          manifest_json, base::JSON_PARSE_CHROMIUM_EXTENSIONS);
+      if (manifest) {
+        const base::DictValue& dict = *manifest;
+        if (const std::string* url = dict.FindString("start_url")) {
+          info.start_url = *url;
+        }
+        if (std::optional<double> time_ms =
+                dict.FindDouble("start_time_ms")) {
+          info.start_time_ms = *time_ms;
+        }
+      }
+    }
+
+    base::FileEnumerator segments(session_dir, /*recursive=*/false,
+                                  base::FileEnumerator::FILES,
+                                  kSegmentPattern);
+    for (base::FilePath segment = segments.Next(); !segment.empty();
+        segment = segments.Next()) {
+      ++info.segment_count;
+      info.total_bytes += segments.GetInfo().GetSize();
+    }
+
+    // blobs.dat now holds the bulk of a recording's real content (see
+    // AppSwapSessionRecordingWriter's own header comment) -- segment files
+    // alone would badly undercount the size shown on the listing page.
+    if (std::optional<int64_t> blobs_size = base::GetFileSize(
+            GetAppSwapRecordingBlobsPath(session_dir))) {
+      info.total_bytes += *blobs_size;
+    }
+
+    results.push_back(std::move(info));
+  }
+
+  return results;
+}
+
+// Pure path computation shared by ResolveSessionDir() and DeleteBlocking()
+// below. AppSwapSessionRecordingWriter only ever names a session
+// directory after a freshly-generated base::UnguessableToken -- so
+// validate `session_id` (untrusted, from the renderer) actually parses
+// as one before treating it as a path component. This rejects path
+// separators, "..", and anything else that isn't that exact shape.
+// Returns an empty path if invalid.
+base::FilePath ResolveSessionDirImpl(const base::FilePath& recordings_dir,
+                                     const std::string& session_id) {
+  if (!base::UnguessableToken::DeserializeFromString(session_id)) {
+    return base::FilePath();
+  }
+  return recordings_dir.AppendASCII(session_id);
+}
+
+// Runs on the scanner's background sequence. Returns false (and deletes
+// nothing) if `session_id` isn't a real, currently-existing recording.
+bool DeleteBlocking(base::FilePath recordings_dir, std::string session_id) {
+  base::FilePath session_dir =
+      ResolveSessionDirImpl(recordings_dir, session_id);
+  if (session_dir.empty() || !base::DirectoryExists(session_dir)) {
+    return false;
+  }
+  return base::DeletePathRecursively(session_dir);
+}
+
+}  // namespace
+
+AppSwapRecordingsScanner::RecordingInfo::RecordingInfo() = default;
+AppSwapRecordingsScanner::RecordingInfo::RecordingInfo(const RecordingInfo&) =
+    default;
+AppSwapRecordingsScanner::RecordingInfo&
+AppSwapRecordingsScanner::RecordingInfo::operator=(const RecordingInfo&) =
+    default;
+AppSwapRecordingsScanner::RecordingInfo::~RecordingInfo() = default;
+
+AppSwapRecordingsScanner::AppSwapRecordingsScanner(
+    base::FilePath recordings_dir)
+    : recordings_dir_(std::move(recordings_dir)),
+      task_runner_(base::ThreadPool::CreateSequencedTaskRunner(
+          {base::MayBlock(), base::TaskPriority::USER_VISIBLE})) {}
+
+AppSwapRecordingsScanner::~AppSwapRecordingsScanner() = default;
+
+void AppSwapRecordingsScanner::Scan(
+    base::OnceCallback<void(std::vector<RecordingInfo>)> callback) {
+  task_runner_->PostTaskAndReplyWithResult(
+      FROM_HERE, base::BindOnce(&ScanBlocking, recordings_dir_),
+      std::move(callback));
+}
+
+void AppSwapRecordingsScanner::Delete(
+    const std::string& session_id,
+    base::OnceCallback<void(bool)> callback) {
+  task_runner_->PostTaskAndReplyWithResult(
+      FROM_HERE, base::BindOnce(&DeleteBlocking, recordings_dir_, session_id),
+      std::move(callback));
+}
+
+base::FilePath AppSwapRecordingsScanner::ResolveSessionDir(
+    const std::string& session_id) const {
+  return ResolveSessionDirImpl(recordings_dir_, session_id);
+}
diff --git a/chrome/browser/app_swap/app_swap_recordings_scanner.h b/chrome/browser/app_swap/app_swap_recordings_scanner.h
new file mode 100644
index 0000000000000..95fae4147c76b
--- /dev/null
+++ b/chrome/browser/app_swap/app_swap_recordings_scanner.h
@@ -0,0 +1,75 @@
+// Copyright 2026 The AppSwap Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_APP_SWAP_APP_SWAP_RECORDINGS_SCANNER_H_
+#define CHROME_BROWSER_APP_SWAP_APP_SWAP_RECORDINGS_SCANNER_H_
+
+#include <cstdint>
+#include <string>
+#include <vector>
+
+#include "base/files/file_path.h"
+#include "base/functional/callback.h"
+#include "base/memory/scoped_refptr.h"
+#include "base/task/sequenced_task_runner.h"
+
+// Lists and deletes AppSwap session recordings on disk (see
+// AppSwapSessionRecordingWriter, which writes the format this reads) for
+// appswap://recordings. All I/O runs on a dedicated SequencedTaskRunner,
+// mirroring AppSwapSessionRecordingWriter's own threading convention --
+// public methods post to it and reply via the given callback on the
+// calling sequence.
+class AppSwapRecordingsScanner {
+ public:
+  struct RecordingInfo {
+    RecordingInfo();
+    RecordingInfo(const RecordingInfo&);
+    RecordingInfo& operator=(const RecordingInfo&);
+    ~RecordingInfo();
+
+    // The directory name under the recordings dir -- a serialized
+    // base::UnguessableToken (see AppSwapSessionRecordingWriter). Passed
+    // back to Delete() to identify which recording to remove.
+    std::string session_id;
+    std::string start_url;
+    double start_time_ms = 0;
+    int segment_count = 0;
+    int64_t total_bytes = 0;
+  };
+
+  explicit AppSwapRecordingsScanner(base::FilePath recordings_dir);
+  ~AppSwapRecordingsScanner();
+
+  AppSwapRecordingsScanner(const AppSwapRecordingsScanner&) = delete;
+  AppSwapRecordingsScanner& operator=(const AppSwapRecordingsScanner&) =
+      delete;
+
+  // Lists every recording under the recordings dir. `callback` runs on
+  // the calling sequence once the scan completes.
+  void Scan(base::OnceCallback<void(std::vector<RecordingInfo>)> callback);
+
+  // Deletes the recording identified by `session_id`. `session_id` comes
+  // from the renderer over Mojo and is NOT trusted -- this validates it
+  // parses as a real base::UnguessableToken (the only shape
+  // AppSwapSessionRecordingWriter ever generates) before touching the
+  // filesystem, rather than blindly appending it to a path. An invalid
+  // `session_id` fails closed: `callback` runs with false, nothing is
+  // deleted. `callback` runs on the calling sequence.
+  void Delete(const std::string& session_id,
+              base::OnceCallback<void(bool)> callback);
+
+  // Pure path computation, no I/O -- safe to call on any sequence,
+  // including the UI thread (needed for platform_util::ShowItemInFolder(),
+  // which must run there). Same validation as Delete(): returns an empty
+  // path if `session_id` doesn't parse as a real
+  // base::UnguessableToken, without checking whether the directory
+  // actually still exists on disk.
+  base::FilePath ResolveSessionDir(const std::string& session_id) const;
+
+ private:
+  const base::FilePath recordings_dir_;
+  const scoped_refptr<base::SequencedTaskRunner> task_runner_;
+};
+
+#endif  // CHROME_BROWSER_APP_SWAP_APP_SWAP_RECORDINGS_SCANNER_H_
diff --git a/chrome/browser/app_swap/app_swap_session_recording_paths.cc b/chrome/browser/app_swap/app_swap_session_recording_paths.cc
new file mode 100644
index 0000000000000..7d0f47a8ab41d
