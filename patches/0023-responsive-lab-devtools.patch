+// static
+DevToolsWindow* DevToolsWindow::OpenDevToolsWindowForAppSwapLab(
+    Profile* profile,
+    const scoped_refptr<DevToolsAgentHost>& first_cell_agent) {
+  DevToolsWindow* window = FindDevToolsWindow(first_cell_agent.get());
+  if (!window) {
+    window = Create(profile, /*inspected_web_contents=*/nullptr,
+                    kFrontendDefault, std::string(), /*can_dock=*/false, "", "",
+                    first_cell_agent->IsAttached(),
+                    /* browser_connection */ true,
+                    DevToolsOpenedByAction::kUnknown);
+    if (!window) {
+      return nullptr;
+    }
+    window->bindings_->AttachViaBrowserTarget(first_cell_agent);
+  }
+  window->ScheduleShow(DevToolsToggleAction::Show());
+  return window;
+}
+
+void DevToolsWindow::SetAppSwapLabTargets(std::vector<std::string> target_ids,
+                                          std::string focused_target_id) {
+  bindings_->SetAppSwapLabTargets(std::move(target_ids),
+                                  std::move(focused_target_id));
+}
+
+void DevToolsWindow::ShowForAppSwapLab() {
+  ScheduleShow(DevToolsToggleAction::Show());
+}
+
+void DevToolsWindow::SetCloseCallback(base::OnceClosure callback) {
+  close_callback_ = std::move(callback);
+}
