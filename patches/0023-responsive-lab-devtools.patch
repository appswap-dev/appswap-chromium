diff --git a/chrome/browser/ui/views/app_swap/app_swap_responsive_lab_devtools_host.cc b/chrome/browser/ui/views/app_swap/app_swap_responsive_lab_devtools_host.cc
new file mode 100644
index 0000000000000..ad715b50daef3
--- /dev/null
+++ b/chrome/browser/ui/views/app_swap/app_swap_responsive_lab_devtools_host.cc
@@ -0,0 +1,134 @@
+// Copyright 2026 The AppSwap Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/views/app_swap/app_swap_responsive_lab_devtools_host.h"
+
+#include <string>
+#include <utility>
+#include <vector>
+
+#include "base/functional/bind.h"
+#include "chrome/browser/devtools/devtools_window.h"
+#include "chrome/browser/profiles/profile.h"
+#include "content/public/browser/devtools_agent_host.h"
+#include "content/public/browser/web_contents.h"
+
+AppSwapResponsiveLabDevToolsHost::AppSwapResponsiveLabDevToolsHost(
+    content::WebContents* web_contents)
+    : content::WebContentsUserData<AppSwapResponsiveLabDevToolsHost>(
+          *web_contents),
+      session_(AppSwapResponsiveLabSession::GetOrCreateForWebContents(
+          web_contents)) {
+  session_observation_.Observe(session_);
+}
+
+AppSwapResponsiveLabDevToolsHost::~AppSwapResponsiveLabDevToolsHost() = default;
+
+void AppSwapResponsiveLabDevToolsHost::OnResponsiveLabDevToolsRequested() {
+  if (!session_ || !session_->inspection_allowed()) {
+    return;
+  }
+  if (window_) {
+    // Already open on this lab. PushTargets() re-sends focus, which is what
+    // the user is usually after when they ask a second time, and raising it
+    // is what they asked for literally.
+    PushTargets();
+    window_->ShowForAppSwapLab();
+    return;
+  }
+
+  content::WebContents* contents = ContentsToOpenOn();
+  if (!contents) {
+    return;
+  }
+  // The page target rather than the tab target: a page target is its own
+  // outermost target, which is what SDK.Target.outermostTarget() -- and
+  // therefore the frontend's scope -- resolves to per cell. Going through
+  // the tab target would attach a second, useless target per cell and put a
+  // shared ancestor in the way.
+  scoped_refptr<content::DevToolsAgentHost> agent_host =
+      content::DevToolsAgentHost::GetOrCreateFor(contents);
+  if (!agent_host) {
+    return;
+  }
+
+  window_ = DevToolsWindow::OpenDevToolsWindowForAppSwapLab(
+      Profile::FromBrowserContext(GetWebContents().GetBrowserContext()),
+      agent_host);
+  if (!window_) {
+    return;
+  }
+  window_->SetCloseCallback(base::BindOnce(
+      [](base::WeakPtr<AppSwapResponsiveLabDevToolsHost> host) {
+        if (host) {
+          host->window_ = nullptr;
+        }
+      },
+      weak_factory_.GetWeakPtr()));
+  PushTargets();
+}
+
+void AppSwapResponsiveLabDevToolsHost::OnResponsiveLabViewportsChanged() {
+  PushTargets();
+}
+
+void AppSwapResponsiveLabDevToolsHost::
+    OnResponsiveLabViewportContentsChanged() {
+  PushTargets();
+}
+
+void AppSwapResponsiveLabDevToolsHost::OnResponsiveLabFocusedViewportChanged() {
+  PushTargets();
+}
+
+void AppSwapResponsiveLabDevToolsHost::OnResponsiveLabSessionDestroying() {
+  session_observation_.Reset();
+  session_ = nullptr;
+  // Deliberately leaves the window open: it belongs to the user now, and
+  // closing it out from under them on a tab close is worse than leaving an
+  // empty frontend they can dismiss themselves.
+  window_ = nullptr;
+}
+
+content::WebContents* AppSwapResponsiveLabDevToolsHost::ContentsToOpenOn() {
+  const AppSwapResponsiveLabSession::Viewport* focused =
+      session_->FindViewport(session_->focused_viewport_id());
+  if (focused && focused->contents) {
+    return focused->contents;
+  }
+  for (const AppSwapResponsiveLabSession::Viewport& viewport :
+       session_->viewports()) {
+    if (viewport.contents) {
+      return viewport.contents;
+    }
+  }
+  return nullptr;
+}
+
+void AppSwapResponsiveLabDevToolsHost::PushTargets() {
+  if (!window_ || !session_) {
+    return;
+  }
+  std::vector<std::string> target_ids;
+  std::string focused_target_id;
+  for (const AppSwapResponsiveLabSession::Viewport& viewport :
+       session_->viewports()) {
+    if (!viewport.contents) {
+      continue;
+    }
+    scoped_refptr<content::DevToolsAgentHost> agent_host =
+        content::DevToolsAgentHost::GetOrCreateFor(viewport.contents);
+    if (!agent_host) {
+      continue;
+    }
+    if (viewport.preset.id == session_->focused_viewport_id()) {
+      focused_target_id = agent_host->GetId();
+    }
+    target_ids.push_back(agent_host->GetId());
+  }
+  window_->SetAppSwapLabTargets(std::move(target_ids),
+                                std::move(focused_target_id));
+}
+
+WEB_CONTENTS_USER_DATA_KEY_IMPL(AppSwapResponsiveLabDevToolsHost);
