+// Copyright 2026 The AppSwap Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_VIEWS_APP_SWAP_APP_SWAP_RESPONSIVE_LAB_DEVTOOLS_HOST_H_
+#define CHROME_BROWSER_UI_VIEWS_APP_SWAP_APP_SWAP_RESPONSIVE_LAB_DEVTOOLS_HOST_H_
+
+#include "base/memory/raw_ptr.h"
+#include "base/memory/weak_ptr.h"
+#include "base/scoped_observation.h"
+#include "chrome/browser/app_swap/app_swap_responsive_lab_session.h"
+#include "content/public/browser/web_contents_user_data.h"
+
+class DevToolsWindow;
+
+// Keeps one real DevTools frontend pointed at one tab's Responsive Lab.
+//
+// The lab shows N cells, each its own WebContents and therefore its own
+// page target. The frontend is attached to the *browser* target instead of
+// to any one of them, which is what lets it see targets it does not own:
+// Target.autoAttachRelated is only allowed on a browser session, and it is
+// how each cell gets attached. Focusing a cell then retargets the panels
+// through TargetManager's scope mechanism, which every panel but Sources
+// already honours -- so Elements, Console and Network follow the focused
+// cell with no per-panel work.
+//
+// Lives in the Views layer rather than next to AppSwapResponsiveLabSession
+// for the same reason the enterprise-policy check does (see
+// AppSwapResponsiveLabSession::inspection_allowed()): opening a DevTools
+// window means //chrome/browser/devtools, which //chrome/browser/app_swap
+// must not depend on. The session signals what it wants and this listens,
+// which also lets the panel -- further still from //chrome/browser/ui --
+// ask for DevTools without reaching into Views itself.
+//
+// One per tab, like AppSwapResponsiveLabGridHolder, and for the same
+// reason: the window has to survive switching tabs away and back.
+class AppSwapResponsiveLabDevToolsHost
+    : public content::WebContentsUserData<AppSwapResponsiveLabDevToolsHost>,
+      public AppSwapResponsiveLabSession::Observer {
+ public:
+  ~AppSwapResponsiveLabDevToolsHost() override;
+
+  AppSwapResponsiveLabDevToolsHost(const AppSwapResponsiveLabDevToolsHost&) =
+      delete;
+  AppSwapResponsiveLabDevToolsHost& operator=(
+      const AppSwapResponsiveLabDevToolsHost&) = delete;
+
+  // AppSwapResponsiveLabSession::Observer:
+  void OnResponsiveLabDevToolsRequested() override;
+  void OnResponsiveLabViewportsChanged() override;
+  void OnResponsiveLabViewportContentsChanged() override;
+  void OnResponsiveLabFocusedViewportChanged() override;
+  void OnResponsiveLabSessionDestroying() override;
+
+ private:
+  friend class content::WebContentsUserData<AppSwapResponsiveLabDevToolsHost>;
+  explicit AppSwapResponsiveLabDevToolsHost(content::WebContents* web_contents);
+
+  // The cell the frontend should follow: the focused one, or -- before
+  // anything has been clicked into -- the first one that has a live cell.
+  // Null when the lab has no live cells at all, which is the state between
+  // toggling it on and the grid building itself.
+  content::WebContents* ContentsToOpenOn();
+
+  // Re-sends the whole cell list and the focused cell. Cheap enough to do
+  // on every change: the list is short, and the frontend drops the ones it
+  // has already attached.
+  void PushTargets();
+
+  // Cleared in OnResponsiveLabSessionDestroying(): the session is a
+  // separate WebContentsUserData on the same tab, and the order two of
+  // those are destroyed in is unspecified, so this can outlive it.
+  raw_ptr<AppSwapResponsiveLabSession> session_;
+
+  // Null until the user asks for DevTools, and again once they close the
+  // window -- SetCloseCallback() is what clears it. Not owned: a DevTools
+  // window owns itself and outlives nothing in particular.
+  raw_ptr<DevToolsWindow> window_ = nullptr;
+
+  base::ScopedObservation<AppSwapResponsiveLabSession,
+                          AppSwapResponsiveLabSession::Observer>
+      session_observation_{this};
+
+  base::WeakPtrFactory<AppSwapResponsiveLabDevToolsHost> weak_factory_{this};
+
+  WEB_CONTENTS_USER_DATA_KEY_DECL();
+};
+
+#endif  // CHROME_BROWSER_UI_VIEWS_APP_SWAP_APP_SWAP_RESPONSIVE_LAB_DEVTOOLS_HOST_H_
