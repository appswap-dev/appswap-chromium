+void DevToolsUIBindings::SetAppSwapLabTargets(
+    std::vector<std::string> target_ids,
+    std::string focused_target_id) {
+  app_swap_lab_target_ids_ = std::move(target_ids);
+  app_swap_lab_focused_target_id_ = std::move(focused_target_id);
+  SendAppSwapLabTargets();
+}
+
+void DevToolsUIBindings::SendAppSwapLabTargets() {
+  if (!frontend_loaded_) {
+    return;
+  }
+  base::ListValue target_ids;
+  for (const std::string& target_id : app_swap_lab_target_ids_) {
+    target_ids.Append(target_id);
+  }
+  CallClientMethod("DevToolsAPI", "appSwapLabTargetsChanged",
+                   base::Value(std::move(target_ids)));
+  // An empty focus is the state a lab starts in, before anything has been
+  // clicked into. Sending it would ask the frontend to scope to a target
+  // that does not exist, so leave the frontend where it is instead.
+  if (!app_swap_lab_focused_target_id_.empty()) {
+    CallClientMethod("DevToolsAPI", "appSwapLabFocusedTargetChanged",
+                     base::Value(app_swap_lab_focused_target_id_));
+  }
+}
+
 void DevToolsUIBindings::Detach() {
   if (agent_host_.get()) {
     agent_host_->DetachClient(this);
@@ -3277,6 +3304,7 @@ void DevToolsUIBindings::FrontendLoaded() {
     CallClientMethod("DevToolsAPI", "setInitialTargetId",
                      base::Value(initial_target_id_));
   }
+  SendAppSwapLabTargets();
   AddDevToolsExtensionsToClient();
 }
 
