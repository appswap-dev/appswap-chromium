@@ -0,0 +1,77 @@
+// Copyright 2026 The AppSwap Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/views/app_swap/app_swap_profile_switch_util.h"
+
+#include <memory>
+#include <string>
+#include <utility>
+
+#include "chrome/browser/app_swap/app_swap_profiles_service.h"
+#include "chrome/browser/app_swap/app_swap_profiles_service_factory.h"
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/browser/ui/browser_window/public/browser_window_interface.h"
+#include "chrome/browser/ui/page_info/chrome_page_info_delegate.h"
+#include "chrome/browser/ui/tabs/tab_strip_model.h"
+#include "content/public/browser/navigation_controller.h"
+#include "content/public/browser/site_instance.h"
+#include "content/public/browser/storage_partition_config.h"
+#include "content/public/browser/web_contents.h"
+#include "content/public/common/referrer.h"
+#include "ui/base/page_transition_types.h"
+
+void SwitchActiveAppSwapProfile(const std::string& new_profile_id,
+                                content::WebContents* web_contents) {
+  AppSwapProfilesService* service = AppSwapProfilesServiceFactory::GetForProfile(
+      Profile::FromBrowserContext(web_contents->GetBrowserContext()));
+  if (!service) {
+    // Doesn't apply to Incognito/Guest/System (see AppSwapProfileTabStripButton
+    // for why) -- this should be unreachable in practice, since the only
+    // caller only offers profiles to switch to after successfully loading
+    // them from this same (non-null) service, but a direct/future caller
+    // shouldn't crash if it skips that check.
+    return;
+  }
+  service->SetActiveProfile(new_profile_id);
+
+  BrowserWindowInterface* browser =
+      ChromePageInfoDelegate::DefaultGetBrowserCallback().Run(web_contents);
+  if (!browser) {
+    return;
+  }
+  TabStripModel* tab_strip_model = browser->GetTabStripModel();
+  if (tab_strip_model->GetIndexOfWebContents(web_contents) ==
+      TabStripModel::kNoTab) {
+    return;
+  }
+
+  content::BrowserContext* browser_context = web_contents->GetBrowserContext();
+  content::StoragePartitionConfig partition_config =
+      content::StoragePartitionConfig::Create(
+          browser_context, kAppSwapProfilePartitionDomain,
+          /*partition_name=*/new_profile_id, /*in_memory=*/false);
+  scoped_refptr<content::SiteInstance> site_instance =
+      content::SiteInstance::CreateForFixedStoragePartition(
+          browser_context, web_contents->GetLastCommittedURL(),
+          partition_config);
+
+  content::WebContents::CreateParams create_params(browser_context,
+                                                    site_instance);
+  std::unique_ptr<content::WebContents> new_contents =
+      content::WebContents::Create(create_params);
+  content::WebContents* raw_new_contents = new_contents.get();
+
+  // Replaces `web_contents` at its current tab-strip index in one call,
+  // preserving position/active state, and hands back the old contents by
+  // unique_ptr.
+  std::unique_ptr<content::WebContents> old_contents =
+      tab_strip_model->DiscardWebContents(web_contents,
+                                          std::move(new_contents));
+
+  raw_new_contents->GetController().LoadURL(
+      old_contents->GetLastCommittedURL(), content::Referrer(),
+      ui::PAGE_TRANSITION_RELOAD, std::string());
+
+  old_contents.reset();  // Synchronous destroy -- see header comment.
+}
