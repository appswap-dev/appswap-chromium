+
+#ifndef CHROME_BROWSER_UI_VIEWS_APP_SWAP_APP_SWAP_PROFILE_SWITCH_UTIL_H_
+#define CHROME_BROWSER_UI_VIEWS_APP_SWAP_APP_SWAP_PROFILE_SWITCH_UTIL_H_
+
+#include <string>
+
+namespace content {
+class WebContents;
+}  // namespace content
+
+// Persists `new_profile_id` as the active profile for its app, then rebuilds
+// `web_contents`'s tab with a SiteInstance fixed to that profile's storage
+// partition, reloading the current URL in place. No-op if `web_contents`
+// isn't currently in a tab strip.
+//
+// Safe to call synchronously from a click handler even though it destroys
+// `web_contents`: this is native Views UI code, not code running inside
+// `web_contents`'s renderer, and PageInfoBubbleViewBase::WebContentsDestroyed()
+// only ever calls the asynchronous Widget::Close() -- matching the fully
+// synchronous discard-and-destroy pattern already used by
+// TabLifecycleUnit::FinishDiscard for memory-saver tab discarding.
+void SwitchActiveAppSwapProfile(const std::string& new_profile_id,
+                                content::WebContents* web_contents);
+
+#endif  // CHROME_BROWSER_UI_VIEWS_APP_SWAP_APP_SWAP_PROFILE_SWITCH_UTIL_H_
