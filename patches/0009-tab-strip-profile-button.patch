+// Copyright 2026 The AppSwap Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_VIEWS_APP_SWAP_APP_SWAP_PROFILE_SWITCH_UTIL_H_
+#define CHROME_BROWSER_UI_VIEWS_APP_SWAP_APP_SWAP_PROFILE_SWITCH_UTIL_H_
+
+#include <string>
+
+namespace content {
+class WebContents;
+}  // namespace content
+
+// Persists `new_profile_id` as the active profile for its app, then rebuilds
+// `web_contents`'s tab with a SiteInstance fixed to that profile's storage
+// partition, reloading the current URL in place. No-op if `web_contents`
+// isn't currently in a tab strip.
+//
+// Safe to call synchronously from a click handler even though it destroys
+// `web_contents`: this is native Views UI code, not code running inside
+// `web_contents`'s renderer, and PageInfoBubbleViewBase::WebContentsDestroyed()
+// only ever calls the asynchronous Widget::Close() -- matching the fully
+// synchronous discard-and-destroy pattern already used by
+// TabLifecycleUnit::FinishDiscard for memory-saver tab discarding.
+void SwitchActiveAppSwapProfile(const std::string& new_profile_id,
+                                content::WebContents* web_contents);
+
+#endif  // CHROME_BROWSER_UI_VIEWS_APP_SWAP_APP_SWAP_PROFILE_SWITCH_UTIL_H_
diff --git a/chrome/browser/ui/views/app_swap/app_swap_profile_tab_strip_button.cc b/chrome/browser/ui/views/app_swap/app_swap_profile_tab_strip_button.cc
new file mode 100644
index 0000000000..22a5c9c5ce
--- /dev/null
+++ b/chrome/browser/ui/views/app_swap/app_swap_profile_tab_strip_button.cc
@@ -0,0 +1,263 @@
+// Copyright 2026 The AppSwap Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/views/app_swap/app_swap_profile_tab_strip_button.h"
+
+#include <iterator>
+#include <optional>
+#include <string>
+#include <utility>
+
+#include "base/functional/bind.h"
+#include "base/hash/hash.h"
+#include "base/strings/utf_string_conversions.h"
+#include "chrome/browser/ui/browser_window/public/browser_window_interface.h"
+#include "chrome/browser/ui/tabs/tab_strip_model.h"
+#include "chrome/browser/ui/views/app_swap/app_swap_profile_switch_util.h"
+#include "content/public/browser/render_frame_host.h"
+#include "content/public/browser/render_process_host.h"
+#include "content/public/browser/storage_partition.h"
+#include "content/public/browser/storage_partition_config.h"
+#include "content/public/browser/web_contents.h"
+#include "ui/base/metadata/metadata_impl_macros.h"
+#include "ui/base/mojom/menu_source_type.mojom.h"
+#include "ui/base/models/menu_separator_types.h"
+#include "ui/base/window_open_disposition.h"
+#include "ui/color/color_id.h"
+#include "ui/color/color_provider.h"
+#include "ui/gfx/color_utils.h"
+#include "ui/gfx/geometry/insets.h"
+#include "ui/views/background.h"
+#include "ui/views/border.h"
+#include "ui/views/controls/menu/menu_item_view.h"
+#include "ui/views/controls/menu/menu_model_adapter.h"
+#include "ui/views/controls/menu/menu_runner.h"
+#include "url/gurl.h"
+
+namespace {
+
+// Command ids for the profile-picker menu. Purely local to this menu's own
+// ExecuteCommand -- not part of chrome's global command-id space.
+constexpr int kCreateProfileCommandId = 1;
+constexpr int kProfileCommandBase = 2;
+
+// Modest rounding for a "rounded rectangle" chip, not a full pill/stadium.
+constexpr float kBadgeCornerRadius = 6.0f;
+
+// Curated hues (degrees) for the badge palette, deliberately NOT a raw
+// hash-to-hue mapping across the full color wheel. Two reasons:
+//  - Yellow/yellow-green hues (~50-100 degrees) read as a washed-out,
+//    "dirty" pastel rather than a clear color once lightened for light-theme
+//    backgrounds, so they're excluded entirely.
+//  - An arbitrary hue can land anywhere on the red-green confusion axis that
+//    dominates the most common (red-green) forms of color blindness. This
+//    palette instead spans hues that stay visually distinct from each other
+//    even under red-green confusion: blue, teal, a blue-leaning green,
+//    purple, magenta, orange, indigo, and a pink-leaning red.
+constexpr double kBadgeHues[] = {
+    210.0,  // blue
+    175.0,  // teal
+    150.0,  // blue-leaning green (not yellow-green)
+    265.0,  // purple
+    330.0,  // magenta / pink
+    25.0,   // orange
+    245.0,  // indigo
+    355.0,  // pink-leaning red
+};
+
+// Deterministically maps a profile name to one of `kBadgeHues` via a stable
+// (cross-run, cross-platform) hash, so e.g. "Alice" always lands on the same
+// hue -- distinct names usually land on visibly different colors, and the
+// same name always looks the same.
+double HueForProfileName(const std::string& name) {
+  return kBadgeHues[base::PersistentHash(name) % std::size(kBadgeHues)];
+}
+
+SkColor ComputeBadgeBackgroundColor(const std::string& name, bool dark_theme) {
+  color_utils::HSL hsl;
+  hsl.h = HueForProfileName(name) / 360.0;
+  // Clearly-colored (not washed-out) chips on light backgrounds, muted-dark
+  // chips on dark backgrounds -- same hue either way, just a tone appropriate
+  // to the theme.
+  hsl.s = dark_theme ? 0.40 : 0.62;
+  hsl.l = dark_theme ? 0.28 : 0.80;
+  return color_utils::HSLToSkColor(hsl, SK_AlphaOPAQUE);
+}
+
+// Picks a text color guaranteed to meet WCAG AA contrast (>= 4.5:1) against
+// `background`: BlendForMinContrast always succeeds by blending toward
+// whichever of black/white contrasts more, so this can't produce an
+// inaccessible pairing regardless of the hash-picked hue.
+SkColor ComputeBadgeTextColor(SkColor background) {
+  return color_utils::BlendForMinContrast(SK_ColorBLACK, background).color;
+}
+
+}  // namespace
+
+AppSwapProfileTabStripButton::AppSwapProfileTabStripButton(
+    BrowserWindowInterface* browser)
+    : views::MenuButton(base::BindRepeating(
+          &AppSwapProfileTabStripButton::ButtonPressed,
+          base::Unretained(this))),
+      browser_(browser) {
+  SetVisible(false);
+  browser_->GetTabStripModel()->AddObserver(this);
+  profiles_change_subscription_ =
+      AppSwapProfilesService::GetInstance()->AddChangeCallback(
+          base::BindRepeating(
+              &AppSwapProfileTabStripButton::UpdateForActiveTab,
+              base::Unretained(this)));
+  UpdateForActiveTab();
+}
+
+AppSwapProfileTabStripButton::~AppSwapProfileTabStripButton() {
+  browser_->GetTabStripModel()->RemoveObserver(this);
+}
+
+void AppSwapProfileTabStripButton::OnTabStripModelChanged(
+    TabStripModel* tab_strip_model,
+    const TabStripModelChange& change,
+    const TabStripSelectionChange& selection) {
+  if (selection.active_tab_changed()) {
+    UpdateForActiveTab();
+  }
+}
+
+void AppSwapProfileTabStripButton::OnTabChangedAt(tabs::TabInterface* tab,
+                                                   TabChangeType change_type) {
+  UpdateForActiveTab();
+}
+
+void AppSwapProfileTabStripButton::UpdateForActiveTab() {
+  content::WebContents* web_contents =
+      browser_->GetTabStripModel()->GetActiveWebContents();
+
+  // The badge reflects what Profile *this tab* is actually running under --
+  // read directly from its real, already-assigned storage partition, not
+  // from AppSwapProfilesService's global "default for new navigations"
+  // pointer. A tab's partition is fixed at creation/switch time
+  // (SiteInstance::CreateForFixedStoragePartition) and stays that way no
+  // matter what gets activated elsewhere afterwards, so reading the global
+  // pointer here would show the wrong name on every tab except the one most
+  // recently switched (this was a real bug: switching Gmail to a different
+  // Profile in one tab silently relabeled every other open tab too).
+  if (web_contents) {
+    content::StoragePartition* partition = web_contents->GetPrimaryMainFrame()
+                                                ->GetProcess()
+                                                ->GetStoragePartition();
+    const content::StoragePartitionConfig& config = partition->GetConfig();
+    if (config.partition_domain() == kAppSwapProfilePartitionDomain) {
+      const std::string profile_id = config.partition_name();
+      for (const AppSwapProfile& profile :
+           AppSwapProfilesService::GetInstance()->GetProfilesIfLoaded()) {
+        if (profile.id == profile_id) {
+          SetText(base::UTF8ToUTF16(profile.name));
+          ApplyBadgeStyle(profile.name);
+          SetVisible(true);
+          return;
+        }
+      }
+      // The partition belongs to a Profile that's since been removed -- fall
+      // through to the "no Profile assigned" placeholder below.
+    }
+  }
+
+  // This tab isn't running under any Profile's partition. Profiles are a
+  // general browser identity feature for any website (e.g. switching which
+  // Gmail account you're signed into), not something specific to AppSwap's
+  // npm apps, so offer this as a discovery entry point on every ordinary web
+  // page -- stays hidden only on non-web pages (chrome://, file://, etc.),
+  // where there's no "site identity" for a Profile to apply to.
+  if (!web_contents ||
+      !web_contents->GetLastCommittedURL().SchemeIsHTTPOrHTTPS()) {
+    SetVisible(false);
+    return;
+  }
+  SetText(u"Profile");
+  ApplyBadgeStyle("Profile");
+  SetVisible(true);
+}
+
+void AppSwapProfileTabStripButton::ApplyBadgeStyle(
+    const std::string& profile_name) {
+  bool dark_theme = false;
+  if (const ui::ColorProvider* color_provider = GetColorProvider()) {
+    dark_theme =
+        color_utils::IsDark(color_provider->GetColor(ui::kColorWindowBackground));
+  }
+
+  const SkColor background_color =
+      ComputeBadgeBackgroundColor(profile_name, dark_theme);
+  const SkColor text_color = ComputeBadgeTextColor(background_color);
+
+  SetBackground(
+      views::CreateRoundedRectBackground(background_color, kBadgeCornerRadius));
+  SetEnabledTextColors(text_color);
+  SetBorder(views::CreateEmptyBorder(gfx::Insets::VH(4, 10)));
+}
+
+void AppSwapProfileTabStripButton::OnThemeChanged() {
+  views::MenuButton::OnThemeChanged();
+  UpdateForActiveTab();
+}
+
+void AppSwapProfileTabStripButton::ButtonPressed() {
+  // Tear down any previous menu before rebuilding: menu_runner_ owns a
+  // MenuItemView tree built from menu_model_adapter_/menu_model_, so it must
+  // be destroyed first -- destroying menu_model_/menu_model_adapter_ first
+  // (as a plain top-to-bottom reassignment below would do) leaves that old
+  // tree referencing already-freed objects, which crashes (dangling raw_ptr
+  // detected) once menu_runner_ is finally reset.
+  menu_runner_.reset();
+  menu_model_adapter_.reset();
+  menu_model_.reset();
+
+  // List every configured profile, not just the current page's app -- the
+  // active profile is a global identity, so switching can pick any of them
+  // regardless of what site the button happens to be showing on right now.
+  menu_profiles_ = AppSwapProfilesService::GetInstance()->GetProfilesIfLoaded();
+
+  menu_model_ = std::make_unique<ui::SimpleMenuModel>(this);
+  for (size_t i = 0; i < menu_profiles_.size(); ++i) {
+    const AppSwapProfile& profile = menu_profiles_[i];
+    menu_model_->AddItem(kProfileCommandBase + static_cast<int>(i),
+                         base::UTF8ToUTF16(profile.name));
+  }
+  menu_model_->AddSeparator(ui::NORMAL_SEPARATOR);
+  menu_model_->AddItem(kCreateProfileCommandId, u"Create new profile");
+
+  menu_model_adapter_ = std::make_unique<views::MenuModelAdapter>(
+      menu_model_.get());
+  std::unique_ptr<views::MenuItemView> root = menu_model_adapter_->CreateMenu();
+  menu_runner_ = std::make_unique<views::MenuRunner>(
+      std::move(root), views::MenuRunner::HAS_MNEMONICS);
+  menu_runner_->RunMenuAt(GetWidget(), nullptr, GetAnchorBoundsInScreen(),
+                          views::MenuAnchorPosition::kTopLeft,
+                          ui::mojom::MenuSourceType::kNone);
+}
+
+void AppSwapProfileTabStripButton::ExecuteCommand(int command_id,
+                                                   int event_flags) {
+  content::WebContents* web_contents =
+      browser_->GetTabStripModel()->GetActiveWebContents();
+  if (!web_contents) {
+    return;
+  }
+
+  if (command_id == kCreateProfileCommandId) {
+    browser_->OpenGURL(GURL("appswap://profiles"),
+                       WindowOpenDisposition::NEW_FOREGROUND_TAB);
+    return;
+  }
+
+  const size_t index = static_cast<size_t>(command_id - kProfileCommandBase);
+  if (index >= menu_profiles_.size()) {
+    return;
+  }
+  SwitchActiveAppSwapProfile(menu_profiles_[index].id, web_contents);
+  UpdateForActiveTab();
+}
+
+BEGIN_METADATA(AppSwapProfileTabStripButton)
+END_METADATA
