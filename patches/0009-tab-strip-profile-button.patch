+// A tab-strip-leading button showing the AppSwap Profile that's currently
+// the browser's active identity -- a general per-browser identity feature
+// for any website (e.g. switching which Gmail account you're signed into),
+// not scoped to any one app, route, or tab. Shows the active profile's name
+// once one is set; before that, shows a neutral "Profile" placeholder on any
+// ordinary web page so the switcher is discoverable everywhere, not just on
+// AppSwap's npm apps. Clicking it opens a menu listing every configured
+// Profile (across all apps) plus a "Create new profile" action; picking one
+// reloads the current tab under that profile's storage partition, and going
+// forward every new http/https navigation in this browser uses that same
+// partition too, until switched again.
+class AppSwapProfileTabStripButton : public views::MenuButton,
+                                     public TabStripModelObserver,
+                                     public ui::SimpleMenuModel::Delegate {
+  METADATA_HEADER(AppSwapProfileTabStripButton, views::MenuButton)
+
+ public:
+  explicit AppSwapProfileTabStripButton(BrowserWindowInterface* browser);
+  AppSwapProfileTabStripButton(const AppSwapProfileTabStripButton&) = delete;
+  AppSwapProfileTabStripButton& operator=(const AppSwapProfileTabStripButton&) =
+      delete;
+  ~AppSwapProfileTabStripButton() override;
+
+  // TabStripModelObserver:
+  void OnTabStripModelChanged(
+      TabStripModel* tab_strip_model,
+      const TabStripModelChange& change,
+      const TabStripSelectionChange& selection) override;
+  void OnTabChangedAt(tabs::TabInterface* tab,
+                      TabChangeType change_type) override;
+
+  // ui::SimpleMenuModel::Delegate:
+  void ExecuteCommand(int command_id, int event_flags) override;
+
+  // views::View:
+  void OnThemeChanged() override;
+
+ private:
+  // Recomputes visibility and label text from the global active profile.
+  void UpdateForActiveTab();
+
+  // Gives the button a colored badge/chip appearance keyed off a hash of
+  // |profile_name|, so the same name always gets the same hue (e.g. "Alice"
+  // is always greenish). The background tone adapts to the current light/dark
+  // theme, and the text color is chosen to guarantee WCAG AA contrast
+  // (>= 4.5:1) against whatever background results.
+  void ApplyBadgeStyle(const std::string& profile_name);
+
+  // Builds and runs the profile-picker menu.
+  void ButtonPressed();
+
+  raw_ptr<BrowserWindowInterface> browser_;
+
+  // Refreshes the badge when the profile list changes anywhere -- e.g. a
+  // rename made via appswap://profiles, which otherwise wouldn't reach this
+  // button until the active tab itself happened to change.
+  base::CallbackListSubscription profiles_change_subscription_;
+
+  // The profiles menu currently shown -- kept in sync with the menu so
+  // ExecuteCommand's command ids resolve against the same list the user
+  // picked from.
+  std::vector<AppSwapProfile> menu_profiles_;
+
+  std::unique_ptr<ui::SimpleMenuModel> menu_model_;
+  std::unique_ptr<views::MenuModelAdapter> menu_model_adapter_;
+  std::unique_ptr<views::MenuRunner> menu_runner_;
+};
+
