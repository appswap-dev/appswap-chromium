+#include "content/public/browser/storage_partition_config.h"
+#include "content/public/browser/web_contents.h"
+#include "ui/base/metadata/metadata_impl_macros.h"
+#include "ui/base/mojom/menu_source_type.mojom.h"
+#include "ui/base/models/menu_separator_types.h"
+#include "ui/base/window_open_disposition.h"
+#include "chrome/browser/ui/views/app_swap/app_swap_badge_style.h"
+#include "ui/color/color_id.h"
+#include "ui/color/color_provider.h"
+#include "ui/gfx/color_utils.h"
+#include "ui/views/controls/menu/menu_item_view.h"
+#include "ui/views/controls/menu/menu_model_adapter.h"
+#include "ui/views/controls/menu/menu_runner.h"
+#include "url/gurl.h"
+
+namespace {
+
+// Command ids for the profile-picker menu. Purely local to this menu's own
+// ExecuteCommand -- not part of chrome's global command-id space.
+constexpr int kCreateProfileCommandId = 1;
+constexpr int kProfileCommandBase = 2;
+
+
+}  // namespace
+
+AppSwapProfileTabStripButton::AppSwapProfileTabStripButton(
+    BrowserWindowInterface* browser)
+    : views::MenuButton(base::BindRepeating(
+          &AppSwapProfileTabStripButton::ButtonPressed,
+          base::Unretained(this))),
+      browser_(browser) {
+  SetVisible(false);
+  browser_->GetTabStripModel()->AddObserver(this);
+  // AppSwapProfilesServiceFactory only builds an instance for regular
+  // profiles (ProfileKeyedServiceFactory's default ProfileSelections
+  // excludes Incognito/Guest/System) -- AppSwap Profiles are a real per-
+  // window storage-partition identity, which doesn't make sense inside
+  // those anyway, so this button just stays permanently hidden there
+  // instead (see the matching guard in UpdateForActiveTab() and
+  // ButtonPressed()) rather than crashing. Confirmed via a real crash dump:
+  // opening an Incognito window used to null-deref right here.
+  if (AppSwapProfilesService* service = AppSwapProfilesServiceFactory::GetForProfile(
+          browser_->GetProfile())) {
+    profiles_change_subscription_ = service->AddChangeCallback(
+        base::BindRepeating(
+            &AppSwapProfileTabStripButton::UpdateForActiveTab,
+            base::Unretained(this)));
+  }
+  UpdateForActiveTab();
+}
+
+AppSwapProfileTabStripButton::~AppSwapProfileTabStripButton() {
+  browser_->GetTabStripModel()->RemoveObserver(this);
+}
+
+void AppSwapProfileTabStripButton::OnTabStripModelChanged(
+    TabStripModel* tab_strip_model,
+    const TabStripModelChange& change,
+    const TabStripSelectionChange& selection) {
+  if (selection.active_tab_changed()) {
+    UpdateForActiveTab();
+  }
+}
+
+void AppSwapProfileTabStripButton::OnTabChangedAt(tabs::TabInterface* tab,
+                                                   TabChangeType change_type) {
+  UpdateForActiveTab();
+}
+
+void AppSwapProfileTabStripButton::UpdateForActiveTab() {
+  AppSwapProfilesService* service =
+      AppSwapProfilesServiceFactory::GetForProfile(browser_->GetProfile());
+  if (!service) {
+    SetVisible(false);
+    return;
+  }
+
+  content::WebContents* web_contents =
+      browser_->GetTabStripModel()->GetActiveWebContents();
+
+  // The badge reflects what Profile *this tab* is actually running under --
+  // read directly from its real, already-assigned storage partition, not
+  // from AppSwapProfilesService's global "default for new navigations"
+  // pointer. A tab's partition is fixed at creation/switch time
+  // (SiteInstance::CreateForFixedStoragePartition) and stays that way no
+  // matter what gets activated elsewhere afterwards, so reading the global
+  // pointer here would show the wrong name on every tab except the one most
+  // recently switched (this was a real bug: switching Gmail to a different
+  // Profile in one tab silently relabeled every other open tab too).
+  if (web_contents) {
+    content::StoragePartition* partition = web_contents->GetPrimaryMainFrame()
+                                                ->GetProcess()
+                                                ->GetStoragePartition();
+    const content::StoragePartitionConfig& config = partition->GetConfig();
+    if (config.partition_domain() == kAppSwapProfilePartitionDomain) {
+      const std::string profile_id = config.partition_name();
+      for (const AppSwapProfile& profile : service->GetProfilesIfLoaded()) {
+        if (profile.id == profile_id) {
+          SetText(base::UTF8ToUTF16(profile.name));
+          ApplyBadgeStyle(profile.name);
+          SetVisible(true);
+          return;
+        }
+      }
+      // The partition belongs to a Profile that's since been removed -- fall
+      // through to the "no Profile assigned" placeholder below.
+    }
+  }
+
+  // This tab isn't running under any Profile's partition. Profiles are a
+  // general browser identity feature for any website (e.g. switching which
+  // Gmail account you're signed into), not something specific to AppSwap's
+  // npm apps, so offer this as a discovery entry point on every ordinary web
+  // page -- stays hidden only on non-web pages (chrome://, file://, etc.),
+  // where there's no "site identity" for a Profile to apply to.
+  if (!web_contents ||
+      !web_contents->GetLastCommittedURL().SchemeIsHTTPOrHTTPS()) {
+    SetVisible(false);
+    return;
+  }
+  SetText(u"Profile");
+  ApplyBadgeStyle("Profile");
+  SetVisible(true);
+}
+
+void AppSwapProfileTabStripButton::ApplyBadgeStyle(
+    const std::string& profile_name) {
+  bool dark_theme = false;
+  if (const ui::ColorProvider* color_provider = GetColorProvider()) {
+    dark_theme = color_utils::IsDark(
+        color_provider->GetColor(ui::kColorWindowBackground));
+  }
+  ApplyAppSwapBadgeStyle(this, profile_name, dark_theme);
+}
+
+void AppSwapProfileTabStripButton::OnThemeChanged() {
+  views::MenuButton::OnThemeChanged();
+  UpdateForActiveTab();
+}
+
+void AppSwapProfileTabStripButton::ButtonPressed() {
+  AppSwapProfilesService* service =
+      AppSwapProfilesServiceFactory::GetForProfile(browser_->GetProfile());
+  if (!service) {
+    return;
+  }
+
+  // Tear down any previous menu before rebuilding: menu_runner_ owns a
+  // MenuItemView tree built from menu_model_adapter_/menu_model_, so it must
+  // be destroyed first -- destroying menu_model_/menu_model_adapter_ first
+  // (as a plain top-to-bottom reassignment below would do) leaves that old
+  // tree referencing already-freed objects, which crashes (dangling raw_ptr
+  // detected) once menu_runner_ is finally reset.
+  menu_runner_.reset();
+  menu_model_adapter_.reset();
+  menu_model_.reset();
+
+  // List every configured profile, not just the current page's app -- the
+  // active profile is a global identity, so switching can pick any of them
+  // regardless of what site the button happens to be showing on right now.
+  menu_profiles_ = service->GetProfilesIfLoaded();
+
+  menu_model_ = std::make_unique<ui::SimpleMenuModel>(this);
+  for (size_t i = 0; i < menu_profiles_.size(); ++i) {
+    const AppSwapProfile& profile = menu_profiles_[i];
+    menu_model_->AddItem(kProfileCommandBase + static_cast<int>(i),
+                         base::UTF8ToUTF16(profile.name));
+  }
+  menu_model_->AddSeparator(ui::NORMAL_SEPARATOR);
+  menu_model_->AddItem(kCreateProfileCommandId, u"Create new profile");
+
+  menu_model_adapter_ = std::make_unique<views::MenuModelAdapter>(
+      menu_model_.get());
+  std::unique_ptr<views::MenuItemView> root = menu_model_adapter_->CreateMenu();
+  menu_runner_ = std::make_unique<views::MenuRunner>(
+      std::move(root), views::MenuRunner::HAS_MNEMONICS);
+  menu_runner_->RunMenuAt(GetWidget(), nullptr, GetAnchorBoundsInScreen(),
+                          views::MenuAnchorPosition::kTopLeft,
+                          ui::mojom::MenuSourceType::kNone);
+}
+
+void AppSwapProfileTabStripButton::ExecuteCommand(int command_id,
+                                                   int event_flags) {
+  content::WebContents* web_contents =
+      browser_->GetTabStripModel()->GetActiveWebContents();
+  if (!web_contents) {
+    return;
+  }
+
+  if (command_id == kCreateProfileCommandId) {
+    browser_->OpenGURL(GURL("appswap://projects"),
+                       WindowOpenDisposition::NEW_FOREGROUND_TAB);
+    return;
+  }
+
+  const size_t index = static_cast<size_t>(command_id - kProfileCommandBase);
+  if (index >= menu_profiles_.size()) {
+    return;
+  }
+  SwitchActiveAppSwapProfile(menu_profiles_[index].id, web_contents);
+  UpdateForActiveTab();
+}
+
+BEGIN_METADATA(AppSwapProfileTabStripButton)
+END_METADATA
