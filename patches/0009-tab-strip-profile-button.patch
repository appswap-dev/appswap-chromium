diff --git a/chrome/browser/ui/views/app_swap/app_swap_badge_style.cc b/chrome/browser/ui/views/app_swap/app_swap_badge_style.cc
new file mode 100644
index 0000000000000..8a574947a32d4
--- /dev/null
+++ b/chrome/browser/ui/views/app_swap/app_swap_badge_style.cc
@@ -0,0 +1,171 @@
+// Copyright 2026 The AppSwap Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/views/app_swap/app_swap_badge_style.h"
+
+#include <iterator>
+#include <memory>
+
+#include "base/hash/hash.h"
+#include "base/memory/raw_ptr.h"
+#include "cc/paint/paint_flags.h"
+#include "ui/gfx/canvas.h"
+#include "ui/gfx/color_utils.h"
+#include "ui/gfx/geometry/insets.h"
+#include "ui/gfx/geometry/rect_f.h"
+#include "ui/views/animation/ink_drop.h"
+#include "ui/views/background.h"
+#include "ui/views/border.h"
+#include "ui/views/controls/button/label_button.h"
+
+namespace {
+
+// Curated hues (degrees), deliberately NOT a raw hash-to-hue mapping across
+// the full color wheel. Two reasons:
+//  - Yellow/yellow-green hues (~50-100 degrees) read as a washed-out,
+//    "dirty" pastel rather than a clear color once lightened for a
+//    light-theme chip, so they're excluded entirely.
+//  - An arbitrary hue can land anywhere on the red-green confusion axis that
+//    dominates the most common forms of color blindness. This palette
+//    instead spans hues that stay visually distinct from each other even
+//    under red-green confusion: blue, teal, a blue-leaning green, purple,
+//    magenta, orange, indigo, and a pink-leaning red.
+constexpr double kBadgeHues[] = {
+    210.0,  // blue
+    175.0,  // teal
+    150.0,  // blue-leaning green (not yellow-green)
+    265.0,  // purple
+    330.0,  // magenta / pink
+    25.0,   // orange
+    245.0,  // indigo
+    355.0,  // pink-leaning red
+};
+
+// Padding inside the pill. Horizontal is the larger of the two because a
+// pill's rounded ends eat into the visual space beside the text; matching
+// the vertical padding would leave the name looking cramped against the
+// curve.
+constexpr int kBadgeVerticalPadding = 4;
+constexpr int kBadgeHorizontalPadding = 12;
+
+// How far hover and pressed states pull the fill toward the text color.
+// Small: the chip is already colored, so a heavy state change reads as the
+// chip changing identity rather than as feedback.
+constexpr float kHoverBlend = 0.10f;
+constexpr float kPressedBlend = 0.20f;
+
+double HueForName(const std::string& name) {
+  return kBadgeHues[base::PersistentHash(name) % std::size(kBadgeHues)];
+}
+
+SkColor FromHsl(double hue_degrees, double saturation, double lightness) {
+  color_utils::HSL hsl;
+  hsl.h = hue_degrees / 360.0;
+  hsl.s = saturation;
+  hsl.l = lightness;
+  return color_utils::HSLToSkColor(hsl, SK_AlphaOPAQUE);
+}
+
+// Paints the pill: a fill that responds to the button's state, and a hairline
+// border in a stronger tone of the same hue.
+//
+// A custom Background rather than views::CreateRoundedRectBackground plus a
+// views::Border for two reasons. The corner radius has to be half the
+// button's height to be a true pill, which isn't known until layout, and the
+// hover and pressed tints have to stay in the chip's own hue -- the default
+// ink drop would wash a gray highlight over a colored chip, so these chips
+// turn it off and paint their own.
+class BadgeBackground : public views::Background {
+ public:
+  BadgeBackground(const views::Button* button, AppSwapBadgeColors colors)
+      : button_(button), colors_(colors) {}
+
+  BadgeBackground(const BadgeBackground&) = delete;
+  BadgeBackground& operator=(const BadgeBackground&) = delete;
+  ~BadgeBackground() override = default;
+
+  void Paint(gfx::Canvas* canvas, views::View* view) const override {
+    const gfx::RectF bounds(view->GetLocalBounds());
+    if (bounds.IsEmpty()) {
+      return;
+    }
+    const float radius = bounds.height() / 2.0f;
+
+    SkColor fill = colors_.background;
+    switch (button_->GetState()) {
+      case views::Button::STATE_HOVERED:
+        fill = color_utils::AlphaBlend(colors_.text, fill, kHoverBlend);
+        break;
+      case views::Button::STATE_PRESSED:
+        fill = color_utils::AlphaBlend(colors_.text, fill, kPressedBlend);
+        break;
+      default:
+        break;
+    }
+
+    cc::PaintFlags flags;
+    flags.setAntiAlias(true);
+    flags.setStyle(cc::PaintFlags::kFill_Style);
+    flags.setColor(fill);
+    canvas->DrawRoundRect(bounds, radius, flags);
+
+    // Inset by half the stroke so the 1px line lands inside the chip rather
+    // than straddling its edge and antialiasing to a 2px smear.
+    gfx::RectF stroke_bounds = bounds;
+    stroke_bounds.Inset(0.5f);
+    flags.setStyle(cc::PaintFlags::kStroke_Style);
+    flags.setStrokeWidth(1.0f);
+    flags.setColor(colors_.border);
+    canvas->DrawRoundRect(stroke_bounds, radius - 0.5f, flags);
+  }
+
+ private:
+  const raw_ptr<const views::Button> button_;
+  const AppSwapBadgeColors colors_;
+};
+
+}  // namespace
+
+AppSwapBadgeColors GetAppSwapBadgeColors(const std::string& name,
+                                         bool dark_theme) {
+  const double hue = HueForName(name);
+
+  AppSwapBadgeColors colors;
+  if (dark_theme) {
+    colors.background = FromHsl(hue, 0.32, 0.20);
+    colors.border = FromHsl(hue, 0.30, 0.32);
+    colors.text = FromHsl(hue, 0.55, 0.80);
+  } else {
+    // Deeper than a pure surface tint would be. The project chip sits on
+    // the window frame, which is itself tinted, so a 0.95-lightness fill
+    // vanished into it even though it read fine against the near-white
+    // toolbar the other two chips sit on.
+    colors.background = FromHsl(hue, 0.62, 0.88);
+    colors.border = FromHsl(hue, 0.50, 0.74);
+    colors.text = FromHsl(hue, 0.72, 0.29);
+  }
+
+  // The tones above are chosen to clear WCAG AA already; this guarantees it
+  // for every hue in the palette rather than trusting that. BlendForMinContrast
+  // returns the color unchanged when it already passes, so a passing pair
+  // keeps its exact hue.
+  colors.text =
+      color_utils::BlendForMinContrast(colors.text, colors.background).color;
+  return colors;
+}
+
+void ApplyAppSwapBadgeStyle(views::LabelButton* button,
+                            const std::string& name,
+                            bool dark_theme) {
+  const AppSwapBadgeColors colors = GetAppSwapBadgeColors(name, dark_theme);
+
+  // Off, so the chip's own hover and pressed tints are the only feedback --
+  // see BadgeBackground's comment.
+  views::InkDrop::Get(button)->SetMode(views::InkDropHost::InkDropMode::OFF);
+
+  button->SetBackground(std::make_unique<BadgeBackground>(button, colors));
+  button->SetEnabledTextColors(colors.text);
+  button->SetBorder(views::CreateEmptyBorder(
+      gfx::Insets::VH(kBadgeVerticalPadding, kBadgeHorizontalPadding)));
+}
diff --git a/chrome/browser/ui/views/app_swap/app_swap_badge_style.h b/chrome/browser/ui/views/app_swap/app_swap_badge_style.h
new file mode 100644
index 0000000000000..3e7d7731b2e30
--- /dev/null
+++ b/chrome/browser/ui/views/app_swap/app_swap_badge_style.h
@@ -0,0 +1,52 @@
+// Copyright 2026 The AppSwap Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_VIEWS_APP_SWAP_APP_SWAP_BADGE_STYLE_H_
+#define CHROME_BROWSER_UI_VIEWS_APP_SWAP_APP_SWAP_BADGE_STYLE_H_
+
+#include <string>
+
+#include "third_party/skia/include/core/SkColor.h"
+
+namespace views {
+class LabelButton;
+}  // namespace views
+
+// The look of the colored chips AppSwap adds to the browser frame: the
+// project selector in the tab strip, and the AppSwap Profile and Route Group
+// buttons in the location bar.
+//
+// One place rather than three. All three chips are the same control wearing
+// a different name, and each used to carry its own copy of the palette and
+// the color math -- so a change to any of it had to be made three times, and
+// the two later copies could only describe themselves as "same curated
+// palette as AppSwapProfileTabStripButton".
+//
+// The chip is a tonal pill: a light tint of the name's own hue, text in a
+// much darker tone of that same hue, and a slightly stronger border of it
+// again. That reads as an accent on the toolbar rather than as a highlighter
+// pen over it, and it leaves the name itself -- which is the thing the user
+// is actually reading -- as the highest-contrast element in the chip.
+
+// One chip's three colors, all derived from the same hue.
+struct AppSwapBadgeColors {
+  SkColor background;
+  SkColor border;
+  SkColor text;
+};
+
+// Deterministic: the same `name` always yields the same colors, so a project
+// or profile keeps its identity across restarts and across machines.
+AppSwapBadgeColors GetAppSwapBadgeColors(const std::string& name,
+                                         bool dark_theme);
+
+// Gives `button` the chip look for `name`: a pill background that tracks
+// hover and pressed state, matching text color, and the shared metrics.
+// Safe to call repeatedly -- the chips re-apply this whenever their name or
+// the theme changes.
+void ApplyAppSwapBadgeStyle(views::LabelButton* button,
+                            const std::string& name,
+                            bool dark_theme);
+
+#endif  // CHROME_BROWSER_UI_VIEWS_APP_SWAP_APP_SWAP_BADGE_STYLE_H_
