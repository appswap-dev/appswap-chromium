+
+namespace content {
+class WebContents;
+}  // namespace content
+
+// Implements the version-picker's PageHandler: fetches the package's
+// dist-tags/versions for display, and performs the actual switch (pin +
+// resolve + reload) the originating tab when one is picked. `entry` (the
+// target tab + AppSwapApp, consumed from AppSwapVersionPickerContext by
+// AppSwapVersionPickerUI) is nullopt if the token in the page's URL was
+// unknown/stale -- every method then just reports failure/empty rather than
+// crashing, since that can legitimately happen (e.g. the tab closed in the
+// gap between navigating here and the page actually loading).
+class AppSwapVersionPickerPageHandler
+    : public app_swap_version_picker::mojom::PageHandler {
+ public:
+  AppSwapVersionPickerPageHandler(
+      mojo::PendingReceiver<app_swap_version_picker::mojom::PageHandler>
+          handler,
+      std::optional<AppSwapVersionPickerContext::Entry> entry);
+  AppSwapVersionPickerPageHandler(const AppSwapVersionPickerPageHandler&) =
+      delete;
+  AppSwapVersionPickerPageHandler& operator=(
+      const AppSwapVersionPickerPageHandler&) = delete;
+  ~AppSwapVersionPickerPageHandler() override;
+
+  // app_swap_version_picker::mojom::PageHandler:
+  void GetVersionInfo(GetVersionInfoCallback callback) override;
+  void SelectVersion(const std::string& value,
+                     SelectVersionCallback callback) override;
+
+ private:
+  // Returns the target WebContents, or nullptr if `entry_` is unset or the
+  // tab it referred to has since been closed.
+  content::WebContents* GetTargetWebContents() const;
+
+  std::optional<AppSwapVersionPickerContext::Entry> entry_;
+  mojo::Receiver<app_swap_version_picker::mojom::PageHandler> receiver_;
+
+  base::WeakPtrFactory<AppSwapVersionPickerPageHandler> weak_factory_{this};
+};
+
+#endif  // CHROME_BROWSER_UI_WEBUI_APP_SWAP_VERSION_PICKER_APP_SWAP_VERSION_PICKER_PAGE_HANDLER_H_
