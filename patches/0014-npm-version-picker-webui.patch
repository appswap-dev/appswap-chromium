@@ -0,0 +1,38 @@
+// Copyright 2026 The AppSwap Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+module app_swap_version_picker.mojom;
+
+// A published dist-tag and the version it currently resolves to.
+struct TagInfo {
+  string name;
+  string resolved_version;
+};
+
+// A published version and the dist-tags (if any) currently pointing at it.
+struct VersionInfo {
+  string version;
+  array<string> tags;
+};
+
+interface PageHandlerFactory {
+  CreatePageHandler(pending_receiver<PageHandler> handler);
+};
+
+interface PageHandler {
+  // Tags first (each with what it currently resolves to), then every
+  // published version (each with any tags pointing at it) -- mirrors
+  // AppSwapArtifactProvider::FetchPackageMetadata(). `current_value` is
+  // this tab's effective version (its own pin, or the app's configured
+  // default), for pre-selecting/highlighting the active row. All fields
+  // come back empty on failure (network error, or the tab/app this bubble
+  // was opened for no longer exists).
+  GetVersionInfo() => (array<TagInfo> tags, array<VersionInfo> versions,
+                       string current_value);
+
+  // Pins the originating tab to `value` and reloads it once resolved.
+  // `success` is false if the tab or app no longer exists, or resolution
+  // failed.
+  SelectVersion(string value) => (bool success);
+};
diff --git a/chrome/browser/ui/webui/app_swap_version_picker/app_swap_version_picker_context.cc b/chrome/browser/ui/webui/app_swap_version_picker/app_swap_version_picker_context.cc
