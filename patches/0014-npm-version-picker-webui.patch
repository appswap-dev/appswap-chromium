+// Copyright 2026 The AppSwap Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/webui/app_swap_version_picker/app_swap_version_picker_context.h"
+
+#include <utility>
+
+#include "base/no_destructor.h"
+#include "base/uuid.h"
+#include "content/public/browser/web_contents.h"
+
+WebContentsWeakHandle::WebContentsWeakHandle(content::WebContents* web_contents)
+    : content::WebContentsUserData<WebContentsWeakHandle>(*web_contents) {}
+
+WebContentsWeakHandle::~WebContentsWeakHandle() = default;
+
+base::WeakPtr<WebContentsWeakHandle> WebContentsWeakHandle::GetWeakPtr() {
+  return weak_factory_.GetWeakPtr();
+}
+
+WEB_CONTENTS_USER_DATA_KEY_IMPL(WebContentsWeakHandle);
+
+AppSwapVersionPickerContext::Entry::Entry() = default;
+AppSwapVersionPickerContext::Entry::Entry(const Entry&) = default;
+AppSwapVersionPickerContext::Entry& AppSwapVersionPickerContext::Entry::
+operator=(const Entry&) = default;
+AppSwapVersionPickerContext::Entry::~Entry() = default;
+
+// static
+AppSwapVersionPickerContext* AppSwapVersionPickerContext::GetInstance() {
+  static base::NoDestructor<AppSwapVersionPickerContext> instance;
+  return instance.get();
+}
+
+AppSwapVersionPickerContext::AppSwapVersionPickerContext() = default;
+AppSwapVersionPickerContext::~AppSwapVersionPickerContext() = default;
+
+std::string AppSwapVersionPickerContext::Stash(Entry entry) {
+  std::string token = base::Uuid::GenerateRandomV4().AsLowercaseString();
+  entries_[token] = std::move(entry);
+  return token;
+}
+
+std::optional<AppSwapVersionPickerContext::Entry>
+AppSwapVersionPickerContext::Consume(const std::string& token) {
+  auto it = entries_.find(token);
+  if (it == entries_.end()) {
+    return std::nullopt;
+  }
+  Entry entry = std::move(it->second);
+  entries_.erase(it);
+  return entry;
+}
