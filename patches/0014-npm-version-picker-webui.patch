+
+#include "chrome/browser/ui/webui/app_swap_version_picker/app_swap_version_picker_ui.h"
+
+#include <utility>
+
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/browser/ui/webui/app_swap_version_picker/app_swap_version_picker_page_handler.h"
+#include "chrome/grit/app_swap_version_picker_resources.h"
+#include "chrome/grit/app_swap_version_picker_resources_map.h"
+#include "content/public/browser/render_frame_host.h"
+#include "content/public/browser/web_contents.h"
+#include "content/public/browser/web_ui.h"
+#include "content/public/browser/web_ui_data_source.h"
+#include "content/public/common/url_constants.h"
+#include "net/base/url_util.h"
+#include "ui/webui/webui_util.h"
+#include "url/gurl.h"
+
+AppSwapVersionPickerUIConfig::AppSwapVersionPickerUIConfig()
+    : DefaultWebUIConfig(content::kChromeUIScheme,
+                         "appswap-version-picker") {}
+
+AppSwapVersionPickerUI::AppSwapVersionPickerUI(content::WebUI* web_ui,
+                                               const GURL& url)
+    : content::WebUIController(web_ui) {
+  Profile* profile = Profile::FromWebUI(web_ui);
+  content::WebUIDataSource* source = content::WebUIDataSource::CreateAndAdd(
+      profile, "appswap-version-picker");
+  webui::SetupWebUIDataSource(
+      source, kAppSwapVersionPickerResources,
+      IDR_APP_SWAP_VERSION_PICKER_APP_SWAP_VERSION_PICKER_HTML);
+
+  // The tab/app this page is for was stashed under a token embedded in
+  // `url`'s query string by CreateAppSwapVersionPickerSubpageView() -- see
+  // AppSwapVersionPickerContext's comment. Consumed here, once.
+  std::string token;
+  net::GetValueForKeyInQuery(url, "token", &token);
+  consumed_entry_ = AppSwapVersionPickerContext::GetInstance()->Consume(token);
+}
+
+AppSwapVersionPickerUI::~AppSwapVersionPickerUI() = default;
+
+WEB_UI_CONTROLLER_TYPE_IMPL(AppSwapVersionPickerUI)
+
+void AppSwapVersionPickerUI::WebUIRenderFrameCreated(
+    content::RenderFrameHost* rfh) {
+  rfh->EnableMojoJsBindings(nullptr);
+}
+
+void AppSwapVersionPickerUI::BindInterface(
+    mojo::PendingReceiver<app_swap_version_picker::mojom::PageHandlerFactory>
+        receiver) {
+  page_factory_receiver_.reset();
+  page_factory_receiver_.Bind(std::move(receiver));
+}
+
+void AppSwapVersionPickerUI::CreatePageHandler(
+    mojo::PendingReceiver<app_swap_version_picker::mojom::PageHandler>
+        handler) {
+  page_handler_ = std::make_unique<AppSwapVersionPickerPageHandler>(
+      std::move(handler), std::move(consumed_entry_));
+}
