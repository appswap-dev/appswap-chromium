@@ -0,0 +1,100 @@
+// Copyright 2026 The AppSwap Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_WEBUI_APP_SWAP_VERSION_PICKER_APP_SWAP_VERSION_PICKER_CONTEXT_H_
+#define CHROME_BROWSER_UI_WEBUI_APP_SWAP_VERSION_PICKER_APP_SWAP_VERSION_PICKER_CONTEXT_H_
+
+#include <map>
+#include <optional>
+#include <string>
+
+#include "base/functional/callback.h"
+#include "base/memory/weak_ptr.h"
+#include "chrome/browser/app_swap/app_swap_apps_service.h"
+#include "content/public/browser/web_contents_user_data.h"
+
+namespace content {
+class WebContents;
+}  // namespace content
+
+// content::WebContents has no public GetWeakPtr(); this gives callers that
+// need to reference a tab across an async gap (network fetch, download) a
+// safe way to do so without holding a raw WebContents pointer that could be
+// closed out from under them.
+class WebContentsWeakHandle
+    : public content::WebContentsUserData<WebContentsWeakHandle> {
+ public:
+  ~WebContentsWeakHandle() override;
+
+  base::WeakPtr<WebContentsWeakHandle> GetWeakPtr();
+
+ private:
+  friend class content::WebContentsUserData<WebContentsWeakHandle>;
+  explicit WebContentsWeakHandle(content::WebContents* web_contents);
+
+  base::WeakPtrFactory<WebContentsWeakHandle> weak_factory_{this};
+
+  WEB_CONTENTS_USER_DATA_KEY_DECL();
+};
+
+// One-shot registry mapping a random token (embedded in the version-picker
+// sub-page's URL query string) to the tab + app it was opened for.
+//
+// A content::WebUIController is constructed generically by the framework
+// from a URL alone -- there's no way to pass a WebContents pointer into its
+// constructor directly, and this page (unlike e.g. Tab Search) is tied to
+// one specific tab, not just the browser window it's shown in.
+// CreateAppSwapVersionPickerSubpageView() stashes an entry here and builds a
+// URL carrying its token; AppSwapVersionPickerUI's constructor consumes
+// (looks up and erases) it.
+class AppSwapVersionPickerContext {
+ public:
+  struct Entry {
+    Entry();
+    Entry(const Entry&);
+    Entry& operator=(const Entry&);
+    ~Entry();
+
+    base::WeakPtr<WebContentsWeakHandle> web_contents_handle;
+    AppSwapApp app;
+
+    // Closes the Page Info bubble this page was opened from -- a
+    // type-erased closure (rather than a PageInfoNavigationHandler pointer
+    // directly) so this webui-layer class doesn't need to depend on
+    // chrome/browser/ui/views/page_info. Picking a version reloads
+    // `web_contents_handle`'s tab -- while that reload's navigation commit
+    // fires WebContentsObserver notifications (e.g.
+    // DidChangeVisibleSecurityState) that a *still-open* Page Info bubble
+    // reacts to by re-querying security/identity state for the page that's
+    // mid-navigation, which PageInfo::PresentSiteIdentity() isn't prepared
+    // for (DCHECK_NE(site_identity_status_, SITE_IDENTITY_STATUS_UNKNOWN)
+    // fires). Closing the bubble first -- matching how the native dialog
+    // this replaced always closed Page Info before switching -- avoids
+    // that entirely, and matches the expected UX anyway. Null if the
+    // bubble/tab this page was opened for is already gone.
+    base::RepeatingClosure close_page_info;
+  };
+
+  static AppSwapVersionPickerContext* GetInstance();
+
+  AppSwapVersionPickerContext(const AppSwapVersionPickerContext&) = delete;
+  AppSwapVersionPickerContext& operator=(const AppSwapVersionPickerContext&) =
+      delete;
+
+  // Stashes `entry` and returns the token to embed in the bubble URL.
+  std::string Stash(Entry entry);
+
+  // Looks up and erases the entry for `token`. Returns nullopt if the token
+  // is unknown (e.g. already consumed, or a stale/malformed URL).
+  std::optional<Entry> Consume(const std::string& token);
+
+ private:
+  friend class base::NoDestructor<AppSwapVersionPickerContext>;
+  AppSwapVersionPickerContext();
+  ~AppSwapVersionPickerContext();
+
+  std::map<std::string, Entry> entries_;
+};
+
+#endif  // CHROME_BROWSER_UI_WEBUI_APP_SWAP_VERSION_PICKER_APP_SWAP_VERSION_PICKER_CONTEXT_H_
