+
+class AppSwapVersionPickerPageHandler;
+class AppSwapVersionPickerUI;
+class GURL;
+
+namespace content {
+class RenderFrameHost;
+}  // namespace content
+
+class AppSwapVersionPickerUIConfig
+    : public content::DefaultWebUIConfig<AppSwapVersionPickerUI> {
+ public:
+  AppSwapVersionPickerUIConfig();
+};
+
+// The "Switch version" content shown as a Page Info sub-page (like
+// "Cookies and Site Data" or "Permissions") -- a small WebUI page embedded
+// directly via a plain views::WebView, not a separate floating bubble.
+// Page Info's own sub-page navigation (PageInfoNavigationHandler /
+// PageInfoBubbleView::SwitchToPage) already handles showing/hiding this
+// alongside a "Back" button, so this class only needs to be a normal,
+// directly-navigable WebUI page -- no TopChromeWebUIController/
+// WebUIBubbleManager "hidden until shown" machinery, which is specific to
+// floating anchored bubbles and doesn't apply here (and, being anchored to
+// a view living inside Page Info's *own* popup, that approach also
+// suffered from Page Info's popup closing itself right after dispatching
+// the triggering click, immediately auto-closing the anchored bubble
+// before its renderer ever got a chance to run).
+//
+// The tab/app this page is for is threaded in via AppSwapVersionPickerContext
+// (see that class's comment for why a URL-embedded token, not a direct
+// constructor argument).
+class AppSwapVersionPickerUI : public content::WebUIController,
+                               public app_swap_version_picker::mojom::
+                                   PageHandlerFactory {
+ public:
+  AppSwapVersionPickerUI(content::WebUI* web_ui, const GURL& url);
+  AppSwapVersionPickerUI(const AppSwapVersionPickerUI&) = delete;
+  AppSwapVersionPickerUI& operator=(const AppSwapVersionPickerUI&) = delete;
+  ~AppSwapVersionPickerUI() override;
+
+  void BindInterface(
+      mojo::PendingReceiver<
+          app_swap_version_picker::mojom::PageHandlerFactory> receiver);
+
+ private:
+  // content::WebUIController:
+  void WebUIRenderFrameCreated(content::RenderFrameHost* rfh) override;
+
+  // app_swap_version_picker::mojom::PageHandlerFactory:
+  void CreatePageHandler(
+      mojo::PendingReceiver<app_swap_version_picker::mojom::PageHandler>
+          handler) override;
+
+  std::optional<AppSwapVersionPickerContext::Entry> consumed_entry_;
+  std::unique_ptr<AppSwapVersionPickerPageHandler> page_handler_;
+  mojo::Receiver<app_swap_version_picker::mojom::PageHandlerFactory>
+      page_factory_receiver_{this};
+
+  WEB_UI_CONTROLLER_TYPE_DECL();
+};
+
+#endif  // CHROME_BROWSER_UI_WEBUI_APP_SWAP_VERSION_PICKER_APP_SWAP_VERSION_PICKER_UI_H_
