@@ -0,0 +1,110 @@
+// Copyright 2026 The AppSwap Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+import {CrLitElement} from 'chrome://resources/lit/v3_0/lit.rollup.js';
+import 'chrome://resources/cr_elements/cr_input/cr_input.js';
+
+import {getCss} from './app.css.js';
+import {getHtml} from './app.html.js';
+import type {BrowserProxy} from './browser_proxy.js';
+import {BrowserProxyImpl} from './browser_proxy.js';
+import type {TagInfo, VersionInfo} from './app_swap_version_picker.mojom-webui.js';
+
+export interface Row {
+  value: string;
+  primaryText: string;
+  secondaryText: string;
+  isCurrent: boolean;
+}
+
+export class AppSwapVersionPickerAppElement extends CrLitElement {
+  static get is() {
+    return 'app-swap-version-picker-app';
+  }
+
+  static override get styles() {
+    return getCss();
+  }
+
+  override render() {
+    return getHtml.bind(this)();
+  }
+
+  static override get properties() {
+    return {
+      filter_: {type: String},
+      tagRows_: {type: Array},
+      versionRows_: {type: Array},
+      loading_: {type: Boolean},
+    };
+  }
+
+  private apiProxy_: BrowserProxy = BrowserProxyImpl.getInstance();
+  protected accessor filter_: string = '';
+  protected accessor tagRows_: Row[] = [];
+  protected accessor versionRows_: Row[] = [];
+  protected accessor loading_: boolean = true;
+
+  override connectedCallback() {
+    super.connectedCallback();
+    this.apiProxy_.handler.getVersionInfo().then(
+        ({tags, versions, currentValue}) => {
+          this.tagRows_ = tags.map((tag: TagInfo) => ({
+                                     value: tag.name,
+                                     primaryText: tag.name,
+                                     secondaryText: tag.resolvedVersion,
+                                     isCurrent: tag.name === currentValue,
+                                   }));
+          this.versionRows_ = versions.map((version: VersionInfo) => ({
+                                             value: version.version,
+                                             primaryText: version.version,
+                                             secondaryText:
+                                                 version.tags.join(', '),
+                                             isCurrent:
+                                                 version.version ===
+                                                 currentValue,
+                                           }));
+          this.loading_ = false;
+        });
+  }
+
+  protected onFilterValueChanged_(e: CustomEvent<{value: string}>) {
+    this.filter_ = e.detail.value;
+  }
+
+  protected filteredTagRows_(): Row[] {
+    return this.filterRows_(this.tagRows_);
+  }
+
+  protected filteredVersionRows_(): Row[] {
+    return this.filterRows_(this.versionRows_);
+  }
+
+  private filterRows_(rows: Row[]): Row[] {
+    const filter = this.filter_.trim().toLowerCase();
+    if (!filter) {
+      return rows;
+    }
+    return rows.filter(
+        row => row.primaryText.toLowerCase().includes(filter) ||
+            row.secondaryText.toLowerCase().includes(filter));
+  }
+
+  protected async onRowClick_(e: Event) {
+    const value = (e.currentTarget as HTMLElement).dataset['value']!;
+    const {success} = await this.apiProxy_.handler.selectVersion(value);
+    if (success) {
+      window.close();
+    }
+  }
+}
+
+declare global {
+  interface HTMLElementTagNameMap {
+    'app-swap-version-picker-app': AppSwapVersionPickerAppElement;
+  }
+}
+
+customElements.define(
+    AppSwapVersionPickerAppElement.is, AppSwapVersionPickerAppElement);
