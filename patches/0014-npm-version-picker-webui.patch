@@ -0,0 +1,166 @@
+// Copyright 2026 The AppSwap Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/webui/app_swap_version_picker/app_swap_version_picker_page_handler.h"
+
+#include <algorithm>
+#include <map>
+#include <utility>
+#include <vector>
+
+#include "base/files/file_path.h"
+#include "base/functional/bind.h"
+#include "chrome/browser/app_swap/app_swap_artifact_provider.h"
+#include "chrome/browser/app_swap/app_swap_version_pin_tab_helper.h"
+#include "chrome/browser/app_swap/app_swap_version_utils.h"
+#include "content/public/browser/navigation_controller.h"
+#include "content/public/browser/web_contents.h"
+
+AppSwapVersionPickerPageHandler::AppSwapVersionPickerPageHandler(
+    mojo::PendingReceiver<app_swap_version_picker::mojom::PageHandler>
+        handler,
+    std::optional<AppSwapVersionPickerContext::Entry> entry)
+    : entry_(std::move(entry)), receiver_(this, std::move(handler)) {}
+
+AppSwapVersionPickerPageHandler::~AppSwapVersionPickerPageHandler() = default;
+
+content::WebContents*
+AppSwapVersionPickerPageHandler::GetTargetWebContents() const {
+  if (!entry_ || !entry_->web_contents_handle) {
+    return nullptr;
+  }
+  return &entry_->web_contents_handle->GetWebContents();
+}
+
+void AppSwapVersionPickerPageHandler::GetVersionInfo(
+    GetVersionInfoCallback callback) {
+  content::WebContents* web_contents = GetTargetWebContents();
+  if (!web_contents) {
+    std::move(callback).Run({}, {}, std::string());
+    return;
+  }
+
+  AppSwapApp app = entry_->app;
+  AppSwapArtifactProvider::GetInstance()->FetchPackageMetadata(
+      app.ToSource(),
+      base::BindOnce(
+          [](base::WeakPtr<AppSwapVersionPickerPageHandler> self,
+             AppSwapApp app, base::WeakPtr<WebContentsWeakHandle> handle,
+             GetVersionInfoCallback callback,
+             std::optional<AppSwapPackageMetadata> metadata) {
+            if (!self || !handle || !metadata) {
+              std::move(callback).Run({}, {}, std::string());
+              return;
+            }
+            content::WebContents* web_contents = &handle->GetWebContents();
+
+            // "latest" first, then alphabetical -- same ordering the
+            // native dialog used.
+            std::vector<std::string> tag_names;
+            for (const auto& [tag, unused] : metadata->dist_tags) {
+              tag_names.push_back(tag);
+            }
+            std::sort(tag_names.begin(), tag_names.end(),
+                      [](const std::string& a, const std::string& b) {
+                        if (a == "latest" || b == "latest") {
+                          return a == "latest";
+                        }
+                        return a < b;
+                      });
+            std::vector<app_swap_version_picker::mojom::TagInfoPtr> tags;
+            for (const std::string& tag : tag_names) {
+              tags.push_back(app_swap_version_picker::mojom::TagInfo::New(
+                  tag, metadata->dist_tags.at(tag)));
+            }
+
+            // Invert dist-tags: version -> the tag names pointing at it.
+            std::map<std::string, std::vector<std::string>> tags_by_version;
+            for (const auto& [tag, version] : metadata->dist_tags) {
+              tags_by_version[version].push_back(tag);
+            }
+
+            std::vector<std::string> version_names = metadata->versions;
+            std::sort(version_names.begin(), version_names.end(),
+                      [](const std::string& a, const std::string& b) {
+                        return app_swap::IsNewerVersion(a, b);
+                      });
+            std::vector<app_swap_version_picker::mojom::VersionInfoPtr>
+                versions;
+            for (const std::string& version : version_names) {
+              std::vector<std::string> pointing_tags;
+              if (auto it = tags_by_version.find(version);
+                  it != tags_by_version.end()) {
+                pointing_tags = it->second;
+                std::sort(pointing_tags.begin(), pointing_tags.end());
+              }
+              versions.push_back(
+                  app_swap_version_picker::mojom::VersionInfo::New(
+                      version, std::move(pointing_tags)));
+            }
+
+            std::move(callback).Run(
+                std::move(tags), std::move(versions),
+                GetEffectiveAppSwapVersion(app, web_contents));
+          },
+          weak_factory_.GetWeakPtr(), app, entry_->web_contents_handle,
+          std::move(callback)));
+}
+
+void AppSwapVersionPickerPageHandler::SelectVersion(
+    const std::string& value,
+    SelectVersionCallback callback) {
+  content::WebContents* web_contents = GetTargetWebContents();
+  if (!web_contents) {
+    std::move(callback).Run(false);
+    return;
+  }
+
+  // Pin this specific tab to the picked version. Deliberately *not* also
+  // writing it into the app's own configured version (AppSwapAppsService::
+  // UpdateApp) -- doing so would silently change what every other,
+  // never-explicitly-pinned tab on this app resolves to as a side effect of
+  // picking a version in just one tab, defeating the point of a per-tab pin.
+  AppSwapVersionPinTabHelper::GetOrCreateForWebContents(web_contents)
+      ->SetPinnedVersion(entry_->app.id, value);
+
+  AppSwapApp app = entry_->app;
+  app.version = value;
+
+  // EnsureFreshThenGetOrDownload rather than plain GetOrDownload: picking a
+  // dist-tag the provider already has *some* cached resolution for should
+  // serve the tag's current version, not whatever was cached earlier.
+  AppSwapArtifactProvider::GetInstance()->EnsureFreshThenGetOrDownload(
+      app.ToSource(),
+      base::BindOnce(
+          [](base::WeakPtr<WebContentsWeakHandle> handle,
+             base::RepeatingClosure close_page_info,
+             SelectVersionCallback callback, base::FilePath dir) {
+            if (dir.empty() || !handle) {
+              std::move(callback).Run(false);
+              return;
+            }
+            // Reply before reloading, not after: reloading this tab can
+            // tear down the PageHandler this callback runs on (if it's
+            // the same tab Page Info -- and this sub-page's WebView --
+            // is anchored to, the reload's navigation commit fires
+            // PageInfoBubbleViewBase::PrimaryPageChanged, which closes
+            // the whole Page Info widget). `callback`'s underlying mojo
+            // pipe lives on that PageHandler, so it must be run first,
+            // while everything is still guaranteed alive.
+            std::move(callback).Run(true);
+            // Close Page Info before reloading, not after: leaving it open
+            // through the reload lets it react to the mid-navigation
+            // security-state notifications that fire as part of the
+            // commit, which PageInfo::PresentSiteIdentity() isn't
+            // prepared for (DCHECK_NE(site_identity_status_,
+            // SITE_IDENTITY_STATUS_UNKNOWN) fires).
+            if (close_page_info) {
+              close_page_info.Run();
+            }
+            handle->GetWebContents().GetController().Reload(
+                content::ReloadType::NORMAL, /*check_for_repost=*/false);
+          },
+          entry_->web_contents_handle, entry_->close_page_info,
+          std::move(callback)));
+}
