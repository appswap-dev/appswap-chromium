diff --git a/front_end/panels/emulation/DeviceViewportWidget.ts b/front_end/panels/emulation/DeviceViewportWidget.ts
new file mode 100644
index 00000000..7e3d55e9
--- /dev/null
+++ b/front_end/panels/emulation/DeviceViewportWidget.ts
@@ -0,0 +1,86 @@
+// Copyright 2026 The AppSwap Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+import * as SDK from '../../core/sdk/sdk.js';
+import * as EmulationModel from '../../models/emulation/emulation.js';
+import * as UI from '../../ui/legacy/legacy.js';
+import * as Screencast from '../screencast/screencast.js';
+
+type EmulatedDevice = EmulationModel.EmulatedDevices.EmulatedDevice;
+
+// One tile in MultiDeviceView: a labeled frame around a live screencast of
+// one selected device's own background target (see
+// MultiDeviceSelectionModel, which owns that target's lifecycle -- this
+// widget just displays whatever it's given).
+//
+// Wraps Screencast.ScreencastView.ScreencastView wholesale rather than
+// reimplementing frame decoding/painting or input dispatch: it already
+// decodes CDP `Page.screencastFrame` JPEGs into a plain <canvas>, and its
+// canvas event handlers already forward mouse/keyboard input to that
+// specific target's own InputModel (`screenCaptureModel.target().model(
+// InputModel)`), so each tile is independently interactive with zero new
+// input code needed here -- see ScreencastView.ts's own constructor.
+//
+// This tile's own screencast container is given a FIXED, untransformed
+// CSS size matching the device's own declared width/height. That
+// matters: zoom is applied by MultiDeviceView as a `transform:
+// scale(...)` on an ancestor wrapper, which never changes this
+// element's own offsetWidth/offsetHeight -- and
+// ScreencastView.viewportDimensions() (which drives what resolution it
+// actually requests via Page.startScreencast) reads exactly those,
+// untransformed. So the requested screencast resolution stays pinned to
+// the device's real size regardless of zoom, the same "capture at a
+// fixed resolution, scale for display" property the native Views
+// implementation had to fight hard for -- here it falls out for free
+// from ordinary CSS semantics.
+export class DeviceViewportWidget extends UI.Widget.VBox {
+  readonly device: EmulatedDevice;
+  readonly #screencastView: Screencast.ScreencastView.ScreencastView|null;
+
+  constructor(device: EmulatedDevice, target: SDK.Target.Target) {
+    super();
+    this.device = device;
+    this.contentElement.classList.add('device-viewport-widget');
+
+    const orientation = device.orientationByName(device.modes[0].orientation);
+    const width = Math.floor(orientation.width);
+    const height = Math.floor(orientation.height);
+
+    const label = document.createElement('div');
+    label.className = 'device-viewport-widget-label';
+    label.textContent = `${device.title}  ${width} × ${height}`;
+    this.contentElement.appendChild(label);
+
+    const screencastContainer = document.createElement('div');
+    screencastContainer.className = 'device-viewport-widget-screencast';
+    screencastContainer.style.width = `${width}px`;
+    screencastContainer.style.height = `${height}px`;
+    this.contentElement.appendChild(screencastContainer);
+
+    const screenCaptureModel = target.model(SDK.ScreenCaptureModel.ScreenCaptureModel);
+    if (screenCaptureModel) {
+      this.#screencastView = new Screencast.ScreencastView.ScreencastView(
+          screenCaptureModel, undefined, undefined, {hideNavigationBar: true});
+      this.#screencastView.show(screencastContainer);
+      this.#screencastView.initialize();
+    } else {
+      // Shouldn't happen -- ScreenCaptureModel is auto-instantiated for
+      // any target with Capability.SCREEN_CAPTURE, which background
+      // targets always have (see MultiDeviceSelectionModel). Fail
+      // visibly rather than silently showing a blank tile.
+      this.#screencastView = null;
+      screencastContainer.textContent = 'Failed to start screencast for this device.';
+    }
+  }
+
+  override wasShown(): void {
+    super.wasShown();
+    this.#screencastView?.showWidget();
+  }
+
+  override willHide(): void {
+    this.#screencastView?.hideWidget();
+    super.willHide();
+  }
+}
diff --git a/front_end/panels/emulation/MultiDeviceView.ts b/front_end/panels/emulation/MultiDeviceView.ts
new file mode 100644
index 00000000..73019e04
--- /dev/null
+++ b/front_end/panels/emulation/MultiDeviceView.ts
@@ -0,0 +1,328 @@
+// Copyright 2026 The AppSwap Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+import * as EmulationModel from '../../models/emulation/emulation.js';
+import * as UI from '../../ui/legacy/legacy.js';
+
+import {DeviceViewportWidget} from './DeviceViewportWidget.js';
+import multiDeviceViewStyles from './multiDeviceView.css.js';
+
+type EmulatedDevice = EmulationModel.EmulatedDevices.EmulatedDevice;
+
+const TILE_GUTTER = 24;
+const MIN_ZOOM = 0.1;
+const MAX_ZOOM = 2;
+const MINIMAP_WIDTH = 180;
+const MINIMAP_HEIGHT = 130;
+const MINIMAP_MARGIN = 16;
+
+interface TileEntry {
+  device: EmulatedDevice;
+  widget: DeviceViewportWidget;
+  // Position within the (unscaled) canvas content, independent of
+  // pan/zoom -- set once on first add via simple left-to-right auto-flow,
+  // then draggable (dragging individual tiles is not implemented in this
+  // first pass; positions are fixed post-layout, see the class comment).
+  x: number;
+  y: number;
+  width: number;
+  height: number;
+}
+
+// The pan/zoom canvas shown by DeviceModeView in place of the ordinary
+// single-viewport content area whenever 2+ devices are selected (see
+// MultiDeviceSelectionModel). Deliberately implemented with plain CSS
+// transforms rather than porting the native Views implementation's
+// compositor-layer-masking approach: DeviceViewportWidget's tiles are
+// ordinary DOM elements, so a single `transform: translate(...) scale(...)`
+// on one wrapper div is sufficient -- no per-platform native-layer work
+// needed, which was the whole point of moving this feature here.
+//
+// Pan/zoom/tile-layout state lives entirely on this view (plain instance
+// fields), not on MultiDeviceSelectionModel -- that model owns *which*
+// devices are selected and their live targets; this view owns *how*
+// they're currently framed on screen. Camera position does not persist
+// across a panel switch in this first pass.
+export class MultiDeviceView extends UI.Widget.VBox {
+  readonly #model: EmulationModel.MultiDeviceSelectionModel.MultiDeviceSelectionModel;
+  readonly #canvas: HTMLElement;
+  readonly #canvasContent: HTMLElement;
+  readonly #minimap: HTMLElement;
+  readonly #minimapContent: HTMLElement;
+  readonly #minimapIndicator: HTMLElement;
+  readonly #tiles = new Map<EmulatedDevice, TileEntry>();
+
+  #panX = 0;
+  #panY = 0;
+  #zoom = 1;
+  #dragging = false;
+  #dragStartX = 0;
+  #dragStartY = 0;
+  #dragStartPanX = 0;
+  #dragStartPanY = 0;
+  #minimapDragging = false;
+
+  constructor() {
+    super();
+    this.#model = EmulationModel.MultiDeviceSelectionModel.MultiDeviceSelectionModel.instance();
+    this.registerRequiredCSS(multiDeviceViewStyles);
+
+    this.contentElement.classList.add('multi-device-view');
+
+    this.#canvas = document.createElement('div');
+    this.#canvas.className = 'multi-device-canvas';
+    this.contentElement.appendChild(this.#canvas);
+
+    this.#canvasContent = document.createElement('div');
+    this.#canvasContent.className = 'multi-device-canvas-content';
+    this.#canvas.appendChild(this.#canvasContent);
+
+    this.#minimap = document.createElement('div');
+    this.#minimap.className = 'multi-device-minimap';
+    this.#minimap.style.width = `${MINIMAP_WIDTH}px`;
+    this.#minimap.style.height = `${MINIMAP_HEIGHT}px`;
+    this.#minimap.style.right = `${MINIMAP_MARGIN}px`;
+    this.#minimap.style.bottom = `${MINIMAP_MARGIN}px`;
+    this.contentElement.appendChild(this.#minimap);
+
+    this.#minimapContent = document.createElement('div');
+    this.#minimapContent.className = 'multi-device-minimap-content';
+    this.#minimap.appendChild(this.#minimapContent);
+
+    this.#minimapIndicator = document.createElement('div');
+    this.#minimapIndicator.className = 'multi-device-minimap-indicator';
+    this.#minimap.appendChild(this.#minimapIndicator);
+
+    this.#canvas.addEventListener('pointerdown', this.#onCanvasPointerDown.bind(this));
+    this.#canvas.addEventListener('pointermove', this.#onCanvasPointerMove.bind(this));
+    this.#canvas.addEventListener('pointerup', this.#onCanvasPointerUp.bind(this));
+    this.#canvas.addEventListener('pointerleave', this.#onCanvasPointerUp.bind(this));
+    this.#canvas.addEventListener('wheel', this.#onCanvasWheel.bind(this), {passive: false});
+
+    this.#minimap.addEventListener('pointerdown', this.#onMinimapPointerDown.bind(this));
+    this.#minimap.addEventListener('pointermove', this.#onMinimapPointerMove.bind(this));
+    this.#minimap.addEventListener('pointerup', this.#onMinimapPointerUp.bind(this));
+    this.#minimap.addEventListener('pointerleave', this.#onMinimapPointerUp.bind(this));
+
+    this.#model.addEventListener(
+        EmulationModel.MultiDeviceSelectionModel.Events.SELECTION_CHANGED, this.#onSelectionChanged, this);
+  }
+
+  override wasShown(): void {
+    super.wasShown();
+    this.#onSelectionChanged();
+  }
+
+  override willHide(): void {
+    super.willHide();
+  }
+
+  #onSelectionChanged(): void {
+    const devices = this.#model.selection();
+    const deviceSet = new Set(devices);
+
+    for (const [device, tile] of [...this.#tiles]) {
+      if (!deviceSet.has(device) || !this.#model.viewportFor(device)) {
+        tile.widget.detach();
+        this.#tiles.delete(device);
+      }
+    }
+
+    let nextX = 0;
+    for (const device of devices) {
+      if (this.#tiles.has(device)) {
+        continue;
+      }
+      const target = this.#model.viewportFor(device);
+      if (!target) {
+        // Still being created -- #onSelectionChanged() fires again once
+        // MultiDeviceSelectionModel finishes attaching it.
+        continue;
+      }
+      const widget = new DeviceViewportWidget(device, target);
+      widget.show(this.#canvasContent);
+      const orientation = device.orientationByName(device.modes[0].orientation);
+      const entry: TileEntry = {
+        device,
+        widget,
+        x: nextX,
+        y: 0,
+        width: Math.floor(orientation.width),
+        height: Math.floor(orientation.height),
+      };
+      this.#tiles.set(device, entry);
+      nextX += entry.width + TILE_GUTTER;
+      this.#positionTile(entry);
+    }
+
+    this.#updateMinimap();
+  }
+
+  #positionTile(entry: TileEntry): void {
+    entry.widget.element.style.position = 'absolute';
+    entry.widget.element.style.left = `${entry.x}px`;
+    entry.widget.element.style.top = `${entry.y}px`;
+  }
+
+  #applyTransform(): void {
+    this.#canvasContent.style.transform = `translate(${this.#panX}px, ${this.#panY}px) scale(${this.#zoom})`;
+    this.#updateMinimap();
+  }
+
+  #contentBoundingBox(): {left: number, top: number, width: number, height: number} {
+    if (this.#tiles.size === 0) {
+      return {left: 0, top: 0, width: 1, height: 1};
+    }
+    let left = Infinity;
+    let top = Infinity;
+    let right = -Infinity;
+    let bottom = -Infinity;
+    for (const tile of this.#tiles.values()) {
+      left = Math.min(left, tile.x);
+      top = Math.min(top, tile.y);
+      right = Math.max(right, tile.x + tile.width);
+      bottom = Math.max(bottom, tile.y + tile.height);
+    }
+    return {left, top, width: Math.max(1, right - left), height: Math.max(1, bottom - top)};
+  }
+
+  // Maps a point in canvas-content-local (unscaled) space into the
+  // minimap's own local pixel space, using a "fit and center" scale
+  // computed from the current tile bounding box -- recomputed on every
+  // call rather than cached, since it's cheap and this only runs on
+  // user-interaction-driven updates, not every frame.
+  #minimapTransform(): {scale: number, offsetX: number, offsetY: number} {
+    const bbox = this.#contentBoundingBox();
+    const scale = Math.min(MINIMAP_WIDTH / bbox.width, MINIMAP_HEIGHT / bbox.height);
+    const scaledWidth = bbox.width * scale;
+    const scaledHeight = bbox.height * scale;
+    const offsetX = (MINIMAP_WIDTH - scaledWidth) / 2 - bbox.left * scale;
+    const offsetY = (MINIMAP_HEIGHT - scaledHeight) / 2 - bbox.top * scale;
+    return {scale, offsetX, offsetY};
+  }
+
+  #updateMinimap(): void {
+    const {scale, offsetX, offsetY} = this.#minimapTransform();
+
+    this.#minimapContent.innerHTML = '';
+    for (const tile of this.#tiles.values()) {
+      const rect = document.createElement('div');
+      rect.className = 'multi-device-minimap-tile';
+      rect.style.left = `${tile.x * scale + offsetX}px`;
+      rect.style.top = `${tile.y * scale + offsetY}px`;
+      rect.style.width = `${tile.width * scale}px`;
+      rect.style.height = `${tile.height * scale}px`;
+      this.#minimapContent.appendChild(rect);
+    }
+
+    const canvasRect = this.#canvas.getBoundingClientRect();
+    const visibleLeft = -this.#panX / this.#zoom;
+    const visibleTop = -this.#panY / this.#zoom;
+    const visibleWidth = canvasRect.width / this.#zoom;
+    const visibleHeight = canvasRect.height / this.#zoom;
+
+    this.#minimapIndicator.style.left = `${visibleLeft * scale + offsetX}px`;
+    this.#minimapIndicator.style.top = `${visibleTop * scale + offsetY}px`;
+    this.#minimapIndicator.style.width = `${visibleWidth * scale}px`;
+    this.#minimapIndicator.style.height = `${visibleHeight * scale}px`;
+  }
+
+  #onCanvasPointerDown(event: PointerEvent): void {
+    if (event.target !== this.#canvas && event.target !== this.#canvasContent) {
+      // Started on a tile (or something inside one, e.g. its screencast
+      // canvas) -- let that content handle the event normally instead of
+      // panning.
+      return;
+    }
+    this.#dragging = true;
+    this.#dragStartX = event.clientX;
+    this.#dragStartY = event.clientY;
+    this.#dragStartPanX = this.#panX;
+    this.#dragStartPanY = this.#panY;
+    this.#canvas.setPointerCapture(event.pointerId);
+  }
+
+  #onCanvasPointerMove(event: PointerEvent): void {
+    if (!this.#dragging) {
+      return;
+    }
+    this.#panX = this.#dragStartPanX + (event.clientX - this.#dragStartX);
+    this.#panY = this.#dragStartPanY + (event.clientY - this.#dragStartY);
+    this.#applyTransform();
+  }
+
+  #onCanvasPointerUp(event: PointerEvent): void {
+    this.#dragging = false;
+    if (this.#canvas.hasPointerCapture(event.pointerId)) {
+      this.#canvas.releasePointerCapture(event.pointerId);
+    }
+  }
+
+  #onCanvasWheel(event: WheelEvent): void {
+    if (!event.ctrlKey && !event.metaKey) {
+      // Plain wheel: pan. (Trackpad pinch-to-zoom arrives as a
+      // ctrlKey-flagged wheel event in Chromium, handled by the branch
+      // below, same convention as most pannable/zoomable web canvases.)
+      event.preventDefault();
+      this.#panX -= event.deltaX;
+      this.#panY -= event.deltaY;
+      this.#applyTransform();
+      return;
+    }
+
+    event.preventDefault();
+    const canvasRect = this.#canvas.getBoundingClientRect();
+    const anchorX = event.clientX - canvasRect.left;
+    const anchorY = event.clientY - canvasRect.top;
+    const zoomStep = -event.deltaY * 0.01;
+    const newZoom = Math.min(MAX_ZOOM, Math.max(MIN_ZOOM, this.#zoom + zoomStep * this.#zoom));
+    if (newZoom === this.#zoom) {
+      return;
+    }
+    // Keep the content point currently under the cursor fixed on screen.
+    const contentX = (anchorX - this.#panX) / this.#zoom;
+    const contentY = (anchorY - this.#panY) / this.#zoom;
+    this.#zoom = newZoom;
+    this.#panX = anchorX - contentX * this.#zoom;
+    this.#panY = anchorY - contentY * this.#zoom;
+    this.#applyTransform();
+  }
+
+  #onMinimapPointerDown(event: PointerEvent): void {
+    this.#minimapDragging = true;
+    this.#minimap.setPointerCapture(event.pointerId);
+    this.#jumpToMinimapPoint(event);
+  }
+
+  #onMinimapPointerMove(event: PointerEvent): void {
+    if (!this.#minimapDragging) {
+      return;
+    }
+    this.#jumpToMinimapPoint(event);
+  }
+
+  #onMinimapPointerUp(event: PointerEvent): void {
+    this.#minimapDragging = false;
+    if (this.#minimap.hasPointerCapture(event.pointerId)) {
+      this.#minimap.releasePointerCapture(event.pointerId);
+    }
+  }
+
+  #jumpToMinimapPoint(event: PointerEvent): void {
+    const minimapRect = this.#minimap.getBoundingClientRect();
+    const localX = event.clientX - minimapRect.left;
+    const localY = event.clientY - minimapRect.top;
+    const {scale, offsetX, offsetY} = this.#minimapTransform();
+    if (scale <= 0) {
+      return;
+    }
+    const contentX = (localX - offsetX) / scale;
+    const contentY = (localY - offsetY) / scale;
+
+    const canvasRect = this.#canvas.getBoundingClientRect();
+    this.#panX = canvasRect.width / 2 - contentX * this.#zoom;
+    this.#panY = canvasRect.height / 2 - contentY * this.#zoom;
+    this.#applyTransform();
+  }
+}
