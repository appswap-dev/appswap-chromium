+// Copyright 2026 The AppSwap Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+import * as Common from '../../core/common/common.js';
+import * as Root from '../../core/root/root.js';
+import * as SDK from '../../core/sdk/sdk.js';
+import type * as Protocol from '../../generated/protocol.js';
+
+import type {EmulatedDevice} from './EmulatedDevices.js';
+
+// One selected device's live background viewport: an independent, hidden
+// CDP target (see #createBackgroundTarget) navigated to the same URL as
+// the primary inspected page, with its own device-metrics override
+// applied directly (bypassing DeviceModeModel, which is a singleton bound
+// to the primary page target only -- see its own modelAdded()).
+interface BackgroundViewport {
+  device: EmulatedDevice;
+  target: SDK.Target.Target;
+}
+
+// Drives "multi-device" mode: when 2+ devices are selected in
+// DeviceModeToolbar's Dimensions control, this owns one independent,
+// hidden background target per selected device (beyond the ordinary
+// single-viewport DeviceModeModel path, which remains untouched and is
+// used as-is whenever 0 or 1 devices are selected -- see
+// DeviceModeToolbar.ts and DeviceModeView.ts). MultiDeviceView (a
+// UI.Widget.Widget) renders one DeviceViewportWidget per
+// BackgroundViewport, but owns none of this lifecycle itself -- it just
+// reacts to Events.SELECTION_CHANGED.
+export class MultiDeviceSelectionModel extends Common.ObjectWrapper.ObjectWrapper<EventTypes> implements
+    SDK.TargetManager.Observer {
+  readonly #targetManager: SDK.TargetManager.TargetManager;
+  #selection: EmulatedDevice[] = [];
+  readonly #viewports = new Map<EmulatedDevice, BackgroundViewport>();
+  // Devices currently being created/attached/navigated -- guards against a
+  // second setSelection() call racing an in-flight #ensureViewportFor()
+  // for the same device (e.g. rapid checkbox double-clicks).
+  readonly #pending = new Map<EmulatedDevice, Promise<BackgroundViewport|null>>();
+
+  private constructor(targetManager: SDK.TargetManager.TargetManager) {
+    super();
+    this.#targetManager = targetManager;
+    // Unscoped: TargetManager only auto-scopes the first non-FRAME/TAB
+    // target it creates, which will always be the primary page target,
+    // never one of our background targets -- a scoped observer would
+    // simply never see them removed (e.g. on a renderer crash).
+    this.#targetManager.observeTargets(this, {scoped: false});
+    this.#targetManager.addModelListener(
+        SDK.ResourceTreeModel.ResourceTreeModel, SDK.ResourceTreeModel.Events.PrimaryPageChanged,
+        this.#onPrimaryPageChanged, this);
+    window.addEventListener('beforeunload', () => {
+      // Best-effort, fire-and-forget: beforeunload can't reliably await
+      // async work. hidden:true targets are also torn down automatically
+      // when this session disconnects (see #createBackgroundTarget's own
+      // comment), so this is a courtesy, not the only cleanup path.
+      this.clear();
+    });
+  }
+
+  static instance(opts?: {forceNew: boolean}): MultiDeviceSelectionModel {
+    if (!Root.DevToolsContext.globalInstance().has(MultiDeviceSelectionModel) || opts?.forceNew) {
+      Root.DevToolsContext.globalInstance().set(
+          MultiDeviceSelectionModel,
+          // eslint-disable-next-line @devtools/no-instance-of-migrated-singletons
+          new MultiDeviceSelectionModel(SDK.TargetManager.TargetManager.instance()));
+    }
+    return Root.DevToolsContext.globalInstance().get(MultiDeviceSelectionModel);
+  }
+
+  selection(): EmulatedDevice[] {
+    return this.#selection;
+  }
+
+  isActive(): boolean {
+    return this.#selection.length >= 2;
+  }
+
+  viewportFor(device: EmulatedDevice): SDK.Target.Target|null {
+    return this.#viewports.get(device)?.target ?? null;
+  }
+
+  // `devices` is the full new selection (not a delta). Newly-added
+  // devices (only once the *overall* count is >= 2 -- a single selected
+  // device stays on the ordinary DeviceModeModel path) get a background
+  // viewport created; devices that no longer have a live viewport get
+  // theirs torn down. Dropping from >=2 back to <=1 tears down
+  // everything, handing control back to DeviceModeModel entirely.
+  //
+  // "Added"/"removed" are computed from #viewports (which devices
+  // actually have a live background target right now), not from a diff
+  // against the previous selection array: a device can be selected while
+  // the count is still <2 (no viewport created for it yet, see below),
+  // so when a second device brings the count to >=2 that first device
+  // still needs its viewport created even though it isn't "new" to the
+  // selection array.
+  async setSelection(devices: EmulatedDevice[]): Promise<void> {
+    this.#selection = devices;
+
+    if (devices.length < 2) {
+      // Only tear down viewports -- do NOT delegate to clear(), which
+      // also resets #selection to [] and would stomp the value just
+      // assigned above (e.g. selecting a single device would otherwise
+      // immediately snap back to an empty selection).
+      this.#disposeAllViewports();
+      this.dispatchEventToListeners(Events.SELECTION_CHANGED);
+      return;
+    }
+
+    const removed = [...this.#viewports.keys()].filter(device => !devices.includes(device));
+    const added = devices.filter(device => !this.#viewports.has(device));
+
+    for (const device of removed) {
+      this.#disposeViewport(device);
+    }
+
+    this.dispatchEventToListeners(Events.SELECTION_CHANGED);
+
+    // Fire off creation for newly-added devices; each resolves
+    // independently and re-notifies once its viewport is actually live,
+    // so tiles can appear one at a time rather than all-or-nothing.
+    for (const device of added) {
+      void this.#ensureViewportFor(device).then(() => {
+        if (this.#selection.includes(device)) {
+          this.dispatchEventToListeners(Events.SELECTION_CHANGED);
+        }
+      });
+    }
+  }
+
+  async clear(): Promise<void> {
+    this.#disposeAllViewports();
+    this.#selection = [];
+  }
+
+  #disposeAllViewports(): void {
+    const devices = [...this.#viewports.keys()];
+    for (const device of devices) {
+      this.#disposeViewport(device);
+    }
+  }
+
+  async #ensureViewportFor(device: EmulatedDevice): Promise<BackgroundViewport|null> {
+    const existingPending = this.#pending.get(device);
+    if (existingPending) {
+      return existingPending;
+    }
+    if (this.#viewports.has(device)) {
+      return this.#viewports.get(device) ?? null;
+    }
+
+    const promise = this.#createViewport(device);
+    this.#pending.set(device, promise);
+    const viewport = await promise;
+    this.#pending.delete(device);
+    if (viewport && this.#selection.includes(device)) {
+      this.#viewports.set(device, viewport);
+      return viewport;
+    }
+    // Selection changed while we were creating this (device got
+    // deselected again before its target finished attaching) -- don't
+    // leak the target we just created.
+    if (viewport) {
+      void viewport.target.targetAgent().invoke_closeTarget({targetId: viewport.target.id() as Protocol.Target.TargetID});
+    }
+    return null;
+  }
+
+  async #createViewport(device: EmulatedDevice): Promise<BackgroundViewport|null> {
+    const primaryTarget = this.#targetManager.primaryPageTarget();
+    const rootTarget = this.#targetManager.rootTarget();
+    if (!rootTarget) {
+      return null;
+    }
+    const url = primaryTarget?.inspectedURL() || 'about:blank';
+
+    const target = await this.#createBackgroundTarget(rootTarget, url);
+    if (!target) {
+      return null;
+    }
+
+    await this.#applyDevice(target, device);
+
+    return {device, target};
+  }
+
+  // Creates a hidden (not present in the real tab strip -- see the
+  // `hidden` CDP parameter's own doc comment in generated/protocol.ts:
+  // "observable via protocol, but not present in the tab UI strip... The
+  // life-time of the tab is limited to the life-time of the session")
+  // background target, then attaches to it so it becomes a normal,
+  // independently-controllable SDK.Target.Target -- see
+  // ui/helpers/OpenInNewTab.ts for the existing, shipping precedent this
+  // is modeled on.
+  async #createBackgroundTarget(rootTarget: SDK.Target.Target, url: string): Promise<SDK.Target.Target|null> {
+    // Deliberately omit `newWindow` entirely rather than passing `false`:
+    // it's a std::optional<bool> on the browser side
+    // (content/browser/devtools/protocol/target_handler.cc's
+    // TargetHandler::CreateTarget), and the hidden-target validation
+    // there checks `if (new_window)` -- i.e. whether the optional was
+    // supplied at all, not its value -- so an explicit `false` is
+    // rejected with "Hidden target cannot be created in a new window"
+    // just like `true` would be. Confirmed via ui/helpers/OpenInNewTab.ts,
+    // the existing precedent for creating a target from the frontend,
+    // which also never sets this field.
+    const createResponse = await rootTarget.targetAgent().invoke_createTarget({
+      url,
+      background: true,
+      hidden: true,
+    });
+    if (createResponse.getError() || !createResponse.targetId) {
+      console.error('[MultiDeviceSelectionModel] createTarget failed:', createResponse.getError());
+      return null;
+    }
+    const {targetId} = createResponse;
+
+    // Target.attachedToTarget is handled asynchronously by
+    // ChildTargetManager, which creates the actual SDK.Target.Target via
+    // TargetManager.createTarget() -- wait for it to show up rather than
+    // constructing one ourselves.
+    const targetPromise = new Promise<SDK.Target.Target>(resolve => {
+      const observer: SDK.TargetManager.Observer = {
+        targetAdded: (target: SDK.Target.Target) => {
+          if (target.id() === targetId) {
+            this.#targetManager.unobserveTargets(observer);
+            resolve(target);
+          }
+        },
+        targetRemoved: () => {},
+      };
+      this.#targetManager.observeTargets(observer, {scoped: false});
+    });
+
+    const attachResponse = await rootTarget.targetAgent().invoke_attachToTarget({targetId, flatten: true});
+    if (attachResponse.getError()) {
+      console.error('[MultiDeviceSelectionModel] attachToTarget failed:', attachResponse.getError());
+      void rootTarget.targetAgent().invoke_closeTarget({targetId});
+      return null;
+    }
+
+    return targetPromise;
+  }
+
+  async #applyDevice(target: SDK.Target.Target, device: EmulatedDevice): Promise<void> {
+    const emulationModel = target.model(SDK.EmulationModel.EmulationModel);
+    if (!emulationModel) {
+      return;
+    }
+    const mode = device.modes[0];
+    const orientation = device.orientationByName(mode.orientation);
+
+    // Deliberately a much simpler subset of DeviceModeModel.applyDeviceMetrics():
+    // no scale/positionX/positionY/dontSetVisibleSize dance, because
+    // there's no InspectedPagePlaceholder to align pixels with here -- the
+    // background target just renders at a fixed size, and
+    // DeviceViewportWidget's screencast captures at whatever that fixed
+    // size is (see that file's own comment on why zoom is "free" here).
+    await emulationModel.emulateDevice({
+      width: Math.floor(orientation.width),
+      height: Math.floor(orientation.height),
+      deviceScaleFactor: device.deviceScaleFactor,
+      mobile: device.mobile(),
+      screenWidth: Math.floor(orientation.width),
+      screenHeight: Math.floor(orientation.height),
+      positionX: 0,
+      positionY: 0,
+      dontSetVisibleSize: true,
+    });
+    await emulationModel.emulateTouch(device.touch(), device.mobile());
+
+    // Per-target UA override -- deliberately NOT
+    // MultitargetNetworkManager.setUserAgentOverride(), which pushes one
+    // single UA string to every attached target simultaneously and would
+    // make each device's UA clobber every other one's.
+    if (device.userAgent) {
+      await target.emulationAgent().invoke_setUserAgentOverride({
+        userAgent: device.userAgent,
+        userAgentMetadata: device.userAgentMetadata ?? undefined,
+      });
+    }
+  }
+
+  #disposeViewport(device: EmulatedDevice): void {
+    const viewport = this.#viewports.get(device);
+    this.#viewports.delete(device);
+    if (!viewport) {
+      return;
+    }
+    void viewport.target.targetAgent().invoke_closeTarget(
+        {targetId: viewport.target.id() as Protocol.Target.TargetID});
+  }
+
+  // TargetManager.Observer:
+  targetAdded(_target: SDK.Target.Target): void {
+  }
+
+  targetRemoved(target: SDK.Target.Target): void {
+    // Defensive cleanup for e.g. a background target's renderer crashing
+    // -- prune our own map so later teardown doesn't try to double-close
+    // an already-gone target.
+    for (const [device, viewport] of this.#viewports) {
+      if (viewport.target === target) {
+        this.#viewports.delete(device);
+        if (this.#selection.includes(device)) {
+          this.dispatchEventToListeners(Events.SELECTION_CHANGED);
+        }
+        break;
+      }
+    }
+  }
+
+  #onPrimaryPageChanged(
+      event: Common.EventTarget.EventTargetEvent<
+          SDK.ResourceTreeModel.EventTypes[SDK.ResourceTreeModel.Events.PrimaryPageChanged]>): void {
+    const frame = event.data.frame;
+    const navigatedTarget = frame.resourceTreeModel().target();
+    if (navigatedTarget !== this.#targetManager.primaryPageTarget()) {
+      // Not the primary page navigating -- e.g. one of our own background
+      // targets just finished its own navigation, which also fires this
+      // event on its own ResourceTreeModel. Ignoring it here is what
+      // prevents re-navigating every background target in a loop.
+      return;
+    }
+    const url = navigatedTarget.inspectedURL();
+    if (!url) {
+      return;
+    }
+    for (const viewport of this.#viewports.values()) {
+      const resourceTreeModel = viewport.target.model(SDK.ResourceTreeModel.ResourceTreeModel);
+      if (resourceTreeModel && resourceTreeModel.target().inspectedURL() !== url) {
+        void resourceTreeModel.navigate(url);
+      }
+    }
+  }
+}
+
+export const enum Events {
+  SELECTION_CHANGED = 'SelectionChanged',
+}
+
+export interface EventTypes {
+  [Events.SELECTION_CHANGED]: void;
+}
