+/*
+ * Copyright 2026 The AppSwap Authors
+ * Use of this source code is governed by a BSD-style license that can be
+ * found in the LICENSE file.
+ */
+
+@scope to (devtools-widget > *) {
+  :scope {
+    overflow: hidden;
+    position: relative;
+    background-color: var(--sys-color-cdt-base-container);
+  }
+
+  .multi-device-canvas {
+    position: absolute;
+    inset: 0;
+    overflow: hidden;
+    cursor: grab;
+    touch-action: none;
+  }
+
+  .multi-device-canvas:active {
+    cursor: grabbing;
+  }
+
+  .multi-device-canvas-content {
+    position: absolute;
+    top: 0;
+    left: 0;
+    transform-origin: 0 0;
+  }
+
+  .device-viewport-widget {
+    position: absolute;
+  }
+
+  .device-viewport-widget-label {
+    font: var(--sys-typescale-body4-medium);
+    color: var(--sys-color-on-surface-subtle);
+    padding-bottom: 6px;
+    white-space: nowrap;
+    user-select: none;
+  }
+
+  .device-viewport-widget-screencast {
+    border: 1px solid var(--sys-color-divider);
+    overflow: hidden;
+  }
+
+  .multi-device-minimap {
+    position: absolute;
+    background-color: color-mix(in sRGB, var(--sys-color-cdt-base-container) 90%, transparent);
+    border: 1px solid var(--sys-color-divider);
+    border-radius: 6px;
+    overflow: hidden;
+    cursor: pointer;
+    box-shadow: var(--sys-elevation-level3);
+  }
+
+  .multi-device-minimap-content {
+    position: absolute;
+    inset: 0;
+  }
+
+  .multi-device-minimap-tile {
+    position: absolute;
+    border: 1px solid var(--sys-color-outline);
+    background-color: var(--sys-color-surface2);
+  }
+
+  .multi-device-minimap-indicator {
+    position: absolute;
+    border: 2px solid var(--sys-color-primary);
+    pointer-events: none;
+  }
+}
