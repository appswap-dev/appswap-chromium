@@ -0,0 +1,51 @@
+// Copyright 2026 The AppSwap Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_APP_SWAP_APP_SWAP_PROFILE_PIN_TAB_HELPER_H_
+#define CHROME_BROWSER_APP_SWAP_APP_SWAP_PROFILE_PIN_TAB_HELPER_H_
+
+#include "content/public/browser/web_contents_observer.h"
+#include "content/public/browser/web_contents_user_data.h"
+
+namespace content {
+class Page;
+}  // namespace content
+
+// Watches this tab's committed navigations and persists which AppSwap
+// Profile (if any) it's actually running under via
+// PersistAppSwapProfilePinning(), so a future session restore can re-pin it
+// to the same Profile instead of falling back to whatever Profile happens
+// to be globally active at restore time.
+//
+// This covers every way a tab can end up pinned to a Profile's storage
+// partition: an explicit switch via SwitchActiveAppSwapProfile(), a fresh
+// tab that gets ambiently pinned to whatever Profile is currently active at
+// creation time (see ChromeContentBrowserClient::GetStoragePartitionConfigForSite),
+// and unpinning back to default storage via SwapWebContentsToDefaultPartition().
+// A tab's fixed storage partition can't change without replacing its
+// WebContents (see SiteInstance::CreateForFixedStoragePartition), so it's
+// safe -- and simplest -- to just re-derive and persist the pin from
+// scratch on every commit rather than track each of those call sites
+// individually.
+class AppSwapProfilePinTabHelper
+    : public content::WebContentsObserver,
+      public content::WebContentsUserData<AppSwapProfilePinTabHelper> {
+ public:
+  ~AppSwapProfilePinTabHelper() override;
+
+  AppSwapProfilePinTabHelper(const AppSwapProfilePinTabHelper&) = delete;
+  AppSwapProfilePinTabHelper& operator=(const AppSwapProfilePinTabHelper&) =
+      delete;
+
+ private:
+  friend class content::WebContentsUserData<AppSwapProfilePinTabHelper>;
+  explicit AppSwapProfilePinTabHelper(content::WebContents* web_contents);
+
+  // content::WebContentsObserver:
+  void PrimaryPageChanged(content::Page& page) override;
+
+  WEB_CONTENTS_USER_DATA_KEY_DECL();
+};
+
+#endif  // CHROME_BROWSER_APP_SWAP_APP_SWAP_PROFILE_PIN_TAB_HELPER_H_
diff --git a/chrome/browser/app_swap/app_swap_profile_removal_util.cc b/chrome/browser/app_swap/app_swap_profile_removal_util.cc
new file mode 100644
index 0000000000000..dc45b2ed3fe47
--- /dev/null
+++ b/chrome/browser/app_swap/app_swap_profile_removal_util.cc
@@ -0,0 +1,112 @@
+// Copyright 2026 The AppSwap Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/app_swap/app_swap_profile_removal_util.h"
+
+#include <memory>
+#include <utility>
+
+#include "base/functional/callback_helpers.h"
+#include "chrome/browser/app_swap/app_swap_profiles_service.h"
+#include "chrome/browser/ui/browser_window/public/browser_window_interface.h"
+#include "chrome/browser/ui/browser_window/public/global_browser_collection.h"
+#include "chrome/browser/ui/tabs/tab_strip_model.h"
+#include "content/public/browser/browser_context.h"
+#include "content/public/browser/navigation_controller.h"
+#include "content/public/browser/render_frame_host.h"
+#include "content/public/browser/render_process_host.h"
+#include "content/public/browser/site_instance.h"
+#include "content/public/browser/storage_partition.h"
+#include "content/public/browser/storage_partition_config.h"
+#include "content/public/browser/web_contents.h"
+#include "content/public/common/referrer.h"
+#include "third_party/blink/public/common/storage_key/storage_key.h"
+#include "ui/base/page_transition_types.h"
+#include "url/gurl.h"
+
+namespace {
+
+// Rebuilds `web_contents`'s tab with a SiteInstance for the browser's
+// ordinary default (unpartitioned) storage, reloading the current URL in
+// place. Deliberately *not* SiteInstance::CreateForFixedStoragePartition()
+// (the mechanism SwitchActiveAppSwapProfile() uses to pin a tab to a named
+// profile's partition) -- that API CHECK-fails on a default
+// StoragePartitionConfig, since "fix this tab to a partition" doesn't make
+// sense for the one partition every unpinned tab already resolves to.
+// CreateForURL() is the ordinary, no-pinning factory used for any regular
+// navigation.
+void SwapWebContentsToDefaultPartition(BrowserWindowInterface* browser,
+                                       content::WebContents* web_contents) {
+  TabStripModel* tab_strip_model = browser->GetTabStripModel();
+  content::BrowserContext* browser_context = web_contents->GetBrowserContext();
+  const GURL url = web_contents->GetLastCommittedURL();
+  scoped_refptr<content::SiteInstance> site_instance =
+      content::SiteInstance::CreateForURL(browser_context, url);
+
+  content::WebContents::CreateParams create_params(browser_context,
+                                                    site_instance);
+  std::unique_ptr<content::WebContents> new_contents =
+      content::WebContents::Create(create_params);
+  content::WebContents* raw_new_contents = new_contents.get();
+
+  // Replaces `web_contents` at its current tab-strip index in one call,
+  // preserving position/active state, and hands back the old contents by
+  // unique_ptr.
+  std::unique_ptr<content::WebContents> old_contents =
+      tab_strip_model->DiscardWebContents(web_contents, std::move(new_contents));
+
+  raw_new_contents->GetController().LoadURL(
+      old_contents->GetLastCommittedURL(), content::Referrer(),
+      ui::PAGE_TRANSITION_RELOAD, std::string());
+
+  old_contents.reset();  // Synchronous destroy -- safe for the same reason
+                         // documented on SwitchActiveAppSwapProfile().
+}
+
+}  // namespace
+
+void SwitchTabsOffAppSwapProfile(const std::string& profile_id) {
+  GlobalBrowserCollection::GetInstance()->ForEach(
+      [&](BrowserWindowInterface* browser) {
+        TabStripModel* tab_strip_model = browser->GetTabStripModel();
+        for (int i = 0; i < tab_strip_model->count(); ++i) {
+          content::WebContents* web_contents =
+              tab_strip_model->GetWebContentsAt(i);
+
+          // Read the tab's *actual* assigned partition directly, the same
+          // way AppSwapProfileTabStripButton does -- this is the only
+          // reliable source of truth for what profile (if any) a given tab
+          // is really running under.
+          content::StoragePartition* partition =
+              web_contents->GetPrimaryMainFrame()
+                  ->GetProcess()
+                  ->GetStoragePartition();
+          const content::StoragePartitionConfig& config =
+              partition->GetConfig();
+          if (config.partition_domain() != kAppSwapProfilePartitionDomain ||
+              config.partition_name() != profile_id) {
+            continue;
+          }
+
+          SwapWebContentsToDefaultPartition(browser, web_contents);
+        }
+        return true;
+      });
+}
+
+void ClearAppSwapProfileData(const std::string& profile_id,
+                             content::BrowserContext* browser_context) {
+  content::StoragePartitionConfig config =
+      content::StoragePartitionConfig::Create(
+          browser_context, kAppSwapProfilePartitionDomain,
+          /*partition_name=*/profile_id, /*in_memory=*/false);
+  content::StoragePartition* partition =
+      browser_context->GetStoragePartition(config, /*can_create=*/false);
+  if (!partition) {
+    return;  // Never actually used -- nothing on disk to clear.
+  }
+  partition->ClearData(content::StoragePartition::REMOVE_DATA_MASK_ALL,
+                       blink::StorageKey(), base::Time(), base::Time::Max(),
+                       base::DoNothing());
+}
