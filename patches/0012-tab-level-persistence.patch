+// Copyright 2026 The AppSwap Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/app_swap/app_swap_profile_pin_tab_helper.h"
+
+#include <string>
+
+#include "chrome/browser/app_swap/app_swap_profile_session_restore_util.h"
+#include "chrome/browser/app_swap/app_swap_profiles_service.h"
+#include "content/public/browser/render_frame_host.h"
+#include "content/public/browser/render_process_host.h"
+#include "content/public/browser/storage_partition.h"
+#include "content/public/browser/storage_partition_config.h"
+#include "content/public/browser/web_contents.h"
+
+AppSwapProfilePinTabHelper::AppSwapProfilePinTabHelper(
+    content::WebContents* web_contents)
+    : content::WebContentsObserver(web_contents),
+      content::WebContentsUserData<AppSwapProfilePinTabHelper>(
+          *web_contents) {}
+
+AppSwapProfilePinTabHelper::~AppSwapProfilePinTabHelper() = default;
+
+void AppSwapProfilePinTabHelper::PrimaryPageChanged(content::Page& page) {
+  content::WebContents* contents = web_contents();
+  const content::StoragePartitionConfig& config =
+      contents->GetPrimaryMainFrame()->GetProcess()->GetStoragePartition()->GetConfig();
+
+  std::string profile_id;
+  if (config.partition_domain() == kAppSwapProfilePartitionDomain) {
+    profile_id = config.partition_name();
+  }
+  PersistAppSwapProfilePinning(contents, profile_id);
+}
+
+WEB_CONTENTS_USER_DATA_KEY_IMPL(AppSwapProfilePinTabHelper);
diff --git a/chrome/browser/app_swap/app_swap_profile_pin_tab_helper.h b/chrome/browser/app_swap/app_swap_profile_pin_tab_helper.h
