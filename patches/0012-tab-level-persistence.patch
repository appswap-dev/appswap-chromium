@@ -0,0 +1,53 @@
+// Copyright 2026 The AppSwap Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/app_swap/app_swap_profile_session_restore_util.h"
+
+#include <utility>
+
+#include "chrome/browser/app_swap/app_swap_profiles_service.h"
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/browser/sessions/session_service.h"
+#include "chrome/browser/sessions/session_service_factory.h"
+#include "components/sessions/content/session_tab_helper.h"
+#include "content/public/browser/site_instance.h"
+#include "content/public/browser/storage_partition_config.h"
+#include "content/public/browser/web_contents.h"
+#include "url/gurl.h"
+
+void PersistAppSwapProfilePinning(content::WebContents* web_contents,
+                                  const std::string& profile_id) {
+  Profile* profile =
+      Profile::FromBrowserContext(web_contents->GetBrowserContext());
+  SessionService* session_service =
+      SessionServiceFactory::GetForProfile(profile);
+  if (!session_service) {
+    return;
+  }
+  SessionID window_id =
+      sessions::SessionTabHelper::IdForWindowContainingTab(web_contents);
+  SessionID tab_id = sessions::SessionTabHelper::IdForTab(web_contents);
+  if (!window_id.is_valid() || !tab_id.is_valid()) {
+    return;
+  }
+  session_service->AddTabExtraData(window_id, tab_id,
+                                   kAppSwapProfileExtraDataKey, profile_id);
+}
+
+scoped_refptr<content::SiteInstance>
+BuildAppSwapPinnedSiteInstanceFromExtraData(
+    Profile* profile,
+    const GURL& url,
+    const std::map<std::string, std::string>& extra_data) {
+  auto it = extra_data.find(kAppSwapProfileExtraDataKey);
+  if (it == extra_data.end() || it->second.empty()) {
+    return nullptr;
+  }
+  content::StoragePartitionConfig partition_config =
+      content::StoragePartitionConfig::Create(
+          profile, kAppSwapProfilePartitionDomain,
+          /*partition_name=*/it->second, /*in_memory=*/false);
+  return content::SiteInstance::CreateForFixedStoragePartition(
+      profile, url, partition_config);
+}
diff --git a/chrome/browser/app_swap/app_swap_profile_session_restore_util.h b/chrome/browser/app_swap/app_swap_profile_session_restore_util.h
