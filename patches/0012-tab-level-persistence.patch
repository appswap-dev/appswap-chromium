@@ -0,0 +1,47 @@
+// Copyright 2026 The AppSwap Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_APP_SWAP_APP_SWAP_PROFILE_SESSION_RESTORE_UTIL_H_
+#define CHROME_BROWSER_APP_SWAP_APP_SWAP_PROFILE_SESSION_RESTORE_UTIL_H_
+
+#include <map>
+#include <string>
+
+#include "base/memory/scoped_refptr.h"
+
+class GURL;
+class Profile;
+
+namespace content {
+class SiteInstance;
+class WebContents;
+}  // namespace content
+
+// Key used in sessions::SessionTab::extra_data (via
+// SessionService::AddTabExtraData) to record which AppSwap Profile (if any)
+// a tab is pinned to. Session restore recreates each tab's WebContents from
+// scratch, so without this the tab's storage partition would fall back to
+// whatever Profile is globally "active" at restore time instead of the one
+// it actually had before shutdown -- see BuildAppSwapPinnedSiteInstanceFromExtraData.
+inline constexpr char kAppSwapProfileExtraDataKey[] = "appswap.profile_id";
+
+// Records (or clears, if `profile_id` is empty) which AppSwap Profile
+// `web_contents`'s tab is pinned to, so a future session restore can re-pin
+// it to the same Profile. Call this any time a tab's fixed storage
+// partition changes: after switching it to a Profile, and after moving it
+// back to default storage (with an empty `profile_id`) when its Profile is
+// removed.
+void PersistAppSwapProfilePinning(content::WebContents* web_contents,
+                                  const std::string& profile_id);
+
+// Returns a SiteInstance fixed to the AppSwap Profile recorded for `url` in
+// `extra_data`, or nullptr if `extra_data` doesn't name one (in which case
+// the caller should fall back to ordinary SiteInstance selection).
+scoped_refptr<content::SiteInstance>
+BuildAppSwapPinnedSiteInstanceFromExtraData(
+    Profile* profile,
+    const GURL& url,
+    const std::map<std::string, std::string>& extra_data);
+
+#endif  // CHROME_BROWSER_APP_SWAP_APP_SWAP_PROFILE_SESSION_RESTORE_UTIL_H_
diff --git a/chrome/browser/app_swap/app_swap_version_pin_tab_helper.cc b/chrome/browser/app_swap/app_swap_version_pin_tab_helper.cc
new file mode 100644
index 0000000000000..dce48bab37dc4
--- /dev/null
+++ b/chrome/browser/app_swap/app_swap_version_pin_tab_helper.cc
@@ -0,0 +1,131 @@
+// Copyright 2026 The AppSwap Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/app_swap/app_swap_version_pin_tab_helper.h"
+
+#include <utility>
+
+#include "base/json/json_reader.h"
+#include "base/json/json_writer.h"
+#include "base/values.h"
+#include "chrome/browser/app_swap/app_swap_apps_service.h"
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/browser/sessions/session_service.h"
+#include "chrome/browser/sessions/session_service_factory.h"
+#include "components/sessions/content/session_tab_helper.h"
+#include "content/public/browser/web_contents.h"
+
+namespace {
+
+constexpr char kAppSwapVersionPinsExtraDataKey[] = "appswap.version_pins";
+
+std::string EncodePins(const std::map<std::string, std::string>& pins) {
+  base::DictValue dict;
+  for (const auto& [app_id, version] : pins) {
+    dict.Set(app_id, version);
+  }
+  std::string json;
+  base::JSONWriter::Write(dict, &json);
+  return json;
+}
+
+std::map<std::string, std::string> DecodePins(const std::string& json) {
+  std::map<std::string, std::string> pins;
+  std::optional<base::DictValue> dict =
+      base::JSONReader::ReadDict(json, base::JSON_PARSE_CHROMIUM_EXTENSIONS);
+  if (!dict) {
+    return pins;
+  }
+  for (auto [app_id, value] : *dict) {
+    if (const std::string* version = value.GetIfString()) {
+      pins[app_id] = *version;
+    }
+  }
+  return pins;
+}
+
+}  // namespace
+
+AppSwapVersionPinTabHelper::AppSwapVersionPinTabHelper(
+    content::WebContents* web_contents)
+    : content::WebContentsObserver(web_contents),
+      content::WebContentsUserData<AppSwapVersionPinTabHelper>(
+          *web_contents) {}
+
+AppSwapVersionPinTabHelper::~AppSwapVersionPinTabHelper() = default;
+
+void AppSwapVersionPinTabHelper::SetPinnedVersion(const std::string& app_id,
+                                                   const std::string& version) {
+  if (version.empty()) {
+    pinned_versions_.erase(app_id);
+  } else {
+    pinned_versions_[app_id] = version;
+  }
+  Persist();
+}
+
+std::optional<std::string> AppSwapVersionPinTabHelper::GetPinnedVersion(
+    const std::string& app_id) const {
+  auto it = pinned_versions_.find(app_id);
+  if (it == pinned_versions_.end()) {
+    return std::nullopt;
+  }
+  return it->second;
+}
+
+void AppSwapVersionPinTabHelper::PrimaryPageChanged(content::Page& page) {
+  // Re-persist on every commit (not just when a pin actually changes) so a
+  // tab whose pins were populated via RestoreFromExtraData -- rather than a
+  // direct SetPinnedVersion() call -- gets written into *this* session's own
+  // SessionService log too, keeping the pin alive across further restarts.
+  // A no-op write when `pinned_versions_` is empty and was never restored.
+  Persist();
+}
+
+// static
+void AppSwapVersionPinTabHelper::RestoreFromExtraData(
+    content::WebContents* web_contents,
+    const std::map<std::string, std::string>& extra_data) {
+  auto it = extra_data.find(kAppSwapVersionPinsExtraDataKey);
+  if (it == extra_data.end() || it->second.empty()) {
+    return;
+  }
+  AppSwapVersionPinTabHelper* helper =
+      GetOrCreateForWebContents(web_contents);
+  helper->pinned_versions_ = DecodePins(it->second);
+}
+
+void AppSwapVersionPinTabHelper::Persist() {
+  content::WebContents* contents = web_contents();
+  Profile* profile = Profile::FromBrowserContext(contents->GetBrowserContext());
+  SessionService* session_service = SessionServiceFactory::GetForProfile(profile);
+  if (!session_service) {
+    return;
+  }
+  SessionID window_id =
+      sessions::SessionTabHelper::IdForWindowContainingTab(contents);
+  SessionID tab_id = sessions::SessionTabHelper::IdForTab(contents);
+  if (!window_id.is_valid() || !tab_id.is_valid()) {
+    return;
+  }
+  session_service->AddTabExtraData(window_id, tab_id,
+                                   kAppSwapVersionPinsExtraDataKey,
+                                   EncodePins(pinned_versions_));
+}
+
+WEB_CONTENTS_USER_DATA_KEY_IMPL(AppSwapVersionPinTabHelper);
+
+std::string GetEffectiveAppSwapVersion(const AppSwapApp& app,
+                                       content::WebContents* web_contents) {
+  if (!web_contents) {
+    return app.version;
+  }
+  if (AppSwapVersionPinTabHelper* pin_helper =
+          AppSwapVersionPinTabHelper::FromWebContents(web_contents)) {
+    if (std::optional<std::string> pinned = pin_helper->GetPinnedVersion(app.id)) {
+      return *pinned;
+    }
+  }
+  return app.version;
+}
diff --git a/chrome/browser/app_swap/app_swap_version_pin_tab_helper.h b/chrome/browser/app_swap/app_swap_version_pin_tab_helper.h
new file mode 100644
index 0000000000000..762bbc577ec3c
--- /dev/null
+++ b/chrome/browser/app_swap/app_swap_version_pin_tab_helper.h
@@ -0,0 +1,81 @@
+// Copyright 2026 The AppSwap Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_APP_SWAP_APP_SWAP_VERSION_PIN_TAB_HELPER_H_
+#define CHROME_BROWSER_APP_SWAP_APP_SWAP_VERSION_PIN_TAB_HELPER_H_
+
+#include <map>
+#include <optional>
+#include <string>
+
+#include "content/public/browser/web_contents_observer.h"
+#include "content/public/browser/web_contents_user_data.h"
+
+namespace content {
+class Page;
+class WebContents;
+}  // namespace content
+
+struct AppSwapApp;
+
+// Lets a single tab pin a specific version of an AppSwap app, independent of
+// the app's own globally-configured version. Two tabs on the same app can
+// each be pinned to a different version at once this way, mirroring how
+// AppSwap Profiles let different tabs use different storage identities.
+//
+// Persisted per-tab via SessionService::AddTabExtraData so a pin survives a
+// session restore -- see RestoreFromExtraData(). Re-persisted on every
+// navigation commit (PrimaryPageChanged), not just when SetPinnedVersion()
+// is called directly: a restored tab's pins are set via RestoreFromExtraData
+// rather than SetPinnedVersion, and that data needs to be written back into
+// *this* session's own SessionService log too, or it would only survive a
+// single restart -- a restored tab's pin would never get re-persisted for
+// the *next* restart otherwise.
+class AppSwapVersionPinTabHelper
+    : public content::WebContentsObserver,
+      public content::WebContentsUserData<AppSwapVersionPinTabHelper> {
+ public:
+  ~AppSwapVersionPinTabHelper() override;
+
+  AppSwapVersionPinTabHelper(const AppSwapVersionPinTabHelper&) = delete;
+  AppSwapVersionPinTabHelper& operator=(const AppSwapVersionPinTabHelper&) =
+      delete;
+
+  // Pins `app_id` to `version` for this tab. An empty `version` clears the
+  // pin (the tab then falls back to the app's own configured version).
+  void SetPinnedVersion(const std::string& app_id, const std::string& version);
+
+  // Returns the version pinned for `app_id` on this tab, or nullopt if this
+  // tab has no pin for that app.
+  std::optional<std::string> GetPinnedVersion(const std::string& app_id) const;
+
+  // Rebuilds this tab's version pins from persisted session-restore extra
+  // data. Call before the tab's first navigation request, mirroring
+  // send_tab_to_self::SendTabToSelfActivationTracker::RestoreFromExtraData().
+  static void RestoreFromExtraData(
+      content::WebContents* web_contents,
+      const std::map<std::string, std::string>& extra_data);
+
+ private:
