+// Copyright 2026 The AppSwap Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_APP_SWAP_APP_SWAP_PROFILE_REMOVAL_UTIL_H_
+#define CHROME_BROWSER_APP_SWAP_APP_SWAP_PROFILE_REMOVAL_UTIL_H_
+
+#include <string>
+
+namespace content {
+class BrowserContext;
+}  // namespace content
+
+// Reassigns every currently open tab running under `profile_id`'s storage
+// partition back to the browser's default (unpartitioned) storage
+// partition, reloading each tab in place. Call this before removing a
+// Profile so no open tab is left pointing at a partition that's about to be
+// cleared out from under it.
+void SwitchTabsOffAppSwapProfile(const std::string& profile_id);
+
+// Clears all on-disk data (cookies, local storage, IndexedDB, cache, etc.)
+// for `profile_id`'s storage partition within `browser_context`. AppSwap
+// Profile partitions live within a single Chrome profile, so any currently
+// available BrowserContext works. Call SwitchTabsOffAppSwapProfile() first
+// so nothing is still actively using the partition while it's cleared.
+// Asynchronous; does not wait for the clear to finish.
+void ClearAppSwapProfileData(const std::string& profile_id,
+                             content::BrowserContext* browser_context);
+
+#endif  // CHROME_BROWSER_APP_SWAP_APP_SWAP_PROFILE_REMOVAL_UTIL_H_
