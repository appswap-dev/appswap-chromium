+// AppSwap: session-recording feasibility research. See the design notes
+// this was built from (PaintOp-based session recording) for full context.
+//
+// Dumps each layer's real cc::PaintOpBuffer to disk. Modeled on
+// SkPictureSerializer just above -- same per-layer directory-dump shape
+// and the same --no-sandbox requirement (renderer file I/O is normally
+// sandbox-blocked, crbug.com/139640) -- but pulls the layer's
+// DisplayItemList's own PaintOpBuffer directly
+// (Layer::CapturePaintOpDisplayListForTesting(), which PictureLayer
+// implements via ContentLayerClient::PaintContentsToDisplayList())
+// instead of re-recording into an SkPicture.
+class PaintOpBufferDumper {
+ public:
+  explicit PaintOpBufferDumper(const base::FilePath& dirpath)
+      : dirpath_(dirpath), layer_id_(0) {}
+
+  void Serialize(const cc::Layer* root_layer) {
+    const cc::ScrollTree& scroll_tree =
+        root_layer->layer_tree_host()->property_trees()->scroll_tree();
+    for (auto* layer : *root_layer->layer_tree_host()) {
+      scoped_refptr<cc::DisplayItemList> display_list =
+          layer->CapturePaintOpDisplayListForTesting();
+      if (!display_list) {
+        continue;
+      }
+      SerializeLayer(*display_list, scroll_tree, layer->bounds(),
+                    layer_id_++);
+    }
+  }
+
+ private:
+  void SerializeLayer(const cc::DisplayItemList& display_list,
+                      const cc::ScrollTree& scroll_tree,
+                      const gfx::Size& bounds,
+                      int layer_id) {
+    // A real captured page can have scrollable subtrees (kDrawScrollingContents
+    // ops) whose offsets MUST be supplied at serialize time -- confirmed by
+    // an actual crash (cc/paint/paint_op_buffer_serializer.cc:287) when
+    // this was omitted. See SerializePaintOpBufferForCapture()'s own
+    // comment for why cc/paint can't build this map itself.
+    cc::ScrollOffsetMap raster_inducing_scroll_offsets;
+    for (auto& [element_id, unused] : display_list.raster_inducing_scrolls()) {
+      raster_inducing_scroll_offsets[element_id] =
+          scroll_tree.current_scroll_offset(element_id);
+    }
+
+    std::optional<cc::SerializedPaintOpBuffer> serialized =
+        cc::SerializePaintOpBufferForCapture(display_list.paint_op_buffer(),
+                                             &raster_inducing_scroll_offsets);
+    if (!serialized) {
+      DLOG(ERROR) << "AppSwap: PaintOpBuffer serialization failed for layer "
+                 << layer_id;
+      return;
+    }
+
+    WriteLayerFile(layer_id, "paintops", base::span(serialized->paintops));
+    WriteLayerFile(layer_id, "strikedata",
+                  base::span(serialized->strikedata));
+
+    // The .paintops bytes don't carry the layer's pixel dimensions, and
+    // there's no other source of truth for them once this leaves the
+    // browser -- write them alongside so paintop_disk_roundtrip_tool's
+    // --mode=read_capture can size its render target correctly without
+    // the caller having to separately measure/guess the layer's size.
+    std::string dims = base::NumberToString(bounds.width()) + " " +
+                       base::NumberToString(bounds.height()) + "\n";
+    WriteLayerFile(layer_id, "dims", base::as_byte_span(dims));
+  }
+
+  void WriteLayerFile(int layer_id,
+                      std::string_view suffix,
+                      base::span<const uint8_t> data) {
+    std::string filename =
+        "layer_" + base::NumberToString(layer_id) + "." + std::string(suffix);
+    base::FilePath path = dirpath_.AppendASCII(filename);
+    if (!base::WriteFile(path, data)) {
+      DLOG(ERROR) << "AppSwap: failed to write " << path;
+    }
+  }
+
+  base::FilePath dirpath_;
+  int layer_id_;
+};
