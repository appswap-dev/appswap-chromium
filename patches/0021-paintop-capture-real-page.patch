@@ -0,0 +1,313 @@
+// Copyright 2026 The AppSwap Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "cc/paint/paint_op_capture_serializer.h"
+
+#include <set>
+#include <utility>
+
+#include <memory>
+
+#include "cc/paint/decoded_draw_image.h"
+#include "cc/paint/draw_image.h"
+#include "cc/paint/image_provider.h"
+#include "cc/paint/image_transfer_cache_entry.h"
+#include "cc/paint/paint_cache.h"
+#include "cc/paint/paint_image.h"
+#include "cc/paint/paint_op_buffer.h"
+#include "cc/paint/paint_op_buffer_serializer.h"
+#include "cc/paint/paint_op_writer.h"
+#include "cc/paint/skottie_serialization_history.h"
+#include "cc/paint/transfer_cache_deserialize_helper.h"
+#include "cc/paint/transfer_cache_serialize_helper.h"
+#include "third_party/skia/include/core/SkBitmap.h"
+#include "third_party/skia/include/core/SkImage.h"
+#include "third_party/skia/include/core/SkPixmap.h"
+#include "third_party/skia/include/private/chromium/SkChromeRemoteGlyphCache.h"
+
+namespace cc {
+
+namespace {
+
+// A minimal SkStrikeServer::DiscardableHandleManager for a short-lived,
+// single-use SkStrikeServer. Each capture call does exactly one
+// Serialize() pass and then throws the server away, so there is nothing
+// to evict and no real discardable-memory bookkeeping is needed: every
+// handle simply stays valid for the server's whole (brief) lifetime.
+class SingleUseDiscardableHandleManager
+    : public SkStrikeServer::DiscardableHandleManager {
+ public:
+  SkDiscardableHandleId createHandle() override { return next_id_++; }
+  bool lockHandle(SkDiscardableHandleId) override { return true; }
+  bool isHandleDeleted(SkDiscardableHandleId) override { return false; }
+
+ private:
+  SkDiscardableHandleId next_id_ = 1;
+};
+
+// A real, production ImageProvider: decodes each image via
+// PaintImage::GetSwSkImage() and packages it as a
+// ClientImageTransferCacheEntry, collecting the serialized entry bytes
+// for SerializePaintOpBufferForCapture() to fold into the returned
+// SerializedPaintOpBuffer's `imagedata` blob afterwards (see this file's
+// header comment for that format and its disclosed limitations). Mirrors
+// TestOptionsProvider::GetRasterContent()'s shape (cc/test/
+// test_options_provider.cc) but with real pixel content instead of a
+// zero-filled placeholder bitmap, and without that class's testonly
+// direct-cache-access helpers (LockEntryDirect/CreateEntryDirect) --
+// those don't exist on the production TransferCacheSerializeHelper base,
+// and aren't needed here anyway since PaintOpWriter::WriteImage() only
+// ever reads an already-assigned transfer_cache_entry_id() off the
+// DecodedDrawImage this class returns; it never calls back into a
+// TransferCacheSerializeHelper for images itself (confirmed: unlike the
+// Skottie/record-shader case, which does drive PaintOpWriter's own
+// LockEntry()/CreateEntry() calls inline).
+class RealImageProvider : public ImageProvider {
+ public:
+  ScopedResult GetRasterContent(const DrawImage& draw_image) override {
+    // A lazy/generator-backed or otherwise unresolvable image degrades to
+    // the same "no image" outcome NullImageProvider always produced --
+    // graceful, not a crash (see PaintOpWriter::WriteImage()).
+    sk_sp<SkImage> sk_image = draw_image.paint_image().GetSwSkImage();
+    if (!sk_image) {
+      return ScopedResult();
+    }
+
+    SkBitmap bitmap;
+    if (!bitmap.tryAllocN32Pixels(sk_image->width(), sk_image->height())) {
+      return ScopedResult();
+    }
+    // nullptr GrDirectContext is correct here: GetSwSkImage() guarantees a
+    // CPU/raster-backed image, so no GPU readback is involved.
+    if (!sk_image->readPixels(/*context=*/nullptr, bitmap.pixmap(), 0, 0)) {
+      return ScopedResult();
+    }
+
+    SkPixmap pixmap = bitmap.pixmap();
+    ClientImageTransferCacheEntry::Image image(&pixmap);
+    ClientImageTransferCacheEntry entry(image, /*needs_mips=*/false);
+    uint32_t size = entry.SerializedSize();
+    std::vector<uint8_t> data(size);
+    if (!entry.Serialize(base::span(data))) {
+      return ScopedResult();
+    }
+
+    uint32_t id = entry.Id();
+    entries_.emplace_back(id, std::move(data));
+
+    return ScopedResult(DecodedDrawImage(
+        id, /*dark_mode_color_filter=*/nullptr, SkSize::MakeEmpty(),
+        draw_image.scale(), draw_image.filter_quality(),
+        /*needs_mips=*/false, /*is_budgeted=*/true));
+  }
+
+  // Flattens every entry collected so far into this file's header-
+  // documented [count][id,len,bytes]* format (via BuildImageData(), also
+  // used by every other consumer of this format), and clears the
+  // collection (this provider is single-use per
+  // SerializePaintOpBufferForCapture() call, so there's nothing left to
+  // take a second time).
+  std::vector<uint8_t> TakeImageData() {
+    std::vector<ImageDataEntry> entries;
+    entries.reserve(entries_.size());
+    for (const auto& [id, data] : entries_) {
+      entries.push_back({id, base::span(data)});
+    }
+    std::vector<uint8_t> result = BuildImageData(entries);
+    // `entries`' raw_spans point into entries_'s own buffers -- they must
+    // be gone before entries_.clear() frees those buffers, or the
+    // raw_spans go dangling and get destroyed after the fact (a real
+    // DanglingPtr crash, confirmed by actually hitting it: "Recording
+    // stopped working on some websites"). entries_.clear() alone, with
+    // `entries` only going out of scope later at function return, hit
+    // exactly this ordering bug.
+    entries.clear();
+    entries_.clear();
+    return result;
+  }
+
+ private:
+  std::vector<std::pair<uint32_t, std::vector<uint8_t>>> entries_;
+};
+
+// A minimal TransferCacheSerializeHelper. Unlike the real raster
+// command-buffer path (gpu::RasterImplementation), a capture via this
+// helper is a single disposable serialize pass, not a persistent cache
+// shared across frames -- so every entry is always freshly created and
+// inlined directly into the buffer PaintOpWriter provides, never treated
+// as already cached on some remote side.
+class InliningTransferCacheSerializeHelper
+    : public TransferCacheSerializeHelper {
+ protected:
+  bool LockEntryInternal(const EntryKey&) override { return false; }
+  uint32_t CreateEntryInternal(const ClientTransferCacheEntry& entry,
+                               base::span<uint8_t> memory) override {
+    uint32_t size = entry.SerializedSize();
+    if (memory.size() < size || !entry.Serialize(memory.first(size))) {
+      return 0u;
+    }
+    return size;
+  }
+  void FlushEntriesInternal(std::set<EntryKey>) override {}
+};
+
+// A transfer-cache stand-in for the read side, matching
+// InliningTransferCacheSerializeHelper's own "always fresh, nothing is
+// ever really cached" behavior above. Every lookup misses -- which every
+// transfer-cache-backed PaintOp already handles gracefully, since a real
+// entry can legitimately be absent there too (a failed image upload not
+// yet resolving a record shader, ...) -- and CreateLocalEntry() just
+// drops what it's given rather than storing it, since this deserializer
+// exists for one single, disposable PaintOpBuffer::MakeFromMemory() call,
+// not a persistent cache serving many buffers over time.
+class NullTransferCacheDeserializeHelper : public TransferCacheDeserializeHelper {
+ public:
+  void CreateLocalEntry(uint32_t,
+                        std::unique_ptr<ServiceTransferCacheEntry>) override {
+  }
+
+ private:
+  ServiceTransferCacheEntry* GetEntryInternal(TransferCacheEntryType,
+                                              uint32_t) override {
+    return nullptr;
+  }
+};
+
+// A minimal SkStrikeClient::DiscardableHandleManager for a short-lived,
+// single-use SkStrikeClient -- the read-side mirror of
+// SingleUseDiscardableHandleManager above. One deserialize call reads all
+// the strike data it will ever read in one readStrikeData() call, so
+// there's nothing to actually track deletion of.
+class SingleUseStrikeClientDiscardableHandleManager
+    : public SkStrikeClient::DiscardableHandleManager {
+ public:
+  bool deleteHandle(SkDiscardableHandleId) override { return true; }
+  void notifyCacheMiss(SkStrikeClient::CacheMissType, int) override {}
+};
+
+}  // namespace
+
+SerializedPaintOpBuffer::SerializedPaintOpBuffer() = default;
+SerializedPaintOpBuffer::SerializedPaintOpBuffer(SerializedPaintOpBuffer&&) =
+    default;
+SerializedPaintOpBuffer& SerializedPaintOpBuffer::operator=(
+    SerializedPaintOpBuffer&&) = default;
+SerializedPaintOpBuffer::~SerializedPaintOpBuffer() = default;
+
+std::optional<SerializedPaintOpBuffer> SerializePaintOpBufferForCapture(
+    const PaintOpBuffer& buffer,
+    const ScrollOffsetMap* raster_inducing_scroll_offsets,
+    size_t max_size) {
+  SingleUseDiscardableHandleManager handle_manager;
+  SkStrikeServer strike_server(&handle_manager);
+  RealImageProvider image_provider;
+  InliningTransferCacheSerializeHelper transfer_cache;
+  ClientPaintCache paint_cache(4 * 1024 * 1024);
+  SkottieSerializationHistory skottie_history;
+
+  PaintOp::SerializeOptions options(
+      &image_provider, &transfer_cache, &paint_cache, &strike_server,
+      /*color_space=*/nullptr, &skottie_history,
+      /*can_use_lcd_text=*/true,
+      /*context_supports_distance_field_text=*/true,
+      /*max_texture_size=*/1024, raster_inducing_scroll_offsets);
+
+  // Matches real production ordering (gpu::RasterImplementation::
+  // RasterCHROMIUM(), gpu/command_buffer/client/raster_implementation.cc):
+  // PaintOpBufferSerializer::Serialize() runs its OWN internal
+  // analysis-canvas pass over the buffer -- that's what actually
+  // populates strike_server with any text ops' glyph data. So Serialize()
+  // first, then pull the strike data out -- no separate manual
+  // analysis-canvas pass needed.
+  base::AlignedHeapArray<uint8_t> memory =
+      PaintOpWriter::AllocateAlignedBuffer(max_size);
+  SimpleBufferSerializer serializer(memory.as_span(), options);
+  serializer.Serialize(buffer);
+  if (!serializer.valid()) {
+    return std::nullopt;
+  }
+
+  SerializedPaintOpBuffer result;
+  base::span<const uint8_t> written =
+      memory.as_span().first(serializer.written());
+  result.paintops.assign(written.begin(), written.end());
+  strike_server.writeStrikeData(&result.strikedata);
+  result.imagedata = image_provider.TakeImageData();
+  return result;
+}
+
+sk_sp<PaintOpBuffer> DeserializePaintOpBufferForPlayback(
+    base::span<const uint8_t> paintops,
+    base::span<const uint8_t> strikedata,
+    TransferCacheDeserializeHelper* transfer_cache) {
+  sk_sp<SingleUseStrikeClientDiscardableHandleManager> discardable_manager =
+      sk_make_sp<SingleUseStrikeClientDiscardableHandleManager>();
+  SkStrikeClient strike_client(discardable_manager);
+  if (!strikedata.empty() &&
+      !strike_client.readStrikeData(strikedata.data(), strikedata.size())) {
+    return nullptr;
+  }
+
+  NullTransferCacheDeserializeHelper null_transfer_cache;
+  ServicePaintCache paint_cache;
+  std::vector<uint8_t> scratch_buffer;
+  PaintOpBuffer::DeserializeOptions options{
+      .transfer_cache = transfer_cache ? transfer_cache : &null_transfer_cache,
+      .paint_cache = &paint_cache,
+      .strike_client = &strike_client,
+      .scratch_buffer = scratch_buffer,
+      .is_privileged = false,
+  };
+
+  return PaintOpBuffer::MakeFromMemory(paintops, options);
+}
+
+std::vector<ImageDataEntry> ParseImageData(base::span<const uint8_t> imagedata) {
+  std::vector<ImageDataEntry> result;
+  size_t pos = 0;
+  if (imagedata.size() < sizeof(uint32_t)) {
+    return result;
+  }
+  uint32_t count;
+  base::byte_span_from_ref(count).copy_from(
+      imagedata.subspan(pos, sizeof(count)));
+  pos += sizeof(count);
+
+  for (uint32_t i = 0; i < count; ++i) {
+    if (imagedata.size() - pos < 2 * sizeof(uint32_t)) {
+      break;
+    }
+    uint32_t id;
+    base::byte_span_from_ref(id).copy_from(imagedata.subspan(pos, sizeof(id)));
+    pos += sizeof(id);
+    uint32_t len;
+    base::byte_span_from_ref(len).copy_from(
+        imagedata.subspan(pos, sizeof(len)));
+    pos += sizeof(len);
+    if (imagedata.size() - pos < len) {
+      break;
+    }
+    result.push_back({id, imagedata.subspan(pos, len)});
+    pos += len;
+  }
+  return result;
+}
+
+std::vector<uint8_t> BuildImageData(base::span<const ImageDataEntry> entries) {
+  std::vector<uint8_t> result;
+  auto append = [&result](base::span<const uint8_t> bytes) {
+    result.insert(result.end(), bytes.begin(), bytes.end());
+  };
+  const uint32_t count = static_cast<uint32_t>(entries.size());
+  append(base::byte_span_from_ref(count));
+  for (const ImageDataEntry& entry : entries) {
+    append(base::byte_span_from_ref(entry.id));
+    const uint32_t len = static_cast<uint32_t>(entry.bytes.size());
+    append(base::byte_span_from_ref(len));
+    append(entry.bytes);
+  }
+  return result;
+}
+
+}  // namespace cc
diff --git a/cc/paint/paint_op_capture_serializer.h b/cc/paint/paint_op_capture_serializer.h
new file mode 100644
index 0000000000000..b94dfc0fa702f
--- /dev/null
+++ b/cc/paint/paint_op_capture_serializer.h
@@ -0,0 +1,154 @@
+// Copyright 2026 The AppSwap Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CC_PAINT_PAINT_OP_CAPTURE_SERIALIZER_H_
+#define CC_PAINT_PAINT_OP_CAPTURE_SERIALIZER_H_
+
+#include <cstdint>
+#include <optional>
+#include <vector>
+
+#include "base/containers/span.h"
+#include "base/memory/raw_span.h"
+#include "cc/paint/paint_export.h"
+#include "cc/paint/scroll_offset_map.h"
+#include "third_party/skia/include/core/SkRefCnt.h"
+
+namespace cc {
+
+class PaintOpBuffer;
+class TransferCacheDeserializeHelper;
+
+// The result of SerializePaintOpBufferForCapture(): the serialized paint
+// ops, plus whatever glyph ("strike") data the buffer's text ops produced
+// as a side channel -- both need to be persisted (to disk, over IPC,
+// wherever) together, the same file-pair convention this checkout's
+// AppSwap paint-op capture work has used since its first spike
+// (cc/paint/paintop_disk_roundtrip_tool.cc). `imagedata` is a third such
+// side channel, added for real image support: a hand-rolled
+// [uint32 count][repeated: uint32 id, uint32 len, len bytes] blob of
+// serialized cc::ClientImageTransferCacheEntry bytes, one per DrawImageOp
+// captured in `paintops` -- see SerializePaintOpBufferForCapture()'s own
+// comment for why this needs its own side channel rather than being
+// inlined into `paintops` the way production's real image path would
+// normally do it.
+struct CC_PAINT_EXPORT SerializedPaintOpBuffer {
+  SerializedPaintOpBuffer();
+  SerializedPaintOpBuffer(SerializedPaintOpBuffer&&);
+  SerializedPaintOpBuffer& operator=(SerializedPaintOpBuffer&&);
+  SerializedPaintOpBuffer(const SerializedPaintOpBuffer&) = delete;
+  SerializedPaintOpBuffer& operator=(const SerializedPaintOpBuffer&) = delete;
+  ~SerializedPaintOpBuffer();
+
+  std::vector<uint8_t> paintops;
+  std::vector<uint8_t> strikedata;
+  std::vector<uint8_t> imagedata;
+};
+
+// Serializes `buffer` for later disk/IPC persistence, using a fresh,
+// short-lived, single-use SkStrikeServer plus no-op image/transfer-cache
+// helpers -- suitable for PRODUCTION (non-test) capture call sites that
+// can't depend on cc:test_support's TestOptionsProvider (testonly).
+// Shared by every AppSwap paint-op capture path in this checkout (the
+// debug chrome.gpuBenchmarking.dumpPaintOpBuffer() path in
+// content/renderer/gpu_benchmarking_extension.cc, and the continuous
+// per-frame recording path) so the serialization sequence itself -- which
+// took real, hard-won debugging to get right (see that file's own
+// comments) -- exists in exactly one place.
+//
+// DrawImageOp content DOES round-trip: each image is decoded via
+// PaintImage::GetSwSkImage(), wrapped in a cc::ClientImageTransferCacheEntry,
+// and stashed in the returned SerializedPaintOpBuffer's `imagedata` blob
+// (production's own real image path always references a transfer-cache
+// entry rather than inlining pixels into the op stream itself -- see
+// cc/paint/paint_op_writer.cc's WriteImage() and the DCHECK guarding
+// against a raw SkImage there). No dedup (the same image appearing
+// multiple times in one buffer is captured once per occurrence), no
+// YUV/gainmap/HDR images, no mips -- a real, disclosed first-pass
+// limitation, not a silent one.
+//
+// `raster_inducing_scroll_offsets`, if `buffer` contains a
+// kDrawScrollingContents op (a scrollable subtree -- confirmed via a real
+// crash, see cc/paint/paint_op_buffer_serializer.cc:287's
+// CHECK(params.raster_inducing_scroll_offsets)), MUST be non-null and
+// contain a real entry for every ElementId the op references, or
+// serialization will crash (a CHECK failure, then an out-of-range map
+// access). cc/paint deliberately doesn't depend on cc/trees (nothing else
+// under cc/paint/ does either), so this helper can't build that map
+// itself from a cc::ScrollTree -- the caller (which already has one, via
+// its LayerTreeHost) must build it, e.g.:
+//   for (auto& [element_id, _] : display_list.raster_inducing_scrolls())
+//     offsets[element_id] = scroll_tree.current_scroll_offset(element_id);
+// A buffer known not to contain any scrolling content can safely pass
+// nullptr.
+//
+// Returns nullopt if serialization fails (e.g. `buffer`'s serialized form
+// doesn't fit in `max_size`).
+CC_PAINT_EXPORT std::optional<SerializedPaintOpBuffer>
+SerializePaintOpBufferForCapture(
+    const PaintOpBuffer& buffer,
+    const ScrollOffsetMap* raster_inducing_scroll_offsets = nullptr,
+    size_t max_size = 4 * 1024 * 1024);
+
+// The read-side counterpart to SerializePaintOpBufferForCapture(): rebuilds
+// a PaintOpBuffer from what that function produced, using a fresh,
+// short-lived, single-use SkStrikeClient plus a minimal paint-cache
+// stand-in -- suitable for PRODUCTION (non-test) playback call sites that
+// can't depend on cc:test_support's TestOptionsProvider (testonly), same
+// reasoning as the serialize side above. `paintops`/`strikedata` must be
+// exactly what one SerializePaintOpBufferForCapture() call produced (its
+// outputs kept together) -- mixing strike data from one buffer with
+// paintops from another will fail to resolve any text in the latter.
+//
+// `transfer_cache`, if non-null, is used to resolve any transfer-cache-
+// backed content (currently: images) instead of the default stand-in that
+// always reports "entry not found" -- which every transfer-cache-backed op
+// already handles gracefully as a documented case (a failed image upload,
+// a not-yet-cached record shader, ...), so passing null here isn't a
+// crash risk, just a caller that doesn't need images to actually render
+// (e.g. no live GrDirectContext available to it -- see
+// cc::ServiceImageTransferCacheEntry::Deserialize()'s own requirement).
+// Returns nullptr on any deserialization failure.
+CC_PAINT_EXPORT sk_sp<PaintOpBuffer> DeserializePaintOpBufferForPlayback(
+    base::span<const uint8_t> paintops,
+    base::span<const uint8_t> strikedata,
+    TransferCacheDeserializeHelper* transfer_cache = nullptr);
+
+// One entry from an `imagedata` blob (see SerializedPaintOpBuffer's own
+// comment for the format): a transfer-cache id and the serialized
+// cc::ClientImageTransferCacheEntry bytes for it. `bytes` is a view into
+// whatever buffer was passed to ParseImageData() -- it does not own the
+// data and must not outlive it.
+struct CC_PAINT_EXPORT ImageDataEntry {
+  uint32_t id;
+  // raw_span, not span: Chromium's clang plugin requires it for a span
+  // stored as a class/struct member (the same "no bare pointer-like field"
+  // rule raw_ptr<T> enforces for plain pointers) -- confirmed by actually
+  // hitting the chromium-rawptr build error. Implicitly converts to/from
+  // span<>, so call sites are unaffected.
+  base::raw_span<const uint8_t> bytes;
+};
+
+// Splits an `imagedata` blob into its individual per-image entries. Used
+// by every consumer of this format: AppSwapSessionRecordingWriter (to
+// content-hash and dedup each image separately),
+// AppSwapPlaybackService's PlaybackTransferCacheDeserializeHelper (to
+// resolve each id to its entry bytes), and (paired with BuildImageData())
+// AppSwapSessionRecordingReader (to reassemble a flat blob after
+// resolving each entry's content hash back to bytes from the on-disk blob
+// store). Returns an empty vector if `imagedata` is malformed or empty --
+// this format is only ever produced by this checkout's own capture code,
+// so a malformed blob indicates a real bug, not something to recover from
+// gracefully.
+CC_PAINT_EXPORT std::vector<ImageDataEntry> ParseImageData(
