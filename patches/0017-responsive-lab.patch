+
+#include "chrome/browser/ui/webui/app_swap_responsive_lab/app_swap_responsive_lab_ui.h"
+
+#include <string>
+#include <utility>
+
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/browser/ui/webui/app_swap_responsive_lab/app_swap_responsive_lab_page_handler.h"
+#include "chrome/grit/app_swap_responsive_lab_resources.h"
+#include "chrome/grit/app_swap_responsive_lab_resources_map.h"
+#include "content/public/browser/render_frame_host.h"
+#include "content/public/browser/web_ui.h"
+#include "content/public/browser/web_ui_data_source.h"
+#include "content/public/common/url_constants.h"
+#include "net/base/url_util.h"
+#include "ui/webui/webui_util.h"
+#include "url/gurl.h"
+
+AppSwapResponsiveLabUIConfig::AppSwapResponsiveLabUIConfig()
+    : DefaultWebUIConfig(content::kChromeUIScheme, "appswap-responsive-lab") {}
+
+AppSwapResponsiveLabUI::AppSwapResponsiveLabUI(content::WebUI* web_ui,
+                                               const GURL& url)
+    : content::WebUIController(web_ui) {
+  Profile* profile = Profile::FromWebUI(web_ui);
+  content::WebUIDataSource* source = content::WebUIDataSource::CreateAndAdd(
+      profile, "appswap-responsive-lab");
+  webui::SetupWebUIDataSource(
+      source, kAppSwapResponsiveLabResources,
+      IDR_APP_SWAP_RESPONSIVE_LAB_APP_SWAP_RESPONSIVE_LAB_HTML);
+
+  // Looked up, not consumed: unlike the version picker's one-shot token,
+  // this bridge lives as long as the panel does and keeps being re-pointed
+  // at different tabs' sessions. Null is a legitimate outcome (a stale URL,
+  // or an overlay torn down between navigation and load) and every method
+  // on the page handler tolerates it.
+  std::string token;
+  net::GetValueForKeyInQuery(url, "token", &token);
+  if (AppSwapResponsiveLabPanelBridge* bridge =
+          AppSwapResponsiveLabPanelBridge::FromToken(token)) {
+    bridge_ = bridge->GetWeakPtr();
+  }
+}
+
+AppSwapResponsiveLabUI::~AppSwapResponsiveLabUI() = default;
+
+WEB_UI_CONTROLLER_TYPE_IMPL(AppSwapResponsiveLabUI)
+
+void AppSwapResponsiveLabUI::WebUIRenderFrameCreated(
+    content::RenderFrameHost* rfh) {
+  rfh->EnableMojoJsBindings(nullptr);
+}
+
+void AppSwapResponsiveLabUI::BindInterface(
+    mojo::PendingReceiver<app_swap_responsive_lab::mojom::PageHandlerFactory>
+        receiver) {
+  page_factory_receiver_.reset();
+  page_factory_receiver_.Bind(std::move(receiver));
+}
+
+void AppSwapResponsiveLabUI::CreatePageHandler(
+    mojo::PendingRemote<app_swap_responsive_lab::mojom::Page> page,
+    mojo::PendingReceiver<app_swap_responsive_lab::mojom::PageHandler>
+        handler) {
+  page_handler_ = std::make_unique<AppSwapResponsiveLabPageHandler>(
+      std::move(page), std::move(handler), bridge_);
+}
