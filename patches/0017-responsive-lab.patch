@@ -0,0 +1,49 @@
+// Copyright 2026 The AppSwap Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/views/app_swap/app_swap_responsive_lab_wheel_observer_mac.h"
+
+#include "chrome/browser/ui/views/app_swap/app_swap_responsive_lab_canvas_view.h"
+#include "ui/events/event.h"
+#include "ui/gfx/geometry/point.h"
+#include "ui/gfx/geometry/rect.h"
+#include "ui/views/event_monitor.h"
+#include "ui/views/view.h"
+#include "ui/views/widget/widget.h"
+
+AppSwapResponsiveLabWheelObserverMac::AppSwapResponsiveLabWheelObserverMac(
+    AppSwapResponsiveLabCanvasView* canvas_view)
+    : canvas_view_(canvas_view) {
+  views::Widget* widget = canvas_view_->GetWidget();
+  if (!widget) {
+    return;
+  }
+  monitor_ = views::EventMonitor::CreateWindowMonitor(
+      this, widget->GetNativeWindow(), {ui::EventType::kMousewheel});
+}
+
+AppSwapResponsiveLabWheelObserverMac::
+    ~AppSwapResponsiveLabWheelObserverMac() = default;
+
+void AppSwapResponsiveLabWheelObserverMac::OnEvent(const ui::Event& event) {
+  if (!event.IsMouseWheelEvent() || !event.IsControlDown() ||
+      !canvas_view_->GetVisible() || !canvas_view_->has_content()) {
+    return;
+  }
+
+  // EventObserver's own class comment: "The root location of located
+  // events is always in screen coordinates" -- bridge that into
+  // canvas_view_'s own local space the same way normal views::View event
+  // dispatch would.
+  const ui::MouseWheelEvent* wheel_event = event.AsMouseWheelEvent();
+  gfx::Point point_in_canvas = wheel_event->root_location();
+  views::View::ConvertPointFromScreen(canvas_view_, &point_in_canvas);
+  if (!canvas_view_->GetLocalBounds().Contains(point_in_canvas)) {
+    return;
+  }
+
+  ui::MouseWheelEvent local_event(*wheel_event);
+  local_event.set_location(point_in_canvas);
+  canvas_view_->OnMouseWheel(local_event);
+}
