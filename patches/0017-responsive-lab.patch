+// Copyright 2026 The AppSwap Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/views/app_swap/app_swap_responsive_lab_button.h"
+
+#include "base/functional/bind.h"
+#include "chrome/browser/app_swap/app_swap_responsive_lab_session.h"
+#include "chrome/browser/devtools/devtools_window.h"
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/browser/ui/browser_window/public/browser_window_interface.h"
+#include "chrome/browser/ui/tabs/tab_strip_model.h"
+#include "chrome/browser/ui/views/app_swap/app_swap_responsive_lab_devtools_host.h"
+#include "chrome/browser/ui/views/app_swap/app_swap_responsive_lab_grid_holder.h"
+#include "chrome/browser/ui/views/app_swap/app_swap_responsive_lab_overlay_view.h"
+#include "chrome/browser/ui/views/frame/browser_view.h"
+#include "chrome/browser/ui/views/frame/contents_container_view.h"
+#include "chrome/browser/ui/views/frame/contents_web_view.h"
+#include "components/vector_icons/vector_icons.h"
+#include "content/public/browser/web_contents.h"
+#include "ui/base/metadata/metadata_impl_macros.h"
+#include "ui/color/color_id.h"
+#include "ui/views/background.h"
+#include "url/gurl.h"
+
+namespace {
+
+constexpr float kActiveBadgeCornerRadius = 4.0f;
+
+}  // namespace
+
+AppSwapResponsiveLabButton::AppSwapResponsiveLabButton(
+    BrowserWindowInterface* browser)
+    : ToolbarButton(base::BindRepeating(
+          &AppSwapResponsiveLabButton::ButtonPressed, base::Unretained(this))),
+      browser_(browser) {
+  SetVectorIcon(vector_icons::kDevicesIcon);
+  SetTooltipText(u"Preview in Responsive Lab");
+  SetAccessibleName(u"Responsive Lab");
+  SetVisible(false);
+  browser_->GetTabStripModel()->AddObserver(this);
+  UpdateForActiveTab();
+}
+
+AppSwapResponsiveLabButton::~AppSwapResponsiveLabButton() {
+  browser_->GetTabStripModel()->RemoveObserver(this);
+}
+
+void AppSwapResponsiveLabButton::OnTabStripModelChanged(
+    TabStripModel* tab_strip_model,
+    const TabStripModelChange& change,
+    const TabStripSelectionChange& selection) {
+  if (selection.active_tab_changed()) {
+    UpdateForActiveTab();
+  }
+}
+
+void AppSwapResponsiveLabButton::OnTabChangedAt(tabs::TabInterface* tab,
+                                                TabChangeType change_type) {
+  UpdateForActiveTab();
+}
+
+void AppSwapResponsiveLabButton::ButtonPressed() {
+  content::WebContents* web_contents =
+      browser_->GetTabStripModel()->GetActiveWebContents();
+  if (!web_contents) {
+    return;
+  }
+  AppSwapResponsiveLabSession* session =
+      AppSwapResponsiveLabSession::GetOrCreateForWebContents(web_contents);
+  const bool new_active = !session->active();
+  session->SetActive(new_active);
+  SyncContentsContainer(web_contents, new_active);
+  if (!new_active) {
+    // An explicit toggle-off (as opposed to merely switching tabs away
+    // from an active grid, which keeps it cached in its
+    // AppSwapResponsiveLabGridHolder for a possible later reactivation) --
+    // actually free the grid's renderer processes rather than leaving them
+    // cached for a reactivation the user hasn't asked for, and forget where
+    // the user had panned a canvas they've now dismissed. The viewport list
+    // itself deliberately survives: it's this tab's configuration, not
+    // scratch state (see AppSwapResponsiveLabSession::ResetCanvasTransform).
+    if (AppSwapResponsiveLabGridHolder* holder =
+            AppSwapResponsiveLabGridHolder::FromWebContents(web_contents)) {
+      holder->Discard();
+    }
+    session->ResetCanvasTransform();
+    // The panel's own renderer, on the same reasoning -- see
+    // AppSwapResponsiveLabOverlayView::DiscardPanel() for why this is here
+    // rather than inside the HideCurrent() that SyncContentsContainer just
+    // did.
+    if (AppSwapResponsiveLabOverlayView* overlay =
+            OverlayFor(web_contents)) {
+      overlay->DiscardPanel();
+    }
+  }
+  SetActiveVisual(new_active);
+}
+
+void AppSwapResponsiveLabButton::UpdateForActiveTab() {
+  content::WebContents* web_contents =
+      browser_->GetTabStripModel()->GetActiveWebContents();
+  if (!web_contents) {
+    SetVisible(false);
+    return;
+  }
+
+  // The button itself only makes sense on an http(s) page, but the
+  // container sync below must still run even when it doesn't -- e.g.
+  // switching to a chrome://newtab/ tab while a previous http(s) tab has
+  // Responsive Lab active. Returning early here (skipping
+  // SyncContentsContainer) used to leave that tab's grid on screen
+  // indefinitely, since nothing else ever told the (per-content-slot, not
+  // per-tab) overlay to hide or contents_view() to show again -- this is
+  // what made a brand new tab appear to inherit the previous tab's grid.
+  const bool applicable =
+      web_contents->GetLastCommittedURL().SchemeIsHTTPOrHTTPS();
+  SetVisible(applicable);
+
+  bool active = false;
+  if (applicable) {
+    if (AppSwapResponsiveLabSession* session =
+            AppSwapResponsiveLabSession::FromWebContents(web_contents)) {
+      active = session->active();
+    }
+  }
+  SetActiveVisual(active);
+  SyncContentsContainer(web_contents, active);
+}
+
+void AppSwapResponsiveLabButton::SetActiveVisual(bool active) {
+  if (active) {
+    SetBackground(views::CreateRoundedRectBackground(
+        ui::kColorSysNeutralContainer, kActiveBadgeCornerRadius));
+  } else {
+    SetBackground(nullptr);
+  }
+}
+
+ContentsContainerView* AppSwapResponsiveLabButton::ContainerFor(
+    content::WebContents* web_contents) {
+  BrowserView* browser_view = BrowserView::GetBrowserViewForBrowser(browser_);
+  if (!browser_view) {
+    return nullptr;
+  }
+  // Null when web_contents isn't currently shown by any container (e.g.
+  // it's a background tab) -- there is then nothing on screen to sync.
+  return browser_view->GetContentsContainerViewFor(web_contents);
+}
+
+AppSwapResponsiveLabOverlayView* AppSwapResponsiveLabButton::OverlayFor(
+    content::WebContents* web_contents) {
+  ContentsContainerView* container = ContainerFor(web_contents);
+  return container ? container->app_swap_responsive_lab_overlay_view()
+                   : nullptr;
+}
+
+void AppSwapResponsiveLabButton::SyncContentsContainer(
+    content::WebContents* web_contents,
+    bool active) {
+  ContentsContainerView* container = ContainerFor(web_contents);
+  if (!container) {
+    return;
+  }
+
+  AppSwapResponsiveLabOverlayView* overlay =
+      container->app_swap_responsive_lab_overlay_view();
+  if (!overlay) {
+    return;
+  }
+
+  if (active) {
+    Profile* profile =
+        Profile::FromBrowserContext(web_contents->GetBrowserContext());
+    AppSwapResponsiveLabSession* session =
+        AppSwapResponsiveLabSession::GetOrCreateForWebContents(web_contents);
+    session->SetPreviewedUrl(web_contents->GetLastCommittedURL());
+    // Evaluated here rather than inside the session, which is deliberately
+    // Views-agnostic and must not depend on //chrome/browser/devtools: this
+    // is the DeveloperToolsAvailability enterprise policy, and it decides
+    // whether each viewport gets a protocol client (and therefore device
+    // emulation) at all.
+    session->set_inspection_allowed(
+        DevToolsWindow::AllowDevToolsFor(profile, web_contents));
+    // Has to exist before the panel can ask for DevTools, and it listens to
+    // the session rather than being driven, so creating it is all there is
+    // to do. A no-op once this tab already has one.
+    AppSwapResponsiveLabDevToolsHost::CreateForWebContents(web_contents);
+    overlay->ShowGridFor(web_contents, profile);
+    container->contents_view()->SetVisible(false);
+  } else {
+    // HideCurrent() detaches whatever the overlay is currently showing --
+    // which, since it's one-per-content-slot rather than one-per-tab, may
+    // belong to a *different* tab than `web_contents` (e.g. this call is
+    // for a newly-active tab that doesn't apply, while the previously
+    // active tab still has an attached grid to hand back to its holder).
+    overlay->HideCurrent();
+    container->contents_view()->SetVisible(true);
+  }
+}
+
+BEGIN_METADATA(AppSwapResponsiveLabButton)
+END_METADATA
