+#include "chrome/browser/app_swap/app_swap_responsive_lab_inspector.h"
+
+#include <algorithm>
+#include <cstddef>
+#include <utility>
+
+#include "base/functional/bind.h"
+#include "base/strings/string_split.h"
+#include "base/strings/string_util.h"
+#include "chrome/browser/app_swap/app_swap_responsive_lab_session.h"
+#include "chrome/browser/app_swap/app_swap_responsive_lab_viewport_client.h"
+
+namespace {
+
+using CommandCallback = AppSwapResponsiveLabViewportClient::CommandCallback;
+
+// How many console lines to keep. The stream is merged across every
+// viewport, so a chatty page fills it several times as fast as one tab
+// would; past this the oldest entries are dropped.
+constexpr size_t kMaxConsoleEntries = 300;
+
+// Builds a selector that identifies `this` element well enough to find the
+// same element in another viewport rendering the same page. Runs in the page
+// rather than being reconstructed from the protocol's node tree in C++: the
+// DOM already knows its own shape, and CSS.escape plus nth-of-type counting
+// are a lot of code to get subtly wrong on this side.
+//
+// Stops as soon as it reaches a unique id, so the common case is short and
+// survives structural differences further up. That matters here: the
+// viewports are the same page at different widths, and their trees can
+// legitimately differ above the element the user pointed at.
+constexpr char kSelectorBuilder[] =
+    "function() {"
+    "  function part(el) {"
+    "    if (el.id &&"
+    "        document.querySelectorAll('#' + CSS.escape(el.id)).length === 1) {"
+    "      return '#' + CSS.escape(el.id);"
+    "    }"
+    "    const tag = el.tagName.toLowerCase();"
+    "    const parent = el.parentElement;"
+    "    if (!parent) {"
+    "      return tag;"
+    "    }"
+    "    const siblings = Array.from(parent.children).filter("
+    "        c => c.tagName === el.tagName);"
+    "    if (siblings.length === 1) {"
+    "      return tag;"
+    "    }"
+    "    return tag + ':nth-of-type(' + (siblings.indexOf(el) + 1) + ')';"
+    "  }"
+    "  let el = this;"
+    "  if (el && el.nodeType !== 1) {"
+    "    el = el.parentElement;"
+    "  }"
+    "  const parts = [];"
+    "  while (el && el.nodeType === 1) {"
+    "    const p = part(el);"
+    "    parts.unshift(p);"
+    "    if (p.charAt(0) === '#') {"
+    "      break;"
+    "    }"
+    "    el = el.parentElement;"
+    "  }"
+    "  return parts.join(' > ');"
+    "}";
+
+base::DictValue Rgba(int r, int g, int b, double a) {
+  return base::DictValue().Set("r", r).Set("g", g).Set("b", b).Set("a", a);
+}
+
+// The same translucent content/padding/border/margin bands DevTools uses, so
+// the highlight reads as the familiar thing rather than as a lab-specific
+// decoration.
+base::DictValue HighlightConfig() {
+  return base::DictValue()
+      .Set("showInfo", false)
+      .Set("contentColor", Rgba(111, 168, 220, 0.4))
+      .Set("paddingColor", Rgba(147, 196, 125, 0.4))
+      .Set("borderColor", Rgba(255, 229, 153, 0.4))
+      .Set("marginColor", Rgba(246, 178, 107, 0.4));
+}
+
+// Flattens Runtime.consoleAPICalled's argument list the way a console does:
+// objects by their description, primitives by value.
+std::string DescribeConsoleArgs(const base::DictValue& params) {
+  const base::ListValue* args = params.FindList("args");
+  if (!args) {
+    return std::string();
+  }
+  std::vector<std::string> parts;
+  for (const base::Value& arg : *args) {
+    if (!arg.is_dict()) {
+      continue;
+    }
+    const base::DictValue& object = arg.GetDict();
+    if (const base::Value* value = object.Find("value")) {
+      if (const std::string* as_string = value->GetIfString()) {
+        parts.push_back(*as_string);
+      } else {
+        parts.push_back(value->DebugString());
+      }
+      continue;
+    }
+    if (const std::string* description = object.FindString("description")) {
+      parts.push_back(*description);
+      continue;
+    }
+    if (const std::string* type = object.FindString("type")) {
+      parts.push_back(*type);
+    }
+  }
+  return base::JoinString(parts, " ");
+}
+
+}  // namespace
+
+AppSwapResponsiveLabInspector::ConsoleEntry::ConsoleEntry() = default;
+AppSwapResponsiveLabInspector::ConsoleEntry::ConsoleEntry(const ConsoleEntry&) =
+    default;
+AppSwapResponsiveLabInspector::ConsoleEntry&
+AppSwapResponsiveLabInspector::ConsoleEntry::operator=(const ConsoleEntry&) =
+    default;
+AppSwapResponsiveLabInspector::ConsoleEntry::~ConsoleEntry() = default;
+
+AppSwapResponsiveLabInspector::MatchedRule::MatchedRule() = default;
+AppSwapResponsiveLabInspector::MatchedRule::MatchedRule(const MatchedRule&) =
+    default;
+AppSwapResponsiveLabInspector::MatchedRule&
+AppSwapResponsiveLabInspector::MatchedRule::operator=(const MatchedRule&) =
+    default;
+AppSwapResponsiveLabInspector::MatchedRule::~MatchedRule() = default;
+
+AppSwapResponsiveLabInspector::AppSwapResponsiveLabInspector(
+    AppSwapResponsiveLabSession* session)
+    : session_(session) {}
+
+AppSwapResponsiveLabInspector::~AppSwapResponsiveLabInspector() = default;
+
+void AppSwapResponsiveLabInspector::AddObserver(Observer* observer) {
+  observers_.AddObserver(observer);
+}
+
+void AppSwapResponsiveLabInspector::RemoveObserver(Observer* observer) {
+  observers_.RemoveObserver(observer);
+}
+
+void AppSwapResponsiveLabInspector::OnViewportAttached(
+    const std::string& viewport_id) {
+  AppSwapResponsiveLabViewportClient* client = session_->ClientFor(viewport_id);
+  if (!client) {
+    return;
+  }
+
+  client->set_event_callback(
+      base::BindRepeating(&AppSwapResponsiveLabInspector::OnProtocolEvent,
+                          weak_factory_.GetWeakPtr(), viewport_id));
+
+  // DOM first: CSS and Overlay both address nodes by the ids the DOM agent
+  // hands out, and neither reports anything useful until it is tracking a
+  // document.
+  for (const char* domain : {"DOM.enable", "CSS.enable", "Overlay.enable",
+                             "Log.enable", "Runtime.enable"}) {
+    client->SendCommand(domain, base::DictValue(), CommandCallback());
+  }
+
+  if (picking_) {
+    SetInspectModeOn(viewport_id, true);
+  }
+  if (!selected_selector_.empty()) {
+    // A viewport added while something is selected joins the selection
+    // rather than being the one cell without a highlight.
+    ResolveSelectionEverywhere();
+  }
+}
+
+void AppSwapResponsiveLabInspector::OnViewportDetached(
+    const std::string& viewport_id) {
+  // Both, unconditionally: `||` would short-circuit past the erase the
+  // moment the node id was found, leaving this viewport's rules behind.
+  const bool had_node = selected_node_ids_.erase(viewport_id) > 0;
+  const bool had_rules =
+      std::erase_if(matched_rules_, [&viewport_id](const MatchedRule& rule) {
+        return rule.viewport_id == viewport_id;
+      }) > 0;
+  if (had_node || had_rules) {
+    NotifySelectionChanged();
+  }
+}
+
+void AppSwapResponsiveLabInspector::StartPicking() {
+  if (picking_) {
+    return;
+  }
+  picking_ = true;
+  // Armed in every viewport, not just one: the user shouldn't have to say
+  // in advance which cell they intend to click in.
+  for (const AppSwapResponsiveLabSession::Viewport& viewport :
+       session_->viewports()) {
+    SetInspectModeOn(viewport.preset.id, true);
+  }
+  NotifyPickingChanged();
+}
+
+void AppSwapResponsiveLabInspector::StopPicking() {
+  if (!picking_) {
+    return;
+  }
+  picking_ = false;
+  for (const AppSwapResponsiveLabSession::Viewport& viewport :
+       session_->viewports()) {
+    SetInspectModeOn(viewport.preset.id, false);
+  }
+  NotifyPickingChanged();
+}
+
+void AppSwapResponsiveLabInspector::ClearSelection() {
+  selected_selector_.clear();
+  selection_source_viewport_id_.clear();
+  selected_node_ids_.clear();
+  matched_rules_.clear();
+  // Invalidates every reply still in flight for the old selection.
+  ++selection_generation_;
+
+  for (const AppSwapResponsiveLabSession::Viewport& viewport :
+       session_->viewports()) {
+    if (AppSwapResponsiveLabViewportClient* client =
+            session_->ClientFor(viewport.preset.id)) {
+      client->SendCommand("Overlay.hideHighlight", base::DictValue(),
+                          CommandCallback());
+    }
+  }
+  NotifySelectionChanged();
+}
+
+void AppSwapResponsiveLabInspector::ApplyStyleToAll(
+    const std::string& declarations) {
+  if (selected_selector_.empty()) {
+    return;
+  }
+
+  // Split into property/value pairs here rather than sending the block
+  // whole. CSS.setEffectivePropertyValueForNode takes one property at a
+  // time, and in exchange it works on an element that has no style
+  // attribute yet -- which CSS.setStyleTexts, needing an existing source
+  // range to replace, does not.
+  std::vector<std::pair<std::string, std::string>> properties;
+  for (const std::string& piece :
+       base::SplitString(declarations, ";", base::TRIM_WHITESPACE,
+                         base::SPLIT_WANT_NONEMPTY)) {
+    const size_t colon = piece.find(':');
+    if (colon == std::string::npos) {
+      continue;
+    }
+    std::string property(base::TrimWhitespaceASCII(piece.substr(0, colon),
+                                                   base::TRIM_ALL));
+    std::string value(base::TrimWhitespaceASCII(piece.substr(colon + 1),
+                                                base::TRIM_ALL));
+    if (!property.empty() && !value.empty()) {
+      properties.emplace_back(std::move(property), std::move(value));
+    }
+  }
+  if (properties.empty()) {
+    return;
+  }
+
+  for (const auto& [viewport_id, node_id] : selected_node_ids_) {
+    AppSwapResponsiveLabViewportClient* client =
+        session_->ClientFor(viewport_id);
+    if (!client) {
+      continue;
+    }
+    for (const auto& [property, value] : properties) {
+      client->SendCommand("CSS.setEffectivePropertyValueForNode",
+                          base::DictValue()
+                              .Set("nodeId", node_id)
+                              .Set("propertyName", property)
+                              .Set("value", value),
+                          CommandCallback());
+    }
+  }
+
+  // Re-read afterwards so the panel shows what actually landed, including
+  // any declaration the engine rejected as invalid.
+  ResolveSelectionEverywhere();
+}
+
+void AppSwapResponsiveLabInspector::ClearConsole() {
+  console_.clear();
+  NotifyConsoleChanged();
+}
+
+void AppSwapResponsiveLabInspector::SetInspectModeOn(
+    const std::string& viewport_id,
+    bool enabled) {
+  AppSwapResponsiveLabViewportClient* client = session_->ClientFor(viewport_id);
+  if (!client) {
+    return;
+  }
+  base::DictValue params;
+  params.Set("mode", enabled ? "searchForNode" : "none");
+  if (enabled) {
+    params.Set("highlightConfig", HighlightConfig());
+  }
+  client->SendCommand("Overlay.setInspectMode", std::move(params),
+                      CommandCallback());
+}
+
+void AppSwapResponsiveLabInspector::OnProtocolEvent(
+    const std::string& viewport_id,
+    const std::string& method,
+    const base::DictValue& params) {
+  if (method == "Overlay.inspectNodeRequested") {
+    if (std::optional<int> backend_node_id = params.FindInt("backendNodeId")) {
+      OnNodePicked(viewport_id, *backend_node_id);
+    }
+    return;
+  }
+
+  if (method == "Log.entryAdded") {
+    const base::DictValue* entry = params.FindDict("entry");
+    if (!entry) {
+      return;
+    }
+    ConsoleEntry console_entry;
+    console_entry.viewport_id = viewport_id;
+    if (const std::string* level = entry->FindString("level")) {
+      console_entry.level = *level;
+    }
+    if (const std::string* text = entry->FindString("text")) {
+      console_entry.text = *text;
+    }
+    if (const std::string* url = entry->FindString("url")) {
+      console_entry.url = *url;
+    }
+    console_entry.line = entry->FindInt("lineNumber").value_or(0);
+    AddConsoleEntry(std::move(console_entry));
+    return;
+  }
+
+  if (method == "Runtime.consoleAPICalled") {
+    ConsoleEntry console_entry;
+    console_entry.viewport_id = viewport_id;
+    if (const std::string* type = params.FindString("type")) {
+      console_entry.level = *type;
+    }
+    console_entry.text = DescribeConsoleArgs(params);
+    AddConsoleEntry(std::move(console_entry));
+    return;
+  }
+
+  if (method == "Runtime.exceptionThrown") {
+    const base::DictValue* details = params.FindDict("exceptionDetails");
+    if (!details) {
+      return;
+    }
+    ConsoleEntry console_entry;
+    console_entry.viewport_id = viewport_id;
+    console_entry.level = "error";
+    // The exception's own description carries the stack-bearing message
+    // ("TypeError: x is not a function"); `text` is the bare wrapper
+    // ("Uncaught"), so it is only a fallback.
+    if (const base::DictValue* exception = details->FindDict("exception")) {
+      if (const std::string* description =
+              exception->FindString("description")) {
+        console_entry.text = *description;
+      }
+    }
+    if (console_entry.text.empty()) {
+      if (const std::string* text = details->FindString("text")) {
+        console_entry.text = *text;
+      }
+    }
+    if (const std::string* url = details->FindString("url")) {
+      console_entry.url = *url;
+    }
+    console_entry.line = details->FindInt("lineNumber").value_or(0);
+    AddConsoleEntry(std::move(console_entry));
+    return;
+  }
+}
+
+void AppSwapResponsiveLabInspector::OnNodePicked(const std::string& viewport_id,
+                                                 int backend_node_id) {
+  AppSwapResponsiveLabViewportClient* client = session_->ClientFor(viewport_id);
+  if (!client) {
+    return;
+  }
+
+  // One pick ends the pick; leaving the picker armed would make the very
+  // next click in any cell replace the selection the user just made.
+  StopPicking();
+
+  const int generation = ++selection_generation_;
+  selection_source_viewport_id_ = viewport_id;
+
+  client->SendCommand(
+      "DOM.resolveNode",
+      base::DictValue()
+          .Set("backendNodeId", backend_node_id)
+          .Set("objectGroup", "appswap-responsive-lab"),
+      base::BindOnce(&AppSwapResponsiveLabInspector::OnNodeResolved,
+                     weak_factory_.GetWeakPtr(), viewport_id, generation));
+}
+
+void AppSwapResponsiveLabInspector::OnNodeResolved(
+    const std::string& viewport_id,
+    int generation,
+    std::optional<base::DictValue> result) {
+  if (generation != selection_generation_ || !result) {
+    return;
+  }
+  const base::DictValue* object = result->FindDict("object");
+  const std::string* object_id =
+      object ? object->FindString("objectId") : nullptr;
+  if (!object_id) {
+    return;
+  }
+  AppSwapResponsiveLabViewportClient* client = session_->ClientFor(viewport_id);
+  if (!client) {
+    return;
+  }
+
+  client->SendCommand(
+      "Runtime.callFunctionOn",
+      base::DictValue()
+          .Set("objectId", *object_id)
+          .Set("functionDeclaration", kSelectorBuilder)
+          .Set("returnByValue", true),
+      base::BindOnce(&AppSwapResponsiveLabInspector::OnSelectorBuilt,
+                     weak_factory_.GetWeakPtr(), generation));
+}
+
+void AppSwapResponsiveLabInspector::OnSelectorBuilt(
+    int generation,
+    std::optional<base::DictValue> result) {
+  if (generation != selection_generation_ || !result) {
+    return;
+  }
+  const base::DictValue* value = result->FindDict("result");
+  const std::string* selector = value ? value->FindString("value") : nullptr;
+  if (!selector || selector->empty()) {
+    return;
+  }
+  selected_selector_ = *selector;
+  ResolveSelectionEverywhere();
+}
+
+void AppSwapResponsiveLabInspector::ResolveSelectionEverywhere() {
+  if (selected_selector_.empty()) {
+    return;
+  }
+  // Not a new generation: this re-resolves the *same* selection (a viewport
+  // was added, a style was edited), and bumping it here would cancel the
+  // very replies this is about to wait for.
+  const int generation = selection_generation_;
+  selected_node_ids_.clear();
+  matched_rules_.clear();
+
+  for (const AppSwapResponsiveLabSession::Viewport& viewport :
+       session_->viewports()) {
+    AppSwapResponsiveLabViewportClient* client =
+        session_->ClientFor(viewport.preset.id);
+    if (!client) {
+      continue;
+    }
+    // Depth 0: only the document node is wanted, as the root to query
+    // from. Asking for the whole tree would ship the entire DOM over the
+    // pipe for nothing.
+    client->SendCommand(
+        "DOM.getDocument", base::DictValue().Set("depth", 0),
+        base::BindOnce(&AppSwapResponsiveLabInspector::OnDocumentForSelection,
+                       weak_factory_.GetWeakPtr(), viewport.preset.id,
+                       generation));
+  }
+}
+
+void AppSwapResponsiveLabInspector::OnDocumentForSelection(
+    const std::string& viewport_id,
+    int generation,
+    std::optional<base::DictValue> result) {
+  if (generation != selection_generation_ || !result) {
+    return;
+  }
+  const base::DictValue* root = result->FindDict("root");
+  const std::optional<int> root_node_id =
+      root ? root->FindInt("nodeId") : std::nullopt;
+  if (!root_node_id) {
+    return;
+  }
+  AppSwapResponsiveLabViewportClient* client = session_->ClientFor(viewport_id);
+  if (!client) {
+    return;
+  }
+
+  client->SendCommand(
+      "DOM.querySelector", base::DictValue()
+                               .Set("nodeId", *root_node_id)
+                               .Set("selector", selected_selector_),
+      base::BindOnce(&AppSwapResponsiveLabInspector::OnQuerySelectorResult,
+                     weak_factory_.GetWeakPtr(), viewport_id, generation));
+}
+
+void AppSwapResponsiveLabInspector::OnQuerySelectorResult(
+    const std::string& viewport_id,
+    int generation,
+    std::optional<base::DictValue> result) {
+  if (generation != selection_generation_) {
+    return;
+  }
+  // A miss is a legitimate outcome, not an error: the element may simply
+  // not exist at this width. The viewport keeps no node id and contributes
+  // no rules, which is what the panel renders as "no match".
+  const std::optional<int> node_id =
+      result ? result->FindInt("nodeId") : std::nullopt;
+  if (!node_id || *node_id == 0) {
+    NotifySelectionChanged();
+    return;
+  }
+  selected_node_ids_[viewport_id] = *node_id;
+
+  AppSwapResponsiveLabViewportClient* client = session_->ClientFor(viewport_id);
+  if (!client) {
+    return;
+  }
+
+  client->SendCommand("Overlay.highlightNode",
+                      base::DictValue()
+                          .Set("highlightConfig", HighlightConfig())
+                          .Set("nodeId", *node_id),
+                      CommandCallback());
+
+  client->SendCommand(
+      "CSS.getMatchedStylesForNode", base::DictValue().Set("nodeId", *node_id),
+      base::BindOnce(&AppSwapResponsiveLabInspector::OnMatchedStyles,
+                     weak_factory_.GetWeakPtr(), viewport_id, generation));
+}
+
+void AppSwapResponsiveLabInspector::OnMatchedStyles(
+    const std::string& viewport_id,
+    int generation,
+    std::optional<base::DictValue> result) {
+  if (generation != selection_generation_ || !result) {
+    return;
+  }
+
+  // Replace rather than append: this viewport's rules may already be here
+  // from an earlier pass (a style edit re-reads all of them).
+  std::erase_if(matched_rules_, [&viewport_id](const MatchedRule& rule) {
+    return rule.viewport_id == viewport_id;
+  });
+
+  // The element's own inline style first, since that is what
+  // ApplyStyleToAll() writes to and what the user most wants to see.
+  if (const base::DictValue* inline_style = result->FindDict("inlineStyle")) {
+    if (const std::string* css_text = inline_style->FindString("cssText")) {
+      if (!css_text->empty()) {
+        MatchedRule rule;
+        rule.viewport_id = viewport_id;
+        rule.selector = "element.style";
+        rule.css_text = *css_text;
+        rule.origin = "inline";
+        matched_rules_.push_back(std::move(rule));
+      }
+    }
+  }
+
+  if (const base::ListValue* matches = result->FindList("matchedCSSRules")) {
+    // Reversed: the protocol lists matches weakest-first, and a stylesheet
+    // pane that puts the winning rule at the bottom reads backwards to
+    // anyone used to DevTools.
+    for (auto it = matches->end(); it != matches->begin();) {
+      --it;
+      if (!it->is_dict()) {
+        continue;
+      }
+      const base::DictValue* css_rule = it->GetDict().FindDict("rule");
+      if (!css_rule) {
+        continue;
+      }
+
+      MatchedRule rule;
+      rule.viewport_id = viewport_id;
+      if (const base::DictValue* selector_list =
+              css_rule->FindDict("selectorList")) {
+        if (const std::string* text = selector_list->FindString("text")) {
+          rule.selector = *text;
+        }
+      }
+      if (const base::DictValue* style = css_rule->FindDict("style")) {
+        if (const std::string* css_text = style->FindString("cssText")) {
+          rule.css_text = *css_text;
+        }
+      }
+      if (const std::string* origin = css_rule->FindString("origin")) {
+        rule.origin = *origin;
+      }
+      // The innermost media condition, which is the one that usually
+      // explains why two viewports disagree.
+      if (const base::ListValue* media = css_rule->FindList("media")) {
+        if (!media->empty() && media->front().is_dict()) {
+          if (const std::string* text =
+                  media->front().GetDict().FindString("text")) {
+            rule.media = *text;
+          }
+        }
+      }
+      if (!rule.selector.empty() && !rule.css_text.empty()) {
+        matched_rules_.push_back(std::move(rule));
+      }
+    }
+  }
+
+  NotifySelectionChanged();
+}
+
+void AppSwapResponsiveLabInspector::AddConsoleEntry(ConsoleEntry entry) {
+  console_.push_back(std::move(entry));
+  if (console_.size() > kMaxConsoleEntries) {
+    console_.erase(console_.begin(),
+                   console_.begin() +
+                       static_cast<ptrdiff_t>(console_.size() -
+                                              kMaxConsoleEntries));
+  }
+  NotifyConsoleChanged();
+}
+
+void AppSwapResponsiveLabInspector::NotifyPickingChanged() {
+  for (Observer& observer : observers_) {
+    observer.OnInspectorPickingChanged();
+  }
+}
+
+void AppSwapResponsiveLabInspector::NotifySelectionChanged() {
+  for (Observer& observer : observers_) {
+    observer.OnInspectorSelectionChanged();
+  }
+}
+
+void AppSwapResponsiveLabInspector::NotifyConsoleChanged() {
+  for (Observer& observer : observers_) {
+    observer.OnInspectorConsoleChanged();
+  }
+}
