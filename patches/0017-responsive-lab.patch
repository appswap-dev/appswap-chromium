+// Copyright 2026 The AppSwap Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_VIEWS_APP_SWAP_APP_SWAP_RESPONSIVE_LAB_WHEEL_INTERCEPTOR_AURA_H_
+#define CHROME_BROWSER_UI_VIEWS_APP_SWAP_APP_SWAP_RESPONSIVE_LAB_WHEEL_INTERCEPTOR_AURA_H_
+
+#include "base/memory/raw_ptr.h"
+#include "ui/events/event_handler.h"
+
+class AppSwapResponsiveLabCanvasView;
+
+// A pre-target event handler (registered on the browser window's own
+// aura::Window -- see AppSwapResponsiveLabOverlayView::AddedToWidget())
+// that intercepts Ctrl+Wheel events anywhere in the window, before they
+// reach their normal target, and routes them to `canvas_view`'s own
+// Ctrl+Wheel-to-zoom handling if they land within it.
+//
+// This exists because a grid cell's views::WebView hosts a real native
+// renderer window (RenderWidgetHostView), which receives wheel input
+// directly rather than through normal views::View event dispatch --
+// canvas_view's own OnMouseWheel() override only ever sees events that
+// land on empty canvas background, never ones over a cell, since the
+// WebView (being on top, and native) claims those first. Modeled on
+// WebUIBubbleEventHandlerAura (chrome/browser/ui/views/bubble/), which
+// solves the same "native content is stealing events an ancestor view
+// needs first" problem for bubble-drag handling.
+class AppSwapResponsiveLabWheelInterceptorAura : public ui::EventHandler {
+ public:
+  explicit AppSwapResponsiveLabWheelInterceptorAura(
+      AppSwapResponsiveLabCanvasView* canvas_view);
+  AppSwapResponsiveLabWheelInterceptorAura(
+      const AppSwapResponsiveLabWheelInterceptorAura&) = delete;
+  AppSwapResponsiveLabWheelInterceptorAura& operator=(
+      const AppSwapResponsiveLabWheelInterceptorAura&) = delete;
+  ~AppSwapResponsiveLabWheelInterceptorAura() override;
+
+  // ui::EventHandler:
+  void OnMouseEvent(ui::MouseEvent* event) override;
+
+ private:
+  // Owned by AppSwapResponsiveLabOverlayView, which outlives this object
+  // (constructed/destroyed alongside it in AddedToWidget()/
+  // RemovedFromWidget()) and owns canvas_view_ too, for the same lifetime.
+  const raw_ptr<AppSwapResponsiveLabCanvasView> canvas_view_;
+};
+
+#endif  // CHROME_BROWSER_UI_VIEWS_APP_SWAP_APP_SWAP_RESPONSIVE_LAB_WHEEL_INTERCEPTOR_AURA_H_
diff --git a/chrome/browser/ui/views/app_swap/app_swap_responsive_lab_wheel_observer_mac.cc b/chrome/browser/ui/views/app_swap/app_swap_responsive_lab_wheel_observer_mac.cc
new file mode 100644
index 0000000000000..dab20b67edd1b
--- /dev/null
+++ b/chrome/browser/ui/views/app_swap/app_swap_responsive_lab_wheel_observer_mac.cc
@@ -0,0 +1,49 @@
+// Copyright 2026 The AppSwap Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/views/app_swap/app_swap_responsive_lab_wheel_observer_mac.h"
+
+#include "chrome/browser/ui/views/app_swap/app_swap_responsive_lab_canvas_view.h"
+#include "ui/events/event.h"
+#include "ui/gfx/geometry/point.h"
+#include "ui/gfx/geometry/rect.h"
+#include "ui/views/event_monitor.h"
+#include "ui/views/view.h"
+#include "ui/views/widget/widget.h"
+
+AppSwapResponsiveLabWheelObserverMac::AppSwapResponsiveLabWheelObserverMac(
+    AppSwapResponsiveLabCanvasView* canvas_view)
+    : canvas_view_(canvas_view) {
+  views::Widget* widget = canvas_view_->GetWidget();
+  if (!widget) {
+    return;
+  }
+  monitor_ = views::EventMonitor::CreateWindowMonitor(
+      this, widget->GetNativeWindow(), {ui::EventType::kMousewheel});
+}
+
+AppSwapResponsiveLabWheelObserverMac::
+    ~AppSwapResponsiveLabWheelObserverMac() = default;
+
+void AppSwapResponsiveLabWheelObserverMac::OnEvent(const ui::Event& event) {
+  if (!event.IsMouseWheelEvent() || !event.IsControlDown() ||
+      !canvas_view_->GetVisible() || !canvas_view_->has_content()) {
+    return;
+  }
+
+  // EventObserver's own class comment: "The root location of located
+  // events is always in screen coordinates" -- bridge that into
+  // canvas_view_'s own local space the same way normal views::View event
+  // dispatch would.
+  const ui::MouseWheelEvent* wheel_event = event.AsMouseWheelEvent();
+  gfx::Point point_in_canvas = wheel_event->root_location();
+  views::View::ConvertPointFromScreen(canvas_view_, &point_in_canvas);
+  if (!canvas_view_->GetLocalBounds().Contains(point_in_canvas)) {
+    return;
+  }
+
+  ui::MouseWheelEvent local_event(*wheel_event);
+  local_event.set_location(point_in_canvas);
+  canvas_view_->OnMouseWheel(local_event);
+}
