new file mode 100644
index 0000000000000..07d458ec3c543
--- /dev/null
+++ b/chrome/browser/app_swap/app_swap_responsive_lab_session.cc
@@ -0,0 +1,305 @@
+// Copyright 2026 The AppSwap Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/app_swap/app_swap_responsive_lab_session.h"
+
+#include <algorithm>
+#include <utility>
+
+#include "base/strings/strcat.h"
+#include "base/strings/string_number_conversions.h"
+#include "base/version_info/version_info.h"
+#include "chrome/browser/app_swap/app_swap_responsive_lab_inspector.h"
+#include "content/public/browser/navigation_controller.h"
+#include "content/public/browser/reload_type.h"
+#include "content/public/browser/web_contents.h"
+
+namespace {
+
+// A modern Android Chrome user agent, matching the shape Chrome itself
+// sends under user-agent reduction (a frozen device string, and only the
+// major version). Built at runtime from this build's own version rather
+// than hardcoded whole, so it can't silently go stale across a Chromium
+// upgrade and start advertising a version nobody ships.
+std::string MobileUserAgent(bool tablet) {
+  return base::StrCat({"Mozilla/5.0 (Linux; Android 10; K) "
+                       "AppleWebKit/537.36 (KHTML, like Gecko) Chrome/",
+                       version_info::GetMajorVersionNumber(), ".0.0.0 ",
+                       tablet ? "" : "Mobile ", "Safari/537.36"});
+}
+
+}  // namespace
+
+AppSwapResponsiveLabSession::Viewport::Viewport() = default;
+AppSwapResponsiveLabSession::Viewport::Viewport(Viewport&&) = default;
+AppSwapResponsiveLabSession::Viewport&
+AppSwapResponsiveLabSession::Viewport::operator=(Viewport&&) = default;
+AppSwapResponsiveLabSession::Viewport::~Viewport() = default;
+
+AppSwapResponsiveLabSession::AppSwapResponsiveLabSession(
+    content::WebContents* web_contents)
+    : content::WebContentsUserData<AppSwapResponsiveLabSession>(
+          *web_contents),
+      inspector_(std::make_unique<AppSwapResponsiveLabInspector>(this)) {
+  for (AppSwapDevicePreset& preset : DefaultPresets()) {
+    AddViewport(std::move(preset));
+  }
+}
+
+AppSwapResponsiveLabSession::~AppSwapResponsiveLabSession() {
+  for (Observer& observer : observers_) {
+    observer.OnResponsiveLabSessionDestroying();
+  }
+}
+
+// static
+std::vector<AppSwapDevicePreset> AppSwapResponsiveLabSession::DefaultPresets() {
+  // Still short, and for the same reason it always was: each viewport is a
+  // full extra renderer process while active.
+  std::vector<AppSwapDevicePreset> presets;
+
+  AppSwapDevicePreset mobile;
+  mobile.name = "Mobile";
+  mobile.width = 390;
+  mobile.height = 844;
+  mobile.device_scale_factor = 3.0f;
+  mobile.mobile = true;
+  mobile.user_agent = MobileUserAgent(/*tablet=*/false);
+  presets.push_back(std::move(mobile));
+
+  AppSwapDevicePreset tablet;
+  tablet.name = "Tablet";
+  tablet.width = 820;
+  tablet.height = 1180;
+  tablet.device_scale_factor = 2.0f;
+  tablet.mobile = true;
+  tablet.user_agent = MobileUserAgent(/*tablet=*/true);
+  presets.push_back(std::move(tablet));
+
+  AppSwapDevicePreset desktop;
+  desktop.name = "Desktop";
+  desktop.width = 1440;
+  desktop.height = 900;
+  // Left at 0 (no override) and with no user agent on purpose: the desktop
+  // cell is meant to be the same browser the user is already running, and
+  // pinning its ratio to 1 would make it render visibly softer than the
+  // real tab beside it on a HiDPI display.
+  presets.push_back(std::move(desktop));
+
+  return presets;
+}
+
+void AppSwapResponsiveLabSession::AddObserver(Observer* observer) {
+  observers_.AddObserver(observer);
+}
+
+void AppSwapResponsiveLabSession::RemoveObserver(Observer* observer) {
+  observers_.RemoveObserver(observer);
+}
+
+void AppSwapResponsiveLabSession::SetActive(bool active) {
+  if (active_ == active) {
+    return;
+  }
+  active_ = active;
+  for (Observer& observer : observers_) {
+    observer.OnResponsiveLabActiveChanged();
+  }
+}
+
+void AppSwapResponsiveLabSession::SetPreviewedUrl(const GURL& url) {
+  if (previewed_url_ == url) {
+    return;
+  }
+  previewed_url_ = url;
+  for (Observer& observer : observers_) {
+    observer.OnResponsiveLabPreviewedUrlChanged();
+  }
+}
+
+const AppSwapResponsiveLabSession::Viewport*
+AppSwapResponsiveLabSession::FindViewport(const std::string& id) const {
+  for (const Viewport& viewport : viewports_) {
+    if (viewport.preset.id == id) {
+      return &viewport;
+    }
+  }
+  return nullptr;
+}
+
+AppSwapResponsiveLabViewportClient* AppSwapResponsiveLabSession::ClientFor(
+    const std::string& id) {
+  Viewport* viewport = FindViewportMutable(id);
+  return viewport ? viewport->client.get() : nullptr;
+}
+
+AppSwapResponsiveLabSession::Viewport*
+AppSwapResponsiveLabSession::FindViewportMutable(const std::string& id) {
+  for (Viewport& viewport : viewports_) {
+    if (viewport.preset.id == id) {
+      return &viewport;
+    }
+  }
+  return nullptr;
+}
+
+void AppSwapResponsiveLabSession::AddViewport(AppSwapDevicePreset preset) {
+  Viewport viewport;
+  viewport.preset = std::move(preset);
+  viewport.preset.id =
+      base::StrCat({"vp", base::NumberToString(++next_viewport_id_)});
+  viewports_.push_back(std::move(viewport));
+  NotifyViewportsChanged();
+}
+
+void AppSwapResponsiveLabSession::RemoveViewport(const std::string& id) {
+  const size_t erased = std::erase_if(viewports_, [&id](const Viewport& v) {
+    return v.preset.id == id;
+  });
+  if (!erased) {
+    return;
+  }
+  if (focused_viewport_id_ == id) {
+    // Deliberately not moved to a surviving viewport: nothing has been
+    // clicked into, so anything picked here would be a guess, and observers
+    // handle an empty focus already (it is the state a fresh lab starts in).
+    focused_viewport_id_.clear();
+    for (Observer& observer : observers_) {
+      observer.OnResponsiveLabFocusedViewportChanged();
+    }
+  }
+  NotifyViewportsChanged();
+}
+
+void AppSwapResponsiveLabSession::SetFocusedViewport(const std::string& id) {
+  if (focused_viewport_id_ == id || !FindViewport(id)) {
+    return;
+  }
+  focused_viewport_id_ = id;
+  for (Observer& observer : observers_) {
+    observer.OnResponsiveLabFocusedViewportChanged();
+  }
+}
+
+void AppSwapResponsiveLabSession::RequestDevTools() {
+  for (Observer& observer : observers_) {
+    observer.OnResponsiveLabDevToolsRequested();
+  }
+}
+
+void AppSwapResponsiveLabSession::UpdateViewport(const std::string& id,
+                                                 AppSwapDevicePreset preset) {
+  Viewport* viewport = FindViewportMutable(id);
+  if (!viewport) {
+    return;
+  }
+  preset.id = id;
+  viewport->preset = std::move(preset);
+  ApplyEmulation(*viewport);
+  NotifyViewportsChanged();
+}
+
+void AppSwapResponsiveLabSession::RotateViewport(const std::string& id) {
+  Viewport* viewport = FindViewportMutable(id);
+  if (!viewport) {
+    return;
+  }
+  viewport->preset.rotated = !viewport->preset.rotated;
+  ApplyEmulation(*viewport);
+  NotifyViewportsChanged();
+}
+
+void AppSwapResponsiveLabSession::ReloadViewport(const std::string& id) {
+  for (Viewport& viewport : viewports_) {
+    if (!viewport.contents || (!id.empty() && viewport.preset.id != id)) {
+      continue;
+    }
+    viewport.contents->GetController().Reload(content::ReloadType::NORMAL,
+                                              /*check_for_repost=*/false);
+  }
+}
+
+void AppSwapResponsiveLabSession::AttachViewportContents(
+    const std::string& id,
+    content::WebContents* contents) {
+  Viewport* viewport = FindViewportMutable(id);
+  if (!viewport) {
+    return;
+  }
+  viewport->contents = contents;
+  if (inspection_allowed_ && contents) {
+    viewport->client =
+        std::make_unique<AppSwapResponsiveLabViewportClient>(contents);
+  }
+  ApplyEmulation(*viewport);
+  // After the client exists and its emulation is in place: this is what
+  // enables the protocol domains the shared tools need, and re-arms the
+  // picker or re-resolves the selection for a viewport that just appeared.
+  inspector_->OnViewportAttached(id);
+  for (Observer& observer : observers_) {
+    observer.OnResponsiveLabViewportContentsChanged();
+  }
+}
+
+void AppSwapResponsiveLabSession::DetachViewportContents(
+    const std::string& id) {
+  Viewport* viewport = FindViewportMutable(id);
+  if (!viewport) {
+    return;
+  }
+  // Before the client goes: the inspector drops this viewport's node id
+  // and matched rules while it can still tell which viewport they were.
+  inspector_->OnViewportDetached(id);
+  // The client detaches from its agent host in its own destructor; no
+  // ClearEmulation() first, since the WebContents this was emulating is
+  // being destroyed along with its cell.
+  viewport->client.reset();
+  viewport->contents = nullptr;
+  for (Observer& observer : observers_) {
+    observer.OnResponsiveLabViewportContentsChanged();
+  }
+}
+
+void AppSwapResponsiveLabSession::SetCanvasTransform(
+    const gfx::Vector2dF& pan_offset,
+    float scale) {
+  pan_offset_ = pan_offset;
+  if (scale_ == scale) {
+    return;
+  }
+  scale_ = scale;
+
+  // The zoom is part of each viewport's emulation, not something the
+  // compositor applies afterwards, so changing it means re-sending it.
+  for (Viewport& viewport : viewports_) {
+    ApplyEmulation(viewport);
+  }
+  for (Observer& observer : observers_) {
+    observer.OnResponsiveLabCanvasScaleChanged();
+  }
+}
+
+void AppSwapResponsiveLabSession::ResetCanvasTransform() {
+  pan_offset_ = gfx::Vector2dF();
+  scale_ = 1.0f;
+}
+
+base::WeakPtr<AppSwapResponsiveLabSession>
+AppSwapResponsiveLabSession::GetWeakPtr() {
+  return weak_factory_.GetWeakPtr();
+}
+
+void AppSwapResponsiveLabSession::NotifyViewportsChanged() {
+  for (Observer& observer : observers_) {
+    observer.OnResponsiveLabViewportsChanged();
+  }
+}
+
+void AppSwapResponsiveLabSession::ApplyEmulation(Viewport& viewport) {
+  if (viewport.client) {
+    viewport.client->ApplyPreset(viewport.preset, scale_);
+  }
+}
+
+WEB_CONTENTS_USER_DATA_KEY_IMPL(AppSwapResponsiveLabSession);
