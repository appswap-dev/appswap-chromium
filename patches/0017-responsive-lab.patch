diff --git a/chrome/browser/resources/app_swap_responsive_lab/app.css b/chrome/browser/resources/app_swap_responsive_lab/app.css
new file mode 100644
index 0000000000000..2537b4bc6f8c6
--- /dev/null
+++ b/chrome/browser/resources/app_swap_responsive_lab/app.css
@@ -0,0 +1,262 @@
+/* Copyright 2026 The AppSwap Authors
+ * Use of this source code is governed by a BSD-style license that can be
+ * found in the LICENSE file. */
+
+/* #css_wrapper_metadata_start
+ * #type=style-lit
+ * #scheme=relative
+ * #css_wrapper_metadata_end */
+
+/* Colors come from --color-sys-* only: those are the tokens the page shell
+ * actually pulls in (chrome://theme/colors.css). The --cr-* wrappers live in
+ * cr_shared_vars.css, which this page doesn't import, so a --cr-* reference
+ * here would silently fall back to a hardcoded light-theme value. */
+
+:host {
+  box-sizing: border-box;
+  color: var(--color-sys-on-surface);
+  display: flex;
+  flex-direction: column;
+  font-size: 12px;
+  height: 100%;
+  padding: 12px;
+}
+
+.header {
+  flex-shrink: 0;
+}
+
+.title {
+  font-size: 14px;
+  font-weight: 500;
+}
+
+/* The previewed page's URL can be arbitrarily long and the panel is
+   narrow, so it ellipsizes rather than wrapping the panel wider or
+   pushing the content down. Full value is in the title attribute. */
+.url {
+  color: var(--color-sys-on-surface-subtle);
+  margin-top: 2px;
+  overflow: hidden;
+  text-overflow: ellipsis;
+  white-space: nowrap;
+}
+
+.tabs {
+  border-bottom: 1px solid var(--color-sys-divider);
+  display: flex;
+  flex-shrink: 0;
+  gap: 4px;
+  margin-top: 10px;
+}
+
+.tab {
+  background: none;
+  border: none;
+  border-bottom: 2px solid transparent;
+  color: var(--color-sys-on-surface-subtle);
+  cursor: pointer;
+  font: inherit;
+  padding: 6px 8px;
+}
+
+.tab.selected {
+  border-bottom-color: var(--color-sys-primary);
+  color: var(--color-sys-on-surface);
+  font-weight: 500;
+}
+
+.zoom-row {
+  align-items: center;
+  display: flex;
+  flex-shrink: 0;
+  gap: 4px;
+  padding: 8px 0;
+}
+
+.zoom-label {
+  color: var(--color-sys-on-surface-subtle);
+  flex-grow: 1;
+}
+
+.zoom-value {
+  min-width: 40px;
+  text-align: center;
+}
+
+.pick-row {
+  display: flex;
+  flex-shrink: 0;
+  gap: 4px;
+  padding: 8px 0;
+}
+
+/* The picker stays visibly armed while it waits for a click in a cell,
+   which can be several seconds of the user moving between viewports. */
+.chip.active {
+  background: var(--color-sys-primary);
+  color: var(--color-sys-on-primary);
+}
+
+.selector {
+  flex-shrink: 0;
+  font-family: monospace;
+  overflow: hidden;
+  padding-bottom: 6px;
+  text-overflow: ellipsis;
+  white-space: nowrap;
+}
+
+/* Stacked rather than side by side: cr-input carries a label above the
+   field, so a row would leave the button floating against the panel's
+   right edge at a different height than anything it sits beside. */
+.style-row {
+  display: flex;
+  flex-direction: column;
+  flex-shrink: 0;
+  gap: 6px;
+  padding-bottom: 8px;
+}
+
+.style-row .chip {
+  align-self: flex-start;
+}
+
+/* The only part of the panel that scrolls: the header, tabs and footer
+   stay put however long the list below them grows. */
+.scroller {
+  flex-grow: 1;
+  overflow-y: auto;
+}
+
+.card {
+  border: 1px solid var(--color-sys-divider);
+  border-radius: 8px;
+  margin-bottom: 8px;
+  padding: 8px;
+}
+
+/* The cell a DevTools window opened on this lab is currently following. */
+.card.focused {
+  border-color: var(--color-sys-primary);
+}
+
+.card-name {
+  font-weight: 500;
+}
+
+.card-detail {
+  color: var(--color-sys-on-surface-subtle);
+  margin-top: 2px;
+  min-height: 1em;
+}
+
+.size-row {
+  display: flex;
+  gap: 8px;
+  margin-top: 8px;
+}
+
+.card-actions {
+  display: flex;
+  gap: 4px;
+  justify-content: flex-end;
+  margin-top: 8px;
+}
+
+.rule {
+  border-top: 1px solid var(--color-sys-divider);
+  margin-top: 6px;
+  padding-top: 6px;
+}
+
+.rule-media {
+  color: var(--color-sys-primary);
+  font-family: monospace;
+}
+
+.rule-selector {
+  font-family: monospace;
+  font-weight: 500;
+  overflow-wrap: anywhere;
+}
+
+/* User-agent rules are the browser's own defaults. They matter for
+   understanding what applies, but they are never what the user is looking
+   for, so they recede. */
+.rule-selector.muted {
+  color: var(--color-sys-on-surface-subtle);
+  font-weight: normal;
+}
+
+.rule-css {
+  color: var(--color-sys-on-surface-subtle);
+  font-family: monospace;
+  overflow-wrap: anywhere;
+  white-space: pre-wrap;
+}
+
+.log {
+  border-bottom: 1px solid var(--color-sys-divider);
+  display: flex;
+  gap: 6px;
+  padding: 4px 0;
+}
+
+/* Which viewport produced the line is the whole point of a merged log, so
+   the badge is fixed-width and always first. */
+.log-badge {
+  color: var(--color-sys-on-surface-subtle);
+  flex-shrink: 0;
+  width: 56px;
+}
+
+.log-text {
+  overflow-wrap: anywhere;
+  white-space: pre-wrap;
+}
+
+.log.error .log-text {
+  color: var(--color-sys-error);
+}
+
+.log.warning .log-text {
+  color: var(--color-sys-orange);
+}
+
+.empty {
+  color: var(--color-sys-on-surface-subtle);
+  padding: 12px 0;
+}
+
+.footer {
+  display: flex;
+  flex-shrink: 0;
+  gap: 8px;
+  padding-top: 8px;
+}
+
+/* Plain buttons rather than cr-button/cr-icon-button: the shared cr:
+ * iconset has no glyph for reload, rotate or minus, and a narrow panel
+ * with three actions per row reads better as short text than as invented
+ * icons. Same approach the version picker's own rows take. */
+.chip {
+  background: var(--color-sys-surface3);
+  border: none;
+  border-radius: 12px;
+  color: var(--color-sys-on-surface);
+  cursor: pointer;
+  font: inherit;
+  min-width: 24px;
+  padding: 4px 10px;
+}
+
+.chip:hover:not(:disabled) {
+  background: var(--color-sys-state-hover-on-subtle);
+}
+
+.chip:disabled {
+  color: var(--color-sys-on-surface-subtle);
+  cursor: default;
+  opacity: 0.5;
+}
