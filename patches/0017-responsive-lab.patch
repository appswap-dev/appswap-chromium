diff --git a/chrome/browser/ui/webui/app_swap_responsive_lab/app_swap_responsive_lab_panel_bridge.cc b/chrome/browser/ui/webui/app_swap_responsive_lab/app_swap_responsive_lab_panel_bridge.cc
new file mode 100644
index 0000000000000..ca98e17fc39b7
--- /dev/null
+++ b/chrome/browser/ui/webui/app_swap_responsive_lab/app_swap_responsive_lab_panel_bridge.cc
@@ -0,0 +1,66 @@
+// Copyright 2026 The AppSwap Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/webui/app_swap_responsive_lab/app_swap_responsive_lab_panel_bridge.h"
+
+#include <map>
+#include <utility>
+
+#include "base/no_destructor.h"
+#include "base/unguessable_token.h"
+
+namespace {
+
+// Every live panel bridge, by token. Not a WeakPtr map: a bridge registers
+// itself for exactly its own lifetime, so an entry here is always valid.
+std::map<std::string, AppSwapResponsiveLabPanelBridge*>& GetRegistry() {
+  static base::NoDestructor<
+      std::map<std::string, AppSwapResponsiveLabPanelBridge*>>
+      registry;
+  return *registry;
+}
+
+}  // namespace
+
+// static
+AppSwapResponsiveLabPanelBridge* AppSwapResponsiveLabPanelBridge::FromToken(
+    const std::string& token) {
+  auto it = GetRegistry().find(token);
+  return it == GetRegistry().end() ? nullptr : it->second;
+}
+
+AppSwapResponsiveLabPanelBridge::AppSwapResponsiveLabPanelBridge()
+    : token_(base::UnguessableToken::Create().ToString()) {
+  GetRegistry()[token_] = this;
+}
+
+AppSwapResponsiveLabPanelBridge::~AppSwapResponsiveLabPanelBridge() {
+  GetRegistry().erase(token_);
+}
+
+void AppSwapResponsiveLabPanelBridge::SetSession(
+    base::WeakPtr<AppSwapResponsiveLabSession> session) {
+  if (session_.get() == session.get()) {
+    return;
+  }
+  session_ = std::move(session);
+  if (client_) {
+    client_->OnPanelSessionChanged();
+  }
+}
+
+void AppSwapResponsiveLabPanelBridge::SetClient(Client* client) {
+  client_ = client;
+}
+
+void AppSwapResponsiveLabPanelBridge::SetCanvasScale(float scale) {
+  if (set_canvas_scale_callback_) {
+    set_canvas_scale_callback_.Run(scale);
+  }
+}
+
+base::WeakPtr<AppSwapResponsiveLabPanelBridge>
+AppSwapResponsiveLabPanelBridge::GetWeakPtr() {
+  return weak_factory_.GetWeakPtr();
+}
