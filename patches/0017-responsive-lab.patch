+
+import {html} from 'chrome://resources/lit/v3_0/lit.rollup.js';
+
+import type {AppSwapResponsiveLabAppElement} from './app.js';
+
+export function getHtml(this: AppSwapResponsiveLabAppElement) {
+  // clang-format off
+  return html`
+    <div class="header">
+      <div class="title">Responsive Lab</div>
+      <div class="url" title="${this.previewedUrl_}">${this.previewedUrl_}</div>
+    </div>
+
+    <div class="tabs">
+      <button class="tab ${this.isTab_('viewports') ? 'selected' : ''}"
+          data-tab="viewports" @click="${this.onTabClick_}">Viewports</button>
+      <button class="tab ${this.isTab_('inspect') ? 'selected' : ''}"
+          data-tab="inspect" @click="${this.onTabClick_}">Inspect</button>
+      <button class="tab ${this.isTab_('console') ? 'selected' : ''}"
+          data-tab="console" @click="${this.onTabClick_}">Console</button>
+    </div>
+
+    ${this.isTab_('viewports') ? html`
+      <div class="zoom-row">
+        <span class="zoom-label">Canvas</span>
+        <button class="chip" title="Zoom out" ?disabled="${!this.canZoomOut_()}"
+            @click="${this.onZoomOutClick_}">&minus;</button>
+        <span class="zoom-value">${this.zoomPercent_()}</span>
+        <button class="chip" title="Zoom in" ?disabled="${!this.canZoomIn_()}"
+            @click="${this.onZoomInClick_}">+</button>
+      </div>
+
+      <div class="scroller">
+        ${this.viewports_.map(viewport => html`
+          <div class="card ${viewport.focused ? 'focused' : ''}">
+            <div class="card-name">${viewport.preset.name}</div>
+            <div class="card-detail">${this.describe_(viewport)}</div>
+            <div class="size-row">
+              <cr-input type="number" label="Width"
+                  .value="${String(viewport.preset.width)}"
+                  data-id="${viewport.preset.id}"
+                  @change="${this.onWidthChange_}"></cr-input>
+              <cr-input type="number" label="Height"
+                  .value="${String(viewport.preset.height)}"
+                  data-id="${viewport.preset.id}"
+                  @change="${this.onHeightChange_}"></cr-input>
+            </div>
+            <div class="card-actions">
+              <button class="chip" data-id="${viewport.preset.id}"
+                  @click="${this.onRotateClick_}">Rotate</button>
+              <button class="chip" data-id="${viewport.preset.id}"
+                  @click="${this.onReloadClick_}">Reload</button>
+              <button class="chip" data-id="${viewport.preset.id}"
+                  @click="${this.onDevToolsClick_}">DevTools</button>
+              <button class="chip" data-id="${viewport.preset.id}"
+                  @click="${this.onRemoveClick_}">Remove</button>
+            </div>
+          </div>`)}
+      </div>
+
+      <div class="footer">
+        <button class="chip" @click="${this.onAddClick_}">Add viewport</button>
+        <button class="chip" @click="${this.onReloadAllClick_}">Reload all</button>
+      </div>` : ''}
+
+    ${this.isTab_('inspect') ? html`
+      <div class="pick-row">
+        <button class="chip ${this.picking_ ? 'active' : ''}"
+            @click="${this.onPickClick_}">${this.pickLabel_()}</button>
+        ${this.hasSelection_() ? html`
+          <button class="chip"
+              @click="${this.onClearSelectionClick_}">Clear</button>` : ''}
+      </div>
+
+      ${this.hasSelection_() ? html`
+        <div class="selector" title="${this.selector_}">${this.selector_}</div>
+
+        <div class="style-row">
+          <cr-input label="Apply to all viewports"
+              placeholder="color: red; width: 50%"
+              .value="${this.styleDraft_}"
+              @change="${this.onStyleDraftChange_}"></cr-input>
+          <button class="chip"
+              @click="${this.onApplyStyleClick_}">Apply</button>
+        </div>
+
+        <div class="scroller">
+          ${this.rulesByViewport_().map(group => html`
+            <div class="card">
+              <div class="card-name">${group.name}</div>
+              ${group.rules.length === 0 ? html`
+                <div class="card-detail">No match at this width</div>` : ''}
+              ${group.rules.map(rule => html`
+                <div class="rule">
+                  ${rule.media ? html`
+                    <div class="rule-media">@media ${rule.media}</div>` : ''}
+                  <div class="rule-selector ${rule.origin === 'user-agent' ?
+                      'muted' : ''}">${rule.selector}</div>
+                  <div class="rule-css">${rule.cssText}</div>
+                </div>`)}
+            </div>`)}
+        </div>` : html`
+        <div class="empty">
+          Pick an element in any viewport. It is highlighted in all of them,
+          with the CSS that applies at each width.
+        </div>`}` : ''}
+
+    ${this.isTab_('console') ? html`
+      <div class="scroller">
+        ${this.console_.length === 0 ? html`
+          <div class="empty">No output yet.</div>` : ''}
+        ${this.console_.map(entry => html`
+          <div class="log ${entry.level}">
+            <span class="log-badge">${this.viewportName_(entry.viewportId)}</span>
+            <span class="log-text">${entry.text}</span>
+          </div>`)}
+      </div>
+
+      <div class="footer">
+        <button class="chip"
+            @click="${this.onClearConsoleClick_}">Clear</button>
+      </div>` : ''}`;
+  // clang-format on
+}
diff --git a/chrome/browser/resources/app_swap_responsive_lab/app.ts b/chrome/browser/resources/app_swap_responsive_lab/app.ts
new file mode 100644
index 0000000000000..d099e8235303a
--- /dev/null
+++ b/chrome/browser/resources/app_swap_responsive_lab/app.ts
@@ -0,0 +1,313 @@
+// Copyright 2026 The AppSwap Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+import 'chrome://resources/cr_elements/cr_input/cr_input.js';
+
+import {ColorChangeUpdater} from 'chrome://resources/cr_components/color_change_listener/colors_css_updater.js';
+import {CrLitElement} from 'chrome://resources/lit/v3_0/lit.rollup.js';
+
+import {getCss} from './app.css.js';
+import {getHtml} from './app.html.js';
+import type {ConsoleEntryInfo, DevicePreset, MatchedRuleInfo, ViewportInfo} from './app_swap_responsive_lab.mojom-webui.js';
+import type {BrowserProxy} from './browser_proxy.js';
+import {BrowserProxyImpl} from './browser_proxy.js';
+
+// Matches AppSwapResponsiveLabCanvasView::kMinScale/kMaxScale. Duplicated
+// rather than plumbed through Mojo: the canvas clamps authoritatively on
+// every SetCanvasScale() call, so this only decides when to grey out the
+// zoom buttons.
+const MIN_SCALE = 0.25;
+const MAX_SCALE = 1.5;
+const SCALE_STEP = 0.25;
+
+// One viewport's contribution to the Inspect tab: the rules that applied to
+// the selected element there, or nothing if the selector matched no element
+// at that width.
+export interface ViewportRules {
+  id: string;
+  name: string;
+  rules: MatchedRuleInfo[];
+}
+
+export class AppSwapResponsiveLabAppElement extends CrLitElement {
+  static get is() {
+    return 'app-swap-responsive-lab-app';
+  }
+
+  static override get styles() {
+    return getCss();
+  }
+
+  override render() {
+    return getHtml.bind(this)();
+  }
+
+  static override get properties() {
+    return {
+      tab_: {type: String},
+      active_: {type: Boolean},
+      previewedUrl_: {type: String},
+      viewports_: {type: Array},
+      canvasScale_: {type: Number},
+      picking_: {type: Boolean},
+      selector_: {type: String},
+      rules_: {type: Array},
+      styleDraft_: {type: String},
+      console_: {type: Array},
+    };
+  }
+
+  private apiProxy_: BrowserProxy = BrowserProxyImpl.getInstance();
+  protected accessor tab_: string = 'viewports';
+  protected accessor active_: boolean = false;
+  protected accessor previewedUrl_: string = '';
+  protected accessor viewports_: ViewportInfo[] = [];
+  protected accessor canvasScale_: number = 1;
+  protected accessor picking_: boolean = false;
+  protected accessor selector_: string = '';
+  protected accessor rules_: MatchedRuleInfo[] = [];
+  protected accessor styleDraft_: string = '';
+  protected accessor console_: ConsoleEntryInfo[] = [];
+
+  override connectedCallback() {
+    super.connectedCallback();
+
+    // Re-fetches chrome://theme/colors.css when the browser's theme changes.
+    // Without it this page keeps whatever palette it loaded with, so the
+    // panel stays light inside a window that has gone dark. The browser-side
+    // binder is registered for every WebUI already, so starting the listener
+    // is all that's needed.
+    ColorChangeUpdater.forDocument().start();
+
+    const router = this.apiProxy_.callbackRouter;
+    router.onStateChanged.addListener(this.onStateChanged_.bind(this));
+    router.onPickingChanged.addListener((picking: boolean) => {
+      this.picking_ = picking;
+    });
+    router.onSelectionChanged.addListener(
+        (selector: string, rules: MatchedRuleInfo[]) => {
+          this.selector_ = selector;
+          this.rules_ = rules;
+        });
+    router.onConsoleEntry.addListener((entry: ConsoleEntryInfo) => {
+      // A new array rather than a push: Lit compares by identity, and a
+      // mutated array in place would not re-render.
+      this.console_ = [...this.console_, entry];
+    });
+    router.onConsoleCleared.addListener(() => {
+      this.console_ = [];
+    });
+
+    this.apiProxy_.handler.getState().then(
+        ({active, previewedUrl, viewports, canvasScale}) => {
+          this.onStateChanged_(active, previewedUrl, viewports, canvasScale);
+        });
+    this.apiProxy_.handler.getConsole().then(({entries}) => {
+      this.console_ = entries;
+    });
+  }
+
+  private onStateChanged_(
+      active: boolean, previewedUrl: string, viewports: ViewportInfo[],
+      canvasScale: number) {
+    this.active_ = active;
+    this.previewedUrl_ = previewedUrl;
+    this.viewports_ = viewports;
+    this.canvasScale_ = canvasScale;
+  }
+
+  protected onTabClick_(e: Event) {
+    this.tab_ = (e.currentTarget as HTMLElement).dataset['tab']!;
+  }
+
+  protected isTab_(name: string): boolean {
+    return this.tab_ === name;
+  }
+
+  // The one-line summary under each viewport's name: the emulation the
+  // browser is actually applying, so "Desktop" reading differently from
+  // "Mobile" is visible rather than implied.
+  protected describe_(viewport: ViewportInfo): string {
+    const preset = viewport.preset;
+    const parts: string[] = [];
+    if (preset.deviceScaleFactor > 0) {
+      parts.push(`DPR ${preset.deviceScaleFactor}`);
+    }
+    if (preset.mobile) {
+      parts.push('touch');
+    }
+    if (preset.userAgent) {
+      parts.push('custom UA');
+    }
+    if (!viewport.emulated) {
+      parts.push('no emulation');
+    }
+    return parts.join(' · ');
+  }
+
+  protected zoomPercent_(): string {
+    return `${Math.round(this.canvasScale_ * 100)}%`;
+  }
+
+  protected canZoomOut_(): boolean {
+    return this.canvasScale_ > MIN_SCALE;
+  }
+
+  protected canZoomIn_(): boolean {
+    return this.canvasScale_ < MAX_SCALE;
+  }
+
+  protected onZoomOutClick_() {
+    this.setScale_(this.canvasScale_ - SCALE_STEP);
+  }
+
+  protected onZoomInClick_() {
+    this.setScale_(this.canvasScale_ + SCALE_STEP);
+  }
+
+  private setScale_(scale: number) {
+    const clamped = Math.min(MAX_SCALE, Math.max(MIN_SCALE, scale));
+    this.canvasScale_ = clamped;
+    this.apiProxy_.handler.setCanvasScale(clamped);
+  }
+
+  protected onRotateClick_(e: Event) {
+    this.apiProxy_.handler.rotateViewport(this.idFor_(e));
+  }
+
+  protected onReloadClick_(e: Event) {
+    this.apiProxy_.handler.reloadViewport(this.idFor_(e));
+  }
+
+  protected onRemoveClick_(e: Event) {
+    this.apiProxy_.handler.removeViewport(this.idFor_(e));
+  }
+
+  protected onDevToolsClick_(e: Event) {
+    this.apiProxy_.handler.openDevTools(this.idFor_(e));
+  }
+
+  protected onReloadAllClick_() {
+    this.apiProxy_.handler.reloadViewport('');
+  }
+
+  protected onAddClick_() {
+    // A plain desktop-shaped viewport with no emulation, which the user
+    // then edits. Adding something opinionated here would be guessing.
+    const preset: DevicePreset = {
+      id: '',
+      name: 'Custom',
+      width: 1024,
+      height: 768,
+      deviceScaleFactor: 0,
+      mobile: false,
+      userAgent: '',
+      rotated: false,
+    };
+    this.apiProxy_.handler.addViewport(preset);
+  }
+
+  protected onWidthChange_(e: CustomEvent<{value: string}>) {
+    this.resize_(e, Number(e.detail.value), null);
+  }
+
+  protected onHeightChange_(e: CustomEvent<{value: string}>) {
+    this.resize_(e, null, Number(e.detail.value));
+  }
+
+  // Sends the whole preset back with one dimension replaced. Rotation is
+  // applied by the browser at render time rather than baked into
+  // width/height (see AppSwapDevicePreset::EffectiveSize), so the values
+  // shown and edited here are always the device's own portrait numbers.
+  private resize_(e: Event, width: number|null, height: number|null) {
+    const id = this.idFor_(e);
+    const viewport = this.viewports_.find(v => v.preset.id === id);
+    if (!viewport) {
+      return;
+    }
+    const next: DevicePreset = {...viewport.preset};
+    if (width !== null && Number.isFinite(width) && width > 0) {
+      next.width = Math.round(width);
+    }
+    if (height !== null && Number.isFinite(height) && height > 0) {
+      next.height = Math.round(height);
+    }
+    this.apiProxy_.handler.updateViewport(id, next);
+  }
+
+  private idFor_(e: Event): string {
+    return (e.currentTarget as HTMLElement).dataset['id']!;
+  }
+
+  protected onPickClick_() {
+    if (this.picking_) {
+      this.apiProxy_.handler.stopPicking();
+    } else {
+      this.apiProxy_.handler.startPicking();
+    }
+  }
+
+  protected pickLabel_(): string {
+    return this.picking_ ? 'Cancel pick' : 'Pick element';
+  }
+
+  protected hasSelection_(): boolean {
+    return this.selector_ !== '';
+  }
+
+  protected onClearSelectionClick_() {
+    this.styleDraft_ = '';
+    this.apiProxy_.handler.clearSelection();
+  }
+
+  // One entry per viewport, in the order the viewport list is in, so the
+  // Inspect tab reads left-to-right the way the canvas does. Viewports the
+  // selector didn't match still appear, with an empty rule list, because
+  // "this element doesn't exist at this width" is itself the answer the
+  // user is looking for.
+  //
+  // Grouped here rather than in app.html.ts because that file may not
+  // declare helpers or locals of its own
+  // (@webui-eslint/lit-element-template-structure).
+  protected rulesByViewport_(): ViewportRules[] {
+    return this.viewports_.map(viewport => ({
+                                 id: viewport.preset.id,
+                                 name: viewport.preset.name,
+                                 rules: this.rules_.filter(
+                                     rule => rule.viewportId ===
+                                         viewport.preset.id),
+                               }));
+  }
+
+  protected onStyleDraftChange_(e: CustomEvent<{value: string}>) {
+    this.styleDraft_ = e.detail.value;
+  }
+
+  protected onApplyStyleClick_() {
+    if (!this.styleDraft_.trim()) {
+      return;
+    }
+    this.apiProxy_.handler.applyStyleToAll(this.styleDraft_);
+  }
+
+  protected onClearConsoleClick_() {
+    this.apiProxy_.handler.clearConsole();
+  }
+
+  // The viewport's display name for a console entry's badge. Falls back to
+  // the raw id for an entry that outlived the viewport that produced it.
+  protected viewportName_(id: string): string {
+    const viewport = this.viewports_.find(v => v.preset.id === id);
+    return viewport ? viewport.preset.name : id;
+  }
+}
+
+declare global {
+  interface HTMLElementTagNameMap {
+    'app-swap-responsive-lab-app': AppSwapResponsiveLabAppElement;
+  }
+}
+
+customElements.define(
+    AppSwapResponsiveLabAppElement.is, AppSwapResponsiveLabAppElement);
