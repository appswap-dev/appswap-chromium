@@ -0,0 +1,90 @@
+// Copyright 2026 The AppSwap Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_WEBUI_APP_SWAP_RESPONSIVE_LAB_APP_SWAP_RESPONSIVE_LAB_PANEL_BRIDGE_H_
+#define CHROME_BROWSER_UI_WEBUI_APP_SWAP_RESPONSIVE_LAB_APP_SWAP_RESPONSIVE_LAB_PANEL_BRIDGE_H_
+
+#include <string>
+
+#include "base/functional/callback.h"
+#include "base/memory/raw_ptr.h"
+#include "base/memory/weak_ptr.h"
+
+class AppSwapResponsiveLabSession;
+
+// Connects the Responsive Lab panel's WebUI page to whichever tab's lab the
+// panel is currently displaying.
+//
+// A content::WebUIController is built generically by the framework from a
+// URL alone, so a page that belongs to one specific piece of browser UI has
+// to be told which one via a token in its URL. That much is the same
+// pattern AppSwapVersionPickerContext already uses.
+//
+// What differs, and is the reason this is a long-lived bridge rather than a
+// one-shot registry entry, is that the panel is one per content slot rather
+// than one per tab -- exactly like AppSwapResponsiveLabOverlayView, which
+// owns it. The tab it is showing changes every time the user switches tabs.
+// Consuming a token once at construction would bind the page to whichever
+// tab happened to be active when it loaded; instead the overlay pushes each
+// new session in through SetSession(), and the page handler (the Client
+// below) re-points itself and tells the page. That is what lets a tab
+// switch re-aim the panel without reloading it.
+class AppSwapResponsiveLabPanelBridge {
+ public:
+  // Implemented by the live page handler, if there is one. There is at most
+  // one: the panel hosts a single WebUI page.
+  class Client {
+   public:
+    virtual void OnPanelSessionChanged() = 0;
+
+   protected:
+    virtual ~Client() = default;
+  };
+
+  // Returns the bridge registered under `token`, or null if the token is
+  // unknown (a stale URL, or a panel whose overlay has since been torn
+  // down).
+  static AppSwapResponsiveLabPanelBridge* FromToken(const std::string& token);
+
+  AppSwapResponsiveLabPanelBridge();
+  AppSwapResponsiveLabPanelBridge(const AppSwapResponsiveLabPanelBridge&) =
+      delete;
+  AppSwapResponsiveLabPanelBridge& operator=(
+      const AppSwapResponsiveLabPanelBridge&) = delete;
+  ~AppSwapResponsiveLabPanelBridge();
+
+  // Embed this in the panel page's URL query string.
+  const std::string& token() const { return token_; }
+
+  // Points the panel at a different tab's lab, or at nothing (a null
+  // `session`) while the overlay is showing no grid at all.
+  void SetSession(base::WeakPtr<AppSwapResponsiveLabSession> session);
+  AppSwapResponsiveLabSession* session() { return session_.get(); }
+
+  // Set by the page handler for its own lifetime, cleared in its
+  // destructor. Null whenever no panel page is loaded.
+  void SetClient(Client* client);
+
+  // Set by the overlay: applies an absolute zoom to the live canvas, which
+  // the session itself can't reach (it only remembers the transform across
+  // detach/reattach, see AppSwapResponsiveLabSession::SetCanvasTransform).
+  // Null while the overlay has no canvas content attached.
+  void set_set_canvas_scale_callback(
+      base::RepeatingCallback<void(float)> callback) {
+    set_canvas_scale_callback_ = std::move(callback);
+  }
+  void SetCanvasScale(float scale);
+
+  base::WeakPtr<AppSwapResponsiveLabPanelBridge> GetWeakPtr();
+
+ private:
+  const std::string token_;
+  base::WeakPtr<AppSwapResponsiveLabSession> session_;
+  raw_ptr<Client> client_ = nullptr;
+  base::RepeatingCallback<void(float)> set_canvas_scale_callback_;
+
+  base::WeakPtrFactory<AppSwapResponsiveLabPanelBridge> weak_factory_{this};
+};
+
+#endif  // CHROME_BROWSER_UI_WEBUI_APP_SWAP_RESPONSIVE_LAB_APP_SWAP_RESPONSIVE_LAB_PANEL_BRIDGE_H_
