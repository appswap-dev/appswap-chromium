--- /dev/null
+++ b/chrome/browser/ui/webui/app_swap_responsive_lab/app_swap_responsive_lab_page_handler.cc
@@ -0,0 +1,366 @@
+// Copyright 2026 The AppSwap Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/webui/app_swap_responsive_lab/app_swap_responsive_lab_page_handler.h"
+
+#include <utility>
+#include <vector>
+
+#include "chrome/browser/app_swap/app_swap_responsive_lab_types.h"
+
+namespace mojom = app_swap_responsive_lab::mojom;
+
+namespace {
+
+mojom::DevicePresetPtr ToMojo(const AppSwapDevicePreset& preset) {
+  auto out = mojom::DevicePreset::New();
+  out->id = preset.id;
+  out->name = preset.name;
+  out->width = preset.width;
+  out->height = preset.height;
+  out->device_scale_factor = preset.device_scale_factor;
+  out->mobile = preset.mobile;
+  out->user_agent = preset.user_agent;
+  out->rotated = preset.rotated;
+  return out;
+}
+
+AppSwapDevicePreset FromMojo(const mojom::DevicePreset& preset) {
+  AppSwapDevicePreset out;
+  out.id = preset.id;
+  out.name = preset.name;
+  out.width = preset.width;
+  out.height = preset.height;
+  out.device_scale_factor = static_cast<float>(preset.device_scale_factor);
+  out.mobile = preset.mobile;
+  out.user_agent = preset.user_agent;
+  out.rotated = preset.rotated;
+  return out;
+}
+
+mojom::MatchedRuleInfoPtr ToMojo(
+    const AppSwapResponsiveLabInspector::MatchedRule& rule) {
+  auto out = mojom::MatchedRuleInfo::New();
+  out->viewport_id = rule.viewport_id;
+  out->selector = rule.selector;
+  out->css_text = rule.css_text;
+  out->origin = rule.origin;
+  out->media = rule.media;
+  return out;
+}
+
+mojom::ConsoleEntryInfoPtr ToMojo(
+    const AppSwapResponsiveLabInspector::ConsoleEntry& entry) {
+  auto out = mojom::ConsoleEntryInfo::New();
+  out->viewport_id = entry.viewport_id;
+  out->level = entry.level;
+  out->text = entry.text;
+  out->url = entry.url;
+  out->line = entry.line;
+  return out;
+}
+
+std::vector<mojom::ViewportInfoPtr> ToMojo(
+    const std::vector<AppSwapResponsiveLabSession::Viewport>& viewports,
+    const std::string& focused_viewport_id) {
+  std::vector<mojom::ViewportInfoPtr> out;
+  out.reserve(viewports.size());
+  for (const AppSwapResponsiveLabSession::Viewport& viewport : viewports) {
+    auto info = mojom::ViewportInfo::New();
+    info->preset = ToMojo(viewport.preset);
+    info->emulated = viewport.client && viewport.client->attached();
+    info->focused = viewport.preset.id == focused_viewport_id;
+    out.push_back(std::move(info));
+  }
+  return out;
+}
+
+}  // namespace
+
+AppSwapResponsiveLabPageHandler::AppSwapResponsiveLabPageHandler(
+    mojo::PendingRemote<mojom::Page> page,
+    mojo::PendingReceiver<mojom::PageHandler> handler,
+    base::WeakPtr<AppSwapResponsiveLabPanelBridge> bridge)
+    : bridge_(std::move(bridge)),
+      page_(std::move(page)),
+      receiver_(this, std::move(handler)) {
+  if (bridge_) {
+    bridge_->SetClient(this);
+  }
+  ObserveCurrentSession();
+}
+
+AppSwapResponsiveLabPageHandler::~AppSwapResponsiveLabPageHandler() {
+  if (bridge_) {
+    bridge_->SetClient(nullptr);
+  }
+}
+
+void AppSwapResponsiveLabPageHandler::GetState(GetStateCallback callback) {
+  AppSwapResponsiveLabSession* current = session();
+  if (!current) {
+    std::move(callback).Run(/*active=*/false, /*previewed_url=*/std::string(),
+                            std::vector<mojom::ViewportInfoPtr>(),
+                            /*canvas_scale=*/1.0);
+    return;
+  }
+  std::move(callback).Run(
+      current->active(), current->previewed_url().spec(),
+      ToMojo(current->viewports(), current->focused_viewport_id()),
+      current->scale());
+}
+
+void AppSwapResponsiveLabPageHandler::AddViewport(
+    mojom::DevicePresetPtr preset,
+    AddViewportCallback callback) {
+  if (AppSwapResponsiveLabSession* current = session()) {
+    current->AddViewport(FromMojo(*preset));
+  }
+  std::move(callback).Run();
+}
+
+void AppSwapResponsiveLabPageHandler::RemoveViewport(
+    const std::string& id,
+    RemoveViewportCallback callback) {
+  if (AppSwapResponsiveLabSession* current = session()) {
+    current->RemoveViewport(id);
+  }
+  std::move(callback).Run();
+}
+
+void AppSwapResponsiveLabPageHandler::UpdateViewport(
+    const std::string& id,
+    mojom::DevicePresetPtr preset,
+    UpdateViewportCallback callback) {
+  if (AppSwapResponsiveLabSession* current = session()) {
+    current->UpdateViewport(id, FromMojo(*preset));
+  }
+  std::move(callback).Run();
+}
+
+void AppSwapResponsiveLabPageHandler::RotateViewport(
+    const std::string& id,
+    RotateViewportCallback callback) {
+  if (AppSwapResponsiveLabSession* current = session()) {
+    current->RotateViewport(id);
+  }
+  std::move(callback).Run();
+}
+
+void AppSwapResponsiveLabPageHandler::OpenDevTools(
+    const std::string& id,
+    OpenDevToolsCallback callback) {
+  if (AppSwapResponsiveLabSession* current = session()) {
+    // Focus first, so the window that opens is already pointed at the cell
+    // whose button was pressed rather than at whatever was focused before.
+    if (!id.empty()) {
+      current->SetFocusedViewport(id);
+    }
+    current->RequestDevTools();
+  }
+  std::move(callback).Run();
+}
+
+void AppSwapResponsiveLabPageHandler::ReloadViewport(
+    const std::string& id,
+    ReloadViewportCallback callback) {
+  if (AppSwapResponsiveLabSession* current = session()) {
+    current->ReloadViewport(id);
+  }
+  std::move(callback).Run();
+}
+
+void AppSwapResponsiveLabPageHandler::SetCanvasScale(
+    double scale,
+    SetCanvasScaleCallback callback) {
+  if (bridge_) {
+    bridge_->SetCanvasScale(static_cast<float>(scale));
+  }
+  std::move(callback).Run();
+}
+
+void AppSwapResponsiveLabPageHandler::StartPicking(
+    StartPickingCallback callback) {
+  if (AppSwapResponsiveLabInspector* current = inspector()) {
+    current->StartPicking();
+  }
+  std::move(callback).Run();
+}
+
+void AppSwapResponsiveLabPageHandler::StopPicking(
+    StopPickingCallback callback) {
+  if (AppSwapResponsiveLabInspector* current = inspector()) {
+    current->StopPicking();
+  }
+  std::move(callback).Run();
+}
+
+void AppSwapResponsiveLabPageHandler::ClearSelection(
+    ClearSelectionCallback callback) {
+  if (AppSwapResponsiveLabInspector* current = inspector()) {
+    current->ClearSelection();
+  }
+  std::move(callback).Run();
+}
+
+void AppSwapResponsiveLabPageHandler::ApplyStyleToAll(
+    const std::string& declarations,
+    ApplyStyleToAllCallback callback) {
+  if (AppSwapResponsiveLabInspector* current = inspector()) {
+    current->ApplyStyleToAll(declarations);
+  }
+  std::move(callback).Run();
+}
+
+void AppSwapResponsiveLabPageHandler::GetConsole(GetConsoleCallback callback) {
+  std::vector<mojom::ConsoleEntryInfoPtr> entries;
+  if (AppSwapResponsiveLabInspector* current = inspector()) {
+    for (const AppSwapResponsiveLabInspector::ConsoleEntry& entry :
+         current->console()) {
+      entries.push_back(ToMojo(entry));
+    }
+    console_sent_ = current->console().size();
+  }
+  std::move(callback).Run(std::move(entries));
+}
+
+void AppSwapResponsiveLabPageHandler::ClearConsole(
+    ClearConsoleCallback callback) {
+  if (AppSwapResponsiveLabInspector* current = inspector()) {
+    current->ClearConsole();
+  }
+  std::move(callback).Run();
+}
+
+void AppSwapResponsiveLabPageHandler::OnPanelSessionChanged() {
+  ObserveCurrentSession();
+  PushState();
+  PushPicking();
+  PushSelection();
+  // The new session has its own log, and the page is about to rebuild from
+  // it, so nothing has been sent for it yet.
+  console_sent_ = 0;
+  page_->OnConsoleCleared();
+}
+
+void AppSwapResponsiveLabPageHandler::OnResponsiveLabFocusedViewportChanged() {
+  // Clicking into a cell is not something the panel initiated, so this is
+  // the only way its focus marker follows the grid.
+  PushState();
+}
+
+void AppSwapResponsiveLabPageHandler::OnResponsiveLabCanvasScaleChanged() {
+  // Ctrl+Wheel over the canvas changes the zoom without going through this
+  // handler, so the panel's readout only follows if the session says so.
+  PushState();
+}
+
+void AppSwapResponsiveLabPageHandler::OnInspectorPickingChanged() {
+  PushPicking();
+}
+
+void AppSwapResponsiveLabPageHandler::OnInspectorSelectionChanged() {
+  PushSelection();
+}
+
+void AppSwapResponsiveLabPageHandler::OnInspectorConsoleChanged() {
+  AppSwapResponsiveLabInspector* current = inspector();
+  if (!current) {
+    return;
+  }
+  const auto& entries = current->console();
+  // A shrink means the log was cleared or trimmed at the front, so the
+  // count the page has is no longer an index into anything.
+  if (entries.size() < console_sent_) {
+    console_sent_ = 0;
+    page_->OnConsoleCleared();
+  }
+  for (size_t i = console_sent_; i < entries.size(); ++i) {
+    page_->OnConsoleEntry(ToMojo(entries[i]));
+  }
+  console_sent_ = entries.size();
+}
+
+void AppSwapResponsiveLabPageHandler::OnResponsiveLabViewportsChanged() {
+  PushState();
+}
+
+void AppSwapResponsiveLabPageHandler::OnResponsiveLabActiveChanged() {
+  PushState();
+}
+
+void AppSwapResponsiveLabPageHandler::OnResponsiveLabPreviewedUrlChanged() {
+  // The URL is part of the state the panel shows in its header.
+  PushState();
+}
+
+void AppSwapResponsiveLabPageHandler::OnResponsiveLabSessionDestroying() {
+  // The tab this panel was showing is closing. Stop observing first, then
+  // push: by the time the bridge's WeakPtr is cleared the session is gone,
+  // and the panel should be showing an empty state rather than the last
+  // list it saw. The inspector goes with the session, so it is dropped
+  // here too.
+  session_observation_.Reset();
+  inspector_observation_.Reset();
+  console_sent_ = 0;
+  page_->OnPickingChanged(false);
+  page_->OnSelectionChanged(std::string(),
+                            std::vector<mojom::MatchedRuleInfoPtr>());
+  page_->OnConsoleCleared();
+  page_->OnStateChanged(/*active=*/false, /*previewed_url=*/std::string(),
+                        std::vector<mojom::ViewportInfoPtr>(),
+                        /*canvas_scale=*/1.0);
+}
+
+AppSwapResponsiveLabSession* AppSwapResponsiveLabPageHandler::session() {
+  return bridge_ ? bridge_->session() : nullptr;
+}
+
+AppSwapResponsiveLabInspector* AppSwapResponsiveLabPageHandler::inspector() {
+  AppSwapResponsiveLabSession* current = session();
+  return current ? current->inspector() : nullptr;
+}
+
+void AppSwapResponsiveLabPageHandler::ObserveCurrentSession() {
+  session_observation_.Reset();
+  inspector_observation_.Reset();
+  if (AppSwapResponsiveLabSession* current = session()) {
+    session_observation_.Observe(current);
+    inspector_observation_.Observe(current->inspector());
+  }
+}
+
+void AppSwapResponsiveLabPageHandler::PushPicking() {
+  AppSwapResponsiveLabInspector* current = inspector();
+  page_->OnPickingChanged(current && current->picking());
+}
+
+void AppSwapResponsiveLabPageHandler::PushSelection() {
+  AppSwapResponsiveLabInspector* current = inspector();
+  if (!current) {
+    page_->OnSelectionChanged(std::string(),
+                              std::vector<mojom::MatchedRuleInfoPtr>());
+    return;
+  }
+  std::vector<mojom::MatchedRuleInfoPtr> rules;
+  for (const AppSwapResponsiveLabInspector::MatchedRule& rule :
+       current->matched_rules()) {
+    rules.push_back(ToMojo(rule));
+  }
+  page_->OnSelectionChanged(current->selected_selector(), std::move(rules));
+}
+
+void AppSwapResponsiveLabPageHandler::PushState() {
+  AppSwapResponsiveLabSession* current = session();
+  if (!current) {
+    page_->OnStateChanged(/*active=*/false, /*previewed_url=*/std::string(),
+                          std::vector<mojom::ViewportInfoPtr>(),
+                          /*canvas_scale=*/1.0);
+    return;
+  }
+  page_->OnStateChanged(
+      current->active(), current->previewed_url().spec(),
+      ToMojo(current->viewports(), current->focused_viewport_id()),
+      current->scale());
+}
