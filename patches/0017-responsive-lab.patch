index 0000000000000..13569fbf10885
--- /dev/null
+++ b/chrome/browser/app_swap/app_swap_responsive_lab_session.h
@@ -0,0 +1,241 @@
+// Copyright 2026 The AppSwap Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_APP_SWAP_APP_SWAP_RESPONSIVE_LAB_SESSION_H_
+#define CHROME_BROWSER_APP_SWAP_APP_SWAP_RESPONSIVE_LAB_SESSION_H_
+
+#include <memory>
+#include <string>
+#include <vector>
+
+#include "base/memory/raw_ptr.h"
+#include "base/memory/weak_ptr.h"
+#include "base/observer_list.h"
+#include "base/observer_list_types.h"
+#include "chrome/browser/app_swap/app_swap_responsive_lab_types.h"
+#include "chrome/browser/app_swap/app_swap_responsive_lab_viewport_client.h"
+#include "content/public/browser/web_contents_user_data.h"
+#include "ui/gfx/geometry/vector2d_f.h"
+#include "url/gurl.h"
+
+class AppSwapResponsiveLabInspector;
+
+namespace content {
+class WebContents;
+}  // namespace content
+
+// One tab's Responsive Lab state: whether the lab is on, which page it is
+// previewing, the list of viewports it is previewing that page in, each
+// viewport's CDP client, and the canvas pan/zoom.
+//
+// Replaces the old AppSwapResponsiveLabTabHelper, which held a single bool.
+// A bool was enough while the viewport list was a hardcoded function inside
+// the toolbar button and the grid was built once and never mutated. It is
+// not enough now: the panel needs to add, remove, resize and rotate
+// viewports, and both the grid and the panel need to observe the same
+// model rather than each holding their own copy.
+//
+// Stays Views-agnostic, like its sibling tab helpers, so the Mojo page
+// handler in //chrome/browser/ui/webui can talk to it directly. The grid's
+// views::View tree and the WebContents inside it are owned by the Views
+// layer (see AppSwapResponsiveLabGridHolder and
+// AppSwapResponsiveLabCellView); this class holds only non-owning pointers
+// to those WebContents, which each cell registers on construction and
+// clears on destruction via AttachViewportContents()/
+// DetachViewportContents(). That split is deliberate: a views::WebView must
+// create its own WebContents for it to paint at all here (see
+// AppSwapResponsiveLabOverlayView's class comment), so this class cannot be
+// their owner.
+class AppSwapResponsiveLabSession
+    : public content::WebContentsUserData<AppSwapResponsiveLabSession> {
+ public:
+  // One viewport: its device definition, the live cell rendering it (null
+  // while the lab is off or the tab is in the background), and that cell's
+  // protocol client.
+  struct Viewport {
+    Viewport();
+    Viewport(Viewport&&);
+    Viewport& operator=(Viewport&&);
+    ~Viewport();
+
+    AppSwapDevicePreset preset;
+    raw_ptr<content::WebContents> contents = nullptr;
+    std::unique_ptr<AppSwapResponsiveLabViewportClient> client;
+  };
+
+  class Observer : public base::CheckedObserver {
+   public:
+    // A viewport was added, removed, or had its preset edited. Observers
+    // re-read viewports() rather than being handed a delta -- the list is
+    // short and both observers (the grid and the panel) reconcile against
+    // it wholesale anyway.
+    virtual void OnResponsiveLabViewportsChanged() {}
+
+    // The lab was toggled on or off.
+    virtual void OnResponsiveLabActiveChanged() {}
+
+    // The page the lab is previewing changed -- the user navigated the
+    // host tab, typically from the address bar. Separate from
+    // OnResponsiveLabActiveChanged() because the cells have to re-navigate
+    // to follow it, which a mere toggle never asks for.
+    virtual void OnResponsiveLabPreviewedUrlChanged() {}
+
+    // The canvas zoom changed. Fired only when the *scale* changes, not on
+    // every pan frame, so an observer can afford to re-read whatever it
+    // needs here.
+    virtual void OnResponsiveLabCanvasScaleChanged() {}
+
+    // A viewport gained or lost its live cell -- the lab was toggled, or
+    // its tab was switched away from and back. Distinct from
+    // OnResponsiveLabViewportsChanged(), which is about the *list*: this
+    // fires while the list is unchanged, and, because it fires from inside
+    // cell construction, an observer of it must not rebuild the grid.
+    virtual void OnResponsiveLabViewportContentsChanged() {}
+
+    // A different viewport became the focused one. Separate from
+    // OnResponsiveLabViewportsChanged() because this fires on every click
+    // into a cell, while the viewport list changes only when the user adds
+    // or removes one.
+    virtual void OnResponsiveLabFocusedViewportChanged() {}
+
+    // The user asked for DevTools on the focused viewport. A signal rather
+    // than a call, because opening a DevTools window means reaching
+    // //chrome/browser/devtools, which this target deliberately does not
+    // depend on (see inspection_allowed()) -- the Views layer listens for
+    // this and does the opening. That is also what lets the panel, which
+    // is further from //chrome/browser/ui still, ask for it.
+    virtual void OnResponsiveLabDevToolsRequested() {}
+
+    // This session is going away. Observers must stop observing here.
+    //
+    // Not merely defensive: both observers outlive this object in a real
+    // teardown order. AppSwapResponsiveLabGridHolder is a separate
+    // WebContentsUserData on the same tab, and the order two user-data
+    // objects are destroyed in is unspecified -- so a detached grid view
+    // can still be observing when this is destroyed. The panel's page
+    // handler belongs to the browser window rather than the tab, and
+    // outlives every session it ever points at.
+    virtual void OnResponsiveLabSessionDestroying() {}
+  };
+
+  ~AppSwapResponsiveLabSession() override;
+
+  AppSwapResponsiveLabSession(const AppSwapResponsiveLabSession&) = delete;
+  AppSwapResponsiveLabSession& operator=(const AppSwapResponsiveLabSession&) =
+      delete;
+
+  // The viewport list a session starts with. Moved here from an anonymous
+  // namespace inside AppSwapResponsiveLabButton, which is the wrong owner
+  // now that the list is per-tab mutable state rather than a constant.
+  static std::vector<AppSwapDevicePreset> DefaultPresets();
+
+  void AddObserver(Observer* observer);
+  void RemoveObserver(Observer* observer);
+
+  bool active() const { return active_; }
+  void SetActive(bool active);
+
+  const GURL& previewed_url() const { return previewed_url_; }
+  void SetPreviewedUrl(const GURL& url);
+
+  // False when enterprise policy forbids developer tools for this profile
+  // or page (see DevToolsWindow::AllowDevToolsFor, which the Views layer
+  // evaluates and pushes down here -- this target deliberately does not
+  // depend on //chrome/browser/devtools). Viewports still render; they
+  // just get no emulation and no protocol client.
+  bool inspection_allowed() const { return inspection_allowed_; }
+  void set_inspection_allowed(bool allowed) { inspection_allowed_ = allowed; }
+
+  const std::vector<Viewport>& viewports() const { return viewports_; }
+  const Viewport* FindViewport(const std::string& id) const;
+
+  // The viewport whose cell the user last clicked into, which is what a
+  // DevTools window opened on this lab follows. Empty until something takes
+  // focus, and reset to empty when the focused viewport is removed.
+  const std::string& focused_viewport_id() const {
+    return focused_viewport_id_;
+  }
+  // No-op for an unknown id, and for the id that is already focused --
+  // cells report focus on every click, not only on a change.
+  void SetFocusedViewport(const std::string& id);
+
+  // Asks whoever is listening to open DevTools on the focused viewport.
+  void RequestDevTools();
+
+  // The protocol client for one viewport, or null when that viewport has
+  // no live cell or policy denied inspection. This is how
+  // AppSwapResponsiveLabInspector reaches the clients it fans commands out
+  // across; nothing else should need it.
+  AppSwapResponsiveLabViewportClient* ClientFor(const std::string& id);
+
+  // Never null. Owns everything that acts on the viewports together: the
+  // shared element picker, cross-viewport style edits, and the merged
+  // console.
+  AppSwapResponsiveLabInspector* inspector() { return inspector_.get(); }
+
+  // `preset.id` is assigned here; whatever the caller put there is ignored.
+  void AddViewport(AppSwapDevicePreset preset);
+  void RemoveViewport(const std::string& id);
+  // Replaces everything about the viewport except its id.
+  void UpdateViewport(const std::string& id, AppSwapDevicePreset preset);
+  void RotateViewport(const std::string& id);
+  // An empty `id` reloads every viewport.
+  void ReloadViewport(const std::string& id);
+
+  // Called by each cell view as it comes and goes. Attaching creates the
+  // viewport's protocol client and applies its preset's emulation;
+  // detaching tears the client down.
+  void AttachViewportContents(const std::string& id,
+                              content::WebContents* contents);
+  void DetachViewportContents(const std::string& id);
+
+  // Canvas pan/zoom, remembered here rather than in the Views layer so the
+  // panel can read and drive it without reaching into views:: -- see
+  // AppSwapResponsiveLabCanvasView, which still owns the live transform
+  // and hands its state back here whenever it is detached.
+  const gfx::Vector2dF& pan_offset() const { return pan_offset_; }
+  float scale() const { return scale_; }
+  void SetCanvasTransform(const gfx::Vector2dF& pan_offset, float scale);
+
+  // Forgets the canvas transform, so an explicit toggle-off followed by a
+  // later toggle-on starts centered rather than resuming wherever the user
+  // last left a canvas they have since dismissed. Deliberately does NOT
+  // discard the viewport list: once the panel can edit that list, it is
+  // the user's own configuration for this tab, not scratch state.
+  void ResetCanvasTransform();
+
+  base::WeakPtr<AppSwapResponsiveLabSession> GetWeakPtr();
+
+ private:
+  friend class content::WebContentsUserData<AppSwapResponsiveLabSession>;
+  explicit AppSwapResponsiveLabSession(content::WebContents* web_contents);
+
+  Viewport* FindViewportMutable(const std::string& id);
+  void NotifyViewportsChanged();
+
+  // Applies `viewport`'s preset to its client, if it currently has one.
+  void ApplyEmulation(Viewport& viewport);
+
+  bool active_ = false;
+  bool inspection_allowed_ = true;
+  GURL previewed_url_;
+  std::vector<Viewport> viewports_;
+  std::string focused_viewport_id_;
+  int next_viewport_id_ = 0;
+
+  gfx::Vector2dF pan_offset_;
+  float scale_ = 1.0f;
+
+  // Declared after viewports_ so it is destroyed before them: it holds no
+  // owning reference to their clients, but its weak-pointer callbacks are
+  // simpler to reason about when it cannot outlive what it points into.
+  std::unique_ptr<AppSwapResponsiveLabInspector> inspector_;
+
+  base::ObserverList<Observer> observers_;
+  base::WeakPtrFactory<AppSwapResponsiveLabSession> weak_factory_{this};
+
+  WEB_CONTENTS_USER_DATA_KEY_DECL();
+};
+
+#endif  // CHROME_BROWSER_APP_SWAP_APP_SWAP_RESPONSIVE_LAB_SESSION_H_
