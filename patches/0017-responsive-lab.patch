@@ -0,0 +1,92 @@
+// Copyright 2026 The AppSwap Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_VIEWS_APP_SWAP_APP_SWAP_RESPONSIVE_LAB_GRID_HOLDER_H_
+#define CHROME_BROWSER_UI_VIEWS_APP_SWAP_APP_SWAP_RESPONSIVE_LAB_GRID_HOLDER_H_
+
+#include <memory>
+#include <vector>
+
+#include "chrome/browser/ui/views/app_swap/app_swap_responsive_lab_overlay_view.h"
+#include "content/public/browser/web_contents_user_data.h"
+#include "ui/gfx/geometry/vector2d_f.h"
+
+class GURL;
+class Profile;
+
+namespace views {
+class View;
+}  // namespace views
+
+// Owns one tab's Responsive Lab grid content (a views::View holding one
+// views::WebView per device preset) across tab switches. This is the piece
+// that AppSwapResponsiveLabTabHelper (chrome/browser/app_swap/, deliberately
+// Views-agnostic like its sibling tab helpers) can't own itself -- hence a
+// second, Views-layer WebContentsUserData rather than adding a views::View
+// member to that one.
+//
+// AppSwapResponsiveLabOverlayView is one-per-content-slot, not one-per-tab
+// (see its own class comment), so it can't hold each tab's grid as a member
+// either; it borrows this class's grid_view_ for as long as this tab is the
+// one being displayed (TakeOrBuildGridView()) and hands it back the moment
+// another tab needs the slot (PutBackGridView()) -- which is what lets
+// switching away and back show the *same* grid instead of a freshly
+// reloaded one.
+class AppSwapResponsiveLabGridHolder
+    : public content::WebContentsUserData<AppSwapResponsiveLabGridHolder> {
+ public:
+  ~AppSwapResponsiveLabGridHolder() override;
+
+  AppSwapResponsiveLabGridHolder(const AppSwapResponsiveLabGridHolder&) =
+      delete;
+  AppSwapResponsiveLabGridHolder& operator=(
+      const AppSwapResponsiveLabGridHolder&) = delete;
+
+  // Returns this tab's grid content view: the one already held (from a
+  // previous PutBackGridView()) if there is one, or a freshly built one
+  // (one views::WebView per preset, each navigated to `url`) otherwise.
+  // Ownership transfers to the caller; this class holds nothing in between
+  // a Take and its matching PutBack.
+  std::unique_ptr<views::View> TakeOrBuildGridView(
+      Profile* profile,
+      const GURL& url,
+      std::vector<AppSwapResponsiveLabOverlayView::DevicePreset> presets);
+
+  // Called when this tab is switched away from (or the browser is closing)
+  // while its grid is still live -- keeps it (and every WebView/WebContents
+  // in it) alive, detached, for a possible later reactivation.
+  void PutBackGridView(std::unique_ptr<views::View> grid_view);
+
+  // Discards any held grid view -- called on an explicit toggle-off (as
+  // opposed to merely switching tabs away from an active grid), so the
+  // extra renderer processes it holds don't linger once the user has
+  // actually turned Responsive Lab off for this tab. Also resets the
+  // remembered pan/zoom, so a later reactivation starts fresh rather than
+  // resuming wherever the user last left the (now-discarded) canvas.
+  void Discard();
+
+  // The canvas pan/zoom this tab's grid was left at, remembered across
+  // detach/reattach the same way the grid view itself is -- so switching
+  // away and back doesn't just avoid reloading the grid, it also leaves
+  // the viewport exactly where the user left it. Defaults (0 pan, 1x
+  // scale) for a tab that's never had a grid built yet.
+  gfx::Vector2dF pan_offset() const { return pan_offset_; }
+  float scale() const { return scale_; }
+  void SetViewport(const gfx::Vector2dF& pan_offset, float scale) {
+    pan_offset_ = pan_offset;
+    scale_ = scale;
+  }
+
+ private:
+  friend class content::WebContentsUserData<AppSwapResponsiveLabGridHolder>;
+  explicit AppSwapResponsiveLabGridHolder(content::WebContents* web_contents);
+
+  std::unique_ptr<views::View> grid_view_;
+  gfx::Vector2dF pan_offset_;
+  float scale_ = 1.0f;
+
+  WEB_CONTENTS_USER_DATA_KEY_DECL();
+};
+
+#endif  // CHROME_BROWSER_UI_VIEWS_APP_SWAP_APP_SWAP_RESPONSIVE_LAB_GRID_HOLDER_H_
