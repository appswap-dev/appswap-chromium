@@ -0,0 +1,87 @@
+// Copyright 2026 The AppSwap Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_VIEWS_APP_SWAP_APP_SWAP_RESPONSIVE_LAB_MINIMAP_VIEW_H_
+#define CHROME_BROWSER_UI_VIEWS_APP_SWAP_APP_SWAP_RESPONSIVE_LAB_MINIMAP_VIEW_H_
+
+#include <vector>
+
+#include "base/memory/raw_ptr.h"
+#include "ui/gfx/geometry/rect.h"
+#include "ui/base/metadata/metadata_header_macros.h"
+#include "ui/gfx/geometry/point.h"
+#include "ui/gfx/geometry/vector2d_f.h"
+#include "ui/views/view.h"
+
+class AppSwapResponsiveLabCanvasView;
+
+// A small, fixed-size overview panel anchored to the bottom-right corner of
+// AppSwapResponsiveLabOverlayView, showing the full extent of the current
+// tab's grid content (a plain outline -- this doesn't attempt a live
+// pixel-accurate thumbnail of the WebViews inside it, since ui::Layer::
+// Mirror() only mirrors a layer's own painted/surface content and
+// explicitly does not mirror children, which is all the grid content
+// actually has) plus a highlighted rectangle showing the portion of it
+// AppSwapResponsiveLabCanvasView currently has in view. Clicking or
+// dragging inside the panel re-centers the canvas's viewport on that point
+// (via AppSwapResponsiveLabCanvasView::CenterOn()), so it doubles as a
+// jump-navigation control for a canvas that's otherwise only pannable by
+// dragging its (potentially much larger) content around.
+//
+// One-per-content-slot, same as the overlay and canvas view it lives
+// beside -- Refresh() re-reads whatever the canvas is currently showing
+// each time it's called, rather than tracking any tab-specific state of
+// its own.
+class AppSwapResponsiveLabMinimapView : public views::View {
+  METADATA_HEADER(AppSwapResponsiveLabMinimapView, views::View)
+
+ public:
+  // `canvas` is the sibling view this minimap always tracks -- both are
+  // constructed once by the overlay and destroyed together, so a raw,
+  // non-owning pointer held for this view's whole lifetime is safe.
+  explicit AppSwapResponsiveLabMinimapView(AppSwapResponsiveLabCanvasView* canvas);
+  AppSwapResponsiveLabMinimapView(const AppSwapResponsiveLabMinimapView&) =
+      delete;
+  AppSwapResponsiveLabMinimapView& operator=(
+      const AppSwapResponsiveLabMinimapView&) = delete;
+  ~AppSwapResponsiveLabMinimapView() override;
+
+  // Recomputes the content outline and viewport indicator from the canvas's
+  // current content size and visible rect. Hides this view entirely when
+  // the canvas has no content to show. Call whenever the canvas's content,
+  // pan, or zoom changes.
+  void Refresh();
+
+  // views::View:
+  void OnPaint(gfx::Canvas* canvas) override;
+
+  // views::View:
+  bool OnMousePressed(const ui::MouseEvent& event) override;
+  bool OnMouseDragged(const ui::MouseEvent& event) override;
+
+ private:
+  // Converts a point in this view's own local coordinates to a point in
+  // the canvas content's (unscaled) local space, using the same fit
+  // mapping Refresh() just computed, and re-centers the canvas there.
+  void JumpTo(const gfx::Point& minimap_local_point);
+
+  const raw_ptr<AppSwapResponsiveLabCanvasView> canvas_;
+
+  // One rect per grid cell, already in this view's own coordinates.
+  // Painted rather than held as child views: they are non-interactive and
+  // their count changes whenever a viewport is added or removed, so a view
+  // per cell would mean reconciling a child list to draw three rectangles.
+  std::vector<gfx::Rect> cell_rects_;
+
+  raw_ptr<views::View> viewport_indicator_ = nullptr;
+
+  // The "fit content into this panel's inner area" mapping Refresh() last
+  // computed -- content-local point p maps to fit_offset_ + p * fit_scale_
+  // in this view's local space. Used both to place the outline/indicator
+  // and, inverted, by JumpTo() to map a click back to a content point.
+  float fit_scale_ = 1.0f;
+  gfx::Vector2dF fit_offset_;
+};
+
+#endif  // CHROME_BROWSER_UI_VIEWS_APP_SWAP_APP_SWAP_RESPONSIVE_LAB_MINIMAP_VIEW_H_
diff --git a/chrome/browser/ui/views/app_swap/app_swap_responsive_lab_overlay_view.cc b/chrome/browser/ui/views/app_swap/app_swap_responsive_lab_overlay_view.cc
new file mode 100644
index 0000000000000..b441f70426504
--- /dev/null
+++ b/chrome/browser/ui/views/app_swap/app_swap_responsive_lab_overlay_view.cc
@@ -0,0 +1,336 @@
+// Copyright 2026 The AppSwap Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/views/app_swap/app_swap_responsive_lab_overlay_view.h"
+
+#include <memory>
+#include <utility>
+
+#include <algorithm>
+
+#include "base/functional/bind.h"
+#include "base/strings/strcat.h"
+#include "chrome/browser/app_swap/app_swap_responsive_lab_session.h"
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/browser/ui/views/app_swap/app_swap_responsive_lab_canvas_view.h"
+#include "chrome/browser/ui/views/app_swap/app_swap_responsive_lab_grid_holder.h"
+#include "chrome/browser/ui/views/app_swap/app_swap_responsive_lab_minimap_view.h"
+#include "chrome/browser/ui/webui/app_swap_responsive_lab/app_swap_responsive_lab_panel_bridge.h"
+#include "content/public/browser/web_contents.h"
+#include "ui/base/metadata/metadata_impl_macros.h"
+#include "ui/color/color_id.h"
+#include "ui/gfx/geometry/rect.h"
+#include "ui/views/background.h"
+#include "ui/views/controls/resize_area.h"
+#include "ui/views/controls/webview/webview.h"
+#include "ui/views/widget/widget.h"
+#include "url/gurl.h"
+
+#if defined(USE_AURA)
+#include "chrome/browser/ui/views/app_swap/app_swap_responsive_lab_wheel_interceptor_aura.h"
+#include "ui/aura/window.h"
+#endif
+#if BUILDFLAG(IS_MAC)
+#include "chrome/browser/ui/views/app_swap/app_swap_responsive_lab_wheel_observer_mac.h"
+#endif
+
+namespace {
+
+constexpr int kMinimapMargin = 16;
+
+// The panel's docked width, and the range the splitter can drag it to.
+// Below the minimum the viewport rows stop being readable; above the
+// maximum the canvas stops fitting a desktop-width cell, which is the
+// whole point of the lab.
+constexpr int kDefaultPanelWidth = 280;
+constexpr int kMinPanelWidth = 200;
+constexpr int kMaxPanelWidth = 480;
+
+// What the canvas keeps for itself when the overlay is too narrow to give
+// the panel its full width. Below this the panel wins nothing useful and
+// the canvas stops showing a viewport at all.
+constexpr int kMinCanvasWidth = 240;
+
+// Width of the invisible drag strip between canvas and panel. Matches what
+// views::ResizeArea-based splitters elsewhere in the browser use.
+constexpr int kResizeAreaWidth = 8;
+
+}  // namespace
+
+AppSwapResponsiveLabOverlayView::AppSwapResponsiveLabOverlayView()
+    : panel_width_(kDefaultPanelWidth) {
+  SetVisible(false);
+  SetBackground(views::CreateSolidBackground(ui::kColorSysBaseContainer));
+
+  // No LayoutManager here -- canvas_view_ fills this view's own bounds and
+  // minimap_view_ is anchored to a corner of it, which Layout(PassKey)
+  // below positions directly rather than through a declarative manager.
+  canvas_view_ = AddChildView(std::make_unique<AppSwapResponsiveLabCanvasView>());
+  canvas_view_->set_change_callback(base::BindRepeating(
+      &AppSwapResponsiveLabOverlayView::OnCanvasChanged,
+      base::Unretained(this)));
+
+  // Constructed after canvas_view_ so it paints on top -- see
+  // AppSwapResponsiveLabCanvasView's own constructor comment for why
+  // canvas_view_ (not this view) is the one given a layer to make that
+  // ordering actually stick against the grid's WebView layers.
+  minimap_view_ = AddChildView(
+      std::make_unique<AppSwapResponsiveLabMinimapView>(canvas_view_));
+}
+
+AppSwapResponsiveLabOverlayView::~AppSwapResponsiveLabOverlayView() {
+  // minimap_view_ holds a non-owning raw_ptr to canvas_view_ (see
+  // AppSwapResponsiveLabMinimapView's own comment). views::View::~View()
+  // destroys children_ in add order, which would destroy canvas_view_
+  // (added first) before minimap_view_ (added second) -- leaving that
+  // raw_ptr dangling for the remainder of minimap_view_'s own destruction,
+  // which is exactly what MiraclePtr's dangling-pointer detector caught
+  // during window teardown. Destroying minimap_view_ explicitly here,
+  // before the base class destructor runs, keeps canvas_view_ alive for
+  // minimap_view_'s entire lifetime instead.
+  //
+  // A first attempt at this cleared minimap_view_ *after* calling
+  // RemoveChildViewT(minimap_view_.get()) -- which doesn't work, because
+  // that call's return value (the freed object's now-sole owning
+  // unique_ptr) isn't captured, so it's destroyed at the end of that same
+  // statement: the object is already gone before the next line runs.
+  // MiraclePtr still caught it. Saving a plain (non-raw_ptr) pointer
+  // first, clearing minimap_view_ *before* triggering destruction, then
+  // destroying via the plain pointer is what actually closes the gap: no
+  // raw_ptr is watching that address at the moment it's freed.
+  if (minimap_view_) {
+    AppSwapResponsiveLabMinimapView* minimap = minimap_view_.get();
+    minimap_view_ = nullptr;
+    RemoveChildViewT(minimap);
+  }
+}
+
+void AppSwapResponsiveLabOverlayView::ShowGridFor(
+    content::WebContents* web_contents,
+    Profile* profile) {
+  if (current_owner_ == web_contents) {
+    SetVisible(true);
+    return;
+  }
+
+  // Hands the previous owner's grid (and pan/zoom) back to its own holder
+  // and session internally, so there's nothing further to do with it here.
+  DetachCurrent();
+
+  EnsurePanel(profile);
+
+  AppSwapResponsiveLabSession* session =
+      AppSwapResponsiveLabSession::GetOrCreateForWebContents(web_contents);
+  AppSwapResponsiveLabGridHolder* holder =
+      AppSwapResponsiveLabGridHolder::GetOrCreateForWebContents(web_contents);
+  canvas_view_->SetContent(holder->TakeOrBuildGridView(profile, session),
+                           session->pan_offset(), session->scale());
+
+  // Re-aims the already-loaded panel page at this tab rather than
+  // navigating it again -- see AppSwapResponsiveLabPanelBridge.
+  panel_bridge_->SetSession(session->GetWeakPtr());
+
+  current_owner_ = web_contents;
+  Observe(web_contents);
+  SetVisible(true);
+}
+
+void AppSwapResponsiveLabOverlayView::EnsurePanel(Profile* profile) {
+  if (panel_web_view_) {
+    return;
+  }
+
+  panel_bridge_ = std::make_unique<AppSwapResponsiveLabPanelBridge>();
+  panel_bridge_->set_set_canvas_scale_callback(base::BindRepeating(
+      [](AppSwapResponsiveLabCanvasView* canvas, float scale) {
+        canvas->SetScale(scale);
+      },
+      base::Unretained(canvas_view_.get())));
+
+  panel_resize_area_ =
+      AddChildView(std::make_unique<views::ResizeArea>(this));
+
+  auto panel = std::make_unique<views::WebView>(profile);
+  panel->LoadInitialURL(GURL(
+      base::StrCat({"chrome://appswap-responsive-lab/?token=",
+                    panel_bridge_->token()})));
+  panel_web_view_ = AddChildView(std::move(panel));
+}
+
+void AppSwapResponsiveLabOverlayView::HideCurrent() {
+  DetachCurrent();
+  SetVisible(false);
+}
+
+void AppSwapResponsiveLabOverlayView::DiscardPanel() {
+  if (!panel_web_view_) {
+    return;
+  }
+
+  // Cleared before the views are destroyed, not after: a raw_ptr still
+  // watching an address at the moment it's freed is what MiraclePtr's
+  // dangling detector fires on -- the same trap this class's destructor
+  // documents for minimap_view_.
+  RemoveChildViewT(panel_web_view_.ExtractAsDangling());
+  RemoveChildViewT(panel_resize_area_.ExtractAsDangling());
+
+  // Last: destroying the WebView above destroys the page handler, whose
+  // destructor clears itself off this bridge.
+  panel_bridge_.reset();
+  InvalidateLayout();
+}
+
+void AppSwapResponsiveLabOverlayView::DetachCurrent() {
+  if (!current_owner_) {
+    return;
+  }
+
+  AppSwapResponsiveLabGridHolder* holder =
+      AppSwapResponsiveLabGridHolder::FromWebContents(current_owner_);
+  AppSwapResponsiveLabSession* session =
+      AppSwapResponsiveLabSession::FromWebContents(current_owner_);
+  AppSwapResponsiveLabCanvasView::DetachResult detached =
+      canvas_view_->DetachContent();
+  if (session) {
+    session->SetCanvasTransform(detached.pan_offset, detached.scale);
+  }
+  if (holder && detached.content) {
+    holder->PutBackGridView(std::move(detached.content));
+  }
+  // If the holder is already gone (shouldn't normally happen -- it and
+  // this view's observation of current_owner_ are torn down together via
+  // WebContentsDestroyed() -- but kept as a safe fallback), detached.content
+  // simply goes out of scope and its WebViews/WebContents are destroyed.
+
+  current_owner_ = nullptr;
+  Observe(nullptr);
+  if (panel_bridge_) {
+    panel_bridge_->SetSession(nullptr);
+  }
+}
+
+void AppSwapResponsiveLabOverlayView::OnCanvasChanged() {
+  minimap_view_->Refresh();
+
+  // Mirror the live canvas transform onto the session on every change, not
+  // just when the grid is detached: the panel reads its zoom from there,
+  // and a value that only caught up on a tab switch would show the panel a
+  // stale percentage for the entire time the user was looking at it.
+  if (current_owner_) {
+    if (AppSwapResponsiveLabSession* session =
+            AppSwapResponsiveLabSession::FromWebContents(current_owner_)) {
+      session->SetCanvasTransform(canvas_view_->pan_offset(),
+                                  canvas_view_->scale());
+    }
+  }
+}
+
+void AppSwapResponsiveLabOverlayView::WebContentsDestroyed() {
+  // The tab whose grid we're currently showing is being destroyed. Detach
+  // without trying to hand the grid back to its holder -- that
+  // WebContentsUserData is being torn down along with the WebContents
+  // itself, so there's nothing to hand it to; just let it go.
+  current_owner_ = nullptr;
+  Observe(nullptr);
+  canvas_view_->DetachContent();  // dropped -- see comment above
+  if (panel_bridge_) {
+    panel_bridge_->SetSession(nullptr);
+  }
+  SetVisible(false);
+}
+
+void AppSwapResponsiveLabOverlayView::OnBoundsChanged(
+    const gfx::Rect& previous_bounds) {
+  views::View::OnBoundsChanged(previous_bounds);
+}
+
+void AppSwapResponsiveLabOverlayView::Layout(PassKey) {
+  const gfx::Rect local_bounds = GetLocalBounds();
+
+  // Canvas, splitter, panel, left to right. Until the panel exists the
+  // canvas simply gets everything, which is also what happens if the
+  // overlay is ever laid out narrower than the panel's own minimum.
+  gfx::Rect canvas_bounds = local_bounds;
+  if (panel_web_view_) {
+    const int panel_width = std::min(
+        panel_width_, std::max(0, local_bounds.width() - kResizeAreaWidth -
+                                      kMinCanvasWidth));
+    canvas_bounds.set_width(local_bounds.width() - panel_width -
+                            kResizeAreaWidth);
+    panel_resize_area_->SetBounds(canvas_bounds.right(), local_bounds.y(),
+                                  kResizeAreaWidth, local_bounds.height());
+    panel_web_view_->SetBounds(canvas_bounds.right() + kResizeAreaWidth,
+                               local_bounds.y(), panel_width,
+                               local_bounds.height());
+  }
+  canvas_view_->SetBoundsRect(canvas_bounds);
+
+  // Anchored inside the canvas, not the overlay, so the panel never covers
+  // it and it never floats over the splitter.
+  const gfx::Size minimap_size = minimap_view_->GetPreferredSize();
+  minimap_view_->SetBoundsRect(gfx::Rect(
+      canvas_bounds.right() - minimap_size.width() - kMinimapMargin,
+      canvas_bounds.bottom() - minimap_size.height() - kMinimapMargin,
+      minimap_size.width(), minimap_size.height()));
+
+  minimap_view_->Refresh();
+}
+
+void AppSwapResponsiveLabOverlayView::OnResize(int resize_amount,
+                                               bool done_resizing) {
+  if (panel_width_at_drag_start_ == 0) {
+    panel_width_at_drag_start_ = panel_width_;
+  }
+  // Dragging the splitter left (a negative amount) widens the panel, since
+  // the panel is the right-hand pane.
+  panel_width_ = std::clamp(panel_width_at_drag_start_ - resize_amount,
+                            kMinPanelWidth, kMaxPanelWidth);
+  if (done_resizing) {
+    panel_width_at_drag_start_ = 0;
+  }
+  InvalidateLayout();
+}
+
+void AppSwapResponsiveLabOverlayView::AddedToWidget() {
+#if defined(USE_AURA)
+  // Registered on the whole browser window, not just this view's own
+  // bounds -- a pre-target handler has no narrower attachment point, and
+  // its own early-out checks (not a Ctrl+Wheel event, or outside
+  // canvas_view_'s bounds) keep it a no-op for everything else. See
+  // AppSwapResponsiveLabWheelInterceptorAura's class comment for why this
+  // exists at all.
+  if (aura::Window* window = GetWidget()->GetNativeView()) {
+    wheel_interceptor_ =
+        std::make_unique<AppSwapResponsiveLabWheelInterceptorAura>(
+            canvas_view_);
+    window->AddPreTargetHandler(wheel_interceptor_.get());
+  }
+#endif
+#if BUILDFLAG(IS_MAC)
+  // See AppSwapResponsiveLabWheelObserverMac's own comment for why this
+  // exists (the Aura pre-target handler above has no macOS equivalent) and
+  // its accepted trade-off versus that Aura version. Its constructor reads
+  // GetWidget() itself, so it must be constructed here, after this view is
+  // actually attached to one.
+  wheel_observer_mac_ =
+      std::make_unique<AppSwapResponsiveLabWheelObserverMac>(canvas_view_);
+#endif
+}
+
+void AppSwapResponsiveLabOverlayView::RemovedFromWidget() {
+#if defined(USE_AURA)
+  if (wheel_interceptor_) {
+    if (aura::Window* window = GetWidget()->GetNativeView()) {
+      window->RemovePreTargetHandler(wheel_interceptor_.get());
+    }
+    wheel_interceptor_.reset();
+  }
+#endif
+#if BUILDFLAG(IS_MAC)
+  wheel_observer_mac_.reset();
+#endif
+}
+
+BEGIN_METADATA(AppSwapResponsiveLabOverlayView)
+END_METADATA
diff --git a/chrome/browser/ui/views/app_swap/app_swap_responsive_lab_overlay_view.h b/chrome/browser/ui/views/app_swap/app_swap_responsive_lab_overlay_view.h
