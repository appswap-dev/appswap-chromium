@@ -0,0 +1,99 @@
+// Copyright 2026 The AppSwap Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_VIEWS_APP_SWAP_APP_SWAP_RESPONSIVE_LAB_BUTTON_H_
+#define CHROME_BROWSER_UI_VIEWS_APP_SWAP_APP_SWAP_RESPONSIVE_LAB_BUTTON_H_
+
+#include "base/memory/raw_ptr.h"
+#include "chrome/browser/ui/tabs/tab_change_type.h"
+#include "chrome/browser/ui/tabs/tab_strip_model_observer.h"
+#include "chrome/browser/ui/views/toolbar/toolbar_button.h"
+#include "ui/base/metadata/metadata_header_macros.h"
+
+class AppSwapResponsiveLabOverlayView;
+class BrowserWindowInterface;
+class ContentsContainerView;
+class TabStripModel;
+
+namespace content {
+class WebContents;
+}  // namespace content
+
+namespace tabs {
+class TabInterface;
+}  // namespace tabs
+
+// A toolbar-row toggle button, next to Home/Split-tabs: pressing it replaces
+// the active tab's own content view with a grid of several real viewports
+// of that same page, one per device preset -- see
+// AppSwapResponsiveLabSession (the per-tab viewport model) and
+// AppSwapResponsiveLabOverlayView (renders them, hosted alongside
+// ContentsWebView in ContentsContainerView). ToolbarButton (rather than a
+// plain ImageButton) is what SplitTabsToolbarButton and HomeButton use for
+// this same toolbar row, and gives this button the same hover/ink-drop/theme
+// handling as its neighbors for free.
+//
+// Lives here (rather than in //chrome/browser/ui/views/app_swap, where its
+// sibling AppSwap buttons live) for the same reason
+// AppSwapProjectSelectorButton does -- see that file's own comment: this
+// button needs BrowserView::GetContentsContainerViewFor(), which only exists
+// inside this target, and this target depends ON views/app_swap, not the
+// other way around, so pulling this button into views/app_swap instead
+// would be a circular dependency.
+//
+// Toggling is per-tab state (AppSwapResponsiveLabSession is a
+// WebContentsUserData), but the actual overlay/ContentsWebView visibility
+// this button drives lives one level up, in whichever ContentsContainerView
+// currently shows the active tab -- so both a toggle click and an active-tab
+// change need to re-sync that container to match the (possibly new) active
+// tab's own helper state. See SyncContentsContainer().
+class AppSwapResponsiveLabButton : public ToolbarButton,
+                                   public TabStripModelObserver {
+  METADATA_HEADER(AppSwapResponsiveLabButton, ToolbarButton)
+
+ public:
+  explicit AppSwapResponsiveLabButton(BrowserWindowInterface* browser);
+  AppSwapResponsiveLabButton(const AppSwapResponsiveLabButton&) = delete;
+  AppSwapResponsiveLabButton& operator=(const AppSwapResponsiveLabButton&) =
+      delete;
+  ~AppSwapResponsiveLabButton() override;
+
+  // TabStripModelObserver:
+  void OnTabStripModelChanged(
+      TabStripModel* tab_strip_model,
+      const TabStripModelChange& change,
+      const TabStripSelectionChange& selection) override;
+  void OnTabChangedAt(tabs::TabInterface* tab,
+                      TabChangeType change_type) override;
+
+ private:
+  void ButtonPressed();
+
+  // Recomputes this button's own visibility/active-visual state from the
+  // active tab's own AppSwapResponsiveLabSession, and re-syncs the
+  // container showing that tab to match.
+  void UpdateForActiveTab();
+
+  // Toggles this button's own "currently active" visual treatment -- a
+  // filled background, the same technique AppSwapRouteGroupTabStripButton
+  // uses for its own badge, simplified to a plain on/off state here.
+  void SetActiveVisual(bool active);
+
+  // Shows/hides `web_contents`'s ContentsWebView vs. its
+  // AppSwapResponsiveLabOverlayView (pointing the overlay at the tab's
+  // session first, if activating). No-op if `web_contents` isn't
+  // currently shown by any ContentsContainerView (e.g. a background tab).
+  void SyncContentsContainer(content::WebContents* web_contents, bool active);
+
+  // The container currently showing `web_contents`, and that container's
+  // Responsive Lab overlay. Null when `web_contents` isn't on screen (a
+  // background tab), which every caller treats as "nothing to do".
+  ContentsContainerView* ContainerFor(content::WebContents* web_contents);
+  AppSwapResponsiveLabOverlayView* OverlayFor(
+      content::WebContents* web_contents);
+
+  raw_ptr<BrowserWindowInterface> browser_;
+};
+
+#endif  // CHROME_BROWSER_UI_VIEWS_APP_SWAP_APP_SWAP_RESPONSIVE_LAB_BUTTON_H_
diff --git a/chrome/browser/ui/views/app_swap/app_swap_responsive_lab_canvas_view.cc b/chrome/browser/ui/views/app_swap/app_swap_responsive_lab_canvas_view.cc
new file mode 100644
index 0000000000000..73d57f1d5a78a
--- /dev/null
+++ b/chrome/browser/ui/views/app_swap/app_swap_responsive_lab_canvas_view.cc
@@ -0,0 +1,227 @@
+// Copyright 2026 The AppSwap Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/views/app_swap/app_swap_responsive_lab_canvas_view.h"
+
+#include <algorithm>
+#include <utility>
+
+#include "base/numerics/safe_conversions.h"
+#include "ui/base/metadata/metadata_impl_macros.h"
+#include "ui/color/color_id.h"
+#include "ui/compositor/layer.h"
+#include "ui/events/event.h"
+#include "ui/gfx/geometry/vector2d.h"
+#include "ui/views/background.h"
+
+AppSwapResponsiveLabCanvasView::DetachResult::DetachResult() = default;
+AppSwapResponsiveLabCanvasView::DetachResult::DetachResult(DetachResult&&) =
+    default;
+AppSwapResponsiveLabCanvasView::DetachResult&
+AppSwapResponsiveLabCanvasView::DetachResult::operator=(DetachResult&&) =
+    default;
+AppSwapResponsiveLabCanvasView::DetachResult::~DetachResult() = default;
+
+AppSwapResponsiveLabCanvasView::AppSwapResponsiveLabCanvasView() {
+  // The actual root cause of the browser-window-wide positioning glitch
+  // (grid content painting over the toolbar, "cropped" at the window's
+  // right/bottom edges) turned out to be neither of the two layer-ordering
+  // theories tried earlier: debug logging showed the overlay and this
+  // view's own bounds were correct throughout. The real issue is that
+  // content_ (the grid) legitimately extends outside this view's bounds
+  // the moment it's panned/zoomed -- that's inherent to how zoom-toward-a-
+  // point works (pan_offset_ goes negative to keep the zoomed point fixed
+  // under the cursor) -- and nothing was ever clipping that overflow to
+  // this view's own visible area, so at high zoom the scaled content's
+  // edges paint wherever their transformed position lands, including
+  // above this view's top edge and into the toolbar.
+  //
+  // A layer with SetMasksToBounds() is what actually fixes that (a plain,
+  // non-layered View doesn't clip WebView-hosted native content the way it
+  // clips its own painting), and it happens to *also* be the same
+  // mechanism needed to keep AppSwapResponsiveLabMinimapView's own layer
+  // stacking above the grid's WebView layers -- see the class comment on
+  // why a layer belongs here rather than on the parent overlay (whose
+  // bounds are set externally, precisely, by ContentsContainerView).
+  SetPaintToLayer();
+  layer()->SetMasksToBounds(true);
+
+  // Once this view paints to its own layer, it's a separate compositing
+  // surface -- the overlay's own background (painted into a different
+  // layer) no longer shows through wherever content_ doesn't cover, since
+  // this view never paints anything of its own there. Panning/zooming
+  // constantly changes how much of this view's area content_ covers, so
+  // without an explicit background here that empty area would show
+  // whatever undefined content the compositor happens to have, not a
+  // deliberate canvas color.
+  // kColorSysBaseContainer, not kColorWindowBackground: the latter is the
+  // same near-white the previewed pages themselves are, so a cell was
+  // separated from the board behind it only by its hairline border. This
+  // token is a tinted container -- light grey under a light theme, a dark
+  // tint of the theme's own hue under a dark one -- so the cells read as
+  // cards laid on a surface. AppSwapResponsiveLabGridView paints the same
+  // color, since the row covers most of this view whenever it is on screen.
+  SetBackground(views::CreateSolidBackground(ui::kColorSysBaseContainer));
+}
+AppSwapResponsiveLabCanvasView::~AppSwapResponsiveLabCanvasView() = default;
+
+AppSwapResponsiveLabGridView* AppSwapResponsiveLabCanvasView::SetContent(
+    std::unique_ptr<AppSwapResponsiveLabGridView> content,
+    const gfx::Vector2dF& pan_offset,
+    float scale) {
+  content_ = AddChildView(std::move(content));
+  pan_offset_ = pan_offset;
+  scale_ = std::clamp(scale, kMinScale, kMaxScale);
+  ApplyScale();
+  ApplyPan();
+  NotifyChanged();
+  return content_;
+}
+
+AppSwapResponsiveLabCanvasView::DetachResult
+AppSwapResponsiveLabCanvasView::DetachContent() {
+  DetachResult result;
+  result.pan_offset = pan_offset_;
+  result.scale = scale_;
+  if (content_) {
+    result.content = RemoveChildViewT(content_.get());
+    content_ = nullptr;
+  }
+  NotifyChanged();
+  return result;
+}
+
+gfx::Size AppSwapResponsiveLabCanvasView::ContentPreferredSize() const {
+  // The grid's size at 100%, not the size it is currently laid out at:
+  // this view's whole coordinate vocabulary (VisibleContentRect(),
+  // CenterOn(), and so the minimap) is unscaled content space.
+  return content_ ? content_->UnscaledPreferredSize() : gfx::Size();
+}
+
+std::vector<gfx::Rect> AppSwapResponsiveLabCanvasView::ContentCellRects()
+    const {
+  return content_ ? content_->UnscaledCellBounds() : std::vector<gfx::Rect>();
+}
+
+gfx::RectF AppSwapResponsiveLabCanvasView::VisibleContentRect() const {
+  if (!content_ || scale_ <= 0) {
+    return gfx::RectF();
+  }
+  return gfx::RectF(-pan_offset_.x() / scale_, -pan_offset_.y() / scale_,
+                    width() / scale_, height() / scale_);
+}
+
+void AppSwapResponsiveLabCanvasView::CenterOn(
+    const gfx::PointF& content_point) {
+  if (!content_) {
+    return;
+  }
+  SetPanOffset(gfx::Vector2dF(width() / 2.0f - content_point.x() * scale_,
+                              height() / 2.0f - content_point.y() * scale_));
+}
+
+void AppSwapResponsiveLabCanvasView::SetScale(float scale) {
+  ZoomBy(std::clamp(scale, kMinScale, kMaxScale) - scale_,
+         gfx::PointF(width() / 2.0f, height() / 2.0f));
+}
+
+bool AppSwapResponsiveLabCanvasView::OnMousePressed(
+    const ui::MouseEvent& event) {
+  if (!content_ || !event.IsOnlyLeftMouseButton()) {
+    return false;
+  }
+  dragging_ = true;
+  drag_start_location_ = event.location();
+  drag_start_pan_offset_ = pan_offset_;
+  return true;
+}
+
+bool AppSwapResponsiveLabCanvasView::OnMouseDragged(
+    const ui::MouseEvent& event) {
+  if (!dragging_) {
+    return false;
+  }
+  const gfx::Vector2d delta = event.location() - drag_start_location_;
+  SetPanOffset(drag_start_pan_offset_ +
+              gfx::Vector2dF(delta.x(), delta.y()));
+  return true;
+}
+
+void AppSwapResponsiveLabCanvasView::OnMouseReleased(
+    const ui::MouseEvent& event) {
+  dragging_ = false;
+}
+
+bool AppSwapResponsiveLabCanvasView::OnMouseWheel(
+    const ui::MouseWheelEvent& event) {
+  if (!content_) {
+    return false;
+  }
+  if (event.IsControlDown()) {
+    // Scaled by the actual offset, not just its sign, so a fast/hard
+    // scroll (or a bigger trackpad pinch, which arrives as a larger wheel
+    // delta) zooms faster than a small one -- kWheelDelta is the size of
+    // one "notch" of a standard wheel, so this reads as "kZoomStepPerNotch
+    // of zoom per notch scrolled, proportionally for partial/larger deltas".
+    constexpr float kZoomStepPerNotch = 0.1f;
+    const float delta_scale = (static_cast<float>(event.y_offset()) /
+                               ui::MouseWheelEvent::kWheelDelta) *
+                              kZoomStepPerNotch;
+    ZoomBy(delta_scale, gfx::PointF(event.location()));
+  } else {
+    SetPanOffset(pan_offset_ + gfx::Vector2dF(event.x_offset() / 4.0f,
+                                              event.y_offset() / 4.0f));
+  }
+  return true;
+}
+
+void AppSwapResponsiveLabCanvasView::SetPanOffset(
+    const gfx::Vector2dF& pan_offset) {
+  pan_offset_ = pan_offset;
+  ApplyPan();
+  NotifyChanged();
+}
+
+void AppSwapResponsiveLabCanvasView::ZoomBy(float delta_scale,
+                                            const gfx::PointF& anchor) {
+  const float new_scale = std::clamp(scale_ + delta_scale, kMinScale, kMaxScale);
+  if (new_scale == scale_) {
+    return;
+  }
+  // Keep the content point currently under `anchor` fixed on screen.
+  const gfx::PointF content_point((anchor.x() - pan_offset_.x()) / scale_,
+                                  (anchor.y() - pan_offset_.y()) / scale_);
+  scale_ = new_scale;
+  pan_offset_ = gfx::Vector2dF(anchor.x() - content_point.x() * scale_,
+                               anchor.y() - content_point.y() * scale_);
+  // Scale first: it resizes the grid, and the pan below positions that new
+  // size. Doing it the other way round leaves one frame at the old size in
+  // the new place.
+  ApplyScale();
+  ApplyPan();
+  NotifyChanged();
+}
+
+void AppSwapResponsiveLabCanvasView::ApplyPan() {
+  if (!content_) {
+    return;
+  }
+  content_->SetPosition(gfx::Point(base::ClampRound(pan_offset_.x()),
+                                   base::ClampRound(pan_offset_.y())));
+}
+
+void AppSwapResponsiveLabCanvasView::ApplyScale() {
+  if (content_) {
+    content_->SetScale(scale_);
+  }
+}
+
+void AppSwapResponsiveLabCanvasView::NotifyChanged() {
+  if (change_callback_) {
+    change_callback_.Run();
+  }
+}
+
+BEGIN_METADATA(AppSwapResponsiveLabCanvasView)
+END_METADATA
diff --git a/chrome/browser/ui/views/app_swap/app_swap_responsive_lab_canvas_view.h b/chrome/browser/ui/views/app_swap/app_swap_responsive_lab_canvas_view.h
new file mode 100644
index 0000000000000..89b505ea60255
--- /dev/null
+++ b/chrome/browser/ui/views/app_swap/app_swap_responsive_lab_canvas_view.h
@@ -0,0 +1,174 @@
+// Copyright 2026 The AppSwap Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_VIEWS_APP_SWAP_APP_SWAP_RESPONSIVE_LAB_CANVAS_VIEW_H_
+#define CHROME_BROWSER_UI_VIEWS_APP_SWAP_APP_SWAP_RESPONSIVE_LAB_CANVAS_VIEW_H_
+
+#include <memory>
+#include <vector>
+
+#include "base/functional/callback.h"
+#include "base/memory/raw_ptr.h"
+#include "chrome/browser/ui/views/app_swap/app_swap_responsive_lab_grid_view.h"
+#include "ui/base/metadata/metadata_header_macros.h"
+#include "ui/gfx/geometry/point.h"
+#include "ui/gfx/geometry/point_f.h"
+#include "ui/gfx/geometry/rect.h"
+#include "ui/gfx/geometry/rect_f.h"
+#include "ui/gfx/geometry/size.h"
+#include "ui/gfx/geometry/vector2d_f.h"
+#include "ui/views/view.h"
+
+// A pannable, zoomable host for one tab's Responsive Lab grid content (see
+// AppSwapResponsiveLabGridHolder, which owns that content across tab
+// switches -- this view only ever displays whatever it's currently handed
+// via SetContent()/DetachContent(), the same one-per-content-slot role
+// AppSwapResponsiveLabOverlayView itself has relative to tabs).
+//
+// Deliberately not a views::ScrollView: the grid can be arbitrarily wide (one
+// column per device preset) and a plain horizontal scrollbar doesn't give a
+// way to zoom out for an overview or to jump around quickly, which is what
+// motivated this -- drag-to-pan on empty canvas background, Ctrl+wheel to
+// zoom, plain wheel to pan. AppSwapResponsiveLabMinimapView (a sibling in the
+// overlay) reads this view's current viewport/content extents to draw a
+// small overview + lets the user jump the pan directly via CenterOn().
+//
+// Neither pan nor zoom uses views::View::SetTransform(). Panning moves
+// content_'s own position (SetPosition()), and zoom is handed to the grid
+// as a layout parameter (AppSwapResponsiveLabGridView::SetScale()), which
+// lays every cell out that much larger while pinning each renderer to its
+// device's real pixel size.
+//
+// A transform for zoom is the obvious implementation and it is wrong here.
+// A WebContents' compositor layer is reparented into the Views layer tree
+// (NativeViewHostAura::AttachNativeView, under kNativeViewHostManagesLayers,
+// enabled by default), so an ancestor transform already scales it;
+// NativeViewHost::Layout() then hands its wrapper widget-space geometry
+// that includes that same transform, and the wrapper applies its own scale
+// on top. The zoom therefore landed on hosted web content twice and on
+// painted Views content once. Cell size and cell pitch squared together, so
+// the grid still looked internally consistent, but the header labels drifted
+// out of alignment with their cells and the zoom readout was wrong: 150%
+// actually magnified by 225%.
+//
+// Keeping bounds and painted geometry identical has a second payoff: hit
+// testing is now exact at every zoom level, where a transform left clicks
+// near the outer edge of zoomed-in content missing.
+//
+// Everything below describes positions in *unscaled* content coordinates,
+// so the minimap's view of the world doesn't shift when the user zooms.
+//
+// This view (not its parent overlay -- see this class's own constructor)
+// is given its own layer with SetMasksToBounds(true). Two independent
+// things need that: content_ legitimately extends outside this view's own
+// bounds the moment it's panned or zoomed (pan_offset_ goes negative to
+// keep a zoomed point fixed under the cursor, and a zoomed-in grid's
+// footprint can far exceed this view's size), and without a masking layer
+// that overflow isn't clipped -- it paints wherever it lands, which at
+// high zoom can be above this view's own top edge, over the browser's
+// toolbar. Separately, giving this view a layer is also what makes
+// AppSwapResponsiveLabMinimapView's own layer correctly stack above the
+// grid's WebView layers (see that class's comment).
+class AppSwapResponsiveLabCanvasView : public views::View {
+  METADATA_HEADER(AppSwapResponsiveLabCanvasView, views::View)
+
+ public:
+  static constexpr float kMinScale = 0.25f;
+  static constexpr float kMaxScale = 1.5f;
+
+  AppSwapResponsiveLabCanvasView();
+  AppSwapResponsiveLabCanvasView(const AppSwapResponsiveLabCanvasView&) =
+      delete;
+  AppSwapResponsiveLabCanvasView& operator=(
+      const AppSwapResponsiveLabCanvasView&) = delete;
+  ~AppSwapResponsiveLabCanvasView() override;
+
+  // Result of DetachContent(): the content view (now parentless) plus the
+  // pan/zoom state it had at the moment of detaching, so the caller (the
+  // overlay) can hand both back to the tab's AppSwapResponsiveLabGridHolder
+  // and restore them exactly on a later SetContent().
+  struct DetachResult {
+    DetachResult();
+    DetachResult(DetachResult&&);
+    DetachResult& operator=(DetachResult&&);
+    ~DetachResult();
+
+    std::unique_ptr<AppSwapResponsiveLabGridView> content;
+    gfx::Vector2dF pan_offset;
+    float scale = 1.0f;
+  };
+
+  // Attaches `content` as the sole child, applying the given initial
+  // pan/zoom. Must be called with no content currently attached (call
+  // DetachContent() first).
+  AppSwapResponsiveLabGridView* SetContent(
+      std::unique_ptr<AppSwapResponsiveLabGridView> content,
+      const gfx::Vector2dF& pan_offset,
+      float scale);
+
+  // Detaches the current content (if any) and returns it along with its
+  // current pan/zoom, resetting this view to empty.
+  DetachResult DetachContent();
+
+  bool has_content() const { return content_ != nullptr; }
+
+  // The content's own size at 100%, or an empty size if there's no content
+  // attached.
+  gfx::Size ContentPreferredSize() const;
+
+  // Each cell's footprint in that same space, for the minimap to draw.
+  // Empty when there's no content attached.
+  std::vector<gfx::Rect> ContentCellRects() const;
+
+  // The portion of content-local (unscaled, pre-pan/zoom) space currently
+  // visible within this view's own bounds -- used by the minimap to
+  // position its viewport indicator.
+  gfx::RectF VisibleContentRect() const;
+
+  // Re-centers the viewport on `content_point` (in content-local space),
+  // preserving the current zoom level. Used by the minimap's click/drag-to-
+  // jump navigation.
+  void CenterOn(const gfx::PointF& content_point);
+
+  float scale() const { return scale_; }
+  const gfx::Vector2dF& pan_offset() const { return pan_offset_; }
+
+  // Zooms to an absolute level, clamped to [kMinScale, kMaxScale], about
+  // this view's own center rather than the cursor -- the panel's zoom
+  // control has no cursor position to anchor to, and the center is what a
+  // user watching the canvas expects to stay put.
+  void SetScale(float scale);
+
+  // Invoked whenever content, pan, or zoom changes -- lets the overlay
+  // refresh the minimap without this view needing to know about it
+  // directly.
+  void set_change_callback(base::RepeatingClosure callback) {
+    change_callback_ = std::move(callback);
+  }
+
+  // views::View:
+  bool OnMousePressed(const ui::MouseEvent& event) override;
+  bool OnMouseDragged(const ui::MouseEvent& event) override;
+  void OnMouseReleased(const ui::MouseEvent& event) override;
+  bool OnMouseWheel(const ui::MouseWheelEvent& event) override;
+
+ private:
+  void SetPanOffset(const gfx::Vector2dF& pan_offset);
+  void ZoomBy(float delta_scale, const gfx::PointF& anchor);
+  void ApplyPan();
+  void ApplyScale();
+  void NotifyChanged();
+
+  raw_ptr<AppSwapResponsiveLabGridView> content_ = nullptr;
+  gfx::Vector2dF pan_offset_;
+  float scale_ = 1.0f;
+
+  bool dragging_ = false;
+  gfx::Point drag_start_location_;
+  gfx::Vector2dF drag_start_pan_offset_;
+
+  base::RepeatingClosure change_callback_;
+};
+
+#endif  // CHROME_BROWSER_UI_VIEWS_APP_SWAP_APP_SWAP_RESPONSIVE_LAB_CANVAS_VIEW_H_
