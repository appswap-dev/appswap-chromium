@@ -0,0 +1,91 @@
+// Copyright 2026 The AppSwap Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_VIEWS_APP_SWAP_APP_SWAP_RESPONSIVE_LAB_GRID_VIEW_H_
+#define CHROME_BROWSER_UI_VIEWS_APP_SWAP_APP_SWAP_RESPONSIVE_LAB_GRID_VIEW_H_
+
+#include <string>
+#include <vector>
+
+#include "base/memory/raw_ptr.h"
+#include "base/memory/weak_ptr.h"
+#include "base/scoped_observation.h"
+#include "chrome/browser/app_swap/app_swap_responsive_lab_session.h"
+#include "ui/base/metadata/metadata_header_macros.h"
+#include "ui/gfx/geometry/rect.h"
+#include "ui/gfx/geometry/size.h"
+#include "ui/views/layout/box_layout.h"
+#include "ui/views/view.h"
+
+class AppSwapResponsiveLabCellView;
+class Profile;
+
+// The row of Responsive Lab cells, one per viewport, kept in sync with the
+// tab's AppSwapResponsiveLabSession. This is the view
+// AppSwapResponsiveLabCanvasView pans and zooms as a whole.
+//
+// Replaces the one-shot BuildGridView() free function this grew out of.
+// The difference that matters is Reconcile(): the panel can add, remove,
+// resize and rotate viewports at any time, and each of those has to change
+// only the cells it actually affects. Rebuilding the row wholesale would
+// reload every page in it on every edit.
+class AppSwapResponsiveLabGridView
+    : public views::View,
+      public AppSwapResponsiveLabSession::Observer {
+  METADATA_HEADER(AppSwapResponsiveLabGridView, views::View)
+
+ public:
+  AppSwapResponsiveLabGridView(Profile* profile,
+                               AppSwapResponsiveLabSession* session);
+  AppSwapResponsiveLabGridView(const AppSwapResponsiveLabGridView&) = delete;
+  AppSwapResponsiveLabGridView& operator=(const AppSwapResponsiveLabGridView&) =
+      delete;
+  ~AppSwapResponsiveLabGridView() override;
+
+  // Lays the whole row out `scale` times its natural size: every cell, and
+  // the spacing between them. See AppSwapResponsiveLabCellView::SetScale()
+  // for why canvas zoom is a layout parameter here rather than a transform
+  // on this view.
+  void SetScale(float scale);
+
+  // This row's size at 100%, which is the coordinate space the canvas and
+  // its minimap describe positions in. Distinct from GetPreferredSize(),
+  // which is the scaled size this view is actually laid out at.
+  gfx::Size UnscaledPreferredSize() const;
+
+  // Each cell's footprint in that same unscaled space, in the session's
+  // viewport order. Lets the minimap draw the grid as the row of differently
+  // proportioned pages it actually is, rather than as one anonymous box.
+  std::vector<gfx::Rect> UnscaledCellBounds() const;
+
+  // AppSwapResponsiveLabSession::Observer:
+  void OnResponsiveLabViewportsChanged() override;
+  void OnResponsiveLabPreviewedUrlChanged() override;
+  void OnResponsiveLabSessionDestroying() override;
+
+ private:
+  // Brings the cell list in line with the session's viewport list: creates
+  // cells for new viewports, drops cells for removed ones, pushes edited
+  // presets into the cells that already exist, and puts them all back in
+  // the session's own order.
+  void Reconcile();
+
+  AppSwapResponsiveLabCellView* FindCell(const std::string& viewport_id);
+
+  // Pushes scale_ into the layout manager's spacing and re-sizes this view
+  // to whatever that produces. Nothing above ever sizes this row for us --
+  // the canvas only repositions it -- so it must size itself.
+  void ApplyScale();
+
+  raw_ptr<Profile> profile_;
+  base::WeakPtr<AppSwapResponsiveLabSession> session_;
+  float scale_ = 1.0f;
+  raw_ptr<views::BoxLayout> layout_ = nullptr;
+
+  base::ScopedObservation<AppSwapResponsiveLabSession,
+                          AppSwapResponsiveLabSession::Observer>
+      session_observation_{this};
+};
+
+#endif  // CHROME_BROWSER_UI_VIEWS_APP_SWAP_APP_SWAP_RESPONSIVE_LAB_GRID_VIEW_H_
diff --git a/chrome/browser/ui/views/app_swap/app_swap_responsive_lab_minimap_view.cc b/chrome/browser/ui/views/app_swap/app_swap_responsive_lab_minimap_view.cc
new file mode 100644
index 0000000000000..3d92b327661fe
--- /dev/null
+++ b/chrome/browser/ui/views/app_swap/app_swap_responsive_lab_minimap_view.cc
@@ -0,0 +1,183 @@
+// Copyright 2026 The AppSwap Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/views/app_swap/app_swap_responsive_lab_minimap_view.h"
+
+#include <algorithm>
+#include <memory>
+
+#include "chrome/browser/ui/views/app_swap/app_swap_responsive_lab_canvas_view.h"
+#include "ui/base/metadata/metadata_impl_macros.h"
+#include "ui/color/color_id.h"
+#include "ui/color/color_provider.h"
+#include "ui/gfx/canvas.h"
+#include "ui/compositor/layer.h"
+#include "ui/events/event.h"
+#include "ui/gfx/geometry/insets.h"
+#include "ui/gfx/geometry/rect.h"
+#include "ui/gfx/geometry/rect_conversions.h"
+#include "ui/gfx/geometry/rect_f.h"
+#include "ui/gfx/geometry/size.h"
+#include "ui/views/background.h"
+#include "ui/views/border.h"
+
+namespace {
+
+constexpr int kPanelWidth = 200;
+constexpr int kPanelHeight = 130;
+constexpr int kPanelPadding = 10;
+constexpr float kPanelCornerRadius = 8.0f;
+constexpr int kViewportIndicatorThickness = 2;
+
+// A cell narrower than this would be a sliver rather than a readable
+// rectangle, so it is drawn at this width instead. Only reachable with a
+// very wide grid: at three default presets every cell is comfortably above
+// it.
+constexpr int kMinCellRectSize = 2;
+
+}  // namespace
+
+AppSwapResponsiveLabMinimapView::AppSwapResponsiveLabMinimapView(
+    AppSwapResponsiveLabCanvasView* canvas)
+    : canvas_(canvas) {
+  // Needs its own layer to actually stack above the grid's WebView layers
+  // -- see AppSwapResponsiveLabOverlayView's constructor comment. Its
+  // background has rounded corners, so it doesn't fill its bounds
+  // opaquely (the corners are transparent).
+  SetPaintToLayer();
+  layer()->SetFillsBoundsOpaquely(false);
+
+  SetPreferredSize(gfx::Size(kPanelWidth, kPanelHeight));
+  SetBackground(views::CreateRoundedRectBackground(
+      ui::kColorSysSurfaceVariant, kPanelCornerRadius));
+  SetBorder(views::CreateEmptyBorder(gfx::Insets(kPanelPadding)));
+
+  auto viewport_indicator = std::make_unique<views::View>();
+  viewport_indicator->SetBorder(views::CreateSolidBorder(
+      kViewportIndicatorThickness, ui::kColorSysPrimary));
+  viewport_indicator_ = AddChildView(std::move(viewport_indicator));
+
+  SetVisible(false);
+}
+
+AppSwapResponsiveLabMinimapView::~AppSwapResponsiveLabMinimapView() = default;
+
+void AppSwapResponsiveLabMinimapView::Refresh() {
+  if (!canvas_->has_content()) {
+    SetVisible(false);
+    return;
+  }
+
+  const gfx::Size content_size = canvas_->ContentPreferredSize();
+  const gfx::Rect inner = GetContentsBounds();
+  if (content_size.IsEmpty() || inner.IsEmpty()) {
+    SetVisible(false);
+    return;
+  }
+  SetVisible(true);
+
+  fit_scale_ = std::min(
+      inner.width() / static_cast<float>(content_size.width()),
+      inner.height() / static_cast<float>(content_size.height()));
+  const float scaled_width = content_size.width() * fit_scale_;
+  const float scaled_height = content_size.height() * fit_scale_;
+  fit_offset_ = gfx::Vector2dF(
+      inner.x() + (inner.width() - scaled_width) / 2.0f,
+      inner.y() + (inner.height() - scaled_height) / 2.0f);
+
+  // One rect per cell, so the minimap shows the grid as the row of
+  // differently proportioned pages it is -- which is what tells the user
+  // where they are. A single outline can only say "somewhere in the
+  // content".
+  cell_rects_.clear();
+  for (const gfx::Rect& cell : canvas_->ContentCellRects()) {
+    gfx::RectF scaled(cell);
+    scaled.Scale(fit_scale_);
+    scaled.Offset(fit_offset_);
+    gfx::Rect rect = gfx::ToEnclosingRect(scaled);
+    rect.set_width(std::max(rect.width(), kMinCellRectSize));
+    rect.set_height(std::max(rect.height(), kMinCellRectSize));
+    cell_rects_.push_back(rect);
+  }
+
+  // The grid's full extent. Not drawn -- the cells are the content, and an
+  // outline around them only ever enclosed the header labels and the row's
+  // padding as well, which read as an empty band around everything. Still
+  // computed, because it is what the indicator is clipped to.
+  const gfx::RectF content_rect(fit_offset_.x(), fit_offset_.y(), scaled_width,
+                                scaled_height);
+  gfx::RectF indicator(canvas_->VisibleContentRect());
+  indicator.Scale(fit_scale_);
+  indicator.Offset(fit_offset_);
+
+  // Clipped to the content, not to the panel: an indicator is a statement
+  // about which part of the content is on screen, so one that extended past
+  // the content outline -- which it does whenever the canvas is wider than
+  // the grid, i.e. at every zoomed-out level -- was claiming to point at
+  // something that isn't there.
+  indicator.Intersect(content_rect);
+
+  // And once it covers the whole grid there is no part to point at, so it
+  // says nothing and is better gone than drawn as a frame around
+  // everything.
+  const bool shows_everything = indicator == content_rect;
+  viewport_indicator_->SetVisible(!indicator.IsEmpty() && !shows_everything);
+  if (viewport_indicator_->GetVisible()) {
+    viewport_indicator_->SetBoundsRect(gfx::ToEnclosingRect(indicator));
+  }
+
+  // The child views above repaint themselves when their bounds change; the
+  // cell rects are painted by this view, so they need asking.
+  SchedulePaint();
+}
+
+void AppSwapResponsiveLabMinimapView::OnPaint(gfx::Canvas* canvas) {
+  views::View::OnPaint(canvas);
+
+  // Painted here rather than as child views, so these land above this
+  // view's own background but below the viewport indicator, which needs to
+  // stay readable on top of them.
+  const ui::ColorProvider* colors = GetColorProvider();
+  const SkColor fill = colors->GetColor(ui::kColorSysSurface);
+  const SkColor outline = colors->GetColor(ui::kColorSysOutline);
+  for (const gfx::Rect& rect : cell_rects_) {
+    canvas->FillRect(rect, fill);
+    // Outlined as well as filled: neighbouring viewports are only a cell's
+    // spacing apart, which is well under a pixel at the minimap's scale, so
+    // fills alone would merge into one block.
+    canvas->DrawRect(gfx::RectF(rect), outline);
+  }
+}
+
+bool AppSwapResponsiveLabMinimapView::OnMousePressed(
+    const ui::MouseEvent& event) {
+  if (!event.IsOnlyLeftMouseButton() || !canvas_->has_content()) {
+    return false;
+  }
+  JumpTo(event.location());
+  return true;
+}
+
+bool AppSwapResponsiveLabMinimapView::OnMouseDragged(
+    const ui::MouseEvent& event) {
+  if (!canvas_->has_content()) {
+    return false;
+  }
+  JumpTo(event.location());
+  return true;
+}
+
+void AppSwapResponsiveLabMinimapView::JumpTo(
+    const gfx::Point& minimap_local_point) {
+  if (fit_scale_ <= 0) {
+    return;
+  }
+  const gfx::PointF content_point(
+      (minimap_local_point.x() - fit_offset_.x()) / fit_scale_,
+      (minimap_local_point.y() - fit_offset_.y()) / fit_scale_);
+  canvas_->CenterOn(content_point);
+}
+
+BEGIN_METADATA(AppSwapResponsiveLabMinimapView)
+END_METADATA
