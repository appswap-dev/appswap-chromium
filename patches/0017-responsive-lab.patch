+
+#include "chrome/browser/app_swap/app_swap_responsive_lab_types.h"
+
+#include "ui/gfx/geometry/size.h"
+
+AppSwapDevicePreset::AppSwapDevicePreset() = default;
+AppSwapDevicePreset::AppSwapDevicePreset(const AppSwapDevicePreset&) = default;
+AppSwapDevicePreset& AppSwapDevicePreset::operator=(
+    const AppSwapDevicePreset&) = default;
+AppSwapDevicePreset::AppSwapDevicePreset(AppSwapDevicePreset&&) = default;
+AppSwapDevicePreset& AppSwapDevicePreset::operator=(AppSwapDevicePreset&&) =
+    default;
+AppSwapDevicePreset::~AppSwapDevicePreset() = default;
+
+gfx::Size AppSwapDevicePreset::EffectiveSize() const {
+  return rotated ? gfx::Size(height, width) : gfx::Size(width, height);
+}
diff --git a/chrome/browser/app_swap/app_swap_responsive_lab_types.h b/chrome/browser/app_swap/app_swap_responsive_lab_types.h
new file mode 100644
index 0000000000000..bd727dcfceb7d
--- /dev/null
+++ b/chrome/browser/app_swap/app_swap_responsive_lab_types.h
@@ -0,0 +1,69 @@
+// Copyright 2026 The AppSwap Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_APP_SWAP_APP_SWAP_RESPONSIVE_LAB_TYPES_H_
+#define CHROME_BROWSER_APP_SWAP_APP_SWAP_RESPONSIVE_LAB_TYPES_H_
+
+#include <string>
+
+namespace gfx {
+class Size;
+}  // namespace gfx
+
+// One Responsive Lab viewport's device definition: the size its cell
+// renders at, plus the emulation parameters that make it behave like that
+// device rather than merely being a narrow desktop window.
+//
+// Deliberately here, in the Views-agnostic layer, rather than nested inside
+// AppSwapResponsiveLabOverlayView where it used to live: it is a pure model
+// type that AppSwapResponsiveLabSession, the CDP client, and the panel's
+// Mojo page handler all need, and none of those can (or should) include a
+// views:: header to reach it.
+struct AppSwapDevicePreset {
+  AppSwapDevicePreset();
+  AppSwapDevicePreset(const AppSwapDevicePreset&);
+  AppSwapDevicePreset& operator=(const AppSwapDevicePreset&);
+  AppSwapDevicePreset(AppSwapDevicePreset&&);
+  AppSwapDevicePreset& operator=(AppSwapDevicePreset&&);
+  ~AppSwapDevicePreset();
+
+  // Stable within a session; the id every panel operation addresses a
+  // viewport by. Not a display string -- see `name` for that.
+  std::string id;
+
+  // Shown in the cell header, e.g. "Mobile".
+  std::string name;
+
+  // The device's own portrait dimensions. `rotated` swaps them at every
+  // use site (see EffectiveSize()) rather than being applied destructively
+  // here, so rotating twice can't drift.
+  int width = 0;
+  int height = 0;
+
+  // Emulated devicePixelRatio. Zero means "leave the host's own alone",
+  // which is what a desktop preset wants -- overriding it to 1 on a HiDPI
+  // display would make the desktop cell render visibly softer than the
+  // real tab it is previewing.
+  float device_scale_factor = 0.0f;
+
+  // Emulates a mobile screen: mobile viewport/meta handling, overlay
+  // scrollbars, and touch input.
+  bool mobile = false;
+
+  // Overrides navigator.userAgent. Empty means no override.
+  std::string user_agent;
+
+  bool rotated = false;
+
+  // Lets the grid tell "this cell's device definition actually changed"
+  // from "the list was rebuilt", so an unrelated edit elsewhere in the
+  // list doesn't resize and re-emulate every other cell.
+  friend bool operator==(const AppSwapDevicePreset&,
+                         const AppSwapDevicePreset&) = default;
+
+  // `width` x `height`, swapped when `rotated`.
+  gfx::Size EffectiveSize() const;
+};
+
+#endif  // CHROME_BROWSER_APP_SWAP_APP_SWAP_RESPONSIVE_LAB_TYPES_H_
diff --git a/chrome/browser/app_swap/app_swap_responsive_lab_viewport_client.cc b/chrome/browser/app_swap/app_swap_responsive_lab_viewport_client.cc
new file mode 100644
index 0000000000000..4a80e3156b969
--- /dev/null
+++ b/chrome/browser/app_swap/app_swap_responsive_lab_viewport_client.cc
@@ -0,0 +1,81 @@
+// Copyright 2026 The AppSwap Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/app_swap/app_swap_responsive_lab_viewport_client.h"
+
+#include <utility>
+
+#include "ui/gfx/geometry/size.h"
+
+namespace {
+
+// What a mobile preset reports for navigator.maxTouchPoints. Matches what
+// DevTools' own device mode sends for a touch device; the exact number
+// matters only to feature-detection code that branches on "> 1".
+constexpr int kMobileMaxTouchPoints = 5;
+
+}  // namespace
+
+AppSwapResponsiveLabViewportClient::AppSwapResponsiveLabViewportClient(
+    content::WebContents* web_contents)
+    : AppSwapDevToolsClient(web_contents) {}
+
+AppSwapResponsiveLabViewportClient::~AppSwapResponsiveLabViewportClient() =
+    default;
+
+void AppSwapResponsiveLabViewportClient::ApplyPreset(
+    const AppSwapDevicePreset& preset,
+    float canvas_scale) {
+  const gfx::Size size = preset.EffectiveSize();
+
+  base::DictValue metrics;
+  metrics.Set("width", size.width());
+  metrics.Set("height", size.height());
+  // The protocol treats 0 as "don't override", which is exactly what a
+  // preset with no explicit ratio wants -- see the field's own comment.
+  metrics.Set("deviceScaleFactor",
+              static_cast<double>(preset.device_scale_factor));
+  metrics.Set("mobile", preset.mobile);
+  // A device's screen is the device, so the page sees screen.width/height
+  // matching its viewport rather than the host monitor's real dimensions.
+  metrics.Set("screenWidth", size.width());
+  metrics.Set("screenHeight", size.height());
+  // Load-bearing: see this class's comment. Without it EmulationHandler
+  // resizes the RenderWidgetHostView out from under NativeViewHost.
+  metrics.Set("dontSetVisibleSize", true);
+  // The canvas zoom, applied by the renderer. See the header for why this
+  // is not left to the compositor.
+  metrics.Set("scale", static_cast<double>(canvas_scale));
+  if (preset.mobile) {
+    metrics.Set("screenOrientation",
+                base::DictValue()
+                    .Set("type", preset.rotated ? "landscapePrimary"
+                                                : "portraitPrimary")
+                    .Set("angle", preset.rotated ? 90 : 0));
+  }
+  SendCommand("Emulation.setDeviceMetricsOverride", std::move(metrics),
+              CommandCallback());
+
+  SendCommand("Emulation.setTouchEmulationEnabled",
+              base::DictValue()
+                  .Set("enabled", preset.mobile)
+                  .Set("maxTouchPoints",
+                       preset.mobile ? kMobileMaxTouchPoints : 1),
+              CommandCallback());
+
+  // An empty string is how the protocol spells "no override" here (see
+  // EmulationHandler::SetUserAgentOverride), so this both sets and clears.
+  SendCommand("Emulation.setUserAgentOverride",
+              base::DictValue().Set("userAgent", preset.user_agent),
+              CommandCallback());
+}
+
+void AppSwapResponsiveLabViewportClient::ClearEmulation() {
+  SendCommand("Emulation.clearDeviceMetricsOverride", base::DictValue(),
+              CommandCallback());
+  SendCommand("Emulation.setTouchEmulationEnabled",
+              base::DictValue().Set("enabled", false), CommandCallback());
+  SendCommand("Emulation.setUserAgentOverride",
+              base::DictValue().Set("userAgent", ""), CommandCallback());
+}
diff --git a/chrome/browser/app_swap/app_swap_responsive_lab_viewport_client.h b/chrome/browser/app_swap/app_swap_responsive_lab_viewport_client.h
new file mode 100644
index 0000000000000..f5bc458cfe7db
--- /dev/null
+++ b/chrome/browser/app_swap/app_swap_responsive_lab_viewport_client.h
@@ -0,0 +1,68 @@
+// Copyright 2026 The AppSwap Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_APP_SWAP_APP_SWAP_RESPONSIVE_LAB_VIEWPORT_CLIENT_H_
+#define CHROME_BROWSER_APP_SWAP_APP_SWAP_RESPONSIVE_LAB_VIEWPORT_CLIENT_H_
+
+#include "chrome/browser/app_swap/app_swap_devtools_client.h"
+#include "chrome/browser/app_swap/app_swap_responsive_lab_types.h"
+
+namespace content {
+class WebContents;
+}  // namespace content
+
+// The protocol client for one Responsive Lab viewport: an
+// AppSwapDevToolsClient that knows what to say to make a lab cell an
+// emulated device.
+//
+// ApplyPreset() supplies the devicePixelRatio, mobile screen type, touch
+// input and user agent that sizing a views::WebView cannot. It is also the
+// seam the shared panel is built on -- one client per viewport, so a single
+// panel action can fan out to every viewport at once (see
+// AppSwapResponsiveLabSession, which owns these).
+//
+// Deliberately a protocol client rather than a DevTools window: the
+// DevTools frontend binds to exactly one primary page target, chosen for it
+// at startup with no switcher, and each lab cell is its own WebContents and
+// therefore its own target -- so one frontend can't span the grid. Docking
+// is refused for a non-tab WebContents as well (see DevToolsWindow::Create).
+//
+// One protocol caveat is load-bearing and is enforced in ApplyPreset():
+// Emulation.setDeviceMetricsOverride must be sent with dontSetVisibleSize
+// true. Without it EmulationHandler calls WebContents::SetDeviceEmulationSize,
+// which resizes the RenderWidgetHostView directly and fights both
+// PinnedSizeWebView and NativeViewHost::Layout() for control of the cell's
+// native surface size.
+class AppSwapResponsiveLabViewportClient : public AppSwapDevToolsClient {
+ public:
+  explicit AppSwapResponsiveLabViewportClient(
+      content::WebContents* web_contents);
+  AppSwapResponsiveLabViewportClient(
+      const AppSwapResponsiveLabViewportClient&) = delete;
+  AppSwapResponsiveLabViewportClient& operator=(
+      const AppSwapResponsiveLabViewportClient&) = delete;
+  ~AppSwapResponsiveLabViewportClient() override;
+
+  // Applies `preset`'s emulation parameters, rendered at `canvas_scale`.
+  //
+  // The scale is handed to the renderer rather than left to the compositor
+  // to apply to the finished texture, which is the difference between text
+  // that stays sharp when the canvas is zoomed out and text that turns to
+  // mush. Blink lays the page out at the device's own CSS size and
+  // rasterizes the result at the size it will actually occupy; a
+  // compositor-side downscale instead minifies an already-rasterized
+  // texture. devicePixelRatio reported to the page is unaffected -- that
+  // stays the preset's own.
+  //
+  // Safe to call repeatedly; the renderer reapplies the override itself
+  // across navigations (see EmulationHandler::SetRenderer), so this does
+  // not need re-sending on every load.
+  void ApplyPreset(const AppSwapDevicePreset& preset, float canvas_scale);
+
+  // Drops every override ApplyPreset() installed, returning the page to the
+  // host's own metrics and user agent.
+  void ClearEmulation();
+};
+
+#endif  // CHROME_BROWSER_APP_SWAP_APP_SWAP_RESPONSIVE_LAB_VIEWPORT_CLIENT_H_
