+// Copyright 2026 The AppSwap Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_VIEWS_APP_SWAP_APP_SWAP_RESPONSIVE_LAB_WHEEL_OBSERVER_MAC_H_
+#define CHROME_BROWSER_UI_VIEWS_APP_SWAP_APP_SWAP_RESPONSIVE_LAB_WHEEL_OBSERVER_MAC_H_
+
+#include <memory>
+
+#include "base/memory/raw_ptr.h"
+#include "ui/events/event_observer.h"
+
+class AppSwapResponsiveLabCanvasView;
+
+namespace views {
+class EventMonitor;
+}  // namespace views
+
+// macOS equivalent of AppSwapResponsiveLabWheelInterceptorAura (see that
+// class's own comment for the underlying problem: a grid cell's WebView
+// hosts native content that claims wheel input directly, so
+// canvas_view's own Ctrl+Wheel-to-zoom handling never sees the event when
+// the cursor is over a cell instead of empty canvas background). Views on
+// macOS doesn't use aura::Window, so there's no ui::EventHandler
+// pre-target mechanism to hook into there -- this uses views::EventMonitor
+// instead, which works cross-platform including on macOS.
+//
+// Trade-off: unlike Aura's pre-target handler, an EventMonitor's
+// ui::EventObserver "cannot modify events nor mark them as handled" (see
+// its own class comment) -- so on macOS, a Ctrl+Wheel gesture over a grid
+// cell still also reaches that cell's WebView afterward (as a plain
+// scroll; native per-page zoom is separately disabled regardless -- see
+// BuildGridView's ZOOM_MODE_DISABLED comment). That's an accepted rough
+// edge: still strictly better than Ctrl+Wheel not zooming the canvas at
+// all when the cursor is over a cell, which is the alternative.
+class AppSwapResponsiveLabWheelObserverMac : public ui::EventObserver {
+ public:
+  explicit AppSwapResponsiveLabWheelObserverMac(
+      AppSwapResponsiveLabCanvasView* canvas_view);
+  AppSwapResponsiveLabWheelObserverMac(
+      const AppSwapResponsiveLabWheelObserverMac&) = delete;
+  AppSwapResponsiveLabWheelObserverMac& operator=(
+      const AppSwapResponsiveLabWheelObserverMac&) = delete;
+  ~AppSwapResponsiveLabWheelObserverMac() override;
+
+  // ui::EventObserver:
+  void OnEvent(const ui::Event& event) override;
+
+ private:
+  // Owned by AppSwapResponsiveLabOverlayView, which outlives this object
+  // (constructed/destroyed alongside it in AddedToWidget()/
+  // RemovedFromWidget()) and owns canvas_view_ too, for the same lifetime.
+  const raw_ptr<AppSwapResponsiveLabCanvasView> canvas_view_;
+
+  std::unique_ptr<views::EventMonitor> monitor_;
+};
+
+#endif  // CHROME_BROWSER_UI_VIEWS_APP_SWAP_APP_SWAP_RESPONSIVE_LAB_WHEEL_OBSERVER_MAC_H_
