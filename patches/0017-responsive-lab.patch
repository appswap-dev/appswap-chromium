+// Copyright 2026 The AppSwap Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+module app_swap_responsive_lab.mojom;
+
+// Mirrors AppSwapDevicePreset
+// (chrome/browser/app_swap/app_swap_responsive_lab_types.h).
+struct DevicePreset {
+  // Assigned by the browser. Ignored on AddViewport(), which mints its own.
+  string id;
+  string name;
+  int32 width;
+  int32 height;
+  // Emulated devicePixelRatio; 0 means "leave the host's own alone".
+  double device_scale_factor;
+  bool mobile;
+  // Empty means no override.
+  string user_agent;
+  bool rotated;
+};
+
+struct ViewportInfo {
+  DevicePreset preset;
+
+  // True for the cell the user last clicked into, which is the one a
+  // DevTools window opened on this lab follows. False for every viewport
+  // until something has been clicked.
+  bool focused;
+
+  // False when this viewport has no live cell (the lab is off, or its tab
+  // is in the background) or when enterprise policy denied developer tools:
+  // it still renders, it just has no protocol client and therefore no
+  // device emulation.
+  bool emulated;
+};
+
+// One CSS rule that applies to the selected element, in one viewport.
+struct MatchedRuleInfo {
+  string viewport_id;
+  string selector;
+  string css_text;
+  // "regular", "user-agent", "injected", "inspector", or "inline" for the
+  // element's own style attribute.
+  string origin;
+  // The innermost @media condition this rule sits under, empty if none.
+  // Usually the reason two viewports disagree.
+  string media;
+};
+
+struct ConsoleEntryInfo {
+  string viewport_id;
+  // "log", "warning", "error", "info", "debug".
+  string level;
+  string text;
+  string url;
+  int32 line;
+};
+
+interface PageHandlerFactory {
+  CreatePageHandler(pending_remote<Page> page,
+                    pending_receiver<PageHandler> handler);
+};
+
+// Every method addresses the session for whichever tab the lab is
+// currently showing -- there is no tab id here. The panel is one per
+// content slot, not one per tab (see AppSwapResponsiveLabPanelBridge), so
+// which session that is changes underneath the page as the user switches
+// tabs; Page.OnStateChanged() is how the page finds out.
+interface PageHandler {
+  GetState() => (bool active, string previewed_url,
+                 array<ViewportInfo> viewports, double canvas_scale);
+
+  // `preset.id` is ignored; the browser assigns one.
+  AddViewport(DevicePreset preset) => ();
+  RemoveViewport(string id) => ();
+  // Replaces everything about the viewport except its id.
+  UpdateViewport(string id, DevicePreset preset) => ();
+  RotateViewport(string id) => ();
+  // An empty `id` reloads every viewport.
+  ReloadViewport(string id) => ();
+
+  // Opens a real DevTools window on the lab, following `id` -- or, for an
+  // empty `id`, whichever cell the user last clicked into. One window for
+  // the whole lab, not one per cell: it attaches to every cell at once and
+  // retargets between them as focus moves.
+  OpenDevTools(string id) => ();
+
+  // Absolute canvas zoom, clamped by the canvas to its own range.
+  SetCanvasScale(double scale) => ();
+
+  // Arms the element picker in every viewport. The first element clicked in
+  // any of them becomes the selection, is highlighted in all of them, and
+  // disarms the picker.
+  StartPicking() => ();
+  StopPicking() => ();
+  ClearSelection() => ();
+
+  // Applies a declaration block ("color: red; width: 50%") to the selected
+  // element's inline style in every viewport that has one.
+  ApplyStyleToAll(string declarations) => ();
+
+  // The merged log so far. Pushed entries arrive via Page.OnConsoleEntry;
+  // this is for a page that has just connected.
+  GetConsole() => (array<ConsoleEntryInfo> entries);
+  ClearConsole() => ();
+};
+
+interface Page {
+  // Pushed whenever the displayed session changes (a tab switch), or that
+  // session's viewport list or active state changes. Carries the whole
+  // state rather than a delta: the list is short, and the page rebuilds
+  // from it wholesale anyway.
+  OnStateChanged(bool active, string previewed_url,
+                 array<ViewportInfo> viewports, double canvas_scale);
+
+  // The picker was armed or disarmed, including disarming itself after a
+  // successful pick.
+  OnPickingChanged(bool picking);
+
+  // A new element was selected, or its rules were re-read after an edit.
+  // An empty `selector` means nothing is selected.
+  OnSelectionChanged(string selector, array<MatchedRuleInfo> rules);
+
+  // One new line of merged console output.
+  OnConsoleEntry(ConsoleEntryInfo entry);
+
+  // The log was cleared, from this page or otherwise.
+  OnConsoleCleared();
+};
diff --git a/chrome/browser/ui/webui/app_swap_responsive_lab/app_swap_responsive_lab_page_handler.cc b/chrome/browser/ui/webui/app_swap_responsive_lab/app_swap_responsive_lab_page_handler.cc
new file mode 100644
