+
+AppSwapResponsiveLabGridHolder::AppSwapResponsiveLabGridHolder(
+    content::WebContents* web_contents)
+    : content::WebContentsUserData<AppSwapResponsiveLabGridHolder>(
+          *web_contents) {}
+
+AppSwapResponsiveLabGridHolder::~AppSwapResponsiveLabGridHolder() = default;
+
+std::unique_ptr<AppSwapResponsiveLabGridView>
+AppSwapResponsiveLabGridHolder::TakeOrBuildGridView(
+    Profile* profile,
+    AppSwapResponsiveLabSession* session) {
+  if (grid_view_) {
+    return std::move(grid_view_);
+  }
+  return std::make_unique<AppSwapResponsiveLabGridView>(profile, session);
+}
+
+void AppSwapResponsiveLabGridHolder::PutBackGridView(
+    std::unique_ptr<AppSwapResponsiveLabGridView> grid_view) {
+  grid_view_ = std::move(grid_view);
+}
+
+void AppSwapResponsiveLabGridHolder::Discard() {
+  grid_view_.reset();
+}
