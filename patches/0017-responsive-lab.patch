+++ b/chrome/browser/app_swap/app_swap_responsive_lab_inspector.h
@@ -0,0 +1,176 @@
+// Copyright 2026 The AppSwap Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_APP_SWAP_APP_SWAP_RESPONSIVE_LAB_INSPECTOR_H_
+#define CHROME_BROWSER_APP_SWAP_APP_SWAP_RESPONSIVE_LAB_INSPECTOR_H_
+
+#include <map>
+#include <optional>
+#include <string>
+#include <vector>
+
+#include "base/memory/raw_ptr.h"
+#include "base/memory/weak_ptr.h"
+#include "base/observer_list.h"
+#include "base/observer_list_types.h"
+#include "base/values.h"
+
+class AppSwapResponsiveLabSession;
+
+// The part of Responsive Lab that acts on every viewport at once.
+//
+// The per-viewport AppSwapResponsiveLabViewportClient objects are what make
+// each cell an emulated device; this is what makes the set of them behave
+// like one instrument. Everything here fans a single action out across the
+// session's viewports and merges what comes back:
+//
+//   - Pick an element in any one viewport and the matching element is
+//     highlighted in all of them, with the CSS that actually applies listed
+//     per viewport (which is the interesting part: the same selector can
+//     match different rules at different widths).
+//   - Type a declaration once and it lands on the selected element in every
+//     viewport.
+//   - Console output and page errors from all viewports arrive as one
+//     stream, each entry tagged with the viewport that produced it.
+//
+// Owned by AppSwapResponsiveLabSession, which tells it when a viewport's
+// client appears and disappears. Deliberately Views-agnostic like the rest
+// of that layer, so the panel's Mojo page handler can drive it directly.
+class AppSwapResponsiveLabInspector {
+ public:
+  // One line of merged console output.
+  struct ConsoleEntry {
+    ConsoleEntry();
+    ConsoleEntry(const ConsoleEntry&);
+    ConsoleEntry& operator=(const ConsoleEntry&);
+    ~ConsoleEntry();
+
+    std::string viewport_id;
+    // "log", "warning", "error", "info", "debug" -- the protocol's own
+    // vocabulary, passed through rather than remapped.
+    std::string level;
+    std::string text;
+    std::string url;
+    int line = 0;
+  };
+
+  // One CSS rule that applies to the selected element, in one viewport.
+  struct MatchedRule {
+    MatchedRule();
+    MatchedRule(const MatchedRule&);
+    MatchedRule& operator=(const MatchedRule&);
+    ~MatchedRule();
+
+    std::string viewport_id;
+    std::string selector;
+    std::string css_text;
+    // "regular", "user-agent", "injected", "inspector".
+    std::string origin;
+    // The innermost @media condition this rule sits under, if any. This is
+    // what usually differs between viewports, so it is worth surfacing.
+    std::string media;
+  };
+
+  class Observer : public base::CheckedObserver {
+   public:
+    // The picker was turned on or off, including turning itself off after
+    // a successful pick.
+    virtual void OnInspectorPickingChanged() {}
+    // A new element was selected, or its matched rules were re-read.
+    virtual void OnInspectorSelectionChanged() {}
+    virtual void OnInspectorConsoleChanged() {}
+  };
+
+  explicit AppSwapResponsiveLabInspector(
+      AppSwapResponsiveLabSession* session);
+  AppSwapResponsiveLabInspector(const AppSwapResponsiveLabInspector&) = delete;
+  AppSwapResponsiveLabInspector& operator=(
+      const AppSwapResponsiveLabInspector&) = delete;
+  ~AppSwapResponsiveLabInspector();
+
+  void AddObserver(Observer* observer);
+  void RemoveObserver(Observer* observer);
+
+  // Called by the session as cells come and go. Attaching enables the
+  // protocol domains this class needs on that viewport and, if the picker
+  // is currently on, arms it there too -- a viewport added mid-pick is
+  // still pickable.
+  void OnViewportAttached(const std::string& viewport_id);
+  void OnViewportDetached(const std::string& viewport_id);
+
+  bool picking() const { return picking_; }
+  void StartPicking();
+  void StopPicking();
+
+  // Empty when nothing is selected.
+  const std::string& selected_selector() const { return selected_selector_; }
+  const std::vector<MatchedRule>& matched_rules() const {
+    return matched_rules_;
+  }
+  void ClearSelection();
+
+  // Applies a declaration block ("color: red; width: 50%") to the selected
+  // element in every viewport that has one, as an inline style. No-op with
+  // nothing selected.
+  void ApplyStyleToAll(const std::string& declarations);
+
+  const std::vector<ConsoleEntry>& console() const { return console_; }
+  void ClearConsole();
+
+ private:
+  // Protocol events arrive here for whichever viewport produced them.
+  void OnProtocolEvent(const std::string& viewport_id,
+                       const std::string& method,
+                       const base::DictValue& params);
+
+  void OnNodePicked(const std::string& viewport_id, int backend_node_id);
+  void OnNodeResolved(const std::string& viewport_id,
+                      int generation,
+                      std::optional<base::DictValue> result);
+  void OnSelectorBuilt(int generation, std::optional<base::DictValue> result);
+
+  // Finds `selected_selector_` in every viewport, highlights it, and reads
+  // back the rules that apply to it there.
+  void ResolveSelectionEverywhere();
+  void OnDocumentForSelection(const std::string& viewport_id,
+                              int generation,
+                              std::optional<base::DictValue> result);
+  void OnQuerySelectorResult(const std::string& viewport_id,
+                             int generation,
+                             std::optional<base::DictValue> result);
+  void OnMatchedStyles(const std::string& viewport_id,
+                       int generation,
+                       std::optional<base::DictValue> result);
+
+  void AddConsoleEntry(ConsoleEntry entry);
+  void SetInspectModeOn(const std::string& viewport_id, bool enabled);
+
+  void NotifyPickingChanged();
+  void NotifySelectionChanged();
+  void NotifyConsoleChanged();
+
+  const raw_ptr<AppSwapResponsiveLabSession> session_;
+
+  bool picking_ = false;
+  std::string selected_selector_;
+  std::string selection_source_viewport_id_;
+
+  // Every asynchronous step of a selection carries the generation it was
+  // started for; a reply from an older one is dropped rather than
+  // scribbling over a newer selection the user has already made.
+  int selection_generation_ = 0;
+
+  // The selected element's DOM node id per viewport, for the follow-up
+  // style reads and edits. Absent for a viewport where the selector didn't
+  // match anything.
+  std::map<std::string, int> selected_node_ids_;
+
+  std::vector<MatchedRule> matched_rules_;
+  std::vector<ConsoleEntry> console_;
+
+  base::ObserverList<Observer> observers_;
+  base::WeakPtrFactory<AppSwapResponsiveLabInspector> weak_factory_{this};
+};
+
+#endif  // CHROME_BROWSER_APP_SWAP_APP_SWAP_RESPONSIVE_LAB_INSPECTOR_H_
