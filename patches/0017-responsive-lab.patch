+#ifndef CHROME_BROWSER_UI_WEBUI_APP_SWAP_RESPONSIVE_LAB_APP_SWAP_RESPONSIVE_LAB_PAGE_HANDLER_H_
+#define CHROME_BROWSER_UI_WEBUI_APP_SWAP_RESPONSIVE_LAB_APP_SWAP_RESPONSIVE_LAB_PAGE_HANDLER_H_
+
+#include <string>
+
+#include "base/memory/weak_ptr.h"
+#include "base/scoped_observation.h"
+#include "chrome/browser/app_swap/app_swap_responsive_lab_inspector.h"
+#include "chrome/browser/app_swap/app_swap_responsive_lab_session.h"
+#include "chrome/browser/ui/webui/app_swap_responsive_lab/app_swap_responsive_lab.mojom.h"
+#include "chrome/browser/ui/webui/app_swap_responsive_lab/app_swap_responsive_lab_panel_bridge.h"
+#include "mojo/public/cpp/bindings/pending_receiver.h"
+#include "mojo/public/cpp/bindings/pending_remote.h"
+#include "mojo/public/cpp/bindings/receiver.h"
+#include "mojo/public/cpp/bindings/remote.h"
+
+// Implements the Responsive Lab panel's PageHandler.
+//
+// Every operation is forwarded to the AppSwapResponsiveLabSession of
+// whichever tab the panel is currently showing, reached through
+// AppSwapResponsiveLabPanelBridge rather than captured once: the panel
+// outlives any one tab (see that class's comment). All three of the things
+// that can change the panel's contents -- a tab switch, a viewport edit,
+// and the lab being toggled -- funnel into PushState().
+//
+// Every method tolerates having no session at all. That is a normal state,
+// not an error: the overlay clears the bridge's session whenever it is
+// showing no grid, and the panel page stays loaded across that.
+class AppSwapResponsiveLabPageHandler
+    : public app_swap_responsive_lab::mojom::PageHandler,
+      public AppSwapResponsiveLabPanelBridge::Client,
+      public AppSwapResponsiveLabSession::Observer,
+      public AppSwapResponsiveLabInspector::Observer {
+ public:
+  AppSwapResponsiveLabPageHandler(
+      mojo::PendingRemote<app_swap_responsive_lab::mojom::Page> page,
+      mojo::PendingReceiver<app_swap_responsive_lab::mojom::PageHandler>
+          handler,
+      base::WeakPtr<AppSwapResponsiveLabPanelBridge> bridge);
+  AppSwapResponsiveLabPageHandler(const AppSwapResponsiveLabPageHandler&) =
+      delete;
+  AppSwapResponsiveLabPageHandler& operator=(
+      const AppSwapResponsiveLabPageHandler&) = delete;
+  ~AppSwapResponsiveLabPageHandler() override;
+
+  // app_swap_responsive_lab::mojom::PageHandler:
+  void GetState(GetStateCallback callback) override;
+  void AddViewport(app_swap_responsive_lab::mojom::DevicePresetPtr preset,
+                   AddViewportCallback callback) override;
+  void RemoveViewport(const std::string& id,
+                      RemoveViewportCallback callback) override;
+  void UpdateViewport(const std::string& id,
+                      app_swap_responsive_lab::mojom::DevicePresetPtr preset,
+                      UpdateViewportCallback callback) override;
+  void RotateViewport(const std::string& id,
+                      RotateViewportCallback callback) override;
+  void ReloadViewport(const std::string& id,
+                      ReloadViewportCallback callback) override;
+  void OpenDevTools(const std::string& id,
+                    OpenDevToolsCallback callback) override;
+  void SetCanvasScale(double scale, SetCanvasScaleCallback callback) override;
+  void StartPicking(StartPickingCallback callback) override;
+  void StopPicking(StopPickingCallback callback) override;
+  void ClearSelection(ClearSelectionCallback callback) override;
+  void ApplyStyleToAll(const std::string& declarations,
+                       ApplyStyleToAllCallback callback) override;
+  void GetConsole(GetConsoleCallback callback) override;
+  void ClearConsole(ClearConsoleCallback callback) override;
+
+  // AppSwapResponsiveLabPanelBridge::Client:
+  void OnPanelSessionChanged() override;
+
+  // AppSwapResponsiveLabSession::Observer:
+  void OnResponsiveLabViewportsChanged() override;
+  void OnResponsiveLabActiveChanged() override;
+  void OnResponsiveLabPreviewedUrlChanged() override;
+  void OnResponsiveLabCanvasScaleChanged() override;
