+
+namespace {
+
+constexpr int kPanelWidth = 200;
+constexpr int kPanelHeight = 130;
+constexpr int kPanelPadding = 10;
+constexpr float kPanelCornerRadius = 8.0f;
+constexpr int kContentOutlineThickness = 1;
+constexpr int kViewportIndicatorThickness = 2;
+
+}  // namespace
+
+AppSwapResponsiveLabMinimapView::AppSwapResponsiveLabMinimapView(
+    AppSwapResponsiveLabCanvasView* canvas)
+    : canvas_(canvas) {
+  // Needs its own layer to actually stack above the grid's WebView layers
+  // -- see AppSwapResponsiveLabOverlayView's constructor comment. Its
+  // background has rounded corners, so it doesn't fill its bounds
+  // opaquely (the corners are transparent).
+  SetPaintToLayer();
+  layer()->SetFillsBoundsOpaquely(false);
+
+  SetPreferredSize(gfx::Size(kPanelWidth, kPanelHeight));
+  SetBackground(views::CreateRoundedRectBackground(
+      ui::kColorSysSurfaceVariant, kPanelCornerRadius));
+  SetBorder(views::CreateEmptyBorder(gfx::Insets(kPanelPadding)));
+
+  auto content_outline = std::make_unique<views::View>();
+  content_outline->SetBorder(views::CreateSolidBorder(
+      kContentOutlineThickness, ui::kColorSysOutline));
+  content_outline_ = AddChildView(std::move(content_outline));
+
+  auto viewport_indicator = std::make_unique<views::View>();
+  viewport_indicator->SetBorder(views::CreateSolidBorder(
+      kViewportIndicatorThickness, ui::kColorSysPrimary));
+  viewport_indicator_ = AddChildView(std::move(viewport_indicator));
+
+  SetVisible(false);
+}
+
+AppSwapResponsiveLabMinimapView::~AppSwapResponsiveLabMinimapView() = default;
+
+void AppSwapResponsiveLabMinimapView::Refresh() {
+  if (!canvas_->has_content()) {
+    SetVisible(false);
+    return;
+  }
+
+  const gfx::Size content_size = canvas_->ContentPreferredSize();
+  const gfx::Rect inner = GetContentsBounds();
+  if (content_size.IsEmpty() || inner.IsEmpty()) {
+    SetVisible(false);
+    return;
+  }
+  SetVisible(true);
+
+  fit_scale_ = std::min(
+      inner.width() / static_cast<float>(content_size.width()),
+      inner.height() / static_cast<float>(content_size.height()));
+  const float scaled_width = content_size.width() * fit_scale_;
+  const float scaled_height = content_size.height() * fit_scale_;
+  fit_offset_ = gfx::Vector2dF(
+      inner.x() + (inner.width() - scaled_width) / 2.0f,
+      inner.y() + (inner.height() - scaled_height) / 2.0f);
+
+  content_outline_->SetBoundsRect(gfx::ToEnclosingRect(
+      gfx::RectF(fit_offset_.x(), fit_offset_.y(), scaled_width,
+                scaled_height)));
+
+  gfx::RectF indicator(canvas_->VisibleContentRect());
+  indicator.Scale(fit_scale_);
+  indicator.Offset(fit_offset_);
+  indicator.Intersect(gfx::RectF(inner));
+  viewport_indicator_->SetVisible(!indicator.IsEmpty());
+  if (!indicator.IsEmpty()) {
+    viewport_indicator_->SetBoundsRect(gfx::ToEnclosingRect(indicator));
+  }
+}
+
+bool AppSwapResponsiveLabMinimapView::OnMousePressed(
+    const ui::MouseEvent& event) {
+  if (!event.IsOnlyLeftMouseButton() || !canvas_->has_content()) {
+    return false;
+  }
+  JumpTo(event.location());
+  return true;
+}
+
+bool AppSwapResponsiveLabMinimapView::OnMouseDragged(
+    const ui::MouseEvent& event) {
+  if (!canvas_->has_content()) {
+    return false;
+  }
+  JumpTo(event.location());
+  return true;
+}
+
+void AppSwapResponsiveLabMinimapView::JumpTo(
+    const gfx::Point& minimap_local_point) {
+  if (fit_scale_ <= 0) {
+    return;
+  }
+  const gfx::PointF content_point(
+      (minimap_local_point.x() - fit_offset_.x()) / fit_scale_,
+      (minimap_local_point.y() - fit_offset_.y()) / fit_scale_);
+  canvas_->CenterOn(content_point);
+}
+
+BEGIN_METADATA(AppSwapResponsiveLabMinimapView)
+END_METADATA
diff --git a/chrome/browser/ui/views/app_swap/app_swap_responsive_lab_minimap_view.h b/chrome/browser/ui/views/app_swap/app_swap_responsive_lab_minimap_view.h
new file mode 100644
index 0000000000000..808cecbeee537
--- /dev/null
+++ b/chrome/browser/ui/views/app_swap/app_swap_responsive_lab_minimap_view.h
@@ -0,0 +1,76 @@
+// Copyright 2026 The AppSwap Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_VIEWS_APP_SWAP_APP_SWAP_RESPONSIVE_LAB_MINIMAP_VIEW_H_
+#define CHROME_BROWSER_UI_VIEWS_APP_SWAP_APP_SWAP_RESPONSIVE_LAB_MINIMAP_VIEW_H_
+
+#include "base/memory/raw_ptr.h"
+#include "ui/base/metadata/metadata_header_macros.h"
+#include "ui/gfx/geometry/point.h"
+#include "ui/gfx/geometry/vector2d_f.h"
+#include "ui/views/view.h"
+
+class AppSwapResponsiveLabCanvasView;
+
+// A small, fixed-size overview panel anchored to the bottom-right corner of
+// AppSwapResponsiveLabOverlayView, showing the full extent of the current
+// tab's grid content (a plain outline -- this doesn't attempt a live
+// pixel-accurate thumbnail of the WebViews inside it, since ui::Layer::
+// Mirror() only mirrors a layer's own painted/surface content and
+// explicitly does not mirror children, which is all the grid content
+// actually has) plus a highlighted rectangle showing the portion of it
+// AppSwapResponsiveLabCanvasView currently has in view. Clicking or
+// dragging inside the panel re-centers the canvas's viewport on that point
+// (via AppSwapResponsiveLabCanvasView::CenterOn()), so it doubles as a
+// jump-navigation control for a canvas that's otherwise only pannable by
+// dragging its (potentially much larger) content around.
+//
+// One-per-content-slot, same as the overlay and canvas view it lives
+// beside -- Refresh() re-reads whatever the canvas is currently showing
+// each time it's called, rather than tracking any tab-specific state of
+// its own.
+class AppSwapResponsiveLabMinimapView : public views::View {
+  METADATA_HEADER(AppSwapResponsiveLabMinimapView, views::View)
+
+ public:
+  // `canvas` is the sibling view this minimap always tracks -- both are
+  // constructed once by the overlay and destroyed together, so a raw,
+  // non-owning pointer held for this view's whole lifetime is safe.
+  explicit AppSwapResponsiveLabMinimapView(AppSwapResponsiveLabCanvasView* canvas);
+  AppSwapResponsiveLabMinimapView(const AppSwapResponsiveLabMinimapView&) =
+      delete;
+  AppSwapResponsiveLabMinimapView& operator=(
+      const AppSwapResponsiveLabMinimapView&) = delete;
+  ~AppSwapResponsiveLabMinimapView() override;
+
+  // Recomputes the content outline and viewport indicator from the canvas's
+  // current content size and visible rect. Hides this view entirely when
+  // the canvas has no content to show. Call whenever the canvas's content,
+  // pan, or zoom changes.
+  void Refresh();
+
+  // views::View:
+  bool OnMousePressed(const ui::MouseEvent& event) override;
+  bool OnMouseDragged(const ui::MouseEvent& event) override;
+
+ private:
+  // Converts a point in this view's own local coordinates to a point in
+  // the canvas content's (unscaled) local space, using the same fit
+  // mapping Refresh() just computed, and re-centers the canvas there.
+  void JumpTo(const gfx::Point& minimap_local_point);
+
+  const raw_ptr<AppSwapResponsiveLabCanvasView> canvas_;
+
+  raw_ptr<views::View> content_outline_ = nullptr;
+  raw_ptr<views::View> viewport_indicator_ = nullptr;
+
+  // The "fit content into this panel's inner area" mapping Refresh() last
+  // computed -- content-local point p maps to fit_offset_ + p * fit_scale_
+  // in this view's local space. Used both to place the outline/indicator
+  // and, inverted, by JumpTo() to map a click back to a content point.
+  float fit_scale_ = 1.0f;
+  gfx::Vector2dF fit_offset_;
+};
+
+#endif  // CHROME_BROWSER_UI_VIEWS_APP_SWAP_APP_SWAP_RESPONSIVE_LAB_MINIMAP_VIEW_H_
diff --git a/chrome/browser/ui/views/app_swap/app_swap_responsive_lab_overlay_view.cc b/chrome/browser/ui/views/app_swap/app_swap_responsive_lab_overlay_view.cc
new file mode 100644
index 0000000000000..0aa5cc2ed178b
--- /dev/null
+++ b/chrome/browser/ui/views/app_swap/app_swap_responsive_lab_overlay_view.cc
@@ -0,0 +1,246 @@
+// Copyright 2026 The AppSwap Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/views/app_swap/app_swap_responsive_lab_overlay_view.h"
+
+#include <memory>
+#include <utility>
+
+#include "base/functional/bind.h"
+#include "base/logging.h"
+#include "chrome/browser/ui/views/app_swap/app_swap_responsive_lab_canvas_view.h"
+#include "chrome/browser/ui/views/app_swap/app_swap_responsive_lab_grid_holder.h"
+#include "chrome/browser/ui/views/app_swap/app_swap_responsive_lab_minimap_view.h"
+#include "content/public/browser/web_contents.h"
+#include "ui/base/metadata/metadata_impl_macros.h"
+#include "ui/color/color_id.h"
+#include "ui/gfx/geometry/rect.h"
+#include "ui/views/background.h"
+#include "ui/views/widget/widget.h"
+#include "url/gurl.h"
+
+#if defined(USE_AURA)
+#include "chrome/browser/ui/views/app_swap/app_swap_responsive_lab_wheel_interceptor_aura.h"
+#include "ui/aura/window.h"
+#endif
+#if BUILDFLAG(IS_MAC)
+#include "chrome/browser/ui/views/app_swap/app_swap_responsive_lab_wheel_observer_mac.h"
+#endif
+
+namespace {
+
+constexpr int kMinimapMargin = 16;
+
+}  // namespace
+
+AppSwapResponsiveLabOverlayView::AppSwapResponsiveLabOverlayView() {
+  SetVisible(false);
+  SetBackground(views::CreateSolidBackground(ui::kColorWindowBackground));
+
+  // No LayoutManager here -- canvas_view_ fills this view's own bounds and
+  // minimap_view_ is anchored to a corner of it, which Layout(PassKey)
+  // below positions directly rather than through a declarative manager.
+  canvas_view_ = AddChildView(std::make_unique<AppSwapResponsiveLabCanvasView>());
+  canvas_view_->set_change_callback(base::BindRepeating(
+      &AppSwapResponsiveLabOverlayView::OnCanvasChanged,
+      base::Unretained(this)));
+
+  // Constructed after canvas_view_ so it paints on top -- see
+  // AppSwapResponsiveLabCanvasView's own constructor comment for why
+  // canvas_view_ (not this view) is the one given a layer to make that
+  // ordering actually stick against the grid's WebView layers.
+  minimap_view_ = AddChildView(
+      std::make_unique<AppSwapResponsiveLabMinimapView>(canvas_view_));
+}
+
+AppSwapResponsiveLabOverlayView::~AppSwapResponsiveLabOverlayView() {
+  // minimap_view_ holds a non-owning raw_ptr to canvas_view_ (see
+  // AppSwapResponsiveLabMinimapView's own comment). views::View::~View()
+  // destroys children_ in add order, which would destroy canvas_view_
+  // (added first) before minimap_view_ (added second) -- leaving that
+  // raw_ptr dangling for the remainder of minimap_view_'s own destruction,
+  // which is exactly what MiraclePtr's dangling-pointer detector caught
+  // during window teardown. Destroying minimap_view_ explicitly here,
+  // before the base class destructor runs, keeps canvas_view_ alive for
+  // minimap_view_'s entire lifetime instead.
+  //
+  // A first attempt at this cleared minimap_view_ *after* calling
+  // RemoveChildViewT(minimap_view_.get()) -- which doesn't work, because
+  // that call's return value (the freed object's now-sole owning
+  // unique_ptr) isn't captured, so it's destroyed at the end of that same
+  // statement: the object is already gone before the next line runs.
+  // MiraclePtr still caught it. Saving a plain (non-raw_ptr) pointer
+  // first, clearing minimap_view_ *before* triggering destruction, then
+  // destroying via the plain pointer is what actually closes the gap: no
+  // raw_ptr is watching that address at the moment it's freed.
+  if (minimap_view_) {
+    AppSwapResponsiveLabMinimapView* minimap = minimap_view_.get();
+    minimap_view_ = nullptr;
+    RemoveChildViewT(minimap);
+  }
+}
+
+void AppSwapResponsiveLabOverlayView::ShowGridFor(
+    content::WebContents* web_contents,
+    Profile* profile,
+    const GURL& url,
+    std::vector<DevicePreset> presets) {
+  LOG(ERROR) << "[ResponsiveLab] OverlayView::ShowGridFor: web_contents="
+             << web_contents << " current_owner_=" << current_owner_
+             << " url=" << url;
+  if (current_owner_ == web_contents) {
+    SetVisible(true);
+    return;
+  }
+
+  // Hands the previous owner's grid (and pan/zoom) back to its own holder
+  // internally, so there's nothing further to do with it here.
+  DetachCurrent();
+
+  AppSwapResponsiveLabGridHolder* holder =
+      AppSwapResponsiveLabGridHolder::GetOrCreateForWebContents(web_contents);
+  canvas_view_->SetContent(
+      holder->TakeOrBuildGridView(profile, url, std::move(presets)),
+      holder->pan_offset(), holder->scale());
+
+  current_owner_ = web_contents;
+  Observe(web_contents);
+  SetVisible(true);
+  LogState("ShowGridFor (end)");
+}
+
+void AppSwapResponsiveLabOverlayView::HideCurrent() {
+  DetachCurrent();
+  SetVisible(false);
+}
+
+void AppSwapResponsiveLabOverlayView::DetachCurrent() {
+  if (!current_owner_) {
+    return;
+  }
+
+  AppSwapResponsiveLabGridHolder* holder =
+      AppSwapResponsiveLabGridHolder::FromWebContents(current_owner_);
+  AppSwapResponsiveLabCanvasView::DetachResult detached =
+      canvas_view_->DetachContent();
+  if (holder && detached.content) {
+    holder->SetViewport(detached.pan_offset, detached.scale);
+    holder->PutBackGridView(std::move(detached.content));
+  }
+  // If the holder is already gone (shouldn't normally happen -- it and
+  // this view's observation of current_owner_ are torn down together via
+  // WebContentsDestroyed() -- but kept as a safe fallback), detached.content
+  // simply goes out of scope and its WebViews/WebContents are destroyed.
+
+  current_owner_ = nullptr;
+  Observe(nullptr);
+}
+
+void AppSwapResponsiveLabOverlayView::OnCanvasChanged() {
+  minimap_view_->Refresh();
+}
+
+void AppSwapResponsiveLabOverlayView::WebContentsDestroyed() {
+  // The tab whose grid we're currently showing is being destroyed. Detach
+  // without trying to hand the grid back to its holder -- that
+  // WebContentsUserData is being torn down along with the WebContents
+  // itself, so there's nothing to hand it to; just let it go.
+  LOG(ERROR) << "[ResponsiveLab] OverlayView::WebContentsDestroyed: "
+             << "current_owner_=" << current_owner_;
+  current_owner_ = nullptr;
+  Observe(nullptr);
+  canvas_view_->DetachContent();  // dropped -- see comment above
+  SetVisible(false);
+}
+
+void AppSwapResponsiveLabOverlayView::OnBoundsChanged(
+    const gfx::Rect& previous_bounds) {
+  views::View::OnBoundsChanged(previous_bounds);
+  LogState("OnBoundsChanged");
+}
+
+void AppSwapResponsiveLabOverlayView::Layout(PassKey) {
+  canvas_view_->SetBoundsRect(GetLocalBounds());
+
+  const gfx::Size minimap_size = minimap_view_->GetPreferredSize();
+  const gfx::Rect local_bounds = GetLocalBounds();
+  minimap_view_->SetBoundsRect(gfx::Rect(
+      local_bounds.right() - minimap_size.width() - kMinimapMargin,
+      local_bounds.bottom() - minimap_size.height() - kMinimapMargin,
+      minimap_size.width(), minimap_size.height()));
+
+  minimap_view_->Refresh();
+  LogState("Layout");
+}
+
+void AppSwapResponsiveLabOverlayView::AddedToWidget() {
+#if defined(USE_AURA)
+  // Registered on the whole browser window, not just this view's own
+  // bounds -- a pre-target handler has no narrower attachment point, and
+  // its own early-out checks (not a Ctrl+Wheel event, or outside
+  // canvas_view_'s bounds) keep it a no-op for everything else. See
+  // AppSwapResponsiveLabWheelInterceptorAura's class comment for why this
+  // exists at all.
+  if (aura::Window* window = GetWidget()->GetNativeView()) {
+    wheel_interceptor_ =
+        std::make_unique<AppSwapResponsiveLabWheelInterceptorAura>(
+            canvas_view_);
+    window->AddPreTargetHandler(wheel_interceptor_.get());
+  }
+#endif
+#if BUILDFLAG(IS_MAC)
+  // See AppSwapResponsiveLabWheelObserverMac's own comment for why this
+  // exists (the Aura pre-target handler above has no macOS equivalent) and
+  // its accepted trade-off versus that Aura version. Its constructor reads
+  // GetWidget() itself, so it must be constructed here, after this view is
+  // actually attached to one.
+  wheel_observer_mac_ =
+      std::make_unique<AppSwapResponsiveLabWheelObserverMac>(canvas_view_);
+#endif
+}
+
+void AppSwapResponsiveLabOverlayView::RemovedFromWidget() {
+#if defined(USE_AURA)
+  if (wheel_interceptor_) {
+    if (aura::Window* window = GetWidget()->GetNativeView()) {
+      window->RemovePreTargetHandler(wheel_interceptor_.get());
+    }
+    wheel_interceptor_.reset();
+  }
+#endif
+#if BUILDFLAG(IS_MAC)
+  wheel_observer_mac_.reset();
+#endif
+}
+
+void AppSwapResponsiveLabOverlayView::LogState(const char* where) {
+  gfx::Point origin_in_screen;
+  gfx::Point origin_in_widget;
+  if (GetWidget()) {
+    views::View::ConvertPointToScreen(this, &origin_in_screen);
+    views::View::ConvertPointToWidget(this, &origin_in_widget);
+  }
+  LOG(ERROR) << "[ResponsiveLab] OverlayView::LogState(" << where
+             << "): this bounds=" << bounds().ToString()
+             << " visible=" << GetVisible() << " widget=" << GetWidget()
+             << " this layer=" << layer()
+             << " origin_in_widget=" << origin_in_widget.ToString()
+             << " origin_in_screen=" << origin_in_screen.ToString()
+             << " widget window bounds="
+             << (GetWidget() ? GetWidget()->GetWindowBoundsInScreen().ToString()
+                             : "n/a")
+             << " widget client bounds="
+             << (GetWidget()
+                     ? GetWidget()->GetClientAreaBoundsInScreen().ToString()
+                     : "n/a")
+             << " current_owner_=" << current_owner_
+             << " canvas bounds=" << canvas_view_->bounds().ToString()
+             << " canvas layer=" << canvas_view_->layer()
+             << " canvas has_content=" << canvas_view_->has_content()
+             << " content preferred_size="
+             << canvas_view_->ContentPreferredSize().ToString();
+}
+
+BEGIN_METADATA(AppSwapResponsiveLabOverlayView)
+END_METADATA
diff --git a/chrome/browser/ui/views/app_swap/app_swap_responsive_lab_overlay_view.h b/chrome/browser/ui/views/app_swap/app_swap_responsive_lab_overlay_view.h
new file mode 100644
index 0000000000000..3919b18d81f3f
--- /dev/null
+++ b/chrome/browser/ui/views/app_swap/app_swap_responsive_lab_overlay_view.h
@@ -0,0 +1,168 @@
+// Copyright 2026 The AppSwap Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_VIEWS_APP_SWAP_APP_SWAP_RESPONSIVE_LAB_OVERLAY_VIEW_H_
+#define CHROME_BROWSER_UI_VIEWS_APP_SWAP_APP_SWAP_RESPONSIVE_LAB_OVERLAY_VIEW_H_
+
+#include <memory>
+#include <string>
+#include <vector>
+
+#include "base/memory/raw_ptr.h"
+#include "build/build_config.h"
+#include "content/public/browser/web_contents_observer.h"
+#include "ui/base/metadata/metadata_header_macros.h"
+#include "ui/views/view.h"
+
+class AppSwapResponsiveLabCanvasView;
+class AppSwapResponsiveLabMinimapView;
+class GURL;
+class Profile;
+
+#if defined(USE_AURA)
+class AppSwapResponsiveLabWheelInterceptorAura;
+#endif
+#if BUILDFLAG(IS_MAC)
+class AppSwapResponsiveLabWheelObserverMac;
+#endif
+
+namespace content {
+class WebContents;
+}  // namespace content
+
+namespace gfx {
+class Rect;
+}  // namespace gfx
+
+// Shown in place of ContentsWebView, full-size, while a tab's
+// AppSwapResponsiveLabTabHelper is active (see ContentsContainerView, which
+// constructs and lays out this view alongside its other overlay siblings,
+// and AppSwapResponsiveLabButton, which is what actually toggles it and
+// keeps its content in sync with the active tab).
+//
+// This view is one-per-content-slot (like ContentsWebView itself), not
+// one-per-tab: it only ever displays whichever tab is currently active, and
+// re-points itself to a different tab's content via ShowGridFor(). The grid
+// content it displays for a given tab -- one views::WebView per device
+// preset, hosted in a pannable/zoomable AppSwapResponsiveLabCanvasView, with
+// an AppSwapResponsiveLabMinimapView overview anchored to the bottom-right
+// corner -- is actually owned by that tab's own
+// AppSwapResponsiveLabGridHolder (content::WebContentsUserData), not by this
+// view; ShowGridFor()/HideCurrent() borrow and return that content (plus its
+// pan/zoom state) so that switching away from a tab and back shows the exact
+// same, still-live grid at the same viewport instead of tearing it down and
+// rebuilding (and re-navigating, and re-centering) it every time.
+//
+// Each grid cell owns a real content::WebContents, created and navigated the
+// same way AppSwapVersionPickerDialog's own WebView does (see
+// CreateAppSwapVersionPickerSubpageView): the views::WebView creates its
+// WebContents itself, via LoadInitialURL(), rather than being handed an
+// already-navigating WebContents built independently via
+// content::WebContents::Create(). That's not an arbitrary style choice --
+// a WebContents built separately and only later attached via
+// WebView::SetWebContents() never gets a real RenderWidgetHostView/
+// compositor surface wired up in time for its already-in-flight navigation
+// to actually paint anything, which is what produced a blank white grid
+// with unresponsive right-click (no working hit-testing) the first time
+// this shipped. Letting the WebView own creation from the start avoids that
+// entirely, and is the only WebContents-creation path this codebase has
+// already proven to work for a WebView hosted outside the normal tab strip.
+class AppSwapResponsiveLabOverlayView : public views::View,
+                                        public content::WebContentsObserver {
+  METADATA_HEADER(AppSwapResponsiveLabOverlayView, views::View)
+
+ public:
+  // One grid cell's device preset -- just the name/size for the header
+  // label and the fixed WebView size; no WebContents here (see the class
+  // comment on why this view creates its own rather than being handed one).
+  struct DevicePreset {
+    std::string name;
+    int width;
+    int height;
+  };
+
+  AppSwapResponsiveLabOverlayView();
+  AppSwapResponsiveLabOverlayView(const AppSwapResponsiveLabOverlayView&) =
+      delete;
+  AppSwapResponsiveLabOverlayView& operator=(
+      const AppSwapResponsiveLabOverlayView&) = delete;
+  ~AppSwapResponsiveLabOverlayView() override;
+
+  // Shows `web_contents`'s grid, becoming visible if it wasn't already. If
+  // this view is already showing `web_contents`'s grid, does nothing (no
+  // rebuild, no re-navigation, no viewport reset). Otherwise detaches
+  // whatever was previously shown (handing it, and its pan/zoom, back to
+  // its own tab's AppSwapResponsiveLabGridHolder untouched) and takes
+  // `web_contents`'s grid from its holder -- building it fresh, one cell
+  // per entry in `presets` navigated to `url`, only if that holder didn't
+  // already have one cached from an earlier activation.
+  void ShowGridFor(content::WebContents* web_contents,
+                   Profile* profile,
+                   const GURL& url,
+                   std::vector<DevicePreset> presets);
+
+  // Detaches whatever's currently shown (if anything), handing it back to
+  // its tab's AppSwapResponsiveLabGridHolder for safekeeping, and hides
+  // this view. Does NOT discard the grid -- callers that want the grid
+  // itself gone (an explicit toggle-off, as opposed to merely switching
+  // tabs away from one with an active grid) must also call
+  // AppSwapResponsiveLabGridHolder::Discard() for that tab.
+  void HideCurrent();
+
+  // views::View:
+  void OnBoundsChanged(const gfx::Rect& previous_bounds) override;
+  void Layout(PassKey) override;
+  void AddedToWidget() override;
+  void RemovedFromWidget() override;
+
+  // content::WebContentsObserver:
+  void WebContentsDestroyed() override;
+
+ private:
+  // Detaches the current child from canvas_view_ (if any), handing it (and
+  // its pan/zoom) back to its tab's holder, and returns whether anything
+  // was detached. Clears current_owner_ and stops observation either way.
+  // Shared by ShowGridFor(), HideCurrent(), and WebContentsDestroyed().
+  void DetachCurrent();
+
+  // Passed to canvas_view_ as its change callback -- refreshes the minimap
+  // whenever the canvas's content, pan, or zoom changes.
+  void OnCanvasChanged();
+
+  // TEMPORARY debug helper: logs this view's own state plus the canvas's
+  // current content/viewport. Remove once the blank-grid bug is found.
+  void LogState(const char* where);
+
+  // The tab whose grid is currently attached to canvas_view_, or null if
+  // nothing is currently shown. Non-owning -- the grid content's real
+  // owner is always either canvas_view_ (while attached) or that tab's
+  // AppSwapResponsiveLabGridHolder (while detached); this is just a key.
+  // Watched via WebContentsObserver so a tab closing while its grid is the
+  // one attached here can't leave this dangling (see WebContentsDestroyed).
+  raw_ptr<content::WebContents> current_owner_ = nullptr;
+
+  raw_ptr<AppSwapResponsiveLabCanvasView> canvas_view_ = nullptr;
+  raw_ptr<AppSwapResponsiveLabMinimapView> minimap_view_ = nullptr;
+
+  // A grid cell's WebView hosts a real native renderer window, which
+  // receives wheel input directly rather than through normal views::View
+  // dispatch -- so canvas_view_'s own Ctrl+Wheel-to-zoom handling never
+  // sees the event when the cursor is over a cell instead of empty canvas
+  // background. This intercepts it one level up, before native content
+  // gets it. Aura-only (see the .cc); null on other platforms, so
+  // Ctrl+Wheel there only zooms from empty background, same as before.
+#if defined(USE_AURA)
+  std::unique_ptr<AppSwapResponsiveLabWheelInterceptorAura> wheel_interceptor_;
+#endif
+
+  // macOS equivalent of wheel_interceptor_ above -- Views on macOS doesn't
+  // use aura::Window, so there's no ui::EventHandler pre-target mechanism
+  // to hook into there. See AppSwapResponsiveLabWheelObserverMac's own
+  // comment for the (accepted) trade-off versus the Aura version.
+#if BUILDFLAG(IS_MAC)
+  std::unique_ptr<AppSwapResponsiveLabWheelObserverMac> wheel_observer_mac_;
+#endif
+};
+
+#endif  // CHROME_BROWSER_UI_VIEWS_APP_SWAP_APP_SWAP_RESPONSIVE_LAB_OVERLAY_VIEW_H_
diff --git a/chrome/browser/ui/views/app_swap/app_swap_responsive_lab_wheel_interceptor_aura.cc b/chrome/browser/ui/views/app_swap/app_swap_responsive_lab_wheel_interceptor_aura.cc
new file mode 100644
