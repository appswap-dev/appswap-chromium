+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/views/app_swap/app_swap_responsive_lab_cell_view.h"
+
+#include <algorithm>
+#include <memory>
+#include <string>
+#include <utility>
+
+#include "base/functional/bind.h"
+#include "base/functional/callback.h"
+#include "base/numerics/safe_conversions.h"
+#include "base/strings/strcat.h"
+#include "base/strings/string_number_conversions.h"
+#include "base/strings/utf_string_conversions.h"
+#include "chrome/browser/app_swap/app_swap_responsive_lab_cell_tag.h"
+#include "chrome/browser/profiles/profile.h"
+#include "components/zoom/zoom_controller.h"
+#include "content/public/browser/navigation_controller.h"
+#include "content/public/browser/render_widget_host.h"
+#include "content/public/browser/web_contents.h"
+#include "cc/paint/paint_flags.h"
+#include "ui/base/metadata/metadata_impl_macros.h"
+#include "ui/color/color_id.h"
+#include "ui/color/color_provider.h"
+#include "ui/gfx/canvas.h"
+#include "ui/gfx/geometry/insets.h"
+#include "ui/gfx/geometry/rect.h"
+#include "ui/gfx/geometry/rect_f.h"
+#include "ui/gfx/geometry/rounded_corners_f.h"
+#include "ui/gfx/geometry/size.h"
+#include "ui/gfx/shadow_value.h"
+#include "ui/gfx/skia_paint_util.h"
+#include "ui/views/controls/label.h"
+#include "ui/views/controls/webview/webview.h"
+#include "ui/views/layout/box_layout.h"
+#include "ui/views/view_class_properties.h"
+#include "url/gurl.h"
+
+namespace {
+
+constexpr int kHeaderBottomMargin = 6;
+
+// The card's rounded corners at 100%. Scales with the canvas zoom, so a
+// zoomed-in cell doesn't look like a differently-designed object.
+constexpr float kCardCornerRadius = 6.0f;
+
+// A ring of the card's own fill between the page and the border.
+//
+// Not decoration: the page's rounded corner is a clip the compositor
+// applies to its layer, and the border is a stroke Skia antialiases into
+// this view's canvas. Two independently antialiased curves meeting at the
+// same pixels disagree about coverage along the arc, which showed up as a
+// stepped, fringed corner. One pixel of separation is enough that neither
+// has to blend against the other.
+constexpr float kCardBorderGap = 1.0f;
+
+constexpr float kCardBorderWidth = 1.0f;
+
+// Material elevation for the card's drop shadow. Low: these are pages laid
+// on a board, not floating dialogs, and a heavy shadow at three cells wide
+// reads as clutter.
+constexpr int kCardShadowElevation = 3;
+
+gfx::ShadowValues CardShadows() {
+  return gfx::ShadowValue::MakeMdShadowValues(kCardShadowElevation);
+}
+
+}  // namespace
+
+// A WebView whose *native* renderer surface stays pinned at `native_size`,
+// regardless of this view's own (canvas-zoom-scaled) bounds -- see
+// AppSwapResponsiveLabCellView::ApplyScale() for why that matters.
+//
+// A one-time NativeViewHost::SetNativeViewSize() call isn't enough:
+// views::WebView::OnBoundsChanged() unconditionally resets it back to
+// "match my own bounds" (holder()->SetNativeViewSize(gfx::Size()), an
+// empty size meaning "no override") on *every* call, which happens on
+// essentially every layout pass -- including every time the canvas zoom
+// changes this view's bounds. Re-pinning it right after the base class's
+// own OnBoundsChanged() runs is what actually makes it stick.
+class AppSwapResponsiveLabPinnedSizeWebView : public views::WebView {
+  METADATA_HEADER(AppSwapResponsiveLabPinnedSizeWebView, views::WebView)
+
+ public:
+  AppSwapResponsiveLabPinnedSizeWebView(Profile* profile,
+                                        const gfx::Size& native_size)
+      : views::WebView(profile), native_size_(native_size) {}
+
+  // Runs whenever this cell's page takes focus, which is how the lab
+  // learns which cell the user is working in -- and therefore which one a
+  // DevTools window opened on the lab should follow.
+  //
+  // Hooked on the WebContents rather than on Views focus: a cell is a
+  // native surface reparented into the Views tree, so a click lands in the
+  // renderer and never reaches this view's OnMousePressed().
+  void SetOnFocusedCallback(base::RepeatingClosure callback) {
+    on_focused_ = std::move(callback);
+  }
+
+  // Re-pins the renderer to `native_size` while laying this view out at
+  // `laid_out_size` (the device size times the canvas zoom). The two are
+  // deliberately independent: NativeViewHost divides them to get the scale
+  // it applies to the hosted layer, which is what magnifies a
+  // fixed-resolution surface instead of resizing and reflowing the page.
+  //
+  // Applied immediately as well as on the next layout pass: a change that
+  // happens to keep this view's bounds the same size (rotating a square
+  // viewport, editing nothing but the device pixel ratio) never triggers
+  // OnBoundsChanged(), so relying on that alone would leave the native
+  // surface stale.
+  void SetSizes(const gfx::Size& native_size, const gfx::Size& laid_out_size) {
+    native_size_ = native_size;
+    SetPreferredSize(laid_out_size);
+    holder()->SetNativeViewSize(native_size_);
+  }
+
+  void OnBoundsChanged(const gfx::Rect& previous_bounds) override {
+    views::WebView::OnBoundsChanged(previous_bounds);
+    holder()->SetNativeViewSize(native_size_);
+  }
+
+  void OnWebContentsFocused(
+      content::RenderWidgetHost* render_widget_host) override {
+    views::WebView::OnWebContentsFocused(render_widget_host);
+    if (on_focused_) {
+      on_focused_.Run();
+    }
+  }
+
+ private:
+  gfx::Size native_size_;
+  base::RepeatingClosure on_focused_;
+};
+
+BEGIN_METADATA(AppSwapResponsiveLabPinnedSizeWebView)
+END_METADATA
+
+AppSwapResponsiveLabCellView::AppSwapResponsiveLabCellView(
+    Profile* profile,
+    base::WeakPtr<AppSwapResponsiveLabSession> session,
+    const AppSwapDevicePreset& preset,
+    const GURL& url)
+    : preset_(preset), session_(std::move(session)) {
+  SetLayoutManager(std::make_unique<views::BoxLayout>(
+      views::BoxLayout::Orientation::kVertical));
+
+  header_ = AddChildView(std::make_unique<views::Label>());
+  header_->SetHorizontalAlignment(gfx::ALIGN_LEFT);
+  UpdateHeaderText();
+
+  base_font_ = header_->font_list();
+
+  const gfx::Size preset_size = preset_.EffectiveSize();
+  // AppSwapResponsiveLabPinnedSizeWebView (not a plain views::WebView) is
+  // what makes the *actual* renderer surface stay at the device preset's
+  // real size while this view is laid out `scale` times larger. Without
+  // the pin, NativeViewHost::Layout() would size the real
+  // RenderWidgetHostView to `preset_size * canvas_scale` -- an actual
+  // resize the page reflows to, defeating the entire point of comparing
+  // fixed device widths side by side. With it,
+  // NativeViewHostAura::ShowWidget() takes its scale branch instead: the
+  // renderer keeps rendering at `preset_size` always, and the zoom only
+  // magnifies that fixed-resolution surface.
+  auto web_view = std::make_unique<AppSwapResponsiveLabPinnedSizeWebView>(
+      profile, preset_size);
+  web_view->SetPreferredSize(preset_size);
+  web_view->SetOnFocusedCallback(base::BindRepeating(
+      [](base::WeakPtr<AppSwapResponsiveLabSession> session,
+         const std::string& viewport_id) {
+        if (session) {
+          session->SetFocusedViewport(viewport_id);
+        }
+      },
+      session_, preset_.id));
+  web_view->LoadInitialURL(url);
+  web_view_ = AddChildView(std::move(web_view));
+
+  // ZoomController's default mode zooms every WebContents showing the
+  // same origin together (see its own ZOOM_MODE_DEFAULT comment) -- so
+  // without this, Ctrl+Wheel over one grid cell (Chrome's native
+  // per-page zoom shortcut) would also zoom every other cell showing the
+  // same site, *on top of* whatever AppSwapResponsiveLabCanvasView's own
+  // Ctrl+Wheel handling already does when the same gesture starts over
+  // empty canvas background -- two independent zoom mechanisms
+  // compounding on the same pixels. Each grid cell is meant to render at
+  // a fixed, real device width/height regardless of the canvas's own
+  // zoom, so native per-page zoom has no business applying to it at all.
+  zoom::ZoomController::CreateForWebContents(web_view_->web_contents());
+  zoom::ZoomController::FromWebContents(web_view_->web_contents())
+      ->SetZoomMode(zoom::ZoomController::ZOOM_MODE_DISABLED);
+
+  // Explicitly, rather than leaving it to the SetScale() the grid makes
+  // right after construction: that early-returns when the scale it is
+  // handed is the one this cell already holds, which is exactly the case
+  // for a cell created while the canvas is at 100%.
+  ApplyScale();
+
+  // What lets anything handed only this cell's WebContents find its way back
+  // to the lab -- the context menu's Inspect command, which routes into the
+  // lab's own DevTools window rather than opening a second one per cell.
+  AppSwapResponsiveLabCellTag::CreateForWebContents(
+      web_view_->web_contents(), session_, preset_.id);
+
+  // Last, and only once the WebContents actually exists: this is what
+  // attaches the viewport's protocol client and applies its emulation.
+  if (session_) {
+    session_->AttachViewportContents(preset_.id, web_view_->web_contents());
+  }
+}
+
+AppSwapResponsiveLabCellView::~AppSwapResponsiveLabCellView() {
+  // The session outlives this view in the normal case (it's a
+  // WebContentsUserData on the previewed tab, and the grid is torn down
+  // first), but not when the tab itself is closing -- hence the WeakPtr.
+  if (session_) {
+    session_->DetachViewportContents(preset_.id);
+  }
+}
+
+void AppSwapResponsiveLabCellView::SetPreviewedUrl(const GURL& url) {
+  content::WebContents* contents = web_view_->web_contents();
+  if (!contents || !url.is_valid() ||
+      contents->GetLastCommittedURL() == url) {
+    return;
+  }
+  // The same load views::WebView::LoadInitialURL() does, which is not
+  // reusable here: it is documented for the first navigation only, and it
+  // also sizes the WebContents -- which would undo this cell's size pin.
+  contents->GetController().LoadURL(url, content::Referrer(),
+                                    ui::PAGE_TRANSITION_AUTO_TOPLEVEL,
+                                    std::string());
+}
+
+gfx::Rect AppSwapResponsiveLabCellView::viewport_bounds() const {
+  return web_view_->bounds();
+}
+
+gfx::RectF AppSwapResponsiveLabCellView::CardBounds() const {
+  return gfx::RectF(web_view_->bounds());
+}
+
+float AppSwapResponsiveLabCellView::CardCornerRadius() const {
+  return kCardCornerRadius * scale_;
+}
+
+void AppSwapResponsiveLabCellView::AddedToWidget() {
+  views::View::AddedToWidget();
+  ApplyCardCorners();
+}
+
+void AppSwapResponsiveLabCellView::ApplyCardCorners() {
+  // See the header: the radius is pre-scaled only when nothing downstream
+  // will scale it. Getting this backwards leaves the page's corners and the
+  // border drawn around them rounded by different amounts -- four times
+  // apart at the minimum zoom.
+  const bool renderer_scales = session_ && session_->inspection_allowed();
+  web_view_->holder()->SetNativeViewCornerRadii(gfx::RoundedCornersF(
+      renderer_scales ? CardCornerRadius() : kCardCornerRadius));
+}
+
+void AppSwapResponsiveLabCellView::OnPaint(gfx::Canvas* canvas) {
+  views::View::OnPaint(canvas);
+
+  const gfx::RectF card = CardBounds();
+  if (card.IsEmpty()) {
+    return;
+  }
+  const float radius = CardCornerRadius();
+  const ui::ColorProvider* colors = GetColorProvider();
+
+  // The card proper: the page's rectangle grown by the gap, so the fill
+  // shows as a ring around the page. Concentric with the page's own corner,
+  // so the ring stays an even width all the way round the arc.
+  gfx::RectF fill_bounds = card;
+  fill_bounds.Outset(kCardBorderGap);
+  const float fill_radius = radius + kCardBorderGap;
+
+  // Filled, not just shadowed: the fill is what the shadow attaches to, it
+  // is what the gap ring is made of, and it keeps the card from being a
+  // hole in the board for the frame or two before the renderer has anything
+  // to show.
+  cc::PaintFlags fill_flags;
+  fill_flags.setAntiAlias(true);
+  fill_flags.setStyle(cc::PaintFlags::kFill_Style);
+  fill_flags.setColor(colors->GetColor(ui::kColorSysSurface));
+  fill_flags.setLooper(gfx::CreateShadowDrawLooper(CardShadows()));
+  canvas->DrawRoundRect(fill_bounds, fill_radius, fill_flags);
+
+  // Centred half a pixel outside the fill, so the whole stroke lands on the
+  // board rather than half of it covering the ring it is supposed to sit
+  // beside.
+  gfx::RectF border = fill_bounds;
+  border.Outset(kCardBorderWidth / 2.0f);
+  cc::PaintFlags border_flags;
+  border_flags.setAntiAlias(true);
+  border_flags.setStyle(cc::PaintFlags::kStroke_Style);
+  border_flags.setStrokeWidth(kCardBorderWidth);
+  border_flags.setColor(colors->GetColor(ui::kColorSysNeutralOutline));
+  canvas->DrawRoundRect(border, fill_radius + kCardBorderWidth / 2.0f,
+                        border_flags);
+}
+
+void AppSwapResponsiveLabCellView::SetPreset(
+    const AppSwapDevicePreset& preset) {
+  if (preset_ == preset) {
+    return;
+  }
+  preset_ = preset;
+  UpdateHeaderText();
+  ApplyScale();
+}
+
+void AppSwapResponsiveLabCellView::SetScale(float scale) {
+  if (scale_ == scale) {
+    return;
+  }
+  scale_ = scale;
+  ApplyScale();
+}
+
+void AppSwapResponsiveLabCellView::ApplyScale() {
+  const gfx::Size device_size = preset_.EffectiveSize();
+  const gfx::Size laid_out_size(
+      base::ClampRound(device_size.width() * scale_),
+      base::ClampRound(device_size.height() * scale_));
+
+  // Who applies the zoom to the page depends on whether this viewport has a
+  // protocol client.
+  //
+  // With one, the renderer does it: it is told to lay out at the device's
+  // CSS size and rasterize the result at `scale`, so text stays sharp at
+  // any zoom. The surface then already *is* the laid-out size and must not
+  // be pinned, or NativeViewHost would add a second scale on top of it.
+  //
+  // Without one -- enterprise policy can deny developer tools, and the lab
+  // still works without them -- the surface is pinned at the device size
+  // and NativeViewHost magnifies it. That is softer when zoomed out, but it
+  // is the only way to keep the page from reflowing to the zoomed size,
+  // which would defeat the point of comparing fixed device widths.
+  const bool renderer_scales = session_ && session_->inspection_allowed();
+  web_view_->SetSizes(renderer_scales ? gfx::Size() : device_size,
+                      laid_out_size);
+
+  // Margins, not padding: the shadow, the gap and the border are all drawn
+  // outside the renderer's own rectangle, and without room reserved for
+  // them inside this cell they would be drawn over by the neighbour or
+  // clipped at the row's edge. GetMargin() returns negative insets, so this
+  // subtracts them.
+  //
+  // The shadow's share scales with the canvas, like the corner radius and
+  // the header font do, so a zoomed-out cell is the same object seen
+  // smaller rather than a small page carrying a full-size shadow. The ring
+  // does not: it is a hairline at every zoom, and scaling it away would
+  // leave the border with nowhere to land.
+  const gfx::Insets shadow = gfx::ShadowValue::GetMargin(CardShadows());
+  const int ring = base::ClampCeil(kCardBorderGap + kCardBorderWidth);
+  const auto scaled = [this, ring](int edge) {
+    return base::ClampRound(-edge * scale_) + ring;
+  };
+  web_view_->SetProperty(
+      views::kMarginsKey,
+      gfx::Insets::TLBR(scaled(shadow.top()), scaled(shadow.left()),
+                        scaled(shadow.bottom()), scaled(shadow.right())));
+
+  // The header scales with the cell rather than staying a fixed size, so
+  // the canvas keeps the same proportions at every zoom level. A derived
+  // font rather than a scale transform on the label: text stays crisp, and
+  // a transform here would land on the label's painting without moving the
+  // bounds the row lays out against.
+  ApplyCardCorners();
+
+  const int base_size = base_font_.GetFontSize();
+  const int scaled_size = std::max(1, base::ClampRound(base_size * scale_));
+  header_->SetFontList(base_font_.DeriveWithSizeDelta(scaled_size - base_size));
+  // The gap under it scales too, or a zoomed-out cell carries a full-size
+  // gap under a three-pixel label.
+  header_->SetProperty(
+      views::kMarginsKey,
+      gfx::Insets::TLBR(0, 0, base::ClampRound(kHeaderBottomMargin * scale_),
+                        0));
+
+  InvalidateLayout();
+}
+
+void AppSwapResponsiveLabCellView::UpdateHeaderText() {
+  const gfx::Size size = preset_.EffectiveSize();
+  header_->SetText(base::UTF8ToUTF16(
+      base::StrCat({preset_.name, "  ", base::NumberToString(size.width()),
+                    " × ", base::NumberToString(size.height())})));
+}
+
+BEGIN_METADATA(AppSwapResponsiveLabCellView)
+END_METADATA
