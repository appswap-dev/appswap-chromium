diff --git a/chrome/browser/ui/views/app_swap/app_swap_responsive_lab_grid_holder.h b/chrome/browser/ui/views/app_swap/app_swap_responsive_lab_grid_holder.h
new file mode 100644
index 0000000000000..9d579336150fb
--- /dev/null
+++ b/chrome/browser/ui/views/app_swap/app_swap_responsive_lab_grid_holder.h
@@ -0,0 +1,70 @@
+// Copyright 2026 The AppSwap Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_VIEWS_APP_SWAP_APP_SWAP_RESPONSIVE_LAB_GRID_HOLDER_H_
+#define CHROME_BROWSER_UI_VIEWS_APP_SWAP_APP_SWAP_RESPONSIVE_LAB_GRID_HOLDER_H_
+
+#include <memory>
+
+#include "content/public/browser/web_contents_user_data.h"
+
+class AppSwapResponsiveLabGridView;
+class AppSwapResponsiveLabSession;
+class Profile;
+
+// Keeps one tab's Responsive Lab grid view alive across tab switches.
+//
+// That is all this does now. Everything about *what* the grid shows -- the
+// viewport list, each viewport's device preset and protocol client, the
+// canvas pan/zoom -- lives in AppSwapResponsiveLabSession, which is
+// Views-agnostic and can therefore be reached by the panel's Mojo page
+// handler too. What is left here is the one thing a Views-agnostic class
+// cannot hold: the views::View itself.
+//
+// AppSwapResponsiveLabOverlayView is one-per-content-slot, not one-per-tab
+// (see its own class comment), so it can't hold each tab's grid as a member
+// either; it borrows this class's grid_view_ for as long as this tab is the
+// one being displayed (TakeOrBuildGridView()) and hands it back the moment
+// another tab needs the slot (PutBackGridView()) -- which is what lets
+// switching away and back show the *same* grid, with its pages still
+// loaded, instead of a freshly reloaded one.
+class AppSwapResponsiveLabGridHolder
+    : public content::WebContentsUserData<AppSwapResponsiveLabGridHolder> {
+ public:
+  ~AppSwapResponsiveLabGridHolder() override;
+
+  AppSwapResponsiveLabGridHolder(const AppSwapResponsiveLabGridHolder&) =
+      delete;
+  AppSwapResponsiveLabGridHolder& operator=(
+      const AppSwapResponsiveLabGridHolder&) = delete;
+
+  // Returns this tab's grid view: the one already held (from a previous
+  // PutBackGridView()) if there is one, or a freshly built one bound to
+  // `session` otherwise. Ownership transfers to the caller; this class
+  // holds nothing in between a Take and its matching PutBack.
+  std::unique_ptr<AppSwapResponsiveLabGridView> TakeOrBuildGridView(
+      Profile* profile,
+      AppSwapResponsiveLabSession* session);
+
+  // Called when this tab is switched away from (or the browser is closing)
+  // while its grid is still live -- keeps it (and every WebView/WebContents
+  // in it) alive, detached, for a possible later reactivation.
+  void PutBackGridView(std::unique_ptr<AppSwapResponsiveLabGridView> grid_view);
+
+  // Discards any held grid view -- called on an explicit toggle-off (as
+  // opposed to merely switching tabs away from an active grid), so the
+  // extra renderer processes it holds don't linger once the user has
+  // actually turned Responsive Lab off for this tab.
+  void Discard();
+
+ private:
+  friend class content::WebContentsUserData<AppSwapResponsiveLabGridHolder>;
+  explicit AppSwapResponsiveLabGridHolder(content::WebContents* web_contents);
+
+  std::unique_ptr<AppSwapResponsiveLabGridView> grid_view_;
+
+  WEB_CONTENTS_USER_DATA_KEY_DECL();
+};
+
+#endif  // CHROME_BROWSER_UI_VIEWS_APP_SWAP_APP_SWAP_RESPONSIVE_LAB_GRID_HOLDER_H_
diff --git a/chrome/browser/ui/views/app_swap/app_swap_responsive_lab_grid_view.cc b/chrome/browser/ui/views/app_swap/app_swap_responsive_lab_grid_view.cc
new file mode 100644
index 0000000000000..aedc3e82e08c5
--- /dev/null
+++ b/chrome/browser/ui/views/app_swap/app_swap_responsive_lab_grid_view.cc
@@ -0,0 +1,190 @@
+// Copyright 2026 The AppSwap Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/views/app_swap/app_swap_responsive_lab_grid_view.h"
+
+#include <memory>
+#include <vector>
+
+#include "base/numerics/safe_conversions.h"
+#include "chrome/browser/ui/views/app_swap/app_swap_responsive_lab_cell_view.h"
+#include "ui/base/metadata/metadata_impl_macros.h"
+#include "ui/color/color_id.h"
+#include "ui/gfx/geometry/insets.h"
+#include "ui/gfx/geometry/rect.h"
+#include "ui/views/background.h"
+#include "ui/views/layout/box_layout.h"
+#include "ui/views/view_utils.h"
+
+namespace {
+
+constexpr int kCellSpacing = 16;
+
+}  // namespace
+
+AppSwapResponsiveLabGridView::AppSwapResponsiveLabGridView(
+    Profile* profile,
+    AppSwapResponsiveLabSession* session)
+    : profile_(profile), session_(session->GetWeakPtr()) {
+  // The canvas paints its own background behind this row, but this row
+  // covers most of it and is repositioned constantly while panning; an
+  // explicit opaque background keeps every repaint starting from a clean
+  // base rather than from whatever the compositor last left there.
+  // Matches AppSwapResponsiveLabCanvasView's own background -- see there
+  // for why it is this token. The seam between the two must be invisible:
+  // this row is repositioned on every pan, so any difference would read as
+  // a rectangle sliding around behind the cells.
+  SetBackground(views::CreateSolidBackground(ui::kColorSysBaseContainer));
+
+  layout_ = SetLayoutManager(std::make_unique<views::BoxLayout>(
+      views::BoxLayout::Orientation::kHorizontal));
+
+  session_observation_.Observe(session);
+  ApplyScale();
+  Reconcile();
+}
+
+void AppSwapResponsiveLabGridView::SetScale(float scale) {
+  if (scale_ == scale) {
+    return;
+  }
+  scale_ = scale;
+  for (views::View* child : children()) {
+    if (AppSwapResponsiveLabCellView* cell =
+            views::AsViewClass<AppSwapResponsiveLabCellView>(child)) {
+      cell->SetScale(scale_);
+    }
+  }
+  ApplyScale();
+}
+
+gfx::Size AppSwapResponsiveLabGridView::UnscaledPreferredSize() const {
+  const gfx::Size scaled = GetPreferredSize();
+  if (scale_ <= 0) {
+    return scaled;
+  }
+  return gfx::Size(base::ClampRound(scaled.width() / scale_),
+                   base::ClampRound(scaled.height() / scale_));
+}
+
+std::vector<gfx::Rect> AppSwapResponsiveLabGridView::UnscaledCellBounds()
+    const {
+  std::vector<gfx::Rect> bounds;
+  if (scale_ <= 0) {
+    return bounds;
+  }
+  for (const views::View* child : children()) {
+    const AppSwapResponsiveLabCellView* cell =
+        views::AsViewClass<AppSwapResponsiveLabCellView>(child);
+    if (!cell) {
+      continue;
+    }
+    // The device's rectangle, offset into this row's coordinates -- not the
+    // cell's own bounds, which the row stretches to a common height and
+    // which would therefore draw every device the same shape.
+    gfx::Rect laid_out = cell->viewport_bounds();
+    laid_out.Offset(cell->bounds().OffsetFromOrigin());
+    bounds.emplace_back(base::ClampRound(laid_out.x() / scale_),
+                        base::ClampRound(laid_out.y() / scale_),
+                        base::ClampRound(laid_out.width() / scale_),
+                        base::ClampRound(laid_out.height() / scale_));
+  }
+  return bounds;
+}
+
+void AppSwapResponsiveLabGridView::ApplyScale() {
+  const int spacing = base::ClampRound(kCellSpacing * scale_);
+  layout_->set_between_child_spacing(spacing);
+  layout_->set_inside_border_insets(gfx::Insets(spacing));
+  // SizeToPreferredSize(), never SetBoundsRect(gfx::Rect(GetPreferredSize())),
+  // which is what this was: that also moves the view to (0, 0), and this
+  // view's origin is where AppSwapResponsiveLabCanvasView keeps the pan.
+  // Zooming hid the bug, because ZoomBy() re-applies the pan immediately
+  // after scaling. Rotating a viewport did not: that path runs from the
+  // session observer with no canvas involvement, so the canvas snapped back
+  // to its origin on every rotate, add and remove.
+  SizeToPreferredSize();
+}
+
+AppSwapResponsiveLabGridView::~AppSwapResponsiveLabGridView() = default;
+
+void AppSwapResponsiveLabGridView::OnResponsiveLabViewportsChanged() {
+  Reconcile();
+}
+
+void AppSwapResponsiveLabGridView::OnResponsiveLabPreviewedUrlChanged() {
+  if (!session_) {
+    return;
+  }
+  for (views::View* child : children()) {
+    if (AppSwapResponsiveLabCellView* cell =
+            views::AsViewClass<AppSwapResponsiveLabCellView>(child)) {
+      cell->SetPreviewedUrl(session_->previewed_url());
+    }
+  }
+}
+
+void AppSwapResponsiveLabGridView::OnResponsiveLabSessionDestroying() {
+  // The cells are about to lose the session their WebContents are
+  // registered with. They notice via their own WeakPtr; all this view has
+  // to do is stop observing something that is being destroyed.
+  session_observation_.Reset();
+}
+
+void AppSwapResponsiveLabGridView::Reconcile() {
+  if (!session_) {
+    return;
+  }
+
+  // Removals first, so the ordering pass below only ever walks cells that
+  // are still wanted. Backwards, because RemoveChildViewT() shifts every
+  // later index down.
+  const views::View::Views& current = children();
+  for (size_t i = current.size(); i > 0; --i) {
+    AppSwapResponsiveLabCellView* cell =
+        views::AsViewClass<AppSwapResponsiveLabCellView>(current[i - 1]);
+    if (cell && !session_->FindViewport(cell->viewport_id())) {
+      RemoveChildViewT(cell);
+    }
+  }
+
+  const std::vector<AppSwapResponsiveLabSession::Viewport>& viewports =
+      session_->viewports();
+  for (size_t i = 0; i < viewports.size(); ++i) {
+    const AppSwapDevicePreset& preset = viewports[i].preset;
+    AppSwapResponsiveLabCellView* cell = FindCell(preset.id);
+    if (cell) {
+      cell->SetPreset(preset);
+    } else {
+      cell = AddChildView(std::make_unique<AppSwapResponsiveLabCellView>(
+          profile_, session_->GetWeakPtr(), preset,
+          session_->previewed_url()));
+      cell->SetScale(scale_);
+    }
+    ReorderChildView(cell, i);
+  }
+
+  // BoxLayout only positions children once this view itself has a size --
+  // nothing above ever resizes it for us (AppSwapResponsiveLabCanvasView
+  // only ever repositions it via SetPosition()), so it must be sized to its
+  // own preferred size explicitly. Re-done on every reconcile, since adding
+  // or removing a viewport changes what that preferred size is. Sized, not
+  // bounded -- see ApplyScale() for what setting the origin here cost.
+  SizeToPreferredSize();
+}
+
+AppSwapResponsiveLabCellView* AppSwapResponsiveLabGridView::FindCell(
+    const std::string& viewport_id) {
+  for (views::View* child : children()) {
+    AppSwapResponsiveLabCellView* cell =
+        views::AsViewClass<AppSwapResponsiveLabCellView>(child);
+    if (cell && cell->viewport_id() == viewport_id) {
+      return cell;
+    }
+  }
+  return nullptr;
+}
+
+BEGIN_METADATA(AppSwapResponsiveLabGridView)
+END_METADATA
