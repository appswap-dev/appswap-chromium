+#ifndef CHROME_BROWSER_UI_VIEWS_APP_SWAP_APP_SWAP_RESPONSIVE_LAB_CELL_VIEW_H_
+#define CHROME_BROWSER_UI_VIEWS_APP_SWAP_APP_SWAP_RESPONSIVE_LAB_CELL_VIEW_H_
+
+#include <string>
+
+#include "base/memory/raw_ptr.h"
+#include "base/memory/weak_ptr.h"
+#include "chrome/browser/app_swap/app_swap_responsive_lab_session.h"
+#include "chrome/browser/app_swap/app_swap_responsive_lab_types.h"
+#include "ui/base/metadata/metadata_header_macros.h"
+#include "ui/gfx/font_list.h"
+#include "ui/gfx/geometry/rect.h"
+#include "ui/views/view.h"
+
+class AppSwapResponsiveLabPinnedSizeWebView;
+class GURL;
+class Profile;
+
+namespace views {
+class Label;
+}  // namespace views
+
+// One Responsive Lab grid cell: a "name / width x height" header above a
+// fixed-size WebView showing the previewed page at one device preset.
+//
+// Extracted from what used to be a pair of free functions inside
+// AppSwapResponsiveLabGridHolder, which built the whole grid in one pass
+// and then forgot every cell it had made. Being a real class is what lets
+// the grid mutate incrementally -- SetPreset() resizes and re-emulates a
+// cell in place, so rotating one viewport (or editing its size from the
+// panel) doesn't tear down and reload every other cell beside it.
+//
+// This cell owns its WebContents, by way of the views::WebView that
+// creates it via LoadInitialURL(); see AppSwapResponsiveLabOverlayView's
+// class comment for why that particular creation path is the only one that
+// paints correctly here. Because of that, the session can't be the owner,
+// so this cell is what registers the WebContents with it (and clears the
+// registration on destruction) -- which is also what creates and destroys
+// that viewport's CDP client.
+class AppSwapResponsiveLabCellView : public views::View {
+  METADATA_HEADER(AppSwapResponsiveLabCellView, views::View)
+
+ public:
+  AppSwapResponsiveLabCellView(
+      Profile* profile,
+      base::WeakPtr<AppSwapResponsiveLabSession> session,
+      const AppSwapDevicePreset& preset,
+      const GURL& url);
+  AppSwapResponsiveLabCellView(const AppSwapResponsiveLabCellView&) = delete;
+  AppSwapResponsiveLabCellView& operator=(const AppSwapResponsiveLabCellView&) =
+      delete;
+  ~AppSwapResponsiveLabCellView() override;
+
+  const std::string& viewport_id() const { return preset_.id; }
+  const AppSwapDevicePreset& preset() const { return preset_; }
+
+  // The device's own rectangle within this cell, in cell-local coordinates.
+  // Distinct from this view's bounds: the row stretches every cell to a
+  // common height (views::BoxLayout's default cross-axis alignment), so a
+  // short device's cell is taller than the device is. This is the part that
+  // actually renders the page.
+  gfx::Rect viewport_bounds() const;
+
+  // Resizes and relabels this cell in place. Does not navigate, so page
+  // state survives a rotation or a size edit. No-op if `preset` is
+  // unchanged.
+  void SetPreset(const AppSwapDevicePreset& preset);
+
+  // Navigates this cell to `url`, so the grid follows the host tab when the
+  // user types a new address. No-op if the cell is already there -- the
+  // grid fans this out to every cell, and a cell that just loaded the URL
+  // should not reload it.
+  void SetPreviewedUrl(const GURL& url);
+
+  // Lays this cell out `scale` times its device size, keeping the renderer
+  // itself pinned at that device's real pixel size.
+  //
+  // Canvas zoom arrives here as a layout parameter rather than as a
+  // transform on an ancestor view, and that is not a style preference. The
+  // WebContents' compositor layer is reparented into the Views layer tree
+  // (NativeViewHostAura::AttachNativeView, under the
+  // kNativeViewHostManagesLayers feature, which is on by default), so an
+  // ancestor's transform already scales it. NativeViewHost::Layout() then
+  // hands the wrapper widget-space geometry that *also* includes that
+  // transform, and the wrapper applies its own scale on top -- so a
+  // transform lands on hosted web content twice and on painted Views
+  // content once. The grid stayed self-consistent under that, since both
+  // cell size and cell pitch squared together, but the header labels drifted
+  // out of alignment and the zoom readout lied: 150% actually showed 225%.
+  void SetScale(float scale);
+
+  // views::View:
+  void OnPaint(gfx::Canvas* canvas) override;
+  void AddedToWidget() override;
+
+ private:
+  void UpdateHeaderText();
+  void ApplyScale();
+
+  // The card's rounded rect: the renderer's own rectangle, which the page is
+  // clipped to and the border and shadow are drawn around.
+  gfx::RectF CardBounds() const;
+
+  // The radius the border is drawn at, which scales with the canvas zoom.
+  float CardCornerRadius() const;
+
+  // Clips the page itself to the card's corners. Separate from ApplyScale()
+  // because it has to run again once this cell is in a widget: the WebView
+  // has no native wrapper to talk to before then, so a call at construction
+  // time is silently dropped.
+  //
+  // Which radius it passes depends on who is applying the canvas zoom, the
+  // same split ApplyScale() makes. When the renderer scales, its layer is
+  // already at the on-screen size and the radius has to be scaled to match
+  // the border. When the surface is pinned instead, the layer is at the
+  // device's size and magnified afterwards, so the radius is magnified with
+  // it and must be passed unscaled.
+  void ApplyCardCorners();
+
+  AppSwapDevicePreset preset_;
+  float scale_ = 1.0f;
+
+  // The header's font at 100%, captured once so repeated zoom steps derive
+  // from a fixed base rather than compounding each other's rounding.
+  gfx::FontList base_font_;
+  base::WeakPtr<AppSwapResponsiveLabSession> session_;
+
+  raw_ptr<views::Label> header_ = nullptr;
+  raw_ptr<AppSwapResponsiveLabPinnedSizeWebView> web_view_ = nullptr;
+};
+
+#endif  // CHROME_BROWSER_UI_VIEWS_APP_SWAP_APP_SWAP_RESPONSIVE_LAB_CELL_VIEW_H_
