@@ -0,0 +1,90 @@
+// Copyright 2026 The AppSwap Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_VIEWS_APP_SWAP_APP_SWAP_RESPONSIVE_LAB_BUTTON_H_
+#define CHROME_BROWSER_UI_VIEWS_APP_SWAP_APP_SWAP_RESPONSIVE_LAB_BUTTON_H_
+
+#include "base/memory/raw_ptr.h"
+#include "chrome/browser/ui/tabs/tab_change_type.h"
+#include "chrome/browser/ui/tabs/tab_strip_model_observer.h"
+#include "chrome/browser/ui/views/toolbar/toolbar_button.h"
+#include "ui/base/metadata/metadata_header_macros.h"
+
+class BrowserWindowInterface;
+class TabStripModel;
+
+namespace content {
+class WebContents;
+}  // namespace content
+
+namespace tabs {
+class TabInterface;
+}  // namespace tabs
+
+// A toolbar-row toggle button, next to Home/Split-tabs: pressing it replaces
+// the active tab's own content view with a grid of several real viewports
+// of that same page, one per device preset -- see
+// AppSwapResponsiveLabTabHelper (owns the grid's WebContents) and
+// AppSwapResponsiveLabOverlayView (renders them, hosted alongside
+// ContentsWebView in ContentsContainerView). ToolbarButton (rather than a
+// plain ImageButton) is what SplitTabsToolbarButton and HomeButton use for
+// this same toolbar row, and gives this button the same hover/ink-drop/theme
+// handling as its neighbors for free.
+//
+// Lives here (rather than in //chrome/browser/ui/views/app_swap, where its
+// sibling AppSwap buttons live) for the same reason
+// AppSwapProjectSelectorButton does -- see that file's own comment: this
+// button needs BrowserView::GetContentsContainerViewFor(), which only exists
+// inside this target, and this target depends ON views/app_swap, not the
+// other way around, so pulling this button into views/app_swap instead
+// would be a circular dependency.
+//
+// Toggling is per-tab state (AppSwapResponsiveLabTabHelper is a
+// WebContentsUserData), but the actual overlay/ContentsWebView visibility
+// this button drives lives one level up, in whichever ContentsContainerView
+// currently shows the active tab -- so both a toggle click and an active-tab
+// change need to re-sync that container to match the (possibly new) active
+// tab's own helper state. See SyncContentsContainer().
+class AppSwapResponsiveLabButton : public ToolbarButton,
+                                   public TabStripModelObserver {
+  METADATA_HEADER(AppSwapResponsiveLabButton, ToolbarButton)
+
+ public:
+  explicit AppSwapResponsiveLabButton(BrowserWindowInterface* browser);
+  AppSwapResponsiveLabButton(const AppSwapResponsiveLabButton&) = delete;
+  AppSwapResponsiveLabButton& operator=(const AppSwapResponsiveLabButton&) =
+      delete;
+  ~AppSwapResponsiveLabButton() override;
+
+  // TabStripModelObserver:
+  void OnTabStripModelChanged(
+      TabStripModel* tab_strip_model,
+      const TabStripModelChange& change,
+      const TabStripSelectionChange& selection) override;
+  void OnTabChangedAt(tabs::TabInterface* tab,
+                      TabChangeType change_type) override;
+
+ private:
+  void ButtonPressed();
+
+  // Recomputes this button's own visibility/active-visual state from the
+  // active tab's own AppSwapResponsiveLabTabHelper, and re-syncs the
+  // container showing that tab to match.
+  void UpdateForActiveTab();
+
+  // Toggles this button's own "currently active" visual treatment -- a
+  // filled background, the same technique AppSwapRouteGroupTabStripButton
+  // uses for its own badge, simplified to a plain on/off state here.
+  void SetActiveVisual(bool active);
+
+  // Shows/hides `web_contents`'s ContentsWebView vs. its
+  // AppSwapResponsiveLabOverlayView (populating the overlay's grid from the
+  // tab's helper first, if activating). No-op if `web_contents` isn't
+  // currently shown by any ContentsContainerView (e.g. a background tab).
+  void SyncContentsContainer(content::WebContents* web_contents, bool active);
+
+  raw_ptr<BrowserWindowInterface> browser_;
+};
+
+#endif  // CHROME_BROWSER_UI_VIEWS_APP_SWAP_APP_SWAP_RESPONSIVE_LAB_BUTTON_H_
diff --git a/chrome/browser/ui/views/app_swap/app_swap_responsive_lab_canvas_view.cc b/chrome/browser/ui/views/app_swap/app_swap_responsive_lab_canvas_view.cc
new file mode 100644
index 0000000000000..c74efa6760520
--- /dev/null
+++ b/chrome/browser/ui/views/app_swap/app_swap_responsive_lab_canvas_view.cc
@@ -0,0 +1,232 @@
+// Copyright 2026 The AppSwap Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/views/app_swap/app_swap_responsive_lab_canvas_view.h"
+
+#include <algorithm>
+#include <utility>
+
+#include "base/logging.h"
+#include "base/numerics/safe_conversions.h"
+#include "ui/base/metadata/metadata_impl_macros.h"
+#include "ui/color/color_id.h"
+#include "ui/compositor/layer.h"
+#include "ui/events/event.h"
+#include "ui/gfx/geometry/transform.h"
+#include "ui/gfx/geometry/vector2d.h"
+#include "ui/views/background.h"
+
+AppSwapResponsiveLabCanvasView::DetachResult::DetachResult() = default;
+AppSwapResponsiveLabCanvasView::DetachResult::DetachResult(DetachResult&&) =
+    default;
+AppSwapResponsiveLabCanvasView::DetachResult&
+AppSwapResponsiveLabCanvasView::DetachResult::operator=(DetachResult&&) =
+    default;
+AppSwapResponsiveLabCanvasView::DetachResult::~DetachResult() = default;
+
+AppSwapResponsiveLabCanvasView::AppSwapResponsiveLabCanvasView() {
+  // The actual root cause of the browser-window-wide positioning glitch
+  // (grid content painting over the toolbar, "cropped" at the window's
+  // right/bottom edges) turned out to be neither of the two layer-ordering
+  // theories tried earlier: debug logging showed the overlay and this
+  // view's own bounds were correct throughout. The real issue is that
+  // content_ (the grid) legitimately extends outside this view's bounds
+  // the moment it's panned/zoomed -- that's inherent to how zoom-toward-a-
+  // point works (pan_offset_ goes negative to keep the zoomed point fixed
+  // under the cursor) -- and nothing was ever clipping that overflow to
+  // this view's own visible area, so at high zoom the scaled content's
+  // edges paint wherever their transformed position lands, including
+  // above this view's top edge and into the toolbar.
+  //
+  // A layer with SetMasksToBounds() is what actually fixes that (a plain,
+  // non-layered View doesn't clip WebView-hosted native content the way it
+  // clips its own painting), and it happens to *also* be the same
+  // mechanism needed to keep AppSwapResponsiveLabMinimapView's own layer
+  // stacking above the grid's WebView layers -- see the class comment on
+  // why a layer belongs here rather than on the parent overlay (whose
+  // bounds are set externally, precisely, by ContentsContainerView).
+  SetPaintToLayer();
+  layer()->SetMasksToBounds(true);
+
+  // Once this view paints to its own layer, it's a separate compositing
+  // surface -- the overlay's own background (painted into a different
+  // layer) no longer shows through wherever content_ doesn't cover, since
+  // this view never paints anything of its own there. Panning/zooming
+  // constantly changes how much of this view's area content_ covers, so
+  // without an explicit background here that empty area would show
+  // whatever undefined content the compositor happens to have, not a
+  // deliberate canvas color.
+  SetBackground(views::CreateSolidBackground(ui::kColorWindowBackground));
+}
+AppSwapResponsiveLabCanvasView::~AppSwapResponsiveLabCanvasView() = default;
+
+views::View* AppSwapResponsiveLabCanvasView::SetContent(
+    std::unique_ptr<views::View> content,
+    const gfx::Vector2dF& pan_offset,
+    float scale) {
+  content_ = AddChildView(std::move(content));
+  pan_offset_ = pan_offset;
+  scale_ = std::clamp(scale, kMinScale, kMaxScale);
+  ApplyPanAndScale();
+  NotifyChanged();
+  return content_;
+}
+
+AppSwapResponsiveLabCanvasView::DetachResult
+AppSwapResponsiveLabCanvasView::DetachContent() {
+  DetachResult result;
+  result.pan_offset = pan_offset_;
+  result.scale = scale_;
+  if (content_) {
+    result.content = RemoveChildViewT(content_.get());
+    content_ = nullptr;
+  }
+  NotifyChanged();
+  return result;
+}
+
+gfx::Size AppSwapResponsiveLabCanvasView::ContentPreferredSize() const {
+  return content_ ? content_->GetPreferredSize() : gfx::Size();
+}
+
+gfx::RectF AppSwapResponsiveLabCanvasView::VisibleContentRect() const {
+  if (!content_ || scale_ <= 0) {
+    return gfx::RectF();
+  }
+  return gfx::RectF(-pan_offset_.x() / scale_, -pan_offset_.y() / scale_,
+                    width() / scale_, height() / scale_);
+}
+
+void AppSwapResponsiveLabCanvasView::CenterOn(
+    const gfx::PointF& content_point) {
+  if (!content_) {
+    return;
+  }
+  SetPanOffset(gfx::Vector2dF(width() / 2.0f - content_point.x() * scale_,
+                              height() / 2.0f - content_point.y() * scale_));
+}
+
+bool AppSwapResponsiveLabCanvasView::OnMousePressed(
+    const ui::MouseEvent& event) {
+  if (!content_ || !event.IsOnlyLeftMouseButton()) {
+    return false;
+  }
+  dragging_ = true;
+  drag_start_location_ = event.location();
+  drag_start_pan_offset_ = pan_offset_;
+  return true;
+}
+
+bool AppSwapResponsiveLabCanvasView::OnMouseDragged(
+    const ui::MouseEvent& event) {
+  if (!dragging_) {
+    return false;
+  }
+  const gfx::Vector2d delta = event.location() - drag_start_location_;
+  SetPanOffset(drag_start_pan_offset_ +
+              gfx::Vector2dF(delta.x(), delta.y()));
+  return true;
+}
+
+void AppSwapResponsiveLabCanvasView::OnMouseReleased(
+    const ui::MouseEvent& event) {
+  dragging_ = false;
+}
+
+bool AppSwapResponsiveLabCanvasView::OnMouseWheel(
+    const ui::MouseWheelEvent& event) {
+  if (!content_) {
+    return false;
+  }
+  if (event.IsControlDown()) {
+    // Scaled by the actual offset, not just its sign, so a fast/hard
+    // scroll (or a bigger trackpad pinch, which arrives as a larger wheel
+    // delta) zooms faster than a small one -- kWheelDelta is the size of
+    // one "notch" of a standard wheel, so this reads as "kZoomStepPerNotch
+    // of zoom per notch scrolled, proportionally for partial/larger deltas".
+    constexpr float kZoomStepPerNotch = 0.1f;
+    const float delta_scale = (static_cast<float>(event.y_offset()) /
+                               ui::MouseWheelEvent::kWheelDelta) *
+                              kZoomStepPerNotch;
+    ZoomBy(delta_scale, gfx::PointF(event.location()));
+  } else {
+    SetPanOffset(pan_offset_ + gfx::Vector2dF(event.x_offset() / 4.0f,
+                                              event.y_offset() / 4.0f));
+  }
+  return true;
+}
+
+void AppSwapResponsiveLabCanvasView::SetPanOffset(
+    const gfx::Vector2dF& pan_offset) {
+  pan_offset_ = pan_offset;
+  ApplyPanAndScale();
+  NotifyChanged();
+}
+
+void AppSwapResponsiveLabCanvasView::ZoomBy(float delta_scale,
+                                            const gfx::PointF& anchor) {
+  const float new_scale = std::clamp(scale_ + delta_scale, kMinScale, kMaxScale);
+  if (new_scale == scale_) {
+    return;
+  }
+  // Keep the content point currently under `anchor` fixed on screen.
+  const gfx::PointF content_point((anchor.x() - pan_offset_.x()) / scale_,
+                                  (anchor.y() - pan_offset_.y()) / scale_);
+  scale_ = new_scale;
+  pan_offset_ = gfx::Vector2dF(anchor.x() - content_point.x() * scale_,
+                               anchor.y() - content_point.y() * scale_);
+  ApplyPanAndScale();
+  NotifyChanged();
+}
+
+void AppSwapResponsiveLabCanvasView::ApplyPanAndScale() {
+  if (!content_) {
+    return;
+  }
+  content_->SetPosition(
+      gfx::Point(base::ClampRound(pan_offset_.x()),
+                base::ClampRound(pan_offset_.y())));
+  gfx::Transform transform;
+  transform.Scale(scale_);
+  content_->SetTransform(transform);
+  // TEMPORARY debug logging: chasing the browser-window-wide positioning
+  // glitch (canvas painting over the toolbar, cropped at the window's
+  // right/bottom edges). Remove once found.
+  LOG(ERROR) << "[ResponsiveLab] CanvasView::ApplyPanAndScale: this bounds="
+             << bounds().ToString() << " widget=" << GetWidget()
+             << " pan_offset=" << pan_offset_.ToString()
+             << " scale=" << scale_
+             << " content bounds=" << content_->bounds().ToString()
+             << " content transform=" << content_->GetTransform().ToString()
+             << " content layer=" << content_->layer();
+  // TEMPORARY debug logging: chasing "webviews get cropped too much" when
+  // dragging the pane toward the top (pan_offset_.y() goes negative,
+  // content_'s top edge moves above this view's own origin). Logs each
+  // cell's own bounds/visible-bounds unconditionally now -- gating this on
+  // pan_offset_.y() < 0 sounded right but missed the previous repro
+  // entirely, since zooming toward any point other than content_'s own
+  // top-left already pushes pan_offset_ negative on its own,
+  // independent of manual panning direction. So: always log; it's only
+  // ~2 lines per cell. Remove once found.
+  for (views::View* cell : content_->children()) {
+    LOG(ERROR) << "[ResponsiveLab] CanvasView::ApplyPanAndScale: cell "
+               << "bounds=" << cell->bounds().ToString()
+               << " visible_bounds=" << cell->GetVisibleBounds().ToString();
+    for (views::View* child : cell->children()) {
+      LOG(ERROR) << "[ResponsiveLab] CanvasView::ApplyPanAndScale:   "
+                 << "child bounds=" << child->bounds().ToString()
+                 << " visible_bounds="
+                 << child->GetVisibleBounds().ToString();
+    }
+  }
+}
+
+void AppSwapResponsiveLabCanvasView::NotifyChanged() {
+  if (change_callback_) {
+    change_callback_.Run();
+  }
+}
+
+BEGIN_METADATA(AppSwapResponsiveLabCanvasView)
+END_METADATA
diff --git a/chrome/browser/ui/views/app_swap/app_swap_responsive_lab_canvas_view.h b/chrome/browser/ui/views/app_swap/app_swap_responsive_lab_canvas_view.h
new file mode 100644
index 0000000000000..88748f1e10edc
--- /dev/null
+++ b/chrome/browser/ui/views/app_swap/app_swap_responsive_lab_canvas_view.h
@@ -0,0 +1,151 @@
+// Copyright 2026 The AppSwap Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_VIEWS_APP_SWAP_APP_SWAP_RESPONSIVE_LAB_CANVAS_VIEW_H_
+#define CHROME_BROWSER_UI_VIEWS_APP_SWAP_APP_SWAP_RESPONSIVE_LAB_CANVAS_VIEW_H_
+
+#include <memory>
+
+#include "base/functional/callback.h"
+#include "base/memory/raw_ptr.h"
+#include "ui/base/metadata/metadata_header_macros.h"
+#include "ui/gfx/geometry/point.h"
+#include "ui/gfx/geometry/point_f.h"
+#include "ui/gfx/geometry/rect_f.h"
+#include "ui/gfx/geometry/size.h"
+#include "ui/gfx/geometry/vector2d_f.h"
+#include "ui/views/view.h"
+
+// A pannable, zoomable host for one tab's Responsive Lab grid content (see
+// AppSwapResponsiveLabGridHolder, which owns that content across tab
+// switches -- this view only ever displays whatever it's currently handed
+// via SetContent()/DetachContent(), the same one-per-content-slot role
+// AppSwapResponsiveLabOverlayView itself has relative to tabs).
+//
+// Deliberately not a views::ScrollView: the grid can be arbitrarily wide (one
+// column per device preset) and a plain horizontal scrollbar doesn't give a
+// way to zoom out for an overview or to jump around quickly, which is what
+// motivated this -- drag-to-pan on empty canvas background, Ctrl+wheel to
+// zoom, plain wheel to pan. AppSwapResponsiveLabMinimapView (a sibling in the
+// overlay) reads this view's current viewport/content extents to draw a
+// small overview + lets the user jump the pan directly via CenterOn().
+//
+// Panning moves content_'s own position (SetPosition()), not a transform --
+// deliberately, since a view whose *painted* position diverges from its
+// *bounds* position risks falling outside the default ViewTargeter's hit
+// testing (see the warning on views::View::SetTransform()); repositioning
+// bounds directly is the same mechanism a plain oversized child inside a
+// ScrollView already relies on in this codebase; content_'s bounds size
+// never changes (WebViews keep the exact pixel size their device preset
+// asks for -- panning must not touch that). Zoom, unlike pan, has no bounds-
+// only equivalent (scaling would mean actually resizing every WebView,
+// which is not what "zoom out to see more of the canvas" should do to
+// them), so it's the one thing here that does use SetTransform() -- scale
+// only, anchored at content_'s own top-left corner, with pan_offset_
+// compensated so the point under the cursor stays fixed. That leaves one
+// known, accepted rough edge: when scale_ > 1, content_'s *painted* size
+// exceeds its *bounds* size, so clicks right at the outer edge of
+// zoomed-in content can miss -- kMaxScale is kept modest to limit how much
+// that can happen, and it's a rough edge, not a broken feature (see the
+// deferred section of the Responsive Lab plan for the same trade-off
+// already accepted for other polish items).
+//
+// This view (not its parent overlay -- see this class's own constructor)
+// is given its own layer with SetMasksToBounds(true). Two independent
+// things need that: content_ legitimately paints outside this view's own
+// bounds the moment it's panned/zoomed (pan_offset_ goes negative to keep
+// a zoomed point fixed under the cursor, and content_'s *scaled* footprint
+// can far exceed this view's size), and without a masking layer that
+// overflow isn't clipped -- it paints wherever its transformed position
+// lands, which at high zoom can be above this view's own top edge, over
+// the browser's toolbar. Separately, giving this view a layer is also
+// what makes AppSwapResponsiveLabMinimapView's own layer correctly stack
+// above the grid's WebView layers (see that class's comment).
+class AppSwapResponsiveLabCanvasView : public views::View {
+  METADATA_HEADER(AppSwapResponsiveLabCanvasView, views::View)
+
+ public:
+  static constexpr float kMinScale = 0.25f;
+  static constexpr float kMaxScale = 1.5f;
+
+  AppSwapResponsiveLabCanvasView();
+  AppSwapResponsiveLabCanvasView(const AppSwapResponsiveLabCanvasView&) =
+      delete;
+  AppSwapResponsiveLabCanvasView& operator=(
+      const AppSwapResponsiveLabCanvasView&) = delete;
+  ~AppSwapResponsiveLabCanvasView() override;
+
+  // Result of DetachContent(): the content view (now parentless) plus the
+  // pan/zoom state it had at the moment of detaching, so the caller (the
+  // overlay) can hand both back to the tab's AppSwapResponsiveLabGridHolder
+  // and restore them exactly on a later SetContent().
+  struct DetachResult {
+    DetachResult();
+    DetachResult(DetachResult&&);
+    DetachResult& operator=(DetachResult&&);
+    ~DetachResult();
+
+    std::unique_ptr<views::View> content;
+    gfx::Vector2dF pan_offset;
+    float scale = 1.0f;
+  };
+
+  // Attaches `content` as the sole child, applying the given initial
+  // pan/zoom. Must be called with no content currently attached (call
+  // DetachContent() first).
+  views::View* SetContent(std::unique_ptr<views::View> content,
+                          const gfx::Vector2dF& pan_offset,
+                          float scale);
+
+  // Detaches the current content (if any) and returns it along with its
+  // current pan/zoom, resetting this view to empty.
+  DetachResult DetachContent();
+
+  bool has_content() const { return content_ != nullptr; }
+
+  // The content view's own natural (unscaled) size, or an empty size if
+  // there's no content attached.
+  gfx::Size ContentPreferredSize() const;
+
+  // The portion of content-local (unscaled, pre-pan/zoom) space currently
+  // visible within this view's own bounds -- used by the minimap to
+  // position its viewport indicator.
+  gfx::RectF VisibleContentRect() const;
+
+  // Re-centers the viewport on `content_point` (in content-local space),
+  // preserving the current zoom level. Used by the minimap's click/drag-to-
+  // jump navigation.
+  void CenterOn(const gfx::PointF& content_point);
+
+  // Invoked whenever content, pan, or zoom changes -- lets the overlay
+  // refresh the minimap without this view needing to know about it
+  // directly.
+  void set_change_callback(base::RepeatingClosure callback) {
+    change_callback_ = std::move(callback);
+  }
+
+  // views::View:
+  bool OnMousePressed(const ui::MouseEvent& event) override;
+  bool OnMouseDragged(const ui::MouseEvent& event) override;
+  void OnMouseReleased(const ui::MouseEvent& event) override;
+  bool OnMouseWheel(const ui::MouseWheelEvent& event) override;
+
+ private:
+  void SetPanOffset(const gfx::Vector2dF& pan_offset);
+  void ZoomBy(float delta_scale, const gfx::PointF& anchor);
+  void ApplyPanAndScale();
+  void NotifyChanged();
+
+  raw_ptr<views::View> content_ = nullptr;
+  gfx::Vector2dF pan_offset_;
+  float scale_ = 1.0f;
+
+  bool dragging_ = false;
+  gfx::Point drag_start_location_;
+  gfx::Vector2dF drag_start_pan_offset_;
+
+  base::RepeatingClosure change_callback_;
+};
+
+#endif  // CHROME_BROWSER_UI_VIEWS_APP_SWAP_APP_SWAP_RESPONSIVE_LAB_CANVAS_VIEW_H_
diff --git a/chrome/browser/ui/views/app_swap/app_swap_responsive_lab_grid_holder.cc b/chrome/browser/ui/views/app_swap/app_swap_responsive_lab_grid_holder.cc
new file mode 100644
index 0000000000000..79a4331a65c4b
--- /dev/null
+++ b/chrome/browser/ui/views/app_swap/app_swap_responsive_lab_grid_holder.cc
@@ -0,0 +1,190 @@
+// Copyright 2026 The AppSwap Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/views/app_swap/app_swap_responsive_lab_grid_holder.h"
+
+#include <utility>
+
+#include "base/strings/strcat.h"
+#include "base/strings/string_number_conversions.h"
+#include "base/strings/utf_string_conversions.h"
+#include "chrome/browser/profiles/profile.h"
+#include "components/zoom/zoom_controller.h"
+#include "ui/color/color_id.h"
+#include "ui/gfx/geometry/insets.h"
+#include "ui/gfx/geometry/rect.h"
+#include "ui/gfx/geometry/size.h"
+#include "ui/views/background.h"
+#include "ui/views/controls/label.h"
+#include "ui/views/controls/webview/webview.h"
+#include "ui/views/layout/box_layout.h"
+#include "ui/views/view.h"
+#include "ui/views/view_class_properties.h"
+#include "url/gurl.h"
+
+namespace {
+
+constexpr int kCellSpacing = 16;
+constexpr int kHeaderBottomMargin = 6;
+
+// A WebView whose *native* renderer surface stays pinned at `native_size`
+// forever, regardless of this view's own (possibly zoom-transform-scaled)
+// bounds -- see BuildGridView's call site for why that matters.
+//
+// A one-time NativeViewHost::SetNativeViewSize() call isn't enough:
+// views::WebView::OnBoundsChanged() unconditionally resets it back to
+// "match my own bounds" (holder()->SetNativeViewSize(gfx::Size()), an
+// empty size meaning "no override") on *every* call, which happens on
+// essentially every layout pass -- including whenever
+// AppSwapResponsiveLabCanvasView's zoom transform changes what this view's
+// bounds convert to in widget space. Re-pinning it right after the base
+// class's own OnBoundsChanged() runs is what actually makes it stick.
+class PinnedSizeWebView : public views::WebView {
+ public:
+  PinnedSizeWebView(Profile* profile, const gfx::Size& native_size)
+      : views::WebView(profile), native_size_(native_size) {}
+
+  void OnBoundsChanged(const gfx::Rect& previous_bounds) override {
+    views::WebView::OnBoundsChanged(previous_bounds);
+    holder()->SetNativeViewSize(native_size_);
+  }
+
+ private:
+  const gfx::Size native_size_;
+};
+
+// One "name / width x height" header plus its fixed-size WebView, wrapped
+// in a vertical column so the two lay out together as one grid cell.
+// `web_view` already owns its own real, navigated WebContents (created via
+// LoadInitialURL by the caller) -- see AppSwapResponsiveLabOverlayView's
+// class comment for why the WebView must create it, rather than being
+// handed one built independently.
+std::unique_ptr<views::View> BuildCell(
+    const AppSwapResponsiveLabOverlayView::DevicePreset& preset,
+    std::unique_ptr<views::WebView> web_view) {
+  auto cell = std::make_unique<views::View>();
+  cell->SetLayoutManager(std::make_unique<views::BoxLayout>(
+      views::BoxLayout::Orientation::kVertical));
+
+  const std::string label_text =
+      base::StrCat({preset.name, "  ", base::NumberToString(preset.width),
+                    " × ", base::NumberToString(preset.height)});
+  auto header =
+      std::make_unique<views::Label>(base::UTF8ToUTF16(label_text));
+  header->SetHorizontalAlignment(gfx::ALIGN_LEFT);
+  header->SetProperty(views::kMarginsKey,
+                      gfx::Insets::TLBR(0, 0, kHeaderBottomMargin, 0));
+  cell->AddChildView(std::move(header));
+
+  cell->AddChildView(std::move(web_view));
+
+  return cell;
+}
+
+// The row every cell is added to -- a plain horizontal BoxLayout container.
+// This is the view AppSwapResponsiveLabCanvasView pans/zooms as a whole.
+std::unique_ptr<views::View> BuildGridView(
+    Profile* profile,
+    const GURL& url,
+    const std::vector<AppSwapResponsiveLabOverlayView::DevicePreset>&
+        presets) {
+  auto row = std::make_unique<views::View>();
+  // views::View::SetTransform() with a non-identity transform implicitly
+  // gives the view its own compositor layer (see its own implementation --
+  // paint_to_layer_for_transform_ = true), which is what
+  // AppSwapResponsiveLabCanvasView's ApplyPanAndScale() puts on `row` here
+  // via its zoom scale. A layer with nothing of its own painted into it
+  // doesn't necessarily get fully cleared between repaints -- during
+  // continuous zoom/pan, that showed up as old header-label text ghosting
+  // behind the current frame's text instead of being cleared first. An
+  // explicit, opaque background makes every repaint start from a clean
+  // base.
+  row->SetBackground(views::CreateSolidBackground(ui::kColorWindowBackground));
+  auto* row_layout = row->SetLayoutManager(std::make_unique<views::BoxLayout>(
+      views::BoxLayout::Orientation::kHorizontal));
+  row_layout->set_between_child_spacing(kCellSpacing);
+  row_layout->set_inside_border_insets(gfx::Insets(kCellSpacing));
+
+  for (const auto& preset : presets) {
+    const gfx::Size preset_size(preset.width, preset.height);
+    // PinnedSizeWebView (not a plain views::WebView) is what makes the
+    // *actual* renderer surface stay at the device preset's real size,
+    // independent of AppSwapResponsiveLabCanvasView's zoom transform.
+    // Without it, NativeViewHost::Layout() -- which WebView uses
+    // internally -- positions/sizes the native renderer window via
+    // ConvertRectToWidget(), a transform-aware conversion (the same
+    // mechanism that makes hit-testing work through a transformed
+    // ancestor). That means it would resize the *actual*
+    // RenderWidgetHostView to `preset_size * canvas_scale`, not just
+    // display it bigger/smaller -- a real resize the page actually
+    // reflows to, defeating the entire point of comparing real, fixed
+    // device widths side by side (this is what previously made zooming
+    // visibly reveal/hide page content rather than just magnify it).
+    // Pinning the native size makes NativeViewHostAura::ShowWidget() take
+    // its transform-scale branch instead: the renderer keeps rendering at
+    // `preset_size` always, and the canvas transform only ever visually
+    // magnifies that fixed-resolution surface.
+    auto web_view = std::make_unique<PinnedSizeWebView>(profile, preset_size);
+    web_view->SetPreferredSize(preset_size);
+    web_view->LoadInitialURL(url);
+
+    // ZoomController's default mode zooms every WebContents showing the
+    // same origin together (see its own ZOOM_MODE_DEFAULT comment) -- so
+    // without this, Ctrl+Wheel over one grid cell (Chrome's native
+    // per-page zoom shortcut) would also zoom every other cell showing the
+    // same site, *on top of* whatever AppSwapResponsiveLabCanvasView's own
+    // Ctrl+Wheel handling already does when the same gesture starts over
+    // empty canvas background -- two independent zoom mechanisms
+    // compounding on the same pixels. Each grid cell is meant to render at
+    // a fixed, real device width/height regardless of the canvas's own
+    // zoom, so native per-page zoom has no business applying to it at all.
+    zoom::ZoomController::CreateForWebContents(web_view->web_contents());
+    zoom::ZoomController::FromWebContents(web_view->web_contents())
+        ->SetZoomMode(zoom::ZoomController::ZOOM_MODE_DISABLED);
+
+    row->AddChildView(BuildCell(preset, std::move(web_view)));
+  }
+
+  // BoxLayout only positions children once this view itself has a size --
+  // nothing above ever resizes it for us (AppSwapResponsiveLabCanvasView
+  // repositions this view via SetPosition() and scales it via a transform,
+  // neither of which touches its bounds *size*), so it must be sized to its
+  // own preferred size explicitly here or every cell inside it lays out
+  // into a zero-size area.
+  row->SetBoundsRect(gfx::Rect(row->GetPreferredSize()));
+  return row;
+}
+
+}  // namespace
+
+AppSwapResponsiveLabGridHolder::AppSwapResponsiveLabGridHolder(
+    content::WebContents* web_contents)
+    : content::WebContentsUserData<AppSwapResponsiveLabGridHolder>(
+          *web_contents) {}
+
+AppSwapResponsiveLabGridHolder::~AppSwapResponsiveLabGridHolder() = default;
+
+std::unique_ptr<views::View>
+AppSwapResponsiveLabGridHolder::TakeOrBuildGridView(
+    Profile* profile,
+    const GURL& url,
+    std::vector<AppSwapResponsiveLabOverlayView::DevicePreset> presets) {
+  if (grid_view_) {
+    return std::move(grid_view_);
+  }
+  return BuildGridView(profile, url, presets);
+}
+
+void AppSwapResponsiveLabGridHolder::PutBackGridView(
+    std::unique_ptr<views::View> grid_view) {
+  grid_view_ = std::move(grid_view);
+}
+
+void AppSwapResponsiveLabGridHolder::Discard() {
+  grid_view_.reset();
+  pan_offset_ = gfx::Vector2dF();
+  scale_ = 1.0f;
+}
+
+WEB_CONTENTS_USER_DATA_KEY_IMPL(AppSwapResponsiveLabGridHolder);
diff --git a/chrome/browser/ui/views/app_swap/app_swap_responsive_lab_grid_holder.h b/chrome/browser/ui/views/app_swap/app_swap_responsive_lab_grid_holder.h
