+// Copyright 2026 The AppSwap Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_APP_SWAP_APP_SWAP_RESPONSIVE_LAB_TAB_HELPER_H_
+#define CHROME_BROWSER_APP_SWAP_APP_SWAP_RESPONSIVE_LAB_TAB_HELPER_H_
+
+#include "content/public/browser/web_contents_user_data.h"
+
+namespace content {
+class WebContents;
+}  // namespace content
+
+// Tracks, per tab, whether AppSwap Responsive Lab is toggled on -- nothing
+// more. The grid it toggles (a per-content-slot AppSwapResponsiveLabOverlayView,
+// hosted in ContentsContainerView) is not tied to any one tab and doesn't
+// persist across a tab switch on its own, so this is what lets
+// AppSwapResponsiveLabButton tell, on every active-tab change, whether the
+// *new* active tab wants the grid shown or not.
+//
+// Does not own any WebContents: the grid's own WebViews create and own
+// theirs directly (see AppSwapResponsiveLabOverlayView::SetViewports()) --
+// this class exists purely as the per-tab bit of memory that survives a
+// switch away and back.
+class AppSwapResponsiveLabTabHelper
+    : public content::WebContentsUserData<AppSwapResponsiveLabTabHelper> {
+ public:
+  ~AppSwapResponsiveLabTabHelper() override;
+
+  AppSwapResponsiveLabTabHelper(const AppSwapResponsiveLabTabHelper&) =
+      delete;
+  AppSwapResponsiveLabTabHelper& operator=(
+      const AppSwapResponsiveLabTabHelper&) = delete;
+
+  bool active() const { return active_; }
+  void SetActive(bool active) { active_ = active; }
+
+ private:
+  friend class content::WebContentsUserData<AppSwapResponsiveLabTabHelper>;
+  explicit AppSwapResponsiveLabTabHelper(content::WebContents* web_contents);
+
+  bool active_ = false;
+
+  WEB_CONTENTS_USER_DATA_KEY_DECL();
+};
+
+#endif  // CHROME_BROWSER_APP_SWAP_APP_SWAP_RESPONSIVE_LAB_TAB_HELPER_H_
diff --git a/chrome/browser/ui/views/app_swap/app_swap_responsive_lab_button.cc b/chrome/browser/ui/views/app_swap/app_swap_responsive_lab_button.cc
new file mode 100644
index 0000000000000..0ee2b2354e43c
--- /dev/null
+++ b/chrome/browser/ui/views/app_swap/app_swap_responsive_lab_button.cc
@@ -0,0 +1,199 @@
+// Copyright 2026 The AppSwap Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/views/app_swap/app_swap_responsive_lab_button.h"
+
+#include <vector>
+
+#include "base/functional/bind.h"
+#include "base/logging.h"
+#include "chrome/browser/app_swap/app_swap_responsive_lab_tab_helper.h"
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/browser/ui/browser_window/public/browser_window_interface.h"
+#include "chrome/browser/ui/tabs/tab_strip_model.h"
+#include "chrome/browser/ui/views/app_swap/app_swap_responsive_lab_grid_holder.h"
+#include "chrome/browser/ui/views/app_swap/app_swap_responsive_lab_overlay_view.h"
+#include "chrome/browser/ui/views/frame/browser_view.h"
+#include "chrome/browser/ui/views/frame/contents_container_view.h"
+#include "chrome/browser/ui/views/frame/contents_web_view.h"
+#include "components/vector_icons/vector_icons.h"
+#include "content/public/browser/web_contents.h"
+#include "ui/base/metadata/metadata_impl_macros.h"
+#include "ui/color/color_id.h"
+#include "ui/views/background.h"
+#include "url/gurl.h"
+
+namespace {
+
+constexpr float kActiveBadgeCornerRadius = 4.0f;
+
+// Small and hardcoded for v1 -- each preset is a full extra renderer
+// process while active, so the list stays short until there's a reason to
+// grow it.
+std::vector<AppSwapResponsiveLabOverlayView::DevicePreset>
+BuildDevicePresets() {
+  return {
+      {"Mobile", 390, 844},
+      {"Tablet", 820, 1180},
+      {"Desktop", 1440, 900},
+  };
+}
+
+}  // namespace
+
+AppSwapResponsiveLabButton::AppSwapResponsiveLabButton(
+    BrowserWindowInterface* browser)
+    : ToolbarButton(base::BindRepeating(
+          &AppSwapResponsiveLabButton::ButtonPressed, base::Unretained(this))),
+      browser_(browser) {
+  SetVectorIcon(vector_icons::kDevicesIcon);
+  SetTooltipText(u"Preview in Responsive Lab");
+  SetAccessibleName(u"Responsive Lab");
+  SetVisible(false);
+  browser_->GetTabStripModel()->AddObserver(this);
+  UpdateForActiveTab();
+}
+
+AppSwapResponsiveLabButton::~AppSwapResponsiveLabButton() {
+  browser_->GetTabStripModel()->RemoveObserver(this);
+}
+
+void AppSwapResponsiveLabButton::OnTabStripModelChanged(
+    TabStripModel* tab_strip_model,
+    const TabStripModelChange& change,
+    const TabStripSelectionChange& selection) {
+  if (selection.active_tab_changed()) {
+    UpdateForActiveTab();
+  }
+}
+
+void AppSwapResponsiveLabButton::OnTabChangedAt(tabs::TabInterface* tab,
+                                                TabChangeType change_type) {
+  UpdateForActiveTab();
+}
+
+void AppSwapResponsiveLabButton::ButtonPressed() {
+  content::WebContents* web_contents =
+      browser_->GetTabStripModel()->GetActiveWebContents();
+  LOG(ERROR) << "[ResponsiveLab] ButtonPressed: web_contents="
+             << web_contents;
+  if (!web_contents) {
+    return;
+  }
+  AppSwapResponsiveLabTabHelper* helper =
+      AppSwapResponsiveLabTabHelper::GetOrCreateForWebContents(web_contents);
+  const bool new_active = !helper->active();
+  LOG(ERROR) << "[ResponsiveLab] ButtonPressed: new_active=" << new_active;
+  helper->SetActive(new_active);
+  SyncContentsContainer(web_contents, new_active);
+  if (!new_active) {
+    // An explicit toggle-off (as opposed to merely switching tabs away
+    // from an active grid, which keeps it cached in its
+    // AppSwapResponsiveLabGridHolder for a possible later reactivation) --
+    // actually free the grid's renderer processes rather than leaving them
+    // cached for a reactivation the user hasn't asked for.
+    if (AppSwapResponsiveLabGridHolder* holder =
+            AppSwapResponsiveLabGridHolder::FromWebContents(web_contents)) {
+      holder->Discard();
+    }
+  }
+  SetActiveVisual(new_active);
+}
+
+void AppSwapResponsiveLabButton::UpdateForActiveTab() {
+  content::WebContents* web_contents =
+      browser_->GetTabStripModel()->GetActiveWebContents();
+  if (!web_contents) {
+    SetVisible(false);
+    return;
+  }
+
+  // The button itself only makes sense on an http(s) page, but the
+  // container sync below must still run even when it doesn't -- e.g.
+  // switching to a chrome://newtab/ tab while a previous http(s) tab has
+  // Responsive Lab active. Returning early here (skipping
+  // SyncContentsContainer) used to leave that tab's grid on screen
+  // indefinitely, since nothing else ever told the (per-content-slot, not
+  // per-tab) overlay to hide or contents_view() to show again -- this is
+  // what made a brand new tab appear to inherit the previous tab's grid.
+  const bool applicable =
+      web_contents->GetLastCommittedURL().SchemeIsHTTPOrHTTPS();
+  SetVisible(applicable);
+
+  bool active = false;
+  if (applicable) {
+    if (AppSwapResponsiveLabTabHelper* helper =
+            AppSwapResponsiveLabTabHelper::FromWebContents(web_contents)) {
+      active = helper->active();
+    }
+  }
+  SetActiveVisual(active);
+  SyncContentsContainer(web_contents, active);
+}
+
+void AppSwapResponsiveLabButton::SetActiveVisual(bool active) {
+  if (active) {
+    SetBackground(views::CreateRoundedRectBackground(
+        ui::kColorSysNeutralContainer, kActiveBadgeCornerRadius));
+  } else {
+    SetBackground(nullptr);
+  }
+}
+
+void AppSwapResponsiveLabButton::SyncContentsContainer(
+    content::WebContents* web_contents,
+    bool active) {
+  BrowserView* browser_view = BrowserView::GetBrowserViewForBrowser(browser_);
+  LOG(ERROR) << "[ResponsiveLab] SyncContentsContainer: active=" << active
+             << " browser_view=" << browser_view;
+  if (!browser_view) {
+    return;
+  }
+  ContentsContainerView* container =
+      browser_view->GetContentsContainerViewFor(web_contents);
+  LOG(ERROR) << "[ResponsiveLab] SyncContentsContainer: container="
+             << container;
+  if (!container) {
+    // web_contents isn't currently shown by any container (e.g. it's a
+    // background tab) -- nothing on screen to sync.
+    return;
+  }
+
+  AppSwapResponsiveLabOverlayView* overlay =
+      container->app_swap_responsive_lab_overlay_view();
+  LOG(ERROR) << "[ResponsiveLab] SyncContentsContainer: overlay=" << overlay
+             << " overlay bounds=" << (overlay ? overlay->bounds().ToString()
+                                               : "n/a")
+             << " overlay widget=" << (overlay ? overlay->GetWidget() : nullptr);
+  if (!overlay) {
+    return;
+  }
+
+  if (active) {
+    const GURL url = web_contents->GetLastCommittedURL();
+    LOG(ERROR) << "[ResponsiveLab] SyncContentsContainer: showing grid for "
+               << url;
+    overlay->ShowGridFor(
+        web_contents,
+        Profile::FromBrowserContext(web_contents->GetBrowserContext()), url,
+        BuildDevicePresets());
+    container->contents_view()->SetVisible(false);
+    LOG(ERROR) << "[ResponsiveLab] SyncContentsContainer: after "
+               << "ShowGridFor(), overlay visible=" << overlay->GetVisible()
+               << " bounds=" << overlay->bounds().ToString()
+               << " contents_view visible="
+               << container->contents_view()->GetVisible();
+  } else {
+    // HideCurrent() detaches whatever the overlay is currently showing --
+    // which, since it's one-per-content-slot rather than one-per-tab, may
+    // belong to a *different* tab than `web_contents` (e.g. this call is
+    // for a newly-active tab that doesn't apply, while the previously
+    // active tab still has an attached grid to hand back to its holder).
+    overlay->HideCurrent();
+    container->contents_view()->SetVisible(true);
+  }
+}
+
+BEGIN_METADATA(AppSwapResponsiveLabButton)
+END_METADATA
diff --git a/chrome/browser/ui/views/app_swap/app_swap_responsive_lab_button.h b/chrome/browser/ui/views/app_swap/app_swap_responsive_lab_button.h
