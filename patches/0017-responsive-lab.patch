--- /dev/null
+++ b/chrome/browser/ui/views/app_swap/app_swap_responsive_lab_overlay_view.h
@@ -0,0 +1,199 @@
+// Copyright 2026 The AppSwap Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_VIEWS_APP_SWAP_APP_SWAP_RESPONSIVE_LAB_OVERLAY_VIEW_H_
+#define CHROME_BROWSER_UI_VIEWS_APP_SWAP_APP_SWAP_RESPONSIVE_LAB_OVERLAY_VIEW_H_
+
+#include <memory>
+
+#include "base/memory/raw_ptr.h"
+#include "build/build_config.h"
+#include "content/public/browser/web_contents_observer.h"
+#include "ui/base/metadata/metadata_header_macros.h"
+#include "ui/views/controls/resize_area_delegate.h"
+#include "ui/views/view.h"
+
+class AppSwapResponsiveLabCanvasView;
+class AppSwapResponsiveLabMinimapView;
+class AppSwapResponsiveLabPanelBridge;
+class Profile;
+
+namespace views {
+class ResizeArea;
+class WebView;
+}  // namespace views
+
+#if defined(USE_AURA)
+class AppSwapResponsiveLabWheelInterceptorAura;
+#endif
+#if BUILDFLAG(IS_MAC)
+class AppSwapResponsiveLabWheelObserverMac;
+#endif
+
+namespace content {
+class WebContents;
+}  // namespace content
+
+namespace gfx {
+class Rect;
+}  // namespace gfx
+
+// Shown in place of ContentsWebView, full-size, while a tab's
+// AppSwapResponsiveLabSession is active (see ContentsContainerView, which
+// constructs and lays out this view alongside its other overlay siblings,
+// and AppSwapResponsiveLabButton, which is what actually toggles it and
+// keeps its content in sync with the active tab).
+//
+// This view is one-per-content-slot (like ContentsWebView itself), not
+// one-per-tab: it only ever displays whichever tab is currently active, and
+// re-points itself to a different tab's content via ShowGridFor(). The grid
+// content it displays for a given tab -- an AppSwapResponsiveLabGridView
+// with one cell per viewport, hosted in a pannable/zoomable
+// AppSwapResponsiveLabCanvasView, with an AppSwapResponsiveLabMinimapView
+// overview anchored to the bottom-right corner -- is actually owned by that
+// tab's own AppSwapResponsiveLabGridHolder (content::WebContentsUserData),
+// not by this view; ShowGridFor()/HideCurrent() borrow and return that
+// content so that switching away from a tab and back shows the exact same,
+// still-live grid instead of tearing it down and rebuilding (and
+// re-navigating) it every time. The pan/zoom that goes with it is
+// remembered on the tab's AppSwapResponsiveLabSession rather than here, so
+// the panel can drive it too.
+//
+// Each grid cell owns a real content::WebContents, created and navigated the
+// same way AppSwapVersionPickerDialog's own WebView does (see
+// CreateAppSwapVersionPickerSubpageView): the views::WebView creates its
+// WebContents itself, via LoadInitialURL(), rather than being handed an
+// already-navigating WebContents built independently via
+// content::WebContents::Create(). That's not an arbitrary style choice --
+// a WebContents built separately and only later attached via
+// WebView::SetWebContents() never gets a real RenderWidgetHostView/
+// compositor surface wired up in time for its already-in-flight navigation
+// to actually paint anything, which is what produced a blank white grid
+// with unresponsive right-click (no working hit-testing) the first time
+// this shipped. Letting the WebView own creation from the start avoids that
+// entirely, and is the only WebContents-creation path this codebase has
+// already proven to work for a WebView hosted outside the normal tab strip.
+class AppSwapResponsiveLabOverlayView : public views::View,
+                                        public views::ResizeAreaDelegate,
+                                        public content::WebContentsObserver {
+  METADATA_HEADER(AppSwapResponsiveLabOverlayView, views::View)
+
+ public:
+  AppSwapResponsiveLabOverlayView();
+  AppSwapResponsiveLabOverlayView(const AppSwapResponsiveLabOverlayView&) =
+      delete;
+  AppSwapResponsiveLabOverlayView& operator=(
+      const AppSwapResponsiveLabOverlayView&) = delete;
+  ~AppSwapResponsiveLabOverlayView() override;
+
+  // Shows `web_contents`'s grid, becoming visible if it wasn't already. If
+  // this view is already showing `web_contents`'s grid, does nothing (no
+  // rebuild, no re-navigation, no viewport reset). Otherwise detaches
+  // whatever was previously shown (handing it, and its pan/zoom, back to
+  // its own tab's session and AppSwapResponsiveLabGridHolder untouched)
+  // and takes `web_contents`'s grid from its holder -- building it fresh,
+  // one cell per viewport in that tab's AppSwapResponsiveLabSession, only
+  // if that holder didn't already have one cached from an earlier
+  // activation.
+  void ShowGridFor(content::WebContents* web_contents, Profile* profile);
+
+  // Detaches whatever's currently shown (if anything), handing it back to
+  // its tab's AppSwapResponsiveLabGridHolder for safekeeping, and hides
+  // this view. Does NOT discard the grid -- callers that want the grid
+  // itself gone (an explicit toggle-off, as opposed to merely switching
+  // tabs away from one with an active grid) must also call
+  // AppSwapResponsiveLabGridHolder::Discard() for that tab.
+  void HideCurrent();
+
+  // Tears the panel down entirely, freeing its renderer. Called only on an
+  // explicit toggle-off, alongside AppSwapResponsiveLabGridHolder::
+  // Discard() and for the same reason: a merely-hidden panel would keep a
+  // renderer alive for the rest of the window's life after a single use of
+  // the lab. Deliberately NOT called from HideCurrent(), which also runs
+  // on every switch to a tab without a lab -- rebuilding the panel there
+  // would reload it constantly and defeat the whole point of
+  // AppSwapResponsiveLabPanelBridge. Rebuilt by the next ShowGridFor();
+  // the panel holds no state of its own, so nothing is lost.
+  void DiscardPanel();
+
+  // views::View:
+  void OnBoundsChanged(const gfx::Rect& previous_bounds) override;
+  void Layout(PassKey) override;
+  void AddedToWidget() override;
+  void RemovedFromWidget() override;
+
+  // views::ResizeAreaDelegate:
+  void OnResize(int resize_amount, bool done_resizing) override;
+
+  // content::WebContentsObserver:
+  void WebContentsDestroyed() override;
+
+ private:
+  // Creates panel_web_view_ and navigates it, the first time a grid is
+  // shown. Deferred rather than done in the constructor because that's
+  // where the Profile first becomes available -- this view is built by
+  // ContentsContainerView with no arguments.
+  void EnsurePanel(Profile* profile);
+
+  // Detaches the current child from canvas_view_ (if any), handing it (and
+  // its pan/zoom) back to its tab's holder, and returns whether anything
+  // was detached. Clears current_owner_ and stops observation either way.
+  // Shared by ShowGridFor(), HideCurrent(), and WebContentsDestroyed().
+  void DetachCurrent();
+
+  // Passed to canvas_view_ as its change callback -- refreshes the minimap
+  // whenever the canvas's content, pan, or zoom changes.
+  void OnCanvasChanged();
+
+  // The tab whose grid is currently attached to canvas_view_, or null if
+  // nothing is currently shown. Non-owning -- the grid content's real
+  // owner is always either canvas_view_ (while attached) or that tab's
+  // AppSwapResponsiveLabGridHolder (while detached); this is just a key.
+  // Watched via WebContentsObserver so a tab closing while its grid is the
+  // one attached here can't leave this dangling (see WebContentsDestroyed).
+  raw_ptr<content::WebContents> current_owner_ = nullptr;
+
+  raw_ptr<AppSwapResponsiveLabCanvasView> canvas_view_ = nullptr;
+  raw_ptr<AppSwapResponsiveLabMinimapView> minimap_view_ = nullptr;
+
+  // The panel docked to the right of the canvas, and the invisible strip
+  // between the two that drags to resize it. Both null until the first
+  // EnsurePanel().
+  raw_ptr<views::WebView> panel_web_view_ = nullptr;
+  raw_ptr<views::ResizeArea> panel_resize_area_ = nullptr;
+
+  // What connects the panel's WebUI page to the session of whichever tab
+  // the canvas is currently showing. Owned here because the panel is
+  // one-per-content-slot exactly as this view is; see its own comment.
+  //
+  // Declared before the view pointers above only incidentally -- what
+  // actually keeps this safe is that the page handler holds a WeakPtr to
+  // it, since member destruction runs before ~View() tears down
+  // panel_web_view_ and with it the page handler.
+  std::unique_ptr<AppSwapResponsiveLabPanelBridge> panel_bridge_;
+
+  int panel_width_;
+  int panel_width_at_drag_start_ = 0;
+
+  // A grid cell's WebView hosts a real native renderer window, which
+  // receives wheel input directly rather than through normal views::View
+  // dispatch -- so canvas_view_'s own Ctrl+Wheel-to-zoom handling never
+  // sees the event when the cursor is over a cell instead of empty canvas
+  // background. This intercepts it one level up, before native content
+  // gets it. Aura-only (see the .cc); null on other platforms, so
+  // Ctrl+Wheel there only zooms from empty background, same as before.
+#if defined(USE_AURA)
+  std::unique_ptr<AppSwapResponsiveLabWheelInterceptorAura> wheel_interceptor_;
+#endif
+
+  // macOS equivalent of wheel_interceptor_ above -- Views on macOS doesn't
+  // use aura::Window, so there's no ui::EventHandler pre-target mechanism
+  // to hook into there. See AppSwapResponsiveLabWheelObserverMac's own
+  // comment for the (accepted) trade-off versus the Aura version.
+#if BUILDFLAG(IS_MAC)
+  std::unique_ptr<AppSwapResponsiveLabWheelObserverMac> wheel_observer_mac_;
+#endif
+};
+
+#endif  // CHROME_BROWSER_UI_VIEWS_APP_SWAP_APP_SWAP_RESPONSIVE_LAB_OVERLAY_VIEW_H_
diff --git a/chrome/browser/ui/views/app_swap/app_swap_responsive_lab_wheel_interceptor_aura.cc b/chrome/browser/ui/views/app_swap/app_swap_responsive_lab_wheel_interceptor_aura.cc
new file mode 100644
index 0000000000000..3d2def202373b
--- /dev/null
+++ b/chrome/browser/ui/views/app_swap/app_swap_responsive_lab_wheel_interceptor_aura.cc
@@ -0,0 +1,59 @@
+// Copyright 2026 The AppSwap Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/views/app_swap/app_swap_responsive_lab_wheel_interceptor_aura.h"
+
+#include "chrome/browser/ui/views/app_swap/app_swap_responsive_lab_canvas_view.h"
+#include "ui/aura/window.h"
+#include "ui/events/event.h"
+#include "ui/gfx/geometry/point.h"
+#include "ui/gfx/geometry/rect.h"
+#include "ui/views/view.h"
+#include "ui/views/widget/widget.h"
+
+AppSwapResponsiveLabWheelInterceptorAura::
+    AppSwapResponsiveLabWheelInterceptorAura(
+        AppSwapResponsiveLabCanvasView* canvas_view)
+    : canvas_view_(canvas_view) {}
+
+AppSwapResponsiveLabWheelInterceptorAura::
+    ~AppSwapResponsiveLabWheelInterceptorAura() = default;
+
+void AppSwapResponsiveLabWheelInterceptorAura::OnMouseEvent(
+    ui::MouseEvent* event) {
+  if (!event->IsMouseWheelEvent() || !event->IsControlDown() ||
+      !canvas_view_->GetVisible() || !canvas_view_->has_content()) {
+    return;
+  }
+
+  views::Widget* widget = canvas_view_->GetWidget();
+  auto* target = static_cast<aura::Window*>(event->target());
+  if (!widget || !widget->GetNativeView() || !target) {
+    return;
+  }
+
+  // event->location() is local to `target` -- the actual native window
+  // under the cursor, e.g. a grid cell's WebView -- not to canvas_view_.
+  // Bridge it into canvas_view_'s own local space the same way normal
+  // views::View event dispatch would, via the browser window's own aura
+  // window as the common intermediate coordinate space.
+  gfx::Point point_in_widget = event->location();
+  aura::Window::ConvertPointToTarget(target, widget->GetNativeView(),
+                                     &point_in_widget);
+  views::View::ConvertPointFromWidget(canvas_view_, &point_in_widget);
+  if (!canvas_view_->GetLocalBounds().Contains(point_in_widget)) {
+    return;
+  }
+
+  ui::MouseWheelEvent* wheel_event = event->AsMouseWheelEvent();
+  wheel_event->set_location(point_in_widget);
+  canvas_view_->OnMouseWheel(*wheel_event);
+
+  // Claim it fully -- otherwise the same gesture would also reach the
+  // WebView underneath (Chrome's native per-page zoom, even though it's
+  // disabled for grid cells -- see BuildGridView's ZOOM_MODE_DISABLED
+  // comment -- or, at minimum, a wasted scroll attempt).
+  event->SetHandled();
+  event->StopPropagation();
+}
