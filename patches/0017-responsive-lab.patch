+  AppSwapResponsiveLabUI(content::WebUI* web_ui, const GURL& url);
+  AppSwapResponsiveLabUI(const AppSwapResponsiveLabUI&) = delete;
+  AppSwapResponsiveLabUI& operator=(const AppSwapResponsiveLabUI&) = delete;
+  ~AppSwapResponsiveLabUI() override;
+
+  void BindInterface(
+      mojo::PendingReceiver<
+          app_swap_responsive_lab::mojom::PageHandlerFactory> receiver);
+
+ private:
+  // content::WebUIController:
+  void WebUIRenderFrameCreated(content::RenderFrameHost* rfh) override;
+
+  // app_swap_responsive_lab::mojom::PageHandlerFactory:
+  void CreatePageHandler(
+      mojo::PendingRemote<app_swap_responsive_lab::mojom::Page> page,
+      mojo::PendingReceiver<app_swap_responsive_lab::mojom::PageHandler>
+          handler) override;
+
+  base::WeakPtr<AppSwapResponsiveLabPanelBridge> bridge_;
+  std::unique_ptr<AppSwapResponsiveLabPageHandler> page_handler_;
+  mojo::Receiver<app_swap_responsive_lab::mojom::PageHandlerFactory>
+      page_factory_receiver_{this};
+
+  WEB_UI_CONTROLLER_TYPE_DECL();
