# ---- Chromium checkout & toolchain (fetched, never committed) ----
/src/
/depot_tools/
/.cipd/
/_bad_scm/

# ---- gclient resolved state (generated by `gclient sync`) ----
/.gclient_entries
/.gclient_previous_sync_commits
/.gcs_entries

# ---- Build output & distribution ----
/dist/
/out/
*.log

# ---- Python bytecode cache ----
__pycache__/
